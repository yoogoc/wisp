                        "--zstd",
                    ],
                ),
                (
                    names: [
                        "Z",
                        "-Z",
                        "--compress",
                        "--uncompress",
                    ],
                    description: Some("Filter the archive through compress"),
                    exclusive_on: [
                        "a",
                        "-a",
                        "--auto-compress",
                        "I",
                        "-I",
                        "--use-compress-program",
                        "j",
                        "-j",
                        "--bzip2",
                        "J",
                        "-J",
                        "--xz",
                        "--lzip",
                        "--lzma",
                        "--lzop",
                        "--no-auto-compress",
                        "z",
                        "-z",
                        "--gzip",
                        "--gunzip",
                        "--ungzip",
                        "Z",
                        "-Z",
                        "--compress",
                        "--uncompress",
                        "--zstd",
                    ],
                ),
                (
                    names: [
                        "--zstd",
                    ],
                    description: Some("Filter the archive through zstd"),
                    exclusive_on: [
                        "a",
                        "-a",
                        "--auto-compress",
                        "I",
                        "-I",
                        "--use-compress-program",
                        "j",
                        "-j",
                        "--bzip2",
                        "J",
                        "-J",
                        "--xz",
                        "--lzip",
                        "--lzma",
                        "--lzop",
                        "--no-auto-compress",
                        "z",
                        "-z",
                        "--gzip",
                        "--gunzip",
                        "--ungzip",
                        "Z",
                        "-Z",
                        "--compress",
                        "--uncompress",
                        "--zstd",
                    ],
                ),
                (
                    names: [
                        "--transform",
                        "--xform",
                    ],
                    description: Some("Use sed replace EXPRESSION to transform file names"),
                    arguments: [
                        (
                            name: "EXPRESSION",
                        ),
                    ],
                ),
                (
                    names: [
                        "--checkpoint",
                    ],
                    description: Some("Display progress messages every Nth record"),
                    arguments: [
                        (
                            name: "N",
                            optional: true,
                            default: Some("10"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--checkpoint-action",
                    ],
                    description: Some("Run ACTION on each checkpoint"),
                    arguments: [
                        (
                            name: "ACTION",
                        ),
                    ],
                ),
                (
                    names: [
                        "--full-time",
                    ],
                    description: Some("Print file time to its full resolution"),
                    depends_on: [
                        "v",
                        "-v",
                        "--verbose",
                    ],
                ),
                (
                    names: [
                        "--utc",
                    ],
                    description: Some("Print file modification times in UTC"),
                    depends_on: [
                        "v",
                        "-v",
                        "--verbose",
                    ],
                ),
                (
                    names: [
                        "b",
                        "-b",
                        "--blocking-factor",
                    ],
                    description: Some("Set record size to BLOCKSx512 bytes"),
                    arguments: [
                        (
                            name: "BLOCKS",
                        ),
                    ],
                ),
                (
                    names: [
                        "--record-size",
                    ],
                    description: Some("Set record size"),
                    arguments: [
                        (
                            name: "NUMBER",
                            description: Some("The number of bytes per record"),
                            suggestions: [
                                (
                                    name: "Blocks",
                                    presentation: (
                                        insert_value: Some("{cursor}b"),
                                    ),
                                ),
                                (
                                    name: "Bytes",
                                    presentation: (
                                        insert_value: Some("{cursor}c"),
                                    ),
                                ),
                                (
                                    name: "Gigabytes",
                                    presentation: (
                                        insert_value: Some("{cursor}G"),
                                    ),
                                ),
                                (
                                    name: "Kilobytes",
                                    presentation: (
                                        insert_value: Some("{cursor}K"),
                                    ),
                                ),
                                (
                                    name: "Megabytes",
                                    presentation: (
                                        insert_value: Some("{cursor}M"),
                                    ),
                                ),
                                (
                                    name: "Petabytes",
                                    presentation: (
                                        insert_value: Some("{cursor}P"),
                                    ),
                                ),
                                (
                                    name: "Terabytes",
                                    presentation: (
                                        insert_value: Some("{cursor}T"),
                                    ),
                                ),
                                (
                                    name: "Words",
                                    presentation: (
                                        insert_value: Some("{cursor}w"),
                                    ),
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "H",
                        "-H",
                        "--format",
                    ],
                    description: Some("Create archive of the given format"),
                    arguments: [
                        (
                            name: "FORMAT",
                            suggestions: [
                                (
                                    name: "gnu",
                                    description: Some("GNU tar 1.13.x format"),
                                ),
                                (
                                    name: "oldgnu",
                                    description: Some("GNU format as per tar <= 1.12"),
                                ),
                                (
                                    name: "pax",
                                    aliases: [
                                        "posix",
                                    ],
                                    description: Some("POSIX 1003.1-2001 (pax) format"),
                                ),
                                (
                                    name: "ustar",
                                    description: Some("POSIX 1003.1-1988 (ustar) format"),
                                ),
                                (
                                    name: "v7",
                                    description: Some("Old V7 tar format"),
                                ),
                            ],
                        ),
                    ],
                    exclusive_on: [
                        "--old-archive",
                        "--portability",
                        "--posix",
                        "o",
                        "-o",
                    ],
                ),
                (
                    names: [
                        "--old-archive",
                        "--portability",
                    ],
                    description: Some("Same as --format=v7"),
                    exclusive_on: [
                        "H",
                        "-H",
                        "--format",
                        "--pax-option",
                        "--posix",
                        "o",
                        "-o",
                    ],
                ),
                (
                    names: [
                        "--pax-option",
                    ],
                    description: Some("Control pax keywords when creating PAX archives"),
                    arguments: [
                        (
                            name: "keyword[[:]=value][,keyword[[:]=value]]...",
                        ),
                    ],
                    exclusive_on: [
                        "--old-archive",
                        "--portability",
                        "--old-archive",
                        "--portability",
                        "--posix",
                        "o",
                        "-o",
                    ],
                    depends_on: [
                        "H",
                        "-H",
                        "--format",
                    ],
                ),
                (
                    names: [
                        "--posix",
                    ],
                    description: Some("Same as --format=posix"),
