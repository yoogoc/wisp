                        "Z",
                        "-Z",
                        "--compress",
                        "--uncompress",
                        "--zstd",
                    ],
                ),
                (
                    names: [
                        "--lzma",
                    ],
                    description: Some("Filter the archive through lzma"),
                    exclusive_on: [
                        "a",
                        "-a",
                        "--auto-compress",
                        "I",
                        "-I",
                        "--use-compress-program",
                        "j",
                        "-j",
                        "--bzip2",
                        "J",
                        "-J",
                        "--xz",
                        "--lzip",
                        "--lzma",
                        "--lzop",
