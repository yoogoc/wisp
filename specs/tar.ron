                        "z",
                        "-z",
                        "--gzip",
                        "--gunzip",
                        "--ungzip",
                        "Z",
                        "-Z",
                        "--compress",
                        "--uncompress",
                        "--zstd",
                    ],
                ),
                (
                    names: [
                        "--no-auto-compress",
                    ],
                    description: Some("Do not use archive suffix to determine the compression program"),
                    exclusive_on: [
                        "a",
                        "-a",
                        "--auto-compress",
                        "I",
                        "-I",
                        "--use-compress-program",
                        "j",
                        "-j",
                        "--bzip2",
                        "J",
