                    ],
                ),
                (
                    names: [
                        "z",
                        "-z",
                        "--gzip",
                        "--gunzip",
                        "--ungzip",
                    ],
                    description: Some("Filter the archive through gzip"),
                    exclusive_on: [
                        "a",
                        "-a",
                        "--auto-compress",
                        "I",
                        "-I",
                        "--use-compress-program",
                        "j",
                        "-j",
                        "--bzip2",
                        "J",
                        "-J",
                        "--xz",
                        "--lzip",
                        "--lzma",
