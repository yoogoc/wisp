                        "-z",
                        "--gzip",
                        "--gunzip",
                        "--ungzip",
                        "Z",
                        "-Z",
                        "--compress",
                        "--uncompress",
                        "--zstd",
                    ],
                ),
                (
                    names: [
                        "--lzop",
                    ],
                    description: Some("Filter the archive through lzop"),
                    exclusive_on: [
                        "a",
                        "-a",
                        "--auto-compress",
                        "I",
                        "-I",
                        "--use-compress-program",
                        "j",
                        "-j",
                        "--bzip2",
                        "J",
                        "-J",
                        "--xz",
                        "--lzip",
                        "--lzma",
