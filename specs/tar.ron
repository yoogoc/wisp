(
    version: 1,
    command: "tar",
    description: Some("Manipulating archive files"),
    subcommands: [
        (
            name: "A",
            aliases: [
                "-A",
                "--catenate",
                "--concatenate",
            ],
            description: Some("Append archive to the end of another archive"),
            arguments: [
                (
                    name: "ARCHIVE",
                    template: [
                        FilePaths,
                    ],
                    variadic: true,
                ),
            ],
        ),
        (
            name: "c",
            aliases: [
                "-c",
                "--create",
            ],
            description: Some("Create a new archive"),
            options: [
                (
                    names: [
                        "--check-device",
                    ],
                    description: Some("Check device numbers when creating incremental archives"),
                    exclusive_on: [
                        "--no-check-device",
                    ],
                    depends_on: [
                        "g",
                        "-g",
                        "--listed-incremental",
                    ],
                ),
                (
                    names: [
                        "--level",
                    ],
                    description: Some("Set dump level for created listed-incremental archive"),
                    arguments: [
                        (
                            name: "NUMBER",
                            default: Some("0"),
                        ),
                    ],
                    requires_separator: Some("="),
                    depends_on: [
                        "g",
                        "-g",
                        "--listed-incremental",
                    ],
                ),
                (
                    names: [
                        "--no-check-device",
                    ],
                    description: Some("Do not check device numbers when creating incremental archives"),
                    exclusive_on: [
                        "--check-device",
                    ],
                    depends_on: [
                        "g",
                        "-g",
                        "--listed-incremental",
                    ],
                ),
                (
                    names: [
                        "--ignore-failed-read",
                    ],
                    description: Some("Do not exit with nonzero on unreadable files"),
                ),
                (
                    names: [
                        "--restrict",
                    ],
                    description: Some("Disable the use of some potentially harmful options"),
                    depends_on: [
                        "M",
                        "-M",
                        "--multi-volume",
                    ],
                ),
                (
                    names: [
                        "--remove-files",
                    ],
                    description: Some("Remove files from disk after adding them to the archive"),
                ),
                (
                    names: [
                        "W",
                        "-W",
                        "--verify",
                    ],
                    description: Some("Verify the archive after writing it"),
                ),
                (
                    names: [
                        "--atime-preserve",
                    ],
                    description: Some("Preserve access times on dumped files"),
                    arguments: [
                        (
                            name: "METHOD",
                            suggestions: [
                                (
                                    name: "replace",
                                    description: Some("Restore the times after reading"),
                                ),
                                (
                                    name: "system",
                                    description: Some("Not setting the times in the first place"),
                                ),
                            ],
                            optional: true,
                            default: Some("replace"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--group",
                    ],
                    description: Some("Force NAME as group for added files"),
                    arguments: [
                        (
                            name: "NAME[:GID]",
                            description: Some("If GID is not supplied, NAME can be either a user name or numeric GID"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--group-map",
                    ],
                    description: Some("Read group translation map from FILE"),
                    arguments: [
                        (
                            name: "FILE",
                            description: Some("Each non-empty line in FILE defines translation for a single group"),
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--mode",
                    ],
                    description: Some("Force symbolic mode CHANGES for added files"),
                    arguments: [
                        (
                            name: "CHANGES",
                        ),
                    ],
                ),
                (
                    names: [
                        "--mtime",
                    ],
                    description: Some("Set mtime for added files"),
                    arguments: [
                        (
                            name: "DATE-OR-FILE",
                            description: Some("Either a date/time in almost arbitrary format, or the name of an existing file"),
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--owner",
                    ],
                    description: Some("Force NAME as owner for added files"),
                    arguments: [
                        (
                            name: "NAME[:GID]",
                            description: Some("If UID is not supplied, NAME can be either a user name or numeric UID"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--owner-map",
                    ],
                    description: Some("Read owner translation map from FILE"),
                    arguments: [
                        (
                            name: "FILE",
                            description: Some("Each non-empty line in FILE defines translation for a single UID"),
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--sort",
                    ],
                    description: Some("When creating an archive, sort directory entries according to ORDER"),
                    arguments: [
                        (
                            name: "ORDER",
                            suggestions: [
                                (
                                    name: "none",
                                ),
                                (
                                    name: "name",
                                ),
                                (
                                    name: "inode",
                                ),
                            ],
                            default: Some("none"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--add-file",
                    ],
                    description: Some("Add FILE to the archive"),
                    arguments: [
                        (
                            name: "FILE",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--exclude",
                    ],
                    description: Some("Exclude files matching PATTERN"),
                    arguments: [
                        (
                            name: "PATTERN",
                            description: Some("A glob-style wildcard pattern"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--exclude-backups",
                    ],
                    description: Some("Exclude backup and lock files"),
                ),
                (
                    names: [
                        "--exclude-caches",
                    ],
                    description: Some("Exclude contents of directories containing file CACHEDIR.TAG, except for the tag file itself"),
                    exclusive_on: [
                        "--exclude-caches-all",
                        "--exclude-caches-under",
                    ],
                ),
                (
                    names: [
                        "--exclude-caches-all",
                    ],
                    description: Some("Exclude directories containing file CACHEDIR.TAG and the file itself"),
                    exclusive_on: [
                        "--exclude-caches",
                        "--exclude-caches-under",
                    ],
                ),
                (
                    names: [
                        "--exclude-caches-under",
                    ],
                    description: Some("Exclude everything under directories containing CACHEDIR.TAG"),
                    exclusive_on: [
                        "--exclude-caches",
                        "--exclude-caches-all",
                    ],
                ),
                (
                    names: [
                        "--exclude-ignore",
                    ],
                    description: Some("Read exclusion patterns from FILE in directory before dumping"),
                    arguments: [
                        (
                            name: "FILE",
                        ),
                    ],
                    exclusive_on: [
                        "--exclude-ignore-recursive",
                    ],
                ),
                (
                    names: [
                        "--exclude-ignore-recursive",
                    ],
                    description: Some("Same  as --exclude-ignore, except that patterns from FILE affect both the directory and all its subdirectories"),
                    arguments: [
                        (
                            name: "FILE",
                        ),
                    ],
                    exclusive_on: [
                        "--exclude-ignore",
                    ],
                ),
                (
                    names: [
                        "--exclude-tag",
                    ],
                    description: Some("Exclude contents of directories containing FILE, except for FILE itself"),
                    arguments: [
                        (
                            name: "FILE",
                        ),
                    ],
                    exclusive_on: [
                        "--exclude-tag-all",
                        "--exclude-tag-under",
                    ],
                ),
                (
                    names: [
                        "--exclude-tag-all",
                    ],
                    description: Some("Exclude directories containing FILE"),
                    arguments: [
                        (
                            name: "FILE",
                        ),
                    ],
                    exclusive_on: [
                        "--exclude-tag",
                        "--exclude-tag-under",
                    ],
                ),
                (
                    names: [
                        "--exclude-tag-under",
                    ],
                    description: Some("Exclude everything under directories containing FILE"),
                    arguments: [
                        (
                            name: "FILE",
                        ),
                    ],
                    exclusive_on: [
                        "--exclude-tag",
                        "--exclude-tag-all",
                    ],
                ),
                (
                    names: [
                        "--exclude-vcs",
                    ],
                    description: Some("Exclude version control system directories"),
                    exclusive_on: [
                        "--exclude-vcs-ignores",
                    ],
                ),
                (
                    names: [
                        "--exclude-vcs-ignores",
                    ],
                    description: Some("Exclude files that match patterns read from VCS-specific ignore files"),
                    exclusive_on: [
                        "--exclude-vcs",
                    ],
                ),
                (
                    names: [
                        "h",
                        "-h",
                        "--dereference",
                    ],
                    description: Some("Follow symlinks; archive and dump the files they point to"),
                ),
                (
                    names: [
                        "--hard-dereference",
                    ],
                    description: Some("Follow hard links; archive and dump the files they refer to"),
                ),
                (
                    names: [
                        "N",
                        "-N",
                        "--newer",
                        "--after-date",
                    ],
                    description: Some("Only store files newer than DATE"),
                    arguments: [
                        (
                            name: "DATE",
                            description: Some("If DATE starts with / or . it is taken to be a file name"),
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--one-file-system",
                    ],
                    description: Some("Stay in local file system when creating archive"),
                ),
                (
                    names: [
                        "P",
                        "-P",
                        "--absolute-names",
                    ],
                    description: Some("Don't strip leading slashes from file names"),
                ),
                (
                    names: [
                        "--anchored",
                    ],
                    description: Some("Patterns match file name start"),
                    exclusive_on: [
                        "--no-anchored",
                    ],
                    depends_on: [
                        "--exclude",
                    ],
                ),
                (
                    names: [
                        "--ignore-case",
                    ],
                    description: Some("Ignore case"),
                    exclusive_on: [
                        "--no-ignore-case",
                    ],
                    depends_on: [
                        "--exclude",
                    ],
                ),
                (
                    names: [
                        "--no-anchored",
                    ],
                    description: Some("Patterns match after any /"),
                    exclusive_on: [
                        "--anchored",
                    ],
                    depends_on: [
                        "--exclude",
                    ],
                ),
                (
                    names: [
                        "--no-ignore-case",
                    ],
                    description: Some("Case sensitive matching"),
                    exclusive_on: [
                        "--ignore-case",
                    ],
                    depends_on: [
                        "--exclude",
                    ],
                ),
                (
                    names: [
                        "--no-wildcards",
                    ],
                    description: Some("Verbatim string matching"),
                    exclusive_on: [
                        "--wildcards",
                    ],
                    depends_on: [
                        "--exclude",
                    ],
                ),
                (
                    names: [
                        "--no-wildcards-match-slash",
                    ],
                    description: Some("Wildcards do not match /"),
                    exclusive_on: [
                        "--no-wildcards",
                        "--wildcards-match-slash",
                    ],
                    depends_on: [
                        "--exclude",
                        "--wildcards",
                    ],
                ),
                (
                    names: [
                        "--wildcards",
                    ],
                    description: Some("Use wildcards"),
                    exclusive_on: [
                        "--no-wildcards",
                    ],
                    depends_on: [
                        "--exclude",
                    ],
                ),
                (
                    names: [
                        "--wildcards-match-slash",
                    ],
                    description: Some("Wildcards match /"),
                    exclusive_on: [
                        "--no-wildcards",
                        "--no-wildcards-match-slash",
                    ],
                    depends_on: [
                        "--exclude",
                        "--wildcards",
                    ],
                ),
                (
                    names: [
                        "--clamp-mtime",
                    ],
                    description: Some("Only set time when the file is more recent than what was given with --mtime"),
                    depends_on: [
                        "--mtime",
                    ],
                ),
                (
                    names: [
                        "l",
                        "-l",
                        "--check-links",
                    ],
                    description: Some("Print a message if not all links are dumped"),
                ),
                (
                    names: [
                        "a",
                        "-a",
                        "--auto-compress",
                    ],
                    description: Some("Use archive suffix to determine the compression program"),
                    exclusive_on: [
                        "a",
                        "-a",
                        "--auto-compress",
                        "I",
                        "-I",
                        "--use-compress-program",
                        "j",
                        "-j",
                        "--bzip2",
                        "J",
                        "-J",
                        "--xz",
                        "--lzip",
                        "--lzma",
                        "--lzop",
                        "--no-auto-compress",
                        "z",
                        "-z",
                        "--gzip",
                        "--gunzip",
                        "--ungzip",
                        "Z",
                        "-Z",
                        "--compress",
                        "--uncompress",
                        "--zstd",
                    ],
                ),
                (
                    names: [
                        "I",
                        "-I",
                        "--use-compress-program",
                    ],
                    description: Some("Filter data through COMMAND"),
                    arguments: [
                        (
                            name: "COMMAND",
                        ),
                    ],
                    exclusive_on: [
                        "a",
                        "-a",
                        "--auto-compress",
                        "I",
                        "-I",
                        "--use-compress-program",
                        "j",
                        "-j",
                        "--bzip2",
                        "J",
                        "-J",
                        "--xz",
                        "--lzip",
                        "--lzma",
                        "--lzop",
                        "--no-auto-compress",
                        "z",
                        "-z",
                        "--gzip",
                        "--gunzip",
                        "--ungzip",
                        "Z",
                        "-Z",
                        "--compress",
                        "--uncompress",
                        "--zstd",
                    ],
                ),
                (
                    names: [
                        "j",
                        "-j",
                        "--bzip2",
                    ],
                    description: Some("Filter the archive through bzip2"),
                    exclusive_on: [
                        "a",
                        "-a",
                        "--auto-compress",
                        "I",
                        "-I",
                        "--use-compress-program",
                        "j",
                        "-j",
                        "--bzip2",
                        "J",
                        "-J",
                        "--xz",
                        "--lzip",
                        "--lzma",
                        "--lzop",
                        "--no-auto-compress",
                        "z",
                        "-z",
                        "--gzip",
                        "--gunzip",
                        "--ungzip",
                        "Z",
                        "-Z",
                        "--compress",
                        "--uncompress",
                        "--zstd",
                    ],
                ),
                (
                    names: [
                        "J",
                        "-J",
                        "--xz",
                    ],
                    description: Some("Filter the archive through xz"),
                    exclusive_on: [
                        "a",
                        "-a",
                        "--auto-compress",
                        "I",
                        "-I",
                        "--use-compress-program",
                        "j",
                        "-j",
                        "--bzip2",
                        "J",
                        "-J",
                        "--xz",
