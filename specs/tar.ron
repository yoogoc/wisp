                        "--ungzip",
                        "Z",
                        "-Z",
                        "--compress",
                        "--uncompress",
                        "--zstd",
                    ],
                ),
                (
                    names: [
                        "--lzip",
                    ],
                    description: Some("Filter the archive through lzip"),
                    exclusive_on: [
                        "a",
                        "-a",
                        "--auto-compress",
                        "I",
                        "-I",
                        "--use-compress-program",
                        "j",
                        "-j",
                        "--bzip2",
