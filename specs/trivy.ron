(
    version: 1,
    command: "trivy",
    description: Some("A simple and comprehensive vulnerability scanner"),
    subcommands: [
        (
            name: "image",
            aliases: [
                "i",
            ],
            description: Some("Scan an image"),
            subcommands: [
                (
                    name: "--template",
                    aliases: [
                        "-t",
                    ],
                    description: Some("Output template [$TRIVY_TEMPLATE]"),
                    arguments: [
                        (
                            name: "output",
                        ),
                    ],
                ),
                (
                    name: "--format",
                    aliases: [
                        "-f",
                    ],
                    description: Some("Format (table, json, sarif, template) (default: \"table\") [$TRIVY_FORMAT]"),
                    arguments: [
                        (
                            name: "format",
                            suggestions: [
                                (
                                    name: "table",
                                ),
                                (
                                    name: "json",
                                ),
                                (
                                    name: "sarif",
                                ),
                                (
                                    name: "template",
                                ),
                            ],
                            default: Some("table"),
                        ),
                    ],
                ),
                (
                    name: "--severity",
                    aliases: [
                        "-s",
                    ],
                    description: Some("Severities of vulnerabilities to be displayed (comma separated) (default: \"UNKNOWN,LOW,MEDIUM,HIGH,CRITICAL\") [$TRIVY_SEVERITY]"),
                    arguments: [
                        (
                            name: "severity",
                            generators: [
                                (
                                    has_custom: true,
                                    trigger: Some(OnMatch([
                                            ",",
                                        ])),
                                    query_term: Some(AfterLast(",")),
                                ),
                            ],
                            default: Some("UNKNOWN,LOW,MEDIUM,HIGH,CRITICAL"),
                        ),
                    ],
                ),
                (
                    name: "--output",
                    aliases: [
                        "-o",
                    ],
                    description: Some("Output file name [$TRIVY_OUTPUT]"),
                    arguments: [
                        (
                            name: "input",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    name: "--exit-code",
                    description: Some("Exit code when vulnerabilities were found (default: 0) [$TRIVY_EXIT_CODE]"),
                    arguments: [
                        (
                            name: "exitCode",
                            default: Some("0"),
                        ),
                    ],
                ),
                (
                    name: "--clear-cache",
                    aliases: [
                        "-c",
                    ],
                    description: Some("Clear image caches without scanning [$TRIVY_CLEAR_CACHE]"),
                ),
                (
                    name: "--vuln-type",
                    description: Some("Comma-separated list of vulnerability types (os,library) (default: \"os,library\") [$TRIVY_VULN_TYPE]"),
                    arguments: [
                        (
                            name: "vulnType",
                            generators: [
                                (
                                    has_custom: true,
                                    trigger: Some(OnMatch([
                                            ",",
                                        ])),
                                    query_term: Some(AfterLast(",")),
                                ),
                            ],
                            default: Some("os,library"),
                        ),
                    ],
                ),
                (
                    name: "--security-checks",
                    description: Some("Comma-separated list of what security issues to detect (vuln,config) (default: \"vuln\") [$TRIVY_SECURITY_CHECKS]"),
                    arguments: [
                        (
                            name: "securityChecks",
                            generators: [
                                (
                                    has_custom: true,
                                    trigger: Some(OnMatch([
                                            ",",
                                        ])),
                                    query_term: Some(AfterLast(",")),
                                ),
                            ],
                            default: Some("vuln"),
                        ),
                    ],
                ),
                (
                    name: "--ignorefile",
                    description: Some("Specify .trivyignore file (default: \".trivyignore\") [$TRIVY_IGNOREFILE]]"),
                    arguments: [
                        (
                            name: "ignorefile",
                            template: [
                                FilePaths,
                            ],
                            default: Some(".trivyignore"),
                        ),
                    ],
                ),
                (
                    name: "--timeout",
                    description: Some("Timeout (default: 5m0s) [$TRIVY_TIMEOUT]"),
                    arguments: [
                        (
                            name: "timeout",
                            default: Some("5m0s"),
                        ),
                    ],
                ),
                (
                    name: "--ignore-policy",
                    description: Some("Specify the Rego file to evaluate each vulnerability [$TRIVY_IGNORE_POLICY]"),
                    arguments: [
                        (
                            name: "ignorePolicy",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    name: "--list-all-pkgs",
                    description: Some("Enabling the option will output all packages regardless of vulnerability (default: false) [$TRIVY_LIST_ALL_PKGS]"),
                ),
                (
                    name: "--cache-backend",
                    description: Some("Cache backend (e.g. redis://localhost:6379) (default: \"fs\") [$TRIVY_CACHE_BACKEND]"),
                    arguments: [
                        (
                            name: "cacheBackend",
                            default: Some("fs"),
                        ),
                    ],
                ),
                (
                    name: "--no-progress",
                    description: Some("Suppress progress bar [$TRIVY_NO_PROGRESS]"),
                ),
                (
                    name: "--offline-scan",
                    description: Some("Do not issue API requests to identify dependencies [$TRIVY_OFFLINE_SCAN]"),
                ),
                (
                    name: "--skip-files",
                    description: Some("Specify the file paths to skip traversal [$TRIVY_SKIP_FILES]"),
                    arguments: [
                        (
                            name: "skipFiles",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    name: "--skip-dirs",
                    description: Some("Allow insecure server connections when using SSL [$TRIVY_INSECURE]"),
                    arguments: [
                        (
                            name: "skipDirs",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    name: "--skip-db-update",
                    aliases: [
                        "--skip-update",
                    ],
                    description: Some("Skip updating vulnerability database [$TRIVY_SKIP_UPDATE, $TRIVY_SKIP_DB_UPDATE]"),
                ),
                (
                    name: "--removed-pkgs",
                    description: Some("Detect vulnerabilities of removed packages (default: false) [$TRIVY_REMOVED_PKGS]"),
                ),
                (
                    name: "--input",
                    aliases: [
                        "-i",
                    ],
                    description: Some("Input file path instead of image name [$TRIVY_INPUT]"),
                    arguments: [
                        (
                            name: "input",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    name: "--download-db-only",
                    description: Some("Download/update vulnerability database but don't run a scan [$TRIVY_DOWNLOAD_DB_ONLY]"),
                ),
                (
                    name: "--reset",
                    description: Some("Remove all caches and database [$TRIVY_RESET]"),
                ),
                (
                    name: "--ignore-unfixed",
                    description: Some("Display only fixed vulnerabilities [$TRIVY_IGNORE_UNFIXED]"),
                ),
                (
                    name: "--light",
                    description: Some("Deprecated [$TRIVY_LIGHT]"),
                ),
                (
                    name: "--insecure",
                    description: Some("Allow insecure server connections when using SSL [$TRIVY_INSECURE]"),
                ),
            ],
            arguments: [
                (
                    name: "image_name",
                ),
            ],
        ),
