(
    version: 1,
    command: "nl",
    description: Some("Line numbering filter"),
    subcommands: [],
    options: [
        (
            names: [
                "-b",
            ],
            description: Some("Specify the logical page body lines to be numbered"),
            takes_value: true,
            arguments: [
                (
                    name: "type",
                    source: Static([
                        "a",
                        "t",
                        "pexpr",
                    ]),
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "-d",
            ],
            description: Some("Specify the delimiter characters used to indicate the\nstart of a logical page section in the input file. At most two\ncharacters may be specified; if only one character is specified,\nthe first character is replaced and the second character remains unchanged"),
            takes_value: true,
            arguments: [
                (
                    name: "delim",
                    source: Static([
                        "\\:",
                    ]),
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "-f",
            ],
            description: Some("Specify the same as -b type except for logical page footer lines"),
            takes_value: true,
            arguments: [
                (
                    name: "type",
                    source: Static([
                        "n",
                    ]),
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "-h",
            ],
            description: Some("Specify the same as -b type except for logical page header lines"),
            takes_value: true,
            arguments: [
                (
                    name: "type",
                    source: Static([
                        "n",
                    ]),
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "-i",
            ],
            description: Some("Specify the increment value used to number logical page lines"),
            takes_value: true,
            arguments: [
                (
                    name: "incr",
                    source: Static([
                        "1",
                    ]),
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "-l",
            ],
            description: Some("If numbering of all lines is specified for the current\nlogical section using the corresponding -b a, -f a or -h a option, specify\nthe number of adjacent blank lines to be considered as one. For example,\n-l 2 results in only the second adjacent blank line being numbered"),
            takes_value: true,
            arguments: [
                (
                    name: "num",
                    source: Static([
                        "1",
                    ]),
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "-n",
            ],
            description: Some("Specify the line numbering output format"),
            takes_value: true,
            arguments: [
                (
                    name: "format",
                    source: Static([
                        "ln",
                        "rn",
                        "rz",
                    ]),
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "-p",
            ],
            description: Some("Specify that line numbering should not be restarted at logical page delimiters"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-s",
            ],
            description: Some("Specify the characters used in separating the line\nnumber and the corresponding text line.  The default\nsep setting is a single tab character"),
            takes_value: true,
            arguments: [
                (
                    name: "sep",
                    source: Static([
                        "\\t",
                    ]),
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "-v",
            ],
            description: Some("Specify the initial value used to number logical page lines; see also the description of the -p option"),
            takes_value: true,
            arguments: [
                (
                    name: "startnum",
                    source: Static([
                        "1",
                        "2",
                        "3",
                    ]),
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "-w",
            ],
            description: Some("Specify the number of characters to be occupied by the\nline number; in case the width is insufficient to hold the line number,\nit will be truncated to its width least significant digits"),
            takes_value: true,
            arguments: [
                (
                    name: "width",
                    source: Static([
                        "6",
                        "5",
                        "4",
                        "3",
                        "2",
                        "1",
                    ]),
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "file",
            source: Files,
            optional: false,
            variadic: false,
            imported_generator: None,
        ),
    ],
)