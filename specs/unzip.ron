(
    version: 1,
    command: "unzip",
    description: Some("Extract compressed files in a ZIP archive"),
    options: [
        (
            names: [
                "-l",
            ],
            description: Some("List the contents of a zip file without extracting"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-c",
            ],
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-0",
            ],
            description: Some("Extract a zip file created in windows, containing files with non-ascii (chinese) filenames"),
            arguments: [
                (
                    name: "gbk",
                ),
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-d",
            ],
            arguments: [
                (
                    name: "destination",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "file",
            template: [
                FilePaths,
            ],
        ),
    ],
)
