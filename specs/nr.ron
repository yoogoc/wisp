(
    version: 1,
    command: "nr",
    description: Some("Use the right package manager - run"),
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Output usage information"),
        ),
    ],
    arguments: [
        (
            name: "script",
            description: Some("The script to run"),
            generators: [
                (
                    script: [
                        "bash",
                        "-c",
                        "until [[ -f package.json ]] || [[ $PWD = '/' ]]; do cd ..; done; cat package.json",
                    ],
                    has_post_process: true,
                    cache: Some((
                        by_directory: true,
                        stale_while_revalidate: true,
                    )),
                ),
            ],
            filter_strategy: Fuzzy,
        ),
    ],
    additional_suggestions: [
        (
            name: "-",
            description: Some("Run the last command"),
            kind: Some(Shortcut),
            presentation: (
                insert_value: Some("-\n"),
            ),
        ),
    ],
)
