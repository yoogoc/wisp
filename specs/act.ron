(
    version: 1,
    command: "act",
    description: Some("Run GitHub actions locally by specifying the event name (e.g. `push`) or an action name directly"),
    subcommands: [
        (
            name: "completion",
            description: Some("Generate the autocompletion script for the specified shell"),
            subcommands: [
                (
                    name: "bash",
                    description: Some("Generate the autocompletion script for bash"),
                    options: [
                        (
                            names: [
                                "--no-descriptions",
                            ],
                            description: Some("Disable completion descriptions"),
                        ),
                    ],
                ),
                (
                    name: "fish",
                    description: Some("Generate the autocompletion script for fish"),
                    options: [
                        (
                            names: [
                                "--no-descriptions",
                            ],
                            description: Some("Disable completion descriptions"),
                        ),
                    ],
                ),
                (
                    name: "powershell",
                    description: Some("Generate the autocompletion script for powershell"),
                    options: [
                        (
                            names: [
                                "--no-descriptions",
                            ],
                            description: Some("Disable completion descriptions"),
                        ),
                    ],
                ),
                (
                    name: "zsh",
                    description: Some("Generate the autocompletion script for zsh"),
                    options: [
                        (
                            names: [
                                "--no-descriptions",
                            ],
                            description: Some("Disable completion descriptions"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "help",
            description: Some("Help about any command"),
            subcommands: [
                (
                    name: "completion",
                    description: Some("Generate the autocompletion script for the specified shell"),
                    subcommands: [
                        (
                            name: "bash",
                            description: Some("Generate the autocompletion script for bash"),
                        ),
                        (
                            name: "fish",
                            description: Some("Generate the autocompletion script for fish"),
                        ),
                        (
                            name: "powershell",
                            description: Some("Generate the autocompletion script for powershell"),
                        ),
                        (
                            name: "zsh",
                            description: Some("Generate the autocompletion script for zsh"),
                        ),
                    ],
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--bind",
                "-b",
            ],
            description: Some("Bind working directory to container, rather than copy"),
        ),
        (
            names: [
                "--bug-report",
            ],
            description: Some("Display system information for bug report"),
        ),
        (
            names: [
                "--container-cap-add",
            ],
            description: Some("Kernel capabilities to add to the workflow containers (e.g. --container-cap-add SYS_PTRACE)"),
            arguments: [
                (
                    name: "container-cap-add",
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "--container-cap-drop",
            ],
            description: Some("Kernel capabilities to remove from the workflow containers (e.g. --container-cap-drop SYS_PTRACE)"),
            arguments: [
                (
                    name: "container-cap-drop",
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "--defaultbranch",
            ],
            description: Some("The name of the main branch"),
            arguments: [
                (
                    name: "defaultbranch",
                ),
            ],
        ),
        (
            names: [
                "--detect-event",
            ],
            description: Some("Use first event type from workflow as event that triggered the workflow"),
        ),
        (
            names: [
                "--env",
            ],
            description: Some("Env to make available to actions with optional value (e.g. --env myenv=foo or --env myenv)"),
            arguments: [
                (
                    name: "env",
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "--eventpath",
                "-e",
            ],
            description: Some("Path to event JSON file"),
            arguments: [
                (
                    name: "eventpath",
                ),
            ],
        ),
        (
            names: [
                "--graph",
                "-g",
            ],
            description: Some("Draw workflows"),
        ),
        (
            names: [
                "--job",
                "-j",
            ],
            description: Some("Run job"),
            arguments: [
                (
                    name: "job",
                ),
            ],
        ),
        (
            names: [
                "--list",
                "-l",
            ],
            description: Some("List workflows"),
        ),
        (
            names: [
                "--platform",
                "-P",
            ],
            description: Some("Custom image to use per platform (e.g. -P ubuntu-18.04=nektos/act-environments-ubuntu:18.04)"),
            arguments: [
                (
                    name: "platform",
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "--privileged",
            ],
            description: Some("Use privileged mode"),
        ),
        (
            names: [
                "--pull",
                "-p",
            ],
            description: Some("Pull docker image(s) even if already present"),
        ),
        (
            names: [
                "--rebuild",
            ],
            description: Some("Rebuild local action docker image(s) even if already present"),
        ),
        (
            names: [
                "--remote-name",
            ],
            description: Some("Git remote name that will be used to retrieve url of git repo"),
            arguments: [
                (
                    name: "remote-name",
                    default: Some("origin"),
                ),
            ],
        ),
        (
            names: [
                "--reuse",
                "-r",
            ],
            description: Some("Don't remove container(s) on successfully completed workflow(s) to maintain state between runs"),
        ),
        (
            names: [
                "--rm",
            ],
            description: Some("Automatically remove container(s)/volume(s) after a workflow(s) failure"),
        ),
        (
            names: [
                "--secret",
                "-s",
            ],
            description: Some("Secret to make available to actions with optional value (e.g. -s mysecret=foo or -s mysecret)"),
            arguments: [
                (
                    name: "secret",
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "--use-gitignore",
            ],
            description: Some("Controls whether paths specified in .gitignore should be copied into container"),
        ),
        (
            names: [
                "--userns",
            ],
            description: Some("User namespace to use"),
            arguments: [
                (
                    name: "userns",
                ),
            ],
        ),
        (
            names: [
                "--watch",
                "-w",
            ],
            description: Some("Watch the contents of the local repo and run when files change"),
        ),
        (
            names: [
                "--actor",
                "-a",
            ],
            description: Some("User that triggered the event"),
            arguments: [
                (
                    name: "actor",
                    default: Some("nektos/act"),
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--artifact-server-path",
            ],
            description: Some("Defines the path where the artifact server stores uploads and retrieves downloads from. If not specified the artifact server will not start"),
            arguments: [
                (
                    name: "artifact-server-path",
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--artifact-server-port",
            ],
            description: Some("Defines the port where the artifact server listens (will only bind to localhost)"),
            arguments: [
                (
                    name: "artifact-server-port",
                    default: Some("34567"),
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--container-architecture",
            ],
            description: Some("Architecture which should be used to run containers, e.g.: linux/amd64. If not specified, will use host default architecture. Requires Docker server API Version 1.41+. Ignored on earlier Docker server platforms"),
            arguments: [
                (
                    name: "container-architecture",
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--container-daemon-socket",
            ],
            description: Some("Path to Docker daemon socket which will be mounted to containers"),
            arguments: [
                (
                    name: "container-daemon-socket",
                    default: Some("/var/run/docker.sock"),
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--directory",
                "-C",
            ],
            description: Some("Working directory"),
            arguments: [
                (
                    name: "directory",
                    template: [
                        Folders,
                    ],
                    default: Some("."),
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--dryrun",
                "-n",
            ],
            description: Some("Dryrun mode"),
            persistent: true,
        ),
        (
            names: [
                "--env-file",
            ],
            description: Some("Environment file to read and use as env in the containers"),
            arguments: [
                (
                    name: "env-file",
                    default: Some(".env"),
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--github-instance",
            ],
            description: Some("GitHub instance to use. Don't use this if you are not using GitHub Enterprise Server"),
            arguments: [
                (
                    name: "github-instance",
                    default: Some("github.com"),
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--insecure-secrets",
            ],
            description: Some("NOT RECOMMENDED! Doesn't hide secrets while printing logs"),
            persistent: true,
        ),
        (
            names: [
                "--json",
            ],
            description: Some("Output logs in json format"),
            persistent: true,
        ),
        (
            names: [
                "--no-recurse",
            ],
            description: Some("Flag to disable running workflows from subdirectories of specified path in '--workflows'/'-W' flag"),
            persistent: true,
        ),
        (
            names: [
                "--no-skip-checkout",
            ],
            description: Some("Do not skip actions/checkout"),
            persistent: true,
        ),
        (
            names: [
                "--quiet",
                "-q",
            ],
            description: Some("Disable logging of output from steps"),
            persistent: true,
        ),
        (
            names: [
                "--secret-file",
            ],
            description: Some("File with list of secrets to read from (e.g. --secret-file .secrets)"),
            arguments: [
                (
                    name: "secret-file",
                    default: Some(".secrets"),
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--verbose",
                "-v",
            ],
            description: Some("Verbose output"),
            persistent: true,
        ),
        (
            names: [
                "--workflows",
                "-W",
            ],
            description: Some("Path to workflow file(s)"),
            arguments: [
                (
                    name: "workflows",
                    template: [
                        Folders,
                        FilePaths,
                    ],
                    default: Some("./.github/workflows/"),
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Display help"),
            persistent: true,
        ),
    ],
)
