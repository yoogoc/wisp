(
    version: 1,
    command: "gource",
    description: Some("Gource is an OpenGL-based 3D visualisation tool for source control repositories"),
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Help ('-H' for extended help)"),
        ),
        (
            names: [
                "--viewport",
            ],
            description: Some("Set the viewport size. If -f is also supplied, will attempt to set the video mode to this also. Add `!` to make the window non-resizable"),
            arguments: [
                (
                    name: "size",
                    description: Some("The size of the viewport (e.g. WIDTHxHEIGHT)"),
                    suggestions: [
                        (
                            name: "3840x2160",
                        ),
                        (
                            name: "2560x1440",
                        ),
                        (
                            name: "1920x1080",
                        ),
                        (
                            name: "1280x720",
                        ),
                        (
                            name: "800x600",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-f",
            ],
            description: Some("Fullscreen"),
        ),
        (
            names: [
                "--screen",
            ],
            description: Some("Set the number of the screen to display on"),
            arguments: [
                (
                    name: "screen",
                    description: Some("The number of the screen to display on"),
                    generators: [
                        (
                            script: [
                                "system_profiler",
                                "SPDisplaysDataType",
                                "-json",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--high-dpi",
            ],
            description: Some("Request a high DPI display when creating the window. On some platforms such as MacOS, the window resolution is specified in points instead of pixels. The --high-dpi flag may be required to access some higher resolutions. E.g. requesting a high DPI 800x600 window may produce a window that is 1600x1200 pixels"),
        ),
        (
            names: [
                "--window-position",
            ],
            description: Some("Initial window position on your desktop which may be made up of multiple monitors. This will override the screen setting so don't specify both"),
            arguments: [
                (
                    name: "position",
                    description: Some("The initial window position on your desktop (e.g. XxY)"),
                ),
            ],
        ),
        (
            names: [
                "--frameless",
            ],
            description: Some("Frameless window"),
        ),
        (
            names: [
                "--transparent",
            ],
            description: Some("Make the background transparent. Only really useful for screenshots"),
        ),
        (
            names: [
                "--start-date",
            ],
            description: Some("Start with the first entry after the supplied date and optional time. If a time zone offset isn't specified the local time zone is used. Example accepted formats: 'YYYY-MM-DD', 'YYYY-MM-DD hh:mm', 'YYYY-MM-DD hh:mm:ss +tz'"),
            arguments: [
                (
                    name: "date",
                    description: Some("The start date and optional time"),
                ),
            ],
        ),
        (
            names: [
                "--stop-date",
            ],
            description: Some("Stop at the last entry prior to the supplied date and optional time. Uses the same format as --start-date"),
            arguments: [
                (
                    name: "date",
                    description: Some("The stop date and optional time"),
                ),
            ],
        ),
        (
            names: [
                "-p",
                "--start-position",
            ],
            description: Some("Begin at some position in the log (between 0.0 and 1.0 or 'random')"),
            arguments: [
                (
                    name: "position",
                    description: Some("The start position in the log"),
                    suggestions: [
                        (
                            name: "random",
                        ),
                        (
                            name: "0.0",
                        ),
                        (
                            name: "0.1",
                        ),
                        (
                            name: "0.2",
                        ),
                        (
                            name: "0.3",
                        ),
                        (
                            name: "0.4",
                        ),
                        (
                            name: "0.5",
                        ),
                        (
                            name: "0.6",
                        ),
                        (
                            name: "0.7",
                        ),
                        (
                            name: "0.8",
                        ),
                        (
                            name: "0.9",
                        ),
                        (
                            name: "1.0",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--stop-position",
            ],
            description: Some("Stop (exit) at some position in the log (does not work with STDIN)"),
            arguments: [
                (
                    name: "position",
                    description: Some("The stop position in the log"),
                    suggestions: [
                        (
                            name: "random",
                        ),
                        (
                            name: "0.0",
                        ),
                        (
                            name: "0.1",
                        ),
                        (
                            name: "0.2",
                        ),
                        (
                            name: "0.3",
                        ),
                        (
                            name: "0.4",
                        ),
                        (
                            name: "0.5",
                        ),
                        (
                            name: "0.6",
                        ),
                        (
                            name: "0.7",
                        ),
                        (
                            name: "0.8",
                        ),
                        (
                            name: "0.9",
                        ),
                        (
                            name: "1.0",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-t",
                "--stop-at-time",
            ],
            description: Some("Stop (exit) after a specified number of seconds"),
            arguments: [
                (
                    name: "seconds",
                    description: Some("The number of seconds to wait before stopping"),
                ),
            ],
        ),
        (
            names: [
                "--stop-at-end",
            ],
            description: Some("Stop (exit) at the end of the log / stream"),
        ),
        (
            names: [
                "--loop",
            ],
            description: Some("Loop back to the start of the log when the end is reached"),
        ),
        (
            names: [
                "--loop-delay-seconds",
            ],
            description: Some("Seconds to delay before looping"),
            arguments: [
                (
                    name: "seconds",
                ),
            ],
        ),
        (
            names: [
                "-a",
                "--auto-skip-seconds",
            ],
            description: Some("Automatically skip to next entry if nothing happens for a specified number of seconds"),
            arguments: [
                (
                    name: "seconds",
                ),
            ],
        ),
        (
            names: [
                "-s",
                "--seconds-per-day",
            ],
            description: Some("Speed of simulation in seconds per day"),
            arguments: [
                (
                    name: "seconds",
                ),
            ],
        ),
        (
            names: [
                "--realtime",
            ],
            description: Some("Realtime playback speed"),
        ),
        (
            names: [
                "--no-time-travel",
            ],
            description: Some("Use the time of the last commit if the time of a commit is in the past"),
        ),
        (
            names: [
                "-c",
                "--time-scale",
            ],
            description: Some("Change simulation time scale"),
        ),
        (
            names: [
                "-i",
                "--file-idle-time",
            ],
            description: Some("Time in seconds files remain idle before they are removed or 0 for no limit"),
        ),
        (
            names: [
                "--file-idle-time-at-end",
            ],
            description: Some("Time in seconds files remain idle at the end before they are removed"),
            arguments: [
                (
                    name: "seconds",
                ),
            ],
        ),
        (
            names: [
                "-e",
                "--elasticity",
            ],
            description: Some("Elasticity of nodes"),
            arguments: [
                (
                    name: "elasticity",
                    description: Some("Elasticity of nodes"),
                ),
            ],
        ),
        (
            names: [
                "-b",
                "--background-colour",
            ],
            description: Some("Background colour in hex"),
            arguments: [
                (
                    name: "colour",
                ),
            ],
        ),
        (
            names: [
                "--background-image",
            ],
            description: Some("Set a background image"),
            arguments: [
                (
                    name: "image file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--title",
            ],
            description: Some("Set a title"),
            arguments: [
                (
                    name: "title",
                ),
            ],
        ),
        (
            names: [
                "--font-file",
            ],
            description: Some("Specify the font. Should work with most font file formats supported by FreeType, such as TTF and OTF, among others"),
            arguments: [
                (
                    name: "font file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--font-scale",
            ],
            description: Some("Scale the size of all fonts"),
            arguments: [
                (
                    name: "scale",
                    description: Some("Font scale"),
                ),
            ],
        ),
        (
            names: [
                "--font-size",
            ],
            description: Some("Font size used by the date and title"),
            arguments: [
                (
                    name: "size",
                    description: Some("Font size"),
                ),
            ],
        ),
        (
            names: [
                "--file-font-size",
            ],
            description: Some("Font size of filenames"),
            arguments: [
                (
                    name: "size",
                    description: Some("Font size"),
                ),
            ],
        ),
        (
            names: [
                "--dir-font-size",
            ],
            description: Some("Font size of directory names"),
            arguments: [
                (
                    name: "size",
                    description: Some("Font size"),
                ),
            ],
        ),
        (
            names: [
                "--user-font-size",
            ],
            description: Some("Font size of user names"),
            arguments: [
                (
                    name: "size",
                    description: Some("Font size"),
                ),
            ],
        ),
        (
            names: [
                "--font-colour",
            ],
            description: Some("Font colour used by the date and title in hex"),
            arguments: [
                (
                    name: "colour",
                    description: Some("Font colour"),
                ),
            ],
        ),
        (
            names: [
                "--key",
            ],
            description: Some("Show file extension key"),
        ),
        (
            names: [
                "--logo",
            ],
            description: Some("Logo to display in the foreground"),
            arguments: [
                (
                    name: "image file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--logo-offset",
            ],
            description: Some("Offset position of the logo"),
            arguments: [
                (
                    name: "offset",
                    description: Some("Logo offset"),
                ),
            ],
        ),
        (
            names: [
                "--date-format",
            ],
            description: Some("Specify display date string (strftime format)"),
            arguments: [
                (
                    name: "format",
                    description: Some("Date format"),
                ),
            ],
        ),
        (
            names: [
                "--log-command",
            ],
            description: Some("Show the log command used by gource (git,svn,hg,bzr,cvs2cl)"),
            arguments: [
                (
                    name: "command",
                    description: Some("Log command"),
                    suggestions: [
                        (
                            name: "git",
                        ),
                        (
                            name: "svn",
                        ),
                        (
                            name: "hg",
                        ),
                        (
                            name: "bzr",
                        ),
                        (
                            name: "cvs2cl",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--log-format",
            ],
            description: Some("Specify format of the log being read (git,svn,hg,bzr,cvs2cl,custom). Required when reading from STDIN"),
            arguments: [
                (
                    name: "format",
                    description: Some("Log format"),
                    suggestions: [
                        (
                            name: "git",
                        ),
                        (
                            name: "svn",
                        ),
                        (
                            name: "hg",
                        ),
                        (
                            name: "bzr",
                        ),
                        (
                            name: "cvs2cl",
                        ),
                        (
                            name: "custom",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--git-branch",
            ],
            description: Some("Get the git log of a branch other than the current one"),
            arguments: [
                (
                    name: "branch",
                ),
            ],
        ),
        (
            names: [
                "--follow-user",
            ],
            description: Some("Have the camera automatically follow a particular user"),
            arguments: [
                (
                    name: "username",
                    description: Some("Name of user to follow"),
                ),
            ],
        ),
        (
            names: [
                "--highlight-dirs",
            ],
            description: Some("Highlight the names of all directories"),
        ),
        (
            names: [
                "--highlight-user",
            ],
            description: Some("Highlight the names of a particular user"),
            arguments: [
                (
                    name: "username",
                    description: Some("Name of user to highlight"),
                ),
            ],
        ),
        (
            names: [
                "--highlight-users",
            ],
            description: Some("Highlight the names of all users"),
        ),
        (
            names: [
                "--highlight-colour",
            ],
            description: Some("Font colour for highlighted users in hex"),
            arguments: [
                (
                    name: "colour",
                    description: Some("Font colour (HEX)"),
                ),
            ],
        ),
        (
            names: [
                "--selection-colour",
            ],
            description: Some("Font colour for selected users and files"),
            arguments: [
                (
                    name: "colour",
                    description: Some("Font colour (HEX)"),
                ),
            ],
        ),
        (
            names: [
                "--filename-colour",
            ],
            description: Some("Font colour for filenames"),
            arguments: [
                (
                    name: "colour",
                    description: Some("Font colour (HEX)"),
                ),
            ],
        ),
        (
            names: [
                "--dir-colour",
            ],
            description: Some("Font colour for directories"),
            arguments: [
                (
                    name: "color",
                    description: Some("Dir colour (HEX)"),
                ),
            ],
        ),
        (
            names: [
                "--dir-name-depth",
            ],
            description: Some("Draw names of directories down to a specific depth in the tree"),
            arguments: [
                (
                    name: "depth",
                ),
            ],
        ),
        (
            names: [
                "--dir-name-position",
            ],
            description: Some("Position along edge of the directory name (between 0.1 and 1.0, default is 0.5)"),
            arguments: [
                (
                    name: "position",
                    suggestions: [
                        (
                            name: "0.1",
                        ),
                        (
                            name: "0.2",
                        ),
                        (
                            name: "0.3",
                        ),
                        (
                            name: "0.4",
                        ),
                        (
                            name: "0.5",
                        ),
                        (
                            name: "0.6",
                        ),
                        (
                            name: "0.7",
                        ),
                        (
                            name: "0.8",
                        ),
                        (
                            name: "0.9",
                        ),
                        (
                            name: "1.0",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--filename-time",
            ],
            description: Some("Duration to keep filenames on screen (>= 2.0)"),
            arguments: [
                (
                    name: "time",
                ),
            ],
        ),
        (
            names: [
                "--file-extensions",
            ],
            description: Some("Show filename extensions only"),
        ),
        (
            names: [
                "--file-extension-fallback",
            ],
            description: Some("Use filename as extension if the extension is missing or empty"),
        ),
        (
            names: [
                "--file-filter",
            ],
            description: Some("Filter out file paths matching the specified regular expression"),
            arguments: [
                (
                    name: "regex",
                ),
            ],
        ),
        (
            names: [
                "--file-show-filter",
            ],
            description: Some("Show only file paths matching the specified regular expression"),
            arguments: [
                (
                    name: "regex",
                ),
            ],
        ),
        (
            names: [
                "--user-filter",
            ],
            description: Some("Filter usernames matching the specified regular expression"),
            arguments: [
                (
                    name: "regex",
                ),
            ],
        ),
        (
            names: [
                "--user-show-filter",
            ],
            description: Some("Show only usernames matching the specified regular expression"),
            arguments: [
                (
                    name: "regex",
                ),
            ],
        ),
        (
            names: [
                "--user-image-dir",
            ],
            description: Some("Directory containing .jpg or .png images of users (eg 'Full Name.png') to use as avatars"),
            arguments: [
                (
                    name: "directory",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--default-user-image",
            ],
            description: Some("Path of .jpg to use as the default user image"),
            arguments: [
                (
                    name: "User image",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--fixed-user-size",
            ],
            description: Some("Forces the size of the user image to remain fixed throughout"),
        ),
        (
            names: [
                "--colour-images",
            ],
            description: Some("Colourize user images"),
        ),
        (
            names: [
                "--crop",
            ],
            description: Some("Crop view on an axis (vertical,horizontal)"),
            arguments: [
                (
                    name: "axis",
                ),
            ],
        ),
        (
            names: [
                "--padding",
            ],
            description: Some("Camera view padding"),
            arguments: [
                (
                    name: "padding",
                ),
            ],
        ),
        (
            names: [
                "--multi-sampling",
            ],
            description: Some("Enable multi-sampling"),
        ),
        (
            names: [
                "--no-vsync",
            ],
            description: Some("Disable vsync"),
        ),
        (
            names: [
                "--bloom-multiplier",
            ],
            description: Some("Adjust the amount of bloom"),
            arguments: [
                (
                    name: "multiplier",
                ),
            ],
        ),
        (
            names: [
                "--bloom-intensity",
            ],
            description: Some("Adjust the intensity of the bloom"),
            arguments: [
                (
                    name: "intensity",
                ),
            ],
        ),
        (
            names: [
                "--max-files",
            ],
            description: Some("Set the maximum number of files or 0 for no limit. Excess files will be discarded"),
            arguments: [
                (
                    name: "number",
                ),
            ],
        ),
        (
            names: [
                "--max-file-lag",
            ],
            description: Some("Max time files of a commit can take to appear. Use -1 for no limit"),
            arguments: [
                (
                    name: "seconds",
                ),
            ],
        ),
        (
            names: [
                "--max-user-speed",
            ],
            description: Some("Max speed users can travel per second"),
            arguments: [
                (
                    name: "units",
                ),
            ],
        ),
        (
            names: [
                "--user-friction",
            ],
            description: Some("Time users take to come to a halt"),
            arguments: [
                (
                    name: "seconds",
                ),
            ],
        ),
        (
            names: [
                "--user-scale",
            ],
            description: Some("Change scale of user avatars"),
            arguments: [
                (
                    name: "scale",
                ),
            ],
        ),
        (
            names: [
                "--camera-mode",
            ],
            description: Some("Camera mode (overview,track)"),
            arguments: [
                (
                    name: "mode",
                    suggestions: [
                        (
                            name: "overview",
                        ),
                        (
                            name: "track",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--disable-auto-rotate",
            ],
            description: Some("Disable automatic camera rotation"),
        ),
        (
            names: [
                "--disable-input",
            ],
            description: Some("Disable keyboard and mouse input"),
        ),
        (
            names: [
                "--hide",
            ],
            description: Some("Hide one or more display elements from the list below: bloom - bloom effect date - current date dirnames - names of directories files - file icons filenames - names of files mouse - mouse cursor progress - progress bar widget root - root directory of the tree tree - animated tree structure users - user avatars usernames - names of users"),
            arguments: [
                (
                    name: "element",
                    description: Some("Element to hide (Separate multiple elements with commas (eg \"mouse,progress\"))"),
                    suggestions: [
                        (
                            name: "bloom",
                        ),
                        (
                            name: "date",
                        ),
                        (
                            name: "dirnames",
                        ),
                        (
                            name: "files",
                        ),
                        (
                            name: "filenames",
                        ),
                        (
                            name: "mouse",
                        ),
                        (
                            name: "progress",
                        ),
                        (
                            name: "root",
                        ),
                        (
                            name: "tree",
                        ),
                        (
                            name: "users",
                        ),
                        (
                            name: "usernames",
                        ),
                    ],
                    variadic: true,
                ),
            ],
        ),
        (
            names: [
                "--hash-seed",
            ],
            description: Some("Change the seed of hash function"),
            arguments: [
                (
                    name: "seed",
                ),
            ],
        ),
        (
            names: [
                "--caption-file",
            ],
            description: Some("Caption file (see Caption Log Format)"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--caption-size",
            ],
            description: Some("Caption size"),
            arguments: [
                (
                    name: "size",
                ),
            ],
        ),
        (
            names: [
                "--caption-colour",
            ],
            description: Some("Caption colour in hex"),
            arguments: [
                (
                    name: "colour",
                    description: Some("Colour in hex (eg #ff0000)"),
                ),
            ],
        ),
        (
            names: [
                "--caption-duration",
            ],
            description: Some("Caption duration"),
            arguments: [
                (
                    name: "seconds",
                ),
            ],
        ),
        (
            names: [
                "--caption-offset",
            ],
            description: Some("Caption horizontal offset (0 to centre captions)"),
            arguments: [
                (
                    name: "offset",
                ),
            ],
        ),
        (
            names: [
                "-o",
                "--output-ppm-stream",
            ],
            description: Some("Output a PPM image stream to a file ('-' for STDOUT). This will automatically hide the progress bar initially and enable 'stop-at-end' unless other behaviour is specified"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-r",
                "--output-framerate",
            ],
            description: Some("Framerate of output (25,30,60). Used with --output-ppm-stream"),
            arguments: [
                (
                    name: "fps",
                    suggestions: [
                        (
                            name: "25",
                        ),
                        (
                            name: "30",
                        ),
                        (
                            name: "60",
                        ),
                        (
                            name: "120",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--output-custom-log",
            ],
            description: Some("Output a custom format log file ('-' for STDOUT)"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--load-config",
            ],
            description: Some("Load a config file"),
            arguments: [
                (
                    name: "config file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--save-config",
            ],
            description: Some("Save a config file with the current options"),
            arguments: [
                (
                    name: "config file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--path",
            ],
            description: Some("Either a supported version control directory, a pre-generated log file (see log commands or the custom log format), a Gource conf file or '-' to read STDIN"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
    ],
)
