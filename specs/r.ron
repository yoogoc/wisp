                            ],
                            description: Some("Add MD5 sums"),
                        ),
                        (
                            names: [
                                "--log",
                            ],
                            description: Some("Log to file 'pkg-00build.log' when processing the pkgdir with basename 'pkg'"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "pakgdirs",
                            description: Some("Package directories"),
                            generators: [
                                (
                                    template: [
                                        Folders,
                                    ],
                                ),
                            ],
                            variadic: true,
                        ),
                    ],
                    presentation: (
                        icon: Some("🛠"),
                    ),
                ),
