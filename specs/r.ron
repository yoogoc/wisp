(
    version: 1,
    command: "R",
    description: Some("Start R or invoke an R tool using CMD"),
    subcommands: [
        (
            name: "RHOME",
            description: Some("Print path to R home directory and exit"),
        ),
        (
            name: "CMD",
            description: Some("Invoke an R tool"),
            subcommands: [
                (
                    name: "BATCH",
                    description: Some("Batch Execution of R"),
                    options: [
                        (
                            names: [
                                "--help",
                                "-h",
                            ],
                            description: Some("Print help message and exit"),
                            presentation: (
                                icon: Some("❔"),
                            ),
                        ),
                        (
                            names: [
                                "--version",
                                "-v",
                            ],
                            description: Some("Print version info and exit"),
                            presentation: (
                                icon: Some("📣"),
                            ),
                        ),
                        (
                            names: [
                                "--no-timing",
                            ],
                            description: Some("Do not report the timings"),
                        ),
                        (
                            names: [
                                "--",
                            ],
                            description: Some("End processing of options"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "infile",
                            description: Some("A file with R code to be executed"),
                            generators: [
                                (
                                    has_custom: true,
                                    has_dynamic_trigger: true,
                                    has_dynamic_query_term: true,
                                ),
                            ],
                        ),
                        (
                            name: "outfile",
                            description: Some("A file to which to write output. If not given, the name used is that of infile, with a possible .R extension stripped, and .Rout appended"),
                        ),
                    ],
                ),
                (
                    name: "COMPILE",
                    description: Some("Compile files for use with R (not available on Windows)"),
                    options: [
                        (
                            names: [
                                "--help",
                                "-h",
                            ],
                            description: Some("Print help message and exit"),
                            presentation: (
                                icon: Some("❔"),
                            ),
                        ),
                        (
                            names: [
                                "--version",
                                "-v",
                            ],
                            description: Some("Print version info and exit"),
                            presentation: (
                                icon: Some("📣"),
                            ),
                        ),
                    ],
                    arguments: [
                        (
                            name: "files",
                            description: Some("Source files to be compiled"),
                            generators: [
                                (
                                    has_custom: true,
                                    has_dynamic_trigger: true,
                                    has_dynamic_query_term: true,
                                ),
                            ],
                            variadic: true,
                        ),
                    ],
                ),
                (
                    name: "SHLIB",
                    description: Some("Compile the given source files and then link all specified object files"),
                    options: [
                        (
                            names: [
                                "--help",
                                "-h",
                            ],
                            description: Some("Print help message and exit"),
                            presentation: (
                                icon: Some("❔"),
                            ),
                        ),
                        (
                            names: [
                                "--version",
                                "-v",
                            ],
                            description: Some("Print version info and exit"),
                            presentation: (
                                icon: Some("📣"),
                            ),
                        ),
                        (
                            names: [
                                "--clean",
                                "-c",
                            ],
                            description: Some("Remove files created during compilation"),
                        ),
                        (
                            names: [
                                "--preclean",
                            ],
                            description: Some("Remove files created during a previous run"),
                        ),
                        (
                            names: [
                                "--output",
                                "-o",
                            ],
                            description: Some("Name for the built library"),
                            arguments: [
                                (
                                    name: "LIB",
                                    description: Some("Full name for the built library"),
                                ),
                            ],
                            requires_separator: Some("="),
                        ),
                        (
                            names: [
                                "--dry-run",
                                "-n",
                            ],
                            description: Some("Dry run; shows commands that would be used"),
                        ),
                        (
                            names: [
                                "--use-LTO",
                            ],
                            description: Some("Use Link-Time Optimization"),
                            exclusive_on: [
                                "--no-use-LTO",
                            ],
                        ),
                        (
                            names: [
                                "--no-use-LTO",
                            ],
                            description: Some("Do not use Link-Time Optimization"),
                            exclusive_on: [
                                "--use-LTO",
                            ],
                        ),
                        (
                            names: [
                                "--debug",
                                "-d",
                            ],
                            description: Some("Build a debug DLL (Windows only)"),
                            presentation: (
                                icon: Some("🪲"),
                            ),
                        ),
                    ],
                    arguments: [
                        (
                            name: "files",
                            description: Some("The object files to be included in the shared object/DLL"),
                            generators: [
                                (
                                    has_custom: true,
                                    has_dynamic_trigger: true,
                                    has_dynamic_query_term: true,
                                ),
                            ],
                            variadic: true,
                        ),
                    ],
                ),
                (
                    name: "INSTALL",
                    description: Some("Utility for installing add-on packages"),
                    options: [
                        (
                            names: [
                                "--help",
                                "-h",
                            ],
                            description: Some("Print help message and exit"),
                            presentation: (
                                icon: Some("❔"),
                            ),
                        ),
                        (
                            names: [
                                "--version",
                                "-v",
                            ],
                            description: Some("Print version info and exit"),
                            presentation: (
                                icon: Some("📣"),
                            ),
                        ),
                        (
                            names: [
                                "--clean",
                                "-c",
                            ],
                            description: Some("Remove files created during compilation"),
                        ),
                        (
                            names: [
                                "--preclean",
                            ],
                            description: Some("Remove files created during a previous run"),
                        ),
                        (
                            names: [
                                "--debug",
                                "-d",
                            ],
                            description: Some("Turn on debugging messages"),
                            presentation: (
                                icon: Some("🪲"),
                            ),
                        ),
                        (
                            names: [
                                "--library",
                                "-l",
                            ],
                            description: Some("Install packages to library tree LIB"),
                            arguments: [
                                (
                                    name: "LIB",
                                    description: Some("Path to the R library tree to install to"),
                                    generators: [
                                        (
                                            script: [
                                                "Rscript",
                                                "-e",
                                                ".libPaths()",
                                            ],
                                            has_post_process: true,
                                        ),
                                    ],
                                ),
                            ],
                            requires_separator: Some("="),
                        ),
                        (
                            names: [
                                "--no-configure",
                            ],
                            description: Some("Do not use the package's configure script"),
                        ),
                        (
                            names: [
                                "--no-docs",
                            ],
                            description: Some("Do not install HTML, LaTeX or examples help"),
                        ),
                        (
                            names: [
                                "--html",
                            ],
                            description: Some("Build HTML help"),
                            exclusive_on: [
                                "--no-html",
                            ],
                        ),
                        (
                            names: [
                                "--no-html",
                            ],
                            description: Some("Do not build HTML help"),
                            exclusive_on: [
                                "--html",
                            ],
                        ),
                        (
                            names: [
                                "--latex",
                            ],
                            description: Some("Install LaTeX help"),
                        ),
                        (
                            names: [
                                "--example",
                            ],
                            description: Some("Install R code for help examples"),
                        ),
                        (
                            names: [
                                "--fake",
                            ],
                            description: Some("Do minimal install for testing purposes"),
                        ),
                        (
                            names: [
                                "--no-lock",
                            ],
                            description: Some("Install on top of any existing installation without using a lock directory"),
                            exclusive_on: [
                                "--lock",
                                "--pkglock",
                            ],
                        ),
                        (
                            names: [
                                "--lock",
                            ],
                            description: Some("Use a per-library lock directory (default)"),
                            exclusive_on: [
                                "--no-lock",
                                "--pkglock",
                            ],
                        ),
                        (
                            names: [
                                "--pkglock",
                            ],
                            description: Some("Use a per-package lock directory (default for a single package)"),
                            exclusive_on: [
                                "--no-lock",
                                "--lock",
                            ],
                        ),
                        (
                            names: [
                                "--build",
                            ],
                            description: Some("Build binaries of the installed package(s)"),
                            presentation: (
                                icon: Some("🛠"),
                            ),
                        ),
                        (
                            names: [
                                "--install-tests",
                            ],
                            description: Some("Install package-specific tests (if any)"),
                        ),
                        (
                            names: [
                                "--no-R",
                            ],
                            description: Some("Suppress installation of the package R code"),
                        ),
                        (
                            names: [
                                "--no-libs",
                            ],
                            description: Some("Suppress installation of the package libs"),
                        ),
                        (
                            names: [
                                "--no-data",
                            ],
                            description: Some("Suppress installation of the package data"),
                        ),
                        (
                            names: [
                                "--no-help",
                            ],
                            description: Some("Suppress installation of the package help"),
                        ),
                        (
                            names: [
                                "--no-demo",
                            ],
                            description: Some("Suppress installation of the package demo"),
                        ),
                        (
                            names: [
                                "--no-exec",
                            ],
                            description: Some("Suppress installation of the 'exec' directory"),
                        ),
                        (
                            names: [
                                "--no-inst",
                            ],
                            description: Some("Suppress installation of the 'inst' directory"),
                        ),
                        (
                            names: [
                                "--no-multiarch",
                            ],
                            description: Some("Build only the main architecture"),
                        ),
                        (
                            names: [
                                "--libs-only",
                            ],
                            description: Some("Only install the libs directory"),
                        ),
                        (
                            names: [
                                "--data-compress",
                            ],
                            description: Some("Compression to be used for lazy-loading of data"),
                            arguments: [
                                (
                                    name: "compression",
                                    description: Some("Compression method"),
                                    suggestions: [
                                        (
                                            name: "gzip",
                                        ),
                                        (
                                            name: "none",
                                        ),
                                        (
                                            name: "bzip2",
                                        ),
                                        (
                                            name: "xz",
                                        ),
                                    ],
                                    default: Some("gzip"),
                                ),
                            ],
                            requires_separator: Some("="),
                        ),
                        (
                            names: [
                                "--resave-data",
                            ],
                            description: Some("Re-save data files as compactly as possible"),
                        ),
                        (
                            names: [
                                "--compact-docs",
                            ],
                            description: Some("Re-compress PDF files under inst/doc"),
                        ),
                        (
                            names: [
                                "--with-keep.source",
                            ],
                            description: Some("'keep.source' for R code"),
                            exclusive_on: [
                                "--without-keep.source",
                            ],
                        ),
                        (
                            names: [
                                "--without-keep.source",
                            ],
                            description: Some("Do not use 'keep.source' for R code"),
                            exclusive_on: [
                                "--with-keep.source",
                            ],
                        ),
                        (
                            names: [
                                "--with-keep.parse.data",
                            ],
                            description: Some("Use 'keep.parse.data' for R code"),
                            exclusive_on: [
                                "--without-keep.parse.data",
                            ],
                        ),
                        (
                            names: [
                                "--without-keep.parse.data",
                            ],
                            description: Some("Do not 'keep.parse.data' for R code"),
                            exclusive_on: [
                                "--with-keep.parse.data",
                            ],
                        ),
                        (
                            names: [
                                "--byte-compile",
                            ],
                            description: Some("Byte-compile R code"),
                            exclusive_on: [
                                "--no-byte-compile",
                            ],
                        ),
                        (
                            names: [
                                "--no-byte-compile",
                            ],
                            description: Some("Do not byte-compile R code"),
                            exclusive_on: [
                                "--byte-compile",
                            ],
                        ),
                        (
                            names: [
                                "--staged-install",
                            ],
                            description: Some("Install to a temporary directory and then move to the target directory (default)"),
                            exclusive_on: [
                                "--staged-install",
                            ],
                        ),
                        (
                            names: [
                                "--no-staged-install",
                            ],
                            description: Some("Install directly to the target directory"),
                            exclusive_on: [
                                "--no-staged-install",
                            ],
                        ),
                        (
                            names: [
                                "--no-test-load",
                            ],
                            description: Some("Skip test of loading installed package"),
                        ),
                        (
                            names: [
                                "--no-clean-on-error",
                            ],
                            description: Some("Do not remove installed package on error"),
                        ),
                        (
                            names: [
                                "--merge-multiarch",
                            ],
                            description: Some("Multi-arch by merging (from a single tarball only)"),
                        ),
                        (
                            names: [
                                "--use-vanilla",
                            ],
                            description: Some("Do not read any Renviron or Rprofile files"),
                        ),
                        (
                            names: [
                                "--use-LTO",
                            ],
                            description: Some("Use Link-Time Optimization"),
                            exclusive_on: [
                                "--no-use-LTO",
                            ],
                        ),
                        (
                            names: [
                                "--no-use-LTO",
                            ],
                            description: Some("Do not use Link-Time Optimization"),
                            exclusive_on: [
                                "--use-LTO",
                            ],
                        ),
                        (
                            names: [
                                "--configure-args",
                            ],
                            description: Some("Set arguments for the configure scripts"),
                            arguments: [
                                (
                                    name: "ARGS",
                                    description: Some("Arguments for the configure script"),
                                ),
                            ],
                            requires_separator: Some("="),
                        ),
                        (
                            names: [
                                "--configure-vars",
                            ],
                            description: Some("Set variables for the configure scripts"),
                            arguments: [
                                (
                                    name: "ARGS",
                                    description: Some("Variables for the configure scripts"),
                                ),
                            ],
                            requires_separator: Some("="),
                        ),
                        (
                            names: [
                                "--strip",
                            ],
                            description: Some("Strip shared object(s) (Unix only)"),
                        ),
                        (
                            names: [
                                "--strip-lib",
                            ],
                            description: Some("Strip static/dynamic libraries under 'lib/' (Unix only)"),
                        ),
                        (
                            names: [
                                "--dsym",
                            ],
                            description: Some("Generate dSYM directory (macOS only)"),
                        ),
                        (
                            names: [
                                "--built-timestamp",
                            ],
                            description: Some("Set timestamp for 'Built' entry in DESCRIPTION (Unix only)"),
                            arguments: [
                                (
                                    name: "STAMP",
                                    description: Some("A timestamp for the build (Unix only)"),
                                ),
                            ],
                            requires_separator: Some("="),
                        ),
                        (
                            names: [
                                "--force-biarch",
                            ],
                            description: Some("Attempt to build both architectures (Windows only)"),
                        ),
                        (
                            names: [
                                "--compile-both",
                            ],
                            description: Some("Compile both architectures on 32-bit Windows (Windows only)"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "packages",
                            description: Some("Directories with the package sources"),
                            generators: [
                                (
                                    template: [
                                        Folders,
                                    ],
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "REMOVE",
                    description: Some("Remove add-on packages"),
                    options: [
                        (
                            names: [
                                "--help",
                                "-h",
                            ],
                            description: Some("Print help message and exit"),
                            presentation: (
                                icon: Some("❔"),
                            ),
                        ),
                        (
                            names: [
                                "--version",
                                "-v",
                            ],
                            description: Some("Print version info and exit"),
                            presentation: (
                                icon: Some("📣"),
                            ),
                        ),
                        (
                            names: [
                                "--library",
                                "-l",
                            ],
                            description: Some("The library tree to remove from"),
                            arguments: [
                                (
                                    name: "LIB",
                                    description: Some("Library tree"),
                                    generators: [
                                        (
                                            script: [
                                                "Rscript",
                                                "-e",
                                                ".libPaths()",
                                            ],
                                            has_post_process: true,
                                        ),
                                    ],
                                ),
                            ],
                            requires_separator: Some("="),
                        ),
                    ],
                    arguments: [
                        (
                            name: "packages",
                            description: Some("Packages to remove"),
                            variadic: true,
                            dangerous: true,
                        ),
                    ],
                    presentation: (
                        icon: Some("🗑"),
                    ),
                ),
                (
                    name: "build",
                    description: Some("Build R packages from package sources"),
                    options: [
                        (
                            names: [
                                "--help",
                                "-h",
                            ],
                            description: Some("Print help message and exit"),
                            presentation: (
                                icon: Some("❔"),
                            ),
                        ),
                        (
                            names: [
                                "--version",
                                "-v",
                            ],
                            description: Some("Print version info and exit"),
                            presentation: (
                                icon: Some("📣"),
                            ),
                        ),
                        (
                            names: [
                                "--force",
                            ],
                            description: Some("Force removal of INDEX file"),
                            presentation: (
                                dangerous: true,
                            ),
                        ),
                        (
                            names: [
                                "--keep-empty-dirs",
                            ],
                            description: Some("Do not remove empty dirs"),
                        ),
                        (
                            names: [
                                "--no-build-vignettes",
                            ],
                            description: Some("Do not (re)build package vignettes"),
                        ),
                        (
                            names: [
                                "--no-manual",
                            ],
                            description: Some("Do not build the PDF manual"),
                        ),
                        (
                            names: [
                                "--resave-data",
                            ],
                            description: Some("Re-save data files as compactly as possible"),
                            arguments: [
                                (
                                    name: "Compression method",
                                    suggestions: [
                                        (
                                            name: "best",
                                        ),
                                        (
                                            name: "gzip",
                                        ),
                                        (
                                            name: "no",
                                        ),
                                    ],
                                    optional: true,
                                    default: Some("best"),
                                ),
                            ],
                            requires_separator: Some("="),
                            exclusive_on: [
                                "--no-resave-data",
                            ],
                        ),
                        (
                            names: [
                                "--no-resave-data",
                            ],
                            description: Some("Do not save data"),
                            exclusive_on: [
                                "--resave-data",
                            ],
                        ),
                        (
                            names: [
                                "--compact-vignettes",
                            ],
                            description: Some("Try to compact PDF files under 'inst/doc'"),
                            arguments: [
                                (
                                    name: "Compression method",
                                    suggestions: [
                                        (
                                            name: "no",
                                        ),
                                        (
                                            name: "qpdf",
                                        ),
                                        (
                                            name: "gs",
                                        ),
                                        (
                                            name: "gs+qpdf",
                                        ),
                                        (
                                            name: "both",
                                        ),
                                    ],
                                    optional: true,
                                    default: Some("no"),
                                ),
                            ],
                            requires_separator: Some("="),
                        ),
                        (
                            names: [
                                "--compression",
                            ],
                            description: Some("Type of compression to be used on tarball"),
                            arguments: [
                                (
                                    name: "Compression method",
                                    suggestions: [
                                        (
                                            name: "gzip",
                                        ),
                                        (
                                            name: "none",
                                        ),
                                        (
                                            name: "bzip2",
                                        ),
                                        (
                                            name: "xz",
                                        ),
                                    ],
                                    optional: true,
                                    default: Some("gzip"),
