(
    version: 1,
    command: "visudo",
    description: Some("Visudo edits the sudoers file, which defines the users and groups with administrator rights"),
    options: [
        (
            names: [
                "--check",
                "-c",
            ],
            description: Some("Checking existing sudoers file for syntax errors"),
        ),
        (
            names: [
                "--file",
                "-f",
            ],
            description: Some("Set an alternative sudoers file location"),
            arguments: [
                (
                    name: "New sudoers location",
                    description: Some("Specify the alternate sudoers file location"),
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Display a short help message"),
        ),
        (
            names: [
                "--quiet",
                "-q",
            ],
            description: Some("Enable quiet mode (syntax error not printed)"),
        ),
        (
            names: [
                "--strict",
                "-s",
            ],
            description: Some("Enable strict checking of the sudoers file"),
        ),
        (
            names: [
                "--version",
                "-V",
            ],
            description: Some("Display version and exit"),
        ),
        (
            names: [
                "--export",
                "-x",
            ],
            description: Some("Export JSON and write it to output_file"),
            arguments: [
                (
                    name: "Output file name",
                    template: [
                        FilePaths,
                    ],
                    suggest_current_token: true,
                ),
            ],
        ),
        (
            names: [
                "--perms",
                "-P",
            ],
            description: Some("Enforce default mode for the sudoers file"),
        ),
        (
            names: [
                "--owner",
                "-O",
            ],
            description: Some("Enforce the default ownership for the sudoers file"),
        ),
    ],
)
