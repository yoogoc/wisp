        (
            name: "listen",
            description: Some("Receives webhook events from Stripe locally"),
            options: [
                (
                    names: [
                        "--connect-headers",
                    ],
                    description: Some("A comma-separated list of custom HTTP headers to any connected accounts"),
                    arguments: [
                        (
                            name: "values",
                            description: Some("Key1:Value1, Key2:Value2"),
                            variadic: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "-e",
                        "--events",
                    ],
                    description: Some("A comma-separated list of which events to listen for"),
                    arguments: [
                        (
                            name: "events types",
                            suggestions: [
                                (
                                    name: "account.updated",
                                    description: Some("Occurs whenever an account status or property has changed"),
                                ),
                                (
                                    name: "account.application.authorized",
                                    description: Some("Occurs whenever a user authorizes an application. Sent to the related application only"),
                                ),
                                (
                                    name: "account.application.deauthorized",
                                    description: Some("Occurs whenever a user deauthorizes an application. Sent to the related application only"),
                                ),
                                (
                                    name: "account.external_account.created",
                                    description: Some("Occurs whenever an external account is created"),
                                ),
                                (
                                    name: "account.external_account.deleted",
                                    description: Some("Occurs whenever an external account is deleted"),
                                ),
                                (
                                    name: "account.external_account.updated",
                                    description: Some("Occurs whenever an external account is updated"),
                                ),
                                (
                                    name: "application_fee.created",
                                    description: Some("Occurs whenever an application fee is created on a charge"),
                                ),
                                (
                                    name: "application_fee.refunded",
                                    description: Some("Occurs whenever an application fee is refunded, whether from refunding a charge or from refunding the application fee directly. This includes partial refunds"),
                                ),
                                (
                                    name: "application_fee.refund.updated",
                                    description: Some("Occurs whenever an application fee refund is updated"),
                                ),
                                (
                                    name: "billing_portal.configuration.created",
                                    description: Some("Occurs whenever a portal configuration is created"),
                                ),
                                (
                                    name: "billing_portal.configuration.updated",
                                    description: Some("Occurs whenever a portal configuration is updated"),
                                ),
                                (
                                    name: "capability.updated",
                                    description: Some("Occurs whenever a capability has new requirements or a new status"),
                                ),
                                (
                                    name: "charge.expired",
                                    description: Some("Occurs whenever an uncaptured charge expires"),
                                ),
                                (
                                    name: "charge.pending",
                                    description: Some("Occurs whenever a pending charge is created"),
                                ),
                                (
                                    name: "charge.updated",
                                    description: Some("Occurs whenever a charge description or metadata is updated"),
                                ),
                                (
                                    name: "charge.dispute.closed",
                                    description: Some("Occurs when a dispute is closed and the dispute status changes to lost, warning_closed, or won"),
                                ),
                                (
                                    name: "charge.dispute.funds_reinstated",
                                    description: Some("Occurs when funds are reinstated to your account after a dispute is closed. This includes partially refunded payments"),
                                ),
                                (
                                    name: "charge.dispute.funds_withdrawn",
                                    description: Some("Occurs when funds are removed from your account due to a dispute"),
                                ),
                                (
                                    name: "charge.dispute.updated",
                                    description: Some("Occurs when the dispute is updated (usually with evidence)"),
                                ),
                                (
                                    name: "charge.refund.updated",
                                    description: Some("Occurs whenever a refund is updated, on selected payment methods"),
                                ),
