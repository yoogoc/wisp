(
    version: 1,
    command: "lsblk",
    description: Some("List block devices"),
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for lsblk"),
        ),
        (
            names: [
                "--version",
                "-V",
            ],
            description: Some("Show version for lsblk"),
        ),
        (
            names: [
                "--all",
                "-a",
            ],
            description: Some("Also list empty devices and RAM disk devices"),
        ),
        (
            names: [
                "--bytes",
                "-b",
            ],
            description: Some("Print the SIZE column in bytes"),
        ),
        (
            names: [
                "--discard",
                "-D",
            ],
            description: Some("Print information about the discarding capabilities (TRIM, UNMAP) for each device"),
        ),
        (
            names: [
                "--nodeps",
                "-d",
            ],
            description: Some("Do not print holder devices or slaves"),
        ),
        (
            names: [
                "--dedup",
                "-E",
            ],
            description: Some("Use column as a de-duplication key to de-duplicate output tree"),
            arguments: [
                (
                    name: "column",
                ),
            ],
        ),
        (
            names: [
                "--exclude",
                "-e",
            ],
            description: Some("Exclude the devices specified by the comma-separated list of major device numbers"),
            arguments: [
                (
                    name: "list",
                ),
            ],
        ),
        (
            names: [
                "--fs",
                "-f",
            ],
            description: Some("Output info about filesystems"),
        ),
        (
            names: [
                "--include",
                "-I",
            ],
            description: Some("Include devices specified by the comma-separated list of major device numbers"),
            arguments: [
                (
                    name: "list",
                ),
            ],
        ),
        (
            names: [
                "--ascii",
                "-i",
            ],
            description: Some("Use ASCII characters for tree formatting"),
        ),
        (
            names: [
                "--json",
                "-J",
            ],
            description: Some("Use JSON output format"),
        ),
        (
            names: [
                "--list",
                "-l",
            ],
            description: Some("Produce output in the form of a list"),
        ),
        (
            names: [
                "--merge",
                "-M",
            ],
            description: Some("Group parents of sub-trees to provide more readable output for RAIDs and Multi-path devices"),
        ),
        (
            names: [
                "--perms",
                "-m",
            ],
            description: Some("Output info about device owner, group and mode"),
        ),
        (
            names: [
                "--noheadings",
                "-n",
            ],
            description: Some("Do not print a header line"),
        ),
        (
            names: [
                "--output",
                "-o",
            ],
            description: Some("Specify which output columns to print"),
            arguments: [
                (
                    name: "list",
                    variadic: true,
                ),
            ],
        ),
        (
            names: [
                "--output-all",
                "-O",
            ],
            description: Some("Output all available columns"),
        ),
        (
            names: [
                "--pairs",
                "-P",
            ],
            description: Some("Produce output in the form of key-value pairs"),
        ),
        (
            names: [
                "--raw",
                "-r",
            ],
            description: Some("Produce output in raw format"),
        ),
        (
            names: [
                "--scsi",
                "-S",
            ],
            description: Some("Output info about SCSI devices only"),
        ),
        (
            names: [
                "--inverse",
                "-s",
            ],
            description: Some("Print dependencies in inverse order"),
        ),
        (
            names: [
                "--tree",
                "-T",
            ],
            description: Some("Force tree-like output format"),
            arguments: [
                (
                    name: "column",
                ),
            ],
        ),
        (
            names: [
                "--topology",
                "-t",
            ],
            description: Some("Output info about block-device topology"),
        ),
        (
            names: [
                "--width",
                "-w",
            ],
            description: Some("Specifies output width as a number of characters"),
            arguments: [
                (
                    name: "number",
                ),
            ],
        ),
        (
            names: [
                "--sort",
                "-x",
            ],
            description: Some("Sort output lines by column"),
            arguments: [
                (
                    name: "column",
                ),
            ],
        ),
        (
            names: [
                "--zoned",
                "-z",
            ],
            description: Some("Print the zone model for each device"),
        ),
        (
            names: [
                "--sysroot",
            ],
            description: Some("Gather data for a Linux instance other than the instance from which the lsblk command is issued"),
            arguments: [
                (
                    name: "directory",
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "device",
            description: Some("Device to list"),
            optional: true,
        ),
    ],
)
