                    ],
                    description: Some("In the `separateIndex` generation scheme, Agrippa creates one file for the component\'s code, and one `index` file, whose purpose is to allow importing exports from the component\'s directory elegantly (the import path can then be `<path>/<to>/<directory>/Component` instead of `<path>/<to>/<directory>/Component/Component`). Defaults to `true`"),
                    takes_value: true,
