(
    version: 1,
    command: "ng",
    description: Some("CLI interface for Angular"),
    subcommands: [
        (
            name: "new",
            description: Some("Create a new Angular app"),
            options: [
                (
                    names: [
                        "--create-application",
                    ],
                    description: Some("Create a default application?"),
                    arguments: [
                        (
                            name: "project",
                            suggestions: [
                                (
                                    name: "true",
                                ),
                                (
                                    name: "false",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "name",
                ),
            ],
        ),
        (
            name: "generate",
            description: Some("Generate new files"),
            subcommands: [
                (
                    name: "application",
                    description: Some("Generates a new application"),
                    options: [
                        (
                            names: [
                                "--style",
                            ],
                            arguments: [
                                (
                                    name: "extension",
                                    suggestions: [
                                        (
                                            name: "css",
                                        ),
                                        (
                                            name: "scss",
                                        ),
                                        (
                                            name: "sass",
                                        ),
                                        (
                                            name: "less",
                                        ),
                                        (
                                            name: "styl",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                    ],
                    arguments: [
                        (
                            name: "name",
                            description: Some("Name of the new app"),
                        ),
                    ],
                ),
                (
                    name: "component",
                    description: Some("Generate a new component"),
                    options: [
                        (
                            names: [
                                "--project",
                            ],
                            description: Some("Project name"),
                            arguments: [
                                (
                                    name: "",
                                    generators: [
                                        (
                                            script: [
                                                "ng",
                                                "config",
                                                "projects",
                                            ],
                                            has_post_process: true,
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--change-detection",
                                "-c",
                            ],
                            description: Some("The change detection strategy to use"),
                            arguments: [
                                (
                                    name: "strategy",
                                    suggestions: [
                                        (
                                            name: "Default",
                                        ),
                                        (
                                            name: "OnPush",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--display-block",
                                "-b",
                            ],
                            description: Some("Add :host block to styles"),
                            arguments: [
                                (
                                    name: "boolean",
                                    suggestions: [
                                        (
                                            name: "true",
                                        ),
                                        (
                                            name: "false",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--flat",
                            ],
                            description: Some("Create at the top level"),
                            arguments: [
                                (
                                    name: "boolean",
                                    suggestions: [
                                        (
                                            name: "true",
                                        ),
                                        (
                                            name: "false",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                    ],
                    arguments: [
                        (
                            name: "name",
                            description: Some("Component name"),
                            optional: true,
                        ),
                    ],
                ),
                (
                    name: "library",
                    description: Some("Generates a new library"),
                    arguments: [
                        (
                            name: "name",
                            optional: true,
                        ),
                    ],
                ),
                (
                    name: "class",
                    description: Some("Generates a class"),
                    options: [
                        (
                            names: [
                                "--project",
                            ],
                            description: Some("Project name"),
                            arguments: [
                                (
                                    name: "",
                                    generators: [
                                        (
                                            script: [
                                                "ng",
                                                "config",
                                                "projects",
                                            ],
                                            has_post_process: true,
                                        ),
                                    ],
                                ),
                            ],
                        ),
                    ],
                    arguments: [
                        (
                            name: "name",
                            optional: true,
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "schematic",
                ),
            ],
        ),
        (
            name: "version",
            description: Some("View your Angular CLI version (update for Angular 14+)"),
        ),
    ],
    options: [
        (
            names: [
                "--version",
            ],
            description: Some("View your Angular CLI version"),
        ),
    ],
)
