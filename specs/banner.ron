(
    version: 1,
    command: "banner",
    description: Some("Prints a large, high quality banner on the standard output"),
    options: [
        (
            names: [
                "-t",
            ],
            description: Some("Enable trace"),
        ),
        (
            names: [
                "-d",
            ],
            description: Some("Enable debug"),
        ),
        (
            names: [
                "-w",
            ],
            description: Some("Change the output from a width of 132 to width, suitable for a narrow terminal"),
        ),
    ],
    arguments: [
        (
            name: "text",
        ),
    ],
)
