(
    version: 1,
    command: "mkinitcpio",
    description: Some("Create an initial ramdisk environment"),
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for mkinitcpio"),
        ),
        (
            names: [
                "--version",
                "-V",
            ],
            description: Some("Display version information"),
        ),
        (
            names: [
                "--addhooks",
                "-A",
            ],
            description: Some("Add additional hooks to the image"),
            arguments: [
                (
                    name: "hooks",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--config",
                "-c",
            ],
            description: Some("Use config file to generate the ramdisk"),
            arguments: [
                (
                    name: "config",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--generatedir",
                "-d",
            ],
            description: Some("Set directory as the location where the initramfs is built"),
            arguments: [
                (
                    name: "directory",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--hookdir",
                "-D",
            ],
            description: Some("Set directory as the location where hooks will be searched for when generating the image"),
            arguments: [
                (
                    name: "directory",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--generate",
                "-g",
            ],
            description: Some("Generate a CPIO image as filename"),
            arguments: [
                (
                    name: "filename",
                ),
            ],
        ),
        (
            names: [
                "--hookhelp",
                "-H",
            ],
            description: Some("Output help for hookname"),
            arguments: [
                (
                    name: "hookname",
                ),
            ],
        ),
        (
            names: [
                "--kernel",
                "-k",
            ],
            description: Some("Use kernelversion, instead of the current running kernel"),
            arguments: [
                (
                    name: "kernelversion",
                ),
            ],
        ),
        (
            names: [
                "--listhooks",
                "-L",
            ],
            description: Some("List all available hooks"),
        ),
        (
            names: [
                "--automods",
                "-M",
            ],
            description: Some("Display modules found via autodetection"),
        ),
        (
            names: [
                "--nocolor",
                "-n",
            ],
            description: Some("Disable color output"),
        ),
        (
            names: [
                "--uefi",
                "-U",
            ],
            description: Some("Generate a UEFI executable as filename"),
            arguments: [
                (
                    name: "filename",
                ),
            ],
        ),
        (
            names: [
                "--allpresets",
                "-P",
            ],
            description: Some("Process all presets contained in /etc/mkinitcpio.d"),
        ),
        (
            names: [
                "--preset",
                "-p",
            ],
            description: Some("Build initramfs image(s) according to specified preset"),
            arguments: [
                (
                    name: "preset",
                    generators: [
                        (
                            script: [
                                "ls",
                                "/etc/mkinitcpio.d",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--moduleroot",
                "-r",
            ],
            description: Some("Specifies the root directory to find modules in"),
            arguments: [
                (
                    name: "root",
                ),
            ],
        ),
        (
            names: [
                "--skiphooks",
                "-S",
            ],
            description: Some("Skip hooks when generating the image"),
            arguments: [
                (
                    name: "hooks",
                ),
            ],
        ),
        (
            names: [
                "--save",
                "-s",
            ],
            description: Some("Saves the build directory for the initial ramdisk"),
        ),
        (
            names: [
                "--builddir",
                "-t",
            ],
            description: Some("Use tmpdir as the temporary build directory instead of /tmp"),
            arguments: [
                (
                    name: "tmpdir",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--verbose",
                "-v",
            ],
            description: Some("Verbose output"),
        ),
        (
            names: [
                "--compress",
                "-z",
            ],
            description: Some("Override the compression method with the compress program"),
            arguments: [
                (
                    name: "compress",
                ),
            ],
        ),
        (
            names: [
                "--cmdline",
            ],
            description: Some("Use kernel command line with UEFI executable"),
            arguments: [
                (
                    name: "filename",
                ),
            ],
        ),
        (
            names: [
                "--splash",
            ],
            description: Some("UEFI executables can show a bitmap file on boot"),
            arguments: [
                (
                    name: "filename",
                ),
            ],
        ),
        (
            names: [
                "--uefistub",
            ],
            description: Some("UEFI stub image used for UEFI executable generation"),
            arguments: [
                (
                    name: "filename",
                ),
            ],
        ),
        (
            names: [
                "--kernelimage",
            ],
            description: Some("Include a kernel image for the UEFI executable"),
            arguments: [
                (
                    name: "filename",
                ),
            ],
        ),
        (
            names: [
                "--microcode",
            ],
            description: Some("Include microcode into the UEFI executable"),
            arguments: [
                (
                    name: "filename",
                ),
            ],
        ),
        (
            names: [
                "--osrelease",
            ],
            description: Some("Include a os-release file for the UEFI executable"),
            arguments: [
                (
                    name: "filename",
                ),
            ],
        ),
    ],
)
