(
    version: 1,
    command: "vtex",
    description: Some("Fig autocomplete for VTEX IO's CLI - VTEX IO's CLI allows you to perform any action necessary to your development process, such as linking local files to the VTEX platform, managing workspaces, and releasing new app versions"),
    subcommands: [
        (
            name: "add",
            description: Some("Adds the specified app(s) to the manifest's dependencies"),
            options: [
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Show help for command"),
                    presentation: (
                        priority: Some(1.0),
                    ),
                ),
            ],
            arguments: [
                (
                    name: "APPID",
                    description: Some("Name and version ({vendor}.{appname}@{x.x.x}) of the dependency to include in the manifest.json file"),
                ),
                (
                    name: "ITHAPPID",
                    description: Some("Names and versions ({vendor}.{appname}@{x.x.x}) of the multiple dependencies to include in the manifest.json file"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "autoupdate",
            description: Some("Automatically updates VTEX IO's CLI"),
            options: [
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Show help for command"),
                    presentation: (
                        priority: Some(1.0),
                    ),
                ),
            ],
            arguments: [
                (
                    name: "CHANNEL",
                    description: Some("Channel to automatically updates"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "browse",
            description: Some("Opens the URL relative to your current workspace and account in a new browser window"),
            options: [
