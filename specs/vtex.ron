                    presentation: (
                        priority: Some(1.0),
                    ),
                ),
            ],
            arguments: [
                (
                    name: "PATH",
                    description: Some("Relative path from https://{workspace}--{account}.myvtex.com/"),
                    optional: true,
                ),
            ],
        ),
        (
