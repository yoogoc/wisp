(
    version: 1,
    command: "eslint",
    description: Some("Pluggable JavaScript linter"),
    options: [
        (
            names: [
                "--no-eslintrc",
            ],
            description: Some("Disable use of configuration from .eslintrc.*"),
        ),
        (
            names: [
                "-c",
                "--config",
            ],
            description: Some("Use this configuration, overriding .eslintrc.* config options if present"),
            arguments: [
                (
                    name: "",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--env",
            ],
            description: Some("Specify environments"),
            arguments: [
                (
                    name: "",
                    generators: [
                        (
                            has_custom: true,
                            trigger: Some(OnMatch([
                                    ",",
                                ])),
                            query_term: Some(AfterLast(",")),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--ext",
            ],
            description: Some("Specify JavaScript file extensions"),
            arguments: [
                (
                    name: "Extension",
                    default: Some(".js"),
                ),
            ],
        ),
        (
            names: [
                "--global",
            ],
            description: Some("Define global variables"),
            arguments: [
                (
                    name: "Variables",
                ),
            ],
        ),
        (
            names: [
                "--parser",
            ],
            description: Some("Specify the parser to be used"),
            arguments: [
                (
                    name: "",
                ),
            ],
        ),
        (
            names: [
                "--parser-options",
            ],
            description: Some("Specify parser options"),
            arguments: [
                (
                    name: "",
                ),
            ],
        ),
        (
            names: [
                "--resolve-plugins-relative-to",
            ],
            description: Some("A folder where plugins should be resolved from"),
            arguments: [
                (
                    name: "",
                    template: [
                        Folders,
                    ],
                    default: Some("CWD"),
                ),
            ],
        ),
        (
            names: [
                "--rulesdir",
            ],
            description: Some("Use additional rules from this directory"),
            arguments: [
                (
                    name: "",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--plugin",
            ],
            description: Some("Specify plugins"),
            arguments: [
                (
                    name: "Plugin",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "{ ls node_modules ; ls $(npm root -g) ; ls $(yarn global dir)/node_modules/ ; } | cat",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--rule",
            ],
            description: Some("Specify rules"),
            arguments: [
                (
                    name: "",
                ),
            ],
        ),
        (
            names: [
                "--fix",
            ],
            description: Some("Automatically fix problems"),
        ),
        (
            names: [
                "--fix-dry-run",
            ],
            description: Some("Automatically fix problems without saving the changes to the file system"),
        ),
        (
            names: [
                "--fix-type",
            ],
            description: Some("Specify the types of fixes to apply"),
            arguments: [
                (
                    name: "",
                    suggestions: [
                        (
                            name: "problem",
                        ),
                        (
                            name: "suggestion",
                        ),
                        (
                            name: "layout",
                        ),
                    ],
                ),
            ],
            depends_on: [
                "--fix",
                "--fix-dry-run",
            ],
        ),
        (
            names: [
                "--ignore-path",
            ],
            description: Some("Specify path of ignore file"),
            arguments: [
                (
                    name: "",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--no-ignore",
            ],
            description: Some("Disable use of ignore files and patterns"),
        ),
        (
            names: [
                "--ignore-pattern",
            ],
            description: Some("Pattern of files to ignore (in addition to those in .eslintignore)"),
            arguments: [
                (
                    name: "",
                ),
            ],
        ),
        (
            names: [
                "--stdin",
            ],
            description: Some("Lint code provided on <STDIN>"),
        ),
        (
            names: [
                "--stdin-filename",
            ],
            description: Some("Specify filename to process STDIN as"),
            arguments: [
                (
                    name: "",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--quiet",
            ],
            description: Some("Report errors only"),
        ),
        (
            names: [
                "--max-warnings",
            ],
            description: Some("Number of warnings to trigger nonzero exit code"),
            arguments: [
                (
                    name: "",
                    default: Some("-1"),
                ),
            ],
        ),
        (
            names: [
                "-o",
                "--output-file",
            ],
            description: Some("Specify file to write report to"),
            arguments: [
                (
                    name: "",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-f",
                "--format",
            ],
            description: Some("Use a specific output format"),
            arguments: [
                (
                    name: "",
                    suggestions: [
                        (
                            name: "checkstyle",
                        ),
                        (
                            name: "codeframe",
                        ),
                        (
                            name: "compact",
                        ),
                        (
                            name: "html",
                        ),
                        (
                            name: "jslint-xml",
                        ),
                        (
                            name: "json",
                        ),
                        (
                            name: "junit",
                        ),
                        (
                            name: "stylish",
                        ),
                        (
                            name: "table",
                        ),
                        (
                            name: "tap",
                        ),
                        (
                            name: "unix",
                        ),
                        (
                            name: "visualstudio",
                        ),
                    ],
                    default: Some("stylish"),
                ),
            ],
        ),
        (
            names: [
                "--color",
            ],
            description: Some("Force enabling of color"),
            exclusive_on: [
                "--no-color",
            ],
        ),
        (
            names: [
                "--no-color",
            ],
            description: Some("Force disabling of color"),
            exclusive_on: [
                "--color",
            ],
        ),
        (
            names: [
                "--no-inline-config",
            ],
            description: Some("Prevent comments from changing config or rules"),
        ),
        (
            names: [
                "--report-unused-disable-directives",
            ],
            description: Some("Adds reported errors for unused eslint-disable-directives"),
        ),
        (
            names: [
                "--cache",
            ],
            description: Some("Only check changed files"),
        ),
        (
            names: [
                "--cache-location",
            ],
            description: Some("Path to the cache file or directory"),
            arguments: [
                (
                    name: "",
                    template: [
                        FilePaths,
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--cache-strategy",
            ],
            description: Some("Strategy to use for detecting changed files"),
            arguments: [
                (
                    name: "",
                    suggestions: [
                        (
                            name: "metadata",
                        ),
                        (
                            name: "content",
                        ),
                    ],
                    default: Some("metadata"),
                ),
            ],
        ),
        (
            names: [
                "--init",
            ],
            description: Some("Run config initialization wizard"),
        ),
        (
            names: [
                "--env-info",
            ],
            description: Some("Output execution environment information"),
        ),
        (
            names: [
                "--no-error-on-unmatched-pattern",
            ],
            description: Some("Prevent errors when pattern is unmatched"),
        ),
        (
            names: [
                "--debug",
            ],
            description: Some("Output debugging information"),
        ),
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Show help"),
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Output the version number"),
        ),
        (
            names: [
                "--print-config",
            ],
            description: Some("Print the configuration for the give file"),
            arguments: [
                (
                    name: "",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "file|dir|glob",
            description: Some("File(s) to lint"),
            template: [
                FilePaths,
                Folders,
            ],
            variadic: true,
        ),
    ],
)
