(
    version: 1,
    command: "mix",
    description: Some("Build tool for Elixir"),
    subcommands: [
        (
            name: "new",
            description: Some("Creates a new Elixir project at the given path"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Output usage information"),
                ),
                (
                    names: [
                        "--app",
                    ],
                    description: Some("Name the OTP application for the project"),
                    arguments: [
                        (
                            name: "app",
                        ),
                    ],
                ),
                (
                    names: [
                        "--modules",
                    ],
                    description: Some("Name the modules in the generated code skeleton"),
                    arguments: [
                        (
                            name: "module",
                        ),
                    ],
                ),
                (
                    names: [
                        "--sup",
                    ],
                    description: Some("Generate an OTP application skeleton including a supervision tree. Normally an app is generated without a supervisor and without the app callback"),
                ),
                (
                    names: [
                        "--umbrella",
                    ],
                    description: Some("Generate an umbrella project"),
                ),
            ],
            arguments: [
                (
                    name: "path",
                ),
            ],
        ),
        (
            name: "run",
            description: Some("Starts the current application and runs code"),
            options: [
                (
                    names: [
                        "--config",
                    ],
                    description: Some("Loads the given configuration files"),
                    arguments: [
                        (
                            name: "file",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-e",
                        "--eval",
                    ],
                    description: Some("Evaluates the given code"),
                    arguments: [
                        (
                            name: "code",
                            description: Some("String containing code to execute"),
                            is_script: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "-r",
                        "--require",
                    ],
                    description: Some("Executes the given pattern/file"),
                    arguments: [
                        (
                            name: "file|pattern",
                            description: Some("The file|pattern to execute"),
                            generators: [
                                (
                                    has_custom: true,
                                    has_dynamic_trigger: true,
                                    has_dynamic_query_term: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-p",
                        "--parallel",
                    ],
                    description: Some("Executes the given pattern/file"),
                    arguments: [
                        (
                            name: "file|pattern",
                            generators: [
                                (
                                    has_custom: true,
                                    has_dynamic_trigger: true,
                                    has_dynamic_query_term: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--preload-modules",
                    ],
                    description: Some("Preloads all modules defined in applications"),
                ),
                (
                    names: [
                        "--no-compile",
                    ],
                    description: Some("Does not compile even if files require compilation"),
                ),
                (
                    names: [
                        "--no-deps-check",
                    ],
                    description: Some("Does not check dependencies"),
                ),
                (
                    names: [
                        "--no-archives-check",
                    ],
                    description: Some("Does not check archives"),
                ),
                (
                    names: [
                        "--no-halt",
                    ],
                    description: Some("Does not halt the system after running the command"),
                ),
                (
                    names: [
                        "--no-mix-exs",
                    ],
                    description: Some("Allows the command to run even if there is no mix.exs"),
                ),
                (
                    names: [
                        "--no-start",
                    ],
                    description: Some("Does not start applications after compilation"),
                ),
                (
                    names: [
                        "--no-elixir-version-check",
                    ],
                    description: Some("Does not check the Elixir version from mix.exs"),
                ),
            ],
            arguments: [
                (
                    name: "file",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "help",
            description: Some("Prints documentation for a given task (Lists all the tasks if no task is specified)"),
            options: [
                (
                    names: [
                        "--search",
                    ],
                    description: Some("Prints all tasks and aliases that contain 'pattern' in the name"),
                    arguments: [
                        (
                            name: "pattern",
                        ),
                    ],
                ),
                (
                    names: [
                        "--names",
                    ],
                    description: Some("Prints all task names and aliases"),
                ),
            ],
            arguments: [
                (
                    name: "task",
                    description: Some("Prints documentation for a given task"),
                    generators: [
                        (
                            script: [
                                "mix",
                                "help",
                            ],
                            has_post_process: true,
                            cache: Some((
                                ttl_ms: Some(10000),
                                stale_while_revalidate: true,
                            )),
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Shows usage information"),
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Shows versioning information"),
        ),
    ],
    arguments: [
        (
            name: "task",
            description: Some("Invokes the task (mix run) in a project"),
            generators: [
                (
                    script: [
                        "mix",
                        "help",
                    ],
                    has_post_process: true,
                    cache: Some((
                        ttl_ms: Some(10000),
                        stale_while_revalidate: true,
                    )),
                ),
            ],
            optional: true,
        ),
    ],
    presentation: (
        icon: Some("data:image/jpeg;base64,"),
    ),
)
