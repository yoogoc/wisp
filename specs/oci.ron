(
    version: 1,
    command: "oci",
    description: Some("Oracle Cloud Infrastructure CLI"),
    subcommands: [
        (
            name: "compute",
            description: Some("Manage Compute resources like instances and images"),
            subcommands: [
                (
                    name: "instance",
                    description: Some("Manage Compute instances"),
                    subcommands: [
                        (
                            name: "launch",
                            description: Some("Launch a new compute instance"),
                            options: [
                                (
                                    names: [
                                        "--availability-domain",
                                    ],
                                    description: Some("The availability domain of the instance"),
                                    required: true,
                                ),
                                (
                                    names: [
                                        "--compartment-id",
                                    ],
                                    description: Some("The OCID of the compartment"),
                                    required: true,
                                ),
                                (
                                    names: [
                                        "--shape",
                                    ],
                                    description: Some("The shape of the instance"),
                                    required: true,
                                ),
                            ],
                        ),
                        (
                            name: "terminate",
                            description: Some("Terminate a compute instance"),
                            options: [
                                (
                                    names: [
                                        "--instance-id",
                                    ],
                                    description: Some("The OCID of the instance"),
                                    required: true,
                                ),
                            ],
                        ),
                        (
                            name: "start",
                            description: Some("Start a stopped instance"),
                            options: [
                                (
                                    names: [
                                        "--instance-id",
                                    ],
                                    description: Some("The OCID of the instance"),
                                    required: true,
                                ),
                            ],
                        ),
                        (
                            name: "stop",
                            description: Some("Stop a running instance"),
                            options: [
                                (
                                    names: [
                                        "--instance-id",
                                    ],
                                    description: Some("The OCID of the instance"),
                                    required: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "image",
                    description: Some("Manage Custom Images"),
                    subcommands: [
                        (
                            name: "list",
                            description: Some("List available compute images"),
                            options: [
                                (
                                    names: [
                                        "--compartment-id",
                                    ],
                                    description: Some("The OCID of the compartment"),
                                    required: true,
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "network",
            description: Some("Manage Virtual Cloud Network resources"),
            subcommands: [
                (
                    name: "vcn",
                    description: Some("Manage Virtual Cloud Networks"),
                    subcommands: [
                        (
                            name: "create",
                            description: Some("Create a new VCN"),
                            options: [
                                (
                                    names: [
                                        "--compartment-id",
                                    ],
                                    description: Some("The OCID of the compartment"),
                                    required: true,
                                ),
                                (
                                    names: [
                                        "--cidr-block",
                                    ],
                                    description: Some("The CIDR block of the VCN"),
                                    required: true,
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "db",
            description: Some("Manage Database resources"),
            subcommands: [
                (
                    name: "autonomous-database",
                    description: Some("Manage Autonomous Databases"),
                    subcommands: [
                        (
                            name: "create",
                            description: Some("Create an Autonomous Database"),
                            options: [
                                (
                                    names: [
                                        "--compartment-id",
                                    ],
                                    description: Some("The OCID of the compartment"),
                                    required: true,
                                ),
                                (
                                    names: [
                                        "--db-name",
                                    ],
                                    description: Some("The database name"),
                                    required: true,
                                ),
                                (
                                    names: [
                                        "--cpu-core-count",
                                    ],
                                    description: Some("Number of CPU cores"),
                                    required: true,
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "os",
            description: Some("Object Storage commands"),
            subcommands: [
                (
                    name: "bucket",
                    description: Some("Manage buckets"),
                    subcommands: [
                        (
                            name: "create",
                            description: Some("Create a new bucket"),
                            options: [
                                (
                                    names: [
                                        "--compartment-id",
                                    ],
                                    description: Some("The OCID of the compartment"),
                                    required: true,
                                ),
                                (
                                    names: [
                                        "--name",
                                    ],
                                    description: Some("The name of the bucket"),
                                    required: true,
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "iam",
            description: Some("Manage Identity and Access Management resources"),
            subcommands: [
                (
                    name: "user",
                    description: Some("Manage users"),
                    subcommands: [
                        (
                            name: "create",
                            description: Some("Create a new user"),
                            options: [
                                (
                                    names: [
                                        "--name",
                                    ],
                                    description: Some("Name of the user"),
                                    required: true,
                                ),
                                (
                                    names: [
                                        "--description",
                                    ],
                                    description: Some("Description for the user"),
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "policy",
                    description: Some("Manage IAM policies"),
                    subcommands: [
                        (
                            name: "create",
                            description: Some("Create a new policy"),
                            options: [
                                (
                                    names: [
                                        "--name",
                                    ],
                                    description: Some("Name of the policy"),
                                    required: true,
                                ),
                                (
                                    names: [
                                        "--statements",
                                    ],
                                    description: Some("Policy statements"),
                                    required: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "group",
                    description: Some("Manage IAM groups"),
                    subcommands: [
                        (
                            name: "create",
                            description: Some("Create a new group"),
                            options: [
                                (
                                    names: [
                                        "--name",
                                    ],
                                    description: Some("The name of the group"),
                                    required: true,
                                ),
                                (
                                    names: [
                                        "--description",
                                    ],
                                    description: Some("Description for the group"),
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "compartment",
                    description: Some("Manage compartments"),
                    subcommands: [
                        (
                            name: "create",
                            description: Some("Create a new compartment"),
                            options: [
                                (
                                    names: [
                                        "--name",
                                    ],
                                    description: Some("The name of the compartment"),
                                    required: true,
                                ),
                                (
                                    names: [
                                        "--description",
                                    ],
                                    description: Some("Description for the compartment"),
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "kms",
            description: Some("Manage Key Management resources"),
            subcommands: [
                (
                    name: "key",
                    description: Some("Manage encryption keys"),
                    subcommands: [
                        (
                            name: "create",
                            description: Some("Create a new key"),
                            options: [
                                (
                                    names: [
                                        "--compartment-id",
                                    ],
                                    description: Some("The OCID of the compartment"),
                                    required: true,
                                ),
                                (
                                    names: [
                                        "--display-name",
                                    ],
                                    description: Some("Display name of the key"),
                                    required: true,
                                ),
                                (
                                    names: [
                                        "--key-shape",
                                    ],
                                    description: Some("Shape of the key"),
                                    arguments: [
                                        (
                                            name: "",
                                            suggestions: [
                                                (
                                                    name: "AES",
                                                ),
                                                (
                                                    name: "RSA",
                                                ),
                                                (
                                                    name: "ECDSA",
                                                ),
                                            ],
                                        ),
                                    ],
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "monitoring",
            description: Some("Manage Monitoring and Alerts"),
            subcommands: [
                (
                    name: "alarm",
                    description: Some("Manage monitoring alarms"),
                    subcommands: [
                        (
                            name: "create",
                            description: Some("Create a new alarm"),
                            options: [
                                (
                                    names: [
                                        "--display-name",
                                    ],
                                    description: Some("Display name of the alarm"),
                                    required: true,
                                ),
                                (
                                    names: [
                                        "--metric-compartment-id",
                                    ],
                                    description: Some("Compartment OCID containing the metric"),
                                    required: true,
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "budget",
            description: Some("Manage Budgets and Cost Controls"),
            subcommands: [
                (
                    name: "create",
                    description: Some("Create a new budget"),
                    options: [
                        (
                            names: [
                                "--compartment-id",
                            ],
                            description: Some("The OCID of the compartment"),
                            required: true,
                        ),
                        (
                            names: [
                                "--amount",
                            ],
                            description: Some("The amount for the budget"),
                            required: true,
                        ),
                        (
                            names: [
                                "--reset-period",
                            ],
                            description: Some("The reset period for the budget"),
                            arguments: [
                                (
                                    name: "",
                                    suggestions: [
                                        (
                                            name: "MONTHLY",
                                        ),
                                        (
                                            name: "YEARLY",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for oci"),
        ),
        (
            names: [
                "--profile",
                "-p",
            ],
            description: Some("The profile to load from the config file"),
            arguments: [
                (
                    name: "profile",
                    default: Some("DEFAULT"),
                ),
            ],
        ),
        (
            names: [
                "--config-file",
            ],
            description: Some("The path to the config file"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--region",
            ],
            description: Some("The region to make calls against"),
            arguments: [
                (
                    name: "",
                    suggestions: [
                        (
                            name: "us-ashburn-1",
                        ),
                        (
                            name: "us-phoenix-1",
                        ),
                        (
                            name: "us-chicago-1",
                        ),
                        (
                            name: "ca-montreal-1",
                        ),
                        (
                            name: "ca-toronto-1",
                        ),
                        (
                            name: "sa-saopaulo-1",
                        ),
                        (
                            name: "sa-vinhedo-1",
                        ),
                        (
                            name: "sa-santiago-1",
                        ),
                        (
                            name: "eu-frankfurt-1",
                        ),
                        (
                            name: "eu-amsterdam-1",
                        ),
                        (
                            name: "eu-zurich-1",
                        ),
                        (
                            name: "eu-madrid-1",
                        ),
                        (
                            name: "uk-london-1",
                        ),
                        (
                            name: "uk-cardiff-1",
                        ),
                        (
                            name: "ap-tokyo-1",
                        ),
                        (
                            name: "ap-osaka-1",
                        ),
                        (
                            name: "ap-seoul-1",
                        ),
                        (
                            name: "ap-sydney-1",
                        ),
                        (
                            name: "ap-melbourne-1",
                        ),
                        (
                            name: "ap-hyderabad-1",
                        ),
                        (
                            name: "ap-mumbai-1",
                        ),
                        (
                            name: "me-dubai-1",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--output",
            ],
            description: Some("The output format"),
            arguments: [
                (
                    name: "",
                    suggestions: [
                        (
                            name: "json",
                        ),
                        (
                            name: "table",
                        ),
                        (
                            name: "text",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--debug",
            ],
            description: Some("Turn on debug logging"),
        ),
        (
            names: [
                "--auth",
            ],
            description: Some("The type of auth to use"),
            arguments: [
                (
                    name: "",
                    suggestions: [
                        (
                            name: "api_key",
                        ),
                        (
                            name: "instance_principal",
                        ),
                        (
                            name: "resource_principal",
                        ),
                        (
                            name: "security_token",
                        ),
                        (
                            name: "raw_token",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--key-file",
            ],
            description: Some("The path to the private key file"),
            arguments: [
                (
                    name: "",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--wait-for-state",
            ],
            description: Some("Wait until resource reaches a given state"),
            arguments: [
                (
                    name: "",
                    suggestions: [
                        (
                            name: "ACCEPTED",
                        ),
                        (
                            name: "AVAILABLE",
                        ),
                        (
                            name: "RUNNING",
                        ),
                        (
                            name: "PROVISIONING",
                        ),
                        (
                            name: "STOPPED",
                        ),
                        (
                            name: "TERMINATED",
                        ),
                        (
                            name: "FAILED",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--wait-interval-seconds",
            ],
            description: Some("Check interval seconds for --wait-for-state"),
            arguments: [
                (
                    name: "seconds",
                    default: Some("30"),
                ),
            ],
        ),
        (
            names: [
                "--max-wait-seconds",
            ],
            description: Some("Maximum time to wait"),
            arguments: [
                (
                    name: "seconds",
                    default: Some("1200"),
                ),
            ],
        ),
        (
            names: [
                "--raw-output",
            ],
            description: Some("Output raw response from OCI API"),
        ),
        (
            names: [
                "--output-format",
            ],
            description: Some("The output format for commands"),
            arguments: [
                (
                    name: "",
                    suggestions: [
                        (
                            name: "json",
                        ),
                        (
                            name: "table",
                        ),
                        (
                            name: "text",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--query",
            ],
            description: Some("JMESPath query to filter the output"),
        ),
    ],
)
