(
    version: 1,
    command: "nginx",
    description: Some("Nginx (pronounced ``engine x'') is an HTTP and reverse proxy server, a mail proxy server, and a generic TCP/UDP proxy server.  It is known for its high performance, stability, rich feature set, simple configuration, and low resource consumption"),
    options: [
        (
            names: [
                "-c",
            ],
            description: Some("Use an alternative configuration file"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-e",
            ],
            description: Some("Use an alternative error log file.  Special value stderr indicates that the standard error output should be used"),
            arguments: [
                (
                    name: "file",
                    suggestions: [
                        (
                            name: "stderr",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-g",
            ],
            description: Some("Set global configuration directives"),
            arguments: [
                (
                    name: "directives",
                    description: Some("For all directives visit https://nginx.org/en/docs/dirindex.html"),
                ),
            ],
        ),
        (
            names: [
                "-p",
            ],
            description: Some("Set the prefix path.  The default value is %%PREFIX%%"),
            arguments: [
                (
                    name: "prefix",
                ),
            ],
        ),
        (
            names: [
                "-q",
            ],
            description: Some("Suppress non-error messages during configuration testing"),
        ),
        (
            names: [
                "-T",
            ],
            description: Some("Same as -t, but additionally dump configuration files to standard output"),
        ),
        (
            names: [
                "-t",
            ],
            description: Some("Do not run, just test the configuration file.  nginx checks the configuration file syntax and then tries to open files referenced in the configuration file"),
        ),
        (
            names: [
                "-V",
            ],
            description: Some("Print the nginx version, compiler version, and configure script parameters"),
        ),
        (
            names: [
                "-v",
            ],
            description: Some("Print the nginx version"),
        ),
        (
            names: [
                "-?",
                "-h",
            ],
            description: Some("Print help"),
        ),
        (
            names: [
                "-s",
            ],
            description: Some("Send a signal to the master process.  The argument signal can be one of: stop, quit, reopen, reload"),
            arguments: [
                (
                    name: "signal",
                    suggestions: [
                        (
                            name: "stop",
                            description: Some("Sends SIGTERM"),
                        ),
                        (
                            name: "quit",
                            description: Some("Sends SIGQUIT"),
                        ),
                        (
                            name: "reopen",
                            description: Some("Sends SIGUSR1"),
                        ),
                        (
                            name: "reload",
                            description: Some("Sends SIGHUP"),
                        ),
                    ],
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "",
            variadic: true,
        ),
    ],
)
