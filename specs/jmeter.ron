(
    version: 1,
    command: "jmeter",
    description: Some("Apache JMeter - 100% Java Load Testing Tool"),
    options: [
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Print the JMeter version information and exit"),
        ),
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Print usage information and exit"),
        ),
        (
            names: [
                "-p",
                "--propfile",
            ],
            description: Some("The jmeter property file to use"),
            arguments: [
                (
                    name: "property",
                    description: Some("Your jmeter property file"),
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-q",
                "--addprop",
            ],
            description: Some("Additional JMeter property file(s)"),
            arguments: [
                (
                    name: "files...",
                    description: Some("Additional JMeter property file(s)"),
                    template: [
                        FilePaths,
                    ],
                    variadic: true,
                ),
            ],
        ),
        (
            names: [
                "-t",
                "--testfile",
            ],
            description: Some("The JMeter test(.jmx) file to run. \"-t LAST\" will load last used file"),
            arguments: [
                (
                    name: "testfile",
                    description: Some("The JMeter test(.jmx) file to run. \"-t LAST\" will load last used file"),
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-l",
                "--logfile",
            ],
            description: Some("The file to log samples to"),
            arguments: [
                (
                    name: "logfile",
                    description: Some("The file to log samples to"),
                    template: [
                        FilePaths,
                    ],
                    suggest_current_token: true,
                ),
            ],
        ),
        (
            names: [
                "-i",
                "--jmeterlogconf",
            ],
            description: Some("JMeter logging configuration file"),
            arguments: [
                (
                    name: "jmeterlogconf",
                    description: Some("Jmeter logging configuration file"),
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-j",
                "--jmeterlogfile",
            ],
            description: Some("JMeter run log file"),
            arguments: [
                (
                    name: "jmeterlogfile",
                    description: Some("JMeter run log file"),
                    template: [
                        FilePaths,
                    ],
                    suggest_current_token: true,
                ),
            ],
        ),
        (
            names: [
                "-n",
                "--nongui",
            ],
            description: Some("Run JMeter in nongui mode"),
        ),
        (
            names: [
                "-s",
                "--server",
            ],
            description: Some("Run the JMeter server"),
        ),
        (
            names: [
                "-E",
                "--proxyScheme",
            ],
            description: Some("Set a proxy scheme to use for the proxy server"),
            arguments: [
                (
                    name: "proxyScheme",
                    description: Some("Set a proxy scheme to use for the proxy server"),
                ),
            ],
        ),
        (
            names: [
                "-H",
                "--proxyHost",
            ],
            description: Some("Set a proxy server for JMeter to use"),
            arguments: [
                (
                    name: "server",
                ),
            ],
        ),
        (
            names: [
                "-P",
                "--proxyPort",
            ],
            description: Some("Set proxy server port for JMeter to use"),
            arguments: [
                (
                    name: "port",
                ),
            ],
        ),
        (
            names: [
                "-N",
                "--nonProxyHosts",
            ],
            description: Some("Set nonproxy host list (e.g. *.apache.org|localhost)"),
            arguments: [
                (
                    name: "nonProxyHosts",
                    description: Some("Set nonproxy host list (e.g. *.apache.org|localhost)"),
                ),
            ],
        ),
        (
            names: [
                "-u",
                "--username",
            ],
            description: Some("Set username for proxy server that JMeter is to use"),
            arguments: [
                (
                    name: "username",
                    description: Some("Set username for proxy server that JMeter is to use"),
                ),
            ],
        ),
        (
            names: [
                "-a",
                "--password",
            ],
            description: Some("Set password for proxy server that JMeter is to use"),
            arguments: [
                (
                    name: "password",
                    description: Some("Set password for proxy server that JMeter is to use"),
                ),
            ],
        ),
        (
            names: [
                "-J",
                "--jmeterproperty",
            ],
            description: Some("Define additional JMeter properties <argument>=<value>"),
            arguments: [
                (
                    name: "jmeterproperty",
                    description: Some("Define additional JMeter properties <argument>=<value>"),
                ),
            ],
        ),
        (
            names: [
                "-G",
                "--globalproperty",
            ],
            description: Some("Define Global properties (sent to servers) e.g. -Gport=123 or -Gglobal.properties"),
            arguments: [
                (
                    name: "globalproperty",
                    description: Some("Define Global properties (sent to servers) e.g. -Gport=123 or -Gglobal.properties"),
                ),
            ],
        ),
        (
            names: [
                "-D",
                "--systemproperty",
            ],
            description: Some("Define additional system properties <argument>=<value>"),
            arguments: [
                (
                    name: "systemproperty",
                    description: Some("Define additional system properties <argument>=<value>"),
                ),
            ],
        ),
        (
            names: [
                "-S",
                "--systemPropertyFile",
            ],
            description: Some("Additional system property file(s)"),
            arguments: [
                (
                    name: "systemPropertyFile",
                    description: Some("Additional system property file(s)"),
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-f",
                "--forceDeleteResultFile",
            ],
            description: Some("Force delete existing results files and web report folder"),
        ),
        (
            names: [
                "-L",
                "--loglevel",
            ],
            description: Some("[category=]level e.g. jorphan=INFO, jmeter.util=DEBUG or com.example.foo=WARN"),
            arguments: [
                (
                    name: "loglevel",
                    suggestions: [
                        (
                            name: "OFF",
                        ),
                        (
                            name: "FATAL",
                        ),
                        (
                            name: "WARN",
                        ),
                        (
                            name: "INFO",
                        ),
                        (
                            name: "DEBUG",
                        ),
                        (
                            name: "TRACE",
                        ),
                        (
                            name: "ALL",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-r",
                "--runremote",
            ],
            description: Some("Start remote servers (as defined in remote_hosts)"),
        ),
        (
            names: [
                "-R",
                "--remotestart",
            ],
            description: Some("Start these remote servers (overrides remote_hosts)"),
            arguments: [
                (
                    name: "servers",
                    variadic: true,
                ),
            ],
        ),
        (
            names: [
                "-d",
                "--homedir",
            ],
            description: Some("The JMeter home directory to use"),
            arguments: [
                (
                    name: "homedir",
                ),
            ],
        ),
        (
            names: [
                "-X",
                "--remoteexit",
            ],
            description: Some("Exit the remote servers at end  of test (non-GUI)"),
        ),
        (
            names: [
                "-g",
                "--reportonly",
            ],
            description: Some("Generate report dashboard only, from a test results file"),
        ),
        (
            names: [
                "-e",
                "--reportatendofloadtests",
            ],
            description: Some("Generate report dashboard after load test"),
        ),
        (
            names: [
                "-o",
                "--reportoutputfolder",
            ],
            description: Some("Output folder for report dashboard"),
            arguments: [
                (
                    name: "reportoutputfolder",
                    description: Some("Output folder for report dashboard"),
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
    ],
)
