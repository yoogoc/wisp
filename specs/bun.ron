(
    version: 1,
    command: "bun",
    description: Some("A fast bundler, transpiler, JavaScript Runtime and package manager for web software"),
    subcommands: [
        (
            name: "c",
            aliases: [
                "create",
            ],
            description: Some("Start a new project from a template"),
            options: [
                (
                    names: [
                        "--force",
                    ],
                    description: Some("Overwrite existing files"),
                ),
                (
                    names: [
                        "--no-install",
                    ],
                    description: Some("Don't install node_modules"),
                ),
                (
                    names: [
                        "--no-git",
                    ],
                    description: Some("Don't create a git repository"),
                ),
                (
                    names: [
                        "--verbose",
                    ],
                    description: Some("Too many logs"),
                ),
                (
                    names: [
                        "--no-package-json",
                    ],
                    description: Some("Disable package.json transforms"),
                ),
                (
                    names: [
                        "--open",
                    ],
                    description: Some("On finish, start bun and open in browser"),
                ),
            ],
            arguments: [
                (
                    name: "template",
                    description: Some("Package from @bun-examples, GitHub repo, or local file"),
                    suggestions: [
                        (
                            name: "react",
                        ),
                        (
                            name: "next",
                        ),
                        (
                            name: "hono",
                        ),
                        (
                            name: "discord-interactions",
                        ),
                        (
                            name: "blank",
                        ),
                        (
                            name: "bun-bakery",
                        ),
                        (
                            name: "react-native-app",
