                    ],
                    description: Some("Disallow changes to lockfile"),
                ),
                (
                    names: [
                        "-f",
                        "--force",
                    ],
                    description: Some("Always request the latest versions from the registry & reinstall all dependencies"),
                ),
                (
                    names: [
                        "--cache-dir",
                    ],
                    description: Some("Store & load cached data from a specific directory path"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-cache",
                    ],
                    description: Some("Ignore manifest cache entirely"),
                ),
                (
                    names: [
                        "--silent",
                    ],
                    description: Some("Don't log anything"),
                ),
                (
                    names: [
                        "--verbose",
                    ],
                    description: Some("Excessively verbose logging"),
