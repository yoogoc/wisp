                            ),
                        ),
                        (
                            name: "completion-spec",
                            presentation: (
                                priority: Some(76.0),
                                icon: Some("https://fig.io/icons/fig-light.png"),
                            ),
                        ),
                        (
                            name: "next-app",
                            presentation: (
                                priority: Some(76.0),
                                icon: Some("https://nextjs.org/static/favicon/favicon-16x16.png"),
                            ),
                        ),
                        (
                            name: "t3-app",
                            presentation: (
                                priority: Some(76.0),
                                icon: Some("https://create.t3.gg/favicon.svg"),
                            ),
                        ),
                        (
                            name: "discord-bot",
                            presentation: (
                                priority: Some(76.0),
                                icon: Some("https://discordjs.dev/favicon-32x32.png"),
                            ),
                        ),
                        (
                            name: "video",
                            presentation: (
                                priority: Some(76.0),
                                icon: Some("https://raw.githubusercontent.com/remotion-dev/remotion/main/packages/docs/static/img/logo-small.png"),
                            ),
                        ),
                        (
                            name: "remix",
                            presentation: (
                                priority: Some(76.0),
                                icon: Some("https://remix.run/favicon-light.1.png"),
                            ),
                        ),
                    ],
                    generators: [
                        (
                            template: [
                                Folders,
                            ],
                        ),
                        (
                            has_custom: true,
                        ),
                        (
                            script: [
                                "command",
                                "ls",
                                "-1",
                                ".bun-create",
                            ],
                            split_on: Some("\n"),
                        ),
                        (
                            has_dynamic_script: true,
                            has_post_process: true,
                            cache: Some((
                                ttl_ms: Some(25920000),
                                stale_while_revalidate: true,
                            )),
                        ),
                    ],
                    is_command: true,
                    has_dynamic_load_spec: true,
                ),
                (
                    name: "name",
                    template: [
                        Folders,
                    ],
                    suggest_current_token: true,
                ),
            ],
            presentation: (
                icon: Some("data:image/svg+xml;base64,"),
            ),
        ),
        (
            name: "run",
            description: Some("Run a package.json script or executable"),
            arguments: [
                (
                    name: "script",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                        (
                            script: [
                                "bash",
                                "-c",
                                "until [[ -f package.json ]] || [[ $PWD = '/' ]]; do cd ..; done; cat package.json",
                            ],
                            has_post_process: true,
                            cache: Some((
                                by_directory: true,
                                stale_while_revalidate: true,
                            )),
                        ),
                    ],
                    filter_strategy: Fuzzy,
                ),
            ],
            presentation: (
                icon: Some("data:image/svg+xml;base64,"),
            ),
        ),
        (
            name: "i",
            aliases: [
