        (
            name: "build",
            aliases: [
                "bun",
            ],
            description: Some("Bundle files using Bun's native bundler"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Display this help and exit"),
                ),
                (
                    names: [
                        "-b",
                        "--bun",
                    ],
                    description: Some("Force a script or package to use Bun's runtime instead of Node.js (via symlinking node)"),
                ),
                (
                    names: [
                        "--cwd",
                    ],
                    arguments: [
                        (
                            name: "path",
                            description: Some("Absolute path to resolve files & entry points from. This just changes the process' cwd"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-c",
                        "--config",
                    ],
                    description: Some("Load config (bunfig.toml)"),
                    arguments: [
                        (
                            name: "path",
                            description: Some("Config file to load Bun from (e.g. -c bunfig.toml)"),
                            template: [
                                FilePaths,
                            ],
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--extension-order",
                    ],
                    arguments: [
                        (
                            name: "order",
                            description: Some("Defaults to: .tsx,.ts,.jsx,.js,.json"),
                            variadic: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--jsx-factory",
                    ],
                    description: Some("Changes the function called when compiling JSX elements using the classic JSX runtime"),
                    arguments: [
                        (
                            name: "name",
                            suggestions: [
                                (
                                    name: "React.createElement",
                                ),
                                (
                                    name: "h",
                                ),
                                (
                                    name: "preact.h",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--jsx-fragment",
                    ],
                    description: Some("Changes the function called when compiling JSX fragments"),
                    arguments: [
                        (
                            name: "string",
                            optional: true,
                        ),
                    ],
                    presentation: (
                        priority: Some(49.0),
                        insert_value: Some("--jsx-fragment='{cursor}'"),
                    ),
                ),
                (
                    names: [
                        "--jsx-import-source",
                    ],
                    description: Some("Declares the module specifier to be used for importing the jsx and jsxs factory functions. Default: \"react\""),
                    arguments: [
                        (
                            name: "module",
                            suggestions: [
                                (
                                    name: "react",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--jsx-runtime",
                    ],
                    description: Some("\"automatic\" (default) or \"classic\""),
                    arguments: [
                        (
                            name: "name",
                            suggestions: [
                                (
                                    name: "automatic",
                                ),
                                (
                                    name: "classic",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-r",
                        "--preload",
                    ],
                    arguments: [
                        (
                            name: "args",
                            description: Some("Import a module before other modules are loaded"),
                            variadic: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--main-fields",
                    ],
                    arguments: [
                        (
                            name: "args",
                            description: Some("Main fields to lookup in package.json. Defaults to --target dependent"),
                            variadic: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-summary",
                    ],
                    description: Some("Don't print a summary (when generating .bun)"),
                ),
                (
                    names: [
                        "-v",
                        "--version",
                    ],
                    description: Some("Print version and exit"),
                ),
                (
                    names: [
                        "--revision",
                    ],
                    description: Some("Print version with revision and exit"),
                ),
                (
                    names: [
                        "--tsconfig-override",
                    ],
                    arguments: [
                        (
                            name: "overrides",
                            description: Some("Load tsconfig from path instead of cwd/tsconfig.json"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-d",
                        "--define",
                    ],
                    arguments: [
                        (
                            name: "k=v",
                            description: Some("Substitute key=value while parsing, e.g. --define process.env.NODE_ENV=development"),
                            variadic: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "-e",
                        "--external",
                    ],
                    arguments: [
                        (
                            name: "args",
                            description: Some("Exclude module from transpilation (can use * wildcards). ex: -e react"),
                            variadic: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "-l",
                        "--loader",
                    ],
                    arguments: [
                        (
                            name: "args",
                            description: Some("Parse files with .ext:loader, e.g. --loader .js:jsx. Valid loaders: js, jsx, ts, tsx, json, toml, text, file, wasm, napi"),
                            generators: [
                                (
                                    has_custom: true,
                                    has_dynamic_trigger: true,
                                    has_dynamic_query_term: true,
                                ),
                            ],
                            variadic: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "-u",
                        "--origin",
                    ],
                    arguments: [
                        (
                            name: "args",
                            description: Some("Rewrite import URLs to start with --origin. Default: \"\""),
                        ),
                    ],
                ),
                (
                    names: [
                        "-p",
                        "--port",
                    ],
                    arguments: [
                        (
                            name: "args",
                            description: Some("Port to serve Bun's dev server on. Default: \"3000\""),
                        ),
                    ],
                ),
                (
                    names: [
                        "--smol",
                    ],
                    description: Some("Use less memory, but run garbage collection more often"),
                ),
                (
                    names: [
                        "--minify",
                    ],
                    description: Some("Minify (experimental)"),
                    presentation: (
                        priority: Some(50.0),
                    ),
                ),
                (
                    names: [
                        "--minify-syntax",
                    ],
                    description: Some("Minify syntax and inline data (experimental)"),
                ),
                (
                    names: [
                        "--minify-whitespace",
                    ],
                    description: Some("Minify whitespace (experimental)"),
                ),
                (
                    names: [
                        "--minify-identifiers",
                    ],
                    description: Some("Minify identifiers"),
                ),
                (
                    names: [
                        "--no-macros",
                    ],
                    description: Some("Disable macros from being executed in the bundler, transpiler and runtime"),
                ),
                (
                    names: [
                        "--target",
                    ],
                    description: Some("Target environment"),
