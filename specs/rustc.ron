(
    version: 1,
    command: "rustc",
    description: Some("CLI for rustc"),
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Prints out help info"),
        ),
        (
            names: [
                "--cfg",
            ],
            description: Some("Configures compilation settings"),
            arguments: [
                (
                    name: "Spec",
                    description: Some("Ex: verbose' or 'feature=\"serde\"'"),
                ),
            ],
        ),
        (
            names: [
                "-L",
            ],
            description: Some("Adds a directory to the library search path"),
            arguments: [
                (
                    name: "kind",
                    description: Some("The kind of search path"),
                    suggestions: [
                        (
                            name: "dependency",
                            description: Some("Only search for transitive dependencies in this directory"),
                            presentation: (
                                insert_value: Some("KIND=dependency"),
                            ),
                        ),
                        (
                            name: "crate",
                            description: Some("Only search for this crate's direct dependencies in this directory"),
                            presentation: (
                                insert_value: Some("KIND=crate"),
                            ),
                        ),
                        (
                            name: "native",
                            description: Some("Only search for native libraries in this directory"),
                            presentation: (
                                insert_value: Some("KIND=native"),
                            ),
                        ),
                        (
                            name: "framework",
                            description: Some("Only search for macOS frameworks in this directory"),
                            presentation: (
                                insert_value: Some("KIND=framework"),
                            ),
                        ),
                        (
                            name: "all",
                            description: Some("Search for all library kinds in this directory"),
                            presentation: (
                                insert_value: Some("KIND=all"),
                            ),
                        ),
                    ],
                    optional: true,
                ),
                (
                    name: "path",
                    description: Some("Path to search for external crates and libraries"),
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--l",
            ],
            description: Some("Links the generated crate to a native library"),
            arguments: [
                (
                    name: "kind",
                    description: Some("Kind of library"),
                    suggestions: [
                        (
                            name: "dylib",
                            description: Some("A native dynamic library"),
                            presentation: (
                                insert_value: Some("KIND=dylib"),
                            ),
                        ),
                        (
                            name: "static",
                            description: Some("A native static library"),
                            presentation: (
                                insert_value: Some("KIND=static"),
                            ),
                        ),
                        (
                            name: "framework",
                            description: Some("A macOS framework"),
                            presentation: (
                                insert_value: Some("KIND=framework"),
                            ),
                        ),
                    ],
                    optional: true,
                ),
                (
                    name: "Name",
                    description: Some("Native library name"),
                ),
            ],
        ),
        (
            names: [
                "--crate-type",
            ],
            description: Some("Specify types of crates for the compiler to emit"),
            arguments: [
                (
                    name: "type",
                    description: Some("Type of crates"),
                    suggestions: [
                        (
                            name: "bin",
                            description: Some("A runnable executable program"),
                        ),
                        (
                            name: "lib",
                            description: Some("Generates a library kind preferred by the compiler"),
                        ),
                        (
                            name: "rlib",
                            description: Some("A Rust static library"),
                        ),
                        (
                            name: "dylib",
                            description: Some("A native dynamic library"),
                        ),
                        (
                            name: "cdylib",
                            description: Some("A native static library"),
                        ),
                        (
                            name: "staticlib",
                            description: Some("A macOS framework"),
                        ),
                        (
                            name: "proc-macro",
                            description: Some("Generates a format suitable for a procedural macro library that may be loaded by the compiler"),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--crate-name",
            ],
            description: Some("Specify the name of the crate being built"),
            arguments: [
                (
                    name: "Name",
                ),
            ],
        ),
        (
            names: [
                "--edition",
            ],
            description: Some("Specify the edition to use"),
            arguments: [
                (
                    name: "edition",
                    suggestions: [
                        (
                            name: "2015",
                        ),
                        (
                            name: "2018",
                        ),
                        (
                            name: "2021",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--emit",
            ],
            description: Some("Specify the types of output files to generate"),
            arguments: [
                (
                    name: "type",
                    suggestions: [
                        (
                            name: "asm",
                            description: Some("Generates a file with the crate's assembly code"),
                        ),
                        (
                            name: "llvm-bc",
                            description: Some("Generates a binary file containing the LLVM bitcode"),
                        ),
                        (
                            name: "llvm-ir",
                            description: Some("Generates a file containing LLVM IR"),
                        ),
                        (
                            name: "obj",
                            description: Some("Generates a native object file"),
                        ),
                        (
                            name: "metadata",
                            description: Some("Generates a file containing metadata about the crate"),
                        ),
                        (
                            name: "link",
                            description: Some("Generates the crates specified by --crate-type"),
                        ),
                        (
                            name: "dep-info",
                            description: Some("Generates a file with Makefile syntax that indicates all the source files that were loaded to generate the crate"),
                        ),
                        (
                            name: "mir",
                            description: Some("Generates a file containing rustc's mid-level intermediate representation"),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--print",
            ],
            description: Some("Prints compiler info"),
            arguments: [
                (
                    name: "type",
                    suggestions: [
                        (
                            name: "crate-name",
                            description: Some("The name of the crate"),
                        ),
                        (
                            name: "file-names",
                            description: Some("The names of the files created by the link emit kind"),
                        ),
                        (
                            name: "sysroot",
                            description: Some("Path to the sysroot"),
                        ),
                        (
                            name: "target-libdir",
                            description: Some("Path to the target libdir"),
                        ),
                        (
                            name: "cfg",
                            description: Some("List of cfg values"),
                        ),
                        (
                            name: "target-list",
                            description: Some("List of known targets. The target may be selected with the --target flag"),
                        ),
                        (
                            name: "target-cpus",
                            description: Some("List of available CPU values for the current target"),
                        ),
                        (
                            name: "target-features",
                            description: Some("List of available target features for the current target"),
                        ),
                        (
                            name: "relocation-models",
                            description: Some("List of relocation models. Relocation models may be selected with the -C relocation-model=val flag"),
                        ),
                        (
                            name: "code-models",
                            description: Some("List of code models"),
                        ),
                        (
                            name: "tls-models",
                            description: Some("List of Thread Local Storage models supported"),
                        ),
                        (
                            name: "target-spec-json",
                        ),
                        (
                            name: "native-static-libs",
                            description: Some("This may be used when creating a staticlib crate type"),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-g",
            ],
            description: Some("Synonym for -C debuginfo=2"),
        ),
        (
            names: [
                "-O",
            ],
            description: Some("Synonym for -C opt-level=2"),
        ),
        (
            names: [
                "-o",
            ],
            description: Some("Specify the filename to write output"),
            arguments: [
                (
                    name: "filename",
                ),
            ],
        ),
        (
            names: [
                "--out-dir",
            ],
            description: Some("Specify directory to write output"),
            arguments: [
                (
                    name: "dir",
                ),
            ],
        ),
        (
            names: [
                "--explain",
            ],
            description: Some("Provides a detailed explanation of an error message"),
            arguments: [
                (
                    name: "Error Code",
                ),
            ],
        ),
        (
            names: [
                "--test",
            ],
            description: Some("Builds a test harness"),
        ),
        (
            names: [
                "--target",
            ],
            description: Some("Selects a target triple to build"),
            arguments: [
                (
                    name: "Target",
                ),
            ],
        ),
        (
            names: [
                "-W",
                "--warn",
            ],
            description: Some("Sets lint warnings"),
            arguments: [
                (
                    name: "OPT",
                ),
            ],
        ),
        (
            names: [
                "-A",
                "--allow",
            ],
            description: Some("Set lint allowed"),
            arguments: [
                (
                    name: "OPT",
                ),
            ],
        ),
        (
            names: [
                "-D",
                "--deny",
            ],
            description: Some("Set lint denied"),
            arguments: [
                (
                    name: "OPT",
                ),
            ],
        ),
        (
            names: [
                "-F",
                "--forbid",
            ],
            description: Some("Set lint forbid"),
            arguments: [
                (
                    name: "Opt",
                ),
            ],
        ),
        (
            names: [
                "--cap-lints",
            ],
            description: Some("Set the most restrictive lint level"),
            arguments: [
                (
                    name: "Level",
                ),
            ],
        ),
        (
            names: [
                "-C",
                "--codegen",
            ],
            description: Some("Set a codegen option"),
            arguments: [
                (
                    name: "option",
                ),
            ],
        ),
        (
            names: [
                "-Z",
            ],
            description: Some("Set unstable options"),
            arguments: [
                (
                    name: "option",
                    description: Some("Unstable options to pass to rustc"),
                ),
            ],
        ),
        (
            names: [
                "-V",
                "--version",
            ],
            description: Some("Prints version"),
        ),
        (
            names: [
                "-v",
                "--verbose",
            ],
            description: Some("Use verbose output"),
        ),
        (
            names: [
                "--extern",
            ],
            description: Some("Specify where an external library is located"),
            arguments: [
                (
                    name: "Path",
                    description: Some("Path where crate(s) can be found"),
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--sysroot",
            ],
            description: Some("Overrides the system root"),
            arguments: [
                (
                    name: "directory",
                ),
            ],
            presentation: (
                dangerous: true,
            ),
        ),
        (
            names: [
                "--error-format",
            ],
            description: Some("Controls how errors are produced"),
            arguments: [
                (
                    name: "format",
                    suggestions: [
                        (
                            name: "human",
                        ),
                        (
                            name: "json",
                        ),
                        (
                            name: "short",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--color",
            ],
            description: Some("Configures coloring of output"),
            arguments: [
                (
                    name: "color",
                    suggestions: [
                        (
                            name: "auto",
                        ),
                        (
                            name: "always",
                        ),
                        (
                            name: "never",
                        ),
                    ],
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "filepath",
            template: [
                FilePaths,
            ],
        ),
    ],
)
