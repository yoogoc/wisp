                                FilePaths,
                            ],
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "-l",
                    description: Some("Label flag"),
                ),
                (
                    name: "label",
                    description: Some("Unique label to assign to launchd"),
                    generators: [
                        (
                            script: [
                                "launchctl",
