                ),
                (
                    name: "command",
                    description: Some("Command to run"),
                ),
                (
                    name: "arg",
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "managerpid",
            description: Some("Prints the PID of the launchd controlling the session"),
        ),
        (
            name: "manageruid",
            description: Some("Prints the UID of the current launchd session"),
        ),
        (
            name: "managername",
            description: Some("Prints the name of the current launchd session"),
        ),
        (
            name: "error",
            description: Some("Prints a description of an error"),
            arguments: [
                (
                    name: "type",
                    description: Some("Error domain type"),
                    suggestions: [
