            name: "secrets",
            description: Some("Handle and manage sensitive information for pipeline execution in a safe manner"),
            options: [
                (
                    names: [
                        "list",
                    ],
                    description: Some("List secrets available in the current store e.g. nextflow secrets list"),
                ),
                (
                    names: [
                        "get",
                    ],
                    description: Some("Allows retrieving a secret value e.g. nextflow secrets get FOO"),
                    arguments: [
                        (
                            name: "secret name",
                            generators: [
                                (
                                    script: [
                                        "bash",
                                        "-c",
                                        "grep -o '\"name\": *\"[^\"]*\"' $HOME/.nextflow/secrets/store.json | grep -o '\"[^\"]*\"$' | tr -d \\\"",
                                    ],
                                    has_post_process: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
