(
    version: 1,
    command: "nextflow",
    description: Some("Nextflow enables scalable and reproducible scientific workflows using software containers. It allows the adaptation of pipelines written in the most common scripting languages"),
    subcommands: [
        (
            name: "clean",
            description: Some("Clean up project cache and work directories (Default: last run)"),
            options: [
                (
                    names: [
                        "-after",
                    ],
                    description: Some("Clean up runs executed after the specified one"),
                    arguments: [
                        (
                            name: "run name",
                            generators: [
                                (
                                    script: [
                                        "bash",
                                        "-c",
                                        "cat .nextflow/history | awk '{ print $4 }'",
                                    ],
                                    has_post_process: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-before",
                    ],
                    description: Some("Clean up runs executed before the specified one"),
                    arguments: [
                        (
                            name: "run name",
                            generators: [
                                (
                                    script: [
                                        "bash",
                                        "-c",
                                        "cat .nextflow/history | awk '{ print $4 }'",
                                    ],
                                    has_post_process: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-but",
                    ],
                    description: Some("Clean up all runs except the specified one"),
                    arguments: [
                        (
                            name: "run name",
                            generators: [
                                (
                                    script: [
                                        "bash",
                                        "-c",
                                        "cat .nextflow/history | awk '{ print $4 }'",
                                    ],
                                    has_post_process: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-n",
                        "-dry-run",
                    ],
                    description: Some("Print names of file to be removed without deleting them (Default: false)"),
                ),
                (
                    names: [
                        "-f",
                        "-force",
                    ],
                    description: Some("Force clean command (Default: false)"),
                ),
                (
                    names: [
                        "-h",
                        "-help",
                    ],
                    description: Some("Print the command usage (Default: false)"),
                ),
                (
                    names: [
                        "-k",
                        "-keep-logs",
                    ],
                    description: Some("Removes only temporary files but retains execution log entries and metadata (Default: false)"),
                ),
                (
                    names: [
                        "-q",
                        "-quiet",
                    ],
                    description: Some("Do not print names of files removed (Default: false)"),
                ),
            ],
            arguments: [
                (
                    name: "run_name|session_id",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "cat .nextflow/history | awk '{ print $4 }'",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "clone",
            description: Some("Clone a project into a folder"),
            options: [
                (
                    names: [
                        "-h",
                        "-help",
                    ],
                    description: Some("Print the command usage (Default: false)"),
                ),
                (
                    names: [
                        "-hub",
                    ],
                    description: Some("Service hub where the project is hosted (Default: GitHub)"),
                    arguments: [
                        (
                            name: "gitlab|github|bitbucket",
                        ),
                    ],
                ),
                (
                    names: [
                        "-r",
                    ],
                    description: Some("Revision to clone - It can be a git branch, tag or revision number"),
                    arguments: [
                        (
                            name: "revision",
                        ),
                    ],
                ),
                (
                    names: [
                        "-user",
                    ],
                    description: Some("Private repository user name"),
                    arguments: [
                        (
                            name: "username",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "namespace/repository_name",
                ),
            ],
        ),
        (
            name: "config",
            description: Some("Print a project configuration"),
            options: [
                (
                    names: [
                        "-flat",
                    ],
                    description: Some("Print config using flat notation (Default: false)"),
                ),
                (
                    names: [
                        "-h",
                        "-help",
                    ],
                    description: Some("Print the command usage (Default: false)"),
                ),
                (
                    names: [
                        "-profile",
                    ],
                    description: Some("Choose a configuration profile"),
                ),
                (
                    names: [
                        "-properties",
                    ],
                    description: Some("Prints config using Java properties notatio (Default: false)"),
                ),
                (
                    names: [
                        "-a",
                        "-show-profiles",
                    ],
                    description: Some("Show all configuration profiles"),
                ),
                (
                    names: [
                        "-sort",
                    ],
                    description: Some("Sort config attributes (Default: false)"),
                ),
            ],
            arguments: [
                (
                    name: "project name",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "{ find * -maxdepth 0 -type f -name '*.nf' 2> /dev/null && find $HOME/.nextflow/assets/* -maxdepth 1 -type d | cut -d/ -f6,7 | grep / | grep -v assets; } 2> /dev/null",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "console",
            description: Some("Launch Nextflow interactive console"),
            options: [
                (
                    names: [
                        "-h",
                        "-help",
                    ],
                    description: Some("Print the command usage (Default: false)"),
                ),
            ],
        ),
        (
            name: "drop",
            description: Some("Delete the local copy of a project"),
            options: [
                (
                    names: [
                        "-h",
                        "-help",
                    ],
                    description: Some("Print the command usage (Default: false)"),
                ),
                (
                    names: [
                        "-f",
                    ],
                    description: Some("Delete the repository without taking care of local changes (Default: false)"),
                ),
            ],
            arguments: [
                (
                    name: "name of the project to drop",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "{ find * -maxdepth 0 -type f -name '*.nf' 2> /dev/null && find $HOME/.nextflow/assets/* -maxdepth 1 -type d | cut -d/ -f6,7 | grep / | grep -v assets; } 2> /dev/null",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "help",
            description: Some("Print the usage help for a command"),
            options: [
                (
                    names: [
                        "-h",
                        "-help",
                    ],
                    description: Some("Print the command usage (Default: false)"),
                ),
            ],
        ),
        (
            name: "info",
            description: Some("Print project and system runtime information"),
            options: [
                (
                    names: [
                        "-u",
                        "-check-updates",
                    ],
                    description: Some("Check for remote updates (Default: false)"),
                ),
                (
                    names: [
                        "-d",
                    ],
                    description: Some("Show detailed information (Default: false)"),
                ),
                (
                    names: [
                        "-h",
                        "-help",
                    ],
                    description: Some("Print the command usage (Default: false)"),
                ),
                (
                    names: [
                        "-o",
                    ],
                    description: Some("Output format, either: text (default), json, yaml"),
                ),
            ],
            arguments: [
                (
                    name: "project name",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "{ find * -maxdepth 0 -type f -name '*.nf' 2> /dev/null && find $HOME/.nextflow/assets/* -maxdepth 1 -type d | cut -d/ -f6,7 | grep / | grep -v assets; } 2> /dev/null",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "kuberun",
            description: Some("Execute a workflow in a Kubernetes cluster (experimental)"),
            options: [
                (
                    names: [
                        "-E",
                    ],
                    description: Some("Exports all current system environment (Default: false)"),
                ),
                (
                    names: [
                        "-ansi-log",
                    ],
                    description: Some("Enable/disable ANSI console logging"),
                ),
                (
                    names: [
                        "-bucket-dir",
                    ],
                    description: Some("Remote bucket where intermediate result files are stored"),
                    arguments: [
                        (
                            name: "remote bucket",
                        ),
                    ],
                ),
                (
                    names: [
                        "-cache",
                    ],
                    description: Some("Enable/disable processes caching"),
                ),
                (
                    names: [
                        "-disable-jobs-cancellation",
                    ],
                    description: Some("Prevent the cancellation of child jobs on execution termination"),
                ),
                (
                    names: [
                        "-dsl1",
                    ],
                    description: Some("Execute the workflow using DSL1 syntax (Default: false)"),
                ),
                (
                    names: [
                        "-dsl2",
                    ],
                    description: Some("Execute the workflow using DSL2 syntax (Default: false)"),
                ),
                (
                    names: [
                        "-dump-channels",
                    ],
                    description: Some("Dump channels for debugging purpose"),
                ),
                (
                    names: [
                        "-dump-hashes",
                    ],
                    description: Some("Dump task hash keys for debugging purpose (Default: false)"),
                ),
                (
                    names: [
                        "-e",
                    ],
                    description: Some("Add the specified variable to execution environment. Syntax: -e.key=value (Default: {})"),
                    arguments: [
                        (
                            name: "key=value",
                        ),
                    ],
                    requires_separator: Some("."),
                ),
                (
                    names: [
                        "-entry",
                    ],
                    description: Some("Entry workflow name to be executed"),
                    arguments: [
                        (
                            name: "entry workflow name",
                        ),
                    ],
                ),
                (
                    names: [
                        "-head-cpus",
                    ],
                    description: Some("Specify number of CPUs requested for the Nextflow pod (Default: 0)"),
                ),
                (
                    names: [
                        "-head-memory",
                    ],
                    description: Some("Specify amount of memory requested for the Nextflow pod"),
                ),
                (
                    names: [
                        "-h",
                        "-help",
                    ],
                    description: Some("Print the command usage (Default: false)"),
                ),
                (
                    names: [
                        "-hub",
                    ],
                    description: Some("Service hub where the project is hosted (Default: github)"),
                    arguments: [
                        (
                            name: "service hub",
                        ),
                    ],
                ),
                (
                    names: [
                        "-latest",
                    ],
                    description: Some("Pull latest changes before run (Default: false)"),
                ),
                (
                    names: [
                        "-lib",
                    ],
                    description: Some("Library extension path"),
                    arguments: [
                        (
                            name: "library extension path",
                        ),
                    ],
                ),
                (
                    names: [
                        "-main-script",
                    ],
                    description: Some("The script file to be executed when launching a project directory or repository"),
                    arguments: [
                        (
                            name: "script file",
                        ),
                    ],
                ),
                (
                    names: [
                        "-name",
                    ],
                    description: Some("Assign a mnemonic name to the a pipeline run"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                ),
                (
                    names: [
                        "-n",
                        "-namespace",
                    ],
                    description: Some("Specify the K8s namespace to use"),
                ),
                (
                    names: [
                        "-offline",
                    ],
                    description: Some("Do not check for remote project updates (Default: false)"),
                ),
                (
                    names: [
                        "-params-file",
                    ],
                    description: Some("Load script parameters from a JSON/YAML file"),
                    arguments: [
                        (
                            name: "JSON/YAML file",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-plugins",
                    ],
                    description: Some("Specify the plugins to be applied for this run e.g. nf-amazon,nf-tower"),
                    arguments: [
                        (
                            name: "plugins ids separated by comma",
                        ),
                    ],
                ),
                (
                    names: [
                        "-pod-image",
                    ],
                    description: Some("Specify the container image for the Nextflow pod"),
                ),
                (
                    names: [
                        "-process",
                    ],
                    description: Some("Set process options. Syntax: -process.key=value (Default: {}"),
                    arguments: [
                        (
                            name: "key=value",
                        ),
                    ],
                    requires_separator: Some("."),
                ),
                (
                    names: [
                        "-profile",
                    ],
                    description: Some("Choose a configuration profile"),
                    arguments: [
                        (
                            name: "profile",
                        ),
                    ],
                ),
                (
                    names: [
                        "-qs",
                        "-queue-size",
                    ],
                    description: Some("Max number of processes that can be executed in parallel by each executor"),
                    arguments: [
                        (
                            name: "number",
                        ),
                    ],
                ),
                (
                    names: [
                        "-remoteProfile",
                    ],
                    description: Some("Choose a configuration profile in the remoteConfig"),
                ),
                (
                    names: [
                        "-resume",
                    ],
                    description: Some("Execute the script using the cached results, useful to continue executions that was stopped by an error"),
                ),
                (
                    names: [
                        "-r",
                        "-revision",
                    ],
                    description: Some("Revision of the project to run (either a git branch, tag or commit SHA number)"),
                    arguments: [
                        (
                            name: "project revision (tag/branch/hash",
                        ),
                    ],
                ),
                (
                    names: [
                        "-stub-run",
                        "-stub",
                    ],
                    description: Some("Execute the workflow replacing process scripts with command stubs (Default: false)"),
                ),
                (
                    names: [
                        "-test",
                    ],
                    description: Some("Test a script function with the name specified"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                ),
                (
                    names: [
                        "-user",
                    ],
                    description: Some("Private repository user name"),
                    arguments: [
                        (
                            name: "username",
                        ),
                    ],
                ),
                (
                    names: [
                        "-v",
                        "-volume-mount",
                    ],
                    description: Some("Volume claim mounts eg. my-pvc:/mnt/path"),
                ),
                (
                    names: [
                        "-with-charliecloud",
                    ],
                    description: Some("Enable process execution in a Charliecloud container runtime"),
                ),
                (
                    names: [
                        "-with-conda",
                    ],
                    description: Some("Use the specified Conda environment package or file (must end with .yml|.yaml suffix)"),
                    arguments: [
                        (
                            name: "conda .yml/.yaml file",
                        ),
                    ],
                ),
                (
                    names: [
                        "-with-dag",
                    ],
                    description: Some("Create pipeline DAG file"),
                    arguments: [
                        (
                            name: "filename, e.g. dag.dot",
                        ),
                    ],
                ),
                (
                    names: [
                        "-with-docker",
                    ],
                    description: Some("Enable process execution in a Docker container"),
                    arguments: [
                        (
                            name: "a docker container image",
                            generators: [
                                (
                                    script: [
                                        "bash",
                                        "-c",
                                        "docker images | cut -w -f 1 | grep -v REPOSITORY",
                                    ],
                                    has_post_process: true,
                                ),
                            ],
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "-N",
                        "-with-notification",
                    ],
                    description: Some("Send a notification email on workflow completion to the specified recipients"),
                    arguments: [
                        (
                            name: "email",
                        ),
                    ],
                ),
                (
                    names: [
                        "-with-podman",
                    ],
                    description: Some("Enable process execution in a Podman container"),
                ),
                (
                    names: [
                        "-with-report",
                    ],
                    description: Some("Create processes execution html report"),
                    arguments: [
                        (
                            name: "report filename e.g. report.html",
                        ),
                    ],
                ),
                (
                    names: [
                        "-with-singularity",
                    ],
                    description: Some("Enable process execution in a Singularity container"),
                ),
                (
                    names: [
                        "-with-timeline",
                    ],
                    description: Some("Create processes execution timeline file"),
                    arguments: [
                        (
                            name: "timeline filename e.g. timeline.html",
                        ),
                    ],
                ),
                (
                    names: [
                        "-with-tower",
                    ],
                    description: Some("Monitor workflow execution with Seqera Tower service"),
                ),
                (
                    names: [
                        "-with-trace",
                    ],
                    description: Some("Create processes execution tracing file"),
                    arguments: [
                        (
                            name: "trace text filename e.g. trace.txt",
                        ),
                    ],
                ),
                (
                    names: [
                        "-with-weblog",
                    ],
                    description: Some("Send workflow status messages via HTTP to target URL"),
                    arguments: [
                        (
                            name: "target web URL",
                        ),
                    ],
                ),
                (
                    names: [
                        "-without-docker",
                    ],
                    description: Some("Disable process execution with Docker (Default: false)"),
                ),
                (
                    names: [
                        "-without-podman",
                    ],
                    description: Some("Disable process execution in a Podman container"),
                ),
                (
                    names: [
                        "-w",
                        "-work-dir",
                    ],
                    description: Some("Directory where intermediate result files are stored"),
                    arguments: [
                        (
                            name: "work dir",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "project name",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "{ find * -maxdepth 0 -type f -name '*.nf' 2> /dev/null && find $HOME/.nextflow/assets/* -maxdepth 1 -type d | cut -d/ -f6,7 | grep / | grep -v assets; } 2> /dev/null",
                            ],
