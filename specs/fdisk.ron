(
    version: 1,
    command: "fdisk",
    description: Some("Manipulate disk partition table"),
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for fdisk"),
        ),
        (
            names: [
                "--version",
                "-V",
            ],
            description: Some("Show version for lsblk"),
        ),
        (
            names: [
                "--sector-size",
                "-b",
            ],
            description: Some("Specify the sector size of the disk"),
            arguments: [
                (
                    name: "mode",
                    description: Some("Valid values are 512, 1024, 2048, and 4096"),
                    suggestions: [
                        (
                            name: "512",
                        ),
                        (
                            name: "1024",
                        ),
                        (
                            name: "2048",
                        ),
                        (
                            name: "4096",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--protect-boot",
                "-B",
            ],
            description: Some("Don't erase the beginning of the first disk sector when creating a new disk label"),
        ),
        (
            names: [
                "--compatibility",
                "-c",
            ],
            description: Some("Specify the compatibility mode, 'dos' or 'nondos'"),
            arguments: [
                (
                    name: "mode",
                    suggestions: [
                        (
                            name: "dos",
                        ),
                        (
                            name: "nondos",
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            names: [
                "--color",
                "-L",
            ],
            description: Some("Colorize the output"),
            arguments: [
                (
                    name: "when",
                    suggestions: [
                        (
                            name: "always",
                        ),
                        (
                            name: "never",
                        ),
                        (
                            name: "auto",
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            names: [
                "--list",
                "-l",
            ],
            description: Some("List the partition tables for the specified devices and then exit"),
        ),
        (
            names: [
                "--list-details",
                "-x",
            ],
            description: Some("Like --list, but provides more details"),
        ),
        (
            names: [
                "--lock",
            ],
            description: Some("Use exclusive BSD lock for device or file it operates"),
            arguments: [
                (
                    name: "mode",
                    description: Some("Optional argument mode can be yes, no (or 1 and 0) or nonblock"),
                    suggestions: [
                        (
                            name: "yes",
                        ),
                        (
                            name: "no",
                        ),
                        (
                            name: "nonblock",
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            names: [
                "--noauto-pt",
                "-n",
            ],
            description: Some("Don't automatically create a default partition table on empty device"),
        ),
        (
            names: [
                "--output",
                "-o",
            ],
            description: Some("Desc"),
            arguments: [
                (
                    name: "list",
                ),
            ],
        ),
        (
            names: [
                "--getsz",
                "-s",
            ],
            description: Some("Print the size in 512-byte sectors of each given block device. This option is DEPRECATED in favour of blockdev(8)"),
        ),
        (
            names: [
                "--type",
                "-t",
            ],
            description: Some("Enable support only for disklabels of the specified type, and disable support for all other types"),
            arguments: [
                (
                    name: "type",
                ),
            ],
        ),
        (
            names: [
                "--units",
                "-u",
            ],
            description: Some("When listing partition tables, show sizes in 'sectors' or in 'cylinders'"),
            arguments: [
                (
                    name: "unit",
                    suggestions: [
                        (
                            name: "sectors",
                        ),
                        (
                            name: "cylinders",
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            names: [
                "--cylinders",
                "-C",
            ],
            description: Some("Specify the number of cylinders of the disk"),
            arguments: [
                (
                    name: "number",
                ),
            ],
        ),
        (
            names: [
                "--heads",
                "-H",
            ],
            description: Some("Specify the number of heads of the disk. (Not the physical number, of course, but the number used for partition tables.)"),
            arguments: [
                (
                    name: "number",
                ),
            ],
        ),
        (
            names: [
                "--sectors",
                "-S",
            ],
            description: Some("Specify the number of sectors per track of the disk. (Not the physical number, of course, but the number used for partition tables.)"),
        ),
        (
            names: [
                "--wipe",
                "-w",
            ],
            description: Some("Wipe filesystem, RAID and partition-table signatures from the device, in order to avoid possible collisions"),
            arguments: [
                (
                    name: "when",
                    description: Some("The argument when can be auto, never or always"),
                    suggestions: [
                        (
                            name: "auto",
                        ),
                        (
                            name: "never",
                        ),
                        (
                            name: "always",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--wipe-partitions",
                "-W",
            ],
            description: Some("Wipe filesystem, RAID and partition-table signatures from a newly created partitions, in order to avoid possible collisions"),
            arguments: [
                (
                    name: "when",
                    description: Some("The argument when can be auto, never or always"),
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "device",
            description: Some("Device to list"),
            template: [
                FilePaths,
            ],
            optional: true,
        ),
    ],
)
