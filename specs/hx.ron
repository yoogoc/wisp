(
    version: 1,
    command: "hx",
    description: Some("A post-modern text editor"),
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Show help"),
        ),
        (
            names: [
                "--tutor",
            ],
            description: Some("Open the tutorial"),
        ),
        (
            names: [
                "--health",
            ],
            description: Some("Check for errors in editor setup"),
            arguments: [
                (
                    name: "language",
                    optional: true,
                ),
            ],
        ),
        (
            names: [
                "-v",
            ],
            description: Some("Increases logging verbosity"),
            repeat: Many,
        ),
        (
            names: [
                "-g",
                "--grammar",
            ],
            description: Some("Fetch or build tree-sitter grammars"),
            arguments: [
                (
                    name: "action",
                    suggestions: [
                        (
                            name: "fetch",
                            presentation: (
                                icon: Some("fig://icon?type=command"),
                            ),
                        ),
                        (
                            name: "build",
                            presentation: (
                                icon: Some("fig://icon?type=command"),
                            ),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-V",
                "--version",
            ],
            description: Some("Print version information"),
        ),
    ],
    arguments: [
        (
            name: "files",
            template: [
                FilePaths,
                Folders,
            ],
            variadic: true,
        ),
    ],
    parser_directives: Some((
        flags_are_posix_noncompliant: true,
    )),
)
