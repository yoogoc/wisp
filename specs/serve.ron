(
    version: 1,
    command: "serve",
    description: Some("Static file serving and directory listing"),
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Shows help message"),
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Displays the current version of serve"),
        ),
        (
            names: [
                "-l",
                "--listen",
            ],
            description: Some("Specify a URI endpoint on which to listen - more than one may be specified to listen in multiple places"),
            arguments: [
                (
                    name: "listen_uri",
                    suggestions: [
                        (
                            name: "port",
                            description: Some("E.g. serve --listen 1234"),
                            presentation: (
                                priority: Some(100.0),
                                insert_value: Some("1234"),
                            ),
                        ),
                        (
                            name: "host/port",
                            description: Some("E.g. serve --listen tcp://hostname:1234"),
                            presentation: (
                                priority: Some(76.0),
                                insert_value: Some("tcp://hostname:1234"),
                            ),
                        ),
                        (
                            name: "unix domain",
                            description: Some("E.g. serve --listen unix:/path/to/socket.sock"),
                            presentation: (
                                insert_value: Some("unix:/path/to/socket.sock"),
                            ),
                        ),
                        (
                            name: "windows pipe",
                            description: Some("E.g. serve -l pipe:\\.pipePipeName"),
                            presentation: (
                                insert_value: Some("pipe:\\.pipePipeName"),
                            ),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-p",
            ],
            description: Some("Specify custom port"),
            arguments: [
                (
                    name: "port",
                ),
            ],
        ),
        (
            names: [
                "-d",
                "--debug",
            ],
            description: Some("Show debugging information"),
        ),
        (
            names: [
                "-s",
                "--single",
            ],
            description: Some("Rewrite all not-found requests to `index.html`"),
        ),
        (
            names: [
                "-c",
                "--config",
            ],
            description: Some("Specify custom path to `serve.json`"),
            arguments: [
                (
                    name: "path to config file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-C",
                "--cors",
            ],
            description: Some("Enable CORS, sets `Access-Control-Allow-Origin` to `*`"),
        ),
        (
            names: [
                "-n",
                "--no-clipboard",
            ],
            description: Some("Do not copy the local address to the clipboard"),
        ),
        (
            names: [
                "-u",
                "--no-compression",
            ],
            description: Some("Do not compress files"),
        ),
        (
            names: [
                "--no-etag",
            ],
            description: Some("Send `Last-Modified` header instead of `ETag`"),
        ),
        (
            names: [
                "-S",
                "--symlinks",
            ],
            description: Some("Resolve symlinks instead of showing 404 errors"),
        ),
        (
            names: [
                "--ssl-cert",
            ],
            description: Some("Optional path to an SSL/TLS certificate to serve with HTTPS"),
            arguments: [
                (
                    name: "path to SSL/TLS certificate",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--ssl-key",
            ],
            description: Some("Optional path to the SSL/TLS certificate's private key"),
            arguments: [
                (
                    name: "path to private key",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--ssl-pass",
            ],
            description: Some("Optional path to the SSL/TLS certificate's passphrase"),
            arguments: [
                (
                    name: "path to passphrase",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--no-port-switching",
            ],
            description: Some("Do not open a port other than the one specified when it's taken"),
        ),
    ],
    arguments: [
        (
            name: "location",
            template: [
                Folders,
            ],
        ),
    ],
)
