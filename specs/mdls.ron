(
    version: 1,
    command: "mdls",
    description: Some("Lists the metadata attributes for the specified file"),
    options: [
        (
            names: [
                "--name",
                "-name",
            ],
            description: Some("Print only the matching metadata attribute value.  Can be used multiple times"),
            arguments: [
                (
                    name: "attributeName",
                    description: Some("Metadata attribute name"),
                    suggestions: [
                        (
                            name: "_kMDItemDisplayNameWithExtensions",
                        ),
                        (
                            name: "kMDItemContentCreationDate",
                        ),
                        (
                            name: "kMDItemContentCreationDate_Ranking",
                        ),
                        (
                            name: "kMDItemContentModificationDate",
                        ),
                        (
                            name: "kMDItemContentModificationDate_Ranking",
                        ),
                        (
                            name: "kMDItemContentType",
                        ),
                        (
                            name: "kMDItemContentTypeTree",
                        ),
                        (
                            name: "kMDItemDateAdded",
                        ),
                        (
                            name: "kMDItemDateAdded_Ranking",
                        ),
                        (
                            name: "kMDItemDisplayName",
                        ),
                        (
                            name: "kMDItemDocumentIdentifier",
                        ),
                        (
                            name: "kMDItemFSContentChangeDate",
                        ),
                        (
                            name: "kMDItemFSCreationDate",
                        ),
                        (
                            name: "kMDItemFSCreatorCode",
                        ),
                        (
                            name: "kMDItemFSFinderFlags",
                        ),
                        (
                            name: "kMDItemFSHasCustomIcon",
                        ),
                        (
                            name: "kMDItemFSInvisible",
                        ),
                        (
                            name: "kMDItemFSIsExtensionHidden",
                        ),
                        (
                            name: "kMDItemFSIsStationery",
                        ),
                        (
                            name: "kMDItemFSLabel",
                        ),
                        (
                            name: "kMDItemFSName",
                        ),
                        (
                            name: "kMDItemFSNodeCount",
                        ),
                        (
                            name: "kMDItemFSOwnerGroupID",
                        ),
                        (
                            name: "kMDItemFSOwnerUserID",
                        ),
                        (
                            name: "kMDItemFSSize",
                        ),
                        (
                            name: "kMDItemFSTypeCode",
                        ),
                        (
                            name: "kMDItemInterestingDate_Ranking",
                        ),
                        (
                            name: "kMDItemKind",
                        ),
                        (
                            name: "kMDItemLogicalSize",
                        ),
                        (
                            name: "kMDItemPhysicalSize",
                        ),
                    ],
                ),
            ],
            repeat: Many,
            exclusive_on: [
                "--plist",
                "-plist",
            ],
        ),
        (
            names: [
                "--raw",
                "-raw",
            ],
            description: Some("Print raw attribute data in the order that was requested. Fields will be separated with a ASCII NUL character, suitable for piping to xargs(1) -0"),
            exclusive_on: [
                "--plist",
                "-plist",
            ],
        ),
        (
            names: [
                "--nullMarker",
                "-nullMarker",
            ],
            description: Some("Sets a marker string to be used when a requested attribute is null. Only used in -raw mode.  Default is '(null)'"),
            exclusive_on: [
                "--plist",
                "-plist",
            ],
            depends_on: [
                "--raw",
                "-raw",
            ],
            presentation: (
                insert_value: Some("--nullMarker \"{cursor}\""),
            ),
        ),
        (
            names: [
                "--plist",
                "-plist",
            ],
            description: Some("Output attributes in XML format to file. Use - to write to stdout option. Incompatible with options -raw, -nullMarker, and -name"),
            arguments: [
                (
                    name: "stdout or file",
                    description: Some("XML output location"),
                    suggestions: [
                        (
                            name: "-",
                            description: Some("Writes to stdout"),
                            presentation: (
                                priority: Some(77.0),
                            ),
                        ),
                    ],
                    template: [
                        FilePaths,
                    ],
                ),
                (
                    name: "file",
                    description: Some("File to read from"),
                    template: [
                        FilePaths,
                    ],
                ),
            ],
            exclusive_on: [
                "--raw",
                "-raw",
                "--nullMarker",
                "-nullMarker",
                "--name",
                "-name",
            ],
        ),
    ],
    arguments: [
        (
            name: "file",
            template: [
                FilePaths,
            ],
            variadic: true,
        ),
    ],
    parser_directives: Some((
        flags_are_posix_noncompliant: true,
    )),
)
