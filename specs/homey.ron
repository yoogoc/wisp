(
    version: 1,
    command: "homey",
    subcommands: [
        (
            name: "app",
            description: Some("App related commands"),
            subcommands: [
                (
                    name: "add-types",
                    description: Some("Install the Apps SDK TypeScript declarations"),
                ),
                (
                    name: "build",
                    description: Some("Build a Homey App for publishing"),
                ),
                (
                    name: "compose",
                    description: Some("Migrate app to Homey compose"),
                ),
                (
                    name: "create",
                    description: Some("Create a new Homey App"),
                ),
                (
                    name: "discovery",
                    description: Some("Discovery related commands"),
                    subcommands: [
                        (
                            name: "create",
                            description: Some("Create a new Discovery strategy"),
                        ),
                    ],
                ),
                (
                    name: "driver",
                    description: Some("Driver related commands"),
                    subcommands: [
                        (
                            name: "capabilities",
                            description: Some("Change the capabilities of a Driver"),
                        ),
                        (
                            name: "create",
                            description: Some("Create a new Driver"),
                        ),
                        (
                            name: "flow",
                            description: Some("Create a new Flow for a Driver"),
                        ),
                    ],
                ),
                (
                    name: "flow",
                    description: Some("Flow related commands"),
                    subcommands: [
                        (
                            name: "create",
                            description: Some("Create a new Flow"),
                        ),
                    ],
                ),
                (
                    name: "install",
                    description: Some("Install a Homey App"),
                    options: [
                        (
                            names: [
                                "-c",
                                "--clean",
                            ],
                            arguments: [
                                (
                                    name: "clean",
                                    suggestions: [
                                        (
                                            name: "false",
                                        ),
                                        (
                                            name: "true",
                                        ),
                                    ],
                                    default: Some("false"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-s",
                                "--skip-build",
                            ],
                            arguments: [
                                (
                                    name: "skip-build",
                                    suggestions: [
                                        (
                                            name: "false",
                                        ),
                                        (
                                            name: "true",
                                        ),
                                    ],
                                    default: Some("false"),
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "manage",
                    description: Some("View your app in the Homey Developer Tools"),
                ),
                (
                    name: "publish",
                    description: Some("Publish a Homey App to the Homey Apps Store"),
                ),
                (
                    name: "run",
                    description: Some("Run a Homey App in development mode"),
                    options: [
                        (
                            names: [
                                "-c",
                                "--clean",
                            ],
                            arguments: [
                                (
                                    name: "clean",
                                    suggestions: [
                                        (
                                            name: "false",
                                        ),
                                        (
                                            name: "true",
                                        ),
                                    ],
                                    default: Some("false"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-s",
                                "--skip-build",
                            ],
                            arguments: [
                                (
                                    name: "skip-build",
                                    suggestions: [
                                        (
                                            name: "false",
                                        ),
                                        (
                                            name: "true",
                                        ),
                                    ],
                                    default: Some("false"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-l",
                                "--link-modules",
                            ],
                            description: Some("Provide a comma-separated path to local Node.js modules to link. Only works on Homey Cloud"),
                            arguments: [
                                (
                                    name: "modules",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "validate",
                    description: Some("Validate a Homey App"),
                    options: [
                        (
                            names: [
                                "-l",
                                "--level",
                            ],
                            description: Some("Validation level"),
                            arguments: [
                                (
                                    name: "value",
                                    suggestions: [
                                        (
                                            name: "debug",
                                        ),
                                        (
                                            name: "publish",
                                        ),
                                        (
                                            name: "verified",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "version",
                    description: Some("Update a Homey App's version"),
                    arguments: [
                        (
                            name: "next",
                            suggestions: [
                                (
                                    name: "patch",
                                ),
                                (
                                    name: "minor",
                                ),
                                (
                                    name: "major",
                                ),
                                (
                                    name: "semver",
                                    presentation: (
                                        insert_value: Some("1.0.0"),
                                    ),
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "view",
                    description: Some("View your app in the Homey Apps Store"),
                ),
            ],
            options: [
                (
                    names: [
                        "-p",
                        "--path",
                    ],
                    description: Some("Path to a Homey App directory"),
                    arguments: [
                        (
                            name: "",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                    persistent: true,
                ),
            ],
        ),
        (
            name: "docs",
            description: Some("Open Homey Developer Documentation"),
            presentation: (
                icon: Some("📖"),
            ),
        ),
        (
            name: "list",
            description: Some("List all Homeys"),
        ),
        (
            name: "login",
            description: Some("Log in with an Athom Account"),
        ),
        (
            name: "logout",
            description: Some("Log out the current user"),
        ),
        (
            name: "select",
            description: Some("Select a Homey as active"),
            options: [
                (
                    names: [
                        "-i",
                        "--id",
                    ],
                    description: Some("ID of the Homey"),
                    arguments: [
                        (
                            name: "id",
                        ),
                    ],
                ),
                (
                    names: [
                        "-n",
                        "--name",
                    ],
                    description: Some("Name of the Homey"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "tools",
            description: Some("Open Homey Developer Tools"),
            presentation: (
                icon: Some("🔧"),
            ),
        ),
        (
            name: "unselect",
            description: Some("Unselect the active Homey"),
        ),
        (
            name: "whoami",
            description: Some("Show the current logged in user"),
        ),
    ],
    options: [
        (
            names: [
                "--help",
            ],
            persistent: true,
        ),
        (
            names: [
                "--version",
            ],
            persistent: true,
        ),
    ],
)
