(
    version: 1,
    command: "mysql",
    description: Some("Mysql is a terminal-based front-end to MySQL"),
    options: [
        (
            names: [
                "--auto-rehash",
            ],
            description: Some("Enable automatic rehashing"),
        ),
        (
            names: [
                "--auto-vertical-output",
            ],
            description: Some("Enable automatic vertical result set display"),
        ),
        (
            names: [
                "--batch",
                "-B",
            ],
            description: Some("Do not use history file"),
        ),
        (
            names: [
                "--binary-as-hex",
            ],
            description: Some("Display binary values in hexadecimal notation"),
        ),
        (
            names: [
                "--binary-mode",
            ],
            description: Some("Disable \\r\\n - to - \\n translation and treatment of \\0 as end-of-query"),
        ),
        (
            names: [
                "--bind-address",
            ],
            description: Some("Use specified network interface to connect to MySQL Server"),
            arguments: [
                (
                    name: "ip_address",
                ),
            ],
        ),
        (
            names: [
                "--character-sets-dir",
            ],
            description: Some("Directory where character sets are installed"),
            arguments: [
                (
                    name: "dir_name",
                    description: Some("Directory where character sets are installed"),
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--column-names",
            ],
            description: Some("Write column names in results"),
        ),
        (
            names: [
                "--column-type-info",
            ],
            description: Some("Display result set metadata"),
        ),
        (
            names: [
                "--comments",
                "-c",
            ],
            description: Some("Whether to retain or strip comments in statements sent to the server"),
        ),
        (
            names: [
                "--compress",
                "-C",
            ],
            description: Some("Compress all information sent between client and server"),
        ),
        (
            names: [
                "--compression-algorithms",
            ],
            description: Some("Permitted compression algorithms for connections to server"),
            arguments: [
                (
                    name: "value",
                    suggestions: [
                        (
                            name: "zlib",
                        ),
                        (
                            name: "zstd",
                        ),
                        (
                            name: "uncompressed",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--connect-expired-password",
            ],
            description: Some("Indicate to server that client can handle expired-password sandbox mode"),
        ),
        (
            names: [
                "--connect-timeout",
            ],
            description: Some("Number of seconds before connection timeout"),
            arguments: [
                (
                    name: "value",
                ),
            ],
        ),
        (
            names: [
                "-D",
                "--database",
            ],
            description: Some("The database to use"),
            arguments: [
                (
                    name: "db_name",
                ),
            ],
        ),
        (
            names: [
                "--debug",
            ],
            description: Some("Write debugging log; supported only if MySQL was built with debugging support"),
        ),
        (
            names: [
                "--debug-check",
            ],
            description: Some("Print debugging information when program exits"),
        ),
        (
            names: [
                "-T",
                "--debug-info",
            ],
            description: Some("Print debugging information, memory, and CPU statistics when program exits"),
        ),
        (
            names: [
                "--default-auth",
            ],
            description: Some("Authentication plugin to use"),
            arguments: [
                (
                    name: "plugin",
                ),
            ],
        ),
        (
            names: [
                "--default-character-set",
            ],
            description: Some("Specify default character set"),
            arguments: [
                (
                    name: "charset_name",
                ),
            ],
        ),
        (
            names: [
                "--defaults-extra-file",
            ],
            description: Some("Read named option file in addition to usual option files"),
            arguments: [
                (
                    name: "file_name",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--defaults-file",
            ],
            description: Some("Read only named option file"),
            arguments: [
                (
                    name: "file_name",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--defaults-group-suffix",
            ],
            description: Some("Option group suffix value"),
            arguments: [
                (
                    name: "str",
                ),
            ],
        ),
        (
            names: [
                "--delimiter",
            ],
            description: Some("Set the statement delimiter"),
            arguments: [
                (
                    name: "str",
                ),
            ],
        ),
        (
            names: [
                "--disable-named-commands",
            ],
            description: Some("Disable named commands. Use the \\* form only, or use named commands only at the beginning of a line ending with a semicolon (;). mysql starts with this option enabled by default. However, even with this option, long-format commands still work from the first line"),
        ),
        (
            names: [
                "--dns-srv-name",
            ],
            description: Some("Use DNS SRV lookup for host information"),
            arguments: [
                (
                    name: "name",
                ),
            ],
        ),
        (
            names: [
                "--enable-cleartext-plugin",
            ],
            description: Some("Enable cleartext authentication plugin"),
        ),
        (
            names: [
                "-e",
                "--execute",
            ],
            description: Some("Execute the statement and quit"),
            arguments: [
                (
                    name: "statement",
                ),
            ],
        ),
        (
            names: [
                "-f",
                "--force",
            ],
            description: Some("Continue even if an SQL error occurs"),
        ),
        (
            names: [
                "--get-server-public-key",
            ],
            description: Some("Request RSA public key from server"),
        ),
        (
            names: [
                "--help",
                "-?",
            ],
            description: Some("Display help message and exit"),
        ),
        (
            names: [
                "--histignore",
            ],
            description: Some("Patterns specifying which statements to ignore for logging"),
        ),
        (
            names: [
                "-h",
                "--host",
            ],
            description: Some("Host on which MySQL server is located"),
            arguments: [
                (
                    name: "host_name",
                ),
            ],
        ),
        (
            names: [
                "-H",
                "--html",
            ],
            description: Some("Produce HTML output"),
        ),
        (
            names: [
                "-i",
                "--ignore-spaces",
            ],
            description: Some("Ignore spaces after function names"),
        ),
        (
            names: [
                "--init-command",
            ],
            description: Some("SQL statement to execute after connecting"),
            arguments: [
                (
                    name: "command",
                ),
            ],
            presentation: (
                insert_value: Some("{cursor}'"),
            ),
        ),
        (
            names: [
                "--line-numbers",
            ],
            description: Some("Write line numbers for errors"),
        ),
        (
            names: [
                "--load-data-local-dir",
            ],
            description: Some("Directory for files named in LOAD DATA LOCAL statements"),
            arguments: [
                (
                    name: "dir_name",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--local-infile",
            ],
            description: Some("Enable or disable for LOCAL capability for LOAD DATA"),
            arguments: [
                (
                    name: "is-local-inflie",
                    suggestions: [
                        (
                            name: "0",
                            description: Some("Disable"),
                        ),
                        (
                            name: "1",
                            description: Some("Enable"),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--login-path",
            ],
            description: Some("Read login path options from .mylogin.cnf"),
            arguments: [
                (
                    name: "name",
                ),
            ],
        ),
        (
            names: [
                "--max-allowed-packet",
            ],
            description: Some("Maximum packet length to send to or receive from server"),
            arguments: [
                (
                    name: "value",
                ),
            ],
        ),
        (
            names: [
                "--max-join-size",
            ],
            description: Some("The automatic limit for rows in a join when using --safe-updates"),
            arguments: [
                (
                    name: "value",
                ),
            ],
        ),
        (
            names: [
                "-G",
                "--named-commands",
            ],
            description: Some("Enable named mysql commands"),
        ),
        (
            names: [
                "--net-buffer-length",
            ],
            description: Some("Buffer size for TCP/IP and socket communication"),
            arguments: [
                (
                    name: "value",
                ),
            ],
        ),
        (
            names: [
                "--network-namespace",
            ],
            description: Some("Specify network namespace"),
            arguments: [
                (
                    name: "name",
                ),
            ],
        ),
        (
            names: [
                "-A",
                "--no-auto-rehash",
            ],
            description: Some("Disable automatic rehashing"),
        ),
        (
            names: [
                "--no-beep",
                "-b",
            ],
            description: Some("Do not beep when errors occur"),
        ),
        (
            names: [
                "--no-defaults",
            ],
            description: Some("Read no option files"),
        ),
        (
            names: [
                "-o",
                "--one-database",
            ],
            description: Some("Ignore statements except those for the default database named on the command line"),
        ),
        (
            names: [
                "--pager",
            ],
            description: Some("Use the given command for paging query output"),
            arguments: [
                (
                    name: "command",
                ),
            ],
        ),
        (
            names: [
                "-p",
                "--password",
            ],
            description: Some("Password to use when connecting to server"),
            arguments: [
                (
                    name: "password",
                ),
            ],
        ),
        (
            names: [
                "--pipe",
                "-W",
            ],
            description: Some("Connect to server using named pipe (Windows only)"),
        ),
        (
            names: [
                "--plugin-dir",
            ],
            description: Some("Directory where plugins are installed"),
            arguments: [
                (
                    name: "dir_name",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-P",
                "--port",
            ],
            description: Some("TCP/IP port number for connection"),
            arguments: [
                (
                    name: "port_num",
                ),
            ],
        ),
        (
            names: [
                "--print-defaults",
            ],
            description: Some("Print default options"),
        ),
        (
            names: [
                "--prompt",
            ],
            description: Some("Set the prompt to the specified format"),
            arguments: [
                (
                    name: "format_str",
                ),
            ],
        ),
        (
            names: [
                "--protocol",
            ],
            description: Some("Transport protocol to use"),
            arguments: [
                (
                    name: "format_str",
                    suggestions: [
                        (
                            name: "TCP",
                        ),
                        (
                            name: "SOCKET",
                        ),
                        (
                            name: "PIPE",
                        ),
                        (
                            name: "MEMORY",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-q",
                "--quick",
            ],
            description: Some("Do not cache each query result"),
        ),
        (
            names: [
                "-r",
                "--raw",
            ],
            description: Some("Write column values without escape conversion"),
        ),
        (
            names: [
                "--reconnect",
            ],
            description: Some("If the connection to the server is lost, automatically try to reconnect"),
        ),
        (
            names: [
                "-U",
                "--safe-updates",
                "--i-am-a-dummy",
            ],
            description: Some("Allow only UPDATE and DELETE statements that specify key values"),
        ),
        (
            names: [
                "--select-limit",
            ],
            description: Some("The automatic limit for SELECT statements when using --safe-updates"),
            arguments: [
                (
                    name: "value",
                ),
            ],
        ),
        (
            names: [
                "--server-public-key-path",
            ],
            description: Some("Path name to file containing RSA public key"),
            arguments: [
                (
                    name: "filename",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--shared-memory-base-name",
            ],
            description: Some("Shared-memory name for shared-memory connections (Windows only)"),
            arguments: [
                (
                    name: "name",
                ),
            ],
        ),
        (
            names: [
                "--show-warnings",
            ],
            description: Some("Show warnings after each statement if there are any"),
        ),
        (
            names: [
                "--sigint-ignore",
            ],
            description: Some("Ignore SIGINT signals (typically the result of typing Control+C)"),
        ),
        (
            names: [
                "-s",
                "--silent",
            ],
            description: Some("Silent mode.  Produce less output. This option can be given multiple times to produce less and less output"),
            repeat: Many,
        ),
        (
            names: [
                "--skip-auto-rehash",
            ],
            description: Some("Disable automatic rehashing"),
        ),
        (
            names: [
                "-N",
                "--skip-column-names",
            ],
            description: Some("Do not write column names in results"),
        ),
        (
            names: [
                "-L",
                "--skip-line-numbers",
            ],
            description: Some("Skip line numbers for errors"),
        ),
        (
            names: [
                "--skip-named-commands",
            ],
            description: Some("Disable named mysql commands"),
        ),
        (
            names: [
                "--skip-pager",
            ],
            description: Some("Disable paging"),
        ),
        (
            names: [
                "--skip-reconnect",
            ],
            description: Some("Disable reconnecting"),
        ),
        (
            names: [
                "-S",
                "--socket",
            ],
            description: Some("Unix socket file or Windows named pipe to use\"File that contains list of trusted SSL Certificate Authorities\""),
            arguments: [
                (
                    name: "name",
                ),
            ],
        ),
        (
            names: [
                "--ssl-ca",
            ],
            description: Some("File that contains list of trusted SSL Certificate Authorities"),
            arguments: [
                (
                    name: "filename",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--ssl-capath",
            ],
            description: Some("Directory that contains trusted SSL Certificate Authority certificate files"),
            arguments: [
                (
                    name: "dirname",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--ssl-cert",
            ],
            description: Some("File that contains X.509 certificate"),
            arguments: [
                (
                    name: "filename",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--ssl-cipher",
            ],
            description: Some("Permissible ciphers for connection encryption"),
        ),
        (
            names: [
                "--ssl-crl",
            ],
            description: Some("File that contains certificate revocation lists"),
            arguments: [
                (
                    name: "filename",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--ssl-crlpath",
            ],
            description: Some("Directory that contains certificate revocation-list files"),
            arguments: [
                (
                    name: "dirname",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--ssl-fips-mode",
            ],
            description: Some("Whether to enable FIPS mode on client side"),
            arguments: [
                (
                    name: "mode",
                    suggestions: [
                        (
                            name: "OFF",
                        ),
                        (
                            name: "ON",
                        ),
                        (
                            name: "STRICT",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--ssl-key",
            ],
            description: Some("File that contains X.509 key"),
            arguments: [
                (
                    name: "filename",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--ssl-mode",
            ],
            description: Some("Desired security state of connection to server"),
        ),
        (
            names: [
                "-j",
                "--syslog",
            ],
            description: Some("Log interactive statements to syslog"),
        ),
        (
            names: [
                "-t",
                "--table",
            ],
            description: Some("Display output in tabular format"),
        ),
        (
            names: [
                "--tee",
            ],
            description: Some("Append a copy of output to named file"),
            arguments: [
                (
                    name: "file_name",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--tls-ciphersuites",
            ],
            description: Some("Permissible TLSv1.3 ciphersuites for encrypted connections"),
            arguments: [
                (
                    name: "ciphersuite_list",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--tls-version",
            ],
            description: Some("Permissible TLS protocols for encrypted connections"),
            arguments: [
                (
                    name: "protocol_list",
                ),
            ],
        ),
        (
            names: [
                "-n",
                "--unbuffered",
            ],
            description: Some("Flush the buffer after each query"),
        ),
        (
            names: [
                "-u",
                "--user",
            ],
            description: Some("MySQL user name to use when connecting to server"),
            arguments: [
                (
                    name: "user_name",
                ),
            ],
        ),
        (
            names: [
                "-v",
                "--verbose",
            ],
            description: Some("Verbose mode"),
        ),
        (
            names: [
                "-V",
                "--version",
            ],
            description: Some("Display version information and exit"),
        ),
        (
            names: [
                "-E",
                "--vertical",
            ],
            description: Some("Print query output rows vertically (one line per column value)"),
        ),
        (
            names: [
                "-w",
                "--wait",
            ],
            description: Some("If the connection cannot be established, wait and retry instead of aborting"),
        ),
        (
            names: [
                "-X",
                "--xml",
            ],
            description: Some("Produce XML output"),
        ),
        (
            names: [
                "--zstd-compression-level",
            ],
            description: Some("Compression level for connections to server that use zstd compression"),
            arguments: [
                (
                    name: "level",
                    description: Some("Compression level between 1-22. The default zstd compression level is 3. The compression level setting has no effect on connections that do not use zstd compression"),
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "",
        ),
    ],
)
