(
    version: 1,
    command: "head",
    description: Some("Output the first part of files"),
    options: [
        (
            names: [
                "-c",
                "--bytes",
            ],
            description: Some("Print the first [numBytes] bytes of each file"),
            arguments: [
                (
                    name: "numBytes",
                ),
            ],
        ),
        (
            names: [
                "-n",
                "--lines",
            ],
            description: Some("Print the first [numLines] lines instead of the first 10"),
            arguments: [
                (
                    name: "numLines",
                ),
            ],
        ),
        (
            names: [
                "-q",
                "--quiet",
                "--silent",
            ],
            description: Some("Never print headers giving file names"),
        ),
        (
            names: [
                "-v",
                "--verbose",
            ],
            description: Some("Always print headers giving file names"),
        ),
        (
            names: [
                "--help",
            ],
            description: Some("Display this help and exit"),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Output version information and exit"),
        ),
    ],
    arguments: [
        (
            name: "file",
            template: [
                FilePaths,
            ],
        ),
    ],
)
