            names: [
                "--version",
                "-v",
            ],
            description: Some("Version for dapr"),
        ),
        (
            names: [
                "--log-as-json",
            ],
            description: Some("Log output in JSON format"),
            persistent: true,
        ),
        (
            names: [
                "--runtime-path",
            ],
            description: Some("The path to the dapr runtime installation directory"),
            arguments: [
                (
                    name: "runtime-path",
                    template: [
                        Folders,
                    ],
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Display help"),
            persistent: true,
        ),
    ],
)
