(
    version: 1,
    command: "dapr",
    description: Some("Dapr CLI"),
    subcommands: [
        (
            name: "annotate",
            description: Some("Add dapr annotations to a Kubernetes configuration. Supported platforms: Kubernetes"),
            options: [
                (
                    names: [
                        "--api-token-secret",
                    ],
                    description: Some("The secret to use for the API token"),
                    arguments: [
                        (
                            name: "api-token-secret",
                        ),
                    ],
                ),
                (
                    names: [
                        "--app-id",
                        "-a",
                    ],
                    description: Some("The app id to annotate"),
                    arguments: [
                        (
                            name: "app-id",
                            generators: [
                                (
                                    script: [
                                        "dapr",
                                        "list",
                                        "-A",
                                        "-o",
                                        "json",
                                    ],
                                    has_post_process: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--app-max-concurrency",
                    ],
                    description: Some("The maximum number of concurrent requests to allow"),
                    arguments: [
                        (
                            name: "app-max-concurrency",
                            default: Some("-1"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--app-port",
                        "-p",
                    ],
                    description: Some("The port to expose the app on"),
                    arguments: [
                        (
                            name: "app-port",
                            default: Some("-1"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--app-protocol",
                    ],
                    description: Some("The protocol to use for the app. Allowed values http, https, h2c, grpc, grpcs"),
                    arguments: [
                        (
                            name: "app-protocol",
                            suggestions: [
                                (
                                    name: "http",
                                ),
                                (
                                    name: "https",
                                ),
                                (
                                    name: "h2c",
                                ),
                                (
                                    name: "grpc",
                                ),
                                (
                                    name: "grpcs",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--app-ssl",
                    ],
                    description: Some("Enable SSL for the app"),
                    presentation: (
                        hidden: true,
                    ),
                ),
                (
                    names: [
                        "--app-token-secret",
                    ],
                    description: Some("The secret to use for the app token"),
                    arguments: [
                        (
                            name: "app-token-secret",
                        ),
                    ],
                ),
                (
                    names: [
                        "--config",
                        "-c",
                    ],
                    description: Some("The config file to annotate"),
                    arguments: [
                        (
                            name: "config",
                            generators: [
                                (
                                    has_custom: true,
                                    has_dynamic_trigger: true,
                                    has_dynamic_query_term: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--cpu-limit",
                    ],
                    description: Some("The CPU limit to set"),
                    arguments: [
                        (
                            name: "cpu-limit",
                        ),
                    ],
                ),
                (
                    names: [
                        "--cpu-request",
                    ],
                    description: Some("The CPU request to set"),
                    arguments: [
                        (
                            name: "cpu-request",
                        ),
                    ],
                ),
                (
                    names: [
                        "--dapr-image",
                    ],
                    description: Some("The image to use for the dapr sidecar container"),
                    arguments: [
                        (
                            name: "dapr-image",
                        ),
                    ],
                ),
                (
                    names: [
                        "--disable-builtin-k8s-secret-store",
                    ],
                    description: Some("Disable the built-in k8s secret store"),
                ),
                (
                    names: [
                        "--enable-api-logging",
                    ],
                    description: Some("Enable API logging for the Dapr sidecar"),
                ),
                (
                    names: [
                        "--enable-debug",
                    ],
                    description: Some("Enable debug"),
                ),
                (
                    names: [
                        "--enable-metrics",
                    ],
                    description: Some("Enable metrics"),
                ),
                (
                    names: [
                        "--enable-profile",
                    ],
                    description: Some("Enable profiling"),
                ),
                (
                    names: [
                        "--env",
                    ],
                    description: Some("Environment variables to set (key value pairs, comma separated)"),
                    arguments: [
                        (
                            name: "env",
                        ),
                    ],
                ),
                (
                    names: [
                        "--graceful-shutdown-seconds",
                    ],
                    description: Some("The number of seconds to wait for the app to shutdown"),
                    arguments: [
                        (
                            name: "graceful-shutdown-seconds",
                            default: Some("-1"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--http-read-buffer-size",
                    ],
                    description: Some("The maximum size of HTTP header read buffer in kilobytes"),
                    arguments: [
                        (
                            name: "http-read-buffer-size",
                            default: Some("-1"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--http-stream-request-body",
                    ],
                    description: Some("Enable streaming request body for HTTP"),
                ),
                (
                    names: [
                        "--kubernetes",
                        "-k",
                    ],
                    description: Some("Apply annotations to Kubernetes resources"),
                    required: true,
                    presentation: (
                        priority: Some(100.0),
                    ),
                ),
                (
                    names: [
                        "--listen-addresses",
                    ],
                    description: Some("The addresses to listen on"),
                    arguments: [
                        (
                            name: "listen-addresses",
                        ),
                    ],
                ),
                (
                    names: [
                        "--liveness-probe-delay",
                    ],
                    description: Some("The delay to use for the liveness probe"),
                    arguments: [
                        (
                            name: "liveness-probe-delay",
                            default: Some("-1"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--liveness-probe-period",
                    ],
                    description: Some("The period to use for the liveness probe"),
                    arguments: [
                        (
                            name: "liveness-probe-period",
                            default: Some("-1"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--liveness-probe-threshold",
                    ],
                    description: Some("The threshold to use for the liveness probe"),
                    arguments: [
                        (
                            name: "liveness-probe-threshold",
                            default: Some("-1"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--liveness-probe-timeout",
                    ],
                    description: Some("The timeout to use for the liveness probe"),
                    arguments: [
                        (
                            name: "liveness-probe-timeout",
                            default: Some("-1"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--log-as-json",
                    ],
                    description: Some("Log as JSON"),
                ),
                (
                    names: [
                        "--log-level",
                    ],
                    description: Some("The log level to use"),
                    arguments: [
                        (
                            name: "log-level",
                        ),
                    ],
                ),
                (
                    names: [
                        "--max-request-body-size",
                    ],
                    description: Some("The maximum request body size to use"),
                    arguments: [
                        (
                            name: "max-request-body-size",
                            default: Some("-1"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--memory-limit",
                    ],
                    description: Some("The memory limit to set"),
                    arguments: [
                        (
                            name: "memory-limit",
                        ),
                    ],
                ),
                (
                    names: [
                        "--memory-request",
                    ],
                    description: Some("The memory request to set"),
                    arguments: [
                        (
                            name: "memory-request",
                        ),
                    ],
                ),
                (
                    names: [
                        "--metrics-port",
                    ],
                    description: Some("The port to expose the metrics on"),
                    arguments: [
                        (
                            name: "metrics-port",
                            default: Some("-1"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--namespace",
                        "-n",
                    ],
                    description: Some("The namespace the resource target is in (can only be set if --resource is also set)"),
                    arguments: [
                        (
                            name: "namespace",
                        ),
                    ],
                ),
                (
                    names: [
                        "--placement-host-address",
                    ],
                    description: Some("Comma separated list of addresses for Dapr actor placement servers"),
                    arguments: [
                        (
                            name: "placement-host-address",
                        ),
                    ],
                ),
                (
                    names: [
                        "--readiness-probe-delay",
                    ],
                    description: Some("The delay to use for the readiness probe"),
                    arguments: [
                        (
                            name: "readiness-probe-delay",
                            default: Some("-1"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--readiness-probe-period",
                    ],
                    description: Some("The period to use for the readiness probe"),
                    arguments: [
                        (
                            name: "readiness-probe-period",
                            default: Some("-1"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--readiness-probe-threshold",
                    ],
                    description: Some("The threshold to use for the readiness probe"),
                    arguments: [
                        (
                            name: "readiness-probe-threshold",
                            default: Some("-1"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--readiness-probe-timeout",
                    ],
                    description: Some("The timeout to use for the readiness probe"),
                    arguments: [
                        (
                            name: "readiness-probe-timeout",
                            default: Some("-1"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--resource",
                        "-r",
                    ],
                    description: Some("The resource to target to annotate"),
                    arguments: [
                        (
                            name: "resource",
                        ),
                    ],
                ),
                (
                    names: [
                        "--unix-domain-socket-path",
                    ],
                    description: Some("Linux domain socket path to use for communicating with the Dapr sidecar"),
                    arguments: [
                        (
                            name: "unix-domain-socket-path",
                        ),
                    ],
                ),
                (
                    names: [
                        "--volume-mounts",
                    ],
                    description: Some("List of pod volumes to be mounted to the sidecar container in read-only mode"),
                    arguments: [
                        (
                            name: "volume-mounts",
                        ),
                    ],
                ),
                (
                    names: [
                        "--volume-mounts-rw",
                    ],
                    description: Some("List of pod volumes to be mounted to the sidecar container in read-write mode"),
                    arguments: [
                        (
                            name: "volume-mounts-rw",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "config",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "build-info",
            description: Some("Print build info of Dapr CLI and runtime"),
            options: [
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Print this help message"),
                ),
            ],
        ),
        (
            name: "completion",
            description: Some("Generates shell completion scripts"),
            subcommands: [
                (
                    name: "bash",
                    description: Some("Generates bash completion scripts"),
                    options: [
                        (
                            names: [
                                "--help",
                                "-h",
                            ],
                            description: Some("Print this help message"),
                        ),
                    ],
                ),
                (
                    name: "fish",
                    description: Some("Generates fish completion scripts"),
                    options: [
                        (
                            names: [
                                "--help",
                                "-h",
                            ],
                            description: Some("Print this help message"),
                        ),
                    ],
                ),
                (
                    name: "powershell",
                    description: Some("Generates powershell completion scripts"),
                    options: [
                        (
                            names: [
                                "--help",
                                "-h",
                            ],
                            description: Some("Print this help message"),
                        ),
                    ],
                ),
                (
                    name: "zsh",
                    description: Some("Generates zsh completion scripts"),
                    options: [
                        (
                            names: [
                                "--help",
                                "-h",
                            ],
                            description: Some("Print this help message"),
                        ),
                    ],
                ),
            ],
            options: [
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Print this help message"),
                ),
            ],
        ),
        (
            name: "components",
            description: Some("List all Dapr components. Supported platforms: Kubernetes"),
            options: [
                (
                    names: [
                        "--all-namespaces",
                        "-A",
                    ],
                    description: Some("If true, list all Dapr components in all namespaces"),
                ),
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Print this help message"),
                ),
                (
                    names: [
                        "--kubernetes",
                        "-k",
                    ],
                    description: Some("List all Dapr components in a Kubernetes cluster"),
                    required: true,
                ),
                (
                    names: [
                        "--name",
                        "-n",
                    ],
                    description: Some("The components name to be printed (optional)"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--namespace",
                    ],
                    description: Some("List all namespace components in a Kubernetes cluster"),
                    arguments: [
                        (
                            name: "namespace",
                        ),
                    ],
                ),
                (
                    names: [
                        "--output",
                        "-o",
                    ],
                    description: Some("Output format (options: json or yaml or list)"),
                    arguments: [
                        (
                            name: "output",
                            suggestions: [
                                (
                                    name: "json",
                                ),
                                (
                                    name: "yaml",
                                ),
                                (
                                    name: "list",
                                ),
                            ],
                            default: Some("list"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "configurations",
            description: Some("List all Dapr configurations. Supported platforms: Kubernetes"),
            options: [
                (
                    names: [
                        "--all-namespaces",
                        "-A",
                    ],
                    description: Some("If true, list all Dapr configurations in all namespaces"),
                ),
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Print this help message"),
                ),
                (
                    names: [
                        "--kubernetes",
                        "-k",
                    ],
                    description: Some("List all Dapr configurations in a Kubernetes cluster"),
                    required: true,
                ),
                (
                    names: [
                        "--name",
                        "-n",
                    ],
                    description: Some("The configuration name to be printed (optional)"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--namespace",
                    ],
                    description: Some("List Define namespace configurations in a Kubernetes cluster"),
                    arguments: [
                        (
                            name: "namespace",
                        ),
                    ],
                ),
                (
                    names: [
                        "--output",
                        "-o",
                    ],
                    description: Some("Output format (options: json or yaml or list)"),
                    arguments: [
                        (
                            name: "output",
                            suggestions: [
                                (
                                    name: "json",
                                ),
                                (
                                    name: "yaml",
                                ),
                                (
                                    name: "list",
                                ),
                            ],
                            default: Some("list"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "dashboard",
            description: Some("Start Dapr dashboard. Supported platforms: Kubernetes and self-hosted"),
            options: [
                (
                    names: [
                        "--address",
                        "-a",
                    ],
                    description: Some("Address to listen on. Only accepts IP address or localhost as a value"),
                    arguments: [
                        (
                            name: "address",
                            default: Some("localhost"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Print this help message"),
                ),
                (
                    names: [
                        "--kubernetes",
                        "-k",
                    ],
                    description: Some("Opens Dapr dashboard in local browser via local proxy to Kubernetes cluster"),
                ),
                (
                    names: [
                        "--namespace",
                        "-n",
                    ],
                    description: Some("The namespace where Dapr dashboard is running"),
                    arguments: [
                        (
                            name: "namespace",
                            default: Some("dapr-system"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--port",
                        "-p",
                    ],
                    description: Some("The local port on which to serve Dapr dashboard"),
                    arguments: [
                        (
                            name: "port",
                            default: Some("8080"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--version",
                        "-v",
                    ],
                    description: Some("Print the version for Dapr dashboard"),
                ),
            ],
        ),
        (
            name: "init",
            description: Some("Install Dapr on supported hosting platforms. Supported platforms: Kubernetes and self-hosted"),
            options: [
                (
                    names: [
                        "--ca-root-certificate",
                    ],
                    description: Some("The root certificate file"),
                    arguments: [
                        (
                            name: "ca-root-certificate",
                        ),
                    ],
                ),
                (
                    names: [
                        "--container-runtime",
                    ],
                    description: Some("The container runtime to use. Supported values are docker (default) and podman"),
                    arguments: [
                        (
                            name: "container-runtime",
                            suggestions: [
                                (
                                    name: "docker",
                                ),
                                (
                                    name: "podman",
                                ),
                            ],
                            default: Some("docker"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--dashboard-version",
                    ],
                    description: Some("The version of the Dapr dashboard to install, for example: 0.13.0"),
                    arguments: [
                        (
                            name: "dashboard-version",
                            default: Some("latest"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--dev",
                    ],
                    description: Some("Use Dev mode. Deploy Redis, Zipkin also in the Kubernetes cluster"),
                ),
                (
                    names: [
                        "--enable-ha",
                    ],
                    description: Some("Enable high availability (HA) mode"),
                ),
                (
                    names: [
                        "--enable-mtls",
                    ],
                    description: Some("Enable mTLS in your cluster"),
                ),
                (
                    names: [
                        "--from-dir",
                    ],
                    description: Some("Use Dapr artifacts from local directory for self-hosted installation"),
                    arguments: [
                        (
                            name: "from-dir",
                        ),
                    ],
                ),
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Print this help message"),
                ),
                (
                    names: [
                        "--image-registry",
                    ],
                    description: Some("Custom/private docker image repository URL"),
                    arguments: [
                        (
                            name: "image-registry",
                        ),
                    ],
                ),
                (
                    names: [
                        "--image-variant",
                    ],
                    description: Some("The image variant to use for the Dapr runtime, for example: mariner"),
                    arguments: [
                        (
                            name: "image-variant",
                        ),
                    ],
                ),
                (
                    names: [
                        "--issuer-private-key",
                    ],
                    description: Some("The issuer certificate private key"),
                    arguments: [
                        (
                            name: "issuer-private-key",
                        ),
                    ],
                ),
                (
                    names: [
                        "--issuer-public-certificate",
                    ],
                    description: Some("The issuer certificate"),
                    arguments: [
                        (
                            name: "issuer-public-certificate",
                        ),
                    ],
                ),
                (
                    names: [
                        "--kubernetes",
                        "-k",
                    ],
                    description: Some("Deploy Dapr to a Kubernetes cluster"),
                ),
                (
                    names: [
                        "--namespace",
                        "-n",
                    ],
                    description: Some("The Kubernetes namespace to install Dapr in"),
                    arguments: [
                        (
                            name: "namespace",
                            default: Some("dapr-system"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--network",
                    ],
                    description: Some("The Docker network on which to deploy the Dapr runtime"),
                    arguments: [
                        (
                            name: "network",
                        ),
                    ],
                ),
                (
                    names: [
                        "--runtime-version",
                    ],
                    description: Some("The version of the Dapr runtime to install, for example: 1.0.0"),
                    arguments: [
                        (
                            name: "runtime-version",
                            generators: [
                                (
                                    has_custom: true,
                                    cache: Some((
                                        ttl_ms: Some(172800000),
                                        stale_while_revalidate: true,
                                    )),
                                ),
                            ],
                            suggest_current_token: true,
                            default: Some("latest"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--set",
                    ],
                    description: Some("Set values on the command line (can specify multiple or separate values with commas: key1=val1,key2=val2)"),
                    arguments: [
                        (
                            name: "set",
                        ),
                    ],
                    repeat: Many,
                ),
                (
                    names: [
                        "--slim",
                        "-s",
                    ],
                    description: Some("Exclude placement service, Redis and Zipkin containers from self-hosted installation"),
                ),
                (
                    names: [
                        "--timeout",
                    ],
                    description: Some("The wait timeout for the Kubernetes installation"),
                    arguments: [
                        (
                            name: "timeout",
                            default: Some("300"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--wait",
                    ],
                    description: Some("Wait for Kubernetes initialization to complete"),
                ),
            ],
        ),
        (
            name: "invoke",
            description: Some("Invoke a method on a given Dapr application. Supported platforms: Self-hosted"),
            options: [
                (
                    names: [
                        "--app-id",
                        "-a",
                    ],
                    description: Some("The application id to invoke"),
                    arguments: [
                        (
                            name: "app-id",
                            generators: [
                                (
                                    script: [
                                        "dapr",
                                        "list",
                                        "-A",
                                        "-o",
                                        "json",
                                    ],
                                    has_post_process: true,
                                ),
                            ],
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--data",
                        "-d",
                    ],
                    description: Some("The JSON serialized data string (optional)"),
                    arguments: [
                        (
                            name: "data",
                        ),
                    ],
                ),
                (
                    names: [
                        "--data-file",
                        "-f",
                    ],
                    description: Some("A file containing the JSON serialized data (optional)"),
                    arguments: [
                        (
                            name: "data-file",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Print this help message"),
                ),
                (
                    names: [
                        "--method",
                        "-m",
                    ],
                    description: Some("The method to invoke"),
                    arguments: [
                        (
                            name: "method",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--unix-domain-socket",
                        "-u",
                    ],
                    description: Some("Path to a unix domain socket dir. If specified, Dapr API servers will use Unix Domain Sockets"),
                    arguments: [
                        (
                            name: "unix-domain-socket",
                        ),
                    ],
                ),
                (
                    names: [
                        "--verb",
                        "-v",
                    ],
                    description: Some("The HTTP verb to use"),
                    arguments: [
                        (
                            name: "verb",
                            default: Some("POST"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "list",
            description: Some("List all Dapr instances. Supported platforms: Kubernetes and self-hosted"),
            options: [
                (
                    names: [
                        "--all-namespaces",
                        "-A",
                    ],
                    description: Some("If true, list all Dapr pods in all namespaces"),
                ),
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Print this help message"),
                ),
                (
                    names: [
                        "--kubernetes",
                        "-k",
                    ],
                    description: Some("List all Dapr pods in a Kubernetes cluster"),
                ),
                (
                    names: [
                        "--namespace",
                    ],
                    description: Some("List define namespace pod in a Kubernetes cluster"),
                    arguments: [
                        (
                            name: "namespace",
                        ),
                    ],
                ),
                (
                    names: [
                        "--output",
                        "-o",
                    ],
                    description: Some("The output format of the list. Valid values are: json, yaml, or table (default)"),
                    arguments: [
                        (
                            name: "output",
                            suggestions: [
                                (
                                    name: "json",
                                ),
                                (
                                    name: "yaml",
                                ),
                                (
                                    name: "table",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
