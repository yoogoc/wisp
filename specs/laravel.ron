(
    version: 1,
    command: "laravel",
    description: Some("Laravel Installer"),
    subcommands: [
        (
            name: "help",
            options: [
                (
                    names: [
                        "--format",
                    ],
                    description: Some("The output format (txt, xml, json, or md)"),
                    arguments: [
                        (
                            name: "",
                            suggestions: [
                                (
                                    name: "txt",
                                ),
                                (
                                    name: "xml",
                                ),
                                (
                                    name: "json",
                                ),
                                (
                                    name: "md",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--raw",
                    ],
                    description: Some("To output raw command list"),
                ),
            ],
        ),
        (
            name: "list",
            options: [
                (
                    names: [
                        "--format",
                    ],
                    description: Some("The output format (txt, xml, json, or md)"),
                    arguments: [
                        (
                            name: "",
                            suggestions: [
                                (
                                    name: "txt",
                                ),
                                (
                                    name: "xml",
                                ),
                                (
                                    name: "json",
                                ),
                                (
                                    name: "md",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--raw",
                    ],
                    description: Some("To output raw command list"),
                ),
            ],
        ),
        (
            name: "new",
            description: Some("Create a new Laravel application"),
            options: [
                (
                    names: [
                        "--dev",
                    ],
                    description: Some("Installs the latest \"development\" release"),
                ),
                (
                    names: [
                        "--git",
                    ],
                    description: Some("Initialize a Git repository"),
                ),
                (
                    names: [
                        "--branch",
                    ],
                    description: Some("The branch that should be created for a new repository"),
                    arguments: [
                        (
                            name: "BRANCH",
                            default: Some("main"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--github",
                    ],
                    description: Some("Create a new repository on GitHub"),
                    arguments: [
                        (
                            name: "GITHUB",
                            optional: true,
                            default: Some("false"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--jet",
                    ],
                    description: Some("Installs the Laravel Jetstream scaffolding"),
                ),
                (
                    names: [
                        "--stack",
                    ],
                    description: Some("The Jetstream stack that should be installed"),
                    arguments: [
                        (
                            name: "STACK",
                            suggestions: [
                                (
                                    name: "livewire",
                                ),
                                (
                                    name: "inertia",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--teams",
                    ],
                    description: Some("Indicates whether Jetstream should be scaffolded with team support"),
                ),
                (
                    names: [
                        "--prompt-jetstream",
                    ],
                    description: Some("Issues a prompt to determine if Jetstream should be installed"),
                ),
                (
                    names: [
                        "-f",
                        "--force",
                    ],
                    description: Some("Forces install even if the directory already exists"),
                ),
            ],
            arguments: [
                (
                    name: "name",
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Display the help message"),
        ),
        (
            names: [
                "-q",
                "--quiet",
            ],
            description: Some("Do not output any message"),
        ),
        (
            names: [
                "-V",
                "--version",
            ],
            description: Some("Display this application version"),
        ),
        (
            names: [
                "--ansi",
            ],
            description: Some("Force ANSI output"),
        ),
        (
            names: [
                "--no-ansi",
            ],
            description: Some("Disable ANSI output"),
        ),
        (
            names: [
                "-n",
                "--no-interaction",
            ],
            description: Some("Do not ask any interactive question"),
        ),
        (
            names: [
                "-v",
                "--verbose",
            ],
            description: Some("Increase the verbosity of messages: 1 for normal output, 2 for more verbose output and 3 for debug"),
            repeat: Times(3),
        ),
    ],
)
