                        (
                            name: "file",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--contents",
                    ],
                    description: Some("Use <file>'s contents as the final image"),
                    arguments: [
                        (
                            name: "file",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-C",
                    ],
                    description: Some("Find line copies within and across files"),
                    presentation: (
                        insert_value: Some("-C{cursor}"),
                    ),
                ),
                (
                    names: [
                        "-M",
                    ],
                    description: Some("Find line movements within and across files"),
                    presentation: (
                        insert_value: Some("-M{cursor}"),
                    ),
                ),
                (
                    names: [
                        "-L",
                    ],
                    description: Some("Process only line range <start>,<end> or function :<funcname>"),
                    arguments: [
                        (
                            name: "start,end",
                        ),
                    ],
                ),
                (
                    names: [
                        "--abbrev",
                    ],
                    description: Some("Use <n> digits to display object names"),
                    arguments: [
                        (
                            name: "n",
                            optional: true,
                        ),
                    ],
                    requires_separator: Some("="),
                ),
            ],
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
