                            name: "http.<url>.proxyAuthMethod",
                            description: Some("Set the method with which to authenticate against the HTTP proxy. This only takes effect if the configured proxy string contains a user name part (i.e. is of the form 'user@host' or 'user@host:port'). This can be overridden on a per-remote basis; see `remote.<name>.proxyAuthMethod`. Both can be overridden by the `GIT_HTTP_PROXY_AUTHMETHOD` environment variable. Possible values are:"),
                            presentation: (
                                icon: Some("⚙️"),
                                insert_value: Some("http.{cursor}.proxyAuthMethod"),
                            ),
                        ),
