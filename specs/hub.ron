(
    version: 1,
    command: "git",
    description: Some("Distributed version control system"),
    subcommands: [
        (
            name: "archive",
            description: Some("Create an archive of files from a named tree"),
            options: [
                (
                    names: [
                        "--format",
                    ],
                    description: Some("Archive format"),
                    arguments: [
                        (
                            name: "fmt",
                            suggestions: [
                                (
                                    name: "tar",
                                ),
                                (
                                    name: "zip",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--prefix",
                    ],
                    description: Some("Prepend prefix to each pathname in the archive"),
                    arguments: [
                        (
                            name: "prefix",
                        ),
                    ],
                ),
                (
                    names: [
                        "--add-file",
                    ],
                    description: Some("Add untracked file to archive"),
                    arguments: [
                        (
                            name: "file",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-o",
                        "--output",
                    ],
                    description: Some("Write the archive to this file"),
                    arguments: [
                        (
                            name: "file",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--worktree-attributes",
                    ],
                    description: Some("Read .gitattributes in working directory"),
                ),
                (
                    names: [
                        "-v",
                        "--verbose",
                    ],
                    description: Some("Report archived files on stderr"),
                ),
                (
                    names: [
                        "-NUM",
                    ],
                    description: Some("Set compression level"),
                    presentation: (
                        insert_value: Some("-"),
                    ),
                ),
                (
                    names: [
                        "-l",
                        "--list",
                    ],
                    description: Some("List supported archive formats"),
                ),
                (
                    names: [
                        "--remote",
                    ],
                    description: Some("Retrieve the archive from remote repository <repo>"),
                    arguments: [
                        (
                            name: "repo",
                        ),
                    ],
                ),
                (
                    names: [
                        "--exec",
                    ],
                    description: Some("Path to the remote git-upload-archive command"),
                    arguments: [
                        (
                            name: "command",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "tree-ish",
                    generators: [
                        (
                            script: [
                                "git",
                                "--no-optional-locks",
                                "diff",
                                "--cached",
                                "--name-only",
                            ],
                            kind: File,
                            has_post_process: true,
                        ),
                    ],
                ),
                (
                    name: "path",
                    template: [
                        FilePaths,
                    ],
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "blame",
            options: [
                (
                    names: [
                        "--incremental",
                    ],
                    description: Some("Show blame entries as we find them, incrementally"),
                ),
                (
                    names: [
                        "-b",
                    ],
                    description: Some("Do not show object names of boundary commits (Default: off)"),
                ),
                (
                    names: [
                        "--root",
                    ],
                    description: Some("Do not treat root commits as boundaries (Default: off)"),
                ),
                (
                    names: [
                        "--show-stats",
                    ],
                    description: Some("Show work cost statistics"),
                ),
                (
                    names: [
                        "--progress",
                    ],
                    description: Some("Force progress reporting"),
                ),
                (
                    names: [
                        "--score-debug",
                    ],
                    description: Some("Show output score for blame entries"),
                ),
                (
                    names: [
                        "-f",
                        "--show-name",
                    ],
                    description: Some("Show original filename (Default: auto)"),
                ),
                (
                    names: [
                        "-n",
                        "--show-number",
                    ],
                    description: Some("Show original linenumber (Default: off)"),
                ),
                (
                    names: [
                        "-p",
                        "--porcelain",
                    ],
                    description: Some("Show in a format designed for machine consumption"),
                ),
                (
                    names: [
                        "--line-porcelain",
                    ],
                    description: Some("Show porcelain format with per-line commit information"),
                ),
                (
                    names: [
                        "-c",
                    ],
                    description: Some("Use the same output mode as git-annotate (Default: off)"),
                ),
                (
                    names: [
                        "-t",
                    ],
                    description: Some("Show raw timestamp (Default: off)"),
                ),
                (
                    names: [
                        "-l",
                    ],
                    description: Some("Show long commit SHA1 (Default: off)"),
                ),
                (
                    names: [
                        "-s",
                    ],
                    description: Some("Suppress author name and timestamp (Default: off)"),
                ),
                (
                    names: [
                        "-e",
                        "--show-email",
                    ],
                    description: Some("Show author email instead of name (Default: off)"),
                ),
                (
                    names: [
                        "-w",
                    ],
                    description: Some("Ignore whitespace differences"),
                ),
                (
                    names: [
                        "--ignore-rev",
                    ],
                    description: Some("Ignore <rev> when blaming"),
                    arguments: [
                        (
                            name: "rev",
                            generators: [
                                (
                                    script: [
                                        "git",
                                        "rev-list",
                                        "--all",
                                        "--oneline",
                                    ],
                                    pipeline: Lines((delimiter: Some(""), name: 0, description: Some(From(1)))),
                                    has_post_process: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--ignore-revs-file",
                    ],
                    description: Some("Ignore revisions from <file>"),
                    arguments: [
                        (
                            name: "file",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--color-lines",
                    ],
                    description: Some("Color redundant metadata from previous line differently"),
                ),
                (
                    names: [
                        "--color-by-age",
                    ],
                    description: Some("Color lines by age"),
                ),
                (
                    names: [
                        "--minimal",
                    ],
                    description: Some("Spend extra cycles to find better match"),
                ),
                (
                    names: [
                        "-S",
                    ],
                    description: Some("Use revisions from <file> instead of calling git-rev-list"),
