                        "--config",
                    ],
                    description: Some("Set a configuration variable in the newly-created repository; this takes effect immediately after the repository is initialized, but before the remote history is fetched or any files checked out. The key is in the same format as expected by git-config[1] (e.g., core.eol=true). If multiple values are given for the same key, each value will be written to the config file. This makes it safe, for example, to add additional fetch refspecs to the origin remote. Due to limitations of the current implementation, some configuration variables do not take effect until after the initial fetch and checkout. Configuration variables known to not take effect are: remote.<name>.mirror and remote.<name>.tagOpt. Use the corresponding --mirror and --no-tags options instead"),
                    arguments: [
                        (
                            name: "key=value",
                        ),
                    ],
                ),
                (
                    names: [
                        "--depth",
                    ],
                    description: Some("Create a shallow clone with a history truncated to the specified number of commits. Implies --single-branch unless --no-single-branch is given to fetch the histories near the tips of all branches. If you want to clone submodules shallowly, also pass --shallow-submodules"),
                    arguments: [
                        (
                            name: "depth",
                        ),
                    ],
                ),
                (
                    names: [
                        "--shallow-since",
                    ],
                    description: Some("Create a shallow clone with a history after the specified time"),
                    arguments: [
                        (
                            name: "date",
                        ),
                    ],
                    requires_separator: Some("="),
                ),
                (
                    names: [
                        "--shallow-exclude",
                    ],
                    description: Some("Create a shallow clone with a history, excluding commits reachable from a specified remote branch or tag. This option can be specified multiple times"),
                    arguments: [
                        (
                            name: "revision",
                        ),
                    ],
                    requires_separator: Some("="),
                ),
                (
                    names: [
                        "--single-branch",
                    ],
                    description: Some("Clone only the history leading to the tip of a single branch, either specified by the --branch option or the primary branch remote’s HEAD points at. Further fetches into the resulting repository will only update the remote-tracking branch for the branch this option was used for the initial cloning. If the HEAD at the remote did not point at any branch when --single-branch clone was made, no remote-tracking branch is created"),
                ),
                (
                    names: [
                        "--no-single-branch",
                    ],
                    description: Some("Do not clone only the history leading to the tip of a single branch, either specified by the --branch option or the primary branch remote’s HEAD points at. Further fetches into the resulting repository will only update the remote-tracking branch for the branch this option was used for the initial cloning. If the HEAD at the remote did not point at any branch when --single-branch clone was made, no remote-tracking branch is created"),
                ),
                (
                    names: [
                        "--no-tags",
                    ],
                    description: Some("Don’t clone any tags, and set remote.<remote>.tagOpt=--no-tags in the config, ensuring that future git pull and git fetch operations won’t follow any tags. Subsequent explicit tag fetches will still work, (see git-fetch[1])"),
                ),
                (
                    names: [
                        "--recurse-submodules",
                    ],
                    description: Some("After the clone is created, initialize and clone submodules within based on the provided pathspec. If no pathspec is provided, all submodules are initialized and cloned. This option can be given multiple times for pathspecs consisting of multiple entries"),
                    arguments: [
                        (
                            name: "pathspec",
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--shallow-submodules",
                    ],
                    description: Some("All submodules which are cloned will be shallow with a depth of 1"),
                ),
                (
                    names: [
                        "--no-shallow-submodules",
                    ],
                    description: Some("Disable --shallow-submodules"),
                ),
                (
                    names: [
                        "--remote-submodules",
                    ],
                    description: Some("All submodules which are cloned will use the status of the submodule’s remote-tracking branch to update the submodule, rather than the superproject’s recorded SHA-1. Equivalent to passing --remote to git submodule update"),
