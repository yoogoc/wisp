                    names: [
                        "--allow-unrelated-histories",
                    ],
                    description: Some("By default, git merge command refuses to merge histories that do not share a common ancestor. This option can be used to override this safety when merging histories of two projects that started their lives independently. As that is a very rare occasion, no configuration variable to enable this by default exists and will not be added"),
                ),
