                (
                    names: [
                        "--no-summary",
                    ],
                    description: Some("Synonym to --no-stat ; this is deprecated and will be removed in the future"),
                ),
                (
                    names: [
                        "-q",
                        "--quiet",
                    ],
                    description: Some("Operate quietly. Implies --no-progress"),
                ),
                (
                    names: [
                        "-v",
                        "--verbose",
                    ],
                    description: Some("Be verbose"),
                ),
                (
                    names: [
                        "--progress",
                    ],
                    description: Some("Turn progress on/off explicitly. If neither is specified, progress is shown if standard error is connected to a terminal. Note that not all merge strategies may support progress reporting"),
                ),
                (
                    names: [
                        "--no-progress",
                    ],
                    description: Some("Turn progress on/off explicitly. If neither is specified, progress is shown if standard error is connected to a terminal. Note that not all merge strategies may support progress reporting"),
                ),
                (
                    names: [
                        "--autostash",
                    ],
                    description: Some("Automatically create a temporary stash entry before the operation begins, and apply it after the operation ends. This means that you can run the operation on a dirty worktree. However, use with care: the final stash application after a successful merge might result in non-trivial conflicts"),
                ),
                (
                    names: [
                        "--no-autostash",
                    ],
                    description: Some("Do not automatically create a temporary stash entry before the operation begins, and apply it after the operation ends"),
                ),
