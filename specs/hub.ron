                            arguments: [
                                (
                                    name: "n",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--summary-limit",
                            ],
                            description: Some("Limit the summary size (number of commits shown in total). Giving 0 will disable the summary; a negative number means unlimited (the default). This limit only applies to modified submodules. The size is always limited to 1 for added/deleted/typechanged submodules"),
                            arguments: [
                                (
                                    name: "n",
                                ),
