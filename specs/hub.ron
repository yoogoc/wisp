                    description: Some("Create a merge commit in all cases, even when the merge could instead be resolved as a fast-forward"),
                ),
                (
                    names: [
                        "--ff-only",
                    ],
                    description: Some("Resolve the merge as a fast-forward when possible. When not possible, refuse to merge and exit with a non-zero status"),
                ),
                (
                    names: [
                        "-S",
