                            presentation: (
                                icon: Some("⚙️"),
                            ),
                        ),
                        (
                            name: "log.mailmap",
                            description: Some("If true, makes git-log[1], git-show[1], and git-whatchanged[1] assume `--use-mailmap`, otherwise assume `--no-use-mailmap`. True by default"),
                            presentation: (
                                icon: Some("⚙️"),
                            ),
                        ),
                        (
                            name: "log.showRoot",
                            description: Some("If true, the initial commit will be shown as a big creation event. This is equivalent to a diff against an empty tree. Tools like git-log[1] or git-whatchanged[1], which normally hide the root commit will now show it. True by default"),
                            presentation: (
                                icon: Some("⚙️"),
