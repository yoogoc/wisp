(
    version: 1,
    command: "tfsec",
    description: Some("Tfsec is a simple tool to detect potential security vulnerabilities in your terraformed infrastructure"),
    options: [
        (
            names: [
                "--concise-output",
            ],
            description: Some("Reduce the amount of output and no statistics"),
        ),
        (
            names: [
                "--config-file",
            ],
            description: Some("Config file to use during run"),
            arguments: [
                (
                    name: "config-file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--custom-check-dir",
            ],
            description: Some("Explicitly the custom checks dir location"),
            arguments: [
                (
                    name: "custom-check-dir",
                ),
            ],
        ),
        (
            names: [
                "--debug",
            ],
            description: Some("Enable debug logging (same as verbose)"),
        ),
        (
            names: [
                "-G",
                "--disable-grouping",
            ],
            description: Some("Disable grouping of similar results"),
        ),
        (
            names: [
                "-e",
                "--exclude",
            ],
            description: Some("Provide comma-separated list of rule IDs to exclude from run"),
            arguments: [
                (
                    name: "excludeList",
                ),
            ],
        ),
        (
            names: [
                "--exclude-downloaded-modules",
            ],
            description: Some("Remove results for downloaded modules in .terraform folder"),
        ),
        (
            names: [
                "--exclude-path",
            ],
            description: Some("Folder path to exclude, can be used multiple times and evaluated in order of specification"),
            arguments: [
                (
                    name: "excludePath",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--filter-results",
            ],
            description: Some("Filter results to return specific checks only (supports comma-delimited input)"),
            arguments: [
                (
                    name: "filterResults",
                ),
            ],
        ),
        (
            names: [
                "--force-all-dirs",
            ],
            description: Some("Don't search for tf files, include everything below provided directory"),
        ),
        (
            names: [
                "-f",
                "--format",
            ],
            description: Some("Select output format: default, json, csv, checkstyle, junit, sarif. To use multiple formats, separate with a comma and specify a base output filename with --out. A file will be written for each type. The first format will additionally be written stdout"),
            arguments: [
                (
                    name: "format",
                    suggestions: [
                        (
                            name: "default",
                        ),
                        (
                            name: "json",
                        ),
                        (
                            name: "csv",
                        ),
                        (
                            name: "checkstyle",
                        ),
                        (
                            name: "junit",
                        ),
                        (
                            name: "sarif",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Help for tfsec"),
        ),
        (
            names: [
                "--ignore-hcl-errors",
            ],
            description: Some("Stop and report an error if an HCL parse error is encountered"),
        ),
        (
            names: [
                "--include-ignored",
            ],
            description: Some("Include ignored checks in the result output"),
        ),
        (
            names: [
                "--include-passed",
            ],
            description: Some("Include passed checks in the result output"),
        ),
        (
            names: [
                "--migrate-ignores",
            ],
            description: Some("Migrate ignore codes to the new ID structure"),
        ),
        (
            names: [
                "-m",
                "--minimum-severity",
            ],
            description: Some("The minimum severity to report. One of CRITICAL, HIGH, MEDIUM, LOW"),
            arguments: [
                (
                    name: "minimumSeverity",
                    suggestions: [
                        (
                            name: "CRITICAL",
                        ),
                        (
                            name: "HIGH",
                        ),
                        (
                            name: "MEDIUM",
                        ),
                        (
                            name: "LOW",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--no-color",
            ],
            description: Some("Disable colored output (American style!)"),
        ),
        (
            names: [
                "--no-colour",
            ],
            description: Some("Disable coloured output"),
        ),
        (
            names: [
                "--no-ignores",
            ],
            description: Some("Do not apply any ignore rules - normally ignored checks will fail"),
        ),
        (
            names: [
                "--no-module-downloads",
            ],
            description: Some("Do not download remote modules"),
        ),
        (
            names: [
                "-O",
                "--out",
            ],
            description: Some("Set output file. This filename will have a format descriptor appended if multiple formats are specified with --format"),
            arguments: [
                (
                    name: "outputFile",
                    template: [
                        FilePaths,
                    ],
                    suggest_current_token: true,
                ),
            ],
        ),
        (
            names: [
                "--print-rego-input",
            ],
            description: Some("Print a JSON representation of the input supplied to rego policies"),
        ),
        (
            names: [
                "--rego-policy-dir",
            ],
            description: Some("Directory to load rego policies from (recursively)"),
            arguments: [
                (
                    name: "regoPolicyDir",
                ),
            ],
        ),
        (
            names: [
                "--run-statistics",
            ],
            description: Some("View statistics table of current findings"),
        ),
        (
            names: [
                "--single-thread",
            ],
            description: Some("Run checks using a single thread"),
        ),
        (
            names: [
                "-s",
                "--soft-fail",
            ],
            description: Some("Runs checks but suppresses error code"),
        ),
        (
            names: [
                "--tfvars-file",
            ],
            description: Some("Path to .tfvars file, can be used multiple times and evaluated in order of specification"),
            arguments: [
                (
                    name: "tfvarsFilePath",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--update",
            ],
            description: Some("Update to latest version"),
        ),
        (
            names: [
                "--verbose",
            ],
            description: Some("Enable verbose logging (same as debug)"),
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Show version information and exit"),
        ),
        (
            names: [
                "-W",
                "--workspace",
            ],
            description: Some("Specify a workspace for ignore limits (default \"default\")"),
            arguments: [
                (
                    name: "workspace",
                    generators: [
                        (
                            script: [
                                "terraform",
                                "workspace",
                                "list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "directory",
            template: [
                Folders,
            ],
        ),
    ],
)
