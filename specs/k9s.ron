(
    version: 1,
    command: "k9s",
    description: Some("K9s is a terminal based UI to interact with your Kubernetes clusters"),
    subcommands: [
        (
            name: "help",
            description: Some("Help about any command"),
            arguments: [
                (
                    name: "command",
                    template: [
                        Help,
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "info",
            description: Some("Print configuration info"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Help for info"),
                ),
            ],
        ),
        (
            name: "version",
            description: Some("Print version/build info"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Help for version"),
                ),
                (
                    names: [
                        "-s",
                        "--short",
                    ],
                    description: Some("Prints K9s version info in short format"),
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "-A",
                "--all-namespaces",
            ],
            description: Some("Launch K9s in all namespaces"),
        ),
        (
            names: [
                "--as",
            ],
            description: Some("Username to impersonate for the operation"),
            arguments: [
                (
                    name: "string",
                    description: Some("The username you want to impersonate"),
                ),
            ],
        ),
        (
            names: [
                "--as-group",
            ],
            description: Some("Group to impersonate for the operation"),
            arguments: [
                (
                    name: "stringArray",
                    description: Some("The group you want to impersonate"),
                ),
            ],
        ),
        (
            names: [
                "--certificate-authority",
            ],
            description: Some("Path to a cert file for the certificate authority"),
            arguments: [
                (
                    name: "string",
                    description: Some("The path to a cert file"),
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--client-key",
            ],
            description: Some("Path to a client key file for TLS"),
            arguments: [
                (
                    name: "string",
                    description: Some("The path to a client key file"),
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-c",
                "--command",
            ],
            description: Some("Overrides the default resource to load when the application launches"),
            arguments: [
                (
                    name: "string",
                    description: Some("The command you want to execute"),
                ),
            ],
        ),
        (
            names: [
                "--context",
            ],
            description: Some("The name of the kubeconfig context to use"),
            arguments: [
                (
                    name: "string",
                    description: Some("The name of the kubeconfig context"),
                ),
            ],
        ),
        (
            names: [
                "--crumbsless",
            ],
            description: Some("Turn K9s crumbs off"),
        ),
        (
            names: [
                "--headless",
            ],
            description: Some("Turn K9s header off"),
        ),
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Show help for k9s"),
        ),
        (
            names: [
                "--insecure-skip-tls-verify",
            ],
            description: Some("If true, the server's caCertFile will not be checked for validity"),
        ),
        (
            names: [
                "--kubeconfig",
            ],
            description: Some("Path to the kubeconfig file to use for CLI requests"),
            arguments: [
                (
                    name: "string",
                    description: Some("The path to the kubeconfig file"),
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--logFile",
            ],
            description: Some("Specify the log file"),
            arguments: [
                (
                    name: "string",
                    description: Some("The path of the log file"),
                    template: [
                        FilePaths,
                    ],
                    suggest_current_token: true,
                ),
            ],
        ),
        (
            names: [
                "-l",
                "--logLevel",
            ],
            description: Some("Specify a log level (info, warn, debug, trace, error) (default 'info')"),
            arguments: [
                (
                    name: "string",
                    description: Some("The log level"),
                    suggestions: [
                        (
                            name: "info",
                        ),
                        (
                            name: "warn",
                        ),
                        (
                            name: "debug",
                        ),
                        (
                            name: "trace",
                        ),
                        (
                            name: "error",
                        ),
                    ],
                    default: Some("info"),
                ),
            ],
        ),
        (
            names: [
                "--logoless",
            ],
            description: Some("Turn K9s logo off"),
        ),
        (
            names: [
                "-n",
                "--namespace",
            ],
            description: Some("If present, the namespace scope for this CLI request"),
            arguments: [
                (
                    name: "string",
                    description: Some("The namespace"),
                    generators: [
                        (
                            script: [
                                "kubectl",
                                "get",
                                "namespaces",
                            ],
                            pipeline: Lines((skip: 1, delimiter: Some(""), name: 0)),
                            has_post_process: true,
                        ),
                    ],
                    debounce: true,
                ),
            ],
        ),
        (
            names: [
                "--readonly",
            ],
            description: Some("Sets readOnly mode by overriding readOnly configuration setting"),
        ),
        (
            names: [
                "-r",
                "--refresh",
            ],
            description: Some("Specify the default refresh rate as an integer (sec) (default 2)"),
            arguments: [
                (
                    name: "int",
                    description: Some("The refresh rate (sec)"),
                    default: Some("2"),
                ),
            ],
        ),
        (
            names: [
                "--request-timeout",
            ],
            description: Some("The length of time to wait before giving up on a single server request"),
            arguments: [
                (
                    name: "string",
                    description: Some("The length of time to wait"),
                ),
            ],
        ),
        (
            names: [
                "--screen-dump-dir",
            ],
            description: Some("Sets a path to a dir for a screen dumps"),
            arguments: [
                (
                    name: "string",
                    description: Some("The path to a dir for a screen dumps"),
                ),
            ],
        ),
        (
            names: [
                "--token",
            ],
            description: Some("Bearer token for authentication to the API server"),
            arguments: [
                (
                    name: "string",
                    description: Some("The Bearer token"),
                ),
            ],
        ),
        (
            names: [
                "--user",
            ],
            description: Some("The name of the kubeconfig user to use"),
            arguments: [
                (
                    name: "string",
                    description: Some("The name of the kubeconfig user"),
                ),
            ],
        ),
        (
            names: [
                "--write",
            ],
            description: Some("Sets write mode by overriding the readOnly configuration setting"),
        ),
    ],
)
