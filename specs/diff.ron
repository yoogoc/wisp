(
    version: 1,
    command: "diff",
    description: Some("Compare files line by line"),
    options: [
        (
            names: [
                "-i",
                "--ignore-case",
            ],
            description: Some("Ignore case differences in file contents"),
        ),
        (
            names: [
                "--ignore-file-name-case",
            ],
            description: Some("Ignore case when comparing file names"),
            exclusive_on: [
                "--no-ignore-file-name-case",
            ],
        ),
        (
            names: [
                "--no-ignore-file-name-case",
            ],
            description: Some("Consider case when comparing file names"),
            exclusive_on: [
                "--ignore-file-name-case",
            ],
        ),
        (
            names: [
                "-E",
                "--ignore-tab-expansion",
            ],
            description: Some("Ignore changes due to tab expansion"),
        ),
        (
            names: [
                "-b",
                "--ignore-space-change",
            ],
            description: Some("Ignore changes in the amount of white space"),
        ),
        (
            names: [
                "-w",
                "--ignore-all-space",
            ],
            description: Some("Ignore all white space"),
        ),
        (
            names: [
                "-B",
                "--ignore-blank-lines",
            ],
            description: Some("Ignore changes whose lines are all blank"),
        ),
        (
            names: [
                "-I",
                "--ignore-matching-lines",
            ],
            description: Some("Ignore changes whose lines all match RE"),
            arguments: [
                (
                    name: "RE",
                ),
            ],
        ),
        (
            names: [
                "--strip-trailing-cr",
            ],
            description: Some("Strip trailing carriage return on input"),
        ),
        (
            names: [
                "-a",
                "--text",
            ],
            description: Some("Treat all files as text"),
        ),
        (
            names: [
                "-c",
                "-C",
                "--context",
            ],
            description: Some("Output NUM lines of copied context"),
            arguments: [
                (
                    name: "NUM",
                    default: Some("3"),
                ),
            ],
        ),
        (
            names: [
                "-u",
                "-U",
                "--unified",
            ],
            description: Some("Output NUM lines of unified context"),
            arguments: [
                (
                    name: "NUM",
                    default: Some("3"),
                ),
            ],
        ),
        (
            names: [
                "--label",
            ],
            description: Some("Use LABEL instead of file name"),
            arguments: [
                (
                    name: "LABEL",
                ),
            ],
        ),
        (
            names: [
                "-p",
                "--show-c-function",
            ],
            description: Some("Show which C function each change is in"),
        ),
        (
            names: [
                "-F",
                "--show-function-line",
            ],
            description: Some("Show the most recent line matching RE"),
            arguments: [
                (
                    name: "RE",
                ),
            ],
        ),
        (
            names: [
                "-q",
                "--brief",
            ],
            description: Some("Output only whether files differ"),
        ),
        (
            names: [
                "-e",
                "--ed",
            ],
            description: Some("Output an ed script"),
        ),
        (
            names: [
                "--normal",
            ],
            description: Some("Output a normal diff"),
        ),
        (
            names: [
                "-n",
                "--rcs",
            ],
            description: Some("Output an RCS format diff"),
        ),
        (
            names: [
                "-y",
                "--side-by-side",
            ],
            description: Some("Output in two columns"),
        ),
        (
            names: [
                "-W",
                "--width",
            ],
            description: Some("Output at most NUM (default 130) print columns"),
            arguments: [
                (
                    name: "NUM",
                ),
            ],
        ),
        (
            names: [
                "--left-column",
            ],
            description: Some("Output only the left column of common lines"),
        ),
        (
            names: [
                "--suppress-common-lines",
            ],
            description: Some("Do not output common lines"),
        ),
        (
            names: [
                "-D",
                "--ifdef",
            ],
            description: Some("Output merged file to show `#ifdef NAME' diffs"),
            arguments: [
                (
                    name: "NAME",
                ),
            ],
        ),
        (
            names: [
                "-l",
                "--paginate",
            ],
            description: Some("Pass the output through `pr' to paginate it"),
        ),
        (
            names: [
                "-t",
                "--expand-tabs",
            ],
            description: Some("Expand tabs to spaces in output"),
        ),
        (
            names: [
                "-T",
                "--initial-tab",
            ],
            description: Some("Make tabs line up by prepending a tab"),
        ),
        (
            names: [
                "-r",
                "--recursive",
            ],
            description: Some("Recursively compare any subdirectories found"),
        ),
        (
            names: [
                "-N",
                "--new-file",
            ],
            description: Some("Treat absent files as empty"),
        ),
        (
            names: [
                "--unidirectional-new-file",
            ],
            description: Some("Treat absent first files as empty"),
        ),
        (
            names: [
                "-s",
                "--report-identical-files",
            ],
            description: Some("Report when two files are the same"),
        ),
        (
            names: [
                "-x",
                "--exclude",
            ],
            description: Some("Exclude files that match PAT"),
            arguments: [
                (
                    name: "PAT",
                ),
            ],
        ),
        (
            names: [
                "-X",
                "--exclude-from",
            ],
            description: Some("Exclude files that match any pattern in FILE"),
            arguments: [
                (
                    name: "FILE",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-S",
                "--starting-file",
            ],
            description: Some("Start with FILE when comparing directories"),
            arguments: [
                (
                    name: "FILE",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--from-file",
            ],
            description: Some("Compare FILE1 to all operands. FILE1 can be a directory"),
            arguments: [
                (
                    name: "FILE1",
                    template: [
                        FilePaths,
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--to-file",
            ],
            description: Some("Compare all operands to FILE2. FILE2 can be a directory"),
            arguments: [
                (
                    name: "FILE2",
                    template: [
                        FilePaths,
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--horizon-lines",
            ],
            description: Some("Keep NUM lines of the common prefix and suffix"),
            arguments: [
                (
                    name: "NUM",
                ),
            ],
        ),
        (
            names: [
                "-d",
                "--minimal",
            ],
            description: Some("Try hard to find a smaller set of changes"),
        ),
        (
            names: [
                "--speed-large-files",
            ],
            description: Some("Assume large files and many scattered small changes"),
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Output version info"),
        ),
        (
            names: [
                "--help",
            ],
            description: Some("Show help"),
        ),
        (
            names: [
                "--old-group-format",
            ],
            description: Some("Similar, but format old input groups with GFTM"),
            arguments: [
                (
                    name: "GFTM",
                    description: Some("%<  lines from FILE1\n%>  lines from FILE2\n%=  lines common to FILE1 and FILE2\n%[-][WIDTH][.[PREC]]{doxX}LETTER  printf-style spec for LETTER\nLETTERs are as follows for new group, lower case for old group:\nF  first line number\nL  last line number\nN  number of lines = L-F+1\nE  F-1\nM  L+1\n%%  %\n%c'C'  the single character C\n%c'OOO'  the character with octal code OOO"),
                ),
            ],
        ),
        (
            names: [
                "--new-group-format",
            ],
            description: Some("Similar, but format new input groups with GFTM"),
            arguments: [
                (
                    name: "GFTM",
                    description: Some("%<  lines from FILE1\n%>  lines from FILE2\n%=  lines common to FILE1 and FILE2\n%[-][WIDTH][.[PREC]]{doxX}LETTER  printf-style spec for LETTER\nLETTERs are as follows for new group, lower case for old group:\nF  first line number\nL  last line number\nN  number of lines = L-F+1\nE  F-1\nM  L+1\n%%  %\n%c'C'  the single character C\n%c'OOO'  the character with octal code OOO"),
                ),
            ],
        ),
        (
            names: [
                "--unchanged-group-format",
            ],
            description: Some("Similar, but format unchanged input groups with GFTM"),
            arguments: [
                (
                    name: "GFTM",
                    description: Some("%<  lines from FILE1\n%>  lines from FILE2\n%=  lines common to FILE1 and FILE2\n%[-][WIDTH][.[PREC]]{doxX}LETTER  printf-style spec for LETTER\nLETTERs are as follows for new group, lower case for old group:\nF  first line number\nL  last line number\nN  number of lines = L-F+1\nE  F-1\nM  L+1\n%%  %\n%c'C'  the single character C\n%c'OOO'  the character with octal code OOO"),
                ),
            ],
        ),
        (
            names: [
                "--changed-group-format",
            ],
            description: Some("Similar, but format changed input groups with GFTM"),
            arguments: [
                (
                    name: "GFTM",
                    description: Some("%<  lines from FILE1\n%>  lines from FILE2\n%=  lines common to FILE1 and FILE2\n%[-][WIDTH][.[PREC]]{doxX}LETTER  printf-style spec for LETTER\nLETTERs are as follows for new group, lower case for old group:\nF  first line number\nL  last line number\nN  number of lines = L-F+1\nE  F-1\nM  L+1\n%%  %\n%c'C'  the single character C\n%c'OOO'  the character with octal code OOO"),
                ),
            ],
        ),
        (
            names: [
                "--line-format",
            ],
            description: Some("Format all input lines with LFMT"),
            arguments: [
                (
                    name: "LFTM",
                ),
            ],
        ),
        (
            names: [
                "--old-line-format",
            ],
            description: Some("Format old input lines with LFTM"),
            arguments: [
                (
                    name: "LFTM",
                    description: Some("%L  contents of line\n%l  contents of line, excluding any trailing newline\n%[-][WIDTH][.[PREC]]{doxX}n  printf-style spec for input line number\n%%  %\n%c'C'  the single character C\n%c'OOO'  the character with octal code OOO"),
                ),
            ],
        ),
        (
            names: [
                "--new-line-format",
            ],
            description: Some("Format new input lines with LFTM"),
            arguments: [
                (
                    name: "LFTM",
                    description: Some("%L  contents of line\n%l  contents of line, excluding any trailing newline\n%[-][WIDTH][.[PREC]]{doxX}n  printf-style spec for input line number\n%%  %\n%c'C'  the single character C\n%c'OOO'  the character with octal code OOO"),
                ),
            ],
        ),
        (
            names: [
                "--unchanged-line-format",
            ],
            description: Some("Format unchanged input lines with LFTM"),
            arguments: [
                (
                    name: "LFTM",
                    description: Some("%L  contents of line\n%l  contents of line, excluding any trailing newline\n%[-][WIDTH][.[PREC]]{doxX}n  printf-style spec for input line number\n%%  %\n%c'C'  the single character C\n%c'OOO'  the character with octal code OOO"),
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "file",
            template: [
                FilePaths,
            ],
            variadic: true,
        ),
    ],
)
