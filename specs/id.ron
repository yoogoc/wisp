(
    version: 1,
    command: "id",
    description: Some("The id utility displays the user and group names and numeric IDs, of the calling process, to the standard output.  If the real and effective IDs are different, both are displayed, otherwise only the real ID is displayed. If a user (login name or user ID) is specified, the user and group IDs of that user are displayed.  In this case, the real and effective IDs are assumed to be the same"),
    subcommands: [],
    options: [
        (
            names: [
                "-A",
            ],
            description: Some("Display the process audit user ID and other process audit properties, which requires privilege"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-F",
            ],
            description: Some("Display the full name of the user"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-G",
            ],
            description: Some("Display the different group IDs (effective, real and supplementary) as white-space separated numbers, in no particular order"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-M",
            ],
            description: Some("Display the MAC label of the current process"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-P",
            ],
            description: Some("Display the id as a password file entry"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-g",
            ],
            description: Some("Display the effective group ID as a number"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-n",
            ],
            description: Some("Display the name of the user or group ID for the -G, -g and -u options instead of the number.  If any of the ID numbers cannot be mapped into names the number will be displayed as usual"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-p",
            ],
            description: Some("Make the output human-readable"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-u",
            ],
            description: Some("Display the effective user ID as a number"),
            takes_value: false,
            arguments: [],
        ),
    ],
    arguments: [
        (
            name: "user",
            source: Unavailable,
            optional: true,
            variadic: false,
            imported_generator: Some((
                script: [
                    "bash",
                    "-c",
                    "dscl . -list /Users | grep -v \'^_\'",
                ],
                has_post_process: true,
                has_custom: false,
            )),
        ),
    ],
)