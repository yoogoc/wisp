(
    version: 1,
    command: "esbuild",
    description: Some("An extremely fast JavaScript bundler"),
    options: [
        (
            names: [
                "--bundle",
            ],
            description: Some("Bundle all dependencies into the output files"),
            presentation: (
                priority: Some(51.0),
                icon: Some("data:image/png;base64,"),
            ),
        ),
        (
            names: [
                "--define",
            ],
            description: Some("Replace variable names with a literal value, eg. --define:DEBUG=true"),
            arguments: [
                (
                    name: "name=value",
                ),
            ],
            requires_separator: Some(":"),
            presentation: (
                priority: Some(51.0),
                icon: Some("data:image/png;base64,"),
            ),
        ),
        (
            names: [
                "--external",
            ],
            description: Some("Exclude modules from the build"),
            arguments: [
                (
                    name: "module specifier",
                ),
            ],
            requires_separator: Some(":"),
            presentation: (
                priority: Some(51.0),
                icon: Some("data:image/png;base64,"),
            ),
        ),
        (
            names: [
                "--format",
            ],
            description: Some("The output format"),
            arguments: [
                (
                    name: "format",
