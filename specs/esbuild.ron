            ],
            requires_separator: Some(":"),
            presentation: (
                priority: Some(51.0),
                icon: Some("data:image/png;base64,"),
            ),
        ),
        (
            names: [
                "--minify",
            ],
            description: Some("Minify the output (sets all the --minify-* options)"),
