                    ],
                ),
            ],
            requires_separator: Some("="),
            presentation: (
                priority: Some(51.0),
                icon: Some("data:image/png;base64,"),
            ),
        ),
        (
            names: [
                "--outfile",
            ],
            description: Some("The output file for one entrypoint"),
