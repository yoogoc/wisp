                priority: Some(51.0),
                icon: Some("data:image/png;base64,"),
            ),
        ),
        (
            names: [
                "--outdir",
            ],
            description: Some("The output directory for multiple entrypoints"),
            arguments: [
                (
                    name: "path",
                    template: [
