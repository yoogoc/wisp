(
    version: 1,
    command: "ghq",
    description: Some("'ghq' provides a way to organize remote repository clones, like go get does. When you clone a remote repository by ghq get, ghq makes a directory under a specific root directory (by default ~/ghq) using the remote repository URL’s host and path"),
    subcommands: [
        (
            name: "get",
            description: Some("Clone/sync with a remote repository"),
            options: [
                (
                    names: [
                        "-u",
                        "--update",
                    ],
                    description: Some("Update local repository if cloned already (default: false)"),
                ),
                (
                    names: [
                        "-p",
                    ],
                    description: Some("Clone with SSH (default: false)"),
                ),
                (
                    names: [
                        "--shallow",
                    ],
                    description: Some("Do a shallow clone (default: false)"),
                ),
                (
                    names: [
                        "-l",
                        "--look",
                    ],
                    description: Some("Look after get (default: false)"),
                ),
                (
                    names: [
                        "--vcs",
                    ],
                    description: Some("Specify vcs backend for cloning"),
                    arguments: [
                        (
                            name: "vcs",
                        ),
                    ],
                ),
                (
                    names: [
                        "-s",
                        "--silent",
                    ],
                    description: Some("Clone or update silently (default: false)"),
                ),
                (
                    names: [
                        "--no-recursive",
                    ],
                    description: Some("Prevent recursive fetching (default: false)"),
                ),
                (
                    names: [
                        "-b",
                        "--branch",
                    ],
                    description: Some("Specify branch name. This flag implies --single-branch on Git"),
                    arguments: [
                        (
                            name: "branch",
                        ),
                    ],
                ),
                (
                    names: [
                        "-P",
                        "--parallel",
                    ],
                    description: Some("Import parallelly (default: false)"),
                ),
                (
                    names: [
                        "--bare",
                    ],
                    description: Some("Do a bare clone (default: false)"),
                ),
            ],
            arguments: [
                (
                    name: "<repository URL>|<project>|<user>/<project>|<host>/<user>/<project>",
                ),
            ],
        ),
        (
            name: "list",
            description: Some("List local repositories"),
            options: [
                (
                    names: [
                        "-e",
                        "--exact",
                    ],
                    description: Some("Perform an exact match (default: false)"),
                ),
                (
                    names: [
                        "--vcs",
                    ],
                    description: Some("Specify vcs backend for matching"),
                    arguments: [
                        (
                            name: "vcs",
                        ),
                    ],
                ),
                (
                    names: [
                        "-p",
                        "--full-path",
                    ],
                    description: Some("Print full paths (default: false)"),
                    exclusive_on: [
                        "--unique",
                    ],
                ),
                (
                    names: [
                        "--unique",
                    ],
                    description: Some("Print unique subpaths (default: false)"),
                    exclusive_on: [
                        "--full-path",
                    ],
                ),
            ],
            arguments: [
                (
                    name: "query",
                    optional: true,
                ),
            ],
        ),
        (
            name: "root",
            description: Some("Show repositories' root"),
            options: [
                (
                    names: [
                        "--all",
                    ],
                    description: Some("Show all roots (default: false)"),
                ),
            ],
        ),
        (
            name: "create",
            description: Some("Create a new repository"),
            options: [
                (
                    names: [
                        "--vcs",
                    ],
                    description: Some("Specify vcs backend explicitly"),
                    arguments: [
                        (
                            name: "vcs",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "<project>|<user>/<project>|<host>/<user>/<project>",
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "-h",
                "--help",
                "h",
                "help",
            ],
            description: Some("Show help"),
            persistent: true,
            exclusive_on: [
                "--version",
            ],
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Print the version"),
            exclusive_on: [
                "--help",
            ],
        ),
    ],
)
