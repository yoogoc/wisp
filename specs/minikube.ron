                (
                    names: [
                        "--namespace",
                    ],
                    description: Some("The named space to activate after start"),
                ),
                (
                    names: [
                        "--nat-nic-type",
                    ],
                    description: Some("NIC Type used for nat network"),
                ),
                (
                    names: [
                        "--native-ssh",
                    ],
                    description: Some("Use native Golang SSH client"),
                ),
                (
                    names: [
                        "--network",
                    ],
                    description: Some("Network to run minikube with"),
                ),
                (
                    names: [
                        "--network-plugin",
                    ],
                    description: Some("Kubelet network plug-in to use"),
                ),
                (
                    names: [
                        "--nfs-share",
                    ],
                    description: Some("Local folders to share with Guest via NFS mounts"),
