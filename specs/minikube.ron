                (
                    names: [
                        "--nfs-shares-root",
                    ],
                    description: Some("Where to root the NFS Shares"),
                ),
                (
                    names: [
                        "--no-kubernetes",
                    ],
                    description: Some("If set, minikube VM/container will start without starting or configuring Kubernetes"),
                ),
                (
                    names: [
                        "--no-vtx-check",
                    ],
                    description: Some("Disable checking for the availability of hardware virtualization before the vm is started"),
                ),
                (
                    names: [
                        "--nodes",
                        "-n",
                    ],
                    description: Some("The number of nodes to spin up"),
                ),
                (
                    names: [
                        "--output",
                        "-o",
                    ],
                    description: Some("Format to print stdout in"),
                    arguments: [
                        (
                            name: "format",
                            suggestions: [
                                (
                                    name: "json",
                                ),
                                (
                                    name: "text",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--ports",
                    ],
                    description: Some("List of ports that should be exposed"),
                ),
                (
                    names: [
                        "--preload",
                    ],
                    description: Some("If set, download tarball of preloaded images if available to improve start time"),
                    arguments: [
