                    names: [
                        "--listen-address",
                    ],
                    description: Some("IP Address to use to expose ports"),
                ),
                (
                    names: [
                        "--memory",
                    ],
                    description: Some("Amount of RAM to allocate to Kubernetes"),
                ),
                (
                    names: [
                        "--mount",
                    ],
                    description: Some("This will start the mount daemon and automatically mount files into minikube"),
                ),
                (
                    names: [
                        "--mount-string",
                    ],
                    description: Some("The argument to pass the minikube mount command on start"),
