(
    version: 1,
    command: "minikube",
    description: Some("Minikube provisions and manages local Kubernetes clusters optimized for development workflows"),
    subcommands: [
        (
            name: "start",
            description: Some("Starts a local Kubernetes cluster"),
            options: [
                (
                    names: [
                        "--addons",
                    ],
                    description: Some("Enable addons. see `minikube addons list` for a list of valid addon names"),
                ),
                (
                    names: [
                        "--apiserver-ips",
                    ],
                    description: Some("A set of apiserver IP Addresses which are used in the generated certificate for kubernetes"),
                ),
                (
                    names: [
                        "--apiserver-name",
                    ],
                    description: Some("The authoritative apiserver hostname for apiserver certificates and connectivity"),
                ),
                (
                    names: [
                        "--apiserver-names",
                    ],
                    description: Some("A set of apiserver names which are used in the generated certificate for kubernetes"),
                ),
                (
                    names: [
                        "--apiserver-port",
                    ],
                    description: Some("The apiserver listening port"),
                ),
                (
                    names: [
                        "--auto-update-drivers",
                    ],
                    description: Some("If set, automatically updates drivers to the latest version"),
                    arguments: [
                        (
                            name: "",
                            suggestions: [
                                (
                                    name: "true",
                                ),
                                (
                                    name: "false",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--base-image",
                    ],
                    description: Some("The base image to use for docker/podman drivers. Intended for local development"),
                ),
                (
                    names: [
                        "--cache-images",
                    ],
                    description: Some("If true, cache docker images for the current bootstrapper and load them into the machine"),
                ),
                (
                    names: [
                        "--cert-expiration",
                    ],
                    description: Some("Duration until minikube certificate expiration"),
                ),
                (
                    names: [
                        "--cni",
                    ],
                    description: Some("CNI plug-in to use"),
                    arguments: [
                        (
                            name: "cni-plugin",
                            suggestions: [
                                (
                                    name: "auto",
                                ),
                                (
                                    name: "bridge",
                                ),
                                (
                                    name: "cilium",
                                ),
                                (
                                    name: "flannel",
                                ),
                                (
                                    name: "kindnet",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--container-runtime",
                    ],
                    description: Some("The container runtime to be used"),
                    arguments: [
                        (
                            name: "container-runtime",
                            suggestions: [
                                (
                                    name: "docker",
                                ),
                                (
                                    name: "cri-o",
                                ),
                                (
                                    name: "containerd",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--cpus",
                    ],
                    description: Some("Number of CPUs allocated to Kubernetes"),
                    arguments: [
                        (
                            name: "cpu number",
                            suggestions: [
                                (
                                    name: "max",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--cri-socket",
                    ],
                    description: Some("The cri socket path to be used"),
                ),
                (
                    names: [
                        "--delete-on-failure",
                    ],
                    description: Some("If set, delete the current cluster if start fails and try again"),
                    arguments: [
                        (
                            name: "",
                            suggestions: [
                                (
                                    name: "true",
                                ),
                                (
                                    name: "false",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--disable-driver-mounts",
                    ],
                    description: Some("Disables the filesystem mounts provided by the hypervisors"),
                ),
                (
                    names: [
                        "--disk-size",
                    ],
                    description: Some("Disk size allocated to the minikube VM"),
                ),
                (
                    names: [
                        "--dns-domain",
                    ],
                    description: Some("The cluster dns domain name used in the Kubernetes cluster"),
                ),
                (
                    names: [
                        "--dns-proxy",
                    ],
                    description: Some("Enable proxy for NAT DNS requests"),
                ),
                (
                    names: [
                        "--docker-env",
                    ],
                    description: Some("Environment variables to pass to the Docker daemon. (format: key=value)"),
                ),
                (
                    names: [
                        "--docker-opt",
                    ],
                    description: Some("Specify arbitrary flags to pass to the Docker daemon. (format: key=value)"),
                ),
                (
                    names: [
                        "--download-only",
                    ],
                    description: Some("If true, only download and cache files for later use - don't install or start anything"),
                ),
                (
                    names: [
                        "--driver",
                    ],
                    description: Some("Choose driver"),
                    arguments: [
                        (
                            name: "driver",
                            suggestions: [
                                (
                                    name: "virtualbox",
                                ),
                                (
                                    name: "parallels",
                                ),
                                (
                                    name: "vmwarefusion",
                                ),
                                (
                                    name: "hyperkit",
                                ),
                                (
                                    name: "vmware",
                                ),
                                (
                                    name: "docker",
                                ),
                                (
                                    name: "podman",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--dry-run",
                    ],
                    description: Some("Dry-run mode. Validates configuration, but does not mutate system state"),
                ),
                (
                    names: [
                        "--embed-certs",
                    ],
                    description: Some("If true, will embed the certs in kubeconfig"),
                    arguments: [
                        (
                            name: "",
                            suggestions: [
                                (
                                    name: "true",
                                ),
                                (
                                    name: "false",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--extra-config",
                    ],
                    description: Some("A set of key=value pairs that describe configuration that may be passed to different components"),
                ),
                (
                    names: [
                        "--extra-disks",
                    ],
                    description: Some("Number of extra disks created and attached to the minikube VM"),
                ),
                (
                    names: [
                        "--feature-gates",
                    ],
                    description: Some("A set of key=value pairs that describe feature gates for alpha/experimental features"),
                ),
                (
                    names: [
                        "--force",
                    ],
                    description: Some("Force minikube to perform possibly dangerous operations"),
                ),
                (
                    names: [
                        "--force-systemd",
                    ],
                    description: Some("If set, force the container runtime to use systemd as cgroup manager"),
                    arguments: [
                        (
                            name: "",
                            suggestions: [
                                (
                                    name: "true",
                                ),
                                (
                                    name: "false",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--host-dns-resolver",
                    ],
                    description: Some("Enable host resolver for NAT DNS requests"),
                ),
                (
                    names: [
                        "--host-only-cidr",
                    ],
                    description: Some("The CIDR to be used for the minikube VM"),
                ),
                (
                    names: [
                        "--host-only-nic-type",
                    ],
                    description: Some("NIC Type used for host only network"),
                    arguments: [
                        (
                            name: "nic type",
                            suggestions: [
                                (
                                    name: "Am79C970A",
                                ),
                                (
                                    name: "Am79C973",
                                ),
                                (
                                    name: "82540EM",
                                ),
                                (
                                    name: "82543GC",
                                ),
                                (
                                    name: "82545EM",
                                ),
                                (
                                    name: "virtio",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--hyperkit-vpnkit-sock",
                    ],
                    description: Some("Location of the VPNKit socket used for networking"),
                ),
                (
                    names: [
                        "--hyperkit-vsock-ports",
                    ],
                    description: Some("List of guest VSock ports that should be exposed as sockets on the host"),
                ),
                (
                    names: [
                        "--hyperv-external-adapter",
                    ],
                    description: Some("External Adapter on which external switch will be created if no external switch is found"),
                ),
                (
                    names: [
                        "--hyperv-use-external-switch",
                    ],
                    description: Some("Whether to use external switch over Default Switch if virtual switch not explicitly specified"),
                ),
                (
                    names: [
                        "--hyperv-virtual-switch",
                    ],
                    description: Some("The hyperv virtual switch name. Defaults to first found"),
                ),
                (
                    names: [
                        "--image-mirror-country",
                    ],
                    description: Some("Country code of the image mirror to be used"),
                ),
                (
                    names: [
                        "--image-repository",
                    ],
                    description: Some("Alternative image repository to pull docker images from"),
                ),
                (
                    names: [
                        "--insecure-registry",
                    ],
                    description: Some("Insecure Docker registries to pass to the Docker daemon"),
                ),
                (
                    names: [
                        "--install-addons",
                    ],
                    description: Some("If set, install addons. Defaults to true"),
                    arguments: [
                        (
                            name: "",
                            suggestions: [
                                (
                                    name: "true",
                                ),
                                (
                                    name: "false",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--interactive",
                    ],
                    description: Some("Allow user prompts for more information"),
                ),
                (
                    names: [
                        "--iso-url",
                    ],
                    description: Some("Locations to fetch the minikube ISO from"),
                ),
                (
                    names: [
                        "--keep-context",
                    ],
                    description: Some("This will keep the existing kubectl context and will create a minikube context"),
                ),
                (
                    names: [
                        "--kubernetes-version",
                    ],
                    description: Some("The Kubernetes version that the minikube VM will use"),
                ),
                (
                    names: [
                        "--kvm-gpu",
                    ],
                    description: Some("Enable experimental NVIDIA GPU support in minikube"),
                ),
                (
                    names: [
                        "--kvm-hidden",
                    ],
                    description: Some("Hide the hypervisor signature from the guest in minikube"),
