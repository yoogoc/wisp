(
    version: 1,
    command: "rollup",
    description: Some("Next-generation ES module bundler"),
    options: [
        (
            names: [
                "-c",
                "--config",
            ],
            description: Some("Use this config file (if argument is used but value is unspecified, defaults to rollup.config.js)"),
            arguments: [
                (
                    name: "filename",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-d",
                "--dir",
            ],
            arguments: [
                (
                    name: "dirname",
                    description: Some("Directory for chunks (if absent, prints to stdout)"),
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-e",
                "--external",
            ],
            arguments: [
                (
                    name: "ids",
                    description: Some("Comma-separate list of module IDs to exclude"),
                ),
            ],
        ),
        (
            names: [
                "-f",
                "--format",
            ],
            arguments: [
                (
                    name: "format",
                    description: Some("Type of output (amd, cjs, es, iife, umd, system)"),
                    suggestions: [
                        (
                            name: "amd",
                        ),
                        (
                            name: "cjs",
                        ),
                        (
                            name: "es",
                        ),
                        (
                            name: "iife",
                        ),
                        (
                            name: "umd",
                        ),
                        (
                            name: "system",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-g",
                "--globals",
            ],
            arguments: [
                (
                    name: "pairs",
                    description: Some("Comma-separate list of `moduleID:Global` pairs"),
                ),
            ],
        ),
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Show help message"),
        ),
        (
            names: [
                "-i",
                "--input",
            ],
            arguments: [
                (
                    name: "filename",
                    description: Some("Input (alternative to <entry file>)"),
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-m",
                "--sourcemap",
            ],
            description: Some("Generate sourcemap (`-m inline` for inline map)"),
        ),
        (
            names: [
                "-n",
                "--name",
            ],
            arguments: [
                (
                    name: "name",
                    description: Some("Name for UMD export"),
                ),
            ],
        ),
        (
            names: [
                "-o",
                "--file",
            ],
            arguments: [
                (
                    name: "output",
                    description: Some("Single output file (if absent, prints to stdout)"),
                ),
            ],
        ),
        (
            names: [
                "-p",
                "--plugin",
            ],
            arguments: [
                (
                    name: "plugin",
                    description: Some("Use the plugin specified (may be repeated)"),
                ),
            ],
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Show version number"),
        ),
        (
            names: [
                "-w",
                "--watch",
            ],
            description: Some("Watch files in bundle and rebuild on changes"),
        ),
        (
            names: [
                "--amd.id",
            ],
            arguments: [
                (
                    name: "id",
                    description: Some("ID for AMD module (default is anonymous)"),
                ),
            ],
        ),
        (
            names: [
                "--amd.autoId",
            ],
            description: Some("Generate the AMD ID based off the chunk name"),
        ),
        (
            names: [
                "--amd.basePath",
            ],
            arguments: [
                (
                    name: "prefix",
                    description: Some("Path to prepend to auto generated AMD ID"),
                ),
            ],
        ),
        (
            names: [
                "--amd.define",
            ],
            arguments: [
                (
                    name: "name",
                    description: Some("Function to use in place of 'define'"),
                ),
            ],
        ),
        (
            names: [
                "--assetFileNames",
            ],
            arguments: [
                (
                    name: "pattern",
                    description: Some("Name pattern for emitted assets"),
                ),
            ],
        ),
        (
            names: [
                "--banner",
            ],
            arguments: [
                (
                    name: "text",
                    description: Some("Code to insert at top of bundle (outside wrapper)"),
                ),
            ],
        ),
        (
            names: [
                "--chunkFileNames",
            ],
            arguments: [
                (
                    name: "pattern",
                    description: Some("Name pattern for emitted secondary chunks"),
                ),
            ],
        ),
        (
            names: [
                "--compact",
            ],
            description: Some("Minify wrapper code"),
        ),
        (
            names: [
                "--context",
            ],
            arguments: [
                (
                    name: "variable",
                    description: Some("Specify top-level 'this' value"),
                ),
            ],
        ),
        (
            names: [
                "--entryFileNames",
            ],
            arguments: [
                (
                    name: "pattern",
                    description: Some("Name pattern for emitted entry chunks"),
                ),
            ],
        ),
        (
            names: [
                "--environment",
            ],
            arguments: [
                (
                    name: "values",
                    description: Some("Settings passed to config file"),
                ),
            ],
        ),
        (
            names: [
                "--no-esModule",
            ],
            description: Some("Do not add __esmodule property"),
        ),
        (
            names: [
                "--exports",
            ],
            arguments: [
                (
                    name: "mode",
                    description: Some("Specify export mode (auto, default, named, none)"),
                ),
            ],
        ),
        (
            names: [
                "--extend",
            ],
            description: Some("Extend global variable defined by --name"),
        ),
        (
            names: [
                "--no-externalLiveBindings",
            ],
            description: Some("Do not generate code to support live bindings"),
        ),
        (
            names: [
                "--failAfterWarnings",
            ],
            description: Some("Exit with an error if the build produced warnings"),
        ),
        (
            names: [
                "--footer",
            ],
            arguments: [
                (
                    name: "text",
                    description: Some("Code to insert at end of bundle (outside wrapper)"),
                ),
            ],
        ),
        (
            names: [
                "--no-freeze",
            ],
            description: Some("Do not freeze namespace objects"),
        ),
        (
            names: [
                "--no-hoistTransistiveImports",
            ],
            description: Some("Do not hoist transistive imports into entry chunks"),
        ),
        (
            names: [
                "--no-indent",
            ],
            description: Some("Don't indent result"),
        ),
        (
            names: [
                "--no-interop",
            ],
            description: Some("Do not include interop block"),
        ),
        (
            names: [
                "--inlineDynamicImports",
            ],
            description: Some("Create a single bundle when using dynamic imports"),
        ),
        (
            names: [
                "--intro",
            ],
            arguments: [
                (
                    name: "text",
                    description: Some("Code to insert at top of bundle (inside wrapper)"),
                ),
            ],
        ),
        (
            names: [
                "--minifyInternalImports",
            ],
            description: Some("Force or disable minification of internal imports"),
        ),
        (
            names: [
                "--namespaceToStringTag",
            ],
            description: Some("Create proper '.toString' methods for namespaces"),
        ),
        (
            names: [
                "--noConflict",
            ],
            description: Some("Generate a noConflict method for UMD globals"),
        ),
        (
            names: [
                "--outro",
            ],
            arguments: [
                (
                    name: "text",
                    description: Some("Code to insert at end of bundle (inside wrapper)"),
                ),
            ],
        ),
        (
            names: [
                "--preferConst",
            ],
            description: Some("Use 'const' instead of 'var' for exports"),
        ),
        (
            names: [
                "--no-preserveEntrySignatures",
            ],
            description: Some("Avoid facade chunks for entry points"),
        ),
        (
            names: [
                "--preserveModules",
            ],
            description: Some("Preserve module structure"),
        ),
        (
            names: [
                "--preserveModulesRoot",
            ],
            description: Some("Put preserved modules under this path at root level"),
        ),
        (
            names: [
                "--preserveSymlinks",
            ],
            description: Some("Do not follow symlinks when resolving files"),
        ),
        (
            names: [
                "--no-sanitizeFileName",
            ],
            description: Some("Do not replace invalid characters in file names"),
        ),
        (
            names: [
                "--shimMissingExports",
            ],
            description: Some("Create shim variables for missing exports"),
        ),
        (
            names: [
                "--silent",
            ],
            description: Some("Don't print warnings"),
        ),
        (
            names: [
                "--sourcemapExcludeSources",
            ],
            description: Some("Do not include source code in source maps"),
        ),
        (
            names: [
                "--sourcemapFile",
            ],
            description: Some("Specify bundle position for source maps"),
            arguments: [
                (
                    name: "file",
                ),
            ],
        ),
        (
            names: [
                "--stdin=ext",
            ],
            description: Some("Specify file extension used for stdin input"),
        ),
        (
            names: [
                "--no-stdin",
            ],
            description: Some("Do not read \"-\" from stdin"),
        ),
        (
            names: [
                "--no-strict",
            ],
            description: Some("Don't emit '\"use strict\"; in the generated modules"),
        ),
        (
            names: [
                "--strictDeprecations",
            ],
            description: Some("Throw errors for deprecated features"),
        ),
        (
            names: [
                "--systemNullSetters",
            ],
            description: Some("Replace empty SystemJS setters with 'null'"),
        ),
        (
            names: [
                "--no-treeshake",
            ],
            description: Some("Disable tree-shaking optimizations"),
        ),
        (
            names: [
                "--no-treeshake.annotations",
            ],
            description: Some("Ignore pure call annotations"),
        ),
        (
            names: [
                "--no-treeshake.moduleSideEffects",
            ],
            description: Some("Assume modules have no side effects"),
        ),
        (
            names: [
                "--no-treeshake.propertyReadSideEffects",
            ],
            description: Some("Ignore property access side-effects"),
        ),
        (
            names: [
                "--no-treeshake.tryCatchDeoptimization",
            ],
            description: Some("Do not turn off try-catch-tree-shaking"),
        ),
        (
            names: [
                "--no-treeshake.unknownGlobalSideEffects",
            ],
            description: Some("Assume unknown globals do not throw"),
        ),
        (
            names: [
                "--waitForBuildInput",
            ],
            description: Some("Wait for bundle input files"),
        ),
        (
            names: [
                "--watch.buildDelay",
            ],
            description: Some("Throttle watch rebuilds"),
            arguments: [
                (
                    name: "number",
                ),
            ],
        ),
        (
            names: [
                "--no-watch.clearScreen",
            ],
            description: Some("Do not clear the screen when rebuilding"),
        ),
        (
            names: [
                "--watch.skipWrite",
            ],
            description: Some("Do not write files to disk when watching"),
        ),
        (
            names: [
                "--watch.exclude",
            ],
            description: Some("Exclude files from being watched"),
            arguments: [
                (
                    name: "files",
                ),
            ],
        ),
        (
            names: [
                "--watch.include",
            ],
            description: Some("Limit watching to specified files"),
            arguments: [
                (
                    name: "files",
                ),
            ],
        ),
        (
            names: [
                "--validate",
            ],
            description: Some("Validate output"),
        ),
    ],
)
