(
    version: 1,
    command: "direnv",
    description: Some("Unclutter your .profile"),
    subcommands: [
        (
            name: "allow",
            description: Some("Grants direnv to load the given .envrc"),
            arguments: [
                (
                    name: "PATH_TO_RC",
                    generators: [
                        (
                            template: [
                                FilePaths,
                            ],
                            has_filter_template_suggestions: true,
                        ),
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                dangerous: true,
            ),
        ),
        (
            name: "deny",
            description: Some("Revokes the authorization of a given .envrc"),
            arguments: [
                (
                    name: "PATH_TO_RC",
                    generators: [
                        (
                            template: [
                                FilePaths,
                            ],
                            has_filter_template_suggestions: true,
                        ),
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                dangerous: true,
            ),
        ),
        (
            name: "edit",
            description: Some("Opens PATH_TO_RC or the current .envrc into an $EDITOR and allow the file to be loaded afterwards"),
            arguments: [
                (
                    name: "PATH_TO_RC",
                    generators: [
                        (
                            template: [
                                FilePaths,
                            ],
                            has_filter_template_suggestions: true,
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "exec",
            description: Some("Executes a command after loading the first .envrc found in DIR"),
            arguments: [
                (
                    name: "DIR",
                    template: [
                        Folders,
                    ],
                ),
                (
                    name: "COMMAND",
                    is_command: true,
                    dangerous: true,
                ),
            ],
        ),
        (
            name: "fetchurl",
            description: Some("Fetches a given URL into direnv's CAS"),
            arguments: [
                (
                    name: "url",
                ),
                (
                    name: "integrity-hash",
                    description: Some("Check if the `integrity hash` is equal to the hash value of the file obtained from the `url`"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "help",
            description: Some("Help for direnv"),
            arguments: [
                (
                    name: "SHOW_PRIVATE",
                    description: Some("Any string"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "hook",
            description: Some("Used to setup the shell hook"),
            arguments: [
                (
                    name: "SHELL",
                    suggestions: [
                        (
                            name: "bash",
                            presentation: (
                                icon: Some("🐚"),
                            ),
                        ),
                        (
