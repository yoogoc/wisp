                                icon: Some("🐚"),
                            ),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "prune",
            description: Some("Removes old allowed files"),
            presentation: (
                dangerous: true,
            ),
        ),
        (
            name: "reload",
            description: Some("Triggers an env reload"),
            presentation: (
                dangerous: true,
            ),
        ),
        (
            name: "status",
            description: Some("Prints some debug status information"),
        ),
        (
            name: "stdlib",
            description: Some("Displays the stdlib available in the .envrc execution context"),
        ),
        (
            name: "version",
            description: Some("Prints the version or checks that direnv is older than VERSION_AT_LEAST"),
            arguments: [
                (
                    name: "VERSION_AT_LEAST",
                    optional: true,
                ),
            ],
        ),
        (
            name: "apply_dump",
