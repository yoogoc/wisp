(
    version: 1,
    command: "gibo",
    description: Some("Easy access to gitignore boilerplates"),
    subcommands: [
        (
            name: "dump",
            description: Some("Dump one or more boilerplates to STDOUT"),
            arguments: [
                (
                    name: "boilerplate",
                    description: Some("Name of the boilerplate to dump"),
                    generators: [
                        (
                            script: [
                                "gibo",
                                "list",
                            ],
                            split_on: Some("\n"),
                        ),
                    ],
                    variadic: true,
                ),
            ],
        ),
        (
            name: "search",
            description: Some("Search for boilerplates"),
            arguments: [
                (
                    name: "search term",
                    description: Some("Name of the language or framework to search for"),
                ),
            ],
        ),
        (
            name: "root",
            description: Some("Show the directory where gibo stores its boilerplates"),
        ),
        (
            name: "help",
            description: Some("Show help information"),
        ),
        (
            name: "list",
            description: Some("Show the list of available boilerplates"),
        ),
        (
            name: "update",
            description: Some("Update the list of available boilerplates"),
        ),
        (
            name: "version",
            description: Some("Show the current version of gibo installed"),
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for gibo"),
        ),
    ],
)
