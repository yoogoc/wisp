(
    version: 1,
    command: "swagger-typescript-api",
    description: Some("Generate api via swagger scheme"),
    subcommands: [
        (
            name: "generate-templates",
            description: Some("Generate \".ejs\" templates needed for generate api"),
            options: [
                (
                    names: [
                        "--output",
                        "-o",
                    ],
                    description: Some("Output path of generated templates"),
                    arguments: [
                        (
                            name: "Path",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--modular",
                        "-m",
                    ],
                    description: Some("Generate templates needed to separate files for http client, data contracts, and routes"),
                ),
                (
                    names: [
                        "--http-client",
                    ],
                    description: Some("Http client type"),
                    arguments: [
                        (
                            name: "Http client",
                            suggestions: [
                                (
                                    name: "fetch",
                                ),
                                (
                                    name: "axios",
                                ),
                            ],
                            default: Some("fetch"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--clean-output",
                        "-c",
                    ],
                    description: Some("Clean output folder before generate template"),
                    presentation: (
                        dangerous: true,
                    ),
                ),
                (
                    names: [
                        "--rewrite",
                        "-r",
                    ],
                    description: Some("Rewrite content in existing templates"),
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--version",
                "-v",
            ],
            description: Some("Output the current version"),
        ),
        (
            names: [
                "--path",
                "-p",
            ],
            description: Some("Path/url to swagger scheme"),
            arguments: [
                (
                    name: "Path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--output",
                "-o",
            ],
            description: Some("Output path of typescript api file (default: \"./\")"),
            arguments: [
                (
                    name: "Path",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--name",
                "-n",
            ],
            description: Some("Name of output typescript api file (default: \"Api.ts\")"),
            arguments: [
                (
                    name: "Name",
                ),
            ],
        ),
        (
            names: [
                "--templates",
                "-t",
            ],
            description: Some("Path to folder containing templates"),
            arguments: [
                (
                    name: "Path",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--default-as-success",
                "-d",
            ],
            description: Some("Use \"default\" response status code as success response too"),
        ),
        (
            names: [
                "--responses",
                "-r",
            ],
            description: Some("Generate additional information about request responses"),
        ),
        (
            names: [
                "--union-enums",
            ],
            description: Some("Generate all \"enum\" types as union types (T1 | T2 | TN)"),
        ),
        (
            names: [
                "--add-readonly",
            ],
            description: Some("Generate readonly properties"),
        ),
        (
            names: [
                "--route-types",
            ],
            description: Some("Generate type definitions for API routes"),
        ),
        (
            names: [
                "--no-client",
            ],
            description: Some("Do not generate an API class"),
        ),
        (
            names: [
                "--enum-names-as-values",
            ],
            description: Some("Use values in 'x-enumNames' as enum values (not only as keys)"),
        ),
        (
            names: [
                "--extract-request-params",
            ],
            description: Some("Extract request params to data contract"),
        ),
        (
            names: [
                "--extract-request-body",
            ],
            description: Some("Extract request body type to data contract"),
        ),
        (
            names: [
                "--extract-response-body",
            ],
            description: Some("Extract response body type to data contract"),
        ),
        (
            names: [
                "--extract-response-error",
            ],
            description: Some("Extract response error type to data contract"),
        ),
        (
            names: [
                "--modular",
            ],
            description: Some("Generate separated files for http client, data contracts, and routes"),
        ),
        (
            names: [
                "--js",
            ],
            description: Some("Generate js api module with declaration file"),
        ),
        (
            names: [
                "--module-name-index",
            ],
            description: Some("Determines which path index should be used for routes separation"),
            arguments: [
                (
                    name: "Index",
                ),
            ],
        ),
        (
            names: [
                "--module-name-first-tag",
            ],
            description: Some("Splits routes based on the first tag"),
        ),
        (
            names: [
                "--disableStrictSSL",
            ],
            description: Some("Disabled strict SSL"),
        ),
        (
            names: [
                "--disableProxy",
            ],
            description: Some("Disabled proxy"),
        ),
        (
            names: [
                "--axios",
            ],
            description: Some("Generate axios http client"),
        ),
        (
            names: [
                "--unwrap-response-data",
            ],
            description: Some("Unwrap the data item from the response"),
        ),
        (
            names: [
                "--disable-throw-on-error",
            ],
            description: Some("Do not throw an error when response.ok is not true (default: false)"),
        ),
        (
            names: [
                "--single-http-client",
            ],
            description: Some("Ability to send HttpClient instance to Api constructor (default: false)"),
        ),
        (
            names: [
                "--silent",
            ],
            description: Some("Output only errors to console"),
            persistent: true,
        ),
        (
            names: [
                "--default-response",
            ],
            description: Some("Default type for empty response schema"),
            arguments: [
                (
                    name: "Type",
                ),
            ],
        ),
        (
            names: [
                "--type-prefix",
            ],
            description: Some("Data contract name prefix"),
            arguments: [
                (
                    name: "Prefix",
                ),
            ],
        ),
        (
            names: [
                "--type-suffix",
            ],
            description: Some("Data contract name suffix"),
            arguments: [
                (
                    name: "Suffix",
                ),
            ],
        ),
        (
            names: [
                "--clean-output",
            ],
            description: Some("Clean output folder before generate api. WARNING: May cause data loss (default: false)"),
        ),
        (
            names: [
                "--api-class-name",
            ],
            description: Some("Name of the api class"),
            arguments: [
                (
                    name: "Name",
                ),
            ],
        ),
        (
            names: [
                "--patch",
            ],
            description: Some("Fix up small errors in the swagger source definition (default: false)"),
        ),
        (
            names: [
                "--debug",
            ],
            description: Some("Additional information about processes inside this tool (default: false)"),
        ),
        (
            names: [
                "--another-array-type",
            ],
            description: Some("Generate array types as Array<Type> (by default Type[]) (default: false)"),
        ),
        (
            names: [
                "--sort-types",
            ],
            description: Some("Sort fields and types (default: false)"),
        ),
        (
            names: [
                "--extract-enums",
            ],
            description: Some("Extract all enums from inline interface\type content to typescript enum construction (default: false)"),
        ),
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for swagger-typescript-api"),
            persistent: true,
        ),
    ],
    presentation: (
        icon: Some("https://static1.smartbear.co/swagger/media/assets/swagger_fav.png"),
    ),
)
