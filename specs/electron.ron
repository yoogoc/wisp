(
    version: 1,
    command: "electron",
    description: Some("Build cross platform desktop apps with JavaScript, HTML and CSS"),
    subcommands: [],
    options: [
        (
            names: [
                "-i",
                "--interactive",
            ],
            description: Some("Open a REPL to the main process"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-r",
                "--require",
            ],
            description: Some("Module to preload"),
            takes_value: true,
            arguments: [
                (
                    name: "module",
                    source: Files,
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Print the version"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-a",
                "--abi",
            ],
            description: Some("Print the Node ABI version"),
            takes_value: false,
            arguments: [],
        ),
    ],
    arguments: [
        (
            name: "path",
            source: Directories,
            optional: false,
            variadic: false,
            imported_generator: None,
        ),
    ],
)