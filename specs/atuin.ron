(
    version: 1,
    command: "atuin",
    description: Some("Magical shell history"),
    subcommands: [
        (
            name: "history",
            description: Some("Manipulate shell history"),
            subcommands: [
                (
                    name: "start",
                    description: Some("Begins a new command in the history"),
                    arguments: [
                        (
                            name: "COMMAND",
                            variadic: true,
                        ),
                    ],
                ),
                (
                    name: "end",
                    description: Some("Finishes a new command in the history (adds time, exit code)"),
                    options: [
                        (
                            names: [
                                "--exit",
                                "-e",
                            ],
                            arguments: [
                                (
                                    name: "EXIT",
                                ),
                            ],
                        ),
                    ],
                    arguments: [
                        (
                            name: "ID",
                        ),
                    ],
                ),
                (
                    name: "list",
                    description: Some("List all items in history"),
                    options: [
                        (
                            names: [
                                "--cwd",
                                "-c",
                            ],
                        ),
                        (
                            names: [
                                "--session",
                                "-s",
                            ],
                        ),
                        (
                            names: [
                                "--human",
                            ],
                        ),
                        (
                            names: [
                                "--cmd-only",
                            ],
                            description: Some("Show only the text of the command"),
                        ),
                        (
                            names: [
                                "--format",
                                "-f",
                            ],
                            arguments: [
                                (
                                    name: "FORMAT",
                                    description: Some("Available variables: {command}, {directory}, {duration}, {user}, {host} and {time}. Example: --format \"{time} - [{duration}] - {directory}$\\t{command}\""),
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "last",
                    description: Some("Get the last command ran"),
                    options: [
                        (
                            names: [
                                "--human",
                            ],
                        ),
                        (
                            names: [
                                "--cmd-only",
                            ],
                            description: Some("Show only the text of the command"),
                        ),
                        (
                            names: [
                                "--format",
                                "-f",
                            ],
                            arguments: [
                                (
                                    name: "FORMAT",
                                    description: Some("Available variables: {command}, {directory}, {duration}, {user}, {host} and {time}. Example: --format \"{time} - [{duration}] - {directory}$\\t{command}\""),
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "import",
            description: Some("Import shell history from file"),
            subcommands: [
                (
                    name: "auto",
                    description: Some("Import history for the current shell"),
                ),
                (
                    name: "zsh",
                    description: Some("Import history from the zsh history file"),
                ),
                (
                    name: "zsh-hist-db",
                    description: Some("Import history from the zsh history file"),
                ),
                (
                    name: "bash",
                    description: Some("Import history from the bash history file"),
                ),
                (
                    name: "resh",
                    description: Some("Import history from the resh history file"),
                ),
                (
                    name: "fish",
                    description: Some("Import history from the fish history file"),
                ),
                (
                    name: "nu",
                    description: Some("Import history from the nu history file"),
                ),
                (
                    name: "nu-hist-db",
                    description: Some("Import history from the nu history file"),
                ),
            ],
        ),
        (
            name: "stats",
            description: Some("Calculate statistics for your history"),
            options: [
                (
                    names: [
                        "--count",
                        "-c",
                    ],
                    description: Some("How many top commands to list"),
                    arguments: [
                        (
                            name: "COUNT",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "PERIOD",
                    description: Some("Compute statistics for the specified period, leave blank for statistics since the beginning"),
                    variadic: true,
                ),
            ],
        ),
        (
            name: "search",
            description: Some("Interactive history search"),
            options: [
                (
                    names: [
                        "--cwd",
                        "-c",
                    ],
                    description: Some("Filter search result by directory"),
                    arguments: [
                        (
                            name: "CWD",
                        ),
                    ],
                ),
                (
                    names: [
                        "--exclude-cwd",
                    ],
                    description: Some("Exclude directory from results"),
                    arguments: [
                        (
                            name: "EXCLUDE_CWD",
                        ),
                    ],
                ),
                (
                    names: [
                        "--exit",
                        "-e",
                    ],
                    description: Some("Filter search result by exit code"),
                    arguments: [
                        (
                            name: "EXIT",
                        ),
                    ],
                ),
                (
                    names: [
                        "--exclude-exit",
                    ],
                    description: Some("Exclude results with this exit code"),
                    arguments: [
                        (
                            name: "EXCLUDE_EXIT",
                        ),
                    ],
                ),
                (
                    names: [
                        "--before",
                        "-b",
                    ],
                    description: Some("Only include results added before this date"),
                    arguments: [
                        (
                            name: "BEFORE",
                        ),
                    ],
                ),
                (
                    names: [
                        "--after",
                    ],
                    description: Some("Only include results after this date"),
                    arguments: [
                        (
                            name: "AFTER",
                        ),
                    ],
                ),
                (
                    names: [
                        "--limit",
                    ],
                    description: Some("How many entries to return at most"),
                    arguments: [
                        (
                            name: "LIMIT",
                        ),
                    ],
                ),
                (
                    names: [
                        "--offset",
                    ],
                    description: Some("Offset from the start of the results"),
                    arguments: [
                        (
                            name: "OFFSET",
                        ),
                    ],
                ),
                (
                    names: [
                        "--interactive",
                        "-i",
                    ],
                    description: Some("Open interactive search UI"),
                ),
                (
                    names: [
                        "--filter-mode",
                    ],
                    description: Some("Allow overriding filter mode over config"),
                    arguments: [
                        (
                            name: "FILTER_MODE",
                            suggestions: [
                                (
                                    name: "global",
                                ),
                                (
                                    name: "host",
                                ),
                                (
                                    name: "session",
                                ),
                                (
                                    name: "directory",
                                ),
                                (
                                    name: "workspace",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--search-mode",
                    ],
                    description: Some("Allow overriding search mode over config"),
                    arguments: [
                        (
                            name: "SEARCH_MODE",
                            suggestions: [
                                (
                                    name: "prefix",
                                ),
                                (
                                    name: "full-text",
                                ),
                                (
                                    name: "fuzzy",
                                ),
                                (
                                    name: "skim",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--human",
                    ],
                    description: Some("Use human-readable formatting for time"),
                ),
                (
                    names: [
                        "--cmd-only",
                    ],
                    description: Some("Show only the text of the command"),
                ),
                (
                    names: [
                        "--delete",
                    ],
                    description: Some("Delete anything matching this query. Will not print out the match"),
                ),
                (
                    names: [
                        "--delete-it-all",
                    ],
                    description: Some("Delete EVERYTHING!"),
                ),
                (
                    names: [
                        "--reverse",
                        "-r",
                    ],
                    description: Some("Reverse the order of results, oldest first"),
                ),
                (
                    names: [
                        "--format",
                        "-f",
                    ],
                    arguments: [
                        (
                            name: "FORMAT",
                            description: Some("Available variables: {command}, {directory}, {duration}, {user}, {host} and {time}. Example: --format \"{time} - [{duration}] - {directory}$\\t{command}\""),
                        ),
                    ],
                ),
                (
                    names: [
                        "--inline-height",
                    ],
                    description: Some("Set the maximum number of lines Atuin's interface should take up"),
                    arguments: [
                        (
                            name: "INLINE_HEIGHT",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "QUERY",
                    variadic: true,
                ),
            ],
        ),
        (
            name: "sync",
            description: Some("Sync with the configured server"),
            options: [
                (
                    names: [
                        "--force",
                        "-f",
                    ],
                    description: Some("Force re-download everything"),
                ),
            ],
        ),
        (
            name: "login",
            description: Some("Login to the configured server"),
            options: [
                (
                    names: [
                        "--username",
                        "-u",
                    ],
                    arguments: [
                        (
                            name: "USERNAME",
                        ),
                    ],
                ),
                (
                    names: [
                        "--password",
                        "-p",
                    ],
                    arguments: [
                        (
                            name: "PASSWORD",
                        ),
                    ],
                ),
                (
                    names: [
                        "--key",
                        "-k",
                    ],
                    description: Some("The encryption key for your account"),
                    arguments: [
                        (
                            name: "KEY",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "logout",
            description: Some("Log out"),
        ),
        (
            name: "register",
            description: Some("Register with the configured server"),
            options: [
                (
                    names: [
                        "--username",
                        "-u",
                    ],
                    arguments: [
                        (
                            name: "USERNAME",
                        ),
                    ],
                ),
                (
                    names: [
                        "--password",
                        "-p",
                    ],
                    arguments: [
                        (
                            name: "PASSWORD",
                        ),
                    ],
                ),
                (
                    names: [
                        "--email",
                        "-e",
                    ],
                    arguments: [
                        (
                            name: "EMAIL",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "key",
            description: Some("Print the encryption key for transfer to another machine"),
            options: [
                (
                    names: [
                        "--base64",
                    ],
                    description: Some("Switch to base64 output of the key"),
                ),
            ],
        ),
        (
            name: "status",
        ),
        (
            name: "account",
            subcommands: [
                (
                    name: "login",
                    description: Some("Login to the configured server"),
                    options: [
                        (
                            names: [
                                "--username",
                                "-u",
                            ],
                            arguments: [
                                (
                                    name: "USERNAME",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--password",
                                "-p",
                            ],
                            arguments: [
                                (
                                    name: "PASSWORD",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--key",
                                "-k",
                            ],
                            description: Some("The encryption key for your account"),
                            arguments: [
                                (
                                    name: "KEY",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "register",
                    options: [
                        (
                            names: [
                                "--username",
                                "-u",
                            ],
                            arguments: [
                                (
                                    name: "USERNAME",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--password",
                                "-p",
                            ],
                            arguments: [
                                (
                                    name: "PASSWORD",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--email",
                                "-e",
                            ],
                            arguments: [
                                (
                                    name: "EMAIL",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "logout",
                    description: Some("Log out"),
                ),
                (
                    name: "delete",
                ),
            ],
        ),
        (
            name: "kv",
            subcommands: [
                (
                    name: "set",
                    options: [
                        (
                            names: [
                                "--key",
                                "-k",
                            ],
                            arguments: [
                                (
                                    name: "KEY",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--namespace",
                                "-n",
                            ],
                            arguments: [
                                (
                                    name: "NAMESPACE",
                                ),
                            ],
                        ),
                    ],
                    arguments: [
                        (
                            name: "VALUE",
                        ),
                    ],
                ),
                (
                    name: "get",
                    options: [
                        (
                            names: [
                                "--namespace",
                                "-n",
                            ],
                            arguments: [
                                (
                                    name: "NAMESPACE",
                                ),
                            ],
                        ),
                    ],
                    arguments: [
                        (
                            name: "KEY",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "server",
            description: Some("Start an atuin server"),
            subcommands: [
                (
                    name: "start",
                    description: Some("Start the server"),
                    options: [
                        (
                            names: [
                                "--host",
                            ],
                            description: Some("The host address to bind"),
                            arguments: [
                                (
                                    name: "HOST",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--port",
                                "-p",
                            ],
                            description: Some("The port to bind"),
                            arguments: [
                                (
                                    name: "PORT",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "init",
            description: Some("Output shell setup"),
            options: [
                (
                    names: [
                        "--disable-ctrl-r",
                    ],
                    description: Some("Disable the binding of CTRL-R to atuin"),
                ),
                (
                    names: [
                        "--disable-up-arrow",
                    ],
                    description: Some("Disable the binding of the Up Arrow key to atuin"),
                ),
            ],
            arguments: [
                (
                    name: "SHELL",
                    suggestions: [
                        (
                            name: "zsh",
                        ),
                        (
                            name: "bash",
                        ),
                        (
                            name: "fish",
                        ),
                        (
                            name: "nu",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "uuid",
            description: Some("Generate a UUID"),
        ),
        (
            name: "contributors",
        ),
        (
            name: "gen-completions",
            description: Some("Generate shell completions"),
            options: [
                (
                    names: [
                        "--shell",
                        "-s",
                    ],
                    description: Some("Set the shell for generating completions"),
                    arguments: [
                        (
                            name: "SHELL",
                            suggestions: [
                                (
                                    name: "bash",
                                ),
                                (
                                    name: "elvish",
                                ),
                                (
                                    name: "fish",
                                ),
                                (
                                    name: "powershell",
                                ),
                                (
                                    name: "zsh",
                                ),
                            ],
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--out-dir",
                        "-o",
                    ],
                    description: Some("Set the output directory"),
                    arguments: [
                        (
                            name: "OUT_DIR",
                        ),
                    ],
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Print help"),
            persistent: true,
        ),
        (
            names: [
                "--version",
                "-V",
            ],
            description: Some("Print version"),
        ),
    ],
)
