(
    version: 1,
    command: "micro",
    description: Some("A modern and intuitive terminal-based text editor"),
    subcommands: [
        (
            name: "--plugin",
            description: Some("Manage plugins"),
            options: [
                (
                    names: [
                        "remove",
                    ],
                    description: Some("Remove plugin(s)"),
                    arguments: [
                        (
                            name: "plugin",
                            variadic: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "update",
                    ],
                    description: Some("Update plugin(s) (if no argument is given, updates all plugins)"),
                    arguments: [
                        (
                            name: "plugin",
                            variadic: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "search",
                    ],
                    description: Some("Search for a plugin"),
                    arguments: [
                        (
                            name: "plugin",
                        ),
                    ],
                ),
                (
                    names: [
                        "list",
                    ],
                    description: Some("List installed plugins"),
                ),
                (
                    names: [
                        "available",
                    ],
                    description: Some("List available plugins"),
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--clean",
            ],
            description: Some("Cleans the configuration directory"),
        ),
        (
            names: [
                "--config-dir",
            ],
            description: Some("Specify a custom location for the configuration directory"),
            arguments: [
                (
                    name: "dir",
                ),
            ],
        ),
        (
            names: [
                "--options",
            ],
            description: Some("Show all option help"),
        ),
        (
            names: [
                "--debug",
            ],
            description: Some("Enable debug mode"),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Show the version number and information"),
        ),
        (
            names: [
                "--autoindent",
            ],
            description: Some("When creating a new line, use the same indentation as the previous line"),
            arguments: [
                (
                    name: "bool",
                    description: Some("True/false"),
                    suggestions: [
                        (
                            name: "true",
                        ),
                        (
                            name: "false",
                        ),
                    ],
                    default: Some("true"),
                ),
            ],
        ),
        (
            names: [
                "--autosave",
            ],
            description: Some("Automatically save the buffer every <n> seconds. If set to 0, no autosaving is performed"),
            arguments: [
                (
                    name: "n",
                    description: Some("Seconds"),
                    suggestions: [
                        (
                            name: "0",
                        ),
                        (
                            name: "60",
                        ),
                        (
                            name: "120",
                        ),
                        (
                            name: "300",
                        ),
                        (
                            name: "600",
                        ),
                        (
                            name: "1800",
                        ),
                    ],
                    default: Some("0"),
                ),
            ],
        ),
        (
            names: [
                "--autosu",
            ],
