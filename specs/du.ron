(
    version: 1,
    command: "du",
    description: Some("Display disk usage statistics"),
    subcommands: [],
    options: [
        (
            names: [
                "-a",
            ],
            description: Some("Display an entry for each file in a file hierarchy"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-c",
            ],
            description: Some("Display a grand total"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-H",
            ],
            description: Some("Symbolic links on the command line are followed, symbolic links in file hierarchies are not followed"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-h",
            ],
            description: Some("\"Human-readable\" output.  Use unit suffixes: Byte, Kilobyte, Megabyte, Gigabyte, Terabyte and Petabyte"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-g",
            ],
            description: Some("Display block counts in 1073741824-byte (1-Gbyte) blocks"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-k",
            ],
            description: Some("Display block counts in 1024-byte (1-Kbyte) blocks"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-m",
            ],
            description: Some("Display block counts in 1048576-byte (1-Mbyte) blocks"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-I",
            ],
            description: Some("Ignore files and directories matching the specified mask"),
            takes_value: true,
            arguments: [
                (
                    name: "mask",
                    source: Files,
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "-L",
            ],
            description: Some("Symbolic links on the command line and in file hierarchies are followed"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-r",
            ],
            description: Some("Generate messages about directories that cannot be read, files that cannot be opened, and so on.  This is the default case.  This option exists solely for conformance with X/Open Portability Guide Issue 4 (``XPG4\'\')"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-P",
            ],
            description: Some("No symbolic links are followed.  This is the default"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-d",
            ],
            description: Some("Display an entry for all files and directories depth directories deep"),
            takes_value: true,
            arguments: [
                (
                    name: "depth",
                    source: Static([
                        "0",
                        "1",
                        "2",
                    ]),
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "-s",
            ],
            description: Some("Display an entry for each specified file.  (Equivalent to -d 0)"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-x",
            ],
            description: Some("Display an entry for each specified file.  (Equivalent to -d 0)"),
            takes_value: false,
            arguments: [],
        ),
    ],
    arguments: [
        (
            name: "files",
            source: Directories,
            optional: true,
            variadic: true,
            imported_generator: None,
        ),
    ],
)