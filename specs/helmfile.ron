(
    version: 1,
    command: "helmfile",
    description: Some("Deploy helm charts"),
    subcommands: [
        (
            name: "apply",
            description: Some("Apply all resources from state file only when there are changes"),
        ),
        (
            name: "build",
            description: Some("Build all resources from state file"),
        ),
        (
            name: "cache",
            description: Some("Cache management"),
        ),
        (
            name: "charts",
            description: Some("DEPRECATED: sync releases from state file (helm upgrade --install)"),
        ),
        (
            name: "completion",
            description: Some("Generate the autocompletion script for the specified shell"),
        ),
        (
            name: "delete",
            description: Some("The helmfile delete sub-command deletes all the releases defined in the manifests"),
        ),
        (
            name: "deps",
            description: Some("Update charts based on their requirements, it locks your helmfile state and local charts dependencies"),
        ),
        (
            name: "destroy",
            description: Some("Destroys and then purges releases"),
        ),
        (
            name: "diff",
            description: Some("Diff releases defined in state file, it executes the helm-diff plugin across all of the charts/releases defined in the manifest"),
        ),
        (
            name: "fetch",
            description: Some("Fetch charts from state file, it downloads or copies local charts to a local directory for debug purpose"),
        ),
        (
            name: "help",
            description: Some("Help about any command"),
        ),
        (
            name: "init",
            description: Some("Initialize the helmfile, includes version checking and installation of helm and plug-ins"),
        ),
        (
            name: "lint",
            description: Some("Lint charts from state file (helm lint)"),
        ),
        (
            name: "list",
            description: Some("List releases defined in state file"),
        ),
        (
            name: "repos",
            description: Some("Repos releases defined in state file"),
        ),
        (
            name: "secrets",
            description: Some("Causes the helm-secrets plugin to be executed to decrypt the file"),
        ),
        (
            name: "status",
            description: Some("Retrieve status of releases in state file"),
        ),
        (
            name: "sync",
            description: Some("Sync releases defined in state file"),
        ),
        (
            name: "template",
            description: Some("Template releases defined in state file"),
        ),
        (
            name: "test",
            description: Some("Test charts from state file (helm test)"),
        ),
        (
            name: "version",
            description: Some("Print the CLI version"),
        ),
        (
            name: " write-values",
            description: Some("Write values files for releases. Similar to `helmfile template`, write values files instead of manifests"),
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Do not exit with an error code if the provided selector has no matching releases"),
            persistent: true,
        ),
        (
            names: [
                "--allow-no-matching-release",
            ],
            description: Some("Show help for helmfile"),
            persistent: true,
        ),
        (
            names: [
                "--chart",
                "-c",
            ],
            description: Some("Set chart. Uses the chart set in release by default, and is available in template as {{ .Chart }}"),
            arguments: [
                (
                    name: "string",
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--color",
            ],
            description: Some("Output with color"),
            persistent: true,
        ),
        (
            names: [
                "--debug",
            ],
            description: Some("Enable verbose output for Helm and set log-level to debug, this disables --quiet/-q effect"),
            persistent: true,
        ),
        (
            names: [
                "--enable-live-output",
            ],
            description: Some("Show live output from the Helm binary Stdout/Stderr into Helmfile own Stdout/Stderr. It only applies for the Helm CLI commands, Stdout/Stderr for Hooks are still displayed only when it's execution finishes"),
            persistent: true,
        ),
        (
            names: [
                "--environment",
                "-e",
            ],
            description: Some("Specify the environment name. defaults to default"),
            arguments: [
                (
                    name: "environment",
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--file",
                "-f",
            ],
            description: Some("Load config from file or directory. defaults to helmfile.yaml or `helmfile.d`(means `helmfile.d/*.yaml`) in this preference"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--helm-binary",
                "-b",
            ],
            description: Some("Path to the helm binary (default \"helm\")"),
            arguments: [
                (
                    name: "binary",
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--interactive",
                "-i",
            ],
            description: Some("Request confirmation before attempting to modify clusters"),
            persistent: true,
        ),
        (
            names: [
                "--kube-context",
            ],
            description: Some("Set kubectl context. Uses current context by default"),
            arguments: [
                (
                    name: "kube-context",
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--log-level",
            ],
            description: Some("Set log level, default info (default info)"),
            arguments: [
                (
                    name: "log-level",
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--namespace",
                "-n",
            ],
            description: Some("Set namespace. Uses the namespace set in the context by default, and is available in templates as {{ .Namespace }}"),
            arguments: [
                (
                    name: "namespace",
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--no-color",
            ],
            description: Some("Output without color"),
            persistent: true,
        ),
        (
            names: [
                "--quiet",
                "-q",
            ],
            description: Some("Silence output. Equivalent to log-level warn"),
            persistent: true,
        ),
        (
            names: [
                "--selector",
                "-l",
            ],
            description: Some("Only run using the releases that match labels. Labels can take the form of foo=bar or foo!=bar"),
            arguments: [
                (
                    name: " selector ",
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--state-values-file",
            ],
            description: Some("Specify state values in a YAML file"),
            arguments: [
                (
                    name: "state-values-file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--state-values-set",
            ],
            description: Some("Set state values on the command line (can specify multiple or separate values with commas: key1=val1,key2=val2)"),
            arguments: [
                (
                    name: "state-values-=set",
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--version",
                "-v",
            ],
            description: Some("Version for helmfile"),
            persistent: true,
        ),
    ],
)
