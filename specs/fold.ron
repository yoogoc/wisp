(
    version: 1,
    command: "fold",
    description: Some("Fold long lines for finite width output device"),
    options: [
        (
            names: [
                "-b",
            ],
            description: Some("Count width in bytes rather than column positions"),
        ),
        (
            names: [
                "-s",
            ],
            description: Some("Fold line after the last blank character within the first width\ncolumn positions (or bytes)"),
        ),
        (
            names: [
                "-w",
            ],
            description: Some("Specify a line width to use instead of the default 80 columns.\nThe width value should be a multiple of 8 if tabs are present,\nor the tabs should be expanded using expand(1) before using\nfold"),
            arguments: [
                (
                    name: "width",
                    suggestions: [
                        (
                            name: "80",
                        ),
                        (
                            name: "90",
                        ),
                        (
                            name: "100",
                        ),
                        (
                            name: "110",
                        ),
                        (
                            name: "120",
                        ),
                    ],
                    default: Some("80"),
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "file",
            description: Some("File(s) to fold"),
            template: [
                FilePaths,
            ],
            optional: true,
            variadic: true,
        ),
    ],
    parser_directives: Some((
        options_must_precede_arguments: true,
    )),
)
