(
    version: 1,
    command: "xcrun",
    description: Some("Find and execute the named command line tool from the active xCode developer directory"),
    subcommands: [
        (
            name: "scntool",
            description: Some("SceneKit CLI utilities"),
            options: [
                (
                    names: [
                        "--convert",
                    ],
                    description: Some("File to convert"),
                    arguments: [
                        (
                            name: "file",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--format",
                    ],
                    description: Some("Format to convert to"),
                    arguments: [
                        (
                            name: "format",
                            suggestions: [
                                (
                                    name: "scn",
                                ),
                                (
                                    name: "dae",
                                ),
                                (
                                    name: "c3d",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--output",
                    ],
                    description: Some("Path to the output file"),
                    arguments: [
                        (
                            name: "file",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--force-y-up",
                    ],
                    description: Some("Convert objects to use y axis up"),
                ),
                (
                    names: [
                        "--force-interleaved",
                    ],
                    description: Some("Interleave the vertex data for multiple semantics in the same array to achieve better rendering performance"),
                ),
                (
                    names: [
                        "--prefer-compressed-textures",
                    ],
                    description: Some("Use .ktx, .astc and .pvrtc files for textures if available in the asset catalog"),
                ),
                (
                    names: [
                        "--verbose",
                    ],
                    description: Some("Get pretty error message"),
                ),
            ],
        ),
        (
            name: "xcodebuild",
            load_spec: Some("xcodebuild"),
        ),
        (
            name: "simctl",
            load_spec: Some("simctl"),
        ),
    ],
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Help message"),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Show the xcrun version"),
        ),
        (
            names: [
                "-v",
                "--verbose",
            ],
            description: Some("Show verbose logging output"),
        ),
        (
            names: [
                "--sdk",
            ],
            description: Some("Find the tool for the given SDK name"),
            arguments: [
                (
                    name: "sdk name",
                ),
            ],
        ),
        (
            names: [
                "--toolchain",
            ],
            description: Some("Find the tool for the given toolchain"),
            arguments: [
                (
                    name: "name",
                ),
            ],
        ),
        (
            names: [
                "-l",
                "--log",
            ],
            description: Some("Show command path to be executed (and --run)"),
        ),
        (
            names: [
                "-f",
                "--find",
            ],
            description: Some("Find and print the tool path"),
        ),
        (
            names: [
                "--run",
            ],
            description: Some("(Default) find and execute the tool"),
        ),
        (
            names: [
                "-n",
                "--no-cache",
            ],
            description: Some("Do not use the lookup cache"),
        ),
        (
            names: [
                "-k",
                "--kill-cache",
            ],
            description: Some("Invalidate all existing cache entries"),
            presentation: (
                dangerous: true,
            ),
        ),
        (
            names: [
                "--show-sdk-path",
            ],
            description: Some("Show selected SDK install path"),
        ),
        (
            names: [
                "--show-sdk-version",
            ],
            description: Some("Show selected SDK version"),
        ),
        (
            names: [
                "--show-sdk-build-version",
            ],
            description: Some("Show selected SDK build version"),
        ),
        (
            names: [
                "--show-sdk-platform-path",
            ],
            description: Some("Show selected SDK platform path"),
        ),
        (
            names: [
                "--show-sdk-platform-version",
            ],
            description: Some("Show selected SDK platform version"),
        ),
    ],
)
