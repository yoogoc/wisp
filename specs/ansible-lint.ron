(
    version: 1,
    command: "ansible-lint",
    description: Some("Ansible static code analysis"),
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for ansible-lint"),
        ),
        (
            names: [
                "--list-rules",
                "-L",
            ],
            description: Some("List all the rules"),
            exclusive_on: [
                "-T",
            ],
        ),
        (
            names: [
                "--list-tags",
                "-T",
            ],
            description: Some("List all the tags and the rules they cover"),
            exclusive_on: [
                "-L",
            ],
        ),
        (
            names: [
                "--format",
                "-f",
            ],
            description: Some("Stdout formatting"),
            arguments: [
                (
                    name: "-f",
                    suggestions: [
                        (
                            name: "rich",
                        ),
                        (
                            name: "plain",
                        ),
                        (
                            name: "md",
                        ),
                        (
                            name: "json",
                        ),
                        (
                            name: "codeclimate",
                        ),
                        (
                            name: "quiet",
                        ),
                        (
                            name: "pep8",
                        ),
                        (
                            name: "sarif",
                        ),
                    ],
                    default: Some("rich"),
                ),
            ],
            presentation: (
                icon: Some("fig://icon?type=characters"),
                display_name: Some("Format"),
            ),
        ),
        (
            names: [
                "-q",
            ],
            description: Some("Quieter, reduce verbosity, can be specified twice"),
            repeat: Times(2),
        ),
        (
            names: [
                "-p",
            ],
            description: Some("Parseable output, same as '-f pep8'"),
        ),
        (
            names: [
                "--progressive",
            ],
            description: Some("Return success if it detects a reduction in number of violations compared with previous git commit. This feature works only in git repositories"),
        ),
        (
            names: [
                "--project-dir",
            ],
            description: Some("Location of project/repository, autodetected based on location of configuration file"),
            arguments: [
                (
                    name: "PROJECT_DIR",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--rules-dir",
                "-r",
            ],
            description: Some("Specify custom rule directories"),
            arguments: [
                (
                    name: "RULESDIR",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-R",
            ],
            description: Some("Keep using embedded rules when using '-r'"),
        ),
        (
            names: [
                "--write",
            ],
            description: Some("Allow ansible-lint to reformat YAML files and run rule transforms"),
            arguments: [
                (
                    name: "WRITE_LIST",
                    description: Some("Limit the effective rule transforms by passing a keywords 'all' or 'none' or a comma separated list of rule ids or rule tags"),
                    suggestions: [
                        (
                            name: "all",
                        ),
                        (
                            name: "none",
                        ),
                        (
                            name: "rule1,rule2,...",
                        ),
                    ],
                    default: Some("all"),
                ),
            ],
        ),
        (
            names: [
                "--show-relpath",
            ],
            description: Some("Display path relative to CWD"),
        ),
        (
            names: [
                "--tags",
                "-t",
            ],
            description: Some("Only check rules whose id/tags match these values"),
        ),
        (
            names: [
                "-v",
            ],
            description: Some("Increase verbosity level (-vv for more)"),
            repeat: Times(2),
        ),
        (
            names: [
                "--skip-list",
                "-x",
            ],
            description: Some("Only check rules whose id/tags do not match these values"),
            arguments: [
                (
                    name: "SKIP_LIST",
                ),
            ],
        ),
        (
            names: [
                "--warn-list",
                "-w",
            ],
            description: Some("Only warn about these rules, unless overridden in config file defaults to 'experimental'"),
            arguments: [
                (
                    name: "WARN_LIST",
                ),
            ],
        ),
        (
            names: [
                "--enable-list",
            ],
            description: Some("Activate optional rules by their tag name"),
            arguments: [
                (
                    name: "ENABLE_LIST",
                ),
            ],
        ),
        (
            names: [
                "--nocolor",
            ],
            description: Some("Disable colored output, same as NO_COLOR=1"),
        ),
        (
            names: [
                "--force-color",
            ],
            description: Some("Force colored output, same as FORCE_COLOR=1"),
        ),
        (
            names: [
                "--exclude-paths",
            ],
            description: Some("Path to directories or files to skip. This option is repeatable"),
            arguments: [
                (
                    name: "EXCLUDE_PATHS",
                    template: [
                        Folders,
                    ],
                    variadic: true,
                ),
            ],
        ),
        (
            names: [
                "--config-file",
            ],
            description: Some("Specify configuration file to use. By default it will look for '.ansible-lint' or '.config/ansible-lint.yml'"),
            arguments: [
                (
                    name: "CONFIG_FILE",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--offline",
            ],
            description: Some("Disable installation of requirements.yml"),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Show version of ansible-lint"),
        ),
    ],
    arguments: [
        (
            name: "lintables",
            description: Some("Files to lint"),
            template: [
                FilePaths,
            ],
            optional: true,
            variadic: true,
        ),
    ],
)
