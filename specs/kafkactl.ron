(
    version: 1,
    command: "kafkactl",
    description: Some("Command-line interface for Apache Kafka"),
    subcommands: [
        (
            name: "edit",
            aliases: [
                "alter",
            ],
            description: Some("Alter topics, partitions"),
            subcommands: [
                (
                    name: "partition",
                    description: Some("Alter a partition"),
                    options: [
                        (
                            names: [
                                "--replicas",
                                "-r",
                            ],
                            description: Some("Set replicas for a partition"),
                            arguments: [
                                (
                                    name: "replicas",
                                ),
                            ],
                            repeat: Many,
                        ),
                        (
                            names: [
                                "--validate-only",
                                "-v",
                            ],
                            description: Some("Validate only"),
                        ),
                    ],
                ),
                (
                    name: "topic",
                    description: Some("Alter a topic"),
                    options: [
                        (
                            names: [
                                "--config",
                                "-c",
                            ],
                            description: Some("Configs in format `key=value`"),
                            arguments: [
                                (
                                    name: "config",
                                ),
                            ],
                            repeat: Many,
                        ),
                        (
                            names: [
                                "--partitions",
                                "-p",
                            ],
                            description: Some("Number of partitions"),
                            arguments: [
                                (
                                    name: "partitions",
                                    default: Some("0"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--replication-factor",
                                "-r",
                            ],
                            description: Some("Replication factor"),
                            arguments: [
                                (
                                    name: "replication-factor",
                                    default: Some("0"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--validate-only",
                                "-v",
                            ],
                            description: Some("Validate only"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "attach",
            description: Some("Run kafkactl pod in kubernetes and attach to it"),
        ),
        (
            name: "clone",
            description: Some("Clone topics, consumerGroups"),
            subcommands: [
                (
                    name: "cg",
                    aliases: [
                        "consumer-group",
                    ],
                    description: Some("Clone existing consumerGroup with all offsets"),
                ),
                (
                    name: "topic",
                    description: Some("Clone existing topic (number of partitions, replication factor, config entries) to new one"),
                ),
            ],
        ),
        (
            name: "completion",
            description: Some("Generate shell auto-completion file"),
        ),
        (
            name: "config",
            description: Some("Show and edit configurations"),
            subcommands: [
                (
                    name: "currentContext",
                    aliases: [
                        "current-context",
                    ],
                    description: Some("Show current context"),
                ),
                (
                    name: "getContexts",
                    aliases: [
                        "get-contexts",
                    ],
                    description: Some("List configured contexts"),
                    options: [
                        (
                            names: [
                                "--output",
                                "-o",
                            ],
                            description: Some("Output format. One of: compact"),
                            arguments: [
                                (
                                    name: "output",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "useContext",
                    aliases: [
                        "use-context",
                    ],
                    description: Some("Switch active context"),
                ),
                (
                    name: "view",
                    description: Some("Show contents of config file"),
                ),
            ],
        ),
        (
            name: "consume",
            description: Some("Consume messages from a topic"),
            options: [
                (
                    names: [
                        "--exit",
                        "-e",
                    ],
                    description: Some("Stop consuming when latest offset is reached"),
                ),
                (
                    names: [
                        "--from-beginning",
                        "-b",
                    ],
                    description: Some("Set offset for consumer to the oldest offset"),
                ),
                (
                    names: [
                        "--group",
                        "-g",
                    ],
                    description: Some("Consumer group to join"),
                    arguments: [
                        (
                            name: "group",
                        ),
                    ],
                ),
                (
                    names: [
                        "--key-encoding",
                    ],
                    description: Some("Key encoding (auto-detected by default). One of: none|hex|base64"),
                    arguments: [
                        (
                            name: "key-encoding",
                        ),
                    ],
                ),
                (
                    names: [
                        "--key-proto-type",
                    ],
                    description: Some("Key protobuf message type"),
                    arguments: [
                        (
                            name: "key-proto-type",
                        ),
                    ],
                ),
                (
                    names: [
                        "--max-messages",
                    ],
                    description: Some("Stop consuming after n messages have been read"),
                    arguments: [
                        (
                            name: "max-messages",
                            default: Some("-1"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--offset",
                    ],
                    description: Some("Offsets in format `partition=offset (for partitions not specified, other parameters apply)`"),
                    arguments: [
                        (
                            name: "offset",
                        ),
                    ],
                    repeat: Many,
                ),
                (
                    names: [
                        "--output",
                        "-o",
                    ],
                    description: Some("Output format. One of: json|yaml"),
                    arguments: [
                        (
                            name: "output",
                        ),
                    ],
                ),
                (
                    names: [
                        "--partitions",
                        "-p",
                    ],
                    description: Some("Partitions to consume. The default is to consume from all partitions"),
                    arguments: [
                        (
                            name: "partitions",
                        ),
                    ],
                    repeat: Many,
                ),
                (
                    names: [
                        "--print-headers",
                    ],
                    description: Some("Print message headers"),
                ),
                (
                    names: [
                        "--print-keys",
                        "-k",
                    ],
                    description: Some("Print message keys"),
                ),
                (
                    names: [
                        "--print-schema",
                        "-a",
                    ],
                    description: Some("Print details about avro schema used for decoding"),
                ),
                (
                    names: [
                        "--print-timestamps",
                        "-t",
                    ],
                    description: Some("Print message timestamps"),
                ),
                (
                    names: [
                        "--proto-file",
                    ],
                    description: Some("Additional protobuf description file for searching message description"),
                    arguments: [
                        (
                            name: "proto-file",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                    repeat: Many,
                ),
                (
                    names: [
                        "--proto-import-path",
                    ],
                    description: Some("Additional path to search files listed in proto 'import' directive"),
                    arguments: [
                        (
                            name: "proto-import-path",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                    repeat: Many,
                ),
                (
                    names: [
                        "--protoset-file",
                    ],
                    description: Some("Additional compiled protobuf description file for searching message description"),
                    arguments: [
                        (
                            name: "protoset-file",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                    repeat: Many,
                ),
                (
                    names: [
                        "--separator",
                        "-s",
                    ],
                    description: Some("Separator to split key and value"),
                    arguments: [
                        (
                            name: "separator",
                            default: Some("#"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--tail",
                    ],
                    description: Some("Show only the last n messages on the topic"),
                    arguments: [
                        (
                            name: "tail",
                            default: Some("-1"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--value-encoding",
                    ],
                    description: Some("Value encoding (auto-detected by default). One of: none|hex|base64"),
                    arguments: [
                        (
                            name: "value-encoding",
                        ),
                    ],
                ),
                (
                    names: [
                        "--value-proto-type",
                    ],
                    description: Some("Value protobuf message type"),
                    arguments: [
                        (
                            name: "value-proto-type",
                        ),
                    ],
                ),
            ],
        ),
