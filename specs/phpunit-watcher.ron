(
    version: 1,
    command: "phpunit-watcher",
    description: Some("Automatically rerun PHPUnit tests when source code changes"),
    subcommands: [
        (
            name: "watch",
            description: Some("This will run the tests and rerun them whenever a file in the app, src or tests directory is modified"),
            options: [
                (
                    names: [
                        "--filter",
                    ],
                    description: Some("Watch a specific test"),
                    arguments: [
                        (
                            name: "filter",
                            generators: [
                                (
                                    script: [
                                        "phpunit",
                                        "--list-tests",
                                    ],
                                    has_post_process: true,
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
    ],
)
