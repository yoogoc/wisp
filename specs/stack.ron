(
    version: 1,
    command: "stack",
    description: Some("The Haskell Tool Stack"),
    subcommands: [
        (
            name: "build",
            description: Some("Build the package(s) in the current directory/configuration"),
            options: [
                (
                    names: [
                        "--resolver",
                    ],
                    description: Some("Override resolver in project file"),
                    arguments: [
                        (
                            name: "RESOLVER",
                        ),
                    ],
                ),
                (
                    names: [
                        "--bench",
                    ],
                    description: Some("Override resolver in project file"),
                ),
                (
                    names: [
                        "--test",
                    ],
                    description: Some("Run complete test suite"),
                ),
                (
                    names: [
                        "--copy-bins",
                    ],
                    description: Some("Enable copying any generated executables to the local bin path (default: disabled)"),
                ),
                (
                    names: [
                        "--no-copy-bins",
                    ],
                    description: Some("Disable copying any generated executables to the local bin path (default: disabled)"),
                    exclusive_on: [
                        "--no-copy-bins",
                    ],
                ),
                (
                    names: [
                        "--haddock",
                    ],
                    description: Some("Enable generating Haddocks the package(s) in this directory/configuration (default: disabled)"),
                ),
                (
                    names: [
                        "--no-haddock",
                    ],
                    description: Some("Disable generating Haddocks the package(s) in this directory/configuration (default: disabled)"),
                    exclusive_on: [
                        "--no-haddock",
                    ],
                ),
                (
                    names: [
                        "--open",
                    ],
                    description: Some("Enable opening the local Haddock"),
                ),
                (
                    names: [
                        "--no-open",
                    ],
                    description: Some("Disable opening the local Haddock"),
                ),
                (
                    names: [
                        "--haddock-deps",
                    ],
                    description: Some("Enable building Haddocks for dependencies (default: true if building Haddocks, false otherwise)"),
                ),
                (
                    names: [
                        "--no-haddock-deps",
                    ],
                    description: Some("Disable building Haddocks for dependencies (default: true if building Haddocks, false otherwise)"),
                    exclusive_on: [
                        "--haddock-deps",
                    ],
                ),
                (
                    names: [
                        "--pedantic",
                    ],
                    description: Some("Turn on all warnings(-Wall) and errors(-Werror)"),
                ),
                (
                    names: [
                        "--only-locals",
                    ],
                    description: Some("Only build packages in the local database, fail if the build plan includes the snapshot database"),
                ),
                (
                    names: [
                        "--file-watch",
                    ],
                    description: Some("Watch for changes in the files used to build the project, and kick off a new build when new changes are saved"),
                ),
                (
                    names: [
                        "--watch-all",
                    ],
                    description: Some("Watch all local files not taking targets into account"),
                ),
                (
                    names: [
                        "-file-watch-poll",
                    ],
                    description: Some("Like --file-watch, but polling the filesystem instead of using events"),
                ),
                (
                    names: [
                        "--only-snapshot",
                    ],
                    description: Some("Only build packages for the snapshot database, not the local database"),
                ),
                (
                    names: [
                        "--only-configure",
                    ],
                    description: Some("Only perform the configure step, not any builds. Intended for tool usage, may break when used on multiple packages at once!"),
                ),
                (
                    names: [
                        "--trace",
                    ],
                    description: Some("Enable profiling in libraries, executables, etc. for all expressions and generate a backtrace on exception"),
                ),
                (
                    names: [
                        "--profile",
                    ],
                    description: Some("Runs profiling in libraries, executables, etc. for all expressions and generate a profiling report in tests or benchmarks"),
                ),
                (
                    names: [
                        "--no-strip",
                    ],
                    description: Some("Disable DWARF debugging symbol stripping in libraries, executables, etc. for all expressions, producing larger executables but allowing the use of standard debuggers/profiling tools/other utilities that use debugging symbols"),
                ),
                (
                    names: [
                        "--library-profiling",
                    ],
                    description: Some("Enable library profiling for TARGETs and all its dependencies (default: disabled)"),
                ),
                (
                    names: [
                        "--no-library-profiling",
                    ],
                    description: Some("Disable library profiling for TARGETs and all its dependencies (default: disabled)"),
                ),
                (
                    names: [
                        "--executable-profiling",
                    ],
                    description: Some("Enable executable profiling for TARGETs and all its dependencies (default: disabled)"),
                ),
                (
                    names: [
                        "--no-executable-profiling",
                    ],
                    description: Some("Disable executable profiling for TARGETs and all its dependencies (default: disabled)"),
                    exclusive_on: [
                        "--executable-profiling",
                    ],
                ),
                (
                    names: [
                        "--library-stripping",
                    ],
                    description: Some("Enable library stripping for TARGETs and all its dependencies (default: enabled"),
                ),
                (
                    names: [
                        "--no-library-stripping",
                    ],
                    description: Some("Disable library stripping for TARGETs and all its dependencies (default: enabled"),
                    exclusive_on: [
                        "--library-stripping",
                    ],
                ),
                (
                    names: [
                        "--executable-stripping",
                    ],
                    description: Some("Enable executable stripping for TARGETs and all its dependencies (default: enabled)"),
                ),
                (
                    names: [
                        "--no-executable-stripping",
                    ],
                    description: Some("Disable executable stripping for TARGETs and all its dependencies (default: enabled)"),
                    exclusive_on: [
                        "--executable-stripping",
                    ],
                ),
                (
                    names: [
                        "--ghc-options",
                    ],
                    description: Some("Specify additional options passed to GHC for all local targets. Does not affect extra-dep and snapshot packages at all"),
                    arguments: [
                        (
                            name: "",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "install",
            description: Some("Builds the package in current directory and copies it as an executable for system wide usage. Shortcut for 'build --copy-bins"),
        ),
        (
            name: "test",
            description: Some("Shortcut for 'build --test'"),
        ),
        (
            name: "bench",
            description: Some("Shortcut for 'build --bench'"),
        ),
        (
            name: "haddock",
            description: Some("Shortcut for 'build --haddock'"),
        ),
        (
            name: "new",
            description: Some("Create a new project from a template. Run `stack templates' to see available templates. Note: you can also specify a local file or a remote URL as a template"),
        ),
        (
            name: "templates",
            description: Some("Show how to find templates available for `stack new'. `stack new' can accept a template from a remote repository (default: github), local file or remote URL. Note: this downloads the help file"),
        ),
        (
            name: "init",
            description: Some("Create stack project config from cabal or hpack package specifications'"),
        ),
        (
            name: "setup",
            description: Some("Get the appropriate GHC for your project"),
        ),
        (
            name: "path",
            description: Some("Print out handy path information"),
        ),
        (
            name: "ls",
            description: Some("List command. Supports snapshots, dependencies and stack's styles"),
        ),
        (
            name: "unpack",
            description: Some("Unpack one or more packages locally"),
        ),
        (
            name: "update",
            description: Some("Update the package index"),
        ),
        (
            name: "upgrade",
            description: Some("Upgrade to the latest stack version"),
        ),
        (
            name: "upload",
            description: Some("Upload a package to Hackage"),
        ),
        (
            name: "sdist",
            description: Some("Create source distribution tarballs"),
        ),
        (
            name: "dot",
            description: Some("Visualize your project's dependency graph using Graphviz dot"),
        ),
        (
            name: "hoogle",
            description: Some("Run hoogle, the Haskell API search engine. Use the '-- ARGUMENT(S)' syntax to pass Hoogle arguments, e.g. stack hoogle -- --count=20, or stack hoogle --server --local"),
        ),
        (
            name: "exec",
            description: Some("Execute a command. If the command is absent, the first of any arguments is taken as the command"),
            options: [
                (
                    names: [
                        "--snapshot-location-base",
                    ],
                    description: Some("The base location of LTS/Nightly snapshots"),
                    arguments: [
                        (
                            name: "URL",
                        ),
                    ],
                ),
                (
                    names: [
                        "--cwd",
                    ],
                    description: Some("Sets the working directory before executing the command"),
                    arguments: [
                        (
                            name: "DIR",
                        ),
                    ],
                ),
                (
                    names: [
                        "--setup-info-yaml",
                    ],
                    description: Some("Alternate URL or relative / absolute path for stack dependencies"),
                    arguments: [
                        (
                            name: "URL",
                        ),
                    ],
                ),
                (
                    names: [
                        "--ghc-package-path",
                    ],
                    description: Some("Enable setting the GHC_PACKAGE_PATH variable for the subprocess (default: enabled)"),
                ),
                (
                    names: [
                        "--no-ghc-package-path",
                    ],
                    description: Some("Disable setting the GHC_PACKAGE_PATH variable for the subprocess (default: enabled)"),
                ),
                (
                    names: [
                        "--package",
                    ],
                    description: Some("Additional package(s) that must be installed"),
                    arguments: [
                        (
                            name: "PACKAGE(S)",
                        ),
                    ],
                ),
                (
                    names: [
                        "--stack-exe",
                    ],
                    description: Some("Enable setting the STACK_EXE environment variable to the path for the stack executable (default: enabled)"),
                ),
                (
                    names: [
                        "--no-stack-exe",
                    ],
                    description: Some("Disable setting the STACK_EXE environment variable to the path for the stack executable (default: enabled)"),
                ),
            ],
        ),
        (
            name: "run",
            description: Some("Build and run an executable. Defaults to the first available executable if none is provided as the first argument"),
        ),
        (
            name: "repl",
            description: Some("Load a REPL"),
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for stack"),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Show version for stack"),
        ),
        (
            names: [
                "--numeric-version",
            ],
            description: Some("Show only the numeric version for stack"),
        ),
        (
            names: [
                "--hpack-numeric-version",
            ],
            description: Some("Show only hpack's version number"),
        ),
        (
            names: [
                "--verbosity",
            ],
            description: Some("Verbosity: silent, error, warn, info, debug"),
        ),
        (
            names: [
                "--verbose",
                "-v",
            ],
            description: Some("Enable verbose mode: verbosity level \"debug\""),
        ),
        (
            names: [
                "--silent",
            ],
            description: Some("Enable silent mode: verbosity level \"silent\""),
        ),
        (
            names: [
                "--stack-root",
            ],
            description: Some("Absolute path to the global stack root directory (Overrides any STACK_ROOT environment variable)"),
        ),
        (
            names: [
                "--work-dir",
            ],
            description: Some("Relative path of work directory (Overrides any STACK_WORK environment variable, default is '.stack-work')"),
        ),
        (
            names: [
                "--system-ghc",
            ],
            description: Some("Enable using the system installed GHC (on the PATH) if it is available and its version matches. Disabled by default"),
        ),
        (
            names: [
                "--no-system-ghc",
            ],
            description: Some("Disable using the system installed GHC (on the PATH) if it is available and its version matches. Disabled by default"),
            exclusive_on: [
                "--system-ghc",
            ],
        ),
        (
            names: [
                "--install-ghc",
            ],
            description: Some("Enable downloading and installing GHC if necessary (can be done manually with stack setup). Enabled by default)"),
        ),
        (
            names: [
                "--no-install-ghc",
            ],
            description: Some("Disable downloading and installing GHC if necessary (can be done manually with stack setup). Enabled by default"),
            exclusive_on: [
                "--install-ghc",
            ],
        ),
        (
            names: [
                "--ghc-variant",
            ],
            description: Some("Specialized GHC variant, e.g. integersimple (incompatible with --system-ghc)"),
        ),
        (
            names: [
                "--ghc-build",
            ],
            description: Some("Specialized GHC build, e.g. 'gmp4' or 'standard' (usually auto-detected)"),
        ),
        (
            names: [
                "--jobs",
                "-j",
            ],
            description: Some("Number of concurrent jobs to run. Should be provied as ARGS"),
        ),
        (
            names: [
                "--extra-include-dirs",
            ],
            description: Some("Extra directories to check for C header files"),
        ),
        (
            names: [
                "--extra-lib-dir",
            ],
            description: Some("Extra directories to check for libraries"),
        ),
        (
            names: [
                "--custom-preprocessor-extensions",
            ],
            description: Some("Extensions used for custom preprocessors"),
        ),
        (
            names: [
                "--color",
                "--colour",
            ],
            description: Some("Specify when to use color in output"),
            arguments: [
                (
                    name: "WHEN",
                    description: Some("WHEN is 'always', 'never', or 'auto'. On Windows versions before Windows 10, for terminals that do not support color codes, the default is 'never'; color may work on terminals that support color codes"),
                    suggestions: [
                        (
                            name: "always",
                        ),
                        (
                            name: "never",
                        ),
                        (
                            name: "auto",
                        ),
                    ],
                    default: Some("never"),
                ),
            ],
        ),
        (
            names: [
                "--compiler",
            ],
            description: Some("Use the specified compiler"),
            arguments: [
                (
                    name: "COMPILER",
                ),
            ],
        ),
        (
            names: [
                "--terminal",
            ],
            description: Some("Enable overriding terminal detection in the case of running in a false terminal"),
        ),
        (
            names: [
                "--no-terminal",
            ],
            description: Some("Disable overriding terminal detection in the case of running in a false terminal"),
            exclusive_on: [
                "--teminal",
            ],
        ),
        (
            names: [
                "--stack-colors",
                "--stack-colours",
            ],
            description: Some("Specify stack's output styles"),
            arguments: [
                (
                    name: "STYLE",
                    description: Some("It a colon-delimited sequence of key=value, where 'key' is a style name and 'value' is a semicolon-delimited list of 'ANSI' SGR (Select Graphic Rendition) control codes (in decimal). Use 'stack ls stack-colors --basic' to see the current sequence. In shells where a semicolon is a command separator, enclose STYLES in quotes"),
                ),
            ],
        ),
        (
            names: [
                "--terminal-width",
            ],
            description: Some("Specify the width of the terminal, used for pretty-print messages"),
            arguments: [
                (
                    name: "INT",
                ),
            ],
        ),
        (
            names: [
                "--stack-yaml",
            ],
            description: Some("Override project stack.yaml file (overrides any STACK_YAML environment variable)"),
            arguments: [
                (
                    name: "STACK-YAML",
                ),
            ],
        ),
        (
            names: [
                "--lock-file",
            ],
            description: Some("Specify how to interact with lock files"),
            arguments: [
                (
                    name: "ARG",
                    description: Some("Default: read/write. If resolver is overridden: read-only"),
                ),
            ],
        ),
    ],
)
