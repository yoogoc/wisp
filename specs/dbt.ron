(
    version: 1,
    command: "dbt",
    description: Some("CLI for dbt - Data Build Tool"),
    subcommands: [
        (
            name: "build",
            description: Some("Run models, test tests, snapshot snapshots, and seed seeds"),
            options: [
                (
                    names: [
                        "--full-refresh",
                    ],
                    description: Some("Treat incremental models as table models"),
                ),
                (
                    names: [
                        "-x",
                        "--fail-fast",
                    ],
                    description: Some("Exit immediately if a single model fails to build"),
                ),
                (
                    names: [
                        "--profiles-dir",
                    ],
                    description: Some("Set the profiles directory"),
                    arguments: [
                        (
                            name: "directory",
                            description: Some("Directory containing profiles.yml"),
                            suggestions: [
                                (
                                    name: "profiles",
                                ),
                            ],
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--profile",
                    ],
                    description: Some("Use the selected profile"),
                    arguments: [
                        (
                            name: "name",
                            description: Some("Name of profile to use when running dbt project"),
                            suggestions: [
                                (
                                    name: "default",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--target",
                    ],
                    description: Some("Target profile configuration i.e. prod/dev"),
                    arguments: [
                        (
                            name: "profile",
                            description: Some("Target profile configuration (dev/prod)"),
                            suggestions: [
                                (
                                    name: "dev",
                                ),
                                (
                                    name: "prod",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--vars",
                    ],
                    description: Some("Variable values to override dbt_project.yml"),
                    arguments: [
                        (
                            name: "variables",
                            description: Some("A short YAML string eg. '{my_variable: my_value}'"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--threads",
                    ],
                    description: Some("Number of concurrent database jobs"),
                    arguments: [
                        (
                            name: "THREADS",
                        ),
                    ],
                ),
                (
                    names: [
                        "-s",
