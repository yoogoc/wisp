(
    version: 1,
    command: "oh-my-posh",
    subcommands: [
        (
            name: "init",
            description: Some("Initialize oh-my-posh for your shell"),
            options: [
                (
                    names: [
                        "--config",
                        "-c",
                    ],
                    description: Some("The config file to use"),
                    arguments: [
                        (
                            name: "CONFIG",
                            description: Some("The configuration to use"),
                            template: [
                                FilePaths,
                                History,
                            ],
                        ),
                    ],
                    persistent: true,
                ),
                (
                    names: [
                        "--print",
                        "-p",
                    ],
                    description: Some("Print the init script"),
                ),
            ],
            arguments: [
                (
                    name: "SHELL",
                    suggestions: [
                        (
                            name: "zsh",
                        ),
                        (
                            name: "fish",
                        ),
                        (
                            name: "pwsh",
                        ),
                        (
                            name: "powershell",
                        ),
                        (
                            name: "cmd",
                        ),
                        (
                            name: "bash",
                        ),
                        (
                            name: "shell",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "get",
            description: Some("Get oh-my-posh values"),
            arguments: [
                (
                    name: "VALUE",
                    suggestions: [
                        (
                            name: "millis",
                            description: Some("Get the current timestamp in milliseconds, example usage: 'oh-my-posh get millis'"),
                        ),
                        (
                            name: "shell",
                            description: Some("Get the current shell, example usage: 'oh-my-posh get shell'"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "debug",
            description: Some("Debug oh-my-posh, example usage: 'oh-my-posh debug'"),
            options: [
                (
                    names: [
                        "--config",
                        "-c",
                    ],
                    description: Some("The config file to use"),
                    arguments: [
                        (
                            name: "CONFIG",
                            description: Some("The configuration to use"),
                            template: [
                                FilePaths,
                                History,
                            ],
                        ),
                    ],
                    persistent: true,
                ),
            ],
        ),
        (
            name: "config",
            description: Some("Interact with the oh-my-posh configuration"),
            subcommands: [
                (
                    name: "edit",
                    description: Some("Edit the config file, example usage: 'oh-my-posh config edit'"),
                ),
                (
                    name: "migrate",
                    description: Some("Migrate the config file, example usage: 'oh-my-posh config migrate --config ~/.config.omp.json'"),
                    options: [
                        (
                            names: [
                                "--write",
                                "-w",
                            ],
                            description: Some("Write the migrated config to the configuration file, example usage: 'oh-my-posh config migrate --write'"),
                        ),
                        (
                            names: [
                                "--format",
                                "-f",
                            ],
                            description: Some("The file format to use"),
                            arguments: [
                                (
                                    name: "FORMAT",
                                    description: Some("The export format"),
                                    suggestions: [
                                        (
                                            name: "json",
                                        ),
                                        (
                                            name: "yaml",
                                        ),
                                        (
                                            name: "toml",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "export",
                    description: Some("Export the config file, example usage: 'oh-my-posh config export --config ~/.config.omp.toml'"),
                    options: [
                        (
                            names: [
                                "--output",
                                "-o",
                            ],
                            description: Some("The file to output the migrated config to, example usage: 'oh-my-posh config export --output ~/.config.omp.json'"),
                            arguments: [
                                (
                                    name: "OUTPUT",
                                    description: Some("The file to write to"),
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--format",
                                "-f",
                            ],
                            description: Some("The file format to use"),
                            arguments: [
                                (
                                    name: "FORMAT",
                                    description: Some("The export format"),
                                    suggestions: [
                                        (
                                            name: "json",
                                        ),
                                        (
                                            name: "yaml",
                                        ),
                                        (
                                            name: "toml",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                    ],
                ),
            ],
            options: [
                (
                    names: [
                        "--config",
                        "-c",
                    ],
                    description: Some("The config file to use"),
                    arguments: [
                        (
                            name: "CONFIG",
                            description: Some("The configuration to use"),
                            template: [
                                FilePaths,
                                History,
                            ],
                        ),
                    ],
                    persistent: true,
                ),
            ],
        ),
        (
            name: "print",
            description: Some("Print a prompt"),
            options: [
                (
                    names: [
                        "--config",
                        "-c",
                    ],
                    description: Some("The config file to use"),
                    arguments: [
                        (
                            name: "CONFIG",
                            description: Some("The configuration to use"),
                            template: [
                                FilePaths,
                                History,
                            ],
                        ),
                    ],
                    persistent: true,
                ),
                (
                    names: [
                        "--terminal-width",
                        "-w",
                    ],
                    description: Some("The terminal width, example usage: 'oh-my-posh print primary --terminal-width 200'"),
                    arguments: [
                        (
                            name: "WIDTH",
                            description: Some("The terminal width"),
                            default: Some("0"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--command",
                    ],
                    description: Some("The current command for tooltips, example usage: 'oh-my-posh print tooltip --command az'"),
                    arguments: [
                        (
                            name: "COMMAND",
                            description: Some("The tooltip command"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--error",
                        "-e",
                    ],
                    description: Some("The last exit code, example usage: 'oh-my-posh print primary --error 127'"),
                    arguments: [
                        (
                            name: "ERROR CODE",
                            description: Some("The last error code"),
                            default: Some("0"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--eval",
                    ],
                    description: Some("Use eval to render the prompt, example usage: 'oh-my-posh print primary --eval'"),
                ),
                (
                    names: [
                        "--execution-time",
                    ],
                    description: Some("Use last command execution time in millis, example usage: 'oh-my-posh print primary --execution-time 200'"),
                    arguments: [
                        (
                            name: "EXECUTION TIME",
                            description: Some("The last command's execution time"),
                            default: Some("0"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--plain",
                        "-p",
                    ],
                    description: Some("Print a prompt without ASNI codes, example usage: 'oh-my-posh print primary --plain'"),
                ),
                (
                    names: [
                        "--pswd",
                    ],
                    description: Some("The current working directory according to PowerShell, example usage: 'oh-my-posh print primary --pswd C:\\Users\\user\\Documents'"),
                    arguments: [
                        (
                            name: "POWERSHELL WORKING DIRECTORY",
                            description: Some("The working directory according to PowerShell"),
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--pwd",
                    ],
                    description: Some("The current working directory, example usage: 'oh-my-posh print primary --pwd /home/user/Documents'"),
                    arguments: [
                        (
                            name: "WORKING DIRECTORY",
                            description: Some("The working directory"),
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--shell",
                    ],
                    description: Some("The current shell, example usage: 'oh-my-posh print primary --shell fish'"),
                    arguments: [
                        (
                            name: "SHELL",
                            description: Some("The shell used"),
                            suggestions: [
                                (
                                    name: "zsh",
                                ),
                                (
                                    name: "fish",
                                ),
                                (
                                    name: "pwsh",
                                ),
                                (
                                    name: "powershell",
                                ),
                                (
                                    name: "cmd",
                                ),
                                (
                                    name: "bash",
                                ),
                                (
                                    name: "shell",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--stack-count",
                    ],
                    description: Some("The directory stack count, example usage: 'oh-my-posh print primary --stack-count 1'"),
                    arguments: [
                        (
                            name: "NUM",
                            description: Some("The number of stacks"),
                            default: Some("0"),
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "PROMPT",
                    suggestions: [
                        (
                            name: "primary",
                        ),
                        (
                            name: "secondary",
                        ),
                        (
                            name: "right",
                        ),
                        (
                            name: "transient",
                        ),
                        (
                            name: "tooltip",
                        ),
                        (
                            name: "valid",
                        ),
                        (
                            name: "error",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "version",
            description: Some("Display the oh-my-posh version, example usage: 'oh-my-posh version'"),
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for oh-my-posh"),
            persistent: true,
        ),
    ],
)
