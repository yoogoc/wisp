(
    version: 1,
    command: "babel",
    options: [
        (
            names: [
                "-f",
                "--filename",
            ],
            description: Some("The filename to use when reading from stdin. This will be used in source-maps, errors etc"),
            arguments: [
                (
                    name: "filename",
                ),
            ],
        ),
        (
            names: [
                "--presets",
            ],
            description: Some("A comma-separated list of preset names"),
            arguments: [
                (
                    name: "list",
                ),
            ],
        ),
        (
            names: [
                "--plugins",
            ],
            description: Some("A comma-separated list of plugin names"),
            arguments: [
                (
                    name: "list",
                ),
            ],
        ),
        (
            names: [
                "--config-file",
            ],
            description: Some("Path to a .babelrc file to use"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--env-name",
            ],
            description: Some("The name of the 'env' to use when loading configs and plugins. Defaults to the value of BABEL_ENV, or else NODE_ENV, or else 'development'"),
            arguments: [
                (
                    name: "env",
                    suggestions: [
                        (
                            name: "production",
                        ),
                        (
                            name: "development",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--root-mode",
            ],
            description: Some("The project-root resolution mode"),
            arguments: [
                (
                    name: "mode",
                    suggestions: [
                        (
                            name: "root",
                            description: Some("Passes the \"root\" value through as unchanged"),
                        ),
                        (
                            name: "upward",
                            description: Some("Walks upward from the \"root\" directory, looking for a directory containing a babel.config.json file, and throws an error if a babel.config.json is not found"),
                        ),
                        (
                            name: "upward-optional",
                            description: Some("Walk upward from the \"root\" directory, looking for a directory containing a babel.config.json file, and falls back to \"root\" if a babel.config.json is not found"),
                        ),
                    ],
                    default: Some("root"),
                ),
            ],
        ),
        (
            names: [
                "--source-type",
            ],
            arguments: [
                (
                    name: "type",
                    suggestions: [
                        (
                            name: "script",
                        ),
                        (
                            name: "module",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--no-babelrc",
            ],
            description: Some("Whether or not to look up .babelrc and .babelignore files"),
        ),
        (
            names: [
                "--ignore",
            ],
            description: Some("List of glob paths to **not** compile"),
            arguments: [
                (
                    name: "list",
                ),
            ],
        ),
        (
            names: [
                "--only",
            ],
            description: Some("List of glob paths to **only** compile"),
            arguments: [
                (
                    name: "list",
                ),
            ],
        ),
        (
            names: [
                "--no-highlight-code",
            ],
            description: Some("Enable or disable ANSI syntax highlighting of code frames"),
        ),
        (
            names: [
                "--no-comments",
            ],
            description: Some("Write comments to generated output"),
        ),
        (
            names: [
                "--retain-lines",
            ],
            description: Some("Retain line numbers. This will result in really ugly code"),
        ),
        (
            names: [
                "--compact",
            ],
            description: Some("Do not include superfluous whitespace characters and line terminators"),
            arguments: [
                (
                    name: "mode",
                    suggestions: [
                        (
                            name: "true",
                        ),
                        (
                            name: "false",
                        ),
                        (
                            name: "auto",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--minified",
            ],
            description: Some("Save as many bytes when printing. (false by default)"),
        ),
        (
            names: [
                "--auxiliary-comment-before",
            ],
            description: Some("Print a comment before any injected non-user code"),
            arguments: [
                (
                    name: "comment",
                ),
            ],
        ),
        (
            names: [
                "--auxiliary-comment-after",
            ],
            description: Some("Print a comment after any injected non-user code"),
            arguments: [
                (
                    name: "comment",
                ),
            ],
        ),
        (
            names: [
                "-s",
                "--source-maps",
            ],
            arguments: [
                (
                    name: "mode",
                    suggestions: [
                        (
                            name: "true",
                        ),
                        (
                            name: "false",
                        ),
                        (
                            name: "inline",
                        ),
                        (
                            name: "both",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--source-map-target",
            ],
            description: Some("Set `file` on returned source map"),
            arguments: [
                (
                    name: "string",
                ),
            ],
        ),
        (
            names: [
                "--source-file-name",
            ],
            description: Some("Set `sources[0]` on returned source map"),
            arguments: [
                (
                    name: "string",
                ),
            ],
        ),
        (
            names: [
                "--source-root",
            ],
            description: Some("The root from which all sources are relative"),
            arguments: [
                (
                    name: "filename",
                ),
            ],
        ),
        (
            names: [
                "-x",
                "--extensions",
            ],
            description: Some("Comma separated list of extensions to compile when a directory has been the input. [js,ts,jsx,tsx]"),
            arguments: [
                (
                    name: "extensions",
                ),
            ],
        ),
        (
            names: [
                "--keep-file-extension",
            ],
            description: Some("Preserve the file extensions of the input files"),
        ),
        (
            names: [
                "-w",
                "--watch",
            ],
            description: Some("Recompile files on changes"),
        ),
        (
            names: [
                "--skip-initial-build",
            ],
            description: Some("Do not compile files before watching"),
        ),
        (
            names: [
                "-o",
                "--out-file",
            ],
            description: Some("Compile all input files into a single file"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-d",
                "--out-dir",
            ],
            description: Some("Compile an input directory of modules into an output directory"),
            arguments: [
                (
                    name: "directory",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--relative",
            ],
            description: Some("Compile into an output directory relative to input directory or file"),
            depends_on: [
                "--out-dir",
            ],
        ),
        (
            names: [
                "-D",
                "--copy-files",
            ],
            description: Some("When compiling a directory copy over non-compilable files"),
        ),
        (
            names: [
                "--include-dotfiles",
            ],
            description: Some("Include dotfiles when compiling and copying non-compilable files"),
        ),
        (
            names: [
                "--no-copy-ignored",
            ],
            description: Some("Exclude ignored files when copying non-compilable files"),
        ),
        (
            names: [
                "--verbose",
            ],
            description: Some("Log everything. This option conflicts with --quiet"),
            exclusive_on: [
                "--quiet",
            ],
        ),
        (
            names: [
                "--quiet",
            ],
            description: Some("Don't log anything. This option conflicts with --verbose"),
            exclusive_on: [
                "--verbose",
            ],
        ),
        (
            names: [
                "--delete-dir-on-start",
            ],
            description: Some("Delete the out directory before compilation"),
        ),
        (
            names: [
                "--out-file-extension",
            ],
            description: Some("Use a specific extension for the output files"),
            arguments: [
                (
                    name: "extension",
                    suggestions: [
                        (
                            name: ".es6",
                        ),
                        (
                            name: ".js",
                        ),
                        (
                            name: ".es",
                        ),
                        (
                            name: ".jsx",
                        ),
                        (
                            name: ".mjs",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-V",
                "--version",
            ],
            description: Some("Output the version number"),
        ),
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Output usage information"),
        ),
    ],
    presentation: (
        icon: Some("https://raw.githubusercontent.com/babel/logo/master/babel.png"),
    ),
)
