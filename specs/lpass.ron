(
    version: 1,
    command: "lpass",
    description: Some("Command line interface for LastPass"),
    subcommands: [
        (
            name: "login",
            description: Some("Log in to LastPass"),
            options: [
                (
                    names: [
                        "--trust",
                    ],
                    description: Some("Subsequent logins will not require multifactor authentication"),
                ),
                (
                    names: [
                        "--plaintext-key",
                    ],
                    description: Some("Save decryption key to the hard disk in plaintext"),
                    arguments: [
                        (
                            name: "--force",
                            description: Some("Skip user confirmation"),
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--color",
                    ],
                    description: Some("Control colored output to the terminal"),
                    arguments: [
                        (
                            name: "color",
                            suggestions: [
                                (
                                    name: "auto",
                                ),
                                (
                                    name: "never",
                                ),
                                (
                                    name: "always",
                                ),
                            ],
                            optional: true,
                            default: Some("auto"),
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "USERNAME",
                    description: Some("LastPass account username (email address)"),
                ),
            ],
        ),
        (
            name: "logout",
            description: Some("Log out of LastPass"),
            options: [
                (
                    names: [
                        "--force",
                    ],
                    description: Some("Skip user confirmation"),
                ),
            ],
        ),
        (
