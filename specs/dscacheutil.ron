(
    version: 1,
    command: "dscacheutil",
    description: Some("Utility for managing the Directory Service cache"),
    subcommands: [
        (
            name: "-h",
            description: Some("List the options for calling dscacheutil"),
        ),
        (
            name: "-q",
            description: Some("Query the Directory Service cache"),
            options: [
                (
                    names: [
                        "-a",
                    ],
                    description: Some("Attribute to query"),
                    arguments: [
                        (
                            name: "attributeKey",
                            generators: [
                                (
                                    has_custom: true,
                                ),
                            ],
                        ),
                        (
                            name: "attributeValue",
                            generators: [
                                (
                                    has_custom: true,
                                ),
                            ],
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "category",
                    description: Some("Category to query"),
                    suggestions: [
                        (
                            name: "group",
                        ),
                        (
                            name: "host",
                        ),
                        (
                            name: "mount",
                        ),
                        (
                            name: "protocol",
                        ),
                        (
                            name: "rpc",
                        ),
                        (
                            name: "service",
                        ),
                        (
                            name: "user",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "-cachedump",
            description: Some("Get an overview of the cache by default"),
            options: [
                (
                    names: [
                        "-buckets",
                    ],
                    description: Some("Get an overview of the cache by default"),
                ),
                (
                    names: [
                        "-entries",
                    ],
                    description: Some("Dump detailed information about cache entries"),
                    arguments: [
                        (
                            name: "entry",
                            suggestions: [
                                (
                                    name: "group",
                                ),
                                (
                                    name: "host",
                                ),
                                (
                                    name: "mount",
                                ),
                                (
                                    name: "protocol",
                                ),
                                (
                                    name: "rpc",
                                ),
                                (
                                    name: "service",
                                ),
                                (
                                    name: "user",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "-configuration",
            description: Some("Get the current configuration information, such as the search policy and cache parameters"),
        ),
        (
            name: "-flushcache",
            description: Some("Flush the entire cache"),
        ),
        (
            name: "-statistics",
            description: Some("Get statistics from the cache, including an overview an detailed call statistics"),
        ),
    ],
)
