(
    version: 1,
    command: "youtube-dl",
    description: Some("Download videos from YouTube"),
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Print the help text and exit"),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Print program version and exit"),
        ),
        (
            names: [
                "-U",
                "--update",
            ],
            description: Some("Update this program to latest version. Make sure you have sufficient permissions (run with sudo if needed)"),
        ),
        (
            names: [
                "--ignore-errors",
                "-i",
            ],
            description: Some("Continue on download errors, for example to skip unavailable videos in a playlist"),
        ),
        (
            names: [
                "--abort-on-error",
            ],
            description: Some("Abort downloading of further videos (in the playlist or the command line) if an error occurs"),
        ),
        (
            names: [
                "--dump-user-agent",
            ],
            description: Some("Display the current browser identification"),
        ),
        (
            names: [
                "--list-extractors",
            ],
            description: Some("List all supported extractors"),
        ),
        (
            names: [
                "--extractor-descriptions",
            ],
            description: Some("Output descriptions of all supported extractors"),
        ),
        (
            names: [
                "--default-search",
            ],
            description: Some("Use this prefix for unqualified URLs. For example \"gvsearch2:\" downloads two videos from google videos for youtube-dl \"large apple\""),
            arguments: [
                (
                    name: "PREFIX",
                ),
            ],
        ),
        (
            names: [
                "--config-location",
            ],
            description: Some("Location of the configuration file; either the path to the config or its containing directory"),
            arguments: [
                (
                    name: "PATH",
                    template: [
                        FilePaths,
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--force-generic-extractor",
            ],
            description: Some("Force extraction to use the generic extractor"),
        ),
        (
            names: [
                "--ignore-config",
            ],
            description: Some("Do not read configuration files"),
        ),
        (
            names: [
                "--flat-playlist",
            ],
            description: Some("Do not extract the videos of a playlist, only list them"),
        ),
        (
            names: [
                "--mark-watched",
            ],
            description: Some("Mark videos watched (YouTube only)"),
        ),
        (
            names: [
                "--no-mark-watched",
            ],
            description: Some("Do not mark videos watched (YouTube only)"),
        ),
        (
            names: [
                "--no-color",
            ],
            description: Some("Do not emit color codes in output"),
        ),
        (
            names: [
                "--proxy",
            ],
            description: Some("Use the specified HTTP/HTTPS/SOCKS proxy. Pass in an empty string for direct connection"),
            arguments: [
                (
                    name: "URL",
                ),
            ],
            presentation: (
                insert_value: Some("--proxy \"{cursor}\""),
            ),
        ),
        (
            names: [
                "--socket-timeout",
            ],
            description: Some("Time to wait before giving up, in seconds"),
            arguments: [
                (
                    name: "SECONDS",
                ),
            ],
        ),
        (
            names: [
                "--source-address",
            ],
            description: Some("Client-side IP address to bind to"),
            arguments: [
                (
                    name: "IP",
                ),
            ],
        ),
        (
            names: [
                "-4",
                "--force-ipv4",
            ],
            description: Some("Make all connections via IPv4"),
        ),
        (
            names: [
                "-6",
                "--force-ipv6",
            ],
            description: Some("Make all connections via IPv6"),
        ),
        (
            names: [
                "--geo-verification-proxy",
            ],
            description: Some("Use this proxy to verify the IP address for some geo-restricted sites"),
            arguments: [
                (
                    name: "URL",
                ),
            ],
        ),
        (
            names: [
                "--geo-bypass",
            ],
            description: Some("Bypass geographic restriction via faking X-Forwarded-For HTTP header"),
        ),
        (
            names: [
                "--no-geo-bypass",
            ],
            description: Some("Do not bypass geographic restriction via faking X-Forwarded-For HTTP header"),
        ),
        (
            names: [
                "--geo-bypass-country",
            ],
            description: Some("Force bypass geographic restriction with explicitly provided two-letter ISO 3166-2 county code"),
            arguments: [
                (
                    name: "CODE",
                ),
            ],
        ),
        (
            names: [
                "--geo-bypass-ip-block",
            ],
            description: Some("Force bypass geographic restriction with explicitly provided IP block in CIDR notation"),
            arguments: [
                (
                    name: "IP_BLOCK",
                ),
            ],
        ),
        (
            names: [
                "--playlist-start",
            ],
            description: Some("Playlist video to start at (default is 1)"),
            arguments: [
                (
                    name: "NUMBER",
                    generators: [
                        (
                            has_dynamic_script: true,
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--playlist-end",
            ],
            description: Some("Playlist video to end at (default is last)"),
            arguments: [
                (
                    name: "NUMBER",
                    generators: [
                        (
                            has_dynamic_script: true,
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--playlist-items",
            ],
            description: Some("Playlist video to end at (default is last)"),
            arguments: [
                (
                    name: "ITEM_SPEC",
                    generators: [
                        (
                            has_dynamic_script: true,
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--match-title",
            ],
            description: Some("Download only matching titles (regex or caseless sub-string)"),
            arguments: [
                (
                    name: "REGEX",
                ),
            ],
        ),
        (
            names: [
                "--reject-title",
            ],
            description: Some("Skip download for matching titles (regex or caseless sub-string)"),
            arguments: [
                (
                    name: "REGEX",
                ),
            ],
        ),
        (
            names: [
                "--max-downloads",
            ],
            description: Some("Abort after downloading NUMBER files"),
            arguments: [
                (
                    name: "NUMBER",
                ),
            ],
        ),
        (
            names: [
                "--min-filesize",
            ],
            description: Some("Do not download any videos smaller than SIZE (e.g. 50k or 44.6)"),
            arguments: [
                (
                    name: "SIZE",
                ),
            ],
        ),
        (
            names: [
                "--max-filesize",
            ],
            description: Some("Do not download any videos larger than SIZE (e.g. 50k or 44.6)"),
            arguments: [
                (
                    name: "SIZE",
                ),
            ],
        ),
        (
            names: [
                "--date",
            ],
            description: Some("Download only videos uploaded in this date"),
            arguments: [
                (
                    name: "DATE",
                ),
            ],
        ),
        (
            names: [
                "--datebefore",
            ],
            description: Some("Download only videos uploaded on or before this date (i.e. inclusive)"),
            arguments: [
                (
                    name: "DATE",
                ),
            ],
        ),
        (
            names: [
                "--dateafter",
            ],
            description: Some("Download only videos uploaded on or after this date (i.e. inclusive)"),
            arguments: [
                (
                    name: "DATE",
                ),
            ],
        ),
        (
            names: [
                "--min-views",
            ],
            description: Some("Do not download any videos with less than COUNT views"),
            arguments: [
                (
                    name: "COUNT",
                ),
            ],
        ),
        (
            names: [
                "--max-views",
            ],
            description: Some("Do not download any videos with more than COUNT views"),
            arguments: [
                (
                    name: "COUNT",
                ),
            ],
        ),
        (
            names: [
                "--match-filter",
            ],
            description: Some("Generic video filter"),
            arguments: [
                (
                    name: "FILTER",
                ),
            ],
        ),
        (
            names: [
                "--no-playlist",
            ],
            description: Some("Download only the video, if the URL refers to a video and a playlist"),
        ),
        (
            names: [
                "--yes-playlist",
            ],
            description: Some("Download the playlist, if the URL refers to a video and a playlist"),
        ),
        (
            names: [
                "--age-limit",
            ],
            description: Some("Download only videos suitable for the given age"),
            arguments: [
                (
                    name: "YEARS",
                ),
            ],
        ),
        (
            names: [
                "--download-archive",
            ],
            description: Some("Download only videos not listed in the archive file. Record the IDs of all downloaded videos in it"),
            arguments: [
                (
                    name: "FILE",
                ),
            ],
        ),
        (
            names: [
                "--include-ads",
            ],
            description: Some("Download advertisements as well (experimental)"),
        ),
        (
            names: [
                "-r",
                "--limit-rate",
            ],
            description: Some("Maximum download rate in bytes per second (e.g. 50K or 4.2M)"),
            arguments: [
                (
                    name: "RATE",
                ),
            ],
        ),
        (
            names: [
                "-R",
                "--retries",
            ],
            description: Some("Number of retries or \"infinite\""),
            arguments: [
                (
                    name: "RETRIES",
                    default: Some("10"),
                ),
            ],
        ),
        (
            names: [
                "--fragment-retries",
            ],
            description: Some("Number of retries for a fragment or \"infinite\""),
            arguments: [
                (
                    name: "RETRIES",
                    default: Some("10"),
                ),
            ],
        ),
        (
            names: [
                "--skip-unavailable-fragments",
            ],
            description: Some("Skip unavailable fragments"),
        ),
        (
            names: [
                "--abort-on-unavailable-fragments",
            ],
            description: Some("Abort downloading when some fragment is not available"),
        ),
        (
            names: [
                "--keep-fragments",
            ],
            description: Some("Keep downloaded fragments on disk after downloading is finished; fragments are erased by default"),
        ),
        (
            names: [
                "--buffer-size",
            ],
            description: Some("Size of download buffer (e.g. 1024 or 16K)"),
            arguments: [
                (
                    name: "SIZE",
                    default: Some("1024"),
                ),
            ],
        ),
        (
            names: [
                "--no-resize-buffer",
            ],
            description: Some("Do not automatically adjust the buffer size"),
        ),
        (
            names: [
                "--http-chunk-size",
            ],
            description: Some("Size of a chunk for chunk-based HTTP downloading (e.g. 10385760 or 10M)"),
            arguments: [
                (
                    name: "SIZE",
                ),
            ],
        ),
        (
            names: [
                "--playlist-reverse",
            ],
            description: Some("Download playlist videos in reverse order"),
        ),
        (
            names: [
                "--playlist-random",
            ],
            description: Some("Download playlist videos in random order"),
        ),
        (
            names: [
                "--xattr-set-filesize",
            ],
            description: Some("Set file xattribute ytdl.filesize with expected file size"),
        ),
        (
            names: [
                "--hls-prefer-native",
            ],
            description: Some("Use the native HLS downloader instead of ffmpeg"),
        ),
        (
            names: [
                "--hls-prefer-ffmpeg",
            ],
            description: Some("Use ffmpeg instead of the native HLS downloader"),
        ),
        (
            names: [
                "--hls-prefer-mpegts",
            ],
            description: Some("Use the mpegts container for HLS videos, allowing to play the video while downloading"),
        ),
        (
            names: [
                "--external-downloader",
            ],
            description: Some("Use the specified external downloader"),
            arguments: [
                (
                    name: "COMMAND",
                    suggestions: [
                        (
                            name: "aria2c",
                        ),
                        (
                            name: "avconv",
                        ),
                        (
                            name: "axel",
                        ),
                        (
                            name: "curl",
                        ),
                        (
                            name: "ffmpeg",
                        ),
                        (
                            name: "httpie",
                        ),
                        (
                            name: "wget",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--external-downloader-args",
            ],
            description: Some("Give these arguments to the external downloader"),
            arguments: [
                (
                    name: "ARGS",
                ),
            ],
            depends_on: [
                "--external-downloader",
            ],
        ),
        (
            names: [
                "-a",
                "--batch-file",
            ],
            description: Some("File containing URLs to download ('-' for stdin), one URL per line. Lines starting with '#', ';' or ']' are considered as comments and ignored"),
            arguments: [
                (
                    name: "FILE",
                    suggestions: [
                        (
                            name: "-",
                        ),
                    ],
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--id",
            ],
            description: Some("Use only video ID in file name"),
        ),
        (
            names: [
                "-o",
                "--output",
            ],
            description: Some("Output filename template"),
            arguments: [
                (
                    name: "TEMPLATE",
                ),
            ],
        ),
        (
            names: [
                "--output-na-placeholder",
            ],
            description: Some("Placeholder value for unavailable meta fields in output filename template"),
            arguments: [
                (
                    name: "PLACEHOLDER",
                    default: Some("NA"),
                ),
            ],
        ),
        (
            names: [
                "--autonumber-start",
            ],
            description: Some("Specify the start value for %(autonumber)s"),
            arguments: [
                (
                    name: "NUMBER",
                    default: Some("1"),
                ),
            ],
        ),
        (
            names: [
                "--restrict-filenames",
            ],
            description: Some("Restrict filenames to only ASCII characters, and avoid \"&\" and spaces in filenames"),
        ),
        (
            names: [
                "-w",
                "--no-overwrites",
            ],
            description: Some("Do not overwrite files"),
        ),
        (
            names: [
                "-c",
                "--continue",
            ],
            description: Some("Do not resume partially downloaded files (restart from beginning)"),
        ),
        (
            names: [
                "--no-part",
            ],
            description: Some("Do not use .part files - write directly into output file"),
        ),
        (
            names: [
                "--no-mtime",
            ],
            description: Some("Do not use the Last-modified header to set the file modification time"),
        ),
        (
            names: [
                "--write-description",
            ],
            description: Some("Write video descriptions to a .description file"),
        ),
        (
            names: [
                "--write-info-json",
            ],
            description: Some("Write video metadata to a .info.json file"),
        ),
        (
            names: [
                "--write-annotations",
            ],
            description: Some("Write video annotations to a .annotations.xml file"),
        ),
        (
            names: [
                "--load-info-json",
            ],
            description: Some("JSON file containing the video information (created with the \"--write-info-json\" option"),
            arguments: [
                (
                    name: "FILE",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--cookies",
            ],
            description: Some("File to read cookies from and dump cookie jar in"),
            arguments: [
                (
                    name: "FILE",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--cache-dir",
            ],
            description: Some("Location in the filesystem where youtube-dl can store some downloaded information permanently"),
            arguments: [
                (
                    name: "DIR",
                    template: [
                        Folders,
                    ],
                    default: Some("$XDG_CACHE_HOME/youtube-dl"),
                ),
            ],
        ),
        (
            names: [
                "--no-cache-dir",
            ],
            description: Some("Disable filesystem caching"),
        ),
        (
            names: [
                "--rm-cache-dir",
            ],
            description: Some("Delete all filesystem cache files"),
        ),
        (
            names: [
                "--write-thumbnail",
            ],
            description: Some("Write thumbnail image to disk"),
        ),
        (
            names: [
                "--write-all-thumbnail",
            ],
            description: Some("Write all thumbnail image formats to disk"),
        ),
        (
            names: [
                "--list-thumbnails",
            ],
            description: Some("Simulate and list all available thumbnail formats"),
        ),
        (
            names: [
                "-q",
                "--quiet",
            ],
            description: Some("Activate quite mode"),
        ),
        (
            names: [
                "--no-warnings",
            ],
            description: Some("Ignore warnings"),
        ),
        (
            names: [
                "-s",
                "--simulate",
            ],
            description: Some("Do not download the video and do note write anything to disk"),
        ),
        (
            names: [
                "--skip-download",
            ],
            description: Some("Do not download the video"),
        ),
        (
            names: [
                "-g",
                "--get-url",
            ],
            description: Some("Simulate, quiet but print URL"),
        ),
        (
            names: [
                "-e",
                "--get-title",
            ],
            description: Some("Simulate, quiet but print title"),
        ),
        (
            names: [
                "--get-id",
            ],
            description: Some("Simulate, quiet but print id"),
        ),
        (
            names: [
                "--get-thumbnail",
            ],
            description: Some("Simulate, quiet but print thumbnail URL"),
        ),
        (
            names: [
                "--get-description",
            ],
            description: Some("Simulate, quiet but print video description"),
        ),
        (
            names: [
                "--get-duration",
            ],
            description: Some("Simulate, quiet but print video length"),
        ),
        (
            names: [
                "--get-filename",
            ],
            description: Some("Simulate, quiet but print output filename"),
        ),
        (
            names: [
                "--get-format",
            ],
            description: Some("Simulate, quiet but print output format"),
        ),
        (
            names: [
                "-j",
                "--dump-json",
            ],
            description: Some("Simulate, quiet but JSON information"),
        ),
        (
            names: [
                "-J",
                "--dump-single-json",
            ],
            description: Some("Simulate, quiet but JSON information for each command-line argument"),
        ),
        (
            names: [
                "--print-json",
            ],
            description: Some("Be quiet and print the video information as JSON (video is still being downloaded)"),
        ),
        (
            names: [
                "--newline",
            ],
            description: Some("Output the progress bar as new lines"),
        ),
        (
            names: [
                "--no-progress",
            ],
            description: Some("Do not print the progress bar"),
        ),
        (
            names: [
                "--console-title",
            ],
            description: Some("Display progress in console titlebar"),
        ),
        (
            names: [
                "-v",
                "--verbose",
            ],
            description: Some("Print various debugging information"),
        ),
        (
            names: [
                "--dump-pages",
            ],
            description: Some("Print downloaded pages encoded using base64 to debug problems (very verbose)"),
        ),
        (
            names: [
                "--write-pages",
            ],
            description: Some("Write downloaded intermediary pages to files in the current directory to debug problems"),
        ),
        (
            names: [
                "--print-traffic",
            ],
            description: Some("Display sent and read HTTP traffic"),
        ),
        (
            names: [
                "-C",
                "--call-home",
            ],
            description: Some("Contact the youtube-dl server for debugging"),
        ),
        (
            names: [
                "--no-call-home",
            ],
            description: Some("Do NOT contact the youtube-dl server for debugging"),
        ),
        (
            names: [
                "--encoding",
            ],
            description: Some("Force the specified encoding (experimental)"),
            arguments: [
                (
                    name: "ENCODING",
                ),
            ],
        ),
        (
            names: [
                "--no-check-certificate",
            ],
            description: Some("Suppress HTTPS certificate validation"),
        ),
        (
            names: [
                "--prefer-insecure",
            ],
            description: Some("Use an unencrypted connection to retrieve information about the video. (Currently supported only for YouTube)"),
        ),
        (
            names: [
                "--user-agent",
            ],
            description: Some("Specify a custom user agent"),
            arguments: [
                (
                    name: "UA",
                ),
            ],
        ),
        (
            names: [
                "--referer",
            ],
            description: Some("Specify a custom referer, use if the video access is restricted to one domain"),
            arguments: [
                (
                    name: "URL",
                ),
            ],
        ),
        (
            names: [
                "--add-header",
            ],
            description: Some("Specify a custom HTTP header and its value, separated by a colon ':'"),
            arguments: [
                (
                    name: "FIELD:VALUE",
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "--bidi-workaround",
            ],
            description: Some("Work around terminals that lack bidirectional text support. Requires bidiv or fribidi executable in PATH"),
        ),
        (
            names: [
                "--sleep-interval",
            ],
            description: Some("Number of seconds to sleep before each download when used alone or a lower bound of a range for randomized sleep before each download when used along with --max-sleep-interval"),
            arguments: [
                (
                    name: "SECONDS",
                ),
            ],
        ),
        (
            names: [
                "--max-sleep-interval",
            ],
            description: Some("Upper bound of a range for randomized sleep before each download. Must only be used along with --min- sleep-interval"),
            arguments: [
                (
                    name: "SECONDS",
                ),
            ],
            depends_on: [
                "--sleep-interval",
            ],
        ),
        (
            names: [
                "-f",
                "--format",
            ],
            description: Some("Video format code"),
            arguments: [
                (
                    name: "FORMAT",
                ),
            ],
        ),
        (
            names: [
                "--all-formats",
            ],
            description: Some("Download all available video formats"),
        ),
        (
            names: [
                "--prefer-free-formats",
            ],
            description: Some("Prefer free video formats unless a specific one is requested"),
        ),
        (
            names: [
                "-F",
                "--list-formats",
            ],
            description: Some("List all available formats of requested videos"),
        ),
        (
            names: [
                "--youtube-skip-dash-manifest",
            ],
            description: Some("Do not download the DASH manifests and related data on YouTube videos"),
        ),
        (
            names: [
                "--merge-output-format",
            ],
            description: Some("If a merge is required (e.g. bestvideo+bestaudio), output to given container format"),
            arguments: [
                (
                    name: "FORMAT",
                    suggestions: [
                        (
                            name: "mkv",
                        ),
                        (
                            name: "mp4",
                        ),
                        (
                            name: "ogg",
                        ),
                        (
                            name: "webm",
                        ),
                        (
                            name: "flv",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--write-sub",
            ],
            description: Some("Write subtitle file"),
        ),
        (
            names: [
                "--write-auto-sub",
            ],
            description: Some("Write automatically generated subtitle file (YouTube only)"),
        ),
        (
            names: [
                "--all-subs",
            ],
            description: Some("Download all the available subtitles of the video"),
        ),
        (
            names: [
                "--list-subs",
            ],
            description: Some("List all available subtitles for the video"),
        ),
        (
            names: [
                "--sub-format",
            ],
            description: Some("Subtitle format, accepts formats preference, for example: \"srt\" or \"ass/srt/best\""),
            arguments: [
                (
                    name: "FORMAT",
                ),
            ],
        ),
        (
            names: [
                "--sub-lang",
            ],
            description: Some("Languages of the subtitles to download (optional) separated by commas"),
            arguments: [
                (
                    name: "LANGS",
                    suggestions: [
                        (
                            name: "af",
                        ),
                        (
                            name: "sq",
                        ),
                        (
                            name: "am",
                        ),
                        (
                            name: "ar",
                        ),
                        (
                            name: "hy",
                        ),
                        (
                            name: "az",
                        ),
                        (
                            name: "bn",
                        ),
                        (
                            name: "eu",
                        ),
                        (
                            name: "be",
                        ),
                        (
                            name: "bs",
                        ),
                        (
                            name: "bg",
                        ),
                        (
                            name: "my",
                        ),
