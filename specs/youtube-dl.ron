        (
            names: [
                "-u",
                "--username",
            ],
            description: Some("Login with this account ID"),
            arguments: [
                (
                    name: "USERNAME",
                ),
            ],
        ),
        (
            names: [
                "-p",
                "--password",
            ],
            description: Some("Account password. If this option is left out, youtube-dl will ask interactively"),
            arguments: [
                (
                    name: "PASSWORD",
                ),
            ],
        ),
        (
            names: [
                "-2",
                "--twofactor",
            ],
            description: Some("Two-factor authentication code"),
            arguments: [
                (
                    name: "TWOFACTOR",
                ),
            ],
        ),
        (
            names: [
                "-n",
                "--netrc",
            ],
            description: Some("Use .netrc authentication data"),
        ),
        (
            names: [
                "--video-password",
            ],
            description: Some("Video password (vimeo, youku)"),
            arguments: [
                (
                    name: "PASSWORD",
                ),
            ],
        ),
        (
            names: [
                "--ap-mso",
            ],
            description: Some("Adobe Pass multiple-system operator (TV provider) identifier"),
            arguments: [
                (
                    name: "MSO",
                    generators: [
                        (
                            has_custom: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--ap-username",
            ],
            description: Some("Multiple-system operator account login"),
            arguments: [
                (
                    name: "USERNAME",
                ),
            ],
        ),
        (
            names: [
                "--ap-password",
            ],
            description: Some("Multiple-system operator account password. If this option is left out, youtube-dl will ask interactively"),
            arguments: [
                (
                    name: "PASSWORD",
                ),
            ],
        ),
        (
            names: [
                "--ap-list-mso",
            ],
            description: Some("List all supported multiple-system operators"),
        ),
        (
            names: [
                "-x",
                "--extract-audio",
            ],
            description: Some("Convert audio files to audio-only files (requires ffmpeg/avconv and ffprobe/avprobe)"),
        ),
        (
            names: [
                "--audio-format",
            ],
            description: Some("Specify audio format"),
            arguments: [
                (
                    name: "FORMAT",
                    suggestions: [
                        (
                            name: "best",
                        ),
                        (
                            name: "aac",
                        ),
                        (
                            name: "flac",
                        ),
                        (
                            name: "mp3",
                        ),
                        (
                            name: "m4a",
                        ),
                        (
                            name: "opus",
                        ),
                        (
                            name: "vorbis",
                        ),
                        (
                            name: "wav",
                        ),
                    ],
                    default: Some("best"),
                ),
            ],
            depends_on: [
                "-x",
            ],
        ),
        (
            names: [
                "--audio-quality",
            ],
            description: Some("Specify ffmpeg/avconv audio quality, insert a value between 0 (better) and 9 (worse) for VBR or a specific bitrate like 128K"),
            arguments: [
                (
                    name: "QUALITY",
                    default: Some("5"),
                ),
            ],
        ),
        (
            names: [
                "--recode-video",
            ],
            description: Some("Encode the video to another format if necessary"),
            arguments: [
                (
                    name: "FORMAT",
                    suggestions: [
                        (
                            name: "mp4",
                        ),
                        (
                            name: "flv",
                        ),
                        (
                            name: "ogg",
                        ),
                        (
                            name: "webm",
                        ),
                        (
                            name: "mkv",
                        ),
                        (
                            name: "avi",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--postprocessor-args",
            ],
            description: Some("Give these arguments to the postprocessor"),
            arguments: [
                (
                    name: "ARGS",
                ),
            ],
        ),
        (
            names: [
                "-k",
                "--keep-video",
            ],
            description: Some("Keep the video file on disk after the post-processing; the video is erased by default"),
        ),
        (
            names: [
                "--no-post-overwrites",
            ],
            description: Some("Do not overwrite post-processed files; the post-processed files are overwritten by default"),
        ),
        (
            names: [
                "--embed-subs",
            ],
            description: Some("Embed subtitles in the video (only for mp4, webm and mkv videos)"),
        ),
        (
            names: [
                "--embed-thumbnail",
            ],
            description: Some("Embed thumbnail in the audio as cover art"),
        ),
        (
            names: [
                "--embed-metadata",
            ],
            description: Some("Write metadata to the video file"),
        ),
        (
            names: [
                "--metadata-from-title",
            ],
            description: Some("Parse additional metadata like song title / artist from the video title. The format syntax is the same as --output. Regular expressions with named capture groups may also be used. The parsed parameters replace existing values"),
            arguments: [
                (
                    name: "FORMAT",
                ),
            ],
        ),
        (
            names: [
                "--xattrs",
            ],
            description: Some("Write metadata to the video file's xattrs (using dublin core and xdg standards)"),
        ),
        (
            names: [
                "--fixup",
            ],
            description: Some("Automatically correct known faults of the file"),
            arguments: [
                (
                    name: "POLICY",
                    suggestions: [
                        (
                            name: "never",
                            description: Some("Do nothing"),
                        ),
                        (
                            name: "warn",
                            description: Some("Only emit a warning"),
                        ),
                        (
                            name: "detect_or_warn",
                            description: Some("Fix file if we can, warn otherwise"),
                        ),
                    ],
                    default: Some("detect_or_warn"),
                ),
            ],
        ),
        (
            names: [
                "--prefer-avconv",
            ],
            description: Some("Prefer avconv over ffmpeg for running the postprocessors"),
        ),
        (
            names: [
                "--prefer-ffmpeg",
            ],
            description: Some("Prefer ffmpeg over avconv for running the postprocessors (default)"),
        ),
        (
            names: [
                "--ffmpeg-location",
            ],
            description: Some("Location of the ffmpeg/avconv binary; either the path to the binary or its containing directory"),
            arguments: [
                (
                    name: "PATH",
                    template: [
                        Folders,
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--exec",
            ],
            description: Some("Execute a command on the file after downloading and post-processing, similar to find's -exec syntax"),
            arguments: [
                (
                    name: "CMD",
                ),
            ],
        ),
        (
            names: [
                "--convert-subs",
            ],
            description: Some("Convert the subtitles to other format"),
            arguments: [
                (
                    name: "FORMAT",
                    suggestions: [
                        (
                            name: "srt",
                        ),
                        (
                            name: "ass",
                        ),
                        (
                            name: "vtt",
                        ),
                        (
                            name: "lrc",
                        ),
                    ],
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "URL",
            generators: [
                (
                    script: [
                        "pbpaste",
                    ],
                    has_post_process: true,
                ),
            ],
            variadic: true,
        ),
    ],
