(
    version: 1,
    command: "vercel",
    description: Some("CLI Interface for Vercel.com"),
    subcommands: [
        (
            name: "deploy",
            description: Some("Performs a deployment (default)"),
            arguments: [
                (
                    name: "",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            name: "dev",
            description: Some("Start a local development server"),
            options: [
                (
                    names: [
                        "--listen",
                    ],
                    description: Some("Specifies which port to run on"),
                ),
            ],
        ),
        (
            name: "env",
            description: Some("Manages the Environment Variables for your current Project"),
            subcommands: [
                (
                    name: "add",
                    description: Some("Add an environment variable"),
                    arguments: [
                        (
                            name: "name",
                            description: Some("Name of the env variable to add"),
                        ),
                        (
                            name: "environment",
                            description: Some("Environment to add the variable to"),
                            suggestions: [
                                (
                                    name: "production",
                                    presentation: (
                                        icon: Some("🔵"),
                                    ),
                                ),
                                (
                                    name: "preview",
                                    presentation: (
                                        icon: Some("🟠"),
                                    ),
                                ),
                                (
                                    name: "development",
                                    presentation: (
                                        icon: Some("🟡"),
                                    ),
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "rm",
                    description: Some("Remove an environment variable"),
                    arguments: [
                        (
                            name: "name",
                            description: Some("Name of the variable to remove"),
                        ),
                        (
                            name: "environment",
                            description: Some("Environment to remove from"),
                            suggestions: [
                                (
                                    name: "production",
                                    presentation: (
                                        icon: Some("🔵"),
                                    ),
                                ),
                                (
                                    name: "preview",
                                    presentation: (
                                        icon: Some("🟠"),
                                    ),
                                ),
                                (
                                    name: "development",
                                    presentation: (
                                        icon: Some("🟡"),
                                    ),
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "pull",
                    description: Some("Download dev env variables from cloud and write to .env"),
                    arguments: [
                        (
                            name: "file",
                            description: Some("The file to write downloaded variables to"),
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    name: "ls",
                    description: Some("List environment variables for a specific environment"),
                    arguments: [
                        (
                            name: "environment",
                            description: Some("Environment to list variables for"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "init",
            description: Some("Initialize an example project"),
            arguments: [
                (
                    name: "project name",
                    description: Some("Project name to initialize locally"),
                ),
                (
                    name: "new project name",
                    description: Some("Initialize specific project locally and rename directory"),
                ),
            ],
        ),
        (
            name: "list",
            description: Some("Lists deployments"),
            options: [
                (
                    names: [
                        "-m",
                        "--meta",
                    ],
                    description: Some("Filters results based on project metadata"),
                    arguments: [
                        (
                            name: "",
                            variadic: true,
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "project name",
                    description: Some("View deployments for specified project"),
                ),
            ],
        ),
        (
            name: "ls",
            description: Some("Lists deployments"),
            arguments: [
                (
                    name: "project name",
                    description: Some("View deployments for specified project"),
                ),
            ],
        ),
        (
            name: "inspect",
            description: Some("Displays information related to a deployment"),
            arguments: [
                (
                    name: "url",
                    description: Some("The URL of the deployment to inspect"),
                ),
            ],
        ),
        (
            name: "login",
            description: Some("Logs into your account or creates a new one"),
        ),
        (
            name: "logout",
            description: Some("Logs out of your account"),
        ),
        (
            name: "switch",
            description: Some("Switches between teams and your personal account"),
            arguments: [
                (
                    name: "team name",
                    description: Some("Team to switch to"),
                ),
            ],
        ),
        (
            name: "help",
            description: Some("Displays complete help for [cmd]"),
            arguments: [
                (
                    name: "command",
                    description: Some("Command to detailed information about"),
                ),
            ],
        ),
        (
            name: "rm",
            description: Some("Removes a deployment"),
            options: [
                (
                    names: [
                        "-s",
                        "--safe",
                    ],
                    description: Some("Skip removal of deployments with an active preview URL or production domain"),
                ),
                (
                    names: [
                        "-y",
                        "--yes",
                    ],
                    description: Some("Skip confirmation step for a deployment or project removal"),
                ),
            ],
            arguments: [
                (
                    name: "deployment url",
                    description: Some("URL of the deployment to remove"),
                ),
            ],
        ),
        (
            name: "remove",
            description: Some("Removes a deployment"),
            arguments: [
                (
                    name: "deployment url",
                    description: Some("URL of the deployment to remove"),
                ),
            ],
        ),
        (
            name: "domains",
            description: Some("Manages your domain names"),
            subcommands: [
                (
                    name: "ls",
                    description: Some("List all domains under an account"),
                ),
                (
                    name: "inspect",
                    description: Some("Retrieves information about a domain"),
                    arguments: [
                        (
                            name: "domain",
                            description: Some("Domain to inspect"),
                        ),
                    ],
                ),
                (
                    name: "add",
                    description: Some("Add a domain to an account"),
                    arguments: [
                        (
                            name: "domain",
                            description: Some("Domain to add"),
                        ),
                    ],
                ),
                (
                    name: "rm",
                    description: Some("Removes a domain from an account"),
                    arguments: [
                        (
                            name: "domain",
                            description: Some("Domain to remove"),
                        ),
                    ],
                ),
                (
                    name: "buy",
                    description: Some("Buy a domain for an account"),
                    arguments: [
                        (
                            name: "domain",
                            description: Some("Domain to buy"),
                        ),
                    ],
                ),
                (
                    name: "move",
                    description: Some("Removes a domain from an account"),
                    arguments: [
                        (
                            name: "domain",
                            description: Some("Domain to move"),
                        ),
                        (
                            name: "account name",
                            description: Some("Account to move the domain to"),
                        ),
                    ],
                ),
                (
                    name: "transfer-in",
                    description: Some("Transfers in a domain to an account"),
                    arguments: [
                        (
                            name: "domain",
                            description: Some("Domain to transfer in"),
                        ),
                    ],
                ),
                (
                    name: "verify",
                    description: Some("Verifies a domain for an account"),
                    arguments: [
                        (
                            name: "domain",
                            description: Some("Domain to verify"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "dns",
            description: Some("Manages your DNS records"),
            subcommands: [
                (
                    name: "add",
                    description: Some("Add DNS record for a domain"),
                    arguments: [
                        (
                            name: "domain",
                            description: Some("Domain to add record to"),
                        ),
                        (
                            name: "subdomain",
                            description: Some("Subdomain to add record to"),
                        ),
                        (
                            name: "record type",
                            description: Some("Type of record to add"),
                            suggestions: [
                                (
                                    name: "A",
                                    description: Some("A record"),
                                ),
                                (
                                    name: "AAAA",
                                    description: Some("AAAA record"),
                                ),
                                (
                                    name: "ALIAS",
                                    description: Some("ALIAS record"),
                                ),
                                (
                                    name: "CNAME",
                                    description: Some("CName record"),
                                ),
                                (
                                    name: "TXT",
                                    description: Some("TXT record"),
                                ),
                            ],
                        ),
                        (
                            name: "value",
                            description: Some("Record value"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "certs",
            description: Some("Manages your SSL certificates"),
            subcommands: [
                (
                    name: "ls",
                    description: Some("List all certificates under an account"),
                ),
                (
                    name: "issue",
                    description: Some("Issue certificates for multiple domains"),
                    arguments: [
                        (
                            name: "Domains",
                            description: Some("List of domains separated by commas to issue certificates for"),
                            variadic: true,
                        ),
                    ],
                ),
                (
                    name: "rm",
                    description: Some("Remove a certificate by id"),
                    arguments: [
                        (
                            name: "certificate id",
                            description: Some("Id of the certificate to remove"),
                        ),
                    ],
                ),
            ],
            options: [
                (
                    names: [
                        "--challenge-only",
                    ],
                    description: Some("Show challenges needed to issue a certificate"),
                ),
                (
                    names: [
                        "--crt",
                    ],
                    description: Some("Include path to .crt"),
                    arguments: [
                        (
                            name: "",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--key",
                    ],
                    description: Some("Include path to .key"),
                    arguments: [
                        (
                            name: "",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--ca",
                    ],
                    description: Some("Include path to .ca"),
                    arguments: [
                        (
                            name: "",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "secrets",
            description: Some("Manages your global Secrets, for use in Environment Variables"),
            subcommands: [
                (
                    name: "list",
                    description: Some("List all secrets"),
                ),
                (
                    name: "add",
                    description: Some("Add a new secret"),
                    arguments: [
                        (
                            name: "secret name",
                            description: Some("Name of the secret to add"),
                        ),
                        (
                            name: "secret value",
                            description: Some("Value of the secret to add"),
                        ),
                    ],
                ),
                (
                    name: "rename",
                    description: Some("Rename a secret"),
                    arguments: [
                        (
                            name: "old name",
                            description: Some("Old name of the secret to rename"),
                        ),
                        (
                            name: "new name",
                            description: Some("New name of the secret"),
                        ),
                    ],
                ),
                (
                    name: "remove",
                    description: Some("Remove a secret"),
                    arguments: [
                        (
                            name: "secret name",
                            description: Some("Name of the seret to remove"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "logs",
            description: Some("Displays the logs for a deployment"),
            options: [
                (
                    names: [
                        "-a",
                        "--all",
                    ],
                    description: Some("Receive access logs in addition to regular logs"),
                ),
                (
                    names: [
                        "-f",
                        "--follow",
                    ],
                    description: Some("Watch for additional logs output"),
                ),
                (
                    names: [
                        "-n",
                        "--number",
                    ],
                    description: Some("Specify number of log lines to output"),
                    arguments: [
                        (
                            name: "",
                        ),
                    ],
                ),
                (
                    names: [
                        "-o",
                        "--output",
                    ],
                    description: Some("Specifies format of logs output as 'short' or 'raw'"),
                    arguments: [
                        (
                            name: "",
                        ),
                    ],
                ),
                (
                    names: [
                        "--since",
                    ],
                    description: Some("Return logs after a specific ISO 8601 date"),
                    arguments: [
                        (
                            name: "",
                        ),
                    ],
                ),
                (
                    names: [
                        "-q",
                        "--query",
                    ],
                    description: Some("Return logs against a search query"),
                    arguments: [
                        (
                            name: "",
                        ),
                    ],
                ),
                (
                    names: [
                        "--until",
                    ],
                    description: Some("Return logs up to a specific ISO 8601 date"),
                    arguments: [
                        (
                            name: "",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "deployment url",
                    description: Some("Get logs for specified deployment"),
                ),
            ],
        ),
        (
            name: "teams",
            description: Some("Manages your teams"),
            subcommands: [
                (
                    name: "list",
                    description: Some("List all teams under an account"),
                ),
                (
                    name: "add",
                    description: Some("Create a new team"),
                ),
                (
                    name: "invite",
                    description: Some("Invite a new member to the team"),
                    arguments: [
                        (
                            name: "email",
                            description: Some("Email of member to invite to team"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "whoami",
            description: Some("Shows the username of the currently logged in user"),
        ),
        (
            name: "alias",
            description: Some("Apply custom domains based on git branches, or other heuristics"),
            subcommands: [
                (
                    name: "set",
                    description: Some("Assign a custom domain to a deployment"),
                    arguments: [
                        (
                            name: "url",
                            description: Some("The URL of the deployment to assign to a domain"),
                        ),
                        (
                            name: "domain",
                            description: Some("The domain you want to assign to"),
                        ),
                    ],
                ),
                (
                    name: "rm",
                    description: Some("Remove a custom domain from a deployment"),
                    arguments: [
                        (
                            name: "domain",
                            description: Some("The domain to remove"),
                        ),
                    ],
                ),
                (
                    name: "ls",
                    description: Some("List custom domains that were assigned to deployments"),
                ),
            ],
        ),
        (
            name: "link",
            description: Some("Links your local directory to a Project"),
            arguments: [
                (
                    name: "directory",
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "billing",
            description: Some("Manage payment methods"),
            subcommands: [
                (
                    name: "ls",
                    description: Some("List all the payment methods of the active account"),
                ),
                (
                    name: "add",
                    description: Some("Interactively add a new credit card"),
                ),
                (
                    name: "rm",
                    description: Some("Remove a credit card by ID"),
                    arguments: [
                        (
                            name: "id",
                            description: Some("The id of the card to remove"),
                        ),
                    ],
                ),
                (
                    name: "set-default",
                    description: Some("Select which credit card should be default"),
                    arguments: [
                        (
                            name: "id",
                            description: Some("The id of the card to set default"),
                        ),
                    ],
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Output usage information"),
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Output the version number"),
        ),
        (
            names: [
                "-V",
                "--platform-version",
            ],
            description: Some("Set the platform version to deploy to"),
        ),
        (
            names: [
                "-A",
                "--local-config",
            ],
            description: Some("Path to the local 'vercel.json' file"),
            arguments: [
                (
                    name: "",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-Q",
                "--global-config",
            ],
            description: Some("Path to the global '.vercel' directory"),
            arguments: [
                (
                    name: "",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-d",
                "--debug",
            ],
            description: Some("Provides more verbose output"),
        ),
        (
            names: [
                "-f",
                "--force",
            ],
            description: Some("Force a new deployment even if nothing has changed"),
        ),
        (
            names: [
                "-with-cache",
            ],
            description: Some("Retain build cache when using --force"),
        ),
        (
            names: [
                "-t",
                "--token",
            ],
            description: Some("Execute command with an auth token"),
            arguments: [
                (
                    name: "auth token",
                    description: Some("Auth token to add to your command"),
                ),
            ],
        ),
        (
            names: [
                "-p",
                "--public",
            ],
            description: Some("Deployment is public ('/_src' is exposed)"),
        ),
        (
            names: [
                "-e",
                "--env",
            ],
            description: Some("Include an env var during run time (e.g.: '-e KEY=value'). Can appear many times"),
        ),
        (
            names: [
                "-b",
                "--build-env",
            ],
            description: Some("Similar to `--env` but for build time only"),
        ),
        (
            names: [
                "-m",
                "--meta",
            ],
            description: Some("Add metadata for the deployment (e.g.: `-m KEY=value`). Can appear many times"),
        ),
        (
            names: [
                "-C",
                "--no-clipboard",
            ],
            description: Some("Do not attempt to copy URL to clipboard"),
        ),
        (
            names: [
                "-S",
                "--scope",
            ],
            description: Some("Set a custom scope"),
            arguments: [
                (
                    name: "team name",
                    description: Some("Team to execute commands from"),
                ),
            ],
        ),
        (
            names: [
                "--regions",
            ],
            description: Some("Set default regions to enable the deployment on"),
        ),
        (
            names: [
                "--prod",
            ],
            description: Some("Create a production deployment"),
        ),
        (
            names: [
                "-c",
                "--confirm",
            ],
            description: Some("Confirm default options and skip questions"),
        ),
    ],
    arguments: [
        (
            name: "path to project",
            template: [
                Folders,
            ],
        ),
    ],
)
