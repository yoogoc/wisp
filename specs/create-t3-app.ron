(
    version: 1,
    command: "create-t3-app",
    description: Some("A CLI for creating web applications with the t3 stack"),
    options: [
        (
            names: [
                "--noGit",
            ],
            description: Some("Explicitly tell the CLI to not initialize a new git repo in the project (default: false)"),
        ),
        (
            names: [
                "--noInstall",
            ],
            description: Some("Explicitly tell the CLI to not run the package manager's install command (default: false)"),
        ),
        (
            names: [
                "-y",
                "--default",
            ],
            description: Some("Bypass the CLI and use all default options to bootstrap a new t3-app (default: false)"),
            presentation: (
                priority: Some(76.0),
            ),
        ),
        (
            names: [
                "--CI",
            ],
            description: Some("Boolean value if we're running in CI (default: false)"),
            presentation: (
                priority: Some(49.0),
            ),
        ),
        (
            names: [
                "--tailwind",
            ],
            description: Some("Experimental: Boolean value if we should install Tailwind CSS. Must be used in conjunction with `--CI`"),
            arguments: [
                (
                    name: "boolean",
                    suggestions: [
                        (
                            name: "true",
                            description: Some("Install Tailwind CSS"),
                        ),
                        (
                            name: "false",
                            description: Some("Do not install Tailwind CSS"),
                        ),
                    ],
                ),
            ],
            depends_on: [
                "--CI",
            ],
            presentation: (
                priority: Some(49.0),
            ),
        ),
        (
            names: [
                "--nextAuth",
            ],
            description: Some("Experimental: Boolean value if we should install NextAuth.js. Must be used in conjunction with `--CI`"),
            arguments: [
                (
                    name: "boolean",
                    suggestions: [
                        (
                            name: "true",
                            description: Some("Install NextAuth.js"),
                        ),
                        (
                            name: "false",
                            description: Some("Do not install NextAuth.js"),
                        ),
                    ],
                ),
            ],
            depends_on: [
                "--CI",
            ],
            presentation: (
                priority: Some(49.0),
            ),
        ),
        (
            names: [
                "--prisma",
            ],
            description: Some("Experimental: Boolean value if we should install Prisma. Must be used in conjunction with `--CI`"),
            arguments: [
                (
                    name: "boolean",
                    suggestions: [
                        (
                            name: "true",
                            description: Some("Install Prisma"),
                        ),
                        (
                            name: "false",
                            description: Some("Do not install Prisma"),
                        ),
                    ],
                ),
            ],
            depends_on: [
                "--CI",
            ],
            presentation: (
                priority: Some(49.0),
            ),
        ),
        (
            names: [
                "--trpc",
            ],
            description: Some("Experimental: Boolean value if we should install tRPC. Must be used in conjunction with `--CI`"),
            arguments: [
                (
                    name: "boolean",
                    suggestions: [
                        (
                            name: "true",
                            description: Some("Install tRPC"),
                        ),
                        (
                            name: "false",
                            description: Some("Do not install tRPC"),
                        ),
                    ],
                ),
            ],
            depends_on: [
                "--CI",
            ],
            presentation: (
                priority: Some(49.0),
            ),
        ),
        (
            names: [
                "-i",
                "--import-alias",
            ],
            description: Some("Explicitly tell the CLI to use a custom import alias"),
            arguments: [
                (
                    name: "alias",
                    suggestions: [
                        (
                            name: "~/",
                            description: Some("Use the ~/ alias"),
                        ),
                        (
                            name: "@/",
                            description: Some("Use the @/ alias"),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Display the version number"),
        ),
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Display help for command"),
        ),
    ],
    arguments: [
        (
            name: "dir",
            description: Some("The name of the application, as well as the name of the directory to create"),
            template: [
                Folders,
            ],
            optional: true,
            suggest_current_token: true,
        ),
    ],
    presentation: (
        icon: Some("https://create.t3.gg/favicon.svg"),
    ),
)
