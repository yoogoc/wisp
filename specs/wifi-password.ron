(
    version: 1,
    command: "wifi-password",
    description: Some("People ask you for the Wi-Fi password. Answer quickly. macOS only"),
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for wifi-password"),
        ),
        (
            names: [
                "--quiet",
                "-q",
            ],
            description: Some("Only output the password"),
        ),
        (
            names: [
                "--version",
                "-V",
            ],
            description: Some("Output version"),
        ),
    ],
    arguments: [
        (
            name: "SSID",
            description: Some("The name for a Wi-Fi network"),
            generators: [
                (
                    script: [
                        "bash",
                        "-c",
                        "networksetup -listallhardwareports | awk '/Wi-Fi/{getline; print $2}' | xargs networksetup -listpreferredwirelessnetworks",
                    ],
                    has_post_process: true,
                ),
            ],
        ),
    ],
)
