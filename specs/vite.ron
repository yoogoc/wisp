(
    version: 1,
    command: "vite",
    description: Some("Native ESM-powered web dev build tool"),
    subcommands: [
        (
            name: "build",
            description: Some("Build for production"),
            options: [
                (
                    names: [
                        "--target",
                    ],
                    description: Some("Transpile target (must be a valid esbuild target)"),
                    arguments: [
                        (
                            name: "target",
                        ),
                    ],
                ),
                (
                    names: [
                        "--outDir",
                    ],
                    description: Some("Output directory"),
                    arguments: [
                        (
                            name: "dir",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--assetsDir",
                    ],
                    description: Some("Directory under outDir to place assets in"),
                    arguments: [
                        (
                            name: "dir",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--assetsInlineLimit",
                    ],
                    description: Some("Static asset base64 inline threshold in bytes"),
                    arguments: [
                        (
                            name: "number",
                        ),
                    ],
                ),
                (
                    names: [
                        "--ssr",
                    ],
                    description: Some("Build specified entry for server-side rendering"),
                    arguments: [
                        (
                            name: "entry",
                            template: [
                                FilePaths,
                            ],
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--sourcemap",
                    ],
                    description: Some("Output sourcemaps for build"),
                ),
                (
                    names: [
                        "--minify",
                    ],
                    description: Some("Enable minification"),
                    arguments: [
                        (
                            name: "minifier",
                            suggestions: [
                                (
                                    name: "terser",
                                ),
                                (
                                    name: "esbuild",
                                ),
                            ],
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--manifest",
                    ],
                    description: Some("Emit build manifest json"),
                    arguments: [
                        (
                            name: "name",
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--ssrManifest",
                    ],
                    description: Some("Emit ssr manifest json"),
                    arguments: [
                        (
                            name: "name",
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--emptyOutDir",
                    ],
                    description: Some("Force empty outDir when it's outside of root"),
                ),
                (
                    names: [
                        "-w",
                        "--watch",
                    ],
                    description: Some("Rebuilds when modules have changed on disk"),
                ),
            ],
            arguments: [
                (
                    name: "root",
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                icon: Some("🛠"),
            ),
        ),
        (
            name: "optimize",
            description: Some("Pre-bundle dependencies"),
            options: [
                (
                    names: [
                        "--force",
                    ],
                    description: Some("For the optimizer to re-bundle"),
                ),
            ],
            arguments: [
                (
                    name: "root",
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                icon: Some("📦"),
            ),
        ),
        (
            name: "preview",
            description: Some("Locally preview the production build"),
            options: [
                (
                    names: [
                        "--host",
                    ],
                    description: Some("Specify the hostname"),
                    arguments: [
                        (
                            name: "host",
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--port",
                    ],
                    description: Some("Specify the port"),
                    arguments: [
                        (
                            name: "port",
                        ),
                    ],
                ),
                (
                    names: [
                        "--https",
                    ],
                    description: Some("Use TLS + HTTP/2"),
                ),
                (
                    names: [
                        "--open",
                    ],
                    description: Some("Open browser on startup"),
                    arguments: [
                        (
                            name: "browser",
                            template: [
                                FilePaths,
                            ],
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--strictPort",
                    ],
                    description: Some("Exit if the port is already in use"),
                ),
            ],
            arguments: [
                (
                    name: "root",
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                icon: Some("✨"),
            ),
        ),
    ],
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Show help message"),
            persistent: true,
        ),
        (
            names: [
                "--host",
            ],
            description: Some("Specify the hostname"),
            arguments: [
                (
                    name: "host",
                    optional: true,
                ),
            ],
        ),
        (
            names: [
                "--port",
            ],
            description: Some("Specify the port"),
            arguments: [
                (
                    name: "port",
                ),
            ],
        ),
        (
            names: [
                "--https",
            ],
            description: Some("Use TLS + HTTP/2"),
        ),
        (
            names: [
                "--open",
            ],
            description: Some("Open browser on startup"),
            arguments: [
                (
                    name: "browser",
                    template: [
                        FilePaths,
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            names: [
                "--cors",
            ],
            description: Some("Enable CORS"),
        ),
        (
            names: [
                "--strictPort",
            ],
            description: Some("Exit if the port is already in use"),
        ),
        (
            names: [
                "--force",
            ],
            description: Some("For the optimizer to re-bundle"),
        ),
        (
            names: [
                "-c",
                "--config",
            ],
            description: Some("Use the specified config file"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--base",
            ],
            description: Some("Public base path"),
            arguments: [
                (
                    name: "path",
                    default: Some("/"),
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "-l",
                "--logLevel",
            ],
            description: Some("Set the log level"),
            arguments: [
                (
                    name: "level",
                    suggestions: [
                        (
                            name: "info",
                            presentation: (
                                icon: Some("💬"),
                            ),
                        ),
                        (
                            name: "warn",
                            presentation: (
                                icon: Some("⚠️"),
                            ),
                        ),
                        (
                            name: "error",
                            presentation: (
                                icon: Some("💥"),
                            ),
                        ),
                        (
                            name: "silent",
                            presentation: (
                                icon: Some("🤫"),
                            ),
                        ),
                    ],
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--clearScreen",
            ],
            description: Some("Enable screen clearing when logging"),
            persistent: true,
        ),
        (
            names: [
                "-d",
                "--debug",
            ],
            description: Some("Show debug logs"),
            arguments: [
                (
                    name: "feat",
                    optional: true,
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "-f",
                "--filter",
            ],
            description: Some("Filter debug logs"),
            arguments: [
                (
                    name: "filter",
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "-m",
                "--mode",
            ],
            description: Some("Set env mode"),
            arguments: [
                (
                    name: "mode",
                    generators: [
                        (
                            script: [
                                "ls",
                                "-l1A",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Display version number"),
        ),
    ],
    arguments: [
        (
            name: "root",
            template: [
                Folders,
            ],
            optional: true,
        ),
    ],
    presentation: (
        icon: Some("https://vitejs.dev/logo.svg"),
    ),
)
