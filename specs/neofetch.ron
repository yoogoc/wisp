(
    version: 1,
    command: "neofetch",
    description: Some("The most complete system information CLI tool"),
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for neofetch"),
        ),
        (
            names: [
                "--disable",
            ],
            description: Some("Disable information line"),
            arguments: [
                (
                    name: "Information lines",
                    suggestions: [
                        (
                            name: "os",
                        ),
                        (
                            name: "host",
                        ),
                        (
                            name: "kernel",
                        ),
                        (
                            name: "uptime",
                        ),
                        (
                            name: "packages",
                        ),
                        (
                            name: "shell",
                        ),
                        (
                            name: "term",
                        ),
                        (
                            name: "cpu",
                        ),
                        (
                            name: "gpu",
                        ),
                        (
                            name: "memory",
                        ),
                        (
                            name: "disk",
                        ),
                        (
                            name: "battery",
                        ),
                        (
                            name: "resolution",
                        ),
                        (
                            name: "wm",
                        ),
                        (
                            name: "de",
                        ),
                        (
                            name: "theme",
                        ),
                        (
                            name: "wm_theme",
                        ),
                        (
                            name: "icons",
