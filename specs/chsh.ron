(
    version: 1,
    command: "chsh",
    description: Some("Change your login shell"),
    options: [
        (
            names: [
                "-s",
                "--shell",
            ],
            description: Some("Specify login shell"),
            arguments: [
                (
                    name: "shell",
                    generators: [
                        (
                            script: [
                                "chsh",
                                "-l",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-l",
                "--list-shells",
            ],
            description: Some("Print list of shells and exit"),
        ),
        (
            names: [
                "-u",
                "-h",
                "--help",
            ],
            description: Some("Print help message and exit"),
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Print version and exit"),
        ),
    ],
    arguments: [
        (
            name: "username",
            description: Some("Target user"),
            optional: true,
        ),
    ],
)
