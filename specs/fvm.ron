(
    version: 1,
    command: "fvm",
    description: Some("Flutter Version Management: A cli to manage Flutter SDK versions"),
    subcommands: [
        (
            name: "config",
            description: Some("Set configuration for FVM"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Print this usage information"),
                ),
                (
                    names: [
                        "-c",
                        "--cache-path",
                    ],
                    description: Some("Set the path which FVM will cache the version. Priority over FVM_HOME"),
                    arguments: [
                        (
                            name: "path",
                            description: Some("Path to the Flutter versions cache"),
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-s",
                        "--skip-setup",
                        "--no-skip-setup",
                    ],
                    description: Some("Skip setup after a version install"),
                ),
                (
                    names: [
                        "-g",
                        "--git-cache",
                        "--no-git-cache",
                    ],
                    description: Some("ADVANCED: Will cache a local version of Flutter repo for faster version install"),
                ),
            ],
        ),
        (
            name: "dart",
            description: Some("Proxies Dart commands"),
        ),
        (
            name: "doctor",
            description: Some("Shows information about environment, and project configuration"),
        ),
        (
            name: "flavor",
            description: Some("Switches between different project flavors"),
            arguments: [
                (
                    name: "flavor-name",
                    description: Some("The flavor to switch to"),
                ),
            ],
        ),
        (
            name: "flutter",
            description: Some("Proxies Flutter commands"),
            load_spec: Some("flutter"),
        ),
        (
            name: "global",
            description: Some("Sets Flutter SDK version as global"),
            arguments: [
                (
                    name: "version",
                    description: Some("Flutter SDK to set for global flutter command"),
                ),
            ],
        ),
        (
            name: "install",
            description: Some("Installs Flutter SDK version"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Print this usage information"),
                ),
                (
                    names: [
                        "-s",
                        "--skip-setup",
                    ],
                    description: Some("Skips Flutter setup after install"),
                ),
            ],
            arguments: [
                (
                    name: "version",
                    suggestions: [
                        (
                            name: "stable",
                            description: Some("Latest stable release of Flutter"),
                            presentation: (
                                priority: Some(100.0),
                            ),
                        ),
                        (
                            name: "beta",
                            description: Some("Latest beta release of Flutter"),
                            presentation: (
                                priority: Some(99.0),
                            ),
                        ),
                        (
                            name: "dev",
                            description: Some("Latest dev release of Flutter (master)"),
                            presentation: (
                                priority: Some(98.0),
                            ),
                        ),
                    ],
                    generators: [
                        (
                            script: [
                                "fvm",
                                "releases",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "list",
            description: Some("Lists installed Flutter SDK versions"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Print this usage information"),
                ),
            ],
        ),
        (
            name: "releases",
            description: Some("View all Flutter SDK releases available for install"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Print this usage information"),
                ),
            ],
        ),
        (
            name: "remove",
            description: Some("Removes Flutter SDK version"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Print this usage information"),
                ),
                (
                    names: [
                        "--force",
                    ],
                    description: Some("Skips version global check"),
                ),
            ],
            arguments: [
                (
                    name: "version",
                    description: Some("The installed Flutter version to remove"),
                ),
            ],
        ),
        (
            name: "spawn",
            description: Some("Spawn a Flutter SDK version command"),
            arguments: [
                (
                    name: "version",
                    description: Some("The Flutter version from which to spawn a command"),
                ),
            ],
        ),
        (
            name: "use",
            description: Some("Sets a Flutter SDK version to be used in a project"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Print this usage information"),
                ),
                (
                    names: [
                        "-f",
                        "--force",
                    ],
                    description: Some("Skips command guards that does Flutter project checks"),
                ),
                (
                    names: [
                        "-p",
                        "--pin",
                    ],
                    description: Some("If version provided is a channel. Will pin the latest release of the channel"),
                ),
                (
                    names: [
                        "--flavor",
                    ],
                    description: Some("Sets version for a project flavor"),
                ),
            ],
            arguments: [
                (
                    name: "version",
                    description: Some("The Flutter SDK version to use"),
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Print this usage information"),
        ),
        (
            names: [
                "--verbose",
            ],
            description: Some("Print verbose output"),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Current FVM version"),
        ),
    ],
)
