(
    version: 1,
    command: "make",
    options: [
        (
            names: [
                "-j",
            ],
            arguments: [
                (
                    name: "number",
                ),
                (
                    name: "target",
                    generators: [
                        (
                            has_custom: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--file",
                "-f",
                "--makefile",
            ],
            description: Some("Read FILE as a makefile"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-C",
                "--directory",
            ],
            description: Some("Change to DIRECTORY before doing anything"),
            arguments: [
                (
                    name: "directory",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-B",
                "--always-make",
            ],
            description: Some("Unconditionally make all targets"),
            arguments: [
                (
                    name: "target",
                    generators: [
                        (
                            has_custom: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-e",
                "--environment-overrides",
            ],
            description: Some("Environment variables override makefiles"),
            arguments: [
                (
                    name: "target",
                    generators: [
                        (
                            has_custom: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Print this message and exit"),
        ),
        (
            names: [
                "-i",
                "--ignore-errors",
            ],
            description: Some("Ignore errors from commands"),
        ),
        (
            names: [
                "-k",
                "--keep-going",
            ],
            description: Some("Keep going when some targets can't be made"),
        ),
        (
            names: [
                "-L",
                "--check-symlink-times",
            ],
            description: Some("Use the latest mtime between symlinks and target"),
        ),
        (
            names: [
                "-p",
                "--print-data-base",
            ],
            description: Some("Print make's internal database"),
        ),
        (
            names: [
                "-q",
                "--question",
            ],
            description: Some("Run no commands; exit status says if up to date"),
        ),
        (
            names: [
                "-r",
                "--no-builtin-rules",
            ],
            description: Some("Disable the built-in implicit rules"),
        ),
        (
            names: [
                "-R",
                "--no-builtin-variables",
            ],
            description: Some("Disable the built-in variable settings"),
        ),
        (
            names: [
                "-t",
                "--touch",
            ],
            description: Some("Touch targets instead of remaking them"),
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Print the version number of make and exit"),
        ),
        (
            names: [
                "-w",
                "--print-directory",
            ],
            description: Some("Print the current directory"),
        ),
        (
            names: [
                "-d",
            ],
            description: Some("Print lots of debugging information"),
        ),
        (
            names: [
                "--debug",
            ],
            description: Some("Print various types of debugging information"),
        ),
        (
            names: [
                "-I",
                "--include-dir",
            ],
            description: Some("Search directory for included makefiles"),
            arguments: [
                (
                    name: "directory",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-l",
                "--load-average",
            ],
            description: Some("Don't start multiple jobs unless load is below N"),
            arguments: [
                (
                    name: "N",
                    optional: true,
                ),
            ],
        ),
        (
            names: [
                "-o",
                "--old-file",
            ],
            description: Some("Consider file to be very old and don't remake it"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--no-print-directory",
            ],
            description: Some("Turn off -w, even if it was turned on implicitly"),
        ),
        (
            names: [
                "-W",
                "--what-if",
                "--new-file",
                "--assume-new",
            ],
            description: Some("Consider file to be infinitely new"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--warn-undefined-variables",
            ],
            description: Some("Warn when an undefined variable is referenced"),
        ),
        (
            names: [
                "-N",
                "--Next-option",
            ],
            description: Some("Turn on value of next option"),
            arguments: [
                (
                    name: "option",
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "target",
            generators: [
                (
                    has_custom: true,
                ),
            ],
        ),
    ],
)
