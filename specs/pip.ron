                        "--requirement",
                    ],
                    description: Some("Install from the given requirements file. This option can be used multiple times"),
                    repeat: Many,
                ),
                (
                    names: [
                        "--no-deps",
                    ],
                    description: Some("Don’t install package dependencies"),
                ),
                (
                    names: [
                        "--global-option",
                    ],
                    description: Some("Extra global options to be supplied to the setup.py call before the install command"),
                ),
                (
                    names: [
                        "--no-binary",
                    ],
