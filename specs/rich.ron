(
    version: 1,
    command: "rich",
    description: Some("Rich text and formatting in the terminal"),
    options: [
        (
            names: [
                "-p",
                "--print",
            ],
            description: Some("Print console markup. See https://rich.readthedocs.io/en/latest/markup.html"),
        ),
        (
            names: [
                "-u",
                "--rule",
            ],
            description: Some("Display a horizontal rule"),
        ),
        (
            names: [
                "-j",
                "--json",
            ],
            description: Some("Display as JSON"),
        ),
        (
            names: [
                "-m",
                "--markdown",
            ],
            description: Some("Display as markdown"),
        ),
        (
            names: [
                "--rst",
            ],
            description: Some("Display restructured text"),
        ),
        (
            names: [
                "--csv",
            ],
            description: Some("Display CSV as a table"),
        ),
        (
            names: [
                "--ipynb",
            ],
            description: Some("Display Jupyter notebook"),
        ),
        (
            names: [
                "--syntax",
            ],
            description: Some("Syntax highlighting"),
        ),
        (
            names: [
                "--inspect",
            ],
            description: Some("Inspect a python object"),
        ),
        (
            names: [
                "-h",
                "--head",
            ],
            description: Some("Display first LINES of the file"),
            arguments: [
                (
                    name: "lines",
                ),
            ],
            depends_on: [
                "--syntax",
                "--csv",
            ],
        ),
        (
            names: [
                "-t",
                "--tail",
            ],
            description: Some("Display last LINES of the file"),
            arguments: [
                (
                    name: "lines",
                ),
            ],
            depends_on: [
                "--syntax",
                "--csv",
            ],
        ),
        (
            names: [
                "--emoji",
            ],
            description: Some("Enable emoji code. e.g. :sparkle:"),
        ),
        (
            names: [
                "-l",
                "--left",
            ],
            description: Some("Align to left"),
        ),
        (
            names: [
                "-r",
                "--right",
            ],
            description: Some("Align to right"),
        ),
        (
            names: [
                "-c",
                "--center",
            ],
            description: Some("Align to center"),
        ),
        (
            names: [
                "-L",
                "--text-left",
            ],
            description: Some("Justify text to left"),
        ),
        (
            names: [
                "-R",
                "--text-right",
            ],
            description: Some("Justify text to right"),
        ),
        (
            names: [
                "-C",
                "--text-center",
            ],
            description: Some("Justify text to center"),
        ),
        (
            names: [
                "-F",
                "--text-full",
            ],
            description: Some("Justify text to both left and right edges"),
        ),
        (
            names: [
                "--soft",
            ],
            description: Some("Enable soft wrapping of text"),
            depends_on: [
                "--print",
            ],
        ),
        (
            names: [
                "-e",
                "--expand",
            ],
            description: Some("Expand to full width"),
            depends_on: [
                "--panel",
            ],
        ),
        (
            names: [
                "-w",
                "--width",
            ],
            description: Some("Fit output to SIZE characters"),
            arguments: [
                (
                    name: "size",
                ),
            ],
        ),
        (
            names: [
                "-W",
                "--max-width",
            ],
            description: Some("Set maximum width to SIZE characters"),
            arguments: [
                (
                    name: "size",
                ),
            ],
        ),
        (
            names: [
                "-s",
                "--style",
            ],
            description: Some("Set text style to STYLE"),
            arguments: [
                (
                    name: "style",
                    generators: [
                        (
                            has_custom: true,
                            trigger: Some(OnMatch([
                                    " ",
                                ])),
                            query_term: Some(AfterLast(" ")),
                        ),
                    ],
                    filter_strategy: Fuzzy,
                ),
            ],
        ),
        (
            names: [
                "--rule-style",
            ],
            description: Some("Set rule style to STYLE"),
            arguments: [
                (
                    name: "style",
                    generators: [
                        (
                            has_custom: true,
                            trigger: Some(OnMatch([
                                    " ",
                                ])),
                            query_term: Some(AfterLast(" ")),
                        ),
                    ],
                    filter_strategy: Fuzzy,
                ),
            ],
            depends_on: [
                "--rule",
            ],
        ),
        (
            names: [
                "--rule-char",
            ],
            description: Some("Use CHARACTER to generate a line with --rule"),
            arguments: [
                (
                    name: "character",
                ),
            ],
            depends_on: [
                "--rule",
            ],
        ),
        (
            names: [
                "-d",
                "--padding",
            ],
            description: Some("Padding around output. 1, 2 or 4 comma separated integers, e.g. 2,4"),
            arguments: [
                (
                    name: "top,right,bottom,left",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-a",
                "--panel",
            ],
            description: Some("Set panel type to BOX"),
            arguments: [
                (
                    name: "box",
                    suggestions: [
                        (
                            name: "ascii",
                        ),
                        (
                            name: "ascii2",
                        ),
                        (
                            name: "double",
                        ),
                        (
                            name: "heavy",
                        ),
                        (
                            name: "none",
                        ),
                        (
                            name: "rounded",
                        ),
                        (
                            name: "square",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-S",
                "--panel-style",
            ],
            description: Some("Set the panel style to STYLE"),
            arguments: [
                (
                    name: "style",
                    generators: [
                        (
                            has_custom: true,
                            trigger: Some(OnMatch([
                                    " ",
                                ])),
                            query_term: Some(AfterLast(" ")),
                        ),
                    ],
                    filter_strategy: Fuzzy,
                ),
            ],
            depends_on: [
                "--panel",
            ],
        ),
        (
            names: [
                "--theme",
            ],
            description: Some("Set syntax theme to THEME. See https://pygments.org/styles/"),
