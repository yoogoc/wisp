        (
            names: [
                "--no-wrap",
            ],
            description: Some("Don't word wrap syntax highlighted files"),
        ),
        (
            names: [
                "--title",
            ],
            description: Some("Set panel title to TEXT"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            names: [
                "--caption",
            ],
            description: Some("Set panel caption to TEXT"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            names: [
                "--force-terminal",
            ],
            description: Some("Force terminal output when not writing to a terminal"),
        ),
        (
            names: [
                "-o",
                "--export-html",
            ],
            description: Some("Write HTML to PATH"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                    ],
                    suggest_current_token: true,
                ),
            ],
        ),
