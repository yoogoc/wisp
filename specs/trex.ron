(
    version: 1,
    command: "trex",
    description: Some("Advanced package management for deno, based on import_map.json"),
    subcommands: [
        (
            name: "i",
            aliases: [
                "install",
            ],
            description: Some("Install a package"),
            options: [
                (
                    names: [
                        "-m",
                        "--map",
                    ],
                    description: Some("Install package from deno.land"),
                    arguments: [
                        (
                            name: "package name",
                            description: Some("Deno.land package name"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-n",
                        "--nest",
                    ],
                    description: Some("Install package from nest.land"),
                    arguments: [
                        (
                            name: "package name",
                            description: Some("Nest.land package name"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-p",
                        "--pkg",
                    ],
                    description: Some("Install package from some repository"),
                    arguments: [
                        (
                            name: "repository",
                            description: Some("[user]/[repo or repo@tag/branch]/[path/to/file]"),
                        ),
                        (
                            name: "Package Name",
                            description: Some("Prefered package alias"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "delete",
            description: Some("Delete a package"),
            arguments: [
                (
                    name: "package name",
                    generators: [
                        (
                            script: [
                                "cat",
                                "import_map.json",
                            ],
                            has_post_process: true,
                        ),
                    ],
                    filter_strategy: Fuzzy,
                ),
            ],
        ),
        (
            name: "upgrade",
            description: Some("Upgrade trex"),
            options: [
                (
                    names: [
                        "--canary",
                    ],
                    description: Some("Install from dev branch"),
                ),
            ],
        ),
        (
            name: "tree",
            description: Some("View dependency tree"),
        ),
        (
            name: "run",
            description: Some("Run a script alias in a file run.json"),
            options: [
                (
                    names: [
                        "-w",
                        "--watch",
                    ],
                    description: Some("Use reboot script alias protocol (rsap)"),
                ),
                (
                    names: [
                        "-wv",
                    ],
                    description: Some("Verbose output in --watch mode (rsap)"),
                ),
            ],
            arguments: [
                (
                    name: "script alias",
                    generators: [
                        (
                            script: [
                                "cat",
                                "run.json",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "purge",
            description: Some("Remove a package or url from cache"),
            arguments: [
                (
                    name: "package | url",
                    generators: [
                        (
                            script: [
                                "cat",
                                "import_map.json",
                            ],
                            has_post_process: true,
                        ),
                    ],
                    filter_strategy: Fuzzy,
                ),
            ],
        ),
        (
            name: "ls",
            description: Some("Shows the list of installed packages"),
        ),
        (
            name: "exec",
            description: Some("Execute a cli tool with out install then"),
            options: [
                (
                    names: [
                        "--perms",
                    ],
                    description: Some("Specify cli permisions"),
                ),
            ],
            arguments: [
                (
                    name: "cli tool",
                ),
            ],
        ),
        (
            name: "check",
            description: Some("Check deno.land [std/x] dependencies updates"),
            options: [
                (
                    names: [
                        "-f",
                        "--fix",
                    ],
                    description: Some("Update outdated dependencies"),
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Print help info"),
            persistent: true,
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Print version"),
        ),
        (
            names: [
                "-c",
                "--custom",
            ],
            description: Some("Install custom package"),
            arguments: [
                (
                    name: "custom package",
                    description: Some("Install a package from a custom URL source, eg: React=https://dev.jspm.io/react/index.js"),
                ),
            ],
        ),
    ],
)
