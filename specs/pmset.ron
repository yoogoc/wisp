(
    version: 1,
    command: "pmset",
    description: Some("Power management settings"),
    subcommands: [
        (
            name: "-g",
            description: Some("GETTING"),
            arguments: [
                (
                    name: "",
                    suggestions: [
                        (
                            name: "live",
                            description: Some("Display the settings currently in use. (default if no argument given)"),
                        ),
                        (
                            name: "custom",
                            description: Some("Display custom settings for all power sources"),
                        ),
                        (
                            name: "cap",
                            description: Some("Display which power management features the machine supports"),
                        ),
                        (
                            name: "sched",
                            description: Some("Display scheduled startup/wake and shutdown/sleep events"),
                        ),
                        (
                            name: "ups",
                            description: Some("Display UPS emergency thresholds"),
                        ),
                        (
                            name: "ps",
                            aliases: [
                                "batt",
                            ],
                            description: Some("Display status of batteries and UPSs"),
                        ),
                        (
                            name: "pslog",
                            description: Some("Display an ongoing log of power source (battery and UPS)state"),
                        ),
                        (
                            name: "rawlog",
                            description: Some("Display an ongoing log of battery state as read directly from battery"),
                        ),
                        (
                            name: "profiles",
                            description: Some("Display the settings associated with each Energy Saver profile. 10.5+"),
                        ),
                        (
                            name: "thermlog",
                            description: Some("Show a log of thermal notifications that affect CPU speed. Not available on all platforms"),
                        ),
                        (
                            name: "assertions",
                            description: Some("Display a summary of power assertions. 10.6+"),
                        ),
                        (
                            name: "assertionslog",
                            description: Some("Show a log of assertion creations and releases. 10.6+"),
                        ),
                        (
                            name: "activity",
                            description: Some("Display a summary of power state of Display wrangler and Disk Queue Manager.10.6+"),
                        ),
                        (
                            name: "activitylog",
                            description: Some("Show a log of power state changes to Display Wrangler and Disk Queue Manager. 10.6+"),
                        ),
                        (
                            name: "sysload",
                            description: Some("Display the \"system load advisory\" 10.6+"),
                        ),
                        (
                            name: "sysloadlog",
                            description: Some("Display an ongoing log of lives changes to the system load advisory. 10.6+"),
                        ),
                        (
                            name: "ac",
                            aliases: [
                                "adapter",
                            ],
                            description: Some("Display details about an attached AC power adapter"),
                        ),
                        (
                            name: "log",
                            description: Some("Display a history of sleeps, wakes, and other power management events"),
                        ),
                        (
                            name: "uuid",
                            description: Some("Display the currently active sleep/wake UUID"),
                        ),
                        (
                            name: "uuidlog",
                            description: Some("Display the currently active sleep/wake UUID, and prints a new UUID as they're set by the system"),
                        ),
                        (
                            name: "history",
                            description: Some("A debugging tool. Prints a timeline of system sleeplwake UUIDs"),
                        ),
                        (
                            name: "historydetailed",
                            description: Some("Prints driver-level timings for a sleep/wake. Pass a UUID as an argument"),
                        ),
                        (
                            name: "everything",
                            description: Some("Print output from every argument under the GETTING header 10.8+"),
                        ),
                    ],
                    optional: true,
                    default: Some("live"),
                ),
                (
                    name: "UUID",
                    description: Some("Used for historydetailed"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "schedule",
            description: Some("For setting up one-time power events"),
            options: [
                (
                    names: [
                        "cancel",
                    ],
                ),
            ],
            arguments: [
                (
                    name: "type",
                    suggestions: [
                        (
                            name: "sleep",
                        ),
                        (
                            name: "wake",
                        ),
                        (
                            name: "poweron",
                        ),
                        (
                            name: "shutdown",
                        ),
                        (
                            name: "wakeorpoweron",
                        ),
                    ],
                ),
                (
                    name: "date/time",
                    description: Some("\"MM/dd/yy HH:mm:ss\" (in 24 hour format; must be in quotes)"),
                ),
            ],
        ),
        (
            name: "repeat",
            description: Some("For setting up daily/weekly power on and power off events"),
            subcommands: [
                (
                    name: "cancel",
                ),
            ],
            arguments: [
                (
                    name: "type",
                    suggestions: [
                        (
                            name: "sleep",
                        ),
                        (
                            name: "wake",
                        ),
                        (
                            name: "poweron",
                        ),
                        (
                            name: "shutdown",
                        ),
                        (
                            name: "wakeorpoweron",
                        ),
                    ],
                ),
                (
                    name: "weekdays",
                    description: Some("A subset of MTWRFSU (\"M\" and \"MTWRF\" are valid strings)"),
                ),
                (
                    name: "date/time",
                    description: Some("\"MM/dd/yy HH:mm:ss\" (in 24 hour format; must be in quotes)"),
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "-a",
            ],
            description: Some("Settings for all"),
            arguments: [
                (
                    name: "setting",
                    suggestions: [
                        (
                            name: "displaysleep",
                            aliases: [
                                "dim",
                            ],
                            description: Some("Display sleep timer (value in minutes, or 0 to disable)"),
                        ),
                        (
                            name: "disksleep",
                            aliases: [
                                "spindown",
                            ],
                            description: Some("Disk spindown timer (value in minutes, or 0 to disable)"),
                        ),
                        (
                            name: "sleep",
                            description: Some("System sleep timer (value in minutes, or 0 to disable)"),
                        ),
                        (
                            name: "womp",
                            description: Some("Wake on ethernet magic packet (value = 0/1)"),
                        ),
                        (
                            name: "ring",
                            description: Some("Wake on modem ring (value = 0/1)"),
                        ),
                        (
                            name: "autorestart",
                            description: Some("Automatic restart on power loss (value = 0/1)"),
                        ),
                        (
                            name: "dps",
                            description: Some("Dynamically change processor speed based on load (value = 0/1)"),
                        ),
                        (
                            name: "reduce",
                            description: Some("Reduce processor speed (value = 0/1)"),
                        ),
                        (
                            name: "powerbutton",
                            description: Some("Sleep the machine when power button is pressed (value=0/1)"),
                        ),
                        (
                            name: "lidwake",
                            description: Some("Wake the machine when the laptop lid (or clamshell) is opened (value = 0/1)"),
                        ),
                        (
                            name: "acwake",
                            description: Some("Wake the machine when power source (AC/battery) is changed (value = 0/1)"),
                        ),
                        (
                            name: "lessbright",
                            description: Some("Slightly turn down display brightness when switching to this power source (value = 0/1)"),
                        ),
                        (
                            name: "halfdim",
                            description: Some("Display sleep will use an intermediate half-brightness state between full brightness and fully off  (value = 0/1)"),
                        ),
                        (
                            name: "sms",
                            description: Some("Use Sudden Motion Sensor to park disk heads on sudden changes in G force (value = 0/1)"),
                        ),
                        (
                            name: "hibernatemode",
                            description: Some("Change hibernation mode. 0 = normal sleep, 1 = hibernate mode, 3 = safe sleep, 25 = hibernate mode for post-2005 portable Macs"),
                        ),
                        (
                            name: "hibernatefile",
                            description: Some("Change hibernation image file location. (value = path)"),
                        ),
                        (
                            name: "ttyskeepawake",
                            description: Some("Prevent idle system sleep when any tty (e.g. remote login session) is 'active'. (value = 0/1)"),
                        ),
                        (
                            name: "networkoversleep",
                            description: Some("This setting affects how macOS networking presents shared network services during system sleep"),
                        ),
                        (
                            name: "destroyfvkeyonstandby",
                            description: Some("Destroy File Vault Key when going to standby mode. (value: 1 - Destroy, 0 - Retain)"),
                        ),
                    ],
                ),
