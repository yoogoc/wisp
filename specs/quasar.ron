(
    version: 1,
    command: "quasar",
    description: Some("Quasar Framework CLI"),
    subcommands: [
        (
            name: "create",
            description: Some("Create a new Quasar project"),
            options: [
                (
                    names: [
                        "--kit",
                        "-k",
                    ],
                    description: Some("Use specific starter kit"),
                    arguments: [
                        (
                            name: "kit",
                        ),
                    ],
                ),
                (
                    names: [
                        "--branch",
                        "-b",
                    ],
                    description: Some("Use specific branch of the starter kit"),
                    arguments: [
                        (
                            name: "branch",
                        ),
                    ],
                ),
                (
                    names: [
                        "--clone",
                        "-c",
                    ],
                    description: Some("Use git clone"),
                ),
                (
                    names: [
                        "--offline",
                        "-o",
                    ],
                    description: Some("Use a cached starter kit"),
                ),
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Output usage information"),
                ),
            ],
            arguments: [
                (
                    name: "project-name",
                    description: Some("Name of the project"),
                ),
            ],
        ),
        (
            name: "info",
            description: Some("Gather environment information for issue reporting"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Output usage information"),
                ),
            ],
        ),
        (
            name: "upgrade",
            description: Some("Upgrade Quasar Framework packages"),
            options: [
                (
                    names: [
                        "--install",
                        "-i",
                    ],
                    description: Some("Also perform package upgrades"),
                ),
                (
                    names: [
                        "--prerelease",
                        "-p",
                    ],
                    description: Some("Allow pre-release versions (alpha/beta)"),
                ),
                (
                    names: [
                        "--major",
                        "-m",
                    ],
                    description: Some("Allow newer major versions (breaking changes)"),
                ),
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Output usage information"),
                ),
            ],
        ),
        (
            name: "serve",
            description: Some("Start development server"),
            options: [
                (
                    names: [
                        "--port",
                        "-p",
                    ],
                    description: Some("Port to use"),
                    arguments: [
                        (
                            name: "port",
                        ),
                    ],
                ),
                (
                    names: [
                        "--hostname",
                        "-H",
                    ],
                    description: Some("Address to use"),
                    arguments: [
                        (
                            name: "hostname",
                        ),
                    ],
                ),
                (
                    names: [
                        "--gzip",
                        "-g",
                    ],
                    description: Some("Compress content"),
                ),
                (
                    names: [
                        "--silent",
                        "-s",
                    ],
                    description: Some("Suppress log message"),
                ),
                (
                    names: [
                        "--colors",
                    ],
                    description: Some("Log messages with colors"),
                ),
                (
                    names: [
                        "--open",
                        "-o",
                    ],
                    description: Some("Open browser window after starting"),
                ),
                (
                    names: [
                        "--cache",
                        "-c",
                    ],
                    description: Some("Cache time (max-age) in seconds"),
                    arguments: [
                        (
                            name: "cache",
                        ),
                    ],
                ),
                (
                    names: [
                        "--micro",
                        "-m",
                    ],
                    description: Some("Use micro-cache"),
                    arguments: [
                        (
                            name: "micro",
                        ),
                    ],
                ),
                (
                    names: [
                        "--history",
                    ],
                    description: Some("Use history api fallback"),
                ),
                (
                    names: [
                        "--index",
                        "-i",
                    ],
                    description: Some("History mode (only!) index url path"),
                    arguments: [
                        (
                            name: "index",
                        ),
                    ],
                ),
                (
                    names: [
                        "--https",
                    ],
                    description: Some("Enable HTTPS"),
                ),
                (
                    names: [
                        "--cert",
                        "-C",
                    ],
                    description: Some("Path to SSL cert file (Optional)"),
                    arguments: [
                        (
                            name: "cert",
                        ),
                    ],
                ),
                (
                    names: [
                        "--key",
                        "-K",
                    ],
                    description: Some("Path to SSL key file (Optional)"),
                    arguments: [
                        (
                            name: "key",
                        ),
                    ],
                ),
                (
                    names: [
                        "--proxy",
                    ],
                    description: Some("Proxy specific requests defined in file"),
                    arguments: [
                        (
                            name: "proxy",
                        ),
                    ],
                ),
                (
                    names: [
                        "--cors",
                    ],
                    description: Some("Enable CORS for all requests"),
                ),
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Output usage information"),
                ),
            ],
            arguments: [
                (
                    name: "path",
                    description: Some("Path to serve"),
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Output usage information"),
        ),
    ],
)
