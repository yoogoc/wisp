(
    version: 1,
    command: "mvn",
    description: Some("Maven - a Java based project management and comprehension tool"),
    options: [
        (
            names: [
                "--also-make",
                "-am",
            ],
            description: Some("Also build projects required by project list"),
        ),
        (
            names: [
                "--also-make-dependents",
                "-amd",
            ],
            description: Some("Also build projects that depend on projects in the project list"),
        ),
        (
            names: [
                "--batch-mode",
                "-B",
            ],
            description: Some("Run in non-interactive (batch)"),
        ),
        (
            names: [
                "--builder",
                "-b",
            ],
            description: Some("Specify the build strategy to use"),
            arguments: [
                (
                    name: "id of build strategy",
                ),
            ],
        ),
        (
            names: [
                "--strict-checksums",
                "-C",
            ],
            description: Some("Fail if checksums do not match"),
        ),
        (
            names: [
                "--lax-checksums",
                "-c",
            ],
            description: Some("Warn if checksums do not match"),
        ),
        (
            names: [
                "--color",
            ],
            description: Some("Specify the color mode of the output"),
            arguments: [
                (
                    name: "color mode",
                    suggestions: [
                        (
                            name: "always",
                        ),
                        (
                            name: "never",
                        ),
                        (
                            name: "auto",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--check-plugin-updates",
                "-cpu",
            ],
            description: Some("Ineffective. Only kept for backward compatibility"),
        ),
        (
            names: [
                "--define",
                "-D",
            ],
            description: Some("Define a system property"),
            arguments: [
                (
                    name: "system property",
                ),
            ],
        ),
        (
            names: [
                "--errors",
                "-e",
            ],
            description: Some("Produce execution error messages"),
        ),
        (
            names: [
                "--encrypt-master-password",
                "-emp",
            ],
            description: Some("Encrypt the master security password"),
            arguments: [
                (
                    name: "master password",
                ),
            ],
        ),
        (
            names: [
                "--encrypt-password",
                "-ep",
            ],
            description: Some("Encrypt the server password"),
            arguments: [
                (
                    name: "server password",
                ),
            ],
        ),
        (
            names: [
                "--file",
                "-f",
            ],
            description: Some("Force the use of an alternate POM file (or directory with pom.xml)"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--fail-at-end",
                "-fae",
            ],
            description: Some("Only fail the build afterwards; allow all non-impacted builds to continue"),
        ),
        (
            names: [
                "--fail-fast",
                "-ff",
            ],
            description: Some("Stop at first failure in reactorized builds"),
        ),
        (
            names: [
                "--fail-never",
                "-fn",
            ],
            description: Some("Never fail the build, regardless of project result"),
        ),
        (
            names: [
                "--global-settings",
                "-gs",
            ],
            description: Some("Specify the global settings file to use"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--global-toolchains",
                "-gt",
            ],
            description: Some("Specify the global toolchains file to use"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Display help information"),
        ),
        (
            names: [
                "--log-file",
                "-l",
            ],
            description: Some("Specify the file to log to"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--legacy-local-repository",
                "-llr",
            ],
            description: Some("Use the Maven2 legacy local repository behaviour"),
        ),
        (
            names: [
                "--non-recursive",
                "-N",
            ],
            description: Some("Do not recurse into sub-projects"),
        ),
        (
            names: [
                "--no-plugin-registry",
                "-npr",
            ],
            description: Some("Ineffective. Only kept for backward compatibility"),
        ),
        (
            names: [
                "--no-plugin-updates",
                "-npu",
            ],
            description: Some("Ineffective. Only kept for backward compatibility"),
        ),
        (
            names: [
                "--no-snapshot-updates",
                "-nsu",
            ],
            description: Some("Suppress SNAPSHOT updates"),
        ),
        (
            names: [
                "--no-transfer-progress",
                "-ntp",
            ],
            description: Some("Do not display transfer progress when downloading or uploading"),
        ),
        (
            names: [
                "--offline",
                "-o",
            ],
            description: Some("Work offline"),
        ),
        (
            names: [
                "--activate-profiles",
                "-P",
            ],
            description: Some("Activate the specified profiles (comma delimited)"),
            arguments: [
                (
                    name: "profiles",
                ),
            ],
        ),
        (
            names: [
                "--projects",
                "-pl",
            ],
            description: Some("Specify the projects to build"),
            arguments: [
                (
                    name: "project list",
                ),
            ],
        ),
        (
            names: [
                "--quiet",
                "-q",
            ],
            description: Some("Quiet output - only shows errors"),
        ),
        (
            names: [
                "--resume-from",
                "-rf",
            ],
            description: Some("Resume from the specified project"),
            arguments: [
                (
                    name: "project",
                ),
            ],
        ),
        (
            names: [
                "--settings",
                "-s",
            ],
            description: Some("Specify the user settings file to use"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--toolchains",
                "-t",
            ],
            description: Some("Specify the toolchains file to use"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--threads",
                "-T",
            ],
            description: Some("Specify the number of threads to use"),
            arguments: [
                (
                    name: "threads",
                ),
            ],
        ),
        (
            names: [
                "--update-snapshots",
                "-U",
            ],
            description: Some("Forces a check for missing releases and updated snapshots on remote repositories"),
        ),
        (
            names: [
                "--update-plugins",
                "-up",
            ],
            description: Some("Ineffective. Only kept for backward compatibility"),
        ),
        (
            names: [
                "--version",
                "-v",
            ],
            description: Some("Display version information"),
        ),
        (
            names: [
                "--show-version",
                "-V",
            ],
            description: Some("Display version information"),
        ),
        (
            names: [
                "--debug",
                "-X",
            ],
            description: Some("Produce execution debug output"),
        ),
    ],
    arguments: [
        (
            name: "goal/phase",
            description: Some("Goal or phase to execute"),
            suggestions: [
                (
                    name: "pre-clean",
                ),
                (
                    name: "clean",
                ),
                (
                    name: "post-clean",
                ),
                (
                    name: "validate",
                ),
                (
                    name: "initialize",
                ),
                (
                    name: "generate-sources",
                ),
                (
                    name: "process-sources",
                ),
                (
                    name: "generate-resources",
                ),
                (
                    name: "process-resources",
                ),
                (
                    name: "compile",
                ),
                (
                    name: "process-classes",
                ),
                (
                    name: "generate-test-sources",
                ),
                (
                    name: "process-test-sources",
                ),
                (
                    name: "generate-test-resources",
                ),
                (
                    name: "process-test-resources",
                ),
                (
                    name: "test-compile",
                ),
                (
                    name: "process-test-classes",
                ),
                (
                    name: "test",
                ),
                (
                    name: "prepare-package",
                ),
                (
                    name: "package",
                ),
                (
                    name: "pre-integration-test",
                ),
                (
                    name: "integration-test",
                ),
                (
                    name: "post-integration-test",
                ),
                (
                    name: "verify",
                ),
                (
                    name: "install",
                ),
                (
                    name: "deploy",
                ),
                (
                    name: "pre-site",
                ),
                (
                    name: "site",
                ),
                (
                    name: "post-site",
                ),
                (
                    name: "site-deploy",
                ),
            ],
            variadic: true,
        ),
    ],
)
