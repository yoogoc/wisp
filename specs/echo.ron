(
    version: 1,
    command: "echo",
    description: Some("Write arguments to the standard output"),
    options: [
        (
            names: [
                "-n",
            ],
            description: Some("Do not print the trailing newline character"),
        ),
        (
            names: [
                "-e",
            ],
            description: Some("Interpret escape sequences"),
        ),
        (
            names: [
                "-E",
            ],
            description: Some("Disable escape sequences"),
        ),
    ],
    arguments: [
        (
            name: "string",
            generators: [
                (
                    has_custom: true,
                    trigger: Some(OnMatch([
                            "$",
                        ])),
                ),
            ],
            variadic: true,
            suggest_current_token: true,
        ),
    ],
)
