(
    version: 1,
    command: "tsc",
    description: Some("CLI tool for TypeScript compiler"),
    options: [
        (
            names: [
                "--all",
            ],
            description: Some("Show all compiler options"),
        ),
        (
            names: [
                "--generateTrace",
            ],
            description: Some("Generates an event trace and a list of types"),
        ),
        (
            names: [
                "--help",
            ],
            description: Some("Gives local information for help on the CLI"),
        ),
        (
            names: [
                "--init",
            ],
            description: Some("Initializes a TypeScript project and creates a tsconfig.json file"),
        ),
        (
            names: [
                "--listFilesOnly",
            ],
            description: Some("Print names of files that are part of the compilation and then stop processing"),
        ),
        (
            names: [
                "--locale",
            ],
            description: Some("Set the language of the messaging from TypeScript. This does not affect emit"),
        ),
        (
            names: [
                "--project",
            ],
            description: Some("Compile the project given the path to its configuration file, or to a folder with a tsconfig.json"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--showConfig",
            ],
            description: Some("Print the final configuration instead of building"),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Print the compiler's version"),
        ),
        (
            names: [
                "--build",
            ],
            description: Some("Build one or more projects and their dependencies, if out of date"),
        ),
        (
            names: [
                "--clean",
            ],
            description: Some("Delete the outputs of all projects"),
        ),
        (
            names: [
                "--dry",
            ],
            description: Some("Show what would be built (or deleted, if specified with '--clean')"),
        ),
        (
            names: [
                "--force",
            ],
            description: Some("Build all projects, including those that appear to be up to date"),
        ),
        (
            names: [
                "--verbose",
            ],
            description: Some("Enable verbose logging"),
        ),
        (
            names: [
                "--excludeDirectories",
            ],
            description: Some("Remove a list of directories from the watch process"),
            arguments: [
                (
                    name: "dir",
                    template: [
                        Folders,
                    ],
                    variadic: true,
                ),
            ],
        ),
        (
            names: [
                "--excludeFiles",
            ],
            description: Some("Remove a list of files from the watch mode's processing"),
            arguments: [
                (
                    name: "files",
                    template: [
                        FilePaths,
                    ],
                    variadic: true,
                ),
            ],
        ),
        (
            names: [
                "--fallbackPolling",
            ],
            description: Some("Specify what approach the watcher should use if the system runs out of native file watchers"),
            arguments: [
                (
                    name: "approach",
                    suggestions: [
                        (
                            name: "fixedPollingInterval",
                        ),
                        (
                            name: "priorityPollingInterval",
                        ),
                        (
                            name: "dynamicPriorityPolling",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--synchronousWatchDirectory",
            ],
            description: Some("Synchronously call callbacks and update the state of directory watchers on platforms that don`t support recursive watching natively"),
        ),
        (
            names: [
                "--watch",
            ],
            description: Some("Watch input files"),
        ),
        (
            names: [
                "--watchDirectory",
            ],
            description: Some("Specify how directories are watched on systems that lack recursive file-watching functionality"),
            arguments: [
                (
                    name: "approach",
                    suggestions: [
                        (
                            name: "fixedPollingInterval",
                        ),
                        (
                            name: "dynamicPriorityPolling",
                        ),
                        (
                            name: "useFsEvents",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--watchFile",
            ],
            description: Some("Specify how the TypeScript watch mode works"),
            arguments: [
                (
                    name: "approach",
                    suggestions: [
                        (
                            name: "fixedPollingInterval",
                        ),
                        (
                            name: "priorityPollingInterval",
                        ),
                        (
                            name: "dynamicPriorityPolling",
                        ),
                        (
                            name: "useFsEvents",
                        ),
                        (
                            name: "useFsEventsOnParentDirectory",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--allowJs",
            ],
            description: Some("Allow JavaScript files to be a part of your program. Use the checkJS option to get errors from these files"),
        ),
        (
            names: [
                "--allowSyntheticDefaultImports",
            ],
            description: Some("Allow 'import x from y' when a module doesn't have a default export"),
        ),
        (
            names: [
                "--allowUmdGlobalAccess",
            ],
            description: Some("Allow accessing UMD globals from modules"),
        ),
        (
            names: [
                "--allowUnreachableCode",
            ],
            description: Some("Disable error reporting for unreachable code"),
        ),
        (
            names: [
                "--allowUnusedLabels",
            ],
            description: Some("Disable error reporting for unused label"),
        ),
        (
            names: [
                "--alwaysStrict",
            ],
            description: Some("Ensure 'use strict' is always emitted"),
        ),
        (
            names: [
                "--assumeChangesOnlyAffectDirectDependencies",
            ],
            description: Some("Have recompiles in projects that use incremental and watch mode assume that changes within a file will only affect files directly depending on it"),
        ),
        (
            names: [
                "--baseUrl",
            ],
            description: Some("Specify the base directory to resolve non-relative module names"),
            arguments: [
                (
                    name: "directory",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--checkJs",
            ],
            description: Some("Enable error reporting in type-checked JavaScript files"),
        ),
        (
            names: [
                "--composite",
            ],
            description: Some("Enable constraints that allow a TypeScript project to be used with project references"),
        ),
        (
            names: [
                "--declaration",
            ],
            description: Some("Generate .d.ts files from TypeScript and JavaScript files in your project"),
        ),
        (
            names: [
                "--declarationDir",
            ],
            description: Some("Specify the output directory for generated declaration files"),
            arguments: [
                (
                    name: "string",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--declarationMap",
            ],
            description: Some("Create sourcemaps for d.ts files"),
        ),
        (
            names: [
                "--diagnostics",
            ],
            description: Some("Output compiler performance information after building"),
        ),
        (
            names: [
                "--disableReferencedProjectLoad",
            ],
            description: Some("Reduce the number of projects loaded automatically by TypeScript"),
        ),
        (
            names: [
                "--disableSizeLimit",
            ],
            description: Some("Remove the 20mb cap on total source code size for JavaScript files in the TypeScript language server"),
        ),
        (
            names: [
                "--disableSolutionSearching",
            ],
            description: Some("Opt a project out of multi-project reference checking when editing"),
        ),
        (
            names: [
                "--disableSourceOfProjectReferenceRedirect",
            ],
            description: Some("Disable preferring source files instead of declaration files when referencing composite projects"),
        ),
        (
            names: [
                "--downlevelIteration",
            ],
            description: Some("Emit more compliant, but verbose and less performant JavaScript for iteration"),
        ),
        (
            names: [
                "--emitBOM",
            ],
            description: Some("Emit a UTF-8 Byte Order Mark (BOM) in the beginning of output files"),
        ),
        (
            names: [
                "--emitDeclarationOnly",
            ],
            description: Some("Only output d.ts files and not JavaScript files"),
        ),
        (
            names: [
                "--emitDecoratorMetadata",
            ],
            description: Some("Emit design-type metadata for decorated declarations in source files"),
        ),
        (
            names: [
                "--esModuleInterop",
            ],
            description: Some("Emit additional JavaScript to ease support for importing CommonJS modules. This enables allowSyntheticDefaultImports for type compatibility"),
        ),
        (
            names: [
                "--exactOptionalPropertyTypes",
            ],
            description: Some("Differentiate between undefined and not present when type checking"),
        ),
        (
            names: [
                "--experimentalDecorators",
            ],
            description: Some("Enable experimental support for TC39 stage 2 draft decorators"),
        ),
        (
            names: [
                "--explainFiles",
            ],
            description: Some("Print files read during the compilation including why it was included"),
        ),
        (
            names: [
                "--extendedDiagnostics",
            ],
            description: Some("Output more detailed compiler performance information after building"),
        ),
        (
            names: [
                "--forceConsistentCasingInFileNames",
            ],
            description: Some("Ensure that casing is correct in imports"),
        ),
        (
            names: [
                "--generateCpuProfile",
            ],
            description: Some("Emit a v8 CPU profile of the compiler run for debugging"),
        ),
        (
            names: [
                "--importHelpers",
            ],
            description: Some("Allow importing helper functions from tslib once per project, instead of including them per-file"),
        ),
        (
            names: [
                "--importsNotUsedAsValues",
            ],
            description: Some("Specify emit/checking behavior for imports that are only used for types"),
            arguments: [
                (
                    name: "type",
                    suggestions: [
                        (
                            name: "remove",
                        ),
                        (
                            name: "preserve",
                        ),
                        (
                            name: "error",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--incremental",
            ],
            description: Some("Save .tsbuildinfo files to allow for incremental compilation of projects"),
        ),
        (
            names: [
                "--inlineSourceMap",
            ],
            description: Some("Include sourcemap files inside the emitted JavaScript"),
        ),
        (
            names: [
                "--inlineSources",
            ],
            description: Some("Include source code in the sourcemaps inside the emitted JavaScript"),
        ),
        (
            names: [
                "--isolatedModules",
            ],
            description: Some("Ensure that each file can be safely transpiled without relying on other imports"),
        ),
        (
            names: [
                "--jsx",
            ],
            description: Some("Specify what JSX code is generated"),
            arguments: [
                (
                    name: "type",
                    suggestions: [
                        (
                            name: "react",
                        ),
                        (
                            name: "react-jsx",
                        ),
                        (
                            name: "react-jsxdev",
                        ),
                        (
                            name: "react-native",
                        ),
                        (
                            name: "preserve",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--jsxFactory",
            ],
            description: Some("Specify the JSX factory function used when targeting React JSX emit, e.g. 'React.createElement' or 'h'"),
            arguments: [
                (
                    name: "JSX factory function",
                    default: Some("React.createElement"),
                ),
            ],
        ),
        (
            names: [
                "--jsxFragmentFactory",
            ],
            description: Some("Specify the JSX Fragment reference used for fragments when targeting React JSX emit e.g. 'React.Fragment' or 'Fragment'"),
            arguments: [
                (
                    name: "JSX fragment",
                ),
            ],
        ),
        (
            names: [
                "--jsxImportSource",
            ],
            description: Some("Specify module specifier used to import the JSX factory functions when using jsx: react-jsx*"),
            arguments: [
                (
                    name: "string",
                    default: Some("react"),
                ),
            ],
        ),
        (
            names: [
                "--keyofStringsOnly",
            ],
            description: Some("Make keyof only return strings instead of string, numbers or symbols. Legacy option"),
        ),
        (
            names: [
                "--lib",
            ],
            description: Some("Specify a set of bundled library declaration files that describe the target runtime environment"),
            arguments: [
                (
                    name: "list",
                    template: [
                        FilePaths,
                    ],
                    variadic: true,
                ),
            ],
        ),
        (
            names: [
                "--listEmittedFiles",
            ],
            description: Some("Print the names of emitted files after a compilation"),
        ),
        (
            names: [
                "--listFiles",
            ],
            description: Some("Print all of the files read during the compilation"),
        ),
        (
            names: [
                "--mapRoot",
            ],
            description: Some("Specify the location where debugger should locate map files instead of generated locations"),
            arguments: [
                (
                    name: "string",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--maxNodeModuleJsDepth",
            ],
            description: Some("Specify the maximum folder depth used for checking JavaScript files from node_modules. Only applicable with allowJs"),
            arguments: [
                (
                    name: "number",
                    default: Some("0"),
                ),
            ],
            depends_on: [
                "--allowJs",
            ],
        ),
        (
            names: [
                "--module",
            ],
            description: Some("Specify what module code is generated"),
            arguments: [
                (
                    name: "module",
                    suggestions: [
                        (
                            name: "ES6",
                        ),
                        (
                            name: "ES2015",
                        ),
                        (
                            name: "ES2020",
                        ),
                        (
                            name: "None",
                        ),
                        (
                            name: "UMD",
                        ),
                        (
                            name: "AMD",
                        ),
                        (
                            name: "System",
                        ),
                        (
                            name: "ESNext",
                        ),
                        (
                            name: "CommonJS",
                        ),
                    ],
                    default: Some("CommonJS"),
                ),
            ],
        ),
        (
            names: [
                "--moduleResolution",
            ],
            description: Some("Specify how TypeScript looks up a file from a given module specifier"),
            arguments: [
                (
                    name: "module",
                ),
            ],
        ),
        (
            names: [
                "--newLine",
            ],
            description: Some("Set the newline character for emitting files"),
            arguments: [
                (
                    name: "character",
                ),
            ],
        ),
        (
            names: [
                "--noEmit",
            ],
            description: Some("Disable emitting file from a compilation"),
        ),
        (
            names: [
                "--noEmitHelpers",
            ],
            description: Some("Disable generating custom helper functions like __extends in compiled output"),
        ),
        (
            names: [
                "--noEmitOnError",
            ],
            description: Some("Disable emitting files if any type checking errors are reported"),
        ),
        (
            names: [
                "--noErrorTruncation",
            ],
            description: Some("Disable truncating types in error messages"),
        ),
        (
            names: [
                "--noFallthroughCasesInSwitch",
            ],
            description: Some("Enable error reporting for fallthrough cases in switch statements"),
        ),
        (
            names: [
                "--noImplicitAny",
            ],
            description: Some("Enable error reporting for expressions and declarations with an implied any type"),
        ),
        (
            names: [
                "--noImplicitOverride",
            ],
            description: Some("Ensure overriding members in derived classes are marked with an override modifier"),
        ),
        (
            names: [
                "--noImplicitReturns",
            ],
            description: Some("Enable error reporting for codepaths that do not explicitly return in a function"),
        ),
        (
            names: [
                "--noImplicitThis",
            ],
            description: Some("Enable error reporting when this is given the type any"),
        ),
        (
            names: [
                "--noImplicitUseStrict",
            ],
            description: Some("Disable adding 'use strict' directives in emitted JavaScript files"),
        ),
        (
            names: [
                "--noLib",
            ],
            description: Some("Disable including any library files, including the default lib.d.ts"),
        ),
        (
            names: [
                "--noPropertyAccessFromIndexSignature",
            ],
            description: Some("Enforces using indexed accessors for keys declared using an indexed type"),
        ),
        (
            names: [
                "--noResolve",
            ],
            description: Some("Disallow imports, requires or <reference>s from expanding the number of files TypeScript should add to a project"),
        ),
        (
            names: [
                "--noStrictGenericChecks",
            ],
            description: Some("Disable strict checking of generic signatures in function types"),
        ),
        (
            names: [
                "--noUncheckedIndexedAccess",
            ],
            description: Some("Add undefined to a type when accessed using an index"),
        ),
        (
            names: [
                "--noUnusedLocals",
            ],
            description: Some("Enable error reporting when a local variables aren't read"),
        ),
        (
            names: [
                "--noUnusedParameters",
            ],
            description: Some("Raise an error when a function parameter isn't read"),
        ),
        (
            names: [
                "--outDir",
            ],
            description: Some("Specify an output folder for all emitted files"),
            arguments: [
                (
                    name: "string",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--outFile",
            ],
            description: Some("Specify a file that bundles all outputs into one JavaScript file. If declaration is true, also designates a file that bundles all .d.ts output"),
            arguments: [
                (
                    name: "string",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--paths",
            ],
            description: Some("Specify a set of entries that re-map imports to additional lookup locations"),
            arguments: [
                (
                    name: "object",
                ),
            ],
        ),
        (
            names: [
                "--plugins",
            ],
            description: Some("Specify a list of language service plugins to include"),
            arguments: [
                (
                    name: "plugins",
                    variadic: true,
                ),
            ],
        ),
        (
            names: [
                "--preserveConstEnums",
            ],
            description: Some("Disable erasing const enum declarations in generated code"),
        ),
        (
            names: [
                "--preserveSymlinks",
            ],
            description: Some("Disable resolving symlinks to their realpath. This correlates to the same flag in node"),
        ),
        (
            names: [
                "--preserveWatchOutput",
            ],
            description: Some("Disable wiping the console in watch mode"),
        ),
        (
            names: [
                "--pretty",
            ],
            description: Some("Enable color and formatting in output to make compiler errors easier to read"),
        ),
        (
            names: [
                "--reactNamespace",
            ],
            description: Some("Specify the object invoked for createElement. This only applies when targeting react JSX emit"),
            arguments: [
                (
                    name: "object",
                    default: Some("React"),
                ),
            ],
        ),
        (
            names: [
                "--removeComments",
            ],
            description: Some("Disable emitting comments"),
        ),
        (
            names: [
                "--resolveJsonModule",
            ],
            description: Some("Enable importing .json files"),
        ),
        (
            names: [
                "--rootDir",
            ],
            description: Some("Specify the root folder within your source files"),
            arguments: [
                (
                    name: "string",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--rootDirs",
            ],
            description: Some("Allow multiple folders to be treated as one when resolving modules"),
            arguments: [
                (
                    name: "string",
                    template: [
                        Folders,
                    ],
                    variadic: true,
                ),
            ],
        ),
        (
            names: [
                "--skipDefaultLibCheck",
            ],
            description: Some("Skip type checking .d.ts files that are included with TypeScript"),
        ),
        (
            names: [
                "--skipLibCheck",
            ],
            description: Some("Skip type checking all .d.ts files"),
        ),
        (
            names: [
                "--sourceMap",
            ],
            description: Some("Create source map files for emitted JavaScript files"),
        ),
        (
            names: [
                "--sourceRoot",
            ],
            description: Some("Specify the root path for debuggers to find the reference source code"),
            arguments: [
                (
                    name: "string",
                    template: [
                        FilePaths,
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--strict",
            ],
            description: Some("Enable all strict type checking options"),
        ),
        (
            names: [
                "--strictBindCallApply",
            ],
            description: Some("Check that the arguments for bind, call, and apply methods match the original function"),
        ),
        (
            names: [
                "--strictFunctionTypes",
            ],
            description: Some("When assigning functions, check to ensure parameters and the return values are subtype-compatible"),
        ),
        (
            names: [
                "--strictNullChecks",
            ],
            description: Some("When type checking, take into account null and undefined"),
        ),
        (
            names: [
                "--strictPropertyInitialization",
            ],
            description: Some("Check for class properties that are declared but not set in the constructor"),
        ),
        (
            names: [
                "--stripInternal",
            ],
            description: Some("Disable emitting declarations that have @internal in their JSDoc comments"),
        ),
        (
            names: [
                "--suppressExcessPropertyErrors",
            ],
            description: Some("Disable reporting of excess property errors during the creation of object literals"),
        ),
        (
            names: [
                "--suppressImplicitAnyIndexErrors",
            ],
            description: Some("Suppress noImplicitAny errors when indexing objects that lack index signatures"),
        ),
        (
            names: [
                "--target",
            ],
            description: Some("Set the JavaScript language version for emitted JavaScript and include compatible library declarations"),
            arguments: [
                (
                    name: "",
                    suggestions: [
                        (
                            name: "ES3",
                        ),
                        (
                            name: "ES5",
                        ),
                        (
                            name: "ES6",
                        ),
                        (
                            name: "ES2015",
                        ),
                        (
                            name: "ES7",
                        ),
                        (
                            name: "ES2016",
                        ),
                        (
                            name: "ES2017",
                        ),
                        (
                            name: "ES2018",
                        ),
                        (
                            name: "ES2019",
                        ),
                        (
                            name: "ES2020",
                        ),
                        (
                            name: "ESNext",
                        ),
                    ],
                    default: Some("ES3"),
                ),
            ],
        ),
        (
            names: [
                "--traceResolution",
            ],
            description: Some("Log paths used during the moduleResolution process"),
        ),
        (
            names: [
                "--tsBuildInfoFile",
            ],
            description: Some("Specify the folder for .tsbuildinfo incremental compilation files"),
            arguments: [
                (
                    name: "string",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--typeRoots",
            ],
            description: Some("Specify multiple folders that act like ./node_modules/@types"),
            arguments: [
                (
                    name: "folders",
                    template: [
                        Folders,
                    ],
                    variadic: true,
                ),
            ],
        ),
        (
            names: [
                "--types",
            ],
            description: Some("Specify type package names to be included without being referenced in a source file"),
            arguments: [
                (
                    name: "package names",
                    variadic: true,
                ),
            ],
        ),
        (
            names: [
                "--useDefineForClassFields",
            ],
            description: Some("Emit ECMAScript-standard-compliant class fields"),
        ),
        (
            names: [
                "--useUnknownInCatchVariables",
            ],
            description: Some("Default catch clause variables as unknown instead of any"),
        ),
    ],
    arguments: [
        (
            name: "tsc script",
            generators: [
                (
                    has_custom: true,
                    has_dynamic_trigger: true,
                    has_dynamic_query_term: true,
                ),
            ],
            is_script: true,
        ),
    ],
)
