(
    version: 1,
    command: "http.server",
    options: [
        (
            names: [
                "-d",
                "--directory",
            ],
            description: Some("Choose the directory to initiate the server from"),
            arguments: [
                (
                    name: "",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-b",
                "--bind",
            ],
            description: Some("Bind to a specific IP address"),
            arguments: [
                (
                    name: "IP Address",
                    description: Some("E.g. 127.0.0.1"),
                ),
            ],
        ),
        (
            names: [
                "--cgi",
            ],
            description: Some("Enable the CGIHTTPRequestHandler"),
        ),
    ],
    arguments: [
        (
            name: "port",
            description: Some("Port number"),
        ),
    ],
)
