(
    version: 1,
    command: "top",
    description: Some("Display Linux tasks"),
    options: [
        (
            names: [
                "-h",
                "-v",
            ],
            description: Some("Show library version and usage prompt"),
        ),
        (
            names: [
                "-b",
            ],
            description: Some("Starts top in Batch mode"),
            arguments: [
                (
                    name: "operation",
                ),
            ],
        ),
        (
            names: [
                "-c",
            ],
            description: Some("Starts top with last remembered c state reversed"),
            arguments: [
                (
                    name: "toggle",
                ),
            ],
        ),
        (
            names: [
                "-i",
            ],
            description: Some("Starts top with the last remembered 'i' state reversed. When this toggle is Off, tasks that are idled or zombied will not be displayed"),
            arguments: [
                (
                    name: "toggle",
                ),
            ],
        ),
        (
            names: [
                "-s",
            ],
            description: Some("Starts top with secure mode forced"),
            arguments: [
                (
                    name: "delay",
                ),
            ],
        ),
        (
            names: [
                "-pid",
            ],
            description: Some("Monitor pids"),
            arguments: [
                (
                    name: "process ids",
                    variadic: true,
                ),
            ],
        ),
    ],
)
