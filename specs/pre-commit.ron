(
    version: 1,
    command: "pre-commit",
    description: Some("Pre-commit"),
    subcommands: [
        (
            name: "autoupdate",
            description: Some("Auto-update pre-commit config to the latest repos' versions"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Show help message and exit"),
                ),
                (
                    names: [
                        "--color",
                    ],
                    description: Some("Whether to use color in output. Defaults to `auto`"),
                    arguments: [
                        (
                            name: "color",
                            suggestions: [
                                (
                                    name: "auto",
                                ),
                                (
                                    name: "always",
                                ),
                                (
                                    name: "never",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--config",
                        "-c",
                    ],
                    description: Some("Path to alternate config file"),
                    arguments: [
                        (
                            name: "CONFIG",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--bleeding-edge",
                    ],
                    description: Some("Update to the bleeding edge of `master` instead of the latest tagged version (the default behavior)"),
                ),
                (
                    names: [
                        "--freeze",
                    ],
                    description: Some("Store 'frozen' hashes in `rev` instead of tag names"),
                ),
                (
                    names: [
                        "--repo",
                    ],
                    description: Some("Only update this repository -- may be specified multiple times"),
                    arguments: [
                        (
                            name: "REPO",
                        ),
                    ],
                    repeat: Many,
                ),
            ],
        ),
        (
            name: "clean",
            description: Some("Clean out pre-commit files"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Show help message and exit"),
                ),
                (
                    names: [
                        "--color",
                    ],
                    description: Some("Whether to use color in output. Defaults to `auto`"),
                    arguments: [
                        (
                            name: "color",
                            suggestions: [
                                (
                                    name: "auto",
                                ),
                                (
                                    name: "always",
                                ),
                                (
                                    name: "never",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--config",
                        "-c",
                    ],
                    description: Some("Path to alternate config file"),
                    arguments: [
                        (
                            name: "CONFIG",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "gc",
            description: Some("Clean unused cached repos"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
