                                    name: "post-rewrite",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--remote-branch",
                    ],
                    description: Some("Remote branch ref used by `git push`"),
                    arguments: [
                        (
                            name: "REMOTE_BRANCH",
                            generators: [
                                (
                                    script: [
                                        "git",
                                        "--no-optional-locks",
                                        "branch",
                                        "-a",
                                        "--no-color",
                                        "--sort=-committerdate",
                                    ],
                                    has_post_process: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--local-branch",
                    ],
                    description: Some("Local branch ref used by `git push`"),
                    arguments: [
                        (
                            name: "LOCAL_BRANCH",
                            generators: [
                                (
                                    script: [
                                        "git",
                                        "--no-optional-locks",
                                        "branch",
                                        "--no-color",
                                        "--sort=-committerdate",
                                    ],
                                    has_post_process: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--from-ref",
                        "--source",
                        "-s",
                    ],
                    description: Some("Represents the original ref in a `from_ref...to_ref` diff expression. For `pre-push` hooks, this represents the branch you are pushing to. For `post-checkout` hooks, this represents the branch that was previously checked out"),
                    arguments: [
                        (
                            name: "FROM_REF",
                            generators: [
                                (
                                    script: [
                                        "git",
                                        "rev-list",
                                        "--all",
                                        "--oneline",
                                    ],
                                    has_post_process: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--to-ref",
                        "--origin",
                        "-o",
                    ],
                    description: Some("Represents the destination ref in a `from_ref...to_ref` diff expression. For `pre-push` hooks, this represents the branch being pushed. For `post-checkout` hooks, this represents the branch that is now checked out"),
                    arguments: [
                        (
                            name: "TO_REF",
                            generators: [
                                (
                                    script: [
                                        "git",
                                        "rev-list",
                                        "--all",
