                    names: [
                        "--remote-url",
                    ],
                    description: Some("Remote URL used by `git push`"),
                    arguments: [
                        (
                            name: "REMOTE_URL",
                        ),
                    ],
                ),
                (
                    names: [
                        "--checkout-type",
                    ],
                    description: Some("Indicates whether the checkout was a branch checkout (changing branches, flag=1) or a file checkout (retrieving a file from the index, flag=0)"),
                    arguments: [
                        (
