                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--verbose",
                        "-v",
                    ],
                ),
                (
                    names: [
                        "--all-files",
                        "-a",
                    ],
                    description: Some("Run all files in the repo"),
                ),
                (
                    names: [
                        "--files",
                    ],
                    description: Some("Specific filenames to run hooks on"),
                    arguments: [
                        (
                            name: "FILES",
                            template: [
                                FilePaths,
                                Folders,
                            ],
                            variadic: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--show-diff-on-failure",
                    ],
                    description: Some("When hooks fail, run `git diff` directly afterward"),
                ),
                (
                    names: [
                        "--hook-stage",
                    ],
                    description: Some("The stage during which the hook is fired"),
                    arguments: [
                        (
                            name: "",
                            suggestions: [
                                (
                                    name: "pre-commit",
                                ),
                                (
                                    name: "pre-merge-commit",
                                ),
                                (
                                    name: "pre-push",
                                ),
