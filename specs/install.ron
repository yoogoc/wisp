(
    version: 1,
    command: "install",
    description: Some("The file(s) are copied to the target file or directory. If the destination is a directory, then the file is copied into directory with its original filename. If the target file already exists, it is either renamed to file.old if the -b option is given or overwritten if permissions allow. An alternate backup suffix may be specified via the -B option\'s argument"),
    subcommands: [],
    options: [
        (
            names: [
                "-B",
            ],
            description: Some("Use suffix as the backup suffix if -b is given"),
            takes_value: true,
            arguments: [
                (
                    name: "suffix",
                    source: Files,
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "-b",
            ],
            description: Some("Back up any existing files before overwriting them by renaming them to file.old. See -B for specifying a different backup suffix"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-C",
            ],
            description: Some("Copy the file.  If the target file already exists and the files are the same, then don\'t change the modification time of the target"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-c",
            ],
            description: Some("Copy the file.  This is actually the default.  The -c option is only included for backwards compatibility"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-d",
            ],
            description: Some("Create directories.  Missing parent directories are created as required"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-f",
            ],
            description: Some("Specify the target\'s file flags; see chflags(1) for a list of possible flags and their meanings"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-g",
            ],
            description: Some("Specify a group. A numeric GID is allowed"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-M",
            ],
            description: Some("Disable all use of mmap(2)"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-m",
            ],
            description: Some("Specify an alternate mode.  The default mode is set to rwxr-xr-x (0755). The specified mode may be either an octal or symbolic value; see chmod(1) for a description of possible mode values"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-o",
            ],
            description: Some("Specify an owner. A numeric UID is allowed"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-p",
            ],
            description: Some("Preserve the modification time. Copy the file, as if the -C (compare and copy) option is specified, except if the target file doesn\'t already exist or is different, then preserve the modification time of the file"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-S",
            ],
            description: Some("Safe copy. Normally, install unlinks an existing target before installing the new file. With the -S flag a temporary file is used and then renamed to be the target. The reason this is safer is that if the copy or rename fails, the existing target is left untouched"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-s",
            ],
            description: Some("Exec\'s the command strip(1) to strip binaries so that install can be portable over a large number of systems and binary types"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-v",
            ],
            description: Some("Causes install to show when -C actually installs something"),
            takes_value: false,
            arguments: [],
        ),
    ],
    arguments: [
        (
            name: "file1 file2 | file1 ... fileN directory | directory ...",
            source: Directories,
            optional: false,
            variadic: false,
            imported_generator: None,
        ),
    ],
)