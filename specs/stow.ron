(
    version: 1,
    command: "stow",
    description: Some("Manage farms of symbolic links"),
    subcommands: [],
    options: [
        (
            names: [
                "-n",
                "--no",
            ],
            description: Some("Do not perform any operations that modify the filesystem; merely show what would happen"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-d",
                "--dir",
            ],
            description: Some("Set the stow directory to \'DIR\' instead of the current directory. This also has the effect of making the default target directory be the parent of \'DIR\'"),
            takes_value: true,
            arguments: [
                (
                    name: "DIR",
                    source: Directories,
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "-t",
                "--target",
            ],
            description: Some("Set the target directory to \'DIR\' instead of the parent of the stow directory"),
            takes_value: true,
            arguments: [
                (
                    name: "DIR",
                    source: Directories,
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "-v",
                "--verbose",
            ],
            description: Some("Send verbose output to standard error describing what Stow is doing. Verbosity levels are from 0 to 5; 0 is the default. Using \'-v\' or \'--verbose\' increases the verbosity by one; using `--verbose=N\' sets it to N"),
            takes_value: true,
            arguments: [
                (
                    name: "level",
                    source: Static([
                        "0",
                        "1",
                        "2",
                        "3",
                        "4",
                        "5",
                    ]),
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "-S",
                "--stow",
            ],
            description: Some("Stow the packages that follow this option into the target directory. This is the default action and so can be omitted if you are only stowing packages rather than performing a mixture of stow/delete/restow actions"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-D",
                "--delete",
            ],
            description: Some("Unstow the packages that follow this option from the target directory rather than installing them"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-R",
                "--restow",
            ],
            description: Some("Restow packages (first unstow, then stow again). This is useful for pruning obsolete symlinks from the target tree after updating the software in a package"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "--adopt",
            ],
            description: Some("This behaviour is specifically intended to alter the contents of your stow directory.  If you do not want that, this option is not for you"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "--no-folding",
            ],
            description: Some("Disable folding of newly stowed directories when stowing, and refolding of newly foldable directories when unstowing"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "--ignore",
            ],
            description: Some("Ignore files ending in this Perl regex"),
            takes_value: true,
            arguments: [
                (
                    name: "REGEX",
                    source: Files,
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "--defer",
            ],
            description: Some("Don\'t stow files beginning with this Perl regex if the file is already stowed to another package"),
            takes_value: true,
            arguments: [
                (
                    name: "REGEX",
                    source: Files,
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "--override",
            ],
            description: Some("Force stowing files beginning with this Perl regex if the file is already stowed to another package"),
            takes_value: true,
            arguments: [
                (
                    name: "REGEX",
                    source: Files,
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "--dotfiles",
            ],
            description: Some("Enable special handling for \'dotfiles\' (files or folders whose name begins with a period) in the package directory. If this option is enabled, Stow will add a preprocessing step for each file or folder whose name begins with \'dot - \', and replace the \'dot- \' prefix in the name by a period (.). This is useful when Stow is used to manage collections of dotfiles, to avoid having a package directory full of hidden files"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-V",
                "--version",
            ],
            description: Some("Show Stow version, and exit"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Show Stow command syntax, and exit"),
            takes_value: false,
            arguments: [],
        ),
    ],
    arguments: [],
)