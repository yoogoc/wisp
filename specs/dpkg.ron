(
    version: 1,
    command: "dpkg",
    description: Some("Debian package management system"),
    subcommands: [
        (
            name: "query",
            description: Some("Query the dpkg database"),
            options: [
                (
                    names: [
                        "-l",
                        "--list",
                    ],
                    description: Some("List packages matching a pattern"),
                    arguments: [
                        (
                            name: "pattern",
                        ),
                    ],
                ),
                (
                    names: [
                        "-s",
                        "--status",
                    ],
                    description: Some("Display the status of available packages"),
                    arguments: [
                        (
                            name: "package",
                        ),
                    ],
                ),
                (
                    names: [
                        "-L",
                        "--listfiles",
                    ],
                    description: Some("List files in a package"),
                    arguments: [
                        (
                            name: "package",
                        ),
                    ],
                ),
                (
                    names: [
                        "-S",
                        "--search",
                    ],
                    description: Some("Search for a package owning a file"),
                    arguments: [
                        (
                            name: "file",
                        ),
                    ],
                ),
                (
                    names: [
                        "-p",
                        "--print-avail",
                    ],
                    description: Some("Display details about a package in the dpkg database"),
                    arguments: [
                        (
                            name: "package",
                        ),
                    ],
                ),
                (
                    names: [
                        "-W",
                        "--show",
                    ],
                    description: Some("Show a package in the dpkg database"),
                    arguments: [
                        (
                            name: "package",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "install",
            description: Some("Install or upgrade packages"),
            options: [
                (
                    names: [
                        "-R",
                        "--recursive",
                    ],
                    description: Some("Recursively handle packages"),
                ),
                (
                    names: [
                        "-B",
                        "--auto-deconfigure",
                    ],
                    description: Some("Uninstall packages that depend on the target package"),
                ),
                (
                    names: [
                        "--skip-same-version",
                    ],
                    description: Some("Don't upgrade if the same version is already installed"),
                ),
                (
                    names: [
                        "--force-depends",
                    ],
                    description: Some("Ignore dependency problems"),
                ),
                (
                    names: [
                        "--force-confnew",
                    ],
                    description: Some("Always install the new version of configuration files"),
                ),
                (
                    names: [
                        "--force-confold",
                    ],
                    description: Some("Always install the old version of configuration files"),
                ),
                (
                    names: [
                        "--force-confdef",
                    ],
                    description: Some("Always install the default version of configuration files"),
                ),
                (
                    names: [
                        "--force-confmiss",
                    ],
                    description: Some("Always install missing configuration files"),
                ),
                (
                    names: [
                        "--no-triggers",
                    ],
                    description: Some("Skip processing triggers"),
                ),
                (
                    names: [
                        "--no-act",
                    ],
                    description: Some("Simulate the action, but don't execute"),
                ),
            ],
            arguments: [
                (
                    name: "package",
                ),
            ],
        ),
        (
            name: "remove",
            description: Some("Remove packages"),
            options: [
                (
                    names: [
                        "-R",
                        "--recursive",
                    ],
                    description: Some("Recursively remove packages"),
                ),
                (
                    names: [
                        "-B",
                        "--auto-deconfigure",
                    ],
                    description: Some("Uninstall packages that depend on the target package"),
                ),
                (
                    names: [
                        "--no-act",
                    ],
                    description: Some("Simulate the action, but don't execute"),
                ),
            ],
            arguments: [
                (
                    name: "package",
                ),
            ],
        ),
        (
            name: "purge",
            description: Some("Remove packages and their configuration files"),
            options: [
                (
                    names: [
                        "-R",
                        "--recursive",
                    ],
                    description: Some("Recursively remove packages"),
                ),
                (
                    names: [
                        "--no-act",
                    ],
                    description: Some("Simulate the action, but don't execute"),
                ),
            ],
            arguments: [
                (
                    name: "package",
                ),
            ],
        ),
        (
            name: "configure",
            description: Some("Configure a package after installation"),
            options: [
                (
                    names: [
                        "--pending",
                    ],
                    description: Some("Configure all unconfigured packages"),
                ),
                (
                    names: [
                        "--no-triggers",
                    ],
                    description: Some("Skip processing triggers"),
                ),
                (
                    names: [
                        "--no-act",
                    ],
                    description: Some("Simulate the action, but don't execute"),
                ),
            ],
            arguments: [
                (
                    name: "package",
                ),
            ],
        ),
        (
            name: "reconfigure",
            description: Some("Reconfigure a package"),
            options: [
                (
                    names: [
                        "--no-triggers",
                    ],
                    description: Some("Skip processing triggers"),
                ),
                (
                    names: [
                        "--no-act",
                    ],
                    description: Some("Simulate the action, but don't execute"),
                ),
            ],
            arguments: [
                (
                    name: "package",
                ),
            ],
        ),
        (
            name: "list",
            description: Some("List packages in the dpkg database"),
            options: [
                (
                    names: [
                        "-l",
                        "--list",
                    ],
                    description: Some("List packages matching a pattern"),
                    arguments: [
                        (
                            name: "pattern",
                        ),
                    ],
                ),
                (
                    names: [
                        "-s",
                        "--status",
                    ],
                    description: Some("Display the status of available packages"),
                    arguments: [
                        (
                            name: "package",
                        ),
                    ],
                ),
                (
                    names: [
                        "-L",
                        "--listfiles",
                    ],
                    description: Some("List files in a package"),
                    arguments: [
                        (
                            name: "package",
                        ),
                    ],
                ),
                (
                    names: [
                        "-S",
                        "--search",
                    ],
                    description: Some("Search for a package owning a file"),
                    arguments: [
                        (
                            name: "file",
                        ),
                    ],
                ),
                (
                    names: [
                        "-p",
                        "--print-avail",
                    ],
                    description: Some("Display details about a package in the dpkg database"),
                    arguments: [
                        (
                            name: "package",
                        ),
                    ],
                ),
                (
                    names: [
                        "-W",
                        "--show",
                    ],
                    description: Some("Show a package in the dpkg database"),
                    arguments: [
                        (
                            name: "package",
                        ),
                    ],
                ),
                (
                    names: [
                        "--installed",
                    ],
                    description: Some("List installed packages"),
                ),
                (
                    names: [
                        "--avail",
                    ],
                    description: Some("List available packages"),
                ),
                (
                    names: [
                        "--hold",
                    ],
                    description: Some("List packages on hold"),
                ),
                (
                    names: [
                        "--deferred",
                    ],
                    description: Some("List deferred packages"),
                ),
            ],
        ),
        (
            name: "builddeb",
            description: Some("Build Debian package files from sources"),
            options: [
                (
                    names: [
                        "-us",
                        "--unsigned",
                    ],
                    description: Some("Build unsigned .changes and .dsc files"),
                ),
                (
                    names: [
                        "-uc",
                        "--unsigned-changes",
                    ],
                    description: Some("Build unsigned .changes file"),
                ),
                (
                    names: [
                        "-sa",
                        "--source",
                    ],
                    description: Some("Build source package"),
                ),
                (
                    names: [
                        "-rfakeroot",
                    ],
                    description: Some("Use fakeroot when building the package"),
                ),
                (
                    names: [
                        "-b",
                        "--binary",
                    ],
                    description: Some("Build binary package from source"),
                ),
                (
                    names: [
                        "--force-sign",
                    ],
                    description: Some("Force signing of changes file"),
                ),
                (
                    names: [
                        "-m",
                        "--maintainer",
                    ],
                    description: Some("Specify the package maintainer"),
                    arguments: [
                        (
                            name: "email",
                        ),
                    ],
                ),
                (
                    names: [
                        "-c",
                        "--changes",
                    ],
                    description: Some("Specify the changes file to use"),
                    arguments: [
                        (
                            name: "file",
                        ),
                    ],
                ),
                (
                    names: [
                        "-v",
                        "--version",
                    ],
                    description: Some("Specify the version to use"),
                    arguments: [
                        (
                            name: "version",
                        ),
                    ],
                ),
                (
                    names: [
                        "--increment",
                    ],
                    description: Some("Increment the version number in the changelog"),
                ),
            ],
            arguments: [
                (
                    name: "directory",
                ),
            ],
        ),
        (
            name: "check",
            description: Some("Check the dependencies of packages"),
            options: [
                (
                    names: [
                        "-a",
                        "--all",
                    ],
                    description: Some("Check all installed packages"),
                ),
                (
                    names: [
                        "-d",
                        "--unmet",
                    ],
                    description: Some("Check for unmet dependencies"),
                ),
                (
                    names: [
                        "-i",
                        "--check-installed",
                    ],
                    description: Some("Check installed packages"),
                ),
                (
                    names: [
                        "-U",
                        "--check-unpacked",
                    ],
                    description: Some("Check unpacked packages"),
                ),
                (
                    names: [
                        "-c",
                        "--nocheck",
                    ],
                    description: Some("Skip checking for broken dependencies"),
                ),
                (
                    names: [
                        "-r",
                        "--reverse",
                    ],
                    description: Some("Check reverse dependencies"),
                ),
            ],
            arguments: [
                (
                    name: "package",
                    optional: true,
                ),
            ],
        ),
        (
            name: "compare-versions",
            description: Some("Compare package versions"),
            arguments: [
                (
                    name: "version1",
                ),
                (
                    name: "relation",
                    suggestions: [
                        (
                            name: "lt",
                        ),
                        (
                            name: "le",
                        ),
                        (
                            name: "eq",
                        ),
                        (
                            name: "ne",
                        ),
                        (
                            name: "gt",
                        ),
                        (
                            name: "ge",
                        ),
                    ],
                    optional: true,
                ),
                (
                    name: "version2",
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Help for dpkg"),
        ),
    ],
)
