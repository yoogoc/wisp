(
    version: 1,
    command: "uv",
    description: Some("An extremely fast Python package manager"),
    subcommands: [
        (
            name: "run",
            description: Some("Run a command or script"),
            options: [
                (
                    names: [
                        "--extra",
                    ],
                    description: Some("Include optional dependencies from the specified extra name"),
                    arguments: [
                        (
                            name: "EXTRA",
                        ),
                    ],
                ),
                (
                    names: [
                        "--all-extras",
                    ],
                    description: Some("Include all optional dependencies"),
                ),
                (
                    names: [
                        "--no-extra",
                    ],
                    description: Some("Exclude the specified optional dependencies, if `--all-extras` is supplied"),
                    arguments: [
                        (
                            name: "NO_EXTRA",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-dev",
                    ],
                    description: Some("Omit the development dependency group"),
                ),
                (
                    names: [
                        "--group",
                    ],
                    description: Some("Include dependencies from the specified dependency group"),
                    arguments: [
                        (
                            name: "GROUP",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-group",
                    ],
                    description: Some("Exclude dependencies from the specified dependency group"),
                    arguments: [
                        (
                            name: "NO_GROUP",
                        ),
                    ],
                ),
                (
                    names: [
                        "--only-group",
                    ],
                    description: Some("Only include dependencies from the specified dependency group"),
                    arguments: [
                        (
                            name: "ONLY_GROUP",
                        ),
                    ],
                ),
                (
                    names: [
                        "--all-groups",
                    ],
                    description: Some("Include dependencies from all dependency groups"),
                ),
                (
                    names: [
                        "-m",
                        "--module",
                    ],
                    description: Some("Run a Python module"),
                ),
                (
                    names: [
                        "--only-dev",
                    ],
                    description: Some("Only include the development dependency group"),
                ),
                (
                    names: [
                        "--no-editable",
                    ],
                    description: Some("Install any editable dependencies, including the project and any workspace members, as non-editable"),
                ),
                (
                    names: [
                        "--env-file",
                    ],
                    description: Some("Load environment variables from a `.env` file"),
                    arguments: [
                        (
                            name: "ENV_FILE",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-env-file",
                    ],
                    description: Some("Avoid reading environment variables from a `.env` file"),
                ),
                (
                    names: [
                        "--with",
                    ],
                    description: Some("Run with the given packages installed"),
                    arguments: [
                        (
                            name: "WITH",
                        ),
                    ],
                ),
                (
                    names: [
                        "--with-editable",
                    ],
                    description: Some("Run with the given packages installed as editables"),
                    arguments: [
                        (
                            name: "WITH_EDITABLE",
                        ),
                    ],
                ),
                (
                    names: [
                        "--with-requirements",
                    ],
                    description: Some("Run with all packages listed in the given `requirements.txt` files"),
                    arguments: [
                        (
                            name: "WITH_REQUIREMENTS",
                        ),
                    ],
                ),
                (
                    names: [
                        "--isolated",
                    ],
                    description: Some("Run the command in an isolated virtual environment"),
                ),
                (
                    names: [
                        "--no-sync",
                    ],
                    description: Some("Avoid syncing the virtual environment"),
                ),
                (
                    names: [
                        "--locked",
                    ],
                    description: Some("Assert that the `uv.lock` will remain unchanged"),
                ),
                (
                    names: [
                        "--frozen",
                    ],
                    description: Some("Run without updating the `uv.lock` file"),
                ),
                (
                    names: [
                        "-s",
                        "--script",
                    ],
                    description: Some("Run the given path as a Python script"),
                ),
                (
                    names: [
                        "--all-packages",
                    ],
                    description: Some("Run the command with all workspace members installed"),
                ),
                (
                    names: [
                        "--package",
                    ],
                    description: Some("Run the command in a specific package in the workspace"),
                    arguments: [
                        (
                            name: "PACKAGE",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-project",
                    ],
                    description: Some("Avoid discovering the project or workspace"),
                ),
            ],
            arguments: [
                (
                    name: "command",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "uv run | grep -E '^- ' | sed 's/^- //'",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "init",
            description: Some("Create a new project"),
            options: [
                (
                    names: [
                        "--name",
                    ],
                    description: Some("The name of the project"),
                    arguments: [
                        (
                            name: "NAME",
                        ),
                    ],
                ),
                (
                    names: [
                        "--package",
                    ],
                    description: Some("Set up the project to be built as a Python package"),
                ),
                (
                    names: [
                        "--no-package",
                    ],
                    description: Some("Do not set up the project to be built as a Python package"),
                ),
                (
                    names: [
                        "--app",
                    ],
                    description: Some("Create a project for an application"),
                ),
                (
                    names: [
                        "--lib",
                    ],
                    description: Some("Create a project for a library"),
                ),
                (
                    names: [
                        "--script",
                    ],
                    description: Some("Create a script"),
                ),
                (
                    names: [
                        "--vcs",
                    ],
                    description: Some("Initialize a version control system for the project"),
                    arguments: [
                        (
                            name: "VCS",
                            suggestions: [
                                (
                                    name: "git",
                                ),
                                (
                                    name: "none",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--build-backend",
                    ],
                    description: Some("Initialize a build-backend of choice for the project"),
                    arguments: [
                        (
                            name: "BUILD_BACKEND",
                            suggestions: [
                                (
                                    name: "hatch",
                                ),
                                (
                                    name: "flit",
                                ),
                                (
                                    name: "pdm",
                                ),
                                (
                                    name: "setuptools",
                                ),
                                (
                                    name: "maturin",
                                ),
                                (
                                    name: "scikit",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-readme",
                    ],
                    description: Some("Do not create a `README.md` file"),
                ),
                (
                    names: [
                        "--author-from",
                    ],
                    description: Some("Fill in the `authors` field in the `pyproject.toml`"),
                    arguments: [
                        (
                            name: "AUTHOR_FROM",
                            suggestions: [
                                (
                                    name: "auto",
                                ),
                                (
                                    name: "git",
                                ),
                                (
                                    name: "none",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-pin-python",
                    ],
                    description: Some("Do not create a `.python-version` file for the project"),
                ),
                (
                    names: [
                        "--no-workspace",
                    ],
                    description: Some("Avoid discovering a workspace and create a standalone project"),
                ),
                (
                    names: [
                        "-n",
                    ],
                    description: Some("Avoid reading from or writing to the cache, instead using a temporary directory for the duration of the operation"),
                ),
                (
                    names: [
                        "--cache-dir",
                    ],
                    description: Some("Path to the cache directory"),
                    arguments: [
                        (
                            name: "CACHE_DIR",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "Path",
                    description: Some("The path to use for the project/script"),
                    template: [
                        FilePaths,
                    ],
                    default: Some("."),
                ),
            ],
        ),
        (
            name: "add",
            description: Some("Add dependencies to the project"),
            options: [
                (
                    names: [
                        "-r",
                        "--requirements",
                    ],
                    description: Some("Add all packages listed in the given `requirements.txt` files"),
                    arguments: [
                        (
                            name: "REQUIREMENTS",
                        ),
                    ],
                ),
                (
                    names: [
                        "--dev",
                    ],
                    description: Some("Add the requirements to the development dependency group"),
                ),
                (
                    names: [
                        "--optional",
                    ],
                    description: Some("Add the requirements to the package's optional dependencies for the specified extra"),
                    arguments: [
                        (
                            name: "OPTIONAL",
                        ),
                    ],
                ),
                (
                    names: [
                        "--group",
                    ],
                    description: Some("Add the requirements to the specified dependency group"),
                    arguments: [
                        (
                            name: "GROUP",
                        ),
                    ],
                ),
                (
                    names: [
                        "--editable",
                    ],
                    description: Some("Add the requirements as editable"),
                ),
                (
                    names: [
                        "--raw-sources",
                    ],
                    description: Some("Add source requirements to `project.dependencies`, rather than `tool.uv.sources`"),
                ),
                (
                    names: [
                        "--rev",
                    ],
                    description: Some("Commit to use when adding a dependency from Git"),
                    arguments: [
                        (
                            name: "REV",
                        ),
                    ],
                ),
                (
                    names: [
                        "--tag",
                    ],
                    description: Some("Tag to use when adding a dependency from Git"),
                    arguments: [
                        (
                            name: "TAG",
                        ),
                    ],
                ),
                (
                    names: [
                        "--branch",
                    ],
                    description: Some("Branch to use when adding a dependency from Git"),
                    arguments: [
                        (
                            name: "BRANCH",
                        ),
                    ],
                ),
                (
                    names: [
                        "--extra",
                    ],
                    description: Some("Extras to enable for the dependency"),
                    arguments: [
                        (
                            name: "EXTRA",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-sync",
                    ],
                    description: Some("Avoid syncing the virtual environment"),
                    arguments: [
                        (
                            name: "UV_NO_SYNC",
                        ),
                    ],
                ),
                (
                    names: [
                        "--locked",
                    ],
                    description: Some("Assert that the `uv.lock` will remain unchanged"),
                    arguments: [
                        (
                            name: "UV_LOCKED",
                        ),
                    ],
                ),
                (
                    names: [
                        "--frozen",
                    ],
                    description: Some("Add dependencies without re-locking the project"),
                    arguments: [
                        (
                            name: "UV_FROZEN",
                        ),
                    ],
                ),
                (
                    names: [
                        "--package",
                    ],
                    description: Some("Add the dependency to a specific package in the workspace"),
                    arguments: [
                        (
                            name: "PACKAGE",
                        ),
                    ],
                ),
                (
                    names: [
                        "--script",
                    ],
                    description: Some("Add the dependency to the specified Python script, rather than to a project"),
                    arguments: [
                        (
                            name: "SCRIPT",
                        ),
                    ],
                ),
                (
                    names: [
                        "--index",
                    ],
                    description: Some("The URLs to use when resolving dependencies, in addition to the default index"),
                    arguments: [
                        (
                            name: "INDEX",
                        ),
                    ],
                ),
                (
                    names: [
                        "--default-index",
                    ],
                    description: Some("The URL of the default package index (by default: <https://pypi.org/simple>)"),
                    arguments: [
                        (
                            name: "DEFAULT_INDEX",
                        ),
                    ],
                ),
                (
                    names: [
                        "--index-url",
                    ],
                    description: Some("The URL of the Python package index (by default: <https://pypi.org/simple>)"),
                    arguments: [
                        (
                            name: "INDEX_URL",
                        ),
                    ],
                ),
                (
                    names: [
                        "--extra-index-url",
                    ],
                    description: Some("Extra URLs of package indexes to use, in addition to `--index-url`"),
                    arguments: [
                        (
                            name: "EXTRA_INDEX_URL",
                        ),
                    ],
                ),
                (
                    names: [
                        "--find-links",
                    ],
                    description: Some("Locations to search for candidate distributions, in addition to those found in the registry indexes"),
                    arguments: [
                        (
                            name: "FIND_LINKS",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-index",
                    ],
                    description: Some("Ignore the registry index (e.g., PyPI), instead relying on direct URL dependencies and those provided via `--find-links`"),
                ),
                (
                    names: [
                        "--index-strategy",
                    ],
                    description: Some("The strategy to use when resolving against multiple index URLs"),
                    arguments: [
                        (
                            name: "INDEX_STRATEGY",
                            suggestions: [
                                (
                                    name: "first-index",
                                ),
                                (
                                    name: "unsafe-first-match",
                                ),
                                (
                                    name: "unsafe-best-match",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--keyring-provider",
                    ],
                    description: Some("Attempt to use `keyring` for authentication for index URLs"),
                    arguments: [
                        (
                            name: "KEYRING_PROVIDER",
                            suggestions: [
                                (
                                    name: "disabled",
                                ),
                                (
                                    name: "subprocess",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-U",
                    ],
                    description: Some("Allow package upgrades, ignoring pinned versions in any existing output file. Implies `--refresh`"),
                ),
                (
                    names: [
                        "--upgrade-package",
                    ],
                    description: Some("Allow upgrades for a specific package, ignoring pinned versions in any existing output file. Implies `--refresh-package`"),
                    arguments: [
                        (
                            name: "UPGRADE_PACKAGE",
                        ),
                    ],
                ),
                (
                    names: [
                        "--resolution",
                    ],
                    description: Some("The strategy to use when selecting between the different compatible versions for a given package requirement"),
                    arguments: [
                        (
                            name: "RESOLUTION",
                            suggestions: [
                                (
                                    name: "highest",
                                ),
                                (
                                    name: "lowest",
                                ),
                                (
                                    name: "lowest-direct",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--prerelease",
                    ],
                    description: Some("The strategy to use when considering pre-release versions"),
                    arguments: [
                        (
                            name: "PRERELEASE",
                            suggestions: [
                                (
                                    name: "disallow",
                                ),
                                (
                                    name: "allow",
                                ),
                                (
                                    name: "if-necessary",
                                ),
                                (
                                    name: "explicit",
                                ),
                                (
                                    name: "if-necessary-or-explicit",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--exclude-newer",
                    ],
                    description: Some("Limit candidate packages to those that were uploaded prior to the given date"),
                    arguments: [
                        (
                            name: "EXCLUDE_NEWER",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-sources",
                    ],
                    description: Some("Ignore the `tool.uv.sources` table when resolving dependencies. Used to lock against the standards-compliant, publishable package metadata, as opposed to using any local or Git sources"),
                ),
                (
                    names: [
                        "--reinstall",
                    ],
                    description: Some("Reinstall all packages, regardless of whether they're already installed. Implies `--refresh`"),
                ),
                (
                    names: [
                        "--reinstall-package",
                    ],
                    description: Some("Reinstall a specific package, regardless of whether it's already installed. Implies `--refresh-package`"),
                    arguments: [
                        (
                            name: "REINSTALL_PACKAGE",
                        ),
                    ],
                ),
                (
                    names: [
                        "--link-mode",
                    ],
                    description: Some("The method to use when installing packages from the global cache"),
                    arguments: [
                        (
                            name: "LINK_MODE",
                            suggestions: [
                                (
                                    name: "clone",
                                ),
                                (
                                    name: "copy",
                                ),
                                (
                                    name: "hardlink",
                                ),
                                (
                                    name: "symlink",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--compile-bytecode",
                    ],
                    description: Some("Compile Python files to bytecode after installation"),
                ),
                (
                    names: [
                        "-C",
                    ],
                    description: Some("Settings to pass to the PEP 517 build backend, specified as `KEY=VALUE` pairs"),
                    arguments: [
                        (
                            name: "CONFIG_SETTING",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-build-isolation",
                    ],
                    description: Some("Disable isolation when building source distributions"),
                    arguments: [
                        (
                            name: "UV_NO_BUILD_ISOLATION",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-build-isolation-package",
                    ],
                    description: Some("Disable isolation when building source distributions for a specific package"),
                    arguments: [
                        (
                            name: "NO_BUILD_ISOLATION_PACKAGE",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-build",
                    ],
                    description: Some("Don't build source distributions"),
                ),
                (
                    names: [
                        "--no-build-package",
                    ],
                    description: Some("Don't build source distributions for a specific package"),
                    arguments: [
                        (
                            name: "NO_BUILD_PACKAGE",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-binary",
                    ],
                    description: Some("Don't install pre-built wheels"),
                ),
                (
                    names: [
                        "--no-binary-package",
                    ],
                    description: Some("Don't install pre-built wheels for a specific package"),
                    arguments: [
                        (
                            name: "NO_BINARY_PACKAGE",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-cache",
                    ],
                    description: Some("Avoid reading from or writing to the cache, instead using a temporary directory for the duration of the operation"),
                ),
                (
                    names: [
                        "--cache-dir",
                    ],
                    description: Some("Path to the cache directory"),
                    arguments: [
                        (
                            name: "CACHE_DIR",
                        ),
                    ],
                ),
                (
                    names: [
                        "--refresh",
                    ],
                    description: Some("Refresh all cached data"),
                ),
                (
                    names: [
                        "--refresh-package",
                    ],
                    description: Some("Refresh cached data for a specific package"),
                    arguments: [
                        (
                            name: "REFRESH_PACKAGE",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "packages",
                    description: Some("Packages to add"),
                    variadic: true,
                ),
            ],
        ),
        (
            name: "remove",
            description: Some("Remove dependencies from the project"),
            options: [
                (
                    names: [
                        "--dev",
                    ],
                    description: Some("Remove the packages from the development dependency group"),
                ),
                (
                    names: [
                        "--optional",
                    ],
                    description: Some("Remove the packages from the project's optional dependencies for the specified extra"),
                    arguments: [
                        (
                            name: "OPTIONAL",
                        ),
                    ],
                ),
                (
                    names: [
                        "--group",
                    ],
                    description: Some("Remove the packages from the specified dependency group"),
                    arguments: [
                        (
                            name: "GROUP",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-sync",
                    ],
                    description: Some("Avoid syncing the virtual environment after re-locking the project"),
                    arguments: [
                        (
                            name: "UV_NO_SYNC",
                        ),
                    ],
                ),
                (
                    names: [
                        "--locked",
                    ],
                    description: Some("Assert that the `uv.lock` will remain unchanged"),
                    arguments: [
                        (
                            name: "UV_LOCKED",
                        ),
                    ],
                ),
                (
                    names: [
                        "--frozen",
                    ],
                    description: Some("Remove dependencies without re-locking the project"),
                    arguments: [
                        (
                            name: "UV_FROZEN",
                        ),
                    ],
                ),
                (
                    names: [
                        "--package",
                    ],
                    description: Some("Remove the dependencies from a specific package in the workspace"),
                    arguments: [
                        (
                            name: "PACKAGE",
                        ),
                    ],
                ),
                (
                    names: [
                        "--script",
                    ],
                    description: Some("Remove the dependency from the specified Python script, rather than from a project"),
                    arguments: [
                        (
                            name: "SCRIPT",
                        ),
                    ],
                ),
                (
                    names: [
                        "--index",
                    ],
                    description: Some("The URLs to use when resolving dependencies, in addition to the default index"),
                    arguments: [
                        (
                            name: "INDEX",
                        ),
                    ],
                ),
                (
                    names: [
                        "--default-index",
                    ],
                    description: Some("The URL of the default package index (by default: <https://pypi.org/simple>)"),
                    arguments: [
                        (
                            name: "DEFAULT_INDEX",
                        ),
                    ],
                ),
                (
                    names: [
                        "--index-url",
                    ],
                    description: Some("The URL of the Python package index (by default: <https://pypi.org/simple>)"),
                    arguments: [
                        (
                            name: "INDEX_URL",
                        ),
                    ],
                ),
                (
                    names: [
                        "--extra-index-url",
                    ],
                    description: Some("Extra URLs of package indexes to use, in addition to `--index-url`"),
                    arguments: [
                        (
                            name: "EXTRA_INDEX_URL",
                        ),
                    ],
                ),
                (
                    names: [
                        "--find-links",
                    ],
                    description: Some("Locations to search for candidate distributions, in addition to those found in the registry indexes"),
                    arguments: [
                        (
                            name: "FIND_LINKS",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-index",
                    ],
                    description: Some("Ignore the registry index (e.g., PyPI), instead relying on direct URL dependencies and those provided via `--find-links`"),
                ),
                (
                    names: [
                        "--index-strategy",
                    ],
                    description: Some("The strategy to use when resolving against multiple index URLs"),
                    arguments: [
                        (
                            name: "INDEX_STRATEGY",
                            suggestions: [
                                (
                                    name: "first-index",
                                ),
                                (
                                    name: "unsafe-first-match",
                                ),
                                (
                                    name: "unsafe-best-match",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--keyring-provider",
                    ],
                    description: Some("Attempt to use `keyring` for authentication for index URLs"),
                    arguments: [
                        (
                            name: "KEYRING_PROVIDER",
                            suggestions: [
                                (
                                    name: "disabled",
                                ),
                                (
                                    name: "subprocess",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-U",
                    ],
                    description: Some("Allow package upgrades, ignoring pinned versions in any existing output file. Implies `--refresh`"),
                ),
                (
                    names: [
                        "--upgrade-package",
                    ],
                    description: Some("Allow upgrades for a specific package, ignoring pinned versions in any existing output file. Implies `--refresh-package`"),
                    arguments: [
                        (
                            name: "UPGRADE_PACKAGE",
                        ),
                    ],
                ),
                (
                    names: [
                        "--resolution",
                    ],
                    description: Some("The strategy to use when selecting between the different compatible versions for a given package requirement"),
                    arguments: [
                        (
                            name: "RESOLUTION",
                            suggestions: [
                                (
                                    name: "highest",
                                ),
                                (
                                    name: "lowest",
                                ),
                                (
                                    name: "lowest-direct",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--prerelease",
                    ],
                    description: Some("The strategy to use when considering pre-release versions"),
                    arguments: [
                        (
                            name: "PRERELEASE",
                            suggestions: [
                                (
                                    name: "disallow",
                                ),
                                (
                                    name: "allow",
                                ),
                                (
                                    name: "if-necessary",
                                ),
                                (
                                    name: "explicit",
                                ),
                                (
                                    name: "if-necessary-or-explicit",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--exclude-newer",
                    ],
                    description: Some("Limit candidate packages to those that were uploaded prior to the given date"),
                    arguments: [
                        (
                            name: "EXCLUDE_NEWER",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-sources",
                    ],
                    description: Some("Ignore the `tool.uv.sources` table when resolving dependencies. Used to lock against the standards-compliant, publishable package metadata, as opposed to using any local or Git sources"),
                ),
                (
                    names: [
                        "--reinstall",
                    ],
