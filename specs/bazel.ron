(
    version: 1,
    command: "bazel",
    description: Some("Bazel the build system!"),
    subcommands: [
        (
            name: "run",
            description: Some("Runs the specified target"),
            arguments: [
                (
                    name: "BUILD file",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "FILES=( $(find ./ -name BUILD) ); for f in $FILES; do echo \"----$f\"; \\cat \"$f\"; done",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "test",
            description: Some("Builds and runs the specified test targets"),
            arguments: [
                (
                    name: "BUILD file",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "FILES=( $(find ./ -name BUILD) ); for f in $FILES; do echo \"----$f\"; \\cat \"$f\"; done",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "build",
            description: Some("Builds the specified targets"),
            arguments: [
                (
                    name: "BUILD file",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "FILES=( $(find ./ -name BUILD) ); for f in $FILES; do echo \"----$f\"; \\cat \"$f\"; done",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--autodetect_server_javabase",
            ],
            description: Some("Back to the local JDK for running the bazel server and instead exits"),
            exclusive_on: [
                "--noautodetect_server_javabase",
            ],
        ),
        (
            names: [
                "--noautodetect_server_javabase",
            ],
            description: Some("Does not fall back to the local JDK for running the bazel server and instead exits"),
            exclusive_on: [
                "autodetect_server_javabase",
            ],
        ),
        (
            names: [
                "--batch",
            ],
            description: Some("Run as just a client process without a server"),
            exclusive_on: [
                "--nobatch",
            ],
        ),
        (
            names: [
                "--nobatch",
            ],
            description: Some("Run with a server"),
            exclusive_on: [
                "--batch",
            ],
        ),
        (
            names: [
                "--batch_cpu_scheduling",
            ],
            description: Some("Only on Linux; use 'batch' CPU scheduling for Bazel"),
            exclusive_on: [
                "--nobatch_cpu_scheduling",
            ],
        ),
        (
            names: [
                "--nobatch_cpu_scheduling",
            ],
            description: Some("Only on Linux; Bazel does not perform a system call"),
            exclusive_on: [
                "--batch_cpu_scheduling",
            ],
        ),
        (
            names: [
                "--bazelrc",
            ],
            description: Some("The location of the user .bazelrc file containing default values of Bazel options"),
            arguments: [
                (
                    name: "bazelrc path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--block_for_lock",
            ],
            description: Some("Wait for a running command to complete"),
            exclusive_on: [
                "--noblock_for_lock",
            ],
        ),
        (
            names: [
                "--noblock_for_lock",
            ],
            description: Some("Bazel does not wait for a running command to complete, but instead exits immediately"),
            exclusive_on: [
                "--block_for_lock",
            ],
        ),
        (
            names: [
                "--client_debug",
            ],
            description: Some("Log debug information from the client to stderr. Changing this option will not cause the server to restart"),
            exclusive_on: [
                "--noclient_debug",
            ],
        ),
        (
            names: [
                "--noclient_debug",
            ],
            description: Some("Don't log debug information from the client to stderr"),
            exclusive_on: [
                "--client_debug",
            ],
        ),
        (
            names: [
                "--connect_timeout_secs",
            ],
            description: Some("The amount of time the client waits for each attempt to connect to the server"),
            arguments: [
                (
                    name: "time",
                ),
            ],
        ),
        (
            names: [
                "--expand_configs_in_place",
            ],
            description: Some("Changed the expansion of --config flags to be done in-place"),
            exclusive_on: [
                "--noexpand_configs_in_place",
            ],
        ),
        (
            names: [
                "--noexpand_configs_in_place",
            ],
            description: Some("--config flags in a fixed point expansion between normal rc options and command-line specified options"),
            exclusive_on: [
                "--expand_configs_in_place",
            ],
        ),
        (
            names: [
                "--failure_detail_out",
            ],
            description: Some("Specifies a location to write a failure_detail protobuf message if the server experiences a failure and cannot report it via gRPC, as normal. Otherwise, the location will be ${OUTPUT_BASE}/failure_detail.rawproto"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--home_rc",
            ],
            description: Some("Look for the home bazelrc file at $HOME/.bazelrc"),
            exclusive_on: [
                "--nohome_rc",
            ],
        ),
        (
            names: [
                "--nohome_rc",
            ],
            description: Some("Don't look for the home bazelrc file at $HOME/.bazelrc"),
            exclusive_on: [
                "--home_rc",
            ],
        ),
        (
            names: [
                "--idle_server_tasks",
            ],
            description: Some("Run System.gc() when the server is idle"),
            exclusive_on: [
                "--noidle_server_tasks",
            ],
        ),
        (
            names: [
                "--noidle_server_tasks",
            ],
            description: Some("Don't run System.gc() when the server is idle"),
            exclusive_on: [
                "--idle_server_tasks",
            ],
        ),
        (
            names: [
                "--ignore_all_rc_files",
            ],
            description: Some("Disables all rc files, regardless of the values of other rc-modifying flags, even if these flags come later in the list of startup options"),
            exclusive_on: [
                "--noignore_all_rc_files",
            ],
        ),
        (
            names: [
                "--noignore_all_rc_files",
            ],
            description: Some("Enables all rc files"),
            exclusive_on: [
                "--ignore_all_rc_files",
            ],
        ),
        (
            names: [
                "--io_nice_level",
            ],
            description: Some("Only on Linux; set a level from 0-7 for best-effort IO scheduling using the sys_ioprio_set system call. 0 is highest priority, 7 is lowest"),
            arguments: [
                (
                    name: "io-level",
                    suggestions: [
                        (
                            name: "0",
                        ),
                        (
                            name: "1",
                        ),
                        (
                            name: "2",
                        ),
                        (
                            name: "3",
                        ),
                        (
                            name: "4",
                        ),
                        (
                            name: "5",
                        ),
                        (
                            name: "6",
                        ),
                        (
                            name: "7",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--local_startup_timeout_secs",
            ],
            description: Some("The maximum amount of time the client waits to connect to the server"),
            arguments: [
                (
                    name: "seconds",
                    default: Some("120"),
                ),
            ],
        ),
        (
            names: [
                "--macos_qos_class",
            ],
            description: Some("Sets the QoS service class of the bazel server when running on macOS"),
            arguments: [
                (
                    name: "QoS service class",
                    default: Some("default"),
                ),
            ],
        ),
        (
            names: [
                "--max_idle_secs",
            ],
            description: Some("The number of seconds the build server will wait idling before shutting down"),
            arguments: [
                (
                    name: "seconds",
                    default: Some("10800"),
                ),
            ],
        ),
        (
            names: [
                "--output_base",
            ],
            description: Some("Specifies the output location to which all build output will be written"),
            arguments: [
                (
                    name: "Path",
                    template: [
                        FilePaths,
                    ],
                    default: Some("${OUTPUT_ROOT}/_bazel_${USER}/${MD5_OF_WORKSPACE_ROOT}"),
                ),
            ],
        ),
        (
            names: [
                "--output_base_root",
            ],
            description: Some("The user-specific directory beneath which all build outputs are written"),
            arguments: [
                (
                    name: "Path",
                    template: [
                        FilePaths,
                    ],
                    default: Some("$USER"),
                ),
            ],
        ),
        (
            names: [
                "--preemptible",
            ],
            description: Some("If true, the command can be preempted if another command is started"),
            exclusive_on: [
                "--nopreemptible",
            ],
        ),
        (
            names: [
                "--nopreemptible",
            ],
            description: Some("If true, the command can be preempted if another command is started"),
            exclusive_on: [
                "--preemptible",
            ],
        ),
        (
            names: [
                "--server_jvm_out",
            ],
            description: Some("The location to write the server's JVM's output"),
            arguments: [
                (
                    name: "Path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--shutdown_on_low_sys_mem",
            ],
            description: Some("Linux only. If max_idle_secs is set and the build server has been idle for a while, shut down the server when the system is low on free RAM"),
            exclusive_on: [
                "--noshutdown_on_low_sys_mem",
            ],
        ),
        (
            names: [
                "--noshutdown_on_low_sys_mem",
            ],
            description: Some("Linux only. Don't shut down the server when the system is low on free RAM"),
            exclusive_on: [
                "--shutdown_on_low_sys_mem",
            ],
        ),
        (
            names: [
                "--system_rc",
            ],
            description: Some("Look for the system-wide bazelrc"),
            exclusive_on: [
                "--nosystem_rc",
            ],
        ),
        (
            names: [
                "--nosystem_rc",
            ],
            description: Some("Don't look for the system-wide bazelrc"),
            exclusive_on: [
                "--system_rc",
            ],
        ),
        (
            names: [
                "--unlimit_coredumps",
            ],
            description: Some("Raises the soft coredump limit to the hard limit to make coredumps of the server (including the JVM) and the client possible under common conditions"),
            exclusive_on: [
                "--nounlimit_coredumps",
            ],
        ),
        (
            names: [
                "--nounlimit_coredumps",
            ],
            description: Some("Don't raise the soft coredump limit to the hard limit to make coredumps of the server (including the JVM) and the client possible under common conditions"),
            exclusive_on: [
                "--unlimit_coredumps",
            ],
        ),
        (
            names: [
                "--watchfs",
            ],
            description: Some("Use the operating system's file watch service for local changes instead of scanning every file for a change"),
            exclusive_on: [
                "--nowatchfs",
            ],
        ),
        (
            names: [
                "--nowatchfs",
            ],
            description: Some("Scan every file for a change"),
            exclusive_on: [
                "--watchfs",
            ],
        ),
        (
            names: [
                "--windows_enable_symlinks",
            ],
            description: Some("Real symbolic links will be created on Windows instead of file copying"),
            exclusive_on: [
                "--nowindows_enable_symlinks",
            ],
        ),
        (
            names: [
                "--nowindows_enable_symlinks",
            ],
            description: Some("Real symbolic links will be created via file copying"),
            exclusive_on: [
                "--windows_enable_symlinks",
            ],
        ),
        (
            names: [
                "--workspace_rc",
            ],
            description: Some("Look for the workspace bazelrc file at $workspace/.bazelrc"),
            exclusive_on: [
                "--noworkspace_rc",
            ],
        ),
        (
            names: [
                "--noworkspace_rc",
            ],
            description: Some("Don't look for the workspace bazelrc file at $workspace/.bazelrc"),
            exclusive_on: [
                "--workspace_rc",
            ],
        ),
    ],
)
