(
    version: 1,
    command: "jest",
    description: Some("A delightful JavaScript Testing Framework with a focus on simplicity"),
    options: [
        (
            names: [
                "--bail",
                "-b",
            ],
            description: Some("Exit the test suite immediately upon n number of failing test suite. Defaults to 1"),
            arguments: [
                (
                    name: "n",
                ),
            ],
        ),
        (
            names: [
                "--cache",
            ],
            description: Some("Whether to use the cache"),
        ),
        (
            names: [
                "--no-cache",
            ],
            description: Some("Whether to use the cache"),
        ),
        (
            names: [
                "--changedFilesWithAncestor",
            ],
            description: Some("Runs tests related to the current changes and the changes made in the last commit"),
        ),
        (
            names: [
                "--changedSince",
            ],
            description: Some("Runs tests related to the changes since the provided branch or commit hash"),
            arguments: [
                (
                    name: "since",
                ),
            ],
        ),
        (
            names: [
                "--ci",
            ],
            description: Some("Instead of the regular behavior of storing a new snapshot automatically, will fail the test and require Jest to be run with --updateSnapshot"),
        ),
        (
            names: [
                "--clearCache",
            ],
            description: Some("Deletes the Jest cache directory and then exits without running tests"),
            arguments: [
                (
                    name: "cacheDirectory",
                ),
            ],
        ),
        (
            names: [
                "--collectCoverageFrom",
            ],
            description: Some("A glob pattern relative to rootDir matching the files that coverage info needs to be collected from"),
            arguments: [
                (
                    name: "glob",
                ),
            ],
            requires_separator: Some("="),
            presentation: (
                display_name: Some("--collectCoverageFrom=<glob>"),
            ),
        ),
        (
            names: [
                "--colors",
            ],
            description: Some("Forces test results output highlighting even if stdout is not a TTY"),
        ),
        (
            names: [
                "--config",
                "-c",
            ],
            description: Some("The path to a Jest config file specifying how to find and execute tests"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
            requires_separator: Some("="),
            presentation: (
                display_name: Some("--config=<path>"),
            ),
        ),
        (
            names: [
                "--coverage",
            ],
            description: Some("Enable or disable coverage, disabled by default"),
            arguments: [
                (
                    name: "true|false",
                    suggestions: [
                        (
                            name: "true",
                        ),
                        (
                            name: "false",
                        ),
                    ],
                ),
            ],
            requires_separator: Some("="),
            presentation: (
                display_name: Some("--coverage=<boolean>"),
            ),
        ),
        (
            names: [
                "--coverageProvider",
            ],
            description: Some("Indicates which provider should be used to instrument code for coverage"),
            arguments: [
                (
                    name: "babel|v8",
                    suggestions: [
                        (
                            name: "babel",
                        ),
                        (
                            name: "v8",
                        ),
                    ],
                ),
            ],
            requires_separator: Some("="),
            presentation: (
                display_name: Some("--coverageProvider=<provider>"),
            ),
        ),
        (
            names: [
                "--debug",
            ],
            description: Some("Print debugging info about your Jest config"),
        ),
        (
            names: [
                "--detectOpenHandles",
            ],
            description: Some("Attempt to collect and print open handles preventing Jest from exiting cleanly"),
        ),
        (
            names: [
                "--env",
            ],
            description: Some("The test environment used for all tests"),
            arguments: [
                (
                    name: "jsdom|node|path/to/env.js",
                    suggestions: [
                        (
                            name: "jsdom",
                        ),
                        (
                            name: "node",
                        ),
                    ],
                    template: [
                        FilePaths,
                    ],
                ),
            ],
            requires_separator: Some("="),
            presentation: (
                display_name: Some("--env=<environment>"),
            ),
        ),
        (
            names: [
                "--errorOnDeprecated",
            ],
            description: Some("Make calling deprecated APIs throw helpful error messages"),
        ),
        (
            names: [
                "--expand",
                "-e",
            ],
            description: Some("Use this flag to show full diffs and errors instead of a patch"),
        ),
        (
            names: [
                "--findRelatedTests",
            ],
            description: Some("Find and run the tests that cover a space separated list of source files that were passed in as arguments"),
            arguments: [
                (
                    name: "<path1> ... <pathN>",
                ),
            ],
            presentation: (
                display_name: Some("--findRelatedTests <path1> ... <pathN>"),
            ),
        ),
        (
            names: [
                "--forceExit",
            ],
            description: Some("Force Jest to exit after all tests have completed running"),
        ),
        (
            names: [
                "--help",
            ],
            description: Some("Show the help information"),
        ),
        (
            names: [
                "--init",
            ],
            description: Some("Generate a basic configuration file"),
        ),
        (
            names: [
                "--injectGlobals",
            ],
            description: Some("Insert Jest's globals (expect, test, describe, beforeEach etc.) into the global environment"),
        ),
        (
            names: [
                "--json",
            ],
            description: Some("Prints the test results in JSON"),
        ),
        (
            names: [
                "--outputFile",
            ],
            description: Some("Write test results to a file when the --json option is also specified"),
            arguments: [
                (
                    name: "filename",
                ),
            ],
            requires_separator: Some("="),
            presentation: (
                display_name: Some("--outputFile=<filename>"),
            ),
        ),
        (
            names: [
                "--lastCommit",
            ],
            description: Some("Run all tests affected by file changes in the last commit made"),
        ),
        (
            names: [
                "--listTests",
            ],
            description: Some("Lists all tests as JSON that Jest will run given the arguments, and exits"),
        ),
        (
            names: [
                "--logHeapUsage",
            ],
            description: Some("Logs the heap usage after every test"),
        ),
        (
            names: [
                "--maxConcurrency",
            ],
            description: Some("Prevents Jest from executing more than the specified amount of tests at the same time"),
            arguments: [
                (
                    name: "num",
                ),
            ],
            requires_separator: Some("="),
            presentation: (
                display_name: Some("--maxConcurrency=<num>"),
            ),
        ),
        (
            names: [
                "--maxWorkers",
                "-w",
            ],
            description: Some("Specifies the maximum number of workers the worker-pool will spawn for running tests"),
            arguments: [
                (
                    name: "<num>|<string>",
                ),
            ],
            requires_separator: Some("="),
            presentation: (
                display_name: Some("--maxWorkers=<num>|<string>"),
            ),
        ),
        (
            names: [
                "--noStackTrace",
            ],
            description: Some("Disables stack trace in test results output"),
        ),
        (
            names: [
                "--notify",
            ],
            description: Some("Activates notifications for test results"),
        ),
        (
            names: [
                "--onlyChanged",
                "-o",
            ],
            description: Some("Attempts to identify which tests to run based on which files have changed in the current repository"),
        ),
        (
            names: [
                "--passWithNoTests",
            ],
            description: Some("Allows the test suite to pass when no files are found"),
        ),
        (
            names: [
                "--projects",
            ],
            description: Some("Run tests from one or more projects, found in the specified paths; also takes path globs"),
            arguments: [
                (
                    name: "<path1> ... <pathN>",
                    template: [
                        FilePaths,
                    ],
                    variadic: true,
                ),
            ],
            presentation: (
                display_name: Some("--projects <path1> ... <pathN>"),
            ),
        ),
        (
            names: [
                "--reporters",
            ],
            description: Some("Run tests with specified reporters"),
            arguments: [
                (
                    name: "reporter",
                ),
            ],
            requires_separator: Some("="),
            presentation: (
                display_name: Some("--reporters=<reporter>"),
            ),
        ),
        (
            names: [
                "--roots",
            ],
            description: Some("A list of paths to directories that Jest should use to search for files in"),
            arguments: [
                (
                    name: "<path1> ... <pathN>",
                    template: [
                        Folders,
                    ],
                    variadic: true,
                ),
            ],
            presentation: (
                display_name: Some("--roots <path1> ... <pathN>"),
            ),
        ),
        (
            names: [
                "--runInBand",
                "-i",
            ],
            description: Some("Run all tests serially in the current process, rather than creating a worker pool of child processes that run tests"),
        ),
        (
            names: [
                "--selectProjects",
            ],
            description: Some("Run only the tests of the specified projects"),
            arguments: [
                (
                    name: "<project1> ... <projectN>",
                ),
            ],
            presentation: (
                display_name: Some("--selectProjects <project1> ... <projectN>"),
            ),
        ),
        (
            names: [
                "--runTestsByPath",
            ],
            description: Some("Run only the tests that were specified with their exact paths"),
        ),
        (
            names: [
                "--setupTestFrameworkScriptFile",
            ],
            description: Some("The path to a module that runs some code to configure or set up the testing framework before each test"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
            requires_separator: Some("="),
            presentation: (
                display_name: Some("--setupTestFrameworkScriptFile=<file>"),
            ),
        ),
        (
            names: [
                "--showConfig",
            ],
            description: Some("Print your Jest config and then exits"),
        ),
        (
            names: [
                "--silent",
            ],
            description: Some("Prevent tests from printing messages through the console"),
        ),
        (
            names: [
                "--testNamePattern",
                "-t",
            ],
            description: Some("Run only tests with a name that matches the regex"),
            arguments: [
                (
                    name: "regex",
                ),
            ],
            requires_separator: Some("="),
            presentation: (
                display_name: Some("--testNamePattern=<regex>"),
            ),
        ),
        (
            names: [
                "--testLocationInResults",
            ],
            description: Some("Adds a location field to test results"),
        ),
        (
            names: [
                "--testPathPattern",
            ],
            description: Some("A regexp pattern string that is matched against all tests paths before executing the test"),
            arguments: [
                (
                    name: "regex",
                ),
            ],
            requires_separator: Some("="),
            presentation: (
                display_name: Some("--testPathPattern=<regex>"),
            ),
        ),
        (
            names: [
                "--testPathIgnorePatterns",
            ],
            description: Some("An array of regexp pattern strings that are tested against all tests paths before executing the test"),
            arguments: [
                (
                    name: "[array]",
                ),
            ],
            requires_separator: Some("="),
            presentation: (
                display_name: Some("--testPathIgnorePatterns=[array]"),
            ),
        ),
        (
            names: [
                "--testRunner",
            ],
            description: Some("Lets you specify a custom test runner"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
            requires_separator: Some("="),
            presentation: (
                display_name: Some("--testRunner=<path>"),
            ),
        ),
        (
            names: [
                "--testSequencer",
            ],
            description: Some("Lets you specify a custom test sequencer"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
            requires_separator: Some("="),
            presentation: (
                display_name: Some("--testSequencer=<path>"),
            ),
        ),
        (
            names: [
                "--testTimeout",
            ],
            description: Some("Default timeout of a test in milliseconds"),
            arguments: [
                (
                    name: "timeout in ms",
                ),
            ],
            requires_separator: Some("="),
            presentation: (
                display_name: Some("--testTimeout=<num>"),
            ),
        ),
        (
            names: [
                "--updateSnapshot",
                "-u",
            ],
            description: Some("Use this flag to re-record every snapshot that fails during this test run"),
        ),
        (
            names: [
                "--useStderr",
            ],
            description: Some("Divert all output to stderr"),
        ),
        (
            names: [
                "--verbose",
            ],
            description: Some("Display individual test results with the test suite hierarchy"),
        ),
        (
            names: [
                "--version",
                "-v",
            ],
            description: Some("Print the version and exit"),
        ),
        (
            names: [
                "--watch",
            ],
            description: Some("Watch files for changes and rerun tests related to changed files"),
        ),
        (
            names: [
                "--watchAll",
            ],
            description: Some("Watch files for changes and rerun all tests when something changes"),
        ),
        (
            names: [
                "--watchman",
            ],
            description: Some("Whether to use watchman for file crawling"),
        ),
        (
            names: [
                "--no-watchman",
            ],
            description: Some("Whether to use watchman for file crawling"),
        ),
    ],
    arguments: [
        (
            name: "",
        ),
    ],
)
