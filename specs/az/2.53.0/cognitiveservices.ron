(
    version: 1,
    command: "cognitiveservices",
    description: Some("Manage Azure Cognitive Services accounts.\n\n\t\tThis article lists the Azure CLI commands for Azure Cognitive Services account and subscription management only. Refer to the documentation at https://docs.microsoft.com/azure/cognitive-services/ for individual services to learn how to use the APIs and supported SDKs"),
    subcommands: [
        (
            name: "account",
            description: Some("Manage Azure Cognitive Services accounts.\n\n\t\tThis article lists the Azure CLI commands for Azure Cognitive Services account and subscription management only. Refer to the documentation at https://docs.microsoft.com/azure/cognitive-services/ for individual services to learn how to use the APIs and supported SDKs"),
