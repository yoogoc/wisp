                        (
                            name: "cluster-type",
                            suggestions: [
                                (
                                    name: "connectedClusters",
                                ),
                                (
                                    name: "managedClusters",
                                ),
                            ],
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--name",
                        "-n",
                    ],
                    description: Some("Name of the Kubernetes Configuration"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--yes",
                        "-y",
                    ],
                    description: Some("Do not prompt for confirmation"),
                ),
            ],
        ),
        (
            name: "list",
            description: Some("List Kubernetes configurations"),
            options: [
                (
                    names: [
                        "--cluster-name",
                        "-c",
                    ],
                    description: Some("Name of the Kubernetes cluster"),
                    arguments: [
                        (
