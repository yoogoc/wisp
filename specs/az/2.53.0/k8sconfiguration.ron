(
    version: 1,
    command: "k8sconfiguration",
    description: Some("Commands to manage Kubernetes configuration"),
    subcommands: [
        (
            name: "create",
            description: Some("Create a Kubernetes configuration"),
            options: [
                (
                    names: [
                        "--cluster-name",
                        "-c",
                    ],
                    description: Some("Name of the Kubernetes cluster"),
                    arguments: [
                        (
                            name: "cluster-name",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--cluster-type",
                    ],
                    description: Some("Specify Arc clusters or AKS managed clusters"),
                    arguments: [
                        (
                            name: "cluster-type",
                            suggestions: [
                                (
                                    name: "connectedClusters",
                                ),
                                (
                                    name: "managedClusters",
                                ),
                            ],
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--name",
                        "-n",
                    ],
                    description: Some("Name of the Kubernetes Configuration"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--repository-url",
                        "-u",
                    ],
                    description: Some("Url of the source control repository"),
                    arguments: [
                        (
                            name: "repository-url",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--scope",
                    ],
                    description: Some("Specify scope of the operator to be 'namespace' or 'cluster'"),
                    arguments: [
                        (
                            name: "scope",
                            suggestions: [
                                (
                                    name: "cluster",
                                ),
                                (
                                    name: "namespace",
                                ),
                            ],
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--enable-helm-operator",
                    ],
                    description: Some("Enable support for Helm chart deployments"),
                    arguments: [
                        (
                            name: "enable-helm-operator",
                            suggestions: [
                                (
                                    name: "false",
                                ),
                                (
                                    name: "true",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--helm-operator-params",
                    ],
                    description: Some("Chart values for the Helm Operator (if enabled)"),
                    arguments: [
                        (
                            name: "helm-operator-params",
                        ),
                    ],
                ),
                (
                    names: [
                        "--helm-operator-version",
                    ],
                    description: Some("Chart version of the Helm Operator (if enabled)"),
                    arguments: [
                        (
                            name: "helm-operator-version",
                        ),
                    ],
                ),
                (
                    names: [
                        "--https-key",
                    ],
                    description: Some("Specify HTTPS token/password for private repository sync"),
                    arguments: [
                        (
                            name: "https-key",
                        ),
                    ],
                ),
                (
                    names: [
                        "--https-user",
                    ],
                    description: Some("Specify HTTPS username for private repository sync"),
                    arguments: [
                        (
                            name: "https-user",
                        ),
                    ],
                ),
                (
                    names: [
                        "--operator-instance-name",
                    ],
                    description: Some("Instance name of the Operator"),
                    arguments: [
                        (
                            name: "operator-instance-name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--operator-namespace",
                    ],
                    description: Some("Namespace in which to install the Operator"),
                    arguments: [
                        (
                            name: "operator-namespace",
                        ),
                    ],
                ),
                (
                    names: [
                        "--operator-params",
                    ],
                    description: Some("Parameters for the Operator"),
                    arguments: [
                        (
                            name: "operator-params",
                        ),
                    ],
                ),
                (
                    names: [
                        "--operator-type",
                    ],
                    description: Some("Type of the operator. Valid value is 'flux'"),
                    arguments: [
                        (
                            name: "operator-type",
                        ),
                    ],
                ),
                (
                    names: [
                        "--ssh-known-hosts",
                    ],
                    description: Some("Specify Base64-encoded known_hosts contents containing public SSH keys required to access private Git instances"),
                    arguments: [
                        (
                            name: "ssh-known-hosts",
                        ),
                    ],
                ),
                (
                    names: [
                        "--ssh-known-hosts-file",
                    ],
                    description: Some("Specify filepath to known_hosts contents containing public SSH keys required to access private Git instances"),
                    arguments: [
                        (
                            name: "ssh-known-hosts-file",
                        ),
                    ],
                ),
                (
                    names: [
                        "--ssh-private-key",
                    ],
                    description: Some("Specify Base64-encoded private ssh key for private repository sync"),
                    arguments: [
                        (
                            name: "ssh-private-key",
                        ),
                    ],
                ),
                (
                    names: [
                        "--ssh-private-key-file",
                    ],
                    description: Some("Specify filepath to private ssh key for private repository sync"),
                    arguments: [
                        (
                            name: "ssh-private-key-file",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "delete",
            description: Some("Delete a Kubernetes configuration"),
            options: [
                (
                    names: [
                        "--cluster-name",
                        "-c",
                    ],
                    description: Some("Name of the Kubernetes cluster"),
                    arguments: [
                        (
                            name: "cluster-name",
                        ),
