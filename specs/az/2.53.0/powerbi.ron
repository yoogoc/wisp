                                (
                                    name: "location",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--no-wait",
                            ],
                            description: Some("Do not wait for the long-running operation to finish"),
                            arguments: [
                                (
                                    name: "no-wait",
                                    suggestions: [
                                        (
                                            name: "0",
                                        ),
                                        (
                                            name: "1",
                                        ),
                                        (
                                            name: "f",
                                        ),
                                        (
