(
    version: 1,
    command: "powerbi",
    description: Some("Manage PowerBI resources"),
    subcommands: [
        (
            name: "embedded-capacity",
            description: Some("Manage PowerBI embedded capacity"),
            subcommands: [
                (
                    name: "create",
                    description: Some("Create a new PowerBI embedded capacity"),
                    options: [
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("The name of the Dedicated capacity. It must be at least 3 characters in length, and no more than 63"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--resource-group",
                                "-g",
                            ],
                            description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                            arguments: [
                                (
                                    name: "resource-group",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--sku-name",
                            ],
                            description: Some("Name of the SKU level. For more information, please refer to https://azure.microsoft.com/en- us/pricing/details/power-bi-embedded/. Allowed values: A1, A2, A3, A4, A5, A6"),
                            arguments: [
                                (
                                    name: "sku-name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--administration-members",
                            ],
                            description: Some("An array of administrator user identities. Support shorthand-syntax, json-file and yaml-file. Try \"??\" to show more"),
