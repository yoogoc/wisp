(
    version: 1,
    command: "connection",
    description: Some("Commands to manage Service Connector local connections which allow local environment to connect Azure Resource. If you want to manage connection for compute service, please run 'az webapp/containerapp/spring connection'"),
    subcommands: [
        (
            name: "create",
            description: Some("Create a connection from local to a target resource"),
            subcommands: [
                (
                    name: "appconfig",
                    description: Some("Create a Service Connector local connection to appconfig"),
                    options: [
                        (
                            names: [
                                "--resource-group",
                                "-g",
                            ],
                            description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                            arguments: [
                                (
                                    name: "resource-group",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--app-config",
                            ],
                            description: Some("Name of the app configuration. Required if '--target-id' is not specified"),
                            arguments: [
                                (
                                    name: "app-config",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--client-type",
                            ],
                            description: Some("The client type used on the connection"),
                            arguments: [
                                (
                                    name: "client-type",
                                    suggestions: [
                                        (
                                            name: "dotnet",
                                        ),
                                        (
                                            name: "java",
                                        ),
                                        (
                                            name: "nodejs",
                                        ),
                                        (
                                            name: "none",
                                        ),
                                        (
                                            name: "python",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--connection",
                            ],
                            description: Some("Name of the connection"),
                            arguments: [
                                (
                                    name: "connection",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--customized-keys",
                            ],
                            description: Some("The customized keys used to change default configuration names. Key is the original name, value is the customized name"),
                            arguments: [
                                (
                                    name: "customized-keys",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--location",
                                "-l",
                            ],
                            description: Some("Location. Values from: az account list-locations. You can configure the default location using az configure --defaults location=<location>"),
                            arguments: [
                                (
                                    name: "location",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--no-wait",
                            ],
                            description: Some("Do not wait for the long-running operation to finish"),
                        ),
                        (
                            names: [
                                "--secret",
                            ],
                            description: Some("The secret auth info"),
                            arguments: [
                                (
                                    name: "secret",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--service-principal",
                            ],
                            description: Some("The service principal auth info"),
                            arguments: [
                                (
                                    name: "service-principal",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--target-id",
                            ],
                            description: Some("The resource id of target service. Required if ['--target-resource-group', '--app-config'] are not specified"),
                            arguments: [
                                (
                                    name: "target-id",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--target-resource-group",
                                "--tg",
                            ],
                            description: Some("The resource group which contains the app configuration. Required if '--target-id' is not specified"),
