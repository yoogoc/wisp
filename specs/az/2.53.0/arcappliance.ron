        (
            name: "createconfig",
            description: Some("Command group for creating configuration files for Arc resource bridge.\n\n\t\tThis command features two modes - interactive and non-interactive. Interactive mode provides helpful prompts that explain the parameter and what to pass. It is initiated by passing only the required parameters. Non-interactive mode allows you to pass all the parameters needed to create the configuration files without being prompted"),
            subcommands: [
                (
                    name: "hci",
                    description: Some("Command to create configuration files for Arc Resource Bridge on HCI"),
                    options: [
                        (
                            names: [
                                "--location",
                                "-l",
                            ],
                            description: Some("The Azure location where the Arc resource bridge Azure resource will be deployed. Must be a valid location where the self-service VM feature for Azure Stack HCI is available and set to the same location as the resource group"),
                            arguments: [
                                (
                                    name: "location",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("Name of the Arc resource bridge"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--resource-group",
                                "-g",
                            ],
                            description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                            arguments: [
                                (
                                    name: "resource-group",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--authenticationport",
                            ],
                            description: Some("Network port used by appliance VM IP to communicate with the cloud agent service endpoint. This port should be open on the firewall to enable communication between the two if the Windows Server physical cluster nodes and Arc resource bridge VM are on separate VLANs"),
                            arguments: [
                                (
                                    name: "authenticationport",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--certificateFilePath",
                            ],
                            description: Some("Certificate file path if your proxy server requires the proxy clients to trust a certificate. Only pass a single proxy certificate, not a bundle"),
                            arguments: [
                                (
                                    name: "certificateFilePath",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--cloudagent",
                            ],
                            description: Some("FQDN or IP address of the Azure Stack HCI MOC cloud agent service used by Arc resource bridge. This can be found in the -infra.yaml configuration file stored locally on the HCI cluster"),
                            arguments: [
                                (
                                    name: "cloudagent",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--controlPlaneEndpoint",
                            ],
                            description: Some("Arc resource bridge on-premises appliance VM hosts a management kubernetes cluster with a control plane that requires a static IP address. This static IP address must lie within the subnet range specified in the IP address prefix"),
                            arguments: [
                                (
                                    name: "controlPlaneEndpoint",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--dnsservers",
                            ],
                            description: Some("IP address(es) of DNS server(s) used by Arc resource bridge on-premises appliance VM for DNS resolution. Appliance VM must be able to resolve external sites and internal endpoints. Enter multiple IP addresses as a comma-separated list"),
                            arguments: [
                                (
                                    name: "dnsservers",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--gateway",
                            ],
                            description: Some("Static gateway IP address, must lie within the subnet range specified in the IP address prefix"),
                            arguments: [
                                (
                                    name: "gateway",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--http",
                            ],
                            description: Some("HTTP proxy URL and port information entered as http://:. Example: http://192.168.0.10:80"),
                            arguments: [
                                (
                                    name: "http",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--https",
                            ],
                            description: Some("HTTPS URL and port information entered as http://:. Example: https://192.168.0.10:443"),
                            arguments: [
                                (
                                    name: "https",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--ipaddressprefix",
                            ],
                            description: Some("Arc resource bridge requires 3 IP addresses for the on-premises appliance VM (appliance VM IP, upgrade VM IP, control plane IP). All IPs should reside within the same subnet and fall within the range specified in the IP address prefix. IP address prefix is entered as the subnet's IP address range for the virtual network and subnet mask (IP Mask) in CIDR notation (ex: 192.168.7.1/24). An IP Subnet CIDR calculator can be used for this. Example: For IPs within a subnet range of 192.168.7.1 - 192.168.7.254, the IP address prefix is 192.168.7.1/24. Within 192.168.7.1/24, set k8snodeippoolstart (appliance VM IP) to 192.168.7.2, k8snodeippoolend (upgrade VM IP) to 192.168.7.3 and control plane IP to 192.168.7.4"),
                            arguments: [
                                (
                                    name: "ipaddressprefix",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--k8snodeippoolend",
                            ],
                            description: Some("Arc resource bridge on-premises appliance VM requires 2 IP addresses (appliance VM IP & upgrade VM IP) that should reside within the same subnet and fall within the range specified in the IP address prefix. IP addresses are specified as an IP range with a minimum size of 2 IP addresses. This parameter is to specify the end range IP. Example: For a subnet range of 192.168.7.1 - 192.168.7.254, the IP address prefix is 192.168.7.1/24. Within 192.168.7.1/24, set k8snodeippoolstart (appliance VM IP) to 192.168.7.2, k8snodeippoolend (upgrade VM IP) to 192.168.7.3 and control plane IP to 192.168.7.4"),
                            arguments: [
                                (
                                    name: "k8snodeippoolend",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--k8snodeippoolstart",
                            ],
                            description: Some("Arc resource bridge on-premises appliance VM requires 2 IP addresses (appliance VM IP & upgrade VM IP) that should reside within the same subnet and fall within the range specified in the IP address prefix. IP addresses are specified as an IP range with a minimum size of 2 IP addresses. This parameter is to specify the start range IP. Example: For a subnet range of 192.168.7.1 - 192.168.7.254, the IP address prefix is 192.168.7.1/24. Within 192.168.7.1/24, set k8snodeippoolstart (appliance VM IP) to 192.168.7.2, k8snodeippoolend (upgrade VM IP) to 192.168.7.3 and control plane IP to 192.168.7.4"),
                            arguments: [
                                (
                                    name: "k8snodeippoolstart",
                                ),
                            ],
