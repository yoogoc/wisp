(
    version: 1,
    command: "graph",
    description: Some("Query the resources managed by Azure Resource Manager.\n\n\t\tRun 'az graph query --help' for detailed help"),
    subcommands: [
        (
            name: "query",
            description: Some("Query the resources managed by Azure Resource Manager"),
            options: [
                (
                    names: [
                        "--graph-query",
                        "--q",
                        "-q",
                    ],
                    description: Some("Resource Graph query to execute"),
                    arguments: [
                        (
                            name: "graph-query",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--allow-partial-scopes",
                        "-a",
                    ],
                    description: Some("Indicates if query should succeed when only partial number of subscription underneath can be processed by server"),
                ),
                (
                    names: [
                        "--first",
                    ],
                    description: Some("The maximum number of objects to return. Accepted range: 1-1000"),
                    arguments: [
                        (
                            name: "first",
                        ),
                    ],
                ),
                (
                    names: [
                        "--management-groups",
                        "-m",
                    ],
                    description: Some("List of management groups to run query against"),
                    arguments: [
                        (
                            name: "management-groups",
                        ),
                    ],
                ),
                (
                    names: [
                        "--skip",
                    ],
                    description: Some("Ignores the first N objects and then gets the remaining objects"),
                    arguments: [
                        (
                            name: "skip",
                        ),
                    ],
                ),
                (
                    names: [
                        "--skip-token",
                    ],
                    description: Some("Skip token to get the next page of the query if applicable"),
                    arguments: [
                        (
                            name: "skip-token",
                        ),
                    ],
                ),
                (
                    names: [
                        "--subscriptions",
                        "-s",
                    ],
                    description: Some("List of subscriptions to run query against. By default all accessible subscriptions are queried"),
                    arguments: [
                        (
                            name: "subscriptions",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "shared-query",
            description: Some("Manage shared query of Azure resource graph"),
            subcommands: [
                (
                    name: "create",
                    description: Some("Create a shared query"),
                    options: [
                        (
                            names: [
                                "--description",
                                "-d",
                            ],
                            description: Some("Description of the graph shared query"),
                            arguments: [
                                (
                                    name: "description",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--graph-query",
                                "--q",
                                "-q",
                            ],
                            description: Some("Resource Graph query to execute"),
                            arguments: [
                                (
                                    name: "graph-query",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("Name of the graph shared query"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--resource-group",
                                "-g",
                            ],
                            description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                            arguments: [
                                (
                                    name: "resource-group",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--tags",
                            ],
                            description: Some("Space-separated tags: key[=value] [key[=value] ...]. Use \"\" to clear existing tags"),
                            arguments: [
                                (
                                    name: "tags",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "delete",
                    description: Some("Delete a shared query"),
                    options: [
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("Name of the graph shared query"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--resource-group",
                                "-g",
                            ],
                            description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                            arguments: [
                                (
                                    name: "resource-group",
                                ),
                            ],
                            required: true,
                        ),
                    ],
                ),
                (
                    name: "list",
                    description: Some("List all shared query in a resource group"),
                    options: [
                        (
                            names: [
                                "--resource-group",
                                "-g",
                            ],
                            description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                            arguments: [
                                (
                                    name: "resource-group",
                                ),
                            ],
                            required: true,
                        ),
                    ],
                ),
                (
                    name: "show",
                    description: Some("Show the properties of a shared query"),
                    options: [
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("Name of the graph shared query"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--resource-group",
                                "-g",
                            ],
                            description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                            arguments: [
                                (
                                    name: "resource-group",
                                ),
                            ],
                            required: true,
                        ),
                    ],
                ),
            ],
        ),
    ],
)
