(
    version: 1,
    command: "role",
    description: Some("Manage user roles for access control with Azure Active Directory and service principals"),
    subcommands: [
        (
            name: "assignment",
            description: Some("Manage role assignments"),
            subcommands: [
                (
                    name: "create",
                    description: Some("Create a new role assignment for a user, group, or service principal"),
                    options: [
                        (
                            names: [
                                "--role",
                            ],
                            description: Some("Role name or id"),
                            arguments: [
                                (
                                    name: "role",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--assignee",
                            ],
                            description: Some("Represent a user, group, or service principal. supported format: object id, user sign-in name, or service principal name"),
                            arguments: [
                                (
                                    name: "assignee",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--assignee-object-id",
                            ],
                            description: Some("Use this parameter instead of '--assignee' to bypass Graph API invocation in case of insufficient privileges. This parameter only works with object ids for users, groups, service principals, and managed identities. For managed identities use the principal id. For service principals, use the object id and not the app id"),
                            arguments: [
                                (
                                    name: "assignee-object-id",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--assignee-principal-type",
                            ],
                            description: Some("Use with --assignee-object-id to avoid errors caused by propagation latency in AAD Graph"),
                            arguments: [
                                (
                                    name: "assignee-principal-type",
                                    suggestions: [
                                        (
                                            name: "ForeignGroup",
                                        ),
                                        (
                                            name: "Group",
                                        ),
                                        (
                                            name: "ServicePrincipal",
                                        ),
                                        (
                                            name: "User",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--condition",
                            ],
                            description: Some("Condition under which the user can be granted permission"),
                            arguments: [
                                (
                                    name: "condition",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--condition-version",
                            ],
                            description: Some("Version of the condition syntax. If --condition is specified without --condition-version, default to 2.0"),
                            arguments: [
                                (
                                    name: "condition-version",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--description",
                            ],
                            description: Some("Description of role assignment"),
                            arguments: [
                                (
                                    name: "description",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("A GUID for the role assignment. It must be unique and different for each role assignment. If omitted, a new GUID is generetd"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--resource-group",
                                "-g",
                            ],
                            description: Some("Use it only if the role or assignment was added at the level of a resource group"),
                            arguments: [
                                (
                                    name: "resource-group",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--scope",
                            ],
                            description: Some("Scope at which the role assignment or definition applies to, e.g., /subscriptions/0b1f6471-1bf0-4dda-aec3-111122223333, /subscriptions/0b1f6471-1bf0-4dda-aec3-111122223333/resourceGroups/myGroup, or /subscriptions/0b1f6471-1bf0-4dda-aec3-111122223333/resourceGroups/myGroup/providers/Microsoft.Compute/virtualMachines/myVM"),
                            arguments: [
                                (
                                    name: "scope",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "delete",
                    description: Some("Delete role assignments"),
                    options: [
                        (
                            names: [
                                "--assignee",
                            ],
                            description: Some("Represent a user, group, or service principal. supported format: object id, user sign-in name, or service principal name"),
                            arguments: [
                                (
                                    name: "assignee",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--ids",
                            ],
                            description: Some("Space-separated role assignment ids"),
                            arguments: [
                                (
                                    name: "ids",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--include-inherited",
                            ],
                            description: Some("Include assignments applied on parent scopes"),
                        ),
                        (
                            names: [
                                "--resource-group",
                                "-g",
                            ],
                            description: Some("Use it only if the role or assignment was added at the level of a resource group"),
                            arguments: [
                                (
                                    name: "resource-group",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--role",
                            ],
                            description: Some("Role name or id"),
                            arguments: [
                                (
                                    name: "role",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--scope",
                            ],
                            description: Some("Scope at which the role assignment or definition applies to, e.g., /subscriptions/0b1f6471-1bf0-4dda-aec3-111122223333, /subscriptions/0b1f6471-1bf0-4dda-aec3-111122223333/resourceGroups/myGroup, or /subscriptions/0b1f6471-1bf0-4dda-aec3-111122223333/resourceGroups/myGroup/providers/Microsoft.Compute/virtualMachines/myVM"),
                            arguments: [
                                (
                                    name: "scope",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--yes",
                                "-y",
                            ],
                            description: Some("Continue to delete all assignments under the subscription"),
                        ),
                    ],
                ),
                (
                    name: "list",
                    description: Some("List role assignments"),
                    options: [
                        (
                            names: [
                                "--all",
                            ],
                            description: Some("Show all assignments under the current subscription"),
                        ),
                        (
                            names: [
                                "--assignee",
                            ],
                            description: Some("Represent a user, group, or service principal. supported format: object id, user sign-in name, or service principal name"),
                            arguments: [
                                (
                                    name: "assignee",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--include-classic-administrators",
                            ],
                            description: Some("List default role assignments for subscription classic administrators, aka co-admins"),
                        ),
                        (
                            names: [
                                "--include-groups",
                            ],
                            description: Some("Include extra assignments to the groups of which the user is a member(transitively)"),
                        ),
                        (
                            names: [
                                "--include-inherited",
                            ],
                            description: Some("Include assignments applied on parent scopes"),
                        ),
                        (
                            names: [
                                "--resource-group",
                                "-g",
                            ],
                            description: Some("Use it only if the role or assignment was added at the level of a resource group"),
                            arguments: [
                                (
                                    name: "resource-group",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--role",
                            ],
                            description: Some("Role name or id"),
                            arguments: [
                                (
                                    name: "role",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--scope",
                            ],
                            description: Some("Scope at which the role assignment or definition applies to, e.g., /subscriptions/0b1f6471-1bf0-4dda-aec3-111122223333, /subscriptions/0b1f6471-1bf0-4dda-aec3-111122223333/resourceGroups/myGroup, or /subscriptions/0b1f6471-1bf0-4dda-aec3-111122223333/resourceGroups/myGroup/providers/Microsoft.Compute/virtualMachines/myVM"),
                            arguments: [
                                (
                                    name: "scope",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "list-changelogs",
                    description: Some("List changelogs for role assignments"),
                    options: [
                        (
                            names: [
                                "--end-time",
                            ],
                            description: Some("The end time of the query in the format of %Y-%m-%dT%H:%M:%SZ, e.g. 2000-12-31T12:59:59Z. Defaults to the current time"),
                            arguments: [
                                (
                                    name: "end-time",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--start-time",
                            ],
                            description: Some("The start time of the query in the format of %Y-%m-%dT%H:%M:%SZ, e.g. 2000-12-31T12:59:59Z. Defaults to 1 Hour prior to the current time"),
                            arguments: [
                                (
                                    name: "start-time",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "update",
                    description: Some("Update an existing role assignment for a user, group, or service principal"),
                    options: [
                        (
                            names: [
                                "--role-assignment",
                            ],
                            description: Some("Description of an existing role assignment as JSON, or a path to a file containing a JSON description"),
                            arguments: [
                                (
                                    name: "role-assignment",
                                ),
                            ],
                            required: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "definition",
            description: Some("Manage role definitions"),
            subcommands: [
                (
                    name: "create",
                    description: Some("Create a custom role definition"),
                    options: [
                        (
                            names: [
                                "--role-definition",
                            ],
                            description: Some("Description of a role as JSON, or a path to a file containing a JSON description"),
                            arguments: [
                                (
                                    name: "role-definition",
                                ),
                            ],
                            required: true,
                        ),
                    ],
                ),
                (
                    name: "delete",
                    description: Some("Delete a role definition"),
                    options: [
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("The role's name"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--custom-role-only",
                            ],
                            description: Some("Custom roles only(vs. build-in ones)"),
                        ),
                        (
                            names: [
                                "--resource-group",
                                "-g",
