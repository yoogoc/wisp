(
    version: 1,
    command: "dedicated-hsm",
    description: Some("Manage dedicated hsm with hardware security modules"),
    subcommands: [
        (
            name: "create",
            description: Some("Create a dedicated HSM in the specified subscription"),
            options: [
                (
                    names: [
                        "--name",
                    ],
                    description: Some("Name of the dedicated Hsm"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--location",
                        "-l",
                    ],
                    description: Some("Location. Values from: az account list-locations. You can configure the default location using az configure --defaults location=<location>"),
                    arguments: [
                        (
                            name: "location",
                        ),
                    ],
                ),
                (
                    names: [
                        "--mgmt-network-interfaces",
                        "-m",
                    ],
                    description: Some("Specifies the list of resource Ids for the network interfaces associated with the dedicated HSM"),
                    arguments: [
                        (
                            name: "mgmt-network-interfaces",
                        ),
                    ],
                ),
                (
                    names: [
                        "--mgmt-network-subnet",
                    ],
                    description: Some("Specifies the identifier of the subnet"),
                    arguments: [
                        (
                            name: "mgmt-network-subnet",
                        ),
                    ],
                ),
                (
                    names: [
                        "--network-interfaces",
                        "-i",
                    ],
                    description: Some("Specifies the list of resource Ids for the network interfaces associated with the dedicated HSM"),
                    arguments: [
                        (
                            name: "network-interfaces",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-wait",
                    ],
                    description: Some("Do not wait for the long-running operation to finish"),
                ),
                (
                    names: [
                        "--sku",
                    ],
                    description: Some("SKU of the dedicated HSM"),
                    arguments: [
                        (
                            name: "sku",
                            suggestions: [
                                (
                                    name: "SafeNet Luna Network HSM A790",
                                ),
                                (
                                    name: "payShield10K_LMK1_CPS250",
                                ),
                                (
                                    name: "payShield10K_LMK1_CPS2500",
                                ),
                                (
                                    name: "payShield10K_LMK1_CPS60",
                                ),
                                (
                                    name: "payShield10K_LMK2_CPS250",
                                ),
                                (
                                    name: "payShield10K_LMK2_CPS2500",
                                ),
                                (
                                    name: "payShield10K_LMK2_CPS60",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--stamp-id",
                    ],
                    description: Some("This field will be used when RP does not support Availability zones"),
                    arguments: [
                        (
                            name: "stamp-id",
                        ),
                    ],
                ),
                (
                    names: [
                        "--subnet",
                    ],
                    description: Some("Specifies the identifier of the subnet"),
                    arguments: [
                        (
                            name: "subnet",
                        ),
                    ],
                ),
                (
                    names: [
                        "--tags",
                    ],
                    description: Some("Space-separated tags: key[=value] [key[=value] ...]. Use \"\" to clear existing tags"),
                    arguments: [
                        (
                            name: "tags",
                        ),
                    ],
                ),
                (
                    names: [
                        "--zones",
                    ],
                    description: Some("The Dedicated Hsm zones"),
                    arguments: [
                        (
                            name: "zones",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "delete",
            description: Some("Deletes the specified Azure Dedicated HSM"),
            options: [
                (
                    names: [
                        "--ids",
                    ],
                    description: Some("One or more resource IDs (space-delimited). It should be a complete resource ID containing all information of 'Resource Id' arguments. You should provide either --ids or other 'Resource Id' arguments"),
                    arguments: [
                        (
                            name: "ids",
                        ),
                    ],
                ),
                (
                    names: [
                        "--name",
                    ],
                    description: Some("The name of the dedicated HSM to delete"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-wait",
                    ],
                    description: Some("Do not wait for the long-running operation to finish"),
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                ),
                (
                    names: [
                        "--subscription",
                    ],
                    description: Some("Name or ID of subscription. You can configure the default subscription using az account set -s NAME_OR_ID"),
                    arguments: [
                        (
                            name: "subscription",
                        ),
                    ],
                ),
                (
                    names: [
                        "--yes",
                        "-y",
                    ],
                    description: Some("Do not prompt for confirmation"),
                ),
            ],
        ),
        (
            name: "list",
            description: Some("The List operation gets information about the dedicated hsms associated with the subscription and within the specified resource group. And The List operation gets information about the dedicated HSMs associated with the subscription"),
            options: [
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                ),
                (
                    names: [
