(
    version: 1,
    command: "batchai",
    description: Some("Manage Batch AI resources"),
    subcommands: [
        (
            name: "cluster",
            description: Some("Commands to manage clusters"),
            subcommands: [
                (
                    name: "auto-scale",
                    description: Some("Set auto-scale parameters for a cluster"),
                    options: [
                        (
                            names: [
                                "--max",
                            ],
                            description: Some("Maximum number of nodes"),
                            arguments: [
                                (
                                    name: "max",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--min",
                            ],
                            description: Some("Minimum number of nodes"),
                            arguments: [
                                (
                                    name: "min",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--ids",
                            ],
                            description: Some("One or more resource IDs (space-delimited). It should be a complete resource ID containing all information of 'Resource Id' arguments. You should provide either --ids or other 'Resource Id' arguments"),
                            arguments: [
                                (
                                    name: "ids",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("Name of cluster"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--resource-group",
                                "-g",
                            ],
                            description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                            arguments: [
                                (
                                    name: "resource-group",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--subscription",
                            ],
                            description: Some("Name or ID of subscription. You can configure the default subscription using az account set -s NAME_OR_ID"),
                            arguments: [
                                (
                                    name: "subscription",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--workspace",
                                "-w",
                            ],
                            description: Some("Name of workspace"),
                            arguments: [
                                (
                                    name: "workspace",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "create",
                    description: Some("Create a cluster"),
                    options: [
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("Name of cluster"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--resource-group",
                                "-g",
                            ],
                            description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                            arguments: [
                                (
                                    name: "resource-group",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--workspace",
                                "-w",
                            ],
                            description: Some("Name of workspace"),
                            arguments: [
                                (
                                    name: "workspace",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--afs-mount-path",
                            ],
                            description: Some("Relative mount path for Azure File share. The file share will be available at $AZ_BATCHAI_MOUNT_ROOT/<relative_mount_path> folder"),
                            arguments: [
                                (
                                    name: "afs-mount-path",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--afs-name",
                            ],
                            description: Some("Name of Azure File Share to be mounted on each cluster node. Must be used in conjunction with --storage-account-name. Multiple shares can be mounted using configuration file (see --config-file option)"),
                            arguments: [
                                (
                                    name: "afs-name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--bfs-mount-path",
                            ],
                            description: Some("Relative mount path for Azure Storage container. The container will be available at $AZ_BATCHAI_MOUNT_ROOT/<relative_mount_path> folder"),
                            arguments: [
                                (
                                    name: "bfs-mount-path",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--bfs-name",
                            ],
                            description: Some("Name of Azure Storage container to be mounted on each cluster node. Must be used in conjunction with --storage-account-name. Multiple containers can be mounted using configuration file (see --config-file option)"),
                            arguments: [
                                (
                                    name: "bfs-name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--config-file",
                                "-f",
                            ],
                            description: Some("A path to a json file containing cluster create parameters (json representation of azure.mgmt.batchai.models.ClusterCreateParameters)"),
                            arguments: [
                                (
                                    name: "config-file",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--custom-image",
                            ],
                            description: Some("ARM ID of a virtual machine image to be used for nodes creation. Note, you need to provide --image containing information about the base image used for this image creation"),
                            arguments: [
                                (
                                    name: "custom-image",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--generate-ssh-keys",
                            ],
                            description: Some("Generate SSH public and private key files in ~/.ssh directory (if missing)"),
                            arguments: [
                                (
                                    name: "generate-ssh-keys",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--image",
                                "-i",
                            ],
                            description: Some("Operation system image for cluster nodes. The value may contain an alias (UbuntuLTS, UbuntuDSVM) or specify image details in the form \"publisher:offer:sku:version\". If image configuration is not provided via command line or configuration file, Batch AI will choose default OS image"),
                            arguments: [
                                (
                                    name: "image",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--max",
                            ],
                            description: Some("Max nodes count for the auto-scale cluster"),
                            arguments: [
                                (
                                    name: "max",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--min",
                            ],
                            description: Some("Min nodes count for the auto-scale cluster"),
                            arguments: [
                                (
                                    name: "min",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--nfs",
                            ],
                            description: Some("Name or ARM ID of a file server to be mounted on each cluster node. You need to provide full ARM ID if the file server belongs to a different workspace. Multiple NFS can be mounted using configuration file (see --config-file option)"),
                            arguments: [
                                (
                                    name: "nfs",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--nfs-mount-path",
                            ],
                            description: Some("Relative mount path for NFS. The NFS will be available at $AZ_BATCHAI_MOUNT_ROOT/<relative_mount_path> folder"),
                            arguments: [
                                (
                                    name: "nfs-mount-path",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--password",
                                "-p",
                            ],
                            description: Some("Optional password for the admin user account to be created on each compute node"),
                            arguments: [
                                (
                                    name: "password",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--setup-task",
                            ],
                            description: Some("A command line which should be executed on each compute node when it's got allocated or rebooted. The task is executed in a bash subshell under root account"),
                            arguments: [
                                (
                                    name: "setup-task",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--setup-task-output",
                            ],
                            description: Some("Directory path to store where setup-task's logs. Note, Batch AI will create several helper directories under this path. The created directories are reported as stdOutErrPathSuffix by 'az cluster show' command"),
                            arguments: [
                                (
                                    name: "setup-task-output",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--ssh-key",
                                "-k",
                            ],
                            description: Some("Optional SSH public key value or path. If ommited and no password specified, default SSH key (~/.ssh/id_rsa.pub) will be used"),
                            arguments: [
                                (
                                    name: "ssh-key",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--storage-account-key",
                            ],
                            description: Some("Storage account key. Required if the storage account belongs to a different subscription. Can be specified using AZURE_BATCHAI_STORAGE_KEY environment variable"),
                            arguments: [
                                (
                                    name: "storage-account-key",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--storage-account-name",
                            ],
                            description: Some("Storage account name for Azure File Shares and/or Azure Storage Containers to be mounted on each cluster node. Can be specified using AZURE_BATCHAI_STORAGE_ACCOUNT environment variable"),
                            arguments: [
                                (
                                    name: "storage-account-name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--subnet",
                            ],
                            description: Some("ARM ID of a virtual network subnet to put the cluster in"),
                            arguments: [
                                (
                                    name: "subnet",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--target",
                                "-t",
                            ],
                            description: Some("Number of nodes which should be allocated immediately after cluster creation. If the cluster is in auto-scale mode, BatchAI can change the number of nodes later based on number of running and queued jobs"),
                            arguments: [
                                (
                                    name: "target",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--use-auto-storage",
                            ],
                            description: Some("If provided, the command will create a storage account in a new or existing resource group named \"batchaiautostorage\". It will also create Azure File Share with name \"batchaishare\", Azure Blob Container with name \"batchaicontainer\". The File Share and Blob Container will be mounted on each cluster node at $AZ_BATCHAI_MOUNT_ROOT/autoafs and $AZ_BATCHAI_MOUNT_ROOT/autobfs. If the resource group already exists and contains an approapriate storage account belonging to the same region as cluster, this command will reuse existing storage account"),
                        ),
                        (
                            names: [
                                "--user-name",
                                "-u",
                            ],
                            description: Some("Name of admin user account to be created on each compute node. If the value is not provided and no user configuration is provided in the config file, current user's name will be used"),
                            arguments: [
                                (
                                    name: "user-name",
