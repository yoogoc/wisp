                                (
                                    name: "location",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--resource-group",
                                "-g",
                            ],
                            description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                            arguments: [
                                (
                                    name: "resource-group",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--authentication-method",
                            ],
                            description: Some("Authentication mode can be None or Cassandra. If None, no authentication will be required to connect to the Cassandra API. If Cassandra, then passwords will be used"),
                            arguments: [
                                (
                                    name: "authentication-method",
                                    suggestions: [
                                        (
                                            name: "Cassandra",
                                        ),
                                        (
                                            name: "None",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--cassandra-version",
                            ],
                            description: Some("The version of Cassandra chosen"),
                            arguments: [
                                (
                                    name: "cassandra-version",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--client-certificates",
                            ],
                            description: Some("If specified, enables client certificate authentication to the Cassandra API"),
                            arguments: [
                                (
                                    name: "client-certificates",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--cluster-name-override",
                            ],
                            description: Some("If a cluster must have a name that is not a valid azure resource name, this field can be specified to choose the Cassandra cluster name. Otherwise, the resource name will be used as the cluster name"),
                            arguments: [
                                (
                                    name: "cluster-name-override",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--external-gossip-certificates",
