(
    version: 1,
    command: "managed-cassandra",
    description: Some("Azure Managed Cassandra"),
    subcommands: [
        (
            name: "cluster",
            description: Some("Azure Managed Cassandra Cluster"),
            subcommands: [
                (
                    name: "create",
                    description: Some("Create a Managed Cassandra Cluster"),
                    options: [
                        (
                            names: [
                                "--cluster-name",
                                "-c",
                            ],
                            description: Some("Cluster Name"),
                            arguments: [
                                (
                                    name: "cluster-name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--delegated-management-subnet-id",
                                "-s",
                            ],
                            description: Some("The resource id of a subnet where the ip address of the cassandra management server will be allocated. This subnet must have connectivity to the delegated_subnet_id subnet of each data center"),
                            arguments: [
                                (
                                    name: "delegated-management-subnet-id",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--location",
                                "-l",
                            ],
                            description: Some("Azure Location of the Cluster"),
