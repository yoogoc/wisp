(
    version: 1,
    command: "rest",
    description: Some("Invoke a custom request"),
    options: [
        (
            names: [
                "--uri",
                "--url",
                "-u",
            ],
            description: Some("Request URL. If it doesn't start with a host, CLI assumes it as an Azure resource ID and prefixes it with the ARM endpoint of the current cloud shown by az cloud show --query endpoints.resourceManager. Common token {subscriptionId} will be replaced with the current subscription ID specified by az account set"),
            arguments: [
                (
                    name: "uri",
                ),
            ],
            required: true,
        ),
        (
            names: [
                "--body",
                "-b",
            ],
            description: Some("Request body. Use @{file} to load from a file. For quoting issues in different terminals, see https://github.com/Azure/azure-cli/blob/dev/doc/use_cli_effectively.md#quoting-issues"),
            arguments: [
                (
                    name: "body",
                ),
            ],
        ),
        (
            names: [
                "--headers",
            ],
            description: Some("Space-separated headers in KEY=VALUE format or JSON string. Use @{file} to load from a file"),
            arguments: [
                (
                    name: "headers",
                ),
            ],
        ),
        (
            names: [
                "--method",
                "-m",
            ],
            description: Some("HTTP request method"),
            arguments: [
                (
                    name: "method",
                    suggestions: [
                        (
                            name: "delete",
                        ),
                        (
                            name: "get",
                        ),
                        (
                            name: "head",
                        ),
                        (
                            name: "options",
                        ),
                        (
                            name: "patch",
                        ),
                        (
                            name: "post",
                        ),
                        (
                            name: "put",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--output-file",
            ],
            description: Some("Save response payload to a file"),
            arguments: [
                (
                    name: "output-file",
                ),
            ],
        ),
        (
            names: [
                "--resource",
            ],
            description: Some("Resource url for which CLI should acquire a token from AAD in order to access the service. The token will be placed in the Authorization header. By default, CLI can figure this out based on --url argument, unless you use ones not in the list of \"az cloud show --query endpoints\""),
            arguments: [
                (
                    name: "resource",
                ),
            ],
        ),
        (
            names: [
                "--skip-authorization-header",
            ],
            description: Some("Do not auto-append Authorization header"),
        ),
        (
            names: [
                "--uri-parameters",
                "--url-parameters",
            ],
            description: Some("Query parameters in the URL. Space-separated queries in KEY=VALUE format or JSON string. Use @{file} to load from a file"),
            arguments: [
                (
                    name: "uri-parameters",
                ),
            ],
        ),
    ],
)
