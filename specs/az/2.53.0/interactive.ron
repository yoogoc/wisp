        (
            names: [
                "--style",
                "-s",
            ],
            description: Some("The colors of the shell"),
            arguments: [
                (
                    name: "style",
                    suggestions: [
                        (
                            name: "bg",
                        ),
                        (
                            name: "br",
                        ),
                        (
                            name: "contrast",
                        ),
                        (
                            name: "default",
                        ),
                        (
                            name: "grey",
                        ),
                        (
                            name: "halloween",
                        ),
                        (
                            name: "neon",
                        ),
                        (
                            name: "none",
                        ),
                        (
                            name: "pastel",
                        ),
                        (
                            name: "primary",
                        ),
                        (
                            name: "purple",
                        ),
                        (
                            name: "quiet",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--update",
            ],
            description: Some("Update the Interactive extension to the latest available"),
            arguments: [
                (
                    name: "update",
                ),
            ],
        ),
    ],
)
