(
    version: 1,
    command: "healthbot",
    description: Some("Manage bot with healthbot"),
    subcommands: [
        (
            name: "create",
            description: Some("Create a new HealthBot"),
            options: [
                (
                    names: [
                        "--bot-name",
                        "--name",
                        "-n",
                    ],
                    description: Some("The name of the Bot resource"),
                    arguments: [
                        (
                            name: "bot-name",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--sku",
                    ],
                    description: Some("The name of the HealthBot SKU"),
                    arguments: [
                        (
                            name: "sku",
                            suggestions: [
                                (
                                    name: "C0",
                                ),
                                (
                                    name: "F0",
                                ),
                                (
                                    name: "S1",
                                ),
                            ],
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--location",
                        "-l",
                    ],
                    description: Some("Location. Values from: az account list-locations. You can configure the default location using az configure --defaults location=<location>"),
                    arguments: [
                        (
                            name: "location",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-wait",
                    ],
                    description: Some("Do not wait for the long-running operation to finish"),
                ),
                (
                    names: [
                        "--tags",
                    ],
                    description: Some("Space-separated tags: key[=value] [key[=value] ...]. Use \"\" to clear existing tags"),
                    arguments: [
                        (
                            name: "tags",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "delete",
            description: Some("Delete a HealthBot"),
            options: [
                (
                    names: [
                        "--bot-name",
                        "--name",
                        "-n",
                    ],
                    description: Some("The name of the Bot resource"),
                    arguments: [
                        (
                            name: "bot-name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--ids",
                    ],
                    description: Some("One or more resource IDs (space-delimited). It should be a complete resource ID containing all information of 'Resource Id' arguments. You should provide either --ids or other 'Resource Id' arguments"),
                    arguments: [
                        (
                            name: "ids",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-wait",
                    ],
                    description: Some("Do not wait for the long-running operation to finish"),
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                ),
                (
                    names: [
                        "--subscription",
                    ],
                    description: Some("Name or ID of subscription. You can configure the default subscription using az account set -s NAME_OR_ID"),
                    arguments: [
                        (
                            name: "subscription",
                        ),
                    ],
                ),
                (
                    names: [
                        "--yes",
                        "-y",
                    ],
                    description: Some("Do not prompt for confirmation"),
                ),
            ],
        ),
        (
            name: "list",
            description: Some("Returns all the resources of a particular type belonging to a resource group And Returns all the resources of a particular type belonging to a subscription"),
            options: [
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "show",
            description: Some("Get a HealthBot"),
            options: [
                (
                    names: [
                        "--bot-name",
                        "--name",
                        "-n",
                    ],
                    description: Some("The name of the Bot resource"),
                    arguments: [
                        (
                            name: "bot-name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--ids",
                    ],
                    description: Some("One or more resource IDs (space-delimited). It should be a complete resource ID containing all information of 'Resource Id' arguments. You should provide either --ids or other 'Resource Id' arguments"),
                    arguments: [
                        (
                            name: "ids",
                        ),
                    ],
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                ),
                (
                    names: [
                        "--subscription",
                    ],
                    description: Some("Name or ID of subscription. You can configure the default subscription using az account set -s NAME_OR_ID"),
                    arguments: [
                        (
                            name: "subscription",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "update",
            description: Some("Patch a HealthBot"),
            options: [
                (
                    names: [
                        "--bot-name",
                        "--name",
                        "-n",
                    ],
                    description: Some("The name of the Bot resource"),
                    arguments: [
                        (
                            name: "bot-name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--ids",
                    ],
                    description: Some("One or more resource IDs (space-delimited). It should be a complete resource ID containing all information of 'Resource Id' arguments. You should provide either --ids or other 'Resource Id' arguments"),
                    arguments: [
                        (
                            name: "ids",
                        ),
                    ],
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                ),
                (
                    names: [
                        "--sku",
                    ],
                    description: Some("The name of the HealthBot SKU"),
                    arguments: [
                        (
                            name: "sku",
                            suggestions: [
                                (
                                    name: "C0",
                                ),
                                (
                                    name: "F0",
                                ),
                                (
                                    name: "S1",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--subscription",
                    ],
                    description: Some("Name or ID of subscription. You can configure the default subscription using az account set -s NAME_OR_ID"),
                    arguments: [
                        (
                            name: "subscription",
                        ),
                    ],
                ),
                (
                    names: [
                        "--tags",
                    ],
                    description: Some("Space-separated tags: key[=value] [key[=value] ...]. Use \"\" to clear existing tags"),
                    arguments: [
                        (
                            name: "tags",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "wait",
            description: Some("Place the CLI in a waiting state until a condition of the healthbot is met"),
            options: [
                (
                    names: [
                        "--bot-name",
                        "--name",
                        "-n",
                    ],
                    description: Some("The name of the Bot resource"),
                    arguments: [
                        (
                            name: "bot-name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--created",
                    ],
                    description: Some("Wait until created with 'provisioningState' at 'Succeeded'"),
                ),
                (
                    names: [
                        "--custom",
                    ],
                    description: Some("Wait until the condition satisfies a custom JMESPath query. E.g. provisioningState!='InProgress', instanceView.statuses[?code=='PowerState/running']"),
                    arguments: [
                        (
                            name: "custom",
                        ),
                    ],
                ),
                (
                    names: [
                        "--deleted",
                    ],
                    description: Some("Wait until deleted"),
                ),
                (
                    names: [
                        "--exists",
                    ],
                    description: Some("Wait until the resource exists"),
                ),
                (
                    names: [
                        "--ids",
                    ],
                    description: Some("One or more resource IDs (space-delimited). It should be a complete resource ID containing all information of 'Resource Id' arguments. You should provide either --ids or other 'Resource Id' arguments"),
                    arguments: [
                        (
                            name: "ids",
                        ),
                    ],
                ),
                (
                    names: [
                        "--interval",
                    ],
                    description: Some("Polling interval in seconds"),
                    arguments: [
                        (
                            name: "interval",
                        ),
                    ],
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                ),
                (
                    names: [
                        "--subscription",
                    ],
                    description: Some("Name or ID of subscription. You can configure the default subscription using az account set -s NAME_OR_ID"),
                    arguments: [
                        (
                            name: "subscription",
                        ),
                    ],
                ),
                (
                    names: [
                        "--timeout",
                    ],
                    description: Some("Maximum wait in seconds"),
                    arguments: [
                        (
                            name: "timeout",
                        ),
                    ],
                ),
                (
                    names: [
                        "--updated",
                    ],
                    description: Some("Wait until updated with provisioningState at 'Succeeded'"),
                ),
            ],
        ),
    ],
)
