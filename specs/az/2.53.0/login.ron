(
    version: 1,
    command: "login",
    description: Some("Log in to Azure"),
    options: [
        (
            names: [
                "--allow-no-subscriptions",
            ],
            description: Some("Support access tenants without subscriptions. It's uncommon but useful to run tenant level commands, such as 'az ad'"),
        ),
        (
            names: [
                "--federated-token",
            ],
            description: Some("Federated token that can be used for OIDC token exchange"),
            arguments: [
                (
                    name: "federated-token",
                ),
            ],
        ),
        (
            names: [
                "--identity",
                "-i",
            ],
            description: Some("Log in using the Virtual Machine's identity"),
        ),
        (
            names: [
                "--password",
                "-p",
            ],
            description: Some("Credentials like user password, or for a service principal, provide client secret or a pem file with key and public certificate. Will prompt if not given"),
            arguments: [
                (
                    name: "password",
                ),
            ],
        ),
        (
            names: [
                "--scope",
            ],
            description: Some("Used in the /authorize request. It can cover only one static resource"),
            arguments: [
                (
                    name: "scope",
                ),
            ],
        ),
        (
            names: [
                "--service-principal",
            ],
            description: Some("The credential representing a service principal"),
            arguments: [
                (
                    name: "service-principal",
                ),
            ],
        ),
        (
            names: [
                "--tenant",
                "-t",
            ],
            description: Some("The AAD tenant, must provide when using service principals"),
            arguments: [
                (
                    name: "tenant",
                ),
            ],
        ),
        (
            names: [
                "--use-cert-sn-issuer",
            ],
            description: Some("Used with a service principal configured with Subject Name and Issuer Authentication in order to support automatic certificate rolls"),
            arguments: [
                (
                    name: "use-cert-sn-issuer",
                ),
            ],
        ),
        (
            names: [
                "--use-device-code",
            ],
            description: Some("Use CLI's old authentication flow based on device code. CLI will also use this if it can't launch a browser in your behalf, e.g. in remote SSH or Cloud Shell"),
        ),
        (
            names: [
                "--username",
                "-u",
            ],
            description: Some("User name, service principal, or managed service identity ID"),
            arguments: [
                (
                    name: "username",
                ),
            ],
        ),
    ],
)
