(
    version: 1,
    command: "self-help",
    description: Some("Azure SelfHelp will help you troubleshoot issues with Azure resources"),
    subcommands: [
        (
            name: "check-name-availability",
            description: Some("This API is used to check the uniqueness of a resource name used for a diagnostic check"),
            options: [
                (
                    names: [
                        "--scope",
                    ],
                    description: Some("This is an extension resource provider and only resource level extension is supported at the moment"),
                    arguments: [
                        (
                            name: "scope",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--name",
                    ],
                    description: Some("The name of the resource for which availability needs to be checked"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--type",
                    ],
                    description: Some("The resource type"),
                    arguments: [
                        (
                            name: "type",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "diagnostic",
            description: Some("Diagnostic command will help you create diagnostics for azure resources"),
            subcommands: [
                (
                    name: "create",
                    description: Some("Creates a diagnostics that will help you troubleshoot an issue with your azure resource"),
                    options: [
                        (
                            names: [
                                "--diagnostic-name",
                            ],
                            description: Some("Unique resource name for diagnostic proxy resources"),
                            arguments: [
                                (
                                    name: "diagnostic-name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--scope",
                            ],
                            description: Some("This is an extension resource provider and only resource level extension is supported at the moment"),
                            arguments: [
                                (
                                    name: "scope",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--global-parameters",
                            ],
                            description: Some("Global parameters that can be passed to all solutionIds. Support shorthand-syntax, json-file and yaml-file. Try \"??\" to show more"),
                            arguments: [
                                (
                                    name: "global-parameters",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--insights",
                            ],
                            description: Some("SolutionIds that are needed to be invoked. Support shorthand-syntax, json-file and yaml-file. Try \"??\" to show more"),
                            arguments: [
                                (
                                    name: "insights",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--no-wait",
                            ],
                            description: Some("Do not wait for the long-running operation to finish"),
                            arguments: [
                                (
                                    name: "no-wait",
                                    suggestions: [
                                        (
                                            name: "0",
                                        ),
                                        (
                                            name: "1",
                                        ),
                                        (
                                            name: "f",
                                        ),
                                        (
                                            name: "false",
                                        ),
                                        (
                                            name: "n",
                                        ),
                                        (
                                            name: "no",
                                        ),
                                        (
                                            name: "t",
                                        ),
                                        (
                                            name: "true",
                                        ),
                                        (
                                            name: "y",
                                        ),
                                        (
                                            name: "yes",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "show",
                    description: Some("Get the diagnostics using the 'diagnosticsResourceName' you chose while creating the diagnostic"),
                    options: [
                        (
                            names: [
                                "--diagnostic-name",
                            ],
                            description: Some("Unique resource name for diagnostic proxy resources"),
                            arguments: [
                                (
                                    name: "diagnostic-name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--scope",
                            ],
                            description: Some("This is an extension resource provider and only resource level extension is supported at the moment"),
                            arguments: [
                                (
                                    name: "scope",
                                ),
                            ],
                            required: true,
                        ),
                    ],
                ),
                (
                    name: "wait",
                    description: Some("Place the CLI in a waiting state until a condition is met"),
                    options: [
                        (
                            names: [
                                "--diagnostic-name",
                            ],
                            description: Some("Unique resource name for diagnostic proxy resources"),
                            arguments: [
                                (
                                    name: "diagnostic-name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--scope",
                            ],
                            description: Some("This is an extension resource provider and only resource level extension is supported at the moment"),
                            arguments: [
                                (
                                    name: "scope",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--created",
                            ],
                            description: Some("Wait until created with 'provisioningState' at 'Succeeded'"),
                        ),
                        (
                            names: [
                                "--custom",
                            ],
                            description: Some("Wait until the condition satisfies a custom JMESPath query. E.g. provisioningState!='InProgress', instanceView.statuses[?code=='PowerState/running']"),
                            arguments: [
                                (
                                    name: "custom",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--deleted",
                            ],
                            description: Some("Wait until deleted"),
                        ),
                        (
                            names: [
                                "--exists",
                            ],
                            description: Some("Wait until the resource exists"),
                        ),
                        (
                            names: [
                                "--interval",
                            ],
                            description: Some("Polling interval in seconds"),
                            arguments: [
                                (
                                    name: "interval",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--timeout",
                            ],
                            description: Some("Maximum wait in seconds"),
                            arguments: [
                                (
                                    name: "timeout",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--updated",
                            ],
                            description: Some("Wait until updated with provisioningState at 'Succeeded'"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "discovery-solution",
            description: Some("Discovery-solution command will help you discover available solutions based on your resource type and problem classification Id"),
            subcommands: [
                (
                    name: "list",
                    description: Some("List the existing available solutions for the problemClassificationId or the resourceUri for the Azure resource"),
                    options: [
                        (
                            names: [
                                "--scope",
                            ],
                            description: Some("This is an extension resource provider and only resource level extension is supported at the moment"),
                            arguments: [
                                (
                                    name: "scope",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--filter",
                            ],
                            description: Some("Can be used to filter solutionIds by 'ProblemClassificationId'. The filter supports only 'and' and 'eq' operators. Example: $filter=ProblemClassificationId eq '1ddda5b4-cf6c-4d4f-91ad-bc38ab0e811e' and ProblemClassificationId eq '0a9673c2-7af6-4e19-90d3-4ee2461076d9'"),
                            arguments: [
                                (
                                    name: "filter",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--skiptoken",
                            ],
                            description: Some("Skiptoken is only used if a previous operation returned a partial result. If a previous response contains a nextLink element, the value of the nextLink element will include a skiptoken parameter that specifies a starting point to use for subsequent calls"),
                            arguments: [
                                (
                                    name: "skiptoken",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
    ],
)
