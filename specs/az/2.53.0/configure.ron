(
    version: 1,
    command: "configure",
    description: Some("Manage Azure CLI configuration. This command is interactive"),
    options: [
        (
            names: [
                "--defaults",
                "-d",
            ],
            description: Some("Space-separated 'name=value' pairs for common argument defaults"),
            arguments: [
                (
                    name: "defaults",
                ),
            ],
        ),
        (
            names: [
                "--list-defaults",
                "-l",
            ],
            description: Some("List all applicable defaults"),
            arguments: [
                (
                    name: "list-defaults",
                    suggestions: [
                        (
                            name: "false",
                        ),
                        (
                            name: "true",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--scope",
            ],
            description: Some("Scope of defaults. Using \"local\" for settings only effective under current folder"),
            arguments: [
                (
                    name: "scope",
                    suggestions: [
                        (
                            name: "global",
                        ),
                        (
                            name: "local",
                        ),
                    ],
                ),
            ],
        ),
    ],
)
