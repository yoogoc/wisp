                    ],
                    description: Some("Update an object by specifying a property path and value to set. Example: --set property1.property2="),
                    arguments: [
                        (
                            name: "set",
                        ),
                    ],
                ),
                (
                    names: [
                        "--type",
                        "-t",
                    ],
                    description: Some("The type of the proximity placement group"),
                    arguments: [
                        (
                            name: "type",
                            suggestions: [
                                (
                                    name: "Standard",
                                ),
                                (
                                    name: "Ultra",
                                ),
                            ],
