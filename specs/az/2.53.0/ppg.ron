(
    version: 1,
    command: "ppg",
    description: Some("Manage Proximity Placement Groups"),
    subcommands: [
        (
            name: "create",
            description: Some("Create a proximity placement group"),
            options: [
                (
                    names: [
                        "--name",
                        "-n",
                    ],
                    description: Some("The name of the proximity placement group"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--intent-vm-sizes",
                    ],
                    description: Some("Specify possible sizes of virtual machines that can be created in the proximity placement group"),
                    arguments: [
                        (
                            name: "intent-vm-sizes",
                        ),
                    ],
                ),
                (
                    names: [
                        "--location",
                        "-l",
                    ],
                    description: Some("Location. Values from: az account list-locations. You can configure the default location using az configure --defaults location=<location>"),
                    arguments: [
                        (
                            name: "location",
                        ),
                    ],
                ),
                (
                    names: [
                        "--tags",
                    ],
                    description: Some("Space-separated tags: key[=value] [key[=value] ...]. Use \"\" to clear existing tags"),
                    arguments: [
                        (
                            name: "tags",
                        ),
                    ],
                ),
                (
                    names: [
                        "--type",
                        "-t",
                    ],
                    description: Some("The type of the proximity placement group"),
                    arguments: [
                        (
                            name: "type",
                            suggestions: [
                                (
                                    name: "Standard",
                                ),
                                (
                                    name: "Ultra",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--zone",
                        "-z",
                    ],
                    description: Some("Availability zone into which to provision the resource"),
                    arguments: [
                        (
                            name: "zone",
                            suggestions: [
                                (
                                    name: "1",
                                ),
                                (
                                    name: "2",
                                ),
                                (
                                    name: "3",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "delete",
            description: Some("Delete a proximity placement group"),
            options: [
                (
                    names: [
                        "--ids",
                    ],
                    description: Some("One or more resource IDs (space-delimited). It should be a complete resource ID containing all information of 'Resource Id' arguments. You should provide either --ids or other 'Resource Id' arguments"),
                    arguments: [
                        (
                            name: "ids",
                        ),
                    ],
                ),
                (
                    names: [
                        "--proximity-placement-group-name",
                        "--name",
                        "-n",
                    ],
                    description: Some("The name of the proximity placement group"),
                    arguments: [
                        (
                            name: "proximity-placement-group-name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                ),
                (
                    names: [
                        "--subscription",
                    ],
                    description: Some("Name or ID of subscription. You can configure the default subscription using az account set -s NAME_OR_ID"),
                    arguments: [
                        (
                            name: "subscription",
                        ),
                    ],
                ),
            ],
        ),
        (
