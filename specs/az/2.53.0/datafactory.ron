(
    version: 1,
    command: "datafactory",
    description: Some("Manage Data Factory"),
    subcommands: [
        (
            name: "activity-run",
            description: Some("Manage activity run with datafactory"),
            subcommands: [
                (
                    name: "query-by-pipeline-run",
                    description: Some("Query activity runs based on input filter conditions"),
                    options: [
                        (
                            names: [
                                "--last-updated-after",
                            ],
                            description: Some("The time at or after which the run event was updated in 'ISO 8601' format"),
                            arguments: [
                                (
                                    name: "last-updated-after",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--last-updated-before",
                            ],
                            description: Some("The time at or before which the run event was updated in 'ISO 8601' format"),
                            arguments: [
                                (
                                    name: "last-updated-before",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--continuation-token",
                            ],
                            description: Some("The continuation token for getting the next page of results. Null for first page"),
                            arguments: [
                                (
                                    name: "continuation-token",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--factory-name",
                            ],
                            description: Some("The factory name"),
                            arguments: [
                                (
                                    name: "factory-name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--filters",
                            ],
                            description: Some("List of filters"),
