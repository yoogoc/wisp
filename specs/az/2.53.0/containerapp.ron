                        (
                            names: [
                                "--dapr-app-id",
                            ],
                            description: Some("The Dapr application identifier"),
                            arguments: [
                                (
                                    name: "dapr-app-id",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--dapr-app-port",
                            ],
                            description: Some("The port Dapr uses to talk to the application"),
                            arguments: [
                                (
                                    name: "dapr-app-port",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--dapr-app-protocol",
                            ],
                            description: Some("The protocol Dapr uses to talk to the application"),
                            arguments: [
                                (
                                    name: "dapr-app-protocol",
                                    suggestions: [
                                        (
                                            name: "grpc",
                                        ),
                                        (
                                            name: "http",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--dapr-http-max-request-size",
                                "--dhmrs",
                            ],
                            description: Some("Increase max size of request body http and grpc servers parameter in MB to handle uploading of big files"),
                            arguments: [
                                (
                                    name: "dapr-http-max-request-size",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--dapr-http-read-buffer-size",
                                "--dhrbs",
                            ],
                            description: Some("Dapr max size of http header read buffer in KB to handle when sending multi-KB headers"),
                            arguments: [
                                (
                                    name: "dapr-http-read-buffer-size",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--dapr-log-level",
                            ],
                            description: Some("Set the log level for the Dapr sidecar"),
                            arguments: [
                                (
                                    name: "dapr-log-level",
                                    suggestions: [
                                        (
                                            name: "debug",
                                        ),
                                        (
                                            name: "error",
                                        ),
