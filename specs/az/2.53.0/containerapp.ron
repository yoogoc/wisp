(
    version: 1,
    command: "containerapp",
    description: Some("Manage Azure Container Apps"),
    subcommands: [
        (
            name: "auth",
            description: Some("Manage containerapp authentication and authorization"),
            subcommands: [
                (
                    name: "show",
                    description: Some("Show the authentication settings for the containerapp"),
                    options: [
                        (
                            names: [
                                "--ids",
                            ],
                            description: Some("One or more resource IDs (space-delimited). It should be a complete resource ID containing all information of 'Resource Id' arguments. You should provide either --ids or other 'Resource Id' arguments"),
                            arguments: [
                                (
                                    name: "ids",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("The name of the Containerapp. A name must consist of lower case alphanumeric characters or '-', start with a letter, end with an alphanumeric character, cannot have '--', and must be less than 32 characters"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--resource-group",
                                "-g",
                            ],
                            description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                            arguments: [
                                (
                                    name: "resource-group",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--subscription",
                            ],
                            description: Some("Name or ID of subscription. You can configure the default subscription using az account set -s NAME_OR_ID"),
                            arguments: [
                                (
                                    name: "subscription",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "update",
                    description: Some("Update the authentication settings for the containerapp"),
                    options: [
                        (
                            names: [
                                "--unauthenticated-client-action",
                                "--action",
                            ],
                            description: Some("The action to take when an unauthenticated client attempts to access the app"),
                            arguments: [
                                (
                                    name: "unauthenticated-client-action",
                                    suggestions: [
                                        (
                                            name: "AllowAnonymous",
                                        ),
                                        (
                                            name: "RedirectToLoginPage",
                                        ),
                                        (
                                            name: "Return401",
                                        ),
                                        (
                                            name: "Return403",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--config-file-path",
                            ],
                            description: Some("The path of the config file containing auth settings if they come from a file"),
                            arguments: [
                                (
                                    name: "config-file-path",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--proxy-custom-host-header",
                                "--custom-host-header",
                            ],
                            description: Some("The name of the header containing the host of the request"),
                            arguments: [
                                (
                                    name: "proxy-custom-host-header",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--proxy-custom-proto-header",
                                "--custom-proto-header",
                            ],
                            description: Some("The name of the header containing the scheme of the request"),
                            arguments: [
                                (
                                    name: "proxy-custom-proto-header",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--enabled",
                            ],
                            description: Some("True if the Authentication / Authorization feature is enabled for the current app; otherwise, false"),
                            arguments: [
                                (
                                    name: "enabled",
                                    suggestions: [
                                        (
                                            name: "false",
                                        ),
                                        (
                                            name: "true",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--excluded-paths",
                            ],
                            description: Some("The list of paths that should be excluded from authentication rules"),
                            arguments: [
                                (
                                    name: "excluded-paths",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--ids",
                            ],
                            description: Some("One or more resource IDs (space-delimited). It should be a complete resource ID containing all information of 'Resource Id' arguments. You should provide either --ids or other 'Resource Id' arguments"),
                            arguments: [
                                (
                                    name: "ids",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("The name of the Containerapp. A name must consist of lower case alphanumeric characters or '-', start with a letter, end with an alphanumeric character, cannot have '--', and must be less than 32 characters"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--proxy-convention",
                            ],
                            description: Some("The convention used to determine the url of the request made"),
                            arguments: [
                                (
                                    name: "proxy-convention",
                                    suggestions: [
                                        (
                                            name: "Custom",
                                        ),
                                        (
                                            name: "NoProxy",
                                        ),
                                        (
                                            name: "Standard",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--redirect-provider",
                            ],
                            description: Some("The default authentication provider to use when multiple providers are configured"),
                            arguments: [
                                (
                                    name: "redirect-provider",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--require-https",
                            ],
                            description: Some("False if the authentication/authorization responses not having the HTTPS scheme are permissible; otherwise, true"),
