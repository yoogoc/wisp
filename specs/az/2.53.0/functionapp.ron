                                        ),
                                    ],
                                    required: true,
                                ),
                                (
                                    names: [
                                        "--action",
                                    ],
                                    description: Some("Allow or deny access"),
                                    arguments: [
                                        (
                                            name: "action",
                                            suggestions: [
                                                (
                                                    name: "Allow",
                                                ),
                                                (
                                                    name: "Deny",
                                                ),
                                            ],
                                        ),
                                    ],
                                ),
                                (
                                    names: [
                                        "--description",
                                    ],
                                    description: Some("Description of the access restriction rule"),
                                    arguments: [
                                        (
                                            name: "description",
                                        ),
                                    ],
                                ),
                                (
                                    names: [
                                        "--http-headers",
                                    ],
