(
    version: 1,
    command: "functionapp",
    description: Some("Manage function apps. To install the Azure Functions Core tools see https://github.com/Azure/azure-functions-core-tools"),
    subcommands: [
        (
            name: "app",
            description: Some("Commands to manage Azure Functions app"),
            subcommands: [
                (
                    name: "up",
                    description: Some("Deploy to Azure Functions via GitHub actions"),
                    options: [
                        (
                            names: [
                                "--app-name",
                            ],
                            description: Some("FunctionApp name in the subscription"),
                            arguments: [
                                (
                                    name: "app-name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--branch-name",
                            ],
                            description: Some("New branch name to be created to check in files and raise a PR"),
                            arguments: [
                                (
                                    name: "branch-name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--do-not-wait",
                            ],
                            description: Some("Do not wait for workflow completion"),
                        ),
                        (
                            names: [
                                "--repository",
                                "-r",
                            ],
                            description: Some("GitHub repository URL e.g. https://github.com/azure/azure-cli"),
                            arguments: [
                                (
                                    name: "repository",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "config",
            description: Some("Configure a function app"),
            subcommands: [
                (
                    name: "set",
                    description: Some("Set an existing function app's configuration"),
                    options: [
                        (
                            names: [
                                "--always-on",
                            ],
                            description: Some("Ensure web app gets loaded all the time, rather unloaded after been idle. Recommended when you have continuous web jobs running"),
                            arguments: [
                                (
                                    name: "always-on",
                                    suggestions: [
                                        (
                                            name: "false",
                                        ),
                                        (
                                            name: "true",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--auto-heal-enabled",
                            ],
                            description: Some("Enable or disable auto heal"),
                            arguments: [
                                (
                                    name: "auto-heal-enabled",
                                    suggestions: [
                                        (
                                            name: "false",
                                        ),
                                        (
                                            name: "true",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--ftps-state",
                            ],
                            description: Some("Set the Ftps state value for an app. Default value is 'AllAllowed'"),
                            arguments: [
                                (
                                    name: "ftps-state",
                                    suggestions: [
                                        (
                                            name: "AllAllowed",
                                        ),
                                        (
                                            name: "Disabled",
                                        ),
                                        (
                                            name: "FtpsOnly",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--generic-configurations",
                            ],
                            description: Some("Provide site configuration list in a format of either key=value pair or @<json_file>. PowerShell and Windows Command Prompt users should use a JSON file to provide these configurations to avoid compatibility issues with escape characters"),
                            arguments: [
                                (
                                    name: "generic-configurations",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--http20-enabled",
                            ],
                            description: Some("Configures a web site to allow clients to connect over http2.0"),
                            arguments: [
                                (
                                    name: "http20-enabled",
                                    suggestions: [
                                        (
                                            name: "false",
                                        ),
                                        (
                                            name: "true",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--ids",
                            ],
                            description: Some("One or more resource IDs (space-delimited). It should be a complete resource ID containing all information of 'Resource Id' arguments. You should provide either --ids or other 'Resource Id' arguments"),
                            arguments: [
                                (
                                    name: "ids",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--java-container",
                            ],
                            description: Some("The java container, e.g., Tomcat, Jetty"),
                            arguments: [
                                (
                                    name: "java-container",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--java-container-version",
                            ],
                            description: Some("The version of the java container, e.g., '8.0.23' for Tomcat"),
                            arguments: [
                                (
                                    name: "java-container-version",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--java-version",
                            ],
                            description: Some("The version used to run your web app if using Java, e.g., '1.7' for Java 7, '1.8' for Java 8"),
                            arguments: [
                                (
                                    name: "java-version",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--linux-fx-version",
                            ],
                            description: Some("The runtime stack used for your linux-based webapp, e.g., \"RUBY|2.5.5\", \"NODE|12LTS\", \"PHP|7.2\", \"DOTNETCORE|2.1\". See https://aka.ms/linux-stacks for more info"),
                            arguments: [
                                (
                                    name: "linux-fx-version",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--min-tls-version",
                            ],
                            description: Some("The minimum version of TLS required for SSL requests, e.g., '1.0', '1.1', '1.2'"),
                            arguments: [
                                (
                                    name: "min-tls-version",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("Name of the function app"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--net-framework-version",
                            ],
                            description: Some("The version used to run your web app if using .NET Framework, e.g., 'v4.0' for .NET 4.6 and 'v3.0' for .NET 3.5"),
                            arguments: [
                                (
                                    name: "net-framework-version",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--number-of-workers",
                            ],
                            description: Some("The number of workers to be allocated"),
                            arguments: [
                                (
                                    name: "number-of-workers",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--php-version",
                            ],
                            description: Some("The version used to run your web app if using PHP, e.g., 5.5, 5.6, 7.0"),
                            arguments: [
                                (
                                    name: "php-version",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--powershell-version",
                            ],
                            description: Some("The version used to run your function app if using PowerShell, e.g., 7.2"),
                            arguments: [
                                (
                                    name: "powershell-version",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--prewarmed-instance-count",
                            ],
                            description: Some("Number of pre-warmed instances a function app has"),
                            arguments: [
                                (
                                    name: "prewarmed-instance-count",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--python-version",
                            ],
                            description: Some("The version used to run your web app if using Python, e.g., 2.7, 3.4"),
                            arguments: [
                                (
                                    name: "python-version",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--remote-debugging-enabled",
                            ],
                            description: Some("Enable or disable remote debugging"),
                            arguments: [
                                (
                                    name: "remote-debugging-enabled",
                                    suggestions: [
                                        (
                                            name: "false",
                                        ),
                                        (
                                            name: "true",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--resource-group",
                                "-g",
                            ],
                            description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                            arguments: [
                                (
                                    name: "resource-group",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--slot",
                                "-s",
                            ],
                            description: Some("The name of the slot. Default to the productions slot if not specified"),
                            arguments: [
                                (
                                    name: "slot",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--startup-file",
                            ],
                            description: Some("The startup file for linux hosted web apps, e.g. 'process.json' for Node.js web"),
                            arguments: [
                                (
                                    name: "startup-file",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--subscription",
                            ],
                            description: Some("Name or ID of subscription. You can configure the default subscription using az account set -s NAME_OR_ID"),
                            arguments: [
                                (
                                    name: "subscription",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--use-32bit-worker-process",
                            ],
                            description: Some("Use 32 bits worker process or not"),
                            arguments: [
                                (
                                    name: "use-32bit-worker-process",
                                    suggestions: [
                                        (
                                            name: "false",
                                        ),
                                        (
                                            name: "true",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--vnet-route-all-enabled",
                            ],
                            description: Some("Configure regional VNet integration to route all traffic to the VNet"),
                            arguments: [
                                (
                                    name: "vnet-route-all-enabled",
                                    suggestions: [
                                        (
                                            name: "false",
                                        ),
                                        (
                                            name: "true",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--web-sockets-enabled",
