                            description: Some("Enable or disable web sockets"),
                            arguments: [
                                (
                                    name: "web-sockets-enabled",
                                    suggestions: [
                                        (
                                            name: "false",
                                        ),
                                        (
                                            name: "true",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "show",
                    description: Some("Get the details of an existing function app's configuration"),
                    options: [
                        (
                            names: [
                                "--ids",
                            ],
                            description: Some("One or more resource IDs (space-delimited). It should be a complete resource ID containing all information of 'Resource Id' arguments. You should provide either --ids or other 'Resource Id' arguments"),
                            arguments: [
                                (
                                    name: "ids",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
