                                    arguments: [
                                        (
                                            name: "ids",
                                        ),
                                    ],
                                ),
                                (
                                    names: [
                                        "--ignore-missing-endpoint",
                                        "-i",
                                    ],
                                    description: Some("Create access restriction rule with checking if the subnet has Microsoft.Web service endpoint enabled"),
                                ),
                                (
                                    names: [
                                        "--ip-address",
                                    ],
                                    description: Some("IP address or CIDR range (optional comma separated list of up to 8 ranges)"),
                                    arguments: [
                                        (
                                            name: "ip-address",
                                        ),
                                    ],
                                ),
                                (
                                    names: [
