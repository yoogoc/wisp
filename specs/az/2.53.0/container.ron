(
    version: 1,
    command: "container",
    description: Some("Manage Azure Container Instances"),
    subcommands: [
        (
            name: "app",
            description: Some("Commands to Manage Azure Container Instances App"),
            subcommands: [
                (
                    name: "up",
                    description: Some("Deploy to Azure Container Instances using GitHub Actions"),
                    options: [
                        (
                            names: [
                                "--acr",
                            ],
                            description: Some("Name of the Azure Container Registry to be used for pushing the image"),
                            arguments: [
                                (
                                    name: "acr",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--branch-name",
                            ],
                            description: Some("New branch name to be created to check in files and raise a PR"),
                            arguments: [
                                (
                                    name: "branch-name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--do-not-wait",
                            ],
                            description: Some("Do not wait for workflow completion"),
                        ),
                        (
                            names: [
                                "--port",
                            ],
                            description: Some("Port on which your application runs. Default is 8080"),
                            arguments: [
                                (
                                    name: "port",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--repository",
                            ],
                            description: Some("GitHub Repository URL e.g. https://github.com/contoso/webapp"),
                            arguments: [
                                (
                                    name: "repository",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "attach",
            description: Some("Attach local standard output and error streams to a container in a container group. This command provides diagnostic information during container startup. Once the container has started, it streams STDOUT and STDERR to your local console"),
            options: [
                (
                    names: [
                        "--container-name",
                    ],
                    description: Some("The container to attach to. If omitted, the first container in the container group will be chosen"),
                    arguments: [
                        (
                            name: "container-name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--ids",
                    ],
                    description: Some("One or more resource IDs (space-delimited). It should be a complete resource ID containing all information of 'Resource Id' arguments. You should provide either --ids or other 'Resource Id' arguments"),
                    arguments: [
                        (
                            name: "ids",
                        ),
                    ],
                ),
                (
                    names: [
                        "--name",
                        "-n",
                    ],
                    description: Some("The name of the container group"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                ),
                (
                    names: [
                        "--subscription",
                    ],
                    description: Some("Name or ID of subscription. You can configure the default subscription using az account set -s NAME_OR_ID"),
                    arguments: [
                        (
                            name: "subscription",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "create",
            description: Some("Create a container group"),
            options: [
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--acr-identity",
                    ],
                    description: Some("The identity with access to the container registry"),
                    arguments: [
                        (
                            name: "acr-identity",
                        ),
                    ],
                ),
                (
                    names: [
                        "--add-capabilities",
                    ],
                    description: Some("A List of security context capabilities to be added"),
                    arguments: [
                        (
                            name: "add-capabilities",
                        ),
                    ],
                ),
                (
                    names: [
                        "--allow-escalation",
                    ],
                    description: Some("Allow whether a process can gain more privileges than its parent process"),
                ),
                (
                    names: [
                        "--assign-identity",
                    ],
                    description: Some("Space-separated list of assigned identities. Assigned identities are either user assigned identities (resource IDs) and / or the system assigned identity ('[system]'). See examples for more info"),
                    arguments: [
                        (
                            name: "assign-identity",
                        ),
                    ],
                ),
                (
                    names: [
                        "--azure-file-volume-account-key",
                    ],
                    description: Some("The storage account access key used to access the Azure File share"),
                    arguments: [
                        (
                            name: "azure-file-volume-account-key",
                        ),
                    ],
                ),
                (
                    names: [
                        "--azure-file-volume-account-name",
                    ],
                    description: Some("The name of the storage account that contains the Azure File share"),
