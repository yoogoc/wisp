                    arguments: [
                        (
                            name: "azure-file-volume-share-name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--cce-policy",
                    ],
                    description: Some("The CCE policy for the confidential container group"),
                    arguments: [
                        (
                            name: "cce-policy",
                        ),
                    ],
                ),
                (
                    names: [
                        "--command-line",
                    ],
                    description: Some("The command line to run when the container is started, e.g. '/bin/bash -c myscript.sh'"),
                    arguments: [
                        (
                            name: "command-line",
                        ),
                    ],
                ),
                (
                    names: [
                        "--cpu",
                    ],
                    description: Some("The required number of CPU cores of the containers, accurate to one decimal place"),
