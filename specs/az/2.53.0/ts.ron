(
    version: 1,
    command: "ts",
    description: Some("Manage template specs at subscription or resource group scope"),
    subcommands: [
        (
            name: "create",
            description: Some("Create a template spec and or template spec version"),
            options: [
                (
                    names: [
                        "--name",
                        "-n",
                    ],
                    description: Some("The name of the template spec"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--description",
                    ],
                    description: Some("The description of the parent template spec"),
                    arguments: [
                        (
                            name: "description",
                        ),
                    ],
                ),
                (
                    names: [
                        "--display-name",
                        "-d",
                    ],
                    description: Some("The display name of the template spec"),
                    arguments: [
                        (
                            name: "display-name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--location",
                        "-l",
                    ],
                    description: Some("The location to store the template-spec and template-spec version(s). Cannot be changed after creation"),
                    arguments: [
                        (
                            name: "location",
                        ),
                    ],
                ),
                (
                    names: [
                        "--tags",
                    ],
                    description: Some("Space-separated tags: key[=value] [key[=value] ...]. Use \"\" to clear existing tags"),
                    arguments: [
                        (
                            name: "tags",
                        ),
                    ],
                ),
                (
                    names: [
                        "--template-file",
                        "-f",
                    ],
                    description: Some("A path to a template file or Bicep file in the file system"),
                    arguments: [
                        (
                            name: "template-file",
                        ),
                    ],
                ),
                (
                    names: [
                        "--ui-form-definition",
                    ],
                    description: Some("The uiFormDefinition file path in the file system for the template spec version"),
                    arguments: [
                        (
                            name: "ui-form-definition",
                        ),
                    ],
                ),
                (
                    names: [
                        "--version",
                        "-v",
                    ],
                    description: Some("The template spec version"),
                    arguments: [
                        (
                            name: "version",
                        ),
                    ],
                ),
                (
                    names: [
                        "--version-description",
                    ],
                    description: Some("The description of the template spec version"),
                    arguments: [
                        (
                            name: "version-description",
                        ),
                    ],
                ),
                (
                    names: [
                        "--yes",
                        "-y",
                    ],
                    description: Some("Do not prompt for confirmation"),
                ),
            ],
        ),
        (
            name: "delete",
            description: Some("Delete a specified template spec or template spec version by name or resource ID"),
