(
    version: 1,
    command: "ssh",
    description: Some("SSH into resources (Azure VMs, Arc servers, etc) using AAD issued openssh certificates.\n\n\t\tSSH into Arc-enabled servers without requiring a public IP address or SSH into Azure Virtual Machines. AAD issued openssh certificates for authentication currently only supported for Linux"),
    subcommands: [
        (
            name: "arc",
            description: Some("SSH into Azure Arc Servers"),
            options: [
                (
                    names: [
                        "--certificate-file",
                        "-c",
                    ],
                    description: Some("Path to certificate file"),
                    arguments: [
                        (
                            name: "certificate-file",
                        ),
                    ],
                ),
                (
                    names: [
                        "--local-user",
                    ],
                    description: Some("The username for a local user"),
                    arguments: [
                        (
                            name: "local-user",
                        ),
                    ],
                ),
                (
                    names: [
                        "--vm-name",
                        "--name",
                        "-n",
                    ],
                    description: Some("The name of the Arc Server"),
                    arguments: [
                        (
                            name: "vm-name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--port",
                    ],
                    description: Some("Port to connect to on the remote host"),
                    arguments: [
                        (
                            name: "port",
                        ),
                    ],
                ),
                (
                    names: [
                        "--private-key-file",
                        "-i",
                    ],
                    description: Some("The RSA private key file path"),
                    arguments: [
                        (
                            name: "private-key-file",
                        ),
                    ],
                ),
                (
                    names: [
                        "--public-key-file",
                        "-p",
                    ],
                    description: Some("The RSA public key file path"),
                    arguments: [
                        (
                            name: "public-key-file",
                        ),
                    ],
                ),
                (
                    names: [
                        "--winrdp",
                        "--rdp",
                    ],
                    description: Some("Start RDP connection over SSH"),
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                ),
                (
                    names: [
                        "--resource-type",
                    ],
                    description: Some("Resource type should be either Microsoft.HybridCompute/machines or Microsoft.ConnectedVMwareSphere/virtualMachines"),
                    arguments: [
                        (
                            name: "resource-type",
                        ),
                    ],
                ),
                (
                    names: [
                        "--ssh-client-folder",
                    ],
                    description: Some("Folder path that contains ssh executables (ssh.exe, ssh-keygen.exe, etc). Default to ssh pre-installed if not provided"),
                    arguments: [
                        (
                            name: "ssh-client-folder",
                        ),
                    ],
                ),
                (
                    names: [
                        "--ssh-proxy-folder",
                    ],
                    description: Some("Path to the folder where the ssh proxy should be saved. Default to .clientsshproxy folder in user's home directory if not provided"),
                    arguments: [
                        (
                            name: "ssh-proxy-folder",
                        ),
                    ],
                ),
                (
                    names: [
                        "--yes-without-prompt",
                        "--yes",
                        "-y",
                    ],
                    description: Some("Update service configuration without prompting user"),
                ),
            ],
            arguments: [
                (
                    name: "<SSH_ARGS>",
                    description: Some("Additional arguments passed to OpenSSH"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "cert",
            description: Some("Create an SSH RSA certificate signed by AAD"),
            options: [
                (
                    names: [
                        "--file",
                        "-f",
                    ],
                    description: Some("The file path to write the SSH cert to, defaults to public key path with -aadcert.pub appened"),
                    arguments: [
                        (
                            name: "file",
                        ),
                    ],
                ),
                (
                    names: [
                        "--public-key-file",
                        "-p",
                    ],
                    description: Some("The RSA public key file path. If not provided, generated key pair is stored in the same directory as --file"),
                    arguments: [
                        (
                            name: "public-key-file",
                        ),
                    ],
                ),
                (
                    names: [
                        "--ssh-client-folder",
                    ],
                    description: Some("Folder path that contains ssh executables (ssh.exe, ssh-keygen.exe, etc). Default to ssh pre-installed if not provided"),
                    arguments: [
                        (
                            name: "ssh-client-folder",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "config",
            description: Some("Create an SSH config for resources (Azure VMs, Arc Servers, etc) which can then be used by clients that support OpenSSH configs and certificates"),
            options: [
                (
                    names: [
                        "--file",
                        "-f",
                    ],
                    description: Some("The file path to write the SSH config to"),
                    arguments: [
                        (
                            name: "file",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--certificate-file",
                        "-c",
                    ],
                    description: Some("Path to certificate file"),
                    arguments: [
                        (
                            name: "certificate-file",
                        ),
                    ],
                ),
                (
                    names: [
                        "--ip",
                    ],
                    description: Some("The public IP address (or hostname) of the VM"),
                    arguments: [
                        (
                            name: "ip",
                        ),
                    ],
                ),
                (
                    names: [
                        "--keys-destination-folder",
                        "--keys-dest-folder",
                    ],
                    description: Some("Folder where new generated keys will be stored"),
                    arguments: [
                        (
                            name: "keys-destination-folder",
                        ),
                    ],
                ),
                (
                    names: [
                        "--local-user",
                    ],
                    description: Some("The username for a local user"),
                    arguments: [
                        (
                            name: "local-user",
                        ),
                    ],
                ),
                (
                    names: [
                        "--vm-name",
                        "--name",
                        "-n",
                    ],
                    description: Some("The name of the VM"),
                    arguments: [
                        (
                            name: "vm-name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--overwrite",
                    ],
                    description: Some("Overwrites the config file if this flag is set"),
                ),
                (
                    names: [
                        "--port",
                    ],
                    description: Some("SSH Port"),
                    arguments: [
                        (
                            name: "port",
                        ),
                    ],
                ),
                (
                    names: [
                        "--prefer-private-ip",
                    ],
                    description: Some("Will use a private IP if available. By default only public IPs are used"),
                ),
                (
                    names: [
                        "--private-key-file",
                        "-i",
                    ],
                    description: Some("The RSA private key file path"),
                    arguments: [
                        (
                            name: "private-key-file",
                        ),
                    ],
                ),
                (
                    names: [
                        "--public-key-file",
                        "-p",
                    ],
                    description: Some("The RSA public key file path"),
                    arguments: [
                        (
                            name: "public-key-file",
                        ),
                    ],
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                ),
                (
                    names: [
                        "--resource-type",
                    ],
                    description: Some("Resource type should be either Microsoft.Compute/virtualMachines, Microsoft.HybridCompute/machines, or Microsoft.ConnectedVMwareSphere/virtualMachines"),
                    arguments: [
                        (
                            name: "resource-type",
                        ),
                    ],
                ),
                (
                    names: [
                        "--ssh-client-folder",
                    ],
                    description: Some("Folder path that contains ssh executables (ssh.exe, ssh-keygen.exe, etc). Default to ssh pre-installed if not provided"),
                    arguments: [
                        (
                            name: "ssh-client-folder",
                        ),
                    ],
                ),
                (
                    names: [
                        "--ssh-proxy-folder",
                    ],
                    description: Some("Path to the folder where the ssh proxy should be saved. Default to .clientsshproxy folder in user's home directory if not provided"),
                    arguments: [
                        (
                            name: "ssh-proxy-folder",
                        ),
                    ],
                ),
                (
                    names: [
                        "--yes-without-prompt",
                        "--yes",
                        "-y",
                    ],
                    description: Some("Update service configuration without prompting user"),
                ),
            ],
        ),
        (
            name: "vm",
            description: Some("SSH into Azure VMs or Arc Servers"),
            options: [
                (
                    names: [
                        "--certificate-file",
                        "-c",
                    ],
                    description: Some("Path to a certificate file used for authentication when using local user credentials"),
                    arguments: [
                        (
                            name: "certificate-file",
                        ),
                    ],
                ),
                (
                    names: [
                        "--hostname",
                        "--ip",
                    ],
                    description: Some("The public (or reachable private) IP address (or hostname) of the VM"),
                    arguments: [
                        (
                            name: "hostname",
                        ),
                    ],
                ),
                (
                    names: [
                        "--local-user",
                    ],
                    description: Some("The username for a local user"),
                    arguments: [
                        (
                            name: "local-user",
                        ),
                    ],
                ),
                (
                    names: [
                        "--vm-name",
                        "--name",
                        "-n",
                    ],
                    description: Some("The name of the VM"),
                    arguments: [
                        (
                            name: "vm-name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--port",
                    ],
                    description: Some("SSH port"),
                    arguments: [
                        (
                            name: "port",
                        ),
                    ],
                ),
                (
                    names: [
                        "--prefer-private-ip",
                    ],
                    description: Some("Will prefer private IP. Requires connectivity to the private IP"),
                ),
                (
                    names: [
                        "--private-key-file",
                        "-i",
                    ],
                    description: Some("The RSA private key file path"),
                    arguments: [
                        (
                            name: "private-key-file",
                        ),
                    ],
                ),
                (
                    names: [
                        "--public-key-file",
                        "-p",
                    ],
                    description: Some("The RSA public key file path"),
                    arguments: [
                        (
                            name: "public-key-file",
                        ),
                    ],
                ),
                (
                    names: [
                        "--winrdp",
                        "--rdp",
                    ],
                    description: Some("Start RDP connection over SSH"),
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                ),
                (
                    names: [
                        "--resource-type",
                    ],
                    description: Some("Resource type should be either Microsoft.Compute/virtualMachines, Microsoft.HybridCompute/machines, or Microsoft.ConnectedVMwareSphere/virtualMachines"),
                    arguments: [
                        (
                            name: "resource-type",
                        ),
                    ],
                ),
                (
                    names: [
                        "--ssh-client-folder",
                    ],
                    description: Some("Folder path that contains ssh executables (ssh.exe, ssh-keygen.exe, etc). Default to ssh pre-installed if not provided"),
                    arguments: [
                        (
                            name: "ssh-client-folder",
                        ),
                    ],
                ),
                (
                    names: [
                        "--ssh-proxy-folder",
                    ],
                    description: Some("Path to the folder where the ssh proxy should be saved. Default to .clientsshproxy folder in user's home directory if not provided"),
                    arguments: [
                        (
                            name: "ssh-proxy-folder",
                        ),
                    ],
                ),
                (
                    names: [
                        "--yes-without-prompt",
                        "--yes",
                        "-y",
                    ],
                    description: Some("Update service configuration without prompting user"),
                ),
            ],
            arguments: [
                (
                    name: "<SSH_ARGS>",
                    description: Some("Additional arguments passed to OpenSSH"),
                    optional: true,
                ),
            ],
        ),
    ],
)
