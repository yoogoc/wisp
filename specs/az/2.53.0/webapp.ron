(
    version: 1,
    command: "webapp",
    description: Some("Manage web apps"),
    subcommands: [
        (
            name: "auth",
            description: Some("Manage webapp authentication and authorization. To use v2 auth commands, run \"az extension add --name authV2\" to add the authV2 CLI extension"),
            subcommands: [
                (
                    name: "set",
                    description: Some("Sets the authentication settings for the webapp in the v2 format, overwriting any existing settings"),
                    options: [
                        (
                            names: [
                                "--body",
                                "-b",
                            ],
                            description: Some("JSON representation of the configuration settings for the Azure App Service Authentication / Authorization V2 feature"),
                            arguments: [
                                (
                                    name: "body",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--ids",
                            ],
                            description: Some("One or more resource IDs (space-delimited). It should be a complete resource ID containing all information of 'Resource Id' arguments. You should provide either --ids or other 'Resource Id' arguments"),
                            arguments: [
                                (
                                    name: "ids",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("Name of the web app"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--resource-group",
                                "-g",
                            ],
                            description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                            arguments: [
                                (
                                    name: "resource-group",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--slot",
                                "-s",
                            ],
                            description: Some("The name of the slot. Default to the productions slot if not specified"),
                            arguments: [
                                (
                                    name: "slot",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--subscription",
                            ],
                            description: Some("Name or ID of subscription. You can configure the default subscription using az account set -s NAME_OR_ID"),
                            arguments: [
                                (
                                    name: "subscription",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "show",
                    description: Some("Show the authentification settings for the webapp"),
                    options: [
                        (
                            names: [
                                "--ids",
                            ],
                            description: Some("One or more resource IDs (space-delimited). It should be a complete resource ID containing all information of 'Resource Id' arguments. You should provide either --ids or other 'Resource Id' arguments"),
                            arguments: [
                                (
                                    name: "ids",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("Name of the web app. If left unspecified, a name will be randomly generated. You can configure the default using az configure --defaults web=<name>"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                        ),
                        (
                            names: [
