(
    version: 1,
    command: "arcdata",
    description: Some("Commands for using Azure Arc-enabled data services"),
    subcommands: [
        (
            name: "ad-connector",
            description: Some("Manage Active Directory authentication for Azure Arc data services"),
            subcommands: [
                (
                    name: "create",
                    description: Some("Create a new Active Directory connector"),
                    options: [
                        (
                            names: [
                                "--account-provisioning",
                            ],
                            description: Some("Value indicating whether service account provisioning for data services should be automatic or manual. Allowed values are: 'manual' or 'automatic'"),
                            arguments: [
                                (
                                    name: "account-provisioning",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("The name of the Active Directory connector"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--nameserver-addresses",
                            ],
                            description: Some("List of Active Directory DNS server IP addresses separated by ',' (e.g. 10.10.10.11,10.10.10.12,10.10.10.13)"),
                            arguments: [
                                (
                                    name: "nameserver-addresses",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--realm",
                            ],
                            description: Some("The name of the Active Directory domain in uppercase (e.g CONTOSO.LOCAL)"),
                            arguments: [
                                (
                                    name: "realm",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--data-controller-name",
                            ],
                            description: Some("The name of the Arc data controller associated with this Active Directory connector"),
                            arguments: [
                                (
                                    name: "data-controller-name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--dns-domain-name",
                            ],
                            description: Some("The DNS domain name (e.g. contoso.com)"),
                            arguments: [
                                (
                                    name: "dns-domain-name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--dns-replicas",
                            ],
                            description: Some("The number of copies for DNS proxy service"),
                            arguments: [
                                (
                                    name: "dns-replicas",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--domain-service-account-secret",
                            ],
                            description: Some("The name of the Kubernetes secret containing the credentials for the pre-created Active Directory account with permissions to create and manage accounts in the given OU. Alternatively, setting the 'DOMAIN_SERVICE_ACCOUNT_USERNAME' and 'DOMAIN_SERVICE_ACCOUNT_PASSWORD' env variables will create this secret automatically"),
                            arguments: [
                                (
                                    name: "domain-service-account-secret",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--k8s-namespace",
                                "-k",
                            ],
                            description: Some("The Kubernetes namespace to deploy the Active Directory connector"),
                            arguments: [
                                (
                                    name: "k8s-namespace",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--netbios-domain-name",
                            ],
                            description: Some("The NETBIOS name of the Active Directory domain (e.g. CONTOSO)"),
                            arguments: [
                                (
                                    name: "netbios-domain-name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--no-wait",
                            ],
                            description: Some("Do not wait for the long-running operation to finish"),
                        ),
                        (
                            names: [
                                "--ou-distinguished-name",
                            ],
                            description: Some("The distinguished name of the pre-created Organizational Unit (OU) in the Active Directory domain. (e.g. OU=arcou,DC=contoso,DC=com)"),
                            arguments: [
                                (
                                    name: "ou-distinguished-name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--prefer-k8s-dns",
                            ],
                            description: Some("Use Kubernetes DNS Server responses over the Active Directory DNS server responses for IP address lookup. Allowed values are 'true' or 'false'"),
                            arguments: [
                                (
                                    name: "prefer-k8s-dns",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--primary-ad-dc-hostname",
                            ],
                            description: Some("The hostname of the primary AD domain controller"),
                            arguments: [
                                (
                                    name: "primary-ad-dc-hostname",
