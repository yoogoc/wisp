                    description: Some("The template gallery endpoint"),
                    arguments: [
                        (
                            name: "endpoint-gallery",
                        ),
                    ],
                ),
                (
                    names: [
                        "--endpoint-management",
                    ],
                    description: Some("The management service endpoint"),
                    arguments: [
                        (
                            name: "endpoint-management",
