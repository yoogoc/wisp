                    ],
                    description: Some("The resource management endpoint"),
                    arguments: [
                        (
                            name: "endpoint-resource-manager",
                        ),
                    ],
                ),
                (
                    names: [
                        "--endpoint-sql-management",
                    ],
                    description: Some("The sql server management endpoint"),
                    arguments: [
                        (
                            name: "endpoint-sql-management",
                        ),
                    ],
                ),
                (
                    names: [
                        "--endpoint-vm-image-alias-doc",
                    ],
                    description: Some("The uri of the document which caches commonly used virtual machine images"),
                    arguments: [
                        (
                            name: "endpoint-vm-image-alias-doc",
                        ),
                    ],
                ),
                (
                    names: [
                        "--name",
                        "-n",
                    ],
                    description: Some("Name of a registered cloud"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--profile",
                    ],
                    description: Some("Profile to use for this cloud"),
                    arguments: [
                        (
                            name: "profile",
                            suggestions: [
                                (
                                    name: "2017-03-09-profile",
                                ),
