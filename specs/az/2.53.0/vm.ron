                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                ),
                (
                    names: [
                        "--subscription",
                    ],
                    description: Some("Name or ID of subscription. You can configure the default subscription using az account set -s NAME_OR_ID"),
                    arguments: [
                        (
                            name: "subscription",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "create",
            description: Some("Create an Azure Virtual Machine"),
            options: [
                (
                    names: [
                        "--name",
                        "-n",
                    ],
                    description: Some("Name of the virtual machine"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--accelerated-networking",
                    ],
                    description: Some("Enable accelerated networking. Unless specified, CLI will enable it based on machine image and size"),
                    arguments: [
                        (
                            name: "accelerated-networking",
                            suggestions: [
                                (
                                    name: "false",
                                ),
                                (
                                    name: "true",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--accept-term",
                    ],
                    description: Some("Accept the license agreement and privacy statement"),
                    arguments: [
                        (
                            name: "accept-term",
                        ),
                    ],
                ),
                (
                    names: [
                        "--admin-password",
                    ],
                    description: Some("Password for the VM if authentication type is 'Password'"),
                    arguments: [
                        (
                            name: "admin-password",
                        ),
                    ],
                ),
                (
                    names: [
                        "--admin-username",
                    ],
                    description: Some("Username for the VM. Default value is current username of OS. If the default value is system reserved, then default value will be set to azureuser. Please refer to https://docs.microsoft.com/rest/api/compute/virtualmachines/createorupdate#osprofile to get a full list of reserved values"),
                    arguments: [
                        (
                            name: "admin-username",
                        ),
                    ],
                ),
                (
                    names: [
                        "--asgs",
                    ],
                    description: Some("Space-separated list of existing application security groups to associate with the VM"),
                    arguments: [
                        (
                            name: "asgs",
                        ),
                    ],
                ),
                (
                    names: [
                        "--assign-identity",
                    ],
                    description: Some("Accept system or user assigned identities separated by spaces. Use '[system]' to refer system assigned identity, or a resource id to refer user assigned identity. Check out help for more examples"),
                    arguments: [
                        (
                            name: "assign-identity",
                        ),
                    ],
                ),
                (
                    names: [
                        "--attach-data-disks",
                    ],
                    description: Some("Attach existing data disks to the VM. Can use the name or ID of a managed disk or the URI to an unmanaged disk VHD"),
                    arguments: [
                        (
                            name: "attach-data-disks",
                        ),
                    ],
                ),
                (
                    names: [
                        "--attach-os-disk",
                    ],
                    description: Some("Attach an existing OS disk to the VM. Can use the name or ID of a managed disk or the URI to an unmanaged disk VHD"),
                    arguments: [
                        (
                            name: "attach-os-disk",
                        ),
                    ],
                ),
                (
                    names: [
                        "--authentication-type",
                    ],
                    description: Some("Type of authentication to use with the VM. Defaults to password for Windows and SSH public key for Linux. \"all\" enables both ssh and password authentication"),
                    arguments: [
                        (
                            name: "authentication-type",
                            suggestions: [
                                (
                                    name: "all",
                                ),
                                (
                                    name: "password",
                                ),
                                (
                                    name: "ssh",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--availability-set",
                    ],
                    description: Some("Name or ID of an existing availability set to add the VM to. None by default"),
                    arguments: [
                        (
                            name: "availability-set",
                        ),
                    ],
                ),
                (
                    names: [
                        "--boot-diagnostics-storage",
                    ],
                    description: Some("Pre-existing storage account name or its blob uri to capture boot diagnostics. Its sku should be one of Standard_GRS, Standard_LRS and Standard_RAGRS"),
                    arguments: [
                        (
                            name: "boot-diagnostics-storage",
                        ),
                    ],
                ),
                (
                    names: [
                        "--capacity-reservation-group",
                        "--crg",
                    ],
                    description: Some("The ID or name of the capacity reservation group that is used to allocate. Pass in \"None\" to disassociate the capacity reservation group. Please note that if you want to delete a VM/VMSS that has been associated with capacity reservation group, you need to disassociate the capacity reservation group first"),
                    arguments: [
                        (
                            name: "capacity-reservation-group",
                        ),
                    ],
                ),
                (
                    names: [
                        "--computer-name",
                    ],
                    description: Some("The host OS name of the virtual machine. Defaults to the name of the VM"),
                    arguments: [
                        (
                            name: "computer-name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--count",
                    ],
                    description: Some("Number of virtual machines to create. Value range is [2, 250], inclusive. Don't specify this parameter if you want to create a normal single VM. The VMs are created in parallel. The output of this command is an array of VMs instead of one single VM. Each VM has its own public IP, NIC. VNET and NSG are shared. It is recommended that no existing public IP, NIC, VNET and NSG are in resource group. When --count is specified, --attach-data-disks, --attach-os-disk, --boot-diagnostics-storage, --computer-name, --host, --host-group, --nics, --os-disk-name, --private-ip-address, --public-ip-address, --public-ip-address-dns-name, --storage-account, --storage-container-name, --subnet, --use-unmanaged-disk, --vnet-name are not allowed"),
                    arguments: [
                        (
                            name: "count",
                        ),
                    ],
                ),
                (
                    names: [
                        "--custom-data",
                    ],
                    description: Some("Custom init script file or text (cloud-init, cloud-config, etc..)"),
                    arguments: [
                        (
                            name: "custom-data",
                        ),
                    ],
                ),
                (
                    names: [
                        "--data-disk-caching",
                    ],
                    description: Some("Storage caching type for data disk(s), including 'None', 'ReadOnly', 'ReadWrite', etc. Use a singular value to apply on all disks, or use <lun>=<vaule1> <lun>=<value2> to configure individual disk"),
                    arguments: [
                        (
                            name: "data-disk-caching",
                        ),
                    ],
                ),
                (
                    names: [
                        "--data-disk-delete-option",
                    ],
                    description: Some("Specify whether data disk should be deleted or detached upon VM deletion. If a single data disk is attached, the allowed values are Delete and Detach. For multiple data disks are attached, please use \"<data_disk>=Delete <data_disk2>=Detach\" to configure each disk"),
                    arguments: [
                        (
                            name: "data-disk-delete-option",
                        ),
                    ],
                ),
                (
                    names: [
                        "--data-disk-encryption-sets",
                    ],
                    description: Some("Names or IDs (space delimited) of disk encryption sets for data disks"),
                    arguments: [
                        (
                            name: "data-disk-encryption-sets",
                        ),
                    ],
                ),
                (
                    names: [
                        "--data-disk-sizes-gb",
                    ],
                    description: Some("Space-separated empty managed data disk sizes in GB to create"),
                    arguments: [
                        (
                            name: "data-disk-sizes-gb",
                        ),
                    ],
                ),
