                                ),
                                (
                                    name: "t",
                                ),
                                (
                                    name: "true",
                                ),
                                (
                                    name: "y",
                                ),
                                (
                                    name: "yes",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
