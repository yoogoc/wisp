(
    version: 1,
    command: "vm",
    description: Some("Manage Linux or Windows virtual machines"),
    subcommands: [
        (
            name: "aem",
            description: Some("Manage Azure Enhanced Monitoring Extension for SAP"),
            subcommands: [
                (
                    name: "delete",
                    description: Some("Remove Azure Enhanced Monitoring Extension"),
                    options: [
                        (
                            names: [
                                "--ids",
                            ],
                            description: Some("One or more resource IDs (space-delimited). It should be a complete resource ID containing all information of 'Resource Id' arguments. You should provide either --ids or other 'Resource Id' arguments"),
                            arguments: [
                                (
                                    name: "ids",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("The name of the Virtual Machine. You can configure the default using az configure --defaults vm=<name>"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--resource-group",
                                "-g",
                            ],
                            description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                            arguments: [
                                (
                                    name: "resource-group",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--subscription",
                            ],
                            description: Some("Name or ID of subscription. You can configure the default subscription using az account set -s NAME_OR_ID"),
                            arguments: [
                                (
                                    name: "subscription",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "set",
                    description: Some("Configure Azure Enhanced Monitoring Extension"),
                    options: [
                        (
                            names: [
                                "--debug-extension",
                            ],
                            description: Some("Enable debug mode on the VM Extension for SAP"),
                        ),
                        (
                            names: [
                                "--ids",
                            ],
                            description: Some("One or more resource IDs (space-delimited). It should be a complete resource ID containing all information of 'Resource Id' arguments. You should provide either --ids or other 'Resource Id' arguments"),
                            arguments: [
                                (
                                    name: "ids",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--install-new-extension",
                                "-i",
                            ],
                            description: Some("Install the new VM Extension for SAP"),
                        ),
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("The name of the Virtual Machine. You can configure the default using az configure --defaults vm=<name>"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--proxy-uri",
                                "-p",
                            ],
                            description: Some("Set the proxy URI that should be used to access external resources e.g. the Azure API. Example: http://proxyhost:8080"),
                            arguments: [
                                (
                                    name: "proxy-uri",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--resource-group",
                                "-g",
                            ],
                            description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                            arguments: [
                                (
                                    name: "resource-group",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--set-access-to-individual-resources",
                                "-s",
                            ],
                            description: Some("Set the access of the VM identity to the individual resources, e.g. data disks instead of the complete resource group"),
                        ),
                        (
                            names: [
                                "--skip-storage-analytics",
                            ],
                            description: Some("Skip enabling analytics on storage accounts"),
                        ),
                        (
                            names: [
                                "--subscription",
                            ],
                            description: Some("Name or ID of subscription. You can configure the default subscription using az account set -s NAME_OR_ID"),
                            arguments: [
                                (
                                    name: "subscription",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "verify",
                    description: Some("Verify Azure Enhanced Monitoring Extensions configured correctly"),
                    options: [
                        (
                            names: [
                                "--ids",
                            ],
                            description: Some("One or more resource IDs (space-delimited). It should be a complete resource ID containing all information of 'Resource Id' arguments. You should provide either --ids or other 'Resource Id' arguments"),
                            arguments: [
                                (
                                    name: "ids",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("The name of the Virtual Machine. You can configure the default using az configure --defaults vm=<name>"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--resource-group",
                                "-g",
                            ],
                            description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                            arguments: [
                                (
                                    name: "resource-group",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--skip-storage-check",
                            ],
                            description: Some("Disables the test for table content"),
                        ),
                        (
                            names: [
                                "--subscription",
                            ],
                            description: Some("Name or ID of subscription. You can configure the default subscription using az account set -s NAME_OR_ID"),
                            arguments: [
                                (
                                    name: "subscription",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--wait-time-in-minutes",
                            ],
                            description: Some("Maximum minutes to wait for the storage metrics to be available"),
                            arguments: [
                                (
                                    name: "wait-time-in-minutes",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "application",
            description: Some("Manage applications for VM"),
            subcommands: [
                (
                    name: "list",
                    description: Some("List applications for VM"),
                    options: [
                        (
                            names: [
                                "--vm-name",
                                "--name",
                                "-n",
                            ],
                            description: Some("The name of the Virtual Machine. You can configure the default using az configure --defaults vm=<name>"),
                            arguments: [
                                (
                                    name: "vm-name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--resource-group",
                                "-g",
                            ],
                            description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                            arguments: [
                                (
                                    name: "resource-group",
                                ),
                            ],
                            required: true,
                        ),
                    ],
                ),
                (
                    name: "set",
                    description: Some("Set applications for VM"),
                    options: [
                        (
                            names: [
                                "--app-version-ids",
                            ],
                            description: Some("Space-separated application version ids to set to VM"),
                            arguments: [
                                (
                                    name: "app-version-ids",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--app-config-overrides",
                            ],
                            description: Some("Space-separated application configuration overrides for each application version ids. It should have the same number of items as the application version ids. Null is available for a application which does not have a configuration override"),
                            arguments: [
                                (
                                    name: "app-config-overrides",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--ids",
                            ],
                            description: Some("One or more resource IDs (space-delimited). It should be a complete resource ID containing all information of 'Resource Id' arguments. You should provide either --ids or other 'Resource Id' arguments"),
                            arguments: [
                                (
                                    name: "ids",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("The name of the Virtual Machine. You can configure the default using az configure --defaults vm=<name>"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--order-applications",
                            ],
                            description: Some("Whether to set order index at each gallery application. If specified, the first app version id gets specified an order = 1, then the next one 2, and so on. This parameter is meant to be used when the VMApplications specified by app version ids must be installed in a particular order; the lowest order is installed first"),
                        ),
                        (
                            names: [
                                "--resource-group",
                                "-g",
                            ],
                            description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                            arguments: [
                                (
                                    name: "resource-group",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--subscription",
                            ],
                            description: Some("Name or ID of subscription. You can configure the default subscription using az account set -s NAME_OR_ID"),
                            arguments: [
                                (
                                    name: "subscription",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--treat-deployment-as-failure",
                            ],
                            description: Some("Space-separated list of true or false corresponding to the application version ids. If set to true, failure to install or update gallery application version operation will fail this operation"),
                            arguments: [
                                (
                                    name: "treat-deployment-as-failure",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "assess-patches",
            description: Some("Assess patches on a VM"),
            options: [
                (
                    names: [
                        "--ids",
                    ],
                    description: Some("One or more resource IDs (space-delimited). It should be a complete resource ID containing all information of 'Resource Id' arguments. You should provide either --ids or other 'Resource Id' arguments"),
                    arguments: [
                        (
                            name: "ids",
                        ),
