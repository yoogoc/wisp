        (
            name: "auto-shutdown",
            description: Some("Manage auto-shutdown for VM"),
            options: [
                (
                    names: [
                        "--email",
                    ],
                    description: Some("The email recipient to send notifications to (can be a list of semi-colon separated email addresses)"),
                    arguments: [
                        (
                            name: "email",
                        ),
                    ],
                ),
                (
                    names: [
                        "--ids",
                    ],
                    description: Some("One or more resource IDs (space-delimited). It should be a complete resource ID containing all information of 'Resource Id' arguments. You should provide either --ids or other 'Resource Id' arguments"),
                    arguments: [
                        (
                            name: "ids",
                        ),
                    ],
                ),
                (
                    names: [
                        "--location",
                        "-l",
                    ],
                    description: Some("Location. Values from: az account list-locations. You can configure the default location using az configure --defaults location=<location>"),
                    arguments: [
                        (
                            name: "location",
                        ),
                    ],
                ),
                (
                    names: [
                        "--name",
                        "-n",
                    ],
                    description: Some("The name of the Virtual Machine. You can configure the default using az configure --defaults vm=<name>"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--off",
                    ],
                    description: Some("Turn off auto-shutdown for VM. Configuration will be cleared"),
                    arguments: [
                        (
                            name: "off",
                        ),
                    ],
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                ),
                (
                    names: [
                        "--subscription",
                    ],
                    description: Some("Name or ID of subscription. You can configure the default subscription using az account set -s NAME_OR_ID"),
                    arguments: [
                        (
                            name: "subscription",
                        ),
                    ],
                ),
                (
                    names: [
                        "--time",
                    ],
                    description: Some("The UTC time of day the schedule will occur every day. Format: hhmm. Example: 1730"),
                    arguments: [
                        (
                            name: "time",
                        ),
                    ],
                ),
                (
                    names: [
                        "--webhook",
                    ],
                    description: Some("The webhook URL to which the notification will be sent"),
                    arguments: [
                        (
                            name: "webhook",
                        ),
                    ],
                ),
