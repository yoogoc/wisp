                        (
                            name: "vm-name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-wait",
                    ],
                    description: Some("Do not wait for the long-running operation to finish"),
                    arguments: [
                        (
                            name: "no-wait",
                            suggestions: [
