(
    version: 1,
    command: "bicep",
    description: Some("Bicep CLI command group.\n\n\t\tBicep CLI command group. There are two configurations that can be set for the command group, including bicep.check_version and bicep.use_binary_from_path:\n[1] az config set bicep.check_version=True/False\nTurn on/off Bicep CLI version check when executing az bicep commands.\n[2] az config set bicep.use_binary_from_path=True/False/if_found_in_ci\nSpecify whether to use Bicep CLI from PATH or not. The default value is if_found_in_ci"),
    subcommands: [
        (
            name: "build",
            description: Some("Build a Bicep file"),
            options: [
                (
                    names: [
                        "--file",
                        "-f",
                    ],
                    description: Some("The path to the Bicep file to build in the file system"),
                    arguments: [
                        (
                            name: "file",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--no-restore",
                    ],
                    description: Some("When set, builds the bicep file without restoring external modules"),
                    arguments: [
                        (
                            name: "no-restore",
                        ),
                    ],
                ),
                (
                    names: [
                        "--outdir",
                    ],
                    description: Some("When set, saves the output at the specified directory"),
                    arguments: [
                        (
                            name: "outdir",
                        ),
                    ],
                ),
                (
                    names: [
                        "--outfile",
                    ],
                    description: Some("When set, saves the output as the specified file path"),
                    arguments: [
                        (
                            name: "outfile",
                        ),
                    ],
                ),
                (
                    names: [
                        "--stdout",
                    ],
                    description: Some("When set, prints all output to stdout instead of corresponding files"),
                    arguments: [
                        (
                            name: "stdout",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "build-params",
            description: Some("Build .bicepparam file"),
            options: [
                (
                    names: [
                        "--file",
                        "-f",
                    ],
                    description: Some("The path to the .bicepparam file to build in the file system"),
                    arguments: [
                        (
                            name: "file",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--no-restore",
                    ],
                    description: Some("When set, builds the .bicepparam file without restoring external modules"),
                    arguments: [
                        (
                            name: "no-restore",
                        ),
                    ],
                ),
                (
                    names: [
                        "--outdir",
                    ],
                    description: Some("When set, saves the output at the specified directory"),
                    arguments: [
                        (
                            name: "outdir",
                        ),
                    ],
                ),
                (
                    names: [
                        "--outfile",
                    ],
                    description: Some("When set, saves the output as the specified file path"),
                    arguments: [
                        (
                            name: "outfile",
                        ),
                    ],
                ),
                (
                    names: [
                        "--stdout",
                    ],
                    description: Some("When set, prints all output to stdout instead of corresponding files"),
                    arguments: [
                        (
                            name: "stdout",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "decompile",
            description: Some("Attempt to decompile an ARM template file to a Bicep file"),
            options: [
                (
                    names: [
                        "--file",
                        "-f",
                    ],
                    description: Some("The path to the ARM template to decompile in the file system"),
                    arguments: [
                        (
                            name: "file",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--force",
                    ],
                    description: Some("Allows overwriting the output file if it exists"),
                    arguments: [
                        (
                            name: "force",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "decompile-params",
            description: Some("Decompile a parameters .json file to .bicepparam"),
            options: [
                (
                    names: [
                        "--file",
                        "-f",
                    ],
                    description: Some("The path to the parameters file to build in the file system"),
                    arguments: [
                        (
                            name: "file",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--bicep-file",
                    ],
                    description: Some("Path to the bicep template file (relative to the .bicepparam file) that will be referenced in the using declaration"),
                    arguments: [
                        (
                            name: "bicep-file",
                        ),
                    ],
                ),
                (
                    names: [
                        "--outdir",
                    ],
                    description: Some("When set, saves the output at the specified directory"),
                    arguments: [
                        (
                            name: "outdir",
                        ),
                    ],
                ),
                (
                    names: [
                        "--outfile",
                    ],
                    description: Some("When set, saves the output as the specified file path"),
                    arguments: [
                        (
                            name: "outfile",
                        ),
                    ],
                ),
                (
                    names: [
                        "--stdout",
                    ],
                    description: Some("When set, prints all output to stdout instead of corresponding files"),
                    arguments: [
                        (
                            name: "stdout",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "format",
            description: Some("Format a Bicep file"),
            options: [
                (
                    names: [
                        "--file",
                        "-f",
                    ],
                    description: Some("The path to the Bicep file to format in the file system"),
                    arguments: [
                        (
                            name: "file",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--indent-kind",
                    ],
                    description: Some("Set indentation kind. Valid values are ( Space | Tab )"),
                    arguments: [
                        (
                            name: "indent-kind",
                        ),
                    ],
                ),
                (
                    names: [
                        "--indent-size",
                    ],
                    description: Some("Number of spaces to indent with (Only valid with --indent-kind set to Space)"),
                    arguments: [
                        (
                            name: "indent-size",
                        ),
                    ],
                ),
                (
                    names: [
                        "--insert-final-newline",
                    ],
                    description: Some("Insert a final newline"),
                    arguments: [
                        (
                            name: "insert-final-newline",
                        ),
                    ],
                ),
                (
                    names: [
                        "--newline",
                    ],
                    description: Some("Set newline char. Valid values are ( Auto | LF | CRLF | CR )"),
                    arguments: [
                        (
                            name: "newline",
                        ),
                    ],
                ),
                (
                    names: [
                        "--outdir",
                    ],
                    description: Some("When set, saves the output at the specified directory"),
                    arguments: [
                        (
                            name: "outdir",
                        ),
                    ],
                ),
                (
                    names: [
                        "--outfile",
                    ],
                    description: Some("When set, saves the output as the specified file path"),
                    arguments: [
                        (
                            name: "outfile",
                        ),
                    ],
                ),
                (
                    names: [
                        "--stdout",
                    ],
                    description: Some("When set, prints all output to stdout instead of corresponding files"),
                    arguments: [
                        (
                            name: "stdout",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "generate-params",
            description: Some("Generate parameters file for a Bicep file"),
            options: [
                (
                    names: [
                        "--file",
                        "-f",
                    ],
                    description: Some("The path to the Bicep file to generate the parameters file from in the file system"),
                    arguments: [
                        (
                            name: "file",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--include-params",
                    ],
                    description: Some("Set include params. Valid values are ( all | required-only )"),
                    arguments: [
                        (
                            name: "include-params",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-restore",
                    ],
                    description: Some("When set, generates the parameters file without restoring external modules"),
                    arguments: [
                        (
                            name: "no-restore",
                        ),
                    ],
                ),
                (
                    names: [
                        "--outdir",
                    ],
                    description: Some("When set, saves the output at the specified directory"),
                    arguments: [
                        (
                            name: "outdir",
                        ),
                    ],
                ),
                (
                    names: [
                        "--outfile",
                    ],
                    description: Some("When set, saves the output as the specified file path"),
                    arguments: [
                        (
                            name: "outfile",
                        ),
                    ],
                ),
                (
                    names: [
                        "--output-format",
                    ],
                    description: Some("Set output format. Valid values are ( json | bicepparam )"),
                    arguments: [
                        (
                            name: "output-format",
                        ),
                    ],
                ),
                (
                    names: [
                        "--stdout",
                    ],
                    description: Some("When set, prints all output to stdout instead of corresponding files"),
                    arguments: [
                        (
                            name: "stdout",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "install",
            description: Some("Install Bicep CLI"),
            options: [
                (
                    names: [
                        "--target-platform",
                        "-t",
                    ],
                    description: Some("The platform the Bicep CLI will be running on. Set this to skip automatic platform detection if it does not work properly"),
                    arguments: [
                        (
                            name: "target-platform",
                            suggestions: [
                                (
                                    name: "linux-arm64",
                                ),
                                (
                                    name: "linux-musl-x64",
                                ),
                                (
                                    name: "linux-x64",
                                ),
                                (
                                    name: "osx-arm64",
                                ),
                                (
                                    name: "osx-x64",
                                ),
                                (
                                    name: "win-x64",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--version",
                        "-v",
                    ],
                    description: Some("The version of Bicep CLI to be installed. Default to the latest if not specified"),
                    arguments: [
                        (
                            name: "version",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "list-versions",
            description: Some("List out all available versions of Bicep CLI"),
        ),
        (
            name: "publish",
            description: Some("Publish a bicep file to a remote module registry"),
            options: [
                (
                    names: [
                        "--file",
                        "-f",
                    ],
                    description: Some("The path to the Bicep module file to publish in the file system"),
                    arguments: [
                        (
                            name: "file",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--target",
                        "-t",
                    ],
                    description: Some("The target location where the Bicep module will be published"),
                    arguments: [
                        (
                            name: "target",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--documentationUri",
                        "-d",
                    ],
                    description: Some("The documentation uri of the Bicep module"),
                    arguments: [
                        (
                            name: "documentationUri",
                        ),
                    ],
                ),
                (
                    names: [
                        "--force",
                    ],
                    description: Some("Allow overwriting an existing Bicep module version"),
                    arguments: [
                        (
                            name: "force",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "restore",
            description: Some("Restore external modules for a bicep file"),
            options: [
                (
                    names: [
                        "--file",
                        "-f",
                    ],
                    description: Some("The path to the Bicep file to restore external modules for"),
                    arguments: [
                        (
                            name: "file",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--force",
                    ],
                    description: Some("Allows overwriting the cached external modules"),
                    arguments: [
                        (
                            name: "force",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "uninstall",
            description: Some("Uninstall Bicep CLI"),
        ),
        (
            name: "upgrade",
            description: Some("Upgrade Bicep CLI to the latest version"),
            options: [
                (
                    names: [
                        "--target-platform",
                        "-t",
                    ],
                    description: Some("The platform the Bicep CLI will be running on. Set this to skip automatic platform detection if it does not work properly"),
                    arguments: [
                        (
                            name: "target-platform",
                            suggestions: [
                                (
                                    name: "linux-arm64",
                                ),
                                (
                                    name: "linux-musl-x64",
                                ),
                                (
                                    name: "linux-x64",
                                ),
                                (
                                    name: "osx-arm64",
                                ),
                                (
                                    name: "osx-x64",
                                ),
                                (
                                    name: "win-x64",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "version",
            description: Some("Show the installed version of Bicep CLI"),
        ),
    ],
)
