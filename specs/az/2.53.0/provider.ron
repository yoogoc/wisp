(
    version: 1,
    command: "provider",
    description: Some("Manage resource providers"),
    subcommands: [
        (
            name: "list",
            description: Some("Gets all resource providers for a subscription"),
            options: [
                (
                    names: [
                        "--expand",
                    ],
                    description: Some("The properties to include in the results. For example, use &$expand=metadata in the query string to retrieve resource provider metadata. To include property aliases in response, use $expand=resourceTypes/aliases. Default value is None"),
                    arguments: [
                        (
                            name: "expand",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "register",
            description: Some("Register a provider"),
            options: [
                (
                    names: [
                        "--namespace",
                        "-n",
                    ],
                    description: Some("The resource namespace, aka 'provider'"),
                    arguments: [
                        (
                            name: "namespace",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--consent-to-permissions",
                        "-c",
                    ],
                    description: Some("A value indicating whether authorization is consented or not"),
                ),
                (
                    names: [
                        "--management-group-id",
                        "-m",
                    ],
                    description: Some("The management group id to register"),
                    arguments: [
                        (
                            name: "management-group-id",
                        ),
                    ],
                ),
                (
                    names: [
                        "--wait",
                    ],
                    description: Some("Wait for the registration to finish"),
                ),
            ],
        ),
        (
            name: "show",
            description: Some("Gets the specified resource provider"),
            options: [
                (
                    names: [
                        "--namespace",
                        "-n",
                    ],
                    description: Some("The resource namespace, aka 'provider'"),
                    arguments: [
                        (
                            name: "namespace",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--expand",
                    ],
                    description: Some("The $expand query parameter. For example, to include property aliases in response, use $expand=resourceTypes/aliases. Default value is None"),
                    arguments: [
                        (
                            name: "expand",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "unregister",
            description: Some("Unregister a provider"),
            options: [
                (
                    names: [
                        "--namespace",
                        "-n",
                    ],
                    description: Some("The resource namespace, aka 'provider'"),
                    arguments: [
                        (
                            name: "namespace",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--wait",
                    ],
                    description: Some("Wait for unregistration to finish"),
                ),
            ],
        ),
        (
            name: "operation",
            description: Some("Get provider operations metadatas"),
            subcommands: [
                (
                    name: "list",
                    description: Some("Get operations from all providers"),
                ),
                (
                    name: "show",
                    description: Some("Get an individual provider's operations"),
                    options: [
                        (
                            names: [
                                "--namespace",
                                "-n",
                            ],
                            description: Some("The resource namespace, aka 'provider'"),
                            arguments: [
                                (
                                    name: "namespace",
                                ),
                            ],
                            required: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "permission",
            description: Some("Manage permissions for a provider"),
            subcommands: [
                (
                    name: "list",
                    description: Some("List permissions from a provider"),
                    options: [
                        (
                            names: [
