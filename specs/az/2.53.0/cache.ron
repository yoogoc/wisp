(
    version: 1,
    command: "cache",
    description: Some("Commands to manage CLI objects cached using the --defer argument"),
    subcommands: [
        (
            name: "delete",
            description: Some("Delete an object from the cache"),
            options: [
                (
                    names: [
                        "--name",
                        "-n",
                    ],
                    description: Some("The resource name"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--resource-type",
                        "-t",
                    ],
                    description: Some("The resource type"),
                    arguments: [
                        (
                            name: "resource-type",
                        ),
                    ],
                    required: true,
                ),
            ],
        ),
        (
            name: "list",
            description: Some("List the contents of the object cache"),
        ),
        (
            name: "purge",
            description: Some("Clear the entire CLI object cache"),
        ),
        (
            name: "show",
            description: Some("Show the contents of a specific object in the cache"),
            options: [
                (
                    names: [
                        "--name",
                        "-n",
                    ],
                    description: Some("The resource name"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--resource-type",
                        "-t",
                    ],
                    description: Some("The resource type"),
                    arguments: [
                        (
                            name: "resource-type",
                        ),
                    ],
                    required: true,
                ),
            ],
        ),
    ],
)
