(
    version: 1,
    command: "artifacts",
    description: Some("Manage Azure Artifacts"),
    subcommands: [
        (
            name: "universal",
            description: Some("Manage Universal Packages"),
            subcommands: [
                (
                    name: "download",
                    description: Some("Download a package"),
                    options: [
                        (
                            names: [
                                "--feed",
                            ],
                            description: Some("Name or ID of the feed"),
                            arguments: [
                                (
                                    name: "feed",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("Name of the package, e.g. 'foo-package'"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--path",
                            ],
                            description: Some("Directory to place the package contents"),
                            arguments: [
                                (
                                    name: "path",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--version",
                                "-v",
                            ],
                            description: Some("Version of the package, e.g. 1.0.0"),
                            arguments: [
                                (
                                    name: "version",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--detect",
                            ],
                            description: Some("Automatically detect organization"),
                            arguments: [
                                (
                                    name: "detect",
                                    suggestions: [
                                        (
                                            name: "false",
                                        ),
                                        (
                                            name: "true",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--file-filter",
                            ],
                            description: Some("Wildcard filter for file download"),
                            arguments: [
                                (
                                    name: "file-filter",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--organization",
                                "--org",
                            ],
                            description: Some("Azure DevOps organization URL. You can configure the default organization using az devops configure -d organization=ORG_URL. Required if not configured as default or picked up via git config. Example: https://dev.azure.com/MyOrganizationName/"),
                            arguments: [
                                (
                                    name: "organization",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--project",
                                "-p",
                            ],
                            description: Some("Name or ID of the project. You can configure the default project using az devops configure -d project=NAME_OR_ID. Required if not configured as default or picked up via git config"),
                            arguments: [
                                (
                                    name: "project",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--scope",
                            ],
                            description: Some("Scope of the feed: 'project' if the feed was created in a project, and 'organization' otherwise"),
                            arguments: [
                                (
                                    name: "scope",
                                    suggestions: [
                                        (
                                            name: "organization",
                                        ),
                                        (
                                            name: "project",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "publish",
                    description: Some("Publish a package to a feed"),
                    options: [
                        (
                            names: [
                                "--feed",
                            ],
                            description: Some("Name or ID of the feed"),
                            arguments: [
                                (
                                    name: "feed",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("Name of the package, e.g. 'foo-package'"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--path",
                            ],
                            description: Some("Directory containing the package contents"),
                            arguments: [
                                (
                                    name: "path",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--version",
                                "-v",
                            ],
                            description: Some("Version of the package, e.g. '1.0.0'"),
                            arguments: [
                                (
                                    name: "version",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--description",
                                "-d",
                            ],
                            description: Some("Description of the package"),
                            arguments: [
                                (
                                    name: "description",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--detect",
                            ],
                            description: Some("Automatically detect organization"),
                            arguments: [
                                (
                                    name: "detect",
                                    suggestions: [
                                        (
                                            name: "false",
                                        ),
                                        (
                                            name: "true",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--organization",
                                "--org",
                            ],
                            description: Some("Azure DevOps organization URL. You can configure the default organization using az devops configure -d organization=ORG_URL. Required if not configured as default or picked up via git config. Example: https://dev.azure.com/MyOrganizationName/"),
                            arguments: [
                                (
                                    name: "organization",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--project",
                                "-p",
                            ],
                            description: Some("Name or ID of the project. You can configure the default project using az devops configure -d project=NAME_OR_ID. Required if not configured as default or picked up via git config"),
                            arguments: [
                                (
                                    name: "project",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--scope",
                            ],
                            description: Some("Scope of the feed: 'project' if the feed was created in a project, and 'organization' otherwise"),
                            arguments: [
                                (
                                    name: "scope",
                                    suggestions: [
                                        (
                                            name: "organization",
                                        ),
                                        (
                                            name: "project",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
    ],
)
