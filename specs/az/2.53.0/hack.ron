(
    version: 1,
    command: "hack",
    description: Some("Commands to manage resources commonly used for student hacks"),
    subcommands: [
        (
            name: "create",
            description: Some("Create resources commonly used for a student hack, including a website, database, and artificial intelligence"),
            options: [
                (
                    names: [
                        "--location",
                        "-l",
                    ],
                    description: Some("Location. Values from: az account list-locations. You can configure the default location using az configure --defaults location=<location>"),
                    arguments: [
                        (
                            name: "location",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--name",
                        "-n",
                    ],
                    description: Some("Base name of resources; random charagers will be appended"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--runtime",
                        "-r",
                    ],
                    description: Some("Runtime"),
                    arguments: [
                        (
                            name: "runtime",
                            suggestions: [
                                (
                                    name: "aspnet",
                                ),
                                (
                                    name: "jetty",
                                ),
                                (
                                    name: "node",
                                ),
                                (
                                    name: "php",
                                ),
                                (
                                    name: "python",
                                ),
                                (
                                    name: "tomcat",
                                ),
                            ],
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--ai",
                    ],
                    description: Some("Enable Azure Cognitive Services"),
                    arguments: [
                        (
                            name: "ai",
                        ),
                    ],
                ),
                (
                    names: [
                        "--database",
                        "-d",
                    ],
                    description: Some("Database type - { sql | mysql | cosmosdb }"),
                    arguments: [
                        (
                            name: "database",
                            suggestions: [
                                (
                                    name: "cosmosdb",
                                ),
                                (
                                    name: "mysql",
                                ),
                                (
                                    name: "sql",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "show",
            description: Some("Display settings for created resources, including database name and password, Git url, and website url"),
            options: [
                (
                    names: [
                        "--name",
                        "-n",
                    ],
                    description: Some("Name of the application"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                    required: true,
                ),
            ],
        ),
    ],
)
