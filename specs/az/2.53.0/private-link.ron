(
    version: 1,
    command: "private-link",
    description: Some("Private-link association CLI command group"),
    subcommands: [
        (
            name: "association",
            description: Some("Private-link association management on a resource"),
            subcommands: [
                (
                    name: "create",
                    description: Some("Create a PrivateLinkAssociation"),
                    options: [
                        (
                            names: [
                                "--management-group-id",
                                "-m",
                            ],
                            description: Some("The management group id"),
                            arguments: [
                                (
                                    name: "management-group-id",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("The name of the private link association"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--privatelink",
                                "-p",
                            ],
                            description: Some("The name of the private link"),
                            arguments: [
                                (
                                    name: "privatelink",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--public-network-access",
                                "-a",
                            ],
                            description: Some("Restrict traffic to private link"),
                            arguments: [
                                (
                                    name: "public-network-access",
                                    suggestions: [
                                        (
                                            name: "disabled",
                                        ),
                                        (
                                            name: "enabled",
                                        ),
                                    ],
                                ),
                            ],
                            required: true,
                        ),
                    ],
                ),
                (
                    name: "delete",
                    description: Some("Delete a PrivateLinkAssociation"),
                    options: [
                        (
                            names: [
                                "--management-group-id",
                                "-m",
                            ],
                            description: Some("The management group id"),
                            arguments: [
                                (
                                    name: "management-group-id",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("The name of the private link association"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--yes",
                                "-y",
                            ],
                            description: Some("Do not prompt for confirmation"),
                        ),
                    ],
                ),
                (
                    name: "list",
                    description: Some("Get a private link association for a management group scope"),
                    options: [
                        (
                            names: [
                                "--management-group-id",
                                "-m",
                            ],
                            description: Some("The management group id"),
                            arguments: [
                                (
                                    name: "management-group-id",
                                ),
                            ],
                            required: true,
                        ),
                    ],
                ),
                (
                    name: "show",
                    description: Some("Get a private link association"),
                    options: [
                        (
                            names: [
                                "--management-group-id",
