(
    version: 1,
    command: "afd",
    description: Some("Manage Azure Front Door Standard/Premium. For classical Azure Front Door, please refer https://docs.microsoft.com/en-us/cli/azure/network/front-door?view=azure-cli-latest"),
    subcommands: [
        (
            name: "custom-domain",
            description: Some("Manage custom domains within the specified profile"),
            subcommands: [
                (
                    name: "create",
                    description: Some("Create a custom domain within the specified profile"),
                    options: [
                        (
                            names: [
                                "--certificate-type",
                            ],
                            description: Some("Defines the source of the SSL certificate"),
                            arguments: [
                                (
                                    name: "certificate-type",
                                    suggestions: [
                                        (
                                            name: "AzureFirstPartyManagedCertificate",
                                        ),
                                        (
                                            name: "CustomerCertificate",
