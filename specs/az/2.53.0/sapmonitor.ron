(
    version: 1,
    command: "sapmonitor",
    description: Some("(PREVIEW) Manage Azure SAP Monitor"),
    subcommands: [
        (
            name: "create",
            description: Some("Create a SAP Monitor"),
            options: [
                (
                    names: [
                        "--hana-subnet",
                        "--hdbsn",
                    ],
                    description: Some("ARM ID of an Azure Subnet with access to the HANA instance"),
                    arguments: [
                        (
                            name: "hana-subnet",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--monitor-name",
