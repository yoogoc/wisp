(
    version: 1,
    command: "disk",
    description: Some("Manage Azure Managed Disks.\n\n\t\tAzure Virtual Machines use disks as a place to store an operating system, applications, and data. All Azure virtual machines have at least two disks: An operating system disk, and a temporary disk. The operating system disk is created from an image, and both the operating system disk and the image are actually virtual hard disks (VHDs) stored in an Azure storage account. Virtual machines also can have one or more data disks, that are also stored as VHDs.\nAzure Unmanaged Data Disks have a maximum size of 4095 GB. To use disks larger than 4095 GB use Azure Managed Disks"),
    subcommands: [
        (
            name: "create",
            description: Some("Create a managed disk"),
            options: [
                (
                    names: [
                        "--name",
                        "-n",
                    ],
                    description: Some("The name of the managed disk"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--accelerated-network",
                    ],
                    description: Some("Customers can set on Managed Disks or Snapshots to enable the accelerated networking if the OS disk image support"),
                    arguments: [
                        (
                            name: "accelerated-network",
                            suggestions: [
                                (
                                    name: "false",
                                ),
                                (
                                    name: "true",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--architecture",
                    ],
                    description: Some("CPU architecture"),
                    arguments: [
                        (
                            name: "architecture",
                            suggestions: [
                                (
                                    name: "Arm64",
                                ),
                                (
                                    name: "x64",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--data-access-auth-mode",
                    ],
                    description: Some("Specify the auth mode when exporting or uploading to a disk or snapshot"),
                    arguments: [
                        (
                            name: "data-access-auth-mode",
                            suggestions: [
                                (
                                    name: "AzureActiveDirectory",
                                ),
                                (
                                    name: "None",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--disk-access",
                    ],
                    description: Some("Name or ID of the disk access resource for using private endpoints on disks"),
                    arguments: [
                        (
                            name: "disk-access",
                        ),
                    ],
                ),
                (
                    names: [
                        "--disk-encryption-set",
                    ],
                    description: Some("Name or ID of disk encryption set that is used to encrypt the disk"),
                    arguments: [
                        (
                            name: "disk-encryption-set",
                        ),
                    ],
                ),
                (
                    names: [
                        "--disk-iops-read-only",
                    ],
                    description: Some("The total number of IOPS that will be allowed across all VMs mounting the shared disk as ReadOnly. One operation can transfer between 4k and 256k bytes"),
                    arguments: [
                        (
                            name: "disk-iops-read-only",
                        ),
                    ],
                ),
                (
                    names: [
                        "--disk-iops-read-write",
                    ],
                    description: Some("The number of IOPS allowed for this disk. Only settable for UltraSSD disks. One operation can transfer between 4k and 256k bytes"),
                    arguments: [
                        (
                            name: "disk-iops-read-write",
                        ),
                    ],
                ),
                (
                    names: [
                        "--disk-mbps-read-only",
                    ],
                    description: Some("The total throughput (MBps) that will be allowed across all VMs mounting the shared disk as ReadOnly. MBps means millions of bytes per second - MB here uses the ISO notation, of powers of 10"),
                    arguments: [
                        (
                            name: "disk-mbps-read-only",
                        ),
                    ],
                ),
                (
                    names: [
                        "--disk-mbps-read-write",
                    ],
                    description: Some("The bandwidth allowed for this disk. Only settable for UltraSSD disks. MBps means millions of bytes per second with ISO notation of powers of 10"),
                    arguments: [
                        (
                            name: "disk-mbps-read-write",
                        ),
                    ],
                ),
                (
                    names: [
                        "--edge-zone",
                    ],
                    description: Some("The name of edge zone"),
                    arguments: [
                        (
                            name: "edge-zone",
                        ),
                    ],
                ),
                (
                    names: [
                        "--enable-bursting",
                    ],
                    description: Some("Enable on-demand bursting beyond the provisioned performance target of the disk. On-demand bursting is disabled by default, and it does not apply to Ultra disks"),
                    arguments: [
                        (
                            name: "enable-bursting",
                            suggestions: [
                                (
                                    name: "false",
                                ),
                                (
                                    name: "true",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--encryption-type",
                    ],
                    description: Some("Encryption type. EncryptionAtRestWithPlatformKey: Disk is encrypted with XStore managed key at rest. It is the default encryption type. EncryptionAtRestWithCustomerKey: Disk is encrypted with Customer managed key at rest"),
                    arguments: [
                        (
                            name: "encryption-type",
                            suggestions: [
                                (
                                    name: "EncryptionAtRestWithCustomerKey",
                                ),
                                (
                                    name: "EncryptionAtRestWithPlatformAndCustomerKeys",
                                ),
                                (
                                    name: "EncryptionAtRestWithPlatformKey",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--gallery-image-reference",
                    ],
                    description: Some("ID of the Compute, Shared or Community Gallery image version from which to create a disk. For details about valid format, please refer to the help sample"),
                    arguments: [
                        (
                            name: "gallery-image-reference",
                        ),
                    ],
                ),
                (
                    names: [
                        "--gallery-image-reference-lun",
                    ],
                    description: Some("If the disk is created from an image's data disk, this is an index that indicates which of the data disks in the image to use. For OS disks, this field is null"),
                    arguments: [
                        (
                            name: "gallery-image-reference-lun",
                        ),
                    ],
                ),
                (
                    names: [
                        "--hyper-v-generation",
                    ],
                    description: Some("The hypervisor generation of the Virtual Machine. Applicable to OS disks only"),
                    arguments: [
                        (
                            name: "hyper-v-generation",
                            suggestions: [
                                (
                                    name: "V1",
                                ),
                                (
                                    name: "V2",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--image-reference",
                    ],
                    description: Some("ID or URN (publisher:offer:sku:version) of the image from which to create a disk"),
                    arguments: [
                        (
                            name: "image-reference",
                        ),
                    ],
                ),
                (
                    names: [
                        "--image-reference-lun",
                    ],
                    description: Some("If the disk is created from an image's data disk, this is an index that indicates which of the data disks in the image to use. For OS disks, this field is null"),
                    arguments: [
                        (
                            name: "image-reference-lun",
                        ),
                    ],
                ),
                (
                    names: [
                        "--location",
                        "-l",
                    ],
                    description: Some("Location. Values from: az account list-locations. You can configure the default location using az configure --defaults location=<location>. If location is not specified and no default location specified, location will be automatically set as same as the resource group"),
                    arguments: [
                        (
                            name: "location",
                        ),
                    ],
                ),
                (
                    names: [
                        "--logical-sector-size",
                    ],
                    description: Some("Logical sector size in bytes for Ultra disks. Supported values are 512 ad 4096. 4096 is the default"),
                    arguments: [
                        (
                            name: "logical-sector-size",
                        ),
                    ],
                ),
                (
                    names: [
                        "--max-shares",
                    ],
                    description: Some("The maximum number of VMs that can attach to the disk at the same time. Value greater than one indicates a disk that can be mounted on multiple VMs at the same time"),
                    arguments: [
                        (
                            name: "max-shares",
                        ),
                    ],
                ),
                (
                    names: [
                        "--network-access-policy",
                    ],
                    description: Some("Policy for accessing the disk via network"),
                    arguments: [
                        (
                            name: "network-access-policy",
                            suggestions: [
                                (
                                    name: "AllowAll",
                                ),
                                (
                                    name: "AllowPrivate",
                                ),
                                (
                                    name: "DenyAll",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-wait",
                    ],
                    description: Some("Do not wait for the long-running operation to finish"),
                ),
                (
                    names: [
                        "--os-type",
                    ],
                    description: Some("The Operating System type of the Disk"),
                    arguments: [
                        (
                            name: "os-type",
                            suggestions: [
                                (
                                    name: "Linux",
                                ),
                                (
                                    name: "Windows",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--performance-plus",
                    ],
                    description: Some("Set this flag to true to get a boost on the performance target of the disk deployed. This flag can only be set on disk creation time and cannot be disabled after enabled"),
                    arguments: [
                        (
                            name: "performance-plus",
                            suggestions: [
                                (
                                    name: "false",
                                ),
                                (
                                    name: "true",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--public-network-access",
                    ],
                    description: Some("Customers can set on Managed Disks or Snapshots to control the export policy on the disk"),
                    arguments: [
                        (
                            name: "public-network-access",
                            suggestions: [
                                (
                                    name: "Disabled",
                                ),
                                (
                                    name: "Enabled",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--secure-vm-disk-encryption-set",
                    ],
                    description: Some("Name or ID of disk encryption set created with ConfidentialVmEncryptedWithCustomerKey encryption type"),
                    arguments: [
