(
    version: 1,
    command: "lock",
    description: Some("Manage Azure locks"),
    subcommands: [
        (
            name: "create",
            description: Some("Create a lock"),
            options: [
                (
                    names: [
                        "--lock-type",
                        "-t",
                    ],
                    description: Some("The type of lock restriction"),
                    arguments: [
                        (
                            name: "lock-type",
                            suggestions: [
                                (
                                    name: "CanNotDelete",
                                ),
                                (
                                    name: "ReadOnly",
                                ),
                            ],
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--name",
                        "-n",
                    ],
                    description: Some("Name of the lock"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--namespace",
                    ],
                    description: Some("Provider namespace (Ex: 'Microsoft.Provider')"),
                    arguments: [
                        (
                            name: "namespace",
                        ),
                    ],
                ),
                (
                    names: [
                        "--notes",
                    ],
                    description: Some("Notes about this lock"),
                    arguments: [
                        (
                            name: "notes",
                        ),
                    ],
                ),
                (
                    names: [
                        "--parent",
                    ],
                    description: Some("The parent path (Ex: 'resA/myA/resB/myB')"),
                    arguments: [
                        (
                            name: "parent",
                        ),
                    ],
                ),
                (
                    names: [
                        "--resource-name",
                        "--resource",
                    ],
                    description: Some("Name or ID of the resource being locked. If an ID is given, other resource arguments should not be given"),
