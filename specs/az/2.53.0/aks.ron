(
    version: 1,
    command: "aks",
    description: Some("Manage Azure Kubernetes Services"),
    subcommands: [
        (
            name: "addon",
            description: Some("Commands to manage and view single addon conditions"),
            subcommands: [
                (
                    name: "disable",
                    description: Some("Disable an enabled Kubernetes addon in a cluster"),
                    options: [
                        (
                            names: [
                                "--addon",
                                "-a",
                            ],
                            description: Some("Specify the Kubernetes addon to disable"),
                            arguments: [
                                (
                                    name: "addon",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("Name of the managed cluster"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--resource-group",
                                "-g",
                            ],
                            description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                            arguments: [
                                (
                                    name: "resource-group",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--no-wait",
                            ],
                            description: Some("Do not wait for the long-running operation to finish"),
                        ),
                    ],
                ),
                (
                    name: "enable",
                    description: Some("Enable a Kubernetes addon"),
                    options: [
                        (
                            names: [
                                "--addon",
                                "-a",
                            ],
                            description: Some("Specify the Kubernetes addon to enable"),
                            arguments: [
                                (
                                    name: "addon",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("Name of the managed cluster"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--resource-group",
                                "-g",
                            ],
                            description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                            arguments: [
                                (
                                    name: "resource-group",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--appgw-id",
                            ],
                            description: Some("Resource Id of an existing Application Gateway to use with AGIC. Use with ingress-azure addon"),
                            arguments: [
                                (
                                    name: "appgw-id",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--appgw-name",
                            ],
                            description: Some("Name of the application gateway to create/use in the node resource group. Use with ingress-azure addon"),
                            arguments: [
                                (
                                    name: "appgw-name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--appgw-subnet-cidr",
                            ],
                            description: Some("Subnet CIDR to use for a new subnet created to deploy the Application Gateway. Use with ingress-azure addon"),
                            arguments: [
                                (
                                    name: "appgw-subnet-cidr",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--appgw-subnet-id",
                            ],
                            description: Some("Resource Id of an existing Subnet used to deploy the Application Gateway. Use with ingress-azure addon"),
