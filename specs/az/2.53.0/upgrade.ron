(
    version: 1,
    command: "upgrade",
    description: Some("Upgrade Azure CLI and extensions"),
    options: [
        (
            names: [
                "--all",
            ],
            description: Some("Enable updating extensions as well"),
            arguments: [
                (
                    name: "all",
                    suggestions: [
                        (
                            name: "false",
                        ),
                        (
                            name: "true",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--yes",
                "-y",
            ],
            description: Some("Do not prompt for checking release notes"),
        ),
    ],
)
