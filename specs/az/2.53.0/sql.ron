                                    description: Some("Path to the custom resource specification, i.e. custom/spec.json"),
                                    arguments: [
                                        (
                                            name: "path",
                                        ),
                                    ],
                                    required: true,
                                ),
                            ],
                        ),
                        (
                            name: "init",
                            description: Some("Initialize the CRD and specification files for a SQL managed instance"),
                            options: [
