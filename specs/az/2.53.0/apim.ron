(
    version: 1,
    command: "apim",
    description: Some("Manage Azure API Management services"),
    subcommands: [
        (
            name: "api",
            description: Some("Manage Azure API Management API's"),
            subcommands: [
                (
                    name: "create",
                    description: Some("Create an API Management API"),
                    options: [
                        (
                            names: [
                                "--api-id",
                            ],
                            description: Some("Unique name of the api to be created"),
                            arguments: [
                                (
                                    name: "api-id",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--display-name",
                            ],
                            description: Some("Display name of the API to be created"),
                            arguments: [
                                (
                                    name: "display-name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--path",
                            ],
                            description: Some("Path to the API"),
