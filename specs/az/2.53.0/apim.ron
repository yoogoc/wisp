                                ),
                            ],
                        ),
                        (
                            names: [
                                "--description",
                            ],
                            description: Some("Description of the API. May include HTML formatting tags"),
                            arguments: [
                                (
                                    name: "description",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--no-wait",
                            ],
                            description: Some("Do not wait for the long-running operation to finish"),
                        ),
                        (
                            names: [
                                "--open-id-provider-id",
                            ],
                            description: Some("Specifies the openid in the authentication setting"),
