                                    name: "api-type",
                                    suggestions: [
                                        (
                                            name: "graphql",
                                        ),
                                        (
                                            name: "http",
                                        ),
                                        (
                                            name: "soap",
                                        ),
                                        (
                                            name: "websocket",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--authorization-scope",
