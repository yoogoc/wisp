(
    version: 1,
    command: "cli-translator",
    description: Some("Translate ARM template or REST API to CLI scripts"),
    subcommands: [
        (
            name: "arm",
            description: Some("Translate ARM template to CLI scripts(Currently only support Compute, Network and Storage)"),
            subcommands: [
                (
                    name: "translate",
                    description: Some("Translate ARM template to CLI scripts(Currently only support Compute, Network and Storage)"),
                    options: [
                        (
                            names: [
                                "--parameters",
                            ],
                            description: Some("The local path or url of parameters.json file"),
                            arguments: [
                                (
                                    name: "parameters",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--resource-group",
                                "-g",
                            ],
                            description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                            arguments: [
                                (
                                    name: "resource-group",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--template",
                            ],
                            description: Some("The local path or url of template.json file"),
                            arguments: [
                                (
                                    name: "template",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--target-subscription",
                            ],
                            description: Some("The target subscription id. If omit, the current subscription id will be used"),
                            arguments: [
                                (
                                    name: "target-subscription",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
    ],
)
