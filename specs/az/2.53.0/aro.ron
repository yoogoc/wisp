(
    version: 1,
    command: "aro",
    description: Some("Manage Azure Red Hat OpenShift clusters"),
    subcommands: [
        (
            name: "create",
            description: Some("Create a cluster"),
            options: [
                (
                    names: [
                        "--master-subnet",
                    ],
                    description: Some("Name or ID of master vnet subnet. If name is supplied, --vnet must be supplied"),
                    arguments: [
                        (
                            name: "master-subnet",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--name",
                        "-n",
                    ],
                    description: Some("Name of cluster"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--worker-subnet",
                    ],
                    description: Some("Name or ID of worker vnet subnet. If name is supplied, --vnet must be supplied"),
                    arguments: [
                        (
                            name: "worker-subnet",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--apiserver-visibility",
                    ],
                    description: Some("API server visibility"),
                    arguments: [
                        (
                            name: "apiserver-visibility",
                            suggestions: [
                                (
                                    name: "Private",
                                ),
                                (
                                    name: "Public",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--client-id",
                    ],
                    description: Some("Client ID of cluster service principal"),
                    arguments: [
                        (
                            name: "client-id",
                        ),
                    ],
                ),
                (
                    names: [
                        "--client-secret",
                    ],
                    description: Some("Client secret of cluster service principal"),
                    arguments: [
                        (
                            name: "client-secret",
                        ),
                    ],
                ),
                (
                    names: [
                        "--cluster-resource-group",
                    ],
                    description: Some("Resource group of cluster"),
                    arguments: [
                        (
                            name: "cluster-resource-group",
                        ),
                    ],
                ),
                (
                    names: [
                        "--disk-encryption-set",
                    ],
                    description: Some("ResourceID of the DiskEncryptionSet to be used for master and worker VMs"),
                    arguments: [
                        (
                            name: "disk-encryption-set",
                        ),
                    ],
                ),
                (
                    names: [
                        "--domain",
                    ],
                    description: Some("Domain of cluster"),
                    arguments: [
                        (
                            name: "domain",
                        ),
                    ],
                ),
                (
                    names: [
                        "--fips-validated-modules",
                        "--fips",
                    ],
                    description: Some("Use FIPS validated cryptography modules"),
                    arguments: [
                        (
                            name: "fips-validated-modules",
                            suggestions: [
                                (
                                    name: "false",
                                ),
                                (
                                    name: "true",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--ingress-visibility",
                    ],
                    description: Some("Ingress visibility"),
                    arguments: [
                        (
                            name: "ingress-visibility",
                            suggestions: [
                                (
                                    name: "Private",
                                ),
                                (
                                    name: "Public",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--location",
                        "-l",
                    ],
                    description: Some("Location. Values from: az account list-locations. You can configure the default location using az configure --defaults location=<location>"),
                    arguments: [
                        (
                            name: "location",
                        ),
                    ],
                ),
                (
                    names: [
                        "--master-encryption-at-host",
                        "--master-enc-host",
                    ],
                    description: Some("Encryption at host flag for master VMs"),
                ),
                (
                    names: [
                        "--master-vm-size",
                    ],
                    description: Some("Size of master VMs"),
                    arguments: [
                        (
                            name: "master-vm-size",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-wait",
                    ],
                    description: Some("Do not wait for the long-running operation to finish"),
                ),
                (
                    names: [
                        "--outbound-type",
                    ],
                    description: Some("Outbound type of cluster. Must be \"Loadbalancer\" (default) or \"UserDefinedRouting\""),
                    arguments: [
                        (
                            name: "outbound-type",
                        ),
                    ],
                ),
                (
                    names: [
                        "--pod-cidr",
                    ],
                    description: Some("CIDR of pod network. Must be a minimum of /18 or larger"),
                    arguments: [
                        (
                            name: "pod-cidr",
                        ),
                    ],
                ),
                (
                    names: [
                        "--pull-secret",
                    ],
                    description: Some("Pull secret of cluster"),
                    arguments: [
                        (
                            name: "pull-secret",
                        ),
                    ],
                ),
                (
                    names: [
                        "--service-cidr",
                    ],
                    description: Some("CIDR of service network. Must be a minimum of /18 or larger"),
                    arguments: [
                        (
                            name: "service-cidr",
                        ),
                    ],
                ),
                (
                    names: [
                        "--tags",
                    ],
                    description: Some("Space-separated tags: key[=value] [key[=value] ...]. Use \"\" to clear existing tags"),
                    arguments: [
                        (
                            name: "tags",
                        ),
                    ],
                ),
                (
                    names: [
                        "--version",
                    ],
                    description: Some("OpenShift version to use for cluster creation"),
                    arguments: [
                        (
                            name: "version",
                        ),
                    ],
                ),
                (
                    names: [
                        "--vnet",
                    ],
                    description: Some("Name or ID of vnet. If name is supplied, --vnet-resource-group must be supplied"),
                    arguments: [
                        (
                            name: "vnet",
                        ),
                    ],
                ),
                (
                    names: [
                        "--vnet-resource-group",
                    ],
                    description: Some("Name of vnet resource group"),
                    arguments: [
                        (
                            name: "vnet-resource-group",
                        ),
                    ],
                ),
                (
                    names: [
                        "--worker-count",
                    ],
                    description: Some("Count of worker VMs"),
                    arguments: [
                        (
                            name: "worker-count",
                        ),
                    ],
                ),
                (
                    names: [
                        "--worker-encryption-at-host",
                        "--worker-enc-host",
                    ],
                    description: Some("Encryption at host flag for worker VMs"),
                ),
                (
                    names: [
                        "--worker-vm-disk-size-gb",
                    ],
                    description: Some("Disk size in GB of worker VMs"),
                    arguments: [
                        (
                            name: "worker-vm-disk-size-gb",
                        ),
                    ],
                ),
                (
                    names: [
                        "--worker-vm-size",
                    ],
                    description: Some("Size of worker VMs"),
                    arguments: [
                        (
                            name: "worker-vm-size",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "delete",
