                (
                    names: [
                        "--refresh-credentials",
                    ],
                    description: Some("Refresh cluster application credentials"),
                ),
            ],
        ),
        (
            name: "validate",
            description: Some("Validate permissions required to create a cluster"),
            options: [
                (
                    names: [
                        "--master-subnet",
                    ],
                    description: Some("Name or ID of master vnet subnet. If name is supplied, --vnet must be supplied"),
                    arguments: [
                        (
                            name: "master-subnet",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--name",
                        "-n",
                    ],
                    description: Some("Name of cluster"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
