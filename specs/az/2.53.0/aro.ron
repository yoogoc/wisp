        ),
        (
            name: "wait",
            description: Some("Wait for a cluster to reach a desired state"),
            options: [
                (
                    names: [
                        "--name",
                        "-n",
                    ],
                    description: Some("Name of cluster"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
