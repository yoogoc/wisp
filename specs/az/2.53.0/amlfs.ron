(
    version: 1,
    command: "amlfs",
    description: Some("Manage lustre file system"),
    subcommands: [
        (
            name: "archive",
            description: Some("Archive data from the AML file system"),
            options: [
                (
                    names: [
                        "--amlfs-name",
                    ],
                    description: Some("Name for the AML file system. Allows alphanumerics, underscores, and hyphens. Start and end with alphanumeric"),
                    arguments: [
                        (
                            name: "amlfs-name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--filesystem-path",
                    ],
                    description: Some("Lustre file system path to archive relative to the file system root. Specify '/' to archive all modified data"),
                    arguments: [
                        (
                            name: "filesystem-path",
                        ),
                    ],
                ),
                (
                    names: [
                        "--ids",
                    ],
                    description: Some("One or more resource IDs (space-delimited). It should be a complete resource ID containing all information of 'Resource Id' arguments. You should provide either --ids or other 'Resource Id' arguments"),
                    arguments: [
                        (
                            name: "ids",
                        ),
                    ],
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                ),
                (
                    names: [
                        "--subscription",
                    ],
                    description: Some("Name or ID of subscription. You can configure the default subscription using az account set -s NAME_OR_ID"),
                    arguments: [
                        (
                            name: "subscription",
                        ),
                    ],
                ),
            ],
        ),
