(
    version: 1,
    command: "support",
    description: Some("Manage Azure support resource"),
    subcommands: [
        (
            name: "services",
            description: Some("Azure services and related problem categories"),
            subcommands: [
                (
                    name: "list",
                    description: Some("Lists all the Azure services available for support ticket creation. Always use the service and it's corresponding problem classification(s) obtained programmatically for support ticket creation. This practice ensures that you always have the most recent set of service and problem classification Ids"),
                ),
                (
                    name: "show",
                    description: Some("Gets a specific Azure service for support ticket creation"),
                    options: [
                        (
                            names: [
                                "--service-name",
                            ],
                            description: Some("Name of Azure service"),
                            arguments: [
                                (
                                    name: "service-name",
                                ),
                            ],
                            required: true,
                        ),
                    ],
                ),
                (
                    name: "problem-classifications",
                    description: Some("Problem classifications for an Azure service"),
                    subcommands: [
                        (
                            name: "list",
                            description: Some("Lists all the problem classifications (categories) available for an Azure service. Always use the service and it's corresponding problem classification(s) obtained programmatically for support ticket creation. This practice ensures that you always have the most recent set of service and problem classification Ids"),
                            options: [
                                (
                                    names: [
                                        "--service-name",
                                    ],
                                    description: Some("Name of Azure service"),
                                    arguments: [
                                        (
                                            name: "service-name",
                                        ),
                                    ],
                                    required: true,
                                ),
                            ],
                        ),
                        (
                            name: "show",
                            description: Some("Gets the problem classification details for an Azure service"),
                            options: [
                                (
                                    names: [
                                        "--problem-classification-name",
                                    ],
                                    description: Some("Name of problem classification"),
                                    arguments: [
                                        (
                                            name: "problem-classification-name",
                                        ),
                                    ],
                                    required: true,
                                ),
                                (
                                    names: [
                                        "--service-name",
                                    ],
                                    description: Some("Name of Azure service"),
                                    arguments: [
                                        (
                                            name: "service-name",
                                        ),
                                    ],
                                    required: true,
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "tickets",
            description: Some("Create and manage Azure support ticket"),
            subcommands: [
                (
                    name: "create",
                    description: Some("Creates a new support ticket for Quota increase, Technical, Billing, and Subscription Management issues for the specified subscription"),
                    options: [
                        (
                            names: [
                                "--contact-country",
                            ],
                            description: Some("Country of the user. This is the ISO Alpha-3 code"),
                            arguments: [
                                (
                                    name: "contact-country",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--contact-email",
                            ],
                            description: Some("Primary email address"),
                            arguments: [
                                (
                                    name: "contact-email",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--contact-first-name",
                            ],
                            description: Some("First Name"),
                            arguments: [
                                (
                                    name: "contact-first-name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--contact-language",
                            ],
                            description: Some("Preferred language of support from Azure. Support languages vary based on the severity you choose for your support ticket. This is the standard country-language code"),
                            arguments: [
                                (
                                    name: "contact-language",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--contact-last-name",
                            ],
                            description: Some("Last Name"),
                            arguments: [
                                (
                                    name: "contact-last-name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--contact-method",
                            ],
                            description: Some("Preferred contact method"),
                            arguments: [
                                (
                                    name: "contact-method",
                                    suggestions: [
                                        (
                                            name: "email",
                                        ),
                                        (
                                            name: "phone",
                                        ),
                                    ],
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--contact-timezone",
                            ],
                            description: Some("Time zone of the user. This is the name of the time zone from Microsoft Time Zone Index Values"),
                            arguments: [
                                (
                                    name: "contact-timezone",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--description",
                            ],
                            description: Some("Detailed description of the question or issue"),
                            arguments: [
                                (
                                    name: "description",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--problem-classification",
                            ],
                            description: Some("Each Azure service has its own set of issue category called problem classification that corresponds to the type of problem you are experiencing. This parameter is the resource id of ProblemClassification resource"),
                            arguments: [
                                (
                                    name: "problem-classification",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--severity",
                            ],
                            description: Some("A value that indicates the urgency of the case, which in turn determines the response time according to the service level agreement of the technical support plan you have with Azure"),
                            arguments: [
                                (
                                    name: "severity",
                                    suggestions: [
                                        (
                                            name: "critical",
                                        ),
                                        (
                                            name: "highestcriticalimpact",
                                        ),
                                        (
                                            name: "minimal",
                                        ),
                                        (
                                            name: "moderate",
                                        ),
                                    ],
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--ticket-name",
                            ],
                            description: Some("Support ticket name"),
                            arguments: [
                                (
                                    name: "ticket-name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--title",
                            ],
                            description: Some("Title of the support ticket"),
                            arguments: [
                                (
                                    name: "title",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--contact-additional-emails",
                            ],
                            description: Some("Space-separated list of additional email addresses. Additional email addresses will be copied on any correspondence about the support ticket"),
                            arguments: [
                                (
                                    name: "contact-additional-emails",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--contact-phone-number",
                            ],
                            description: Some("Phone number. This is required if preferred contact method is phone"),
                            arguments: [
                                (
                                    name: "contact-phone-number",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--partner-tenant-id",
                            ],
                            description: Some("Partner tenant id for Admin On Behalf of (AOBO) scenario. In addition to logging in to the customer tenant, logging in to the partner tenant (PT) using \"az login -t PT --allow-no-subscriptions\" is required"),
                            arguments: [
                                (
                                    name: "partner-tenant-id",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--quota-change-payload",
                            ],
                            description: Some("Space -separated list of serialized payload of the quota increase request corresponding to regions. Visit https://aka.ms/supportrpquotarequestpayload for details"),
                            arguments: [
                                (
                                    name: "quota-change-payload",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--quota-change-regions",
                            ],
                            description: Some("Space-separated list of region for which the quota increase request is being made"),
                            arguments: [
                                (
                                    name: "quota-change-regions",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--quota-change-subtype",
                            ],
                            description: Some("Required for certain quota types when there is a sub type that you are requesting quota increase for. Example: Batch"),
                            arguments: [
                                (
                                    name: "quota-change-subtype",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--quota-change-version",
                            ],
                            description: Some("Quota change request version"),
                            arguments: [
                                (
                                    name: "quota-change-version",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--require-24-by-7-response",
                            ],
                            description: Some("Indicates if this requires a 24x7 response from Azure. Default is false"),
                            arguments: [
                                (
                                    name: "require-24-by-7-response",
                                    suggestions: [
                                        (
                                            name: "false",
                                        ),
                                        (
                                            name: "true",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--start-time",
                            ],
                            description: Some("Time in UTC datetime (Y-m-d'T'H:M:S'Z') when the problem started. Default is today"),
                            arguments: [
                                (
                                    name: "start-time",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--technical-resource",
                            ],
                            description: Some("This is the resource id of the Azure service resource for which the support ticket is created"),
                            arguments: [
                                (
                                    name: "technical-resource",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "list",
                    description: Some("Lists all the support tickets for an Azure subscription"),
                    options: [
                        (
                            names: [
                                "--filters",
                            ],
                            description: Some("The filter to apply on the operation. We support OData v4.0 semtantics. Filter can be specified on \"Status\" property using eq operator or on \"CreatedDate\" using gt/ge. To combine both filters, use the logical and operator. Default is CreatedDate >= one week"),
                            arguments: [
                                (
                                    name: "filters",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "show",
                    description: Some("Gets support ticket details for an Azure subscription"),
                    options: [
                        (
                            names: [
                                "--ticket-name",
                            ],
                            description: Some("Support ticket name"),
                            arguments: [
                                (
                                    name: "ticket-name",
                                ),
                            ],
                            required: true,
                        ),
                    ],
                ),
                (
                    name: "update",
                    description: Some("Updates severity level, status and customer contact information for a support ticket"),
                    options: [
                        (
                            names: [
                                "--ticket-name",
                            ],
                            description: Some("Support ticket name"),
                            arguments: [
                                (
                                    name: "ticket-name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--contact-additional-emails",
                            ],
                            description: Some("Space-separated list of additional email addresses. Additional email addresses will be copied on any correspondence about the support ticket"),
                            arguments: [
                                (
                                    name: "contact-additional-emails",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--contact-country",
                            ],
                            description: Some("Country of the user. This is the ISO Alpha-3 code"),
                            arguments: [
                                (
                                    name: "contact-country",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--contact-email",
                            ],
                            description: Some("Primary email address"),
                            arguments: [
                                (
                                    name: "contact-email",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--contact-first-name",
                            ],
                            description: Some("First Name"),
                            arguments: [
                                (
                                    name: "contact-first-name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--contact-language",
                            ],
                            description: Some("Preferred language of support from Azure. Support languages vary based on the severity you choose for your support ticket. This is the standard country-language code"),
                            arguments: [
                                (
                                    name: "contact-language",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--contact-last-name",
                            ],
                            description: Some("Last Name"),
                            arguments: [
                                (
                                    name: "contact-last-name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--contact-method",
                            ],
                            description: Some("Preferred contact method"),
                            arguments: [
                                (
                                    name: "contact-method",
                                    suggestions: [
                                        (
                                            name: "email",
                                        ),
                                        (
                                            name: "phone",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--contact-phone-number",
                            ],
                            description: Some("Phone number. This is required if preferred contact method is phone"),
                            arguments: [
                                (
                                    name: "contact-phone-number",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--contact-timezone",
                            ],
                            description: Some("Time zone of the user. This is the name of the time zone from Microsoft Time Zone Index Values"),
                            arguments: [
                                (
                                    name: "contact-timezone",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--severity",
                            ],
                            description: Some("A value that indicates the urgency of the case, which in turn determines the response time according to the service level agreement of the technical support plan you have with Azure"),
                            arguments: [
                                (
                                    name: "severity",
                                    suggestions: [
                                        (
                                            name: "critical",
                                        ),
                                        (
                                            name: "highestcriticalimpact",
                                        ),
                                        (
                                            name: "minimal",
                                        ),
                                        (
                                            name: "moderate",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--status",
                            ],
                            description: Some("Status to be updated on the ticket"),
                            arguments: [
                                (
                                    name: "status",
                                    suggestions: [
                                        (
                                            name: "closed",
                                        ),
                                        (
                                            name: "open",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "communications",
                    description: Some("Manage support ticket communications"),
                    subcommands: [
                        (
                            name: "create",
                            description: Some("Adds a new customer communication to an Azure support ticket"),
                            options: [
                                (
                                    names: [
                                        "--communication-body",
                                    ],
                                    description: Some("Text of the communication"),
                                    arguments: [
                                        (
                                            name: "communication-body",
                                        ),
                                    ],
                                    required: true,
                                ),
                                (
                                    names: [
                                        "--communication-name",
                                    ],
                                    description: Some("Communication name"),
                                    arguments: [
                                        (
                                            name: "communication-name",
                                        ),
                                    ],
                                    required: true,
                                ),
                                (
                                    names: [
                                        "--communication-subject",
                                    ],
                                    description: Some("Subject of the communication"),
                                    arguments: [
                                        (
                                            name: "communication-subject",
                                        ),
                                    ],
                                    required: true,
                                ),
                                (
                                    names: [
                                        "--ticket-name",
                                    ],
                                    description: Some("Support ticket name"),
                                    arguments: [
                                        (
                                            name: "ticket-name",
                                        ),
                                    ],
                                    required: true,
                                ),
                                (
                                    names: [
                                        "--communication-sender",
                                    ],
                                    description: Some("Email address of the sender"),
                                    arguments: [
                                        (
                                            name: "communication-sender",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            name: "list",
                            description: Some("Lists all communications (attachments not included) for a support ticket"),
                            options: [
                                (
                                    names: [
                                        "--ticket-name",
                                    ],
                                    description: Some("Support ticket name"),
                                    arguments: [
                                        (
                                            name: "ticket-name",
                                        ),
                                    ],
                                    required: true,
                                ),
                                (
                                    names: [
                                        "--filters",
                                    ],
                                    description: Some("The filter to apply on the operation. We support OData v4.0 semtantics. Filter can be specified on \"CommunicationType\" using eq operator or on \"CreatedDate\" using gt/ge. To combine both filters, use the logical and operator"),
                                    arguments: [
                                        (
                                            name: "filters",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            name: "show",
                            description: Some("Gets communication details for a support ticket"),
                            options: [
                                (
                                    names: [
                                        "--communication-name",
                                    ],
                                    description: Some("Communication name"),
                                    arguments: [
                                        (
                                            name: "communication-name",
                                        ),
                                    ],
                                    required: true,
                                ),
                                (
                                    names: [
                                        "--ticket-name",
                                    ],
                                    description: Some("Support ticket name"),
                                    arguments: [
                                        (
                                            name: "ticket-name",
                                        ),
                                    ],
                                    required: true,
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
    ],
)
