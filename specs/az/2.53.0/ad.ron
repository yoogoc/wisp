(
    version: 1,
    command: "ad",
    description: Some("Manage Azure Active Directory Graph entities needed for Role Based Access Control"),
    subcommands: [
        (
            name: "app",
            description: Some("Manage applications with AAD Graph"),
            subcommands: [
                (
                    name: "create",
                    description: Some("Create a web application, web API or native application"),
                    options: [
                        (
                            names: [
                                "--display-name",
                            ],
                            description: Some("The display name of the application"),
                            arguments: [
                                (
                                    name: "display-name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--app-roles",
                            ],
                            description: Some("The collection of roles assigned to the application. With app role assignments, these roles can be assigned to users, groups, or service principals associated with other applications. Should be JSON file path or in-line JSON string. See examples for details"),
                            arguments: [
                                (
                                    name: "app-roles",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--enable-access-token-issuance",
                            ],
                            description: Some("Specifies whether this web application can request an access token using the OAuth 2.0 implicit flow"),
                            arguments: [
                                (
                                    name: "enable-access-token-issuance",
                                    suggestions: [
                                        (
                                            name: "false",
                                        ),
                                        (
                                            name: "true",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--enable-id-token-issuance",
                            ],
                            description: Some("Specifies whether this web application can request an ID token using the OAuth 2.0 implicit flow"),
