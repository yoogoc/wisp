(
    version: 1,
    command: "serial-console",
    description: Some("Connect to the Serial Console of a Linux/Windows Virtual Machine or VMSS Instance"),
    subcommands: [
        (
            name: "connect",
            description: Some("Connect to Serial Console VM or VMSS Instance"),
            options: [
                (
                    names: [
                        "--name",
                        "-n",
                    ],
                    description: Some("Name of the Virtual Machine or Virtual Machine Scale Set"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--instance-id",
                    ],
                    description: Some("ID of VMSS instance. Not needed when connecting to the serialport of a Virtual Machine"),
                    arguments: [
                        (
                            name: "instance-id",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "disable",
            description: Some("Disable the serial console service for an entire subscription"),
        ),
        (
            name: "enable",
            description: Some("Enable the serial console service for an entire subscription"),
        ),
        (
            name: "send",
            description: Some("Send NMI/SysRq/Reset to a VM or VMSS Instance"),
            subcommands: [
                (
                    name: "nmi",
                    description: Some("Send a Non-Maskable Interrupt (NMI) to a VM or VMSS Instance"),
                    options: [
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("Name of the Virtual Machine or Virtual Machine Scale Set"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--resource-group",
                                "-g",
                            ],
                            description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                            arguments: [
                                (
                                    name: "resource-group",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--instance-id",
                            ],
                            description: Some("ID of VMSS instance. Not needed when connecting to the serialport of a Virtual Machine"),
                            arguments: [
                                (
                                    name: "instance-id",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "reset",
                    description: Some("Perform a \"hard\" restart of the VM or VMSS Instance"),
                    options: [
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("Name of the Virtual Machine or Virtual Machine Scale Set"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--resource-group",
                                "-g",
                            ],
                            description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                            arguments: [
                                (
                                    name: "resource-group",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--instance-id",
                            ],
                            description: Some("ID of VMSS instance. Not needed when connecting to the serialport of a Virtual Machine"),
                            arguments: [
                                (
                                    name: "instance-id",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "sysrq",
                    description: Some("Send SysRq sequence to a VM or VMSS Instance"),
                    options: [
                        (
                            names: [
                                "--input",
                            ],
                            description: Some("Input key to send over serial console. Must be one character"),
                            arguments: [
                                (
                                    name: "input",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("Name of the Virtual Machine or Virtual Machine Scale Set"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--resource-group",
                                "-g",
                            ],
                            description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                            arguments: [
                                (
                                    name: "resource-group",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--instance-id",
                            ],
                            description: Some("ID of VMSS instance. Not needed when connecting to the serialport of a Virtual Machine"),
                            arguments: [
                                (
                                    name: "instance-id",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
    ],
)
