(
    version: 1,
    command: "scenario",
    description: Some("E2E Scenario Usage Guidance"),
    subcommands: [
        (
            name: "guide",
            description: Some("Fuzzy search E2E scenario examples and execute them with walk-through"),
            options: [
                (
                    names: [
                        "--match-rule",
                    ],
                    description: Some("The matching rules for multi-keywords: \"and\" is to search scenarios that match all keywords, \"or\" is to search scenarios that match any keyword, \"all\" is to search scenarios that match all keywords first, if the number is not enough then search any keyword"),
                    arguments: [
                        (
                            name: "match-rule",
                            suggestions: [
                                (
                                    name: "all",
                                ),
                                (
                                    name: "and",
                                ),
                                (
                                    name: "or",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--scope",
                    ],
                    description: Some("The scope of search: \"scenario\" is to search whether the title and description in E2E scenario data contain keywords, \"command\" is to search whether the commands in E2E scenario data contain keywords, \"all\" is to search all contents"),
                    arguments: [
                        (
                            name: "scope",
                            suggestions: [
                                (
                                    name: "all",
                                ),
                                (
                                    name: "command",
                                ),
                                (
                                    name: "scenario",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--top",
                    ],
                    description: Some("Specify the number of results to return. The maximum value is limited to 20"),
                    arguments: [
                        (
                            name: "top",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "<SEARCH_KEYWORD>",
                    description: Some("Keywords for search. If there are multiple keywords, please separate them with spaces. Fuzzy search is supported, and the returned results are sorted by keyword matching degree"),
                    optional: true,
                ),
            ],
        ),
    ],
)
