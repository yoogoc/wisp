(
    version: 1,
    command: "quantum",
    description: Some("Manage Azure Quantum Workspaces and submit jobs to Azure Quantum Providers"),
    subcommands: [
        (
            name: "execute",
            description: Some("Submit a job to run on Azure Quantum, and waits for the result"),
            options: [
                (
                    names: [
                        "--location",
                        "-l",
                    ],
                    description: Some("Location. Values from: az account list-locations. You can configure the default location using az configure --defaults location=<location>"),
                    arguments: [
                        (
                            name: "location",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--target-id",
                        "-t",
                    ],
                    description: Some("Execution engine for quantum computing jobs. When a workspace is configured with a set of providers, they each enable one or more targets. You can configure the default target using az quantum target set"),
                    arguments: [
                        (
                            name: "target-id",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--workspace-name",
                        "-w",
                    ],
                    description: Some("Name of the Quantum Workspace. You can configure the default workspace using az quantum workspace set"),
                    arguments: [
                        (
                            name: "workspace-name",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--entry-point",
                    ],
                    description: Some("The entry point for the QIR program or circuit. Required for QIR. Ignored on Q# jobs"),
                    arguments: [
                        (
                            name: "entry-point",
                        ),
                    ],
                ),
                (
                    names: [
                        "--job-input-file",
                    ],
                    description: Some("The location of the input file to submit. Required for QIR, QIO, and pass-through jobs. Ignored on Q# jobs"),
                    arguments: [
                        (
                            name: "job-input-file",
                        ),
                    ],
                ),
                (
                    names: [
                        "--job-input-format",
                    ],
                    description: Some("The format of the file to submit. Omit this parameter on Q# jobs"),
                    arguments: [
                        (
                            name: "job-input-format",
                        ),
                    ],
                ),
                (
                    names: [
                        "--job-name",
                    ],
                    description: Some("A friendly name to give to this run of the program"),
                    arguments: [
                        (
                            name: "job-name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--job-output-format",
                    ],
                    description: Some("The expected job output format. Ignored on Q# jobs"),
                    arguments: [
                        (
                            name: "job-output-format",
                        ),
                    ],
                ),
                (
                    names: [
                        "--job-params",
                    ],
                    description: Some("Job parameters passed to the target as a list of key=value pairs, json string, or @{file} with json content"),
                    arguments: [
                        (
                            name: "job-params",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-build",
                    ],
                    description: Some("If specified, the Q# program is not built before submitting"),
                ),
                (
                    names: [
                        "--project",
                    ],
                    description: Some("The location of the Q# project to submit. Defaults to current folder"),
                    arguments: [
                        (
                            name: "project",
                        ),
                    ],
                ),
                (
                    names: [
                        "--shots",
                    ],
                    description: Some("The number of times to run the Q# program on the given target"),
