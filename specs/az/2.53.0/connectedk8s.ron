(
    version: 1,
    command: "connectedk8s",
    description: Some("Commands to manage connected kubernetes clusters"),
    subcommands: [
        (
            name: "connect",
            description: Some("Onboard a connected kubernetes cluster to azure"),
            options: [
                (
                    names: [
                        "--name",
                        "-n",
                    ],
                    description: Some("The name of the connected cluster"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
