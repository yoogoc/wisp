(
    version: 1,
    command: "keyvault",
    description: Some("Manage KeyVault keys, secrets, and certificates"),
    subcommands: [
        (
            name: "backup",
            description: Some("Manage full HSM backup"),
            subcommands: [
                (
                    name: "start",
                    description: Some("Begin a full backup of the HSM"),
                    options: [
                        (
                            names: [
                                "--storage-container-SAS-token",
                                "-t",
                            ],
                            description: Some("The SAS token pointing to an Azure Blob storage container"),
                            arguments: [
                                (
                                    name: "storage-container-SAS-token",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--blob-container-name",
                            ],
                            description: Some("Name of Blob Container"),
                            arguments: [
                                (
                                    name: "blob-container-name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--hsm-name",
                            ],
                            description: Some("Name of the HSM. Can be omitted if --id is specified"),
                            arguments: [
                                (
                                    name: "hsm-name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--id",
                            ],
                            description: Some("Full URI of the HSM"),
                            arguments: [
                                (
                                    name: "id",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--storage-account-name",
                            ],
                            description: Some("Name of Azure Storage Account"),
                            arguments: [
                                (
                                    name: "storage-account-name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--storage-resource-uri",
                            ],
                            description: Some("Azure Blob storage container Uri. If specified all other 'Storage Id' arguments should be omitted"),
                            arguments: [
                                (
                                    name: "storage-resource-uri",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "certificate",
            description: Some("Manage certificates"),
            subcommands: [
                (
                    name: "backup",
                    description: Some("Backs up the specified certificate"),
                    options: [
                        (
                            names: [
                                "--file",
                                "-f",
                            ],
                            description: Some("Local file path in which to store certificate backup"),
                            arguments: [
                                (
                                    name: "file",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--id",
                            ],
                            description: Some("Id of the certificate. If specified all other 'Id' arguments should be omitted"),
                            arguments: [
                                (
                                    name: "id",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("Name of the certificate. Required if --id is not specified"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--vault-name",
                            ],
                            description: Some("Name of the Key Vault. Required if --id is not specified"),
                            arguments: [
                                (
                                    name: "vault-name",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "create",
                    description: Some("Create a Key Vault certificate"),
                    options: [
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("Name of the certificate"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--policy",
                                "-p",
                            ],
                            description: Some("JSON encoded policy definition. Use @{file} to load from a file(e.g. @my_policy.json)"),
                            arguments: [
                                (
                                    name: "policy",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--vault-name",
                            ],
                            description: Some("Name of the Vault"),
                            arguments: [
                                (
                                    name: "vault-name",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--disabled",
                            ],
                            description: Some("Create certificate in disabled state"),
                            arguments: [
                                (
                                    name: "disabled",
                                    suggestions: [
                                        (
                                            name: "false",
                                        ),
                                        (
                                            name: "true",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--tags",
                            ],
                            description: Some("Space-separated tags: key[=value] [key[=value] ...]. Use \"\" to clear existing tags"),
