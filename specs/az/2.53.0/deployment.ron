                        (
                            name: "name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-prompt",
                    ],
                    description: Some("The option to disable the prompt of missing parameters for ARM template. When the value is true, the prompt requiring users to provide missing parameter will be ignored. The default value is false"),
                ),
                (
                    names: [
                        "--no-wait",
                    ],
                    description: Some("Do not wait for the long-running operation to finish"),
                ),
                (
                    names: [
                        "--parameters",
                        "-p",
                    ],
                    description: Some("Supply deployment parameter values"),
                    arguments: [
                        (
                            name: "parameters",
                        ),
                    ],
                ),
                (
                    names: [
                        "--proceed-if-no-change",
                    ],
