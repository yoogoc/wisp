(
    version: 1,
    command: "deployment",
    description: Some("Manage Azure Resource Manager template deployment at subscription scope"),
    subcommands: [
        (
            name: "cancel",
            description: Some("Cancel a deployment at subscription scope"),
            options: [
                (
                    names: [
                        "--name",
                        "-n",
                    ],
                    description: Some("The deployment name"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                    required: true,
                ),
            ],
        ),
        (
            name: "create",
            description: Some("Start a deployment at subscription scope"),
