                (
                    names: [
                        "--location",
                        "-l",
                    ],
                    description: Some("The location to store the deployment metadata"),
                    arguments: [
                        (
                            name: "location",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--confirm-with-what-if",
                        "-c",
                    ],
                    description: Some("Instruct the command to run deployment What-If before executing the deployment. It then prompts you to acknowledge resource changes before it continues"),
                    arguments: [
                        (
                            name: "confirm-with-what-if",
                        ),
                    ],
                ),
                (
                    names: [
                        "--handle-extended-json-format",
                        "-j",
                    ],
