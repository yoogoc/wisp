                        (
                            name: "proceed-if-no-change",
                        ),
                    ],
                ),
                (
                    names: [
                        "--query-string",
                        "-q",
                    ],
                    description: Some("The query string (a SAS token) to be used with the template-uri in the case of linked templates"),
                    arguments: [
                        (
                            name: "query-string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--template-file",
                        "-f",
                    ],
