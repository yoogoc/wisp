(
    version: 1,
    command: "deployment-scripts",
    description: Some("Manage deployment scripts at subscription or resource group scope"),
    subcommands: [
        (
            name: "delete",
            description: Some("Delete a deployment script"),
            options: [
                (
                    names: [
                        "--name",
                    ],
                    description: Some("Deployment script resource name"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--yes",
                        "-y",
                    ],
                    description: Some("Do not prompt for confirmation"),
                ),
            ],
        ),
        (
            name: "list",
            description: Some("List all deployment scripts"),
            options: [
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "show",
            description: Some("Retrieve a deployment script"),
            options: [
                (
                    names: [
                        "--name",
                    ],
                    description: Some("Deployment script resource name"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                    required: true,
                ),
            ],
        ),
        (
            name: "show-log",
            description: Some("Show deployment script logs"),
            options: [
                (
                    names: [
                        "--name",
                    ],
                    description: Some("Deployment script resource name"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--resource-group",
                        "-g",
                    ],
                    description: Some("Name of resource group. You can configure the default group using az configure --defaults group=<name>"),
                    arguments: [
                        (
                            name: "resource-group",
                        ),
                    ],
                    required: true,
                ),
            ],
        ),
    ],
)
