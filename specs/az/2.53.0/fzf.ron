(
    version: 1,
    command: "fzf",
    description: Some("Commands to select active or default objects via fzf.\n\n\t\tSelect your active subscription or set defaults with an easy selection interface (fzf).\nSearch syntax:\nToken    Match type                  Description\n\nsbtrkt   fuzzy-match                 Items that match sbtrkt\n'wild    exact-match (quoted)        Items that include wild\n^music   prefix-exact-match          Items that start with music\n.mp3$    suffix-exact-match          Items that end with .mp3\n!fire    inverse-exact-match         Items that do not include fire\n!^music  inverse-prefix-exact-match  Items that do not start with music\n!.mp3$   inverse-suffix-exact-match  Items that do not end with .mp3\nMore information about search syntax or fzf in general can be found on the fzf project page: https://github.com/junegunn/fzf#search-syntax"),
    subcommands: [
        (
            name: "group",
            description: Some("Select default resource group"),
            options: [
                (
                    names: [
                        "--filter",
                        "-f",
                    ],
                    description: Some("A filter string to pass to fzf"),
                    arguments: [
                        (
                            name: "filter",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-default",
                        "-d",
                    ],
                    description: Some("Don't change the active or default, just return selected item"),
                ),
            ],
        ),
        (
            name: "install",
            description: Some("Download and install the fzf command"),
            options: [
                (
                    names: [
                        "--install-dir",
                        "-i",
                    ],
                    description: Some("Path to the directory where fzf should be installed"),
                    arguments: [
                        (
                            name: "install-dir",
                        ),
                    ],
                ),
                (
                    names: [
                        "--version",
                        "-v",
                    ],
                    description: Some("Version of fzf to install"),
                    arguments: [
                        (
                            name: "version",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "location",
            description: Some("Select default location"),
            options: [
                (
                    names: [
                        "--filter",
                        "-f",
                    ],
                    description: Some("A filter string to pass to fzf"),
                    arguments: [
                        (
                            name: "filter",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-default",
                        "-d",
                    ],
                    description: Some("Don't change the active or default, just return selected item"),
                ),
            ],
        ),
        (
            name: "subscription",
            description: Some("Select default subscription"),
            options: [
                (
                    names: [
                        "--filter",
                        "-f",
                    ],
                    description: Some("A filter string to pass to fzf"),
                    arguments: [
                        (
                            name: "filter",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-default",
                        "-d",
                    ],
                    description: Some("Don't change the active or default, just return selected item"),
                ),
            ],
        ),
    ],
)
