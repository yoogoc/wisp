(
    version: 1,
    command: "rm",
    description: Some("Remove directory entries"),
    options: [
        (
            names: [
                "-r",
                "-R",
            ],
            description: Some("Recursive. Attempt to remove the file hierarchy rooted in each file argument"),
            presentation: (
                dangerous: true,
            ),
        ),
        (
            names: [
                "-P",
            ],
            description: Some("Overwrite regular files before deleting them"),
            presentation: (
                dangerous: true,
            ),
        ),
        (
            names: [
                "-d",
            ],
            description: Some("Attempt to remove directories as well as other types of files"),
        ),
        (
            names: [
                "-f",
            ],
            description: Some("⚠️ Attempt to remove the files without prompting for confirmation"),
            presentation: (
                dangerous: true,
            ),
        ),
        (
            names: [
                "-i",
            ],
            description: Some("Request confirmation before attempting to remove each file"),
        ),
        (
            names: [
                "-v",
            ],
            description: Some("Be verbose when deleting files"),
        ),
    ],
    arguments: [
        (
            name: "",
            template: [
                Folders,
                FilePaths,
            ],
            variadic: true,
        ),
    ],
)
