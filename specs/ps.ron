            ],
        ),
        (
            names: [
                "--sort",
            ],
            description: Some("Specify sorting order"),
            arguments: [
                (
                    name: "spec",
                ),
            ],
        ),
        (
            names: [
                "--width",
            ],
            description: Some("Set screen width"),
            arguments: [
                (
                    name: "n",
                ),
            ],
        ),
        (
            names: [
                "-L",
            ],
            description: Some("Show threads, possibly with LWP and NLWP columns"),
        ),
        (
            names: [
                "-T",
            ],
            description: Some("Show threads, possibly with SPID column"),
        ),
        (
            names: [
                "--help",
            ],
            description: Some("Print a help message"),
        ),
        (
            names: [
                "--info",
            ],
            description: Some("Print debugging info"),
