(
    version: 1,
    command: "cot",
    description: Some("Command-line utility for CotEditor"),
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Show help message and exit"),
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Show program's version number and exit"),
        ),
        (
            names: [
                "-w",
                "--wait",
            ],
            description: Some("Wait for opened file to be closed"),
        ),
        (
            names: [
                "-g",
                "--background",
            ],
            description: Some("Do not bring the application to the foreground"),
        ),
        (
            names: [
                "-n",
                "--new",
            ],
            description: Some("Create a new blank document"),
        ),
        (
            names: [
                "-l",
                "--line",
            ],
            description: Some("Jump to specific line in opened document"),
            arguments: [
                (
                    name: "line",
                ),
            ],
        ),
        (
            names: [
                "-c",
                "--column",
            ],
            description: Some("Jump to specific column in opened document"),
            arguments: [
                (
                    name: "column",
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "",
            template: [
                FilePaths,
            ],
        ),
    ],
    presentation: (
        icon: Some("https://coteditor.com/favicon@2x.png"),
    ),
)
