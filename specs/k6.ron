(
    version: 1,
    command: "k6",
    description: Some("Grafana k6 is an open-source load testing tool that makes performance testing easy"),
    subcommands: [
        (
            name: "archive",
            description: Some("Create an archive"),
            arguments: [
                (
                    name: "archive",
                    description: Some("Name of a file to archive"),
                ),
            ],
        ),
        (
            name: "cloud",
            description: Some("Run a test on the cloud"),
            arguments: [
                (
                    name: "cloud",
                    description: Some("Name of a script to run"),
                ),
            ],
        ),
        (
            name: "completion",
            description: Some("Generate the autocompletion script for the specified shell"),
