                        (
                            name: "batch",
                            description: Some("Max parallel batch reqs (default 20)"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--batch-per-host",
                    ],
                    description: Some("Max parallel batch reqs per host (default 6)"),
