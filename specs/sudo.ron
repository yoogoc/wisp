(
    version: 1,
    command: "sudo",
    description: Some("Execute a command as the superuser or another user"),
    options: [
        (
            names: [
                "-g",
                "--group",
            ],
            description: Some("Run command as the specified group name or ID"),
            arguments: [
                (
                    name: "group",
                    description: Some("Group name or ID"),
                ),
            ],
        ),
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Display help message and exit"),
        ),
        (
            names: [
                "-u",
                "--user",
            ],
            description: Some("Run command as specified user name or ID"),
            arguments: [
                (
                    name: "user",
                    description: Some("User name or ID"),
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "command",
            description: Some("Command to run with elevated permissions"),
            is_command: true,
        ),
    ],
)
