(
    version: 1,
    command: "login",
    description: Some("Begin session on the system"),
    options: [
        (
            names: [
                "-p",
            ],
            description: Some("Preserve environment"),
        ),
        (
            names: [
                "-r",
            ],
            description: Some("Perform autologin protocol for rlogin"),
        ),
        (
            names: [
                "-h",
            ],
            description: Some("Specify host"),
            arguments: [
                (
                    name: "host",
                ),
            ],
        ),
        (
            names: [
                "-f",
            ],
            description: Some("Don't authenticate user, user is preauthenticated"),
        ),
    ],
    arguments: [
        (
            name: "username",
            generators: [
                (
                    script: [
                        "cat",
                        "/etc/passwd",
                    ],
                    has_post_process: true,
                ),
            ],
        ),
    ],
)
