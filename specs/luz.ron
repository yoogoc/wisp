(
    version: 1,
    command: "luz",
    description: Some("A next-generation build system for Apple Darwin-based systems"),
    subcommands: [
        (
            name: "build",
            description: Some("Build the target in the current directory"),
            options: [
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Show help for the build command"),
                ),
                (
                    names: [
                        "--clean",
                        "-c",
                    ],
                    description: Some("Clean the build directory before building"),
                ),
            ],
        ),
        (
            name: "gen",
            description: Some("Generate a new project"),
            options: [
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Show help for the gen command"),
                ),
                (
                    names: [
                        "--type",
                        "-t",
                    ],
                    description: Some("The type of project to generate"),
                    arguments: [
                        (
                            name: "type",
                            suggestions: [
                                (
                                    name: "tool",
                                    description: Some("A command-line tool"),
                                    presentation: (
                                        icon: Some("💻"),
                                    ),
                                ),
                                (
                                    name: "tweak",
                                    description: Some("A tweak"),
                                    presentation: (
                                        icon: Some("🛠"),
                                    ),
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for Luz"),
        ),
    ],
)
