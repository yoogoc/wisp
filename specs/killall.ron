(
    version: 1,
    command: "killall",
    description: Some("Kill processes by name"),
    options: [
        (
            names: [
                "-d",
            ],
            description: Some("Be verbose (dry run) and display number of user processes"),
        ),
        (
            names: [
                "-e",
            ],
            description: Some("Use the effective user ID instead of the real user ID for matching processes with -u"),
        ),
        (
            names: [
                "-help",
            ],
            description: Some("Display help and exit"),
        ),
        (
            names: [
                "-I",
            ],
            description: Some("Request confirmation before killing each process"),
        ),
        (
            names: [
                "-l",
            ],
            description: Some("List the names of the available signals and exit"),
        ),
        (
            names: [
                "-m",
            ],
            description: Some("Match the process name as a regular expression"),
        ),
        (
            names: [
                "-v",
            ],
            description: Some("Be verbose"),
        ),
        (
            names: [
                "-s",
            ],
            description: Some("Be verbose (dry run)"),
        ),
        (
            names: [
                "-SIGHUP",
            ],
            description: Some("Send HUP instead of TERM"),
        ),
        (
            names: [
                "-SIGINT",
            ],
            description: Some("Send INT instead of TERM"),
        ),
        (
            names: [
                "-SIGQUIT",
            ],
            description: Some("Send QUIT instead of TERM"),
        ),
        (
            names: [
                "-SIGILL",
            ],
            description: Some("Send ILL instead of TERM"),
        ),
        (
            names: [
                "-SIGTRAP",
            ],
            description: Some("Send TRAP instead of TERM"),
        ),
        (
            names: [
                "-SIGABRT",
            ],
            description: Some("Send ABRT instead of TERM"),
        ),
        (
            names: [
                "-SIGEMT",
            ],
            description: Some("Send EMT instead of TERM"),
        ),
        (
            names: [
                "-SIGFPE",
            ],
            description: Some("Send FPE instead of TERM"),
        ),
        (
            names: [
                "-SIGKILL",
            ],
            description: Some("Send KILL instead of TERM"),
        ),
        (
            names: [
                "-SIGBUS",
            ],
            description: Some("Send BUS instead of TERM"),
        ),
        (
            names: [
                "-SIGSEGV",
            ],
            description: Some("Send SEGV instead of TERM"),
        ),
        (
            names: [
                "-SIGSYS",
            ],
            description: Some("Send SYS instead of TERM"),
        ),
        (
            names: [
                "-SIGPIPE",
            ],
            description: Some("Send PIPE instead of TERM"),
        ),
        (
            names: [
                "-SIGALRM",
            ],
            description: Some("Send ALRM instead of TERM"),
        ),
        (
            names: [
                "-SIGURG",
            ],
            description: Some("Send URG instead of TERM"),
        ),
        (
            names: [
                "-SIGSTOP",
            ],
            description: Some("Send STOP instead of TERM"),
        ),
        (
            names: [
                "-SIGTSTP",
            ],
            description: Some("Send TSTP instead of TERM"),
        ),
        (
            names: [
                "-SIGCONT",
            ],
            description: Some("Send CONT instead of TERM"),
        ),
        (
            names: [
                "-SIGCHLD",
            ],
            description: Some("Send CHLD instead of TERM"),
        ),
        (
            names: [
                "-SIGTTIN",
            ],
            description: Some("Send TTIN instead of TERM"),
        ),
        (
            names: [
                "-SIGTTOU",
            ],
            description: Some("Send TTOU instead of TERM"),
        ),
        (
            names: [
                "-SIGIO",
            ],
            description: Some("Send IO instead of TERM"),
        ),
        (
            names: [
                "-SIGXCPU",
            ],
            description: Some("Send XCPU instead of TERM"),
        ),
        (
            names: [
                "-SIGXFSZ",
            ],
            description: Some("Send XFSZ instead of TERM"),
        ),
        (
            names: [
                "-SIGVTALRM",
            ],
            description: Some("Send VTALRM instead of TERM"),
        ),
        (
            names: [
                "-SIGPROF",
            ],
            description: Some("Send PROF instead of TERM"),
        ),
        (
            names: [
                "-SIGWINCH",
            ],
            description: Some("Send WINCH instead of TERM"),
        ),
        (
            names: [
                "-SIGINFO",
            ],
            description: Some("Send INFO instead of TERM"),
        ),
        (
            names: [
                "-SIGUSR1",
            ],
            description: Some("Send USR1 instead of TERM"),
        ),
        (
            names: [
                "-SIGUSR2",
            ],
            description: Some("Send USR2 instead of TERM"),
        ),
        (
            names: [
                "-u",
            ],
            description: Some("Limit potentially matching processes to those belonging to the user"),
            arguments: [
                (
                    name: "user",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "dscl . -list /Users | grep -v '^_'",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-t",
            ],
            description: Some("Limit matching processes to those running on the specified TTY"),
            arguments: [
                (
                    name: "tty",
                ),
            ],
        ),
        (
            names: [
                "-c",
            ],
            description: Some("Limit matching processes to those matching the given name"),
            arguments: [
                (
                    name: "name",
                ),
            ],
        ),
        (
            names: [
                "-q",
            ],
            description: Some("Suppress error message if no processes are matched"),
        ),
        (
            names: [
                "-z",
            ],
            description: Some("Do not skip zombies"),
        ),
    ],
    arguments: [
        (
            name: "process_name",
            generators: [
                (
                    script: [
                        "bash",
                        "-c",
                        "ps -A -o comm | sort -u",
                    ],
                    has_post_process: true,
                ),
            ],
            variadic: true,
        ),
    ],
)
