(
    version: 1,
    command: "ipatool",
    description: Some("IPATool is a command line tool that allows you to search for iOS apps on the App Store and download a copy of the app package, known as an ipa file"),
    subcommands: [
        (
            name: "auth",
            description: Some("Authenticate with the App Store"),
            subcommands: [
                (
                    name: "info",
                    description: Some("Show current account info"),
                ),
                (
                    name: "login",
                    description: Some("Login to the App Store"),
                    options: [
                        (
                            names: [
                                "--auth-code",
                            ],
                            description: Some("2FA code for the Apple ID"),
                            arguments: [
                                (
                                    name: "2FA code",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-e",
                                "--email",
                            ],
                            description: Some("Apple ID email address"),
                            required: true,
                        ),
                        (
                            names: [
                                "-p",
                                "--password",
                            ],
                            description: Some("Apple ID password"),
                            required: true,
                        ),
                    ],
                ),
                (
                    name: "revoke",
                    description: Some("Revoke your App Store credentials"),
                ),
            ],
        ),
        (
            name: "completion",
            description: Some("Generate shell completion script"),
            subcommands: [
                (
                    name: "bash",
                    description: Some("Generate the autocompletion script for bash"),
                ),
                (
                    name: "fish",
                    description: Some("Generate the autocompletion script for fish"),
                ),
                (
                    name: "powershell",
                    description: Some("Generate the autocompletion script for powershell"),
                ),
                (
                    name: "zsh",
                    description: Some("Generate the autocompletion script for zsh"),
                ),
            ],
        ),
        (
            name: "download",
            description: Some("Download (encrypted) iOS app packages from the App Store"),
            options: [
                (
                    names: [
                        "-b",
                        "--bundle-identifier",
                    ],
                    description: Some("Bundle identifier of the app"),
                    arguments: [
                        (
                            name: "identifier",
                            generators: [
                                (
                                    has_dynamic_script: true,
                                    has_post_process: true,
                                ),
                            ],
                            filter_strategy: Fuzzy,
                            debounce: true,
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "-o",
                        "--output",
                    ],
                    description: Some("The destination path of the downloaded app package"),
                    arguments: [
                        (
                            name: "output path",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--purchase",
                    ],
                    description: Some("Obtain a license for the app if needed"),
                ),
            ],
        ),
        (
            name: "help",
            description: Some("Display help for command"),
            arguments: [
                (
                    name: "command",
                    template: [
                        Help,
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "purchase",
            description: Some("Obtain a license for the app from the App Store"),
            options: [
                (
                    names: [
                        "-b",
                        "--bundle-identifier",
                    ],
                    description: Some("Bundle identifier of the app"),
                    arguments: [
                        (
                            name: "identifier",
                            generators: [
                                (
                                    has_dynamic_script: true,
                                    has_post_process: true,
                                ),
                            ],
                            filter_strategy: Fuzzy,
                            debounce: true,
                        ),
                    ],
                    required: true,
                ),
            ],
        ),
        (
            name: "search",
            description: Some("Search for iOS apps available on the App Store"),
            options: [
                (
                    names: [
                        "-l",
                        "--limit",
                    ],
                    description: Some("Limit the number of results"),
                    arguments: [
                        (
                            name: "limit",
                            default: Some("5"),
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "query",
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Show help for ipatool"),
            persistent: true,
        ),
        (
            names: [
                "--non-interactive",
            ],
            description: Some("Run in non-interactive session"),
            persistent: true,
        ),
        (
            names: [
                "--verbose",
            ],
            description: Some("Enables verbose logs"),
            persistent: true,
        ),
        (
            names: [
                "--format",
            ],
            description: Some("Output format"),
            arguments: [
                (
                    name: "format",
                    suggestions: [
                        (
                            name: "text",
                        ),
                        (
                            name: "json",
                        ),
                    ],
                    default: Some("text"),
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Show version for ipatool"),
        ),
    ],
    presentation: (
        display_name: Some("IPATool"),
    ),
)
