(
    version: 1,
    command: "screen",
    description: Some("Screen manager with VT100/ANSI terminal emulation"),
    subcommands: [
        (
            name: "-d",
            description: Some("Does not start screen, but detaches the elsewhere running screen session"),
            subcommands: [
                (
                    name: "-r",
                    description: Some("Reattach a session and if necessary detach it first"),
                    arguments: [
                        (
                            name: "identifier",
                            suggestions: [
                                (
                                    name: "pid",
                                ),
                                (
                                    name: "pid.tty",
                                ),
                                (
                                    name: "pid.tty.host",
                                ),
                                (
                                    name: "sessionowner/pid",
                                ),
                                (
                                    name: "sessionowner/pid.tty",
                                ),
                                (
                                    name: "sessionowner/pid.tty.host",
                                ),
                            ],
                        ),
                    ],
                    presentation: (
                        icon: Some("fig://icon?type=option"),
                    ),
                ),
                (
                    name: "-R",
                    description: Some("Reattach a session and if necessary detach or even create it first"),
                    arguments: [
                        (
                            name: "identifier",
                            suggestions: [
                                (
                                    name: "pid",
                                ),
                                (
                                    name: "pid.tty",
                                ),
                                (
                                    name: "pid.tty.host",
                                ),
                                (
                                    name: "sessionowner/pid",
                                ),
                                (
                                    name: "sessionowner/pid.tty",
                                ),
                                (
                                    name: "sessionowner/pid.tty.host",
                                ),
                            ],
                        ),
                    ],
                    presentation: (
                        icon: Some("fig://icon?type=option"),
                    ),
                ),
                (
                    name: "-RR",
                    description: Some("Reattach a session and if necessary detach or create it. Use the first session if more than one session is available"),
                    arguments: [
                        (
                            name: "identifier",
                            suggestions: [
                                (
                                    name: "pid",
                                ),
                                (
                                    name: "pid.tty",
                                ),
                                (
                                    name: "pid.tty.host",
                                ),
                                (
                                    name: "sessionowner/pid",
                                ),
                                (
                                    name: "sessionowner/pid.tty",
                                ),
                                (
                                    name: "sessionowner/pid.tty.host",
                                ),
                            ],
                        ),
                    ],
                    presentation: (
                        icon: Some("fig://icon?type=option"),
                    ),
                ),
            ],
            presentation: (
                icon: Some("fig://icon?type=option"),
            ),
        ),
        (
            name: "-D",
            description: Some("Does not start screen, but detaches the elsewhere running screen session"),
            subcommands: [
                (
                    name: "-r",
                    description: Some("Reattach a session. If necessary detach and logout remotely first"),
                    arguments: [
                        (
                            name: "identifier",
                            suggestions: [
                                (
                                    name: "pid",
                                ),
                                (
                                    name: "pid.tty",
                                ),
                                (
                                    name: "pid.tty.host",
                                ),
                                (
                                    name: "sessionowner/pid",
                                ),
                                (
                                    name: "sessionowner/pid.tty",
                                ),
                                (
                                    name: "sessionowner/pid.tty.host",
                                ),
                            ],
                        ),
                    ],
                    presentation: (
                        icon: Some("fig://icon?type=option"),
                    ),
                ),
                (
                    name: "-R",
                    description: Some("Attach here and now. In detail this means: If a session is running, then reattach. If necessary detach and logout remotely first"),
                    arguments: [
                        (
                            name: "identifier",
                            suggestions: [
                                (
                                    name: "pid",
                                ),
                                (
                                    name: "pid.tty",
                                ),
                                (
                                    name: "pid.tty.host",
                                ),
                                (
                                    name: "sessionowner/pid",
                                ),
                                (
                                    name: "sessionowner/pid.tty",
                                ),
                                (
                                    name: "sessionowner/pid.tty.host",
                                ),
                            ],
                        ),
                    ],
                    presentation: (
                        icon: Some("fig://icon?type=option"),
                    ),
                ),
                (
                    name: "-RR",
                    description: Some("Attach here and now. Whatever that means, just do it"),
                    arguments: [
                        (
                            name: "identifier",
                            suggestions: [
                                (
                                    name: "pid",
                                ),
                                (
                                    name: "pid.tty",
                                ),
                                (
                                    name: "pid.tty.host",
                                ),
                                (
                                    name: "sessionowner/pid",
                                ),
                                (
                                    name: "sessionowner/pid.tty",
                                ),
                                (
                                    name: "sessionowner/pid.tty.host",
                                ),
                            ],
                        ),
                    ],
                    presentation: (
                        icon: Some("fig://icon?type=option"),
                    ),
                ),
            ],
            presentation: (
                icon: Some("fig://icon?type=option"),
            ),
        ),
        (
            name: "-r",
            description: Some("Resumes a detached screen session"),
            arguments: [
                (
                    name: "identifier",
                    suggestions: [
                        (
                            name: "pid",
                        ),
                        (
                            name: "pid.tty",
                        ),
                        (
                            name: "pid.tty.host",
                        ),
                        (
                            name: "sessionowner/pid",
                        ),
                        (
                            name: "sessionowner/pid.tty",
                        ),
                        (
                            name: "sessionowner/pid.tty.host",
                        ),
                    ],
                ),
            ],
            presentation: (
                icon: Some("fig://icon?type=option"),
            ),
        ),
        (
            name: "-R",
            description: Some("Attempts to resume the first detached screen session it finds"),
            arguments: [
                (
                    name: "identifier",
                    suggestions: [
                        (
                            name: "pid",
                        ),
                        (
                            name: "pid.tty",
                        ),
                        (
                            name: "pid.tty.host",
                        ),
                        (
                            name: "sessionowner/pid",
                        ),
                        (
                            name: "sessionowner/pid.tty",
                        ),
                        (
                            name: "sessionowner/pid.tty.host",
                        ),
                    ],
                ),
            ],
            presentation: (
                icon: Some("fig://icon?type=option"),
            ),
        ),
        (
            name: "-dmS",
            description: Some("Start as daemon: Screen session in detached mode"),
            arguments: [
                (
                    name: "name",
                    description: Some("Name of the screen session"),
                ),
            ],
            presentation: (
                icon: Some("fig://icon?type=option"),
            ),
        ),
    ],
    options: [
        (
            names: [
                "-a",
            ],
            description: Some("Force all capabilities into each window's termcap"),
        ),
        (
            names: [
                "-A",
            ],
            description: Some("Adapt all windows to the new display width & height"),
        ),
        (
            names: [
                "-c",
            ],
            description: Some("Read configuration file instead of '.screenrc'"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-e",
            ],
            description: Some("Change command characters"),
            arguments: [
                (
                    name: "xy",
                    description: Some("Specifies the command character to be x and the character generating a literal command character to y"),
                ),
            ],
        ),
        (
            names: [
                "-f",
            ],
            description: Some("Flow control on"),
        ),
        (
            names: [
                "-fn",
            ],
            description: Some("Flow control off"),
        ),
        (
            names: [
                "-fa",
            ],
            description: Some("Flow control automatic"),
        ),
        (
            names: [
                "-h",
            ],
            description: Some("Set the size of the scrollback history buffer"),
            arguments: [
                (
                    name: "h",
                    description: Some("Lines"),
                ),
            ],
        ),
        (
            names: [
                "-i",
            ],
            description: Some("Interrupt output sooner when flow control is on"),
        ),
        (
            names: [
                "-list",
                "-ls",
            ],
            description: Some("Do nothing, just list our SockDir"),
        ),
        (
            names: [
                "-L",
            ],
            description: Some("Turn on output logging"),
        ),
        (
            names: [
                "-m",
            ],
            description: Some("Ignore $STY variable, do create a new screen session"),
        ),
        (
            names: [
                "-O",
            ],
            description: Some("Choose optimal output rather than exact vt100 emulation"),
        ),
        (
            names: [
                "-p",
            ],
            description: Some("Preselect the named window if it exists"),
            arguments: [
                (
                    name: "window",
                ),
            ],
        ),
        (
            names: [
                "-q",
            ],
            description: Some("Quiet startup. Exits with non-zero return code if unsuccessful"),
        ),
        (
            names: [
                "-s",
            ],
            description: Some("Shell to execute rather than $SHELL"),
            arguments: [
                (
                    name: "shell",
                ),
            ],
        ),
        (
            names: [
                "-S",
            ],
            description: Some("Name this session <pid>.sockname instead of <pid>.<tty>.<host>"),
            arguments: [
                (
                    name: "sockname",
                ),
            ],
        ),
        (
            names: [
                "-t",
            ],
            description: Some("Set title. (window's name)"),
            arguments: [
                (
                    name: "title",
                ),
            ],
        ),
        (
            names: [
                "-T",
            ],
            description: Some("Use term as $TERM for windows, rather than 'screen'"),
            arguments: [
                (
                    name: "term",
                ),
            ],
        ),
        (
            names: [
                "-U",
            ],
            description: Some("Tell screen to use UTF-8 encoding"),
        ),
        (
            names: [
                "-v",
            ],
            description: Some("Print 'Screen version 4.00.03 (FAU) 23-Oct-06'"),
        ),
        (
            names: [
                "-wipe",
            ],
            description: Some("Do nothing, just clean up SockDir"),
            arguments: [
                (
                    name: "match",
                    description: Some("Screen session to match"),
                    suggestions: [
                        (
                            name: "sessionowner/[pid.tty.host]",
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            names: [
                "-x",
            ],
            description: Some("Attach to a not detached screen. (Multi display mode)"),
        ),
        (
            names: [
                "-X",
            ],
            description: Some("Execute <cmd> as a screen command in the specified session"),
        ),
    ],
    arguments: [
        (
            name: "cmd",
            description: Some("Command to invoke"),
        ),
        (
            name: "args",
            description: Some("Arguments to pass"),
            variadic: true,
        ),
    ],
    parser_directives: Some((
        flags_are_posix_noncompliant: true,
        options_must_precede_arguments: true,
    )),
)
