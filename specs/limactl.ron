                        ),
                        (
                            names: [
                                "--no-descriptions",
                            ],
                            description: Some("Disable completion descriptions"),
                        ),
                    ],
                ),
                (
                    name: "zsh",
                    description: Some("Generate the autocompletion script for zsh"),
                    options: [
                        (
                            names: [
                                "-h",
                                "--help",
                            ],
                            description: Some("Help for zsh"),
                        ),
                        (
                            names: [
                                "--debug",
                            ],
                            description: Some("Debug mode"),
                        ),
                        (
                            names: [
                                "--no-descriptions",
                            ],
                            description: Some("Disable completion descriptions"),
                        ),
                    ],
                ),
            ],
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Help for completion"),
                ),
                (
                    names: [
                        "--debug",
                    ],
                    description: Some("Debug mode"),
                ),
            ],
        ),
        (
            name: "copy",
            aliases: [
                "cp",
            ],
            description: Some("Copy files between host and guest"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Help for copy"),
                ),
                (
                    names: [
                        "--debug",
                    ],
                    description: Some("Debug mode"),
                ),
                (
                    names: [
                        "-r",
                        "--recursive",
                    ],
                    description: Some("Copy directories recursively"),
                ),
            ],
            arguments: [
                (
                    name: "SOURCE",
                    generators: [
                        (
                            script: [
                                "limactl",
                                "list",
                                "--quiet",
                            ],
                            has_post_process: true,
                        ),
                        (
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                    variadic: true,
                ),
                (
                    name: "TARGET",
                    generators: [
                        (
                            script: [
                                "limactl",
                                "list",
                                "--quiet",
                            ],
                            has_post_process: true,
                        ),
                        (
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "delete",
            aliases: [
                "remove",
                "rm",
            ],
            description: Some("Delete an instance of Lima"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Help for delete"),
                ),
                (
                    names: [
                        "--debug",
                    ],
                    description: Some("Debug mode"),
                ),
                (
                    names: [
                        "-f",
                        "--force",
                    ],
                    description: Some("Forcibly kill the processes"),
                    presentation: (
                        dangerous: true,
                    ),
                ),
            ],
            arguments: [
                (
                    name: "INSTANCE",
                    generators: [
                        (
                            script: [
                                "limactl",
                                "list",
                                "--quiet",
                            ],
                            has_post_process: true,
                        ),
