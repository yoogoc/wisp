                ),
                (
                    names: [
                        "--debug",
                    ],
                    description: Some("Debug mode"),
                ),
                (
                    names: [
                        "--json",
                    ],
                    description: Some("JSONify output"),
                ),
                (
                    names: [
                        "-q",
                        "--quiet",
                    ],
                    description: Some("Only show names"),
                ),
            ],
        ),
        (
            name: "prune",
            description: Some("Prune garbage objects"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Help for prune"),
                ),
                (
                    names: [
                        "--debug",
                    ],
                    description: Some("Debug mode"),
                ),
            ],
            presentation: (
                dangerous: true,
            ),
        ),
        (
            name: "shell",
            description: Some("Lima command is provided as an alias for limactl shell $LIMA_INSTANCE. $LIMA_INSTANCE defaults to \"default\""),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Help for shell"),
                ),
                (
                    names: [
                        "--debug",
                    ],
                    description: Some("Debug mode"),
                ),
                (
                    names: [
                        "--workdir",
                    ],
                    description: Some("Working directory"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "INSTANCE",
                    generators: [
                        (
                            script: [
                                "limactl",
                                "list",
                                "--quiet",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
                (
                    name: "COMMAND",
                    optional: true,
                    variadic: true,
                    is_command: true,
                ),
            ],
        ),
        (
            name: "show-ssh",
            description: Some("Show the ssh command line"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Help for show-ssh"),
                ),
                (
                    names: [
                        "--debug",
                    ],
                    description: Some("Debug mode"),
                ),
                (
                    names: [
                        "-f",
                        "--format",
                    ],
                    description: Some("Format: cmd, args, options, config (default \"cmd\")"),
                    arguments: [
                        (
                            name: "string",
                            suggestions: [
                                (
                                    name: "cmd",
                                    description: Some("Full ssh command line"),
                                ),
                                (
                                    name: "args",
                                    description: Some("Similar to the cmd format but omits \"ssh\" and the destination address"),
                                ),
                                (
                                    name: "options",
                                    description: Some("Ssh option key value pairs"),
                                ),
                                (
                                    name: "config",
                                    description: Some("~/.ssh/config format"),
                                ),
                            ],
                            default: Some("cmd"),
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "INSTANCE",
                    generators: [
                        (
                            script: [
                                "limactl",
                                "list",
                                "--quiet",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "start",
            description: Some("Start an instance of Lima. If the instance does not exist, open an editor for creating new one, with name \"default\""),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Help for start"),
                ),
                (
                    names: [
                        "--debug",
                    ],
                    description: Some("Debug mode"),
                ),
                (
                    names: [
                        "--tty",
                    ],
                    description: Some("Enable TUI interactions such as opening an editor, defaults to true when stdout is a terminal (default true)"),
                ),
            ],
            arguments: [
                (
                    name: "NAME|FILE.yaml|URL",
                    generators: [
                        (
                            script: [
                                "limactl",
                                "list",
                                "--quiet",
                            ],
                            has_post_process: true,
                        ),
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "stop",
            description: Some("Stop an instance"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Help for stop"),
                ),
                (
                    names: [
                        "--debug",
                    ],
                    description: Some("Debug mode"),
                ),
                (
                    names: [
                        "-f",
                        "--force",
                    ],
                    description: Some("Force stop the instance"),
                    presentation: (
                        dangerous: true,
                    ),
                ),
            ],
            arguments: [
                (
                    name: "INSTANCE",
                    generators: [
                        (
                            script: [
                                "limactl",
                                "list",
                                "--quiet",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
            presentation: (
                dangerous: true,
            ),
        ),
        (
            name: "sudoers",
            description: Some("Generate /etc/sudoers.d/lima file for enabling vmnet.framework support. See /usr/local/share/doc/lima/docs/network.md for the usage"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Help for sudoers"),
                ),
                (
                    names: [
                        "--debug",
                    ],
                    description: Some("Debug mode"),
                ),
                (
                    names: [
                        "--check",
                    ],
                    description: Some("Check that the sudoers file is up-to-date with \"~/.lima/_config/networks.yaml\""),
                ),
            ],
            arguments: [
                (
                    name: "SUDORSFILE",
                    template: [
                        FilePaths,
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "validate",
            description: Some("Validate YAML files"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Help for validate"),
                ),
                (
                    names: [
                        "--debug",
                    ],
                    description: Some("Debug mode"),
                ),
            ],
            arguments: [
                (
                    name: "FILE.yaml",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                    variadic: true,
                ),
            ],
        ),
        (
            name: "help",
            description: Some("Help provides help for any command in the application"),
            arguments: [
                (
                    name: "command",
                    suggestions: [
                        (
                            name: "completion",
                            description: Some("Generate the autocompletion script for the specified shell"),
                            kind: Some(Subcommand),
                        ),
                        (
                            name: "copy",
                            aliases: [
