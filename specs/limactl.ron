(
    version: 1,
    command: "limactl",
    description: Some("Control the Lima(Linux virtual machines)"),
    subcommands: [
        (
            name: "completion",
            description: Some("Generate the autocompletion script for the specified shell"),
            subcommands: [
                (
                    name: "bash",
