(
    version: 1,
    command: "list",
    subcommands: [
        (
            name: "package",
            description: Some("The dotnet list package command provides a convenient option to list all NuGet package references for a specific project or a solution. You first need to build the project in order to have the assets needed for this command to process"),
            options: [
                (
                    names: [
                        "--config",
                    ],
                    description: Some("The NuGet sources to use when searching for newer packages. Requires the --outdated option"),
                    arguments: [
                        (
                            name: "source",
                        ),
                    ],
                ),
                (
                    names: [
                        "--deprecated",
                    ],
                    description: Some("Displays packages that have been deprecated"),
                ),
                (
                    names: [
                        "--framework",
                    ],
                    description: Some("Displays only the packages applicable for the specified target framework. To specify multiple frameworks, repeat the option multiple times. For example: --framework netcoreapp2.2 --framework netstandard2.0"),
                    arguments: [
                        (
                            name: "framework",
                        ),
                    ],
                ),
                (
                    names: [
                        "--highest-minor",
                    ],
                    description: Some("Considers only the packages with a matching major version number when searching for newer packages. Requires the --outdated or --deprecated option"),
                ),
                (
                    names: [
                        "--highest-patch",
                    ],
                    description: Some("Considers only the packages with a matching major and minor version numbers when searching for newer packages. Requires the --outdated or --deprecated option"),
                ),
                (
                    names: [
                        "--include-prerelease",
                    ],
                    description: Some("Considers packages with prerelease versions when searching for newer packages. Requires the --outdated or --deprecated option"),
                ),
                (
                    names: [
                        "--include-transitive",
                    ],
                    description: Some("Lists transitive packages, in addition to the top-level packages. When specifying this option, you get a list of packages that the top-level packages depend on"),
                ),
                (
                    names: [
                        "--interactive",
                    ],
                    description: Some("Allows the command to stop and wait for user input or action. For example, to complete authentication. Available since .NET Core 3.0 SDK"),
                ),
                (
                    names: [
                        "--outdated",
                    ],
                    description: Some("Lists packages that have newer versions available"),
                ),
                (
                    names: [
                        "-s",
                        "--source",
                    ],
                    description: Some("The NuGet sources to use when searching for newer packages. Requires the --outdated or --deprecated option"),
                ),
                (
                    names: [
                        "-v",
                        "--verbosity",
                    ],
                    description: Some("Sets the verbosity level of the command. Allowed values are q[uiet], m[inimal], n[ormal], d[etailed], and diag[nostic]. Not supported in every command. See specific command page to determine if this option is available"),
                    arguments: [
                        (
                            name: "verbosity",
                            suggestions: [
                                (
                                    name: "quiet",
                                ),
                                (
                                    name: "minimal",
                                ),
                                (
                                    name: "normal",
                                ),
                                (
                                    name: "detailed",
                                ),
                                (
                                    name: "diagnostic",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--vulnerable",
                    ],
                    description: Some("Lists packages that have known vulnerabilities. Cannot be combined with --deprecated or --outdated options"),
                ),
            ],
        ),
        (
            name: "reference",
            description: Some("The dotnet list reference command provides a convenient option to list project references for a given project"),
        ),
    ],
    arguments: [
        (
            name: "project",
            description: Some("The project or solution file to operate on. If not specified, the command searches the current directory for one. If more than one solution or project is found, an error is thrown"),
            generators: [
                (
                    has_custom: true,
                    has_dynamic_trigger: true,
                    has_dynamic_query_term: true,
                ),
            ],
            optional: true,
        ),
    ],
)
