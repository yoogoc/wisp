(
    version: 1,
    command: "migrate",
    options: [
        (
            names: [
                "--format-report-file-json",
            ],
            description: Some("Output migration report file as JSON rather than user messages"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-r",
                "--report",
            ],
            description: Some("Output migration report to a file in addition to the console"),
            arguments: [
                (
                    name: "report_file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-s",
                "--skip-project-references",
            ],
            description: Some("Skip migrating project references. By default, project references are migrated recursively"),
            arguments: [
                (
                    name: "type",
                    suggestions: [
                        (
                            name: "Debug",
                        ),
                        (
                            name: "Release",
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            names: [
                "--skip-backup",
            ],
            description: Some("Skip moving project.json, global.json, and *.xproj to a backup directory after successful migration"),
        ),
        (
            names: [
                "-t",
                "--template-file",
            ],
            description: Some("Template csproj file to use for migration. By default, the same template as the one dropped by dotnet new console is used"),
            arguments: [
                (
                    name: "file",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-v",
                "--sdk-package-version",
            ],
            description: Some("The version of the sdk package that's referenced in the migrated app. The default is the version of the SDK in dotnet new"),
            arguments: [
                (
                    name: "version",
                ),
            ],
        ),
        (
            names: [
                "-x",
                "--xproj-file",
            ],
            description: Some("The path to the xproj file to use. Required when there is more than one xproj in a project directory"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "project",
            description: Some("The project or solution file to operate on. If not specified, the command searches the current directory for one. If more than one solution or project is found, an error is thrown"),
            generators: [
                (
                    has_custom: true,
                    has_dynamic_trigger: true,
                    has_dynamic_query_term: true,
                ),
            ],
            optional: true,
        ),
    ],
)
