(
    version: 1,
    command: "build-server",
    description: Some("Interacts with servers started by a build"),
    subcommands: [
        (
            name: "shutdown",
            description: Some("Shuts down build servers that are started from dotnet. By default, all servers are shut down"),
            options: [
                (
                    names: [
                        "--msbuild",
                    ],
                    description: Some("Shuts down the MSBuild build server"),
                ),
                (
                    names: [
                        "--razor",
                    ],
                    description: Some("Shuts down the Razor build server"),
                ),
                (
                    names: [
                        "--vbcscompiler",
                    ],
                    description: Some("Shuts down the VB/C# compiler build server"),
                ),
            ],
        ),
    ],
)
