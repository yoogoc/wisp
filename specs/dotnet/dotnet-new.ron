(
    version: 1,
    command: "new",
    description: Some("The dotnet new command creates a .NET project or other artifacts based on a template"),
    subcommands: [
        (
            name: "--list",
            description: Some("The dotnet new --list option lists available templates to use with dotnet new"),
            options: [
                (
                    names: [
                        "--author",
                    ],
                ),
                (
                    names: [
                        "--columns",
                    ],
                    description: Some("Comma-separated list of columns to display in the output"),
                    arguments: [
                        (
                            name: "columns",
                            suggestions: [
                                (
                                    name: "language",
                                ),
                                (
                                    name: "tags",
                                ),
                                (
                                    name: "author",
                                ),
                                (
                                    name: "type",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--columns-all",
                    ],
                    description: Some("Displays all columns in the output. Available since .NET Core 5.0.300 SDK"),
                ),
                (
                    names: [
                        "--tag",
                    ],
                    description: Some("Filters templates based on template tags. To be selected, a template must have at least one tag that exactly matches the criteria. Available since .NET Core 5.0.300 SDK"),
                    arguments: [
                        (
                            name: "tag",
                        ),
                    ],
                ),
                (
                    names: [
                        "--type",
                    ],
                    arguments: [
                        (
                            name: "type",
                            suggestions: [
                                (
                                    name: "project",
                                ),
                                (
                                    name: "item",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "--search",
            description: Some("The dotnet new --search option searches for templates supported by dotnet new on NuGet.org"),
            options: [
                (
                    names: [
                        "--author",
                    ],
                    description: Some("Filters templates based on template author. Partial match is supported"),
                    arguments: [
                        (
                            name: "author",
                        ),
                    ],
                ),
                (
                    names: [
                        "--columns",
                    ],
                    description: Some("Comma-separated list of columns to display in the output"),
                    arguments: [
                        (
                            name: "columns",
                            suggestions: [
                                (
                                    name: "language",
                                ),
                                (
                                    name: "tags",
                                ),
                                (
                                    name: "author",
                                ),
                                (
                                    name: "type",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--columns-all",
                    ],
                    description: Some("Displays all columns in the output"),
                ),
                (
                    names: [
                        "-lang",
                        "--language",
                    ],
                    description: Some("Filters templates based on language supported by the template. The language accepted varies by the template. Not valid for some templates"),
                    arguments: [
                        (
                            name: "language",
                            suggestions: [
                                (
                                    name: "C#",
                                ),
                                (
                                    name: "F#",
                                ),
                                (
                                    name: "VB",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--package",
                    ],
                    description: Some("Filters templates based on NuGet package ID. Partial match is supported"),
                    arguments: [
                        (
                            name: "package",
                        ),
                    ],
                ),
                (
                    names: [
                        "--tag",
                    ],
                    description: Some("Filters templates based on template tags. To be selected, a template must have at least one tag that exactly matches the criteria"),
                    arguments: [
                        (
                            name: "tag",
                        ),
                    ],
                ),
                (
                    names: [
                        "--type",
                    ],
                    description: Some("Filters templates based on template type. Predefined values are project and item"),
                    arguments: [
                        (
                            name: "type",
                            suggestions: [
                                (
                                    name: "project",
                                ),
                                (
                                    name: "item",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "template",
                    description: Some("If the argument is specified, only templates containing <TEMPLATE_NAME> in the template name or short name will be shown. The argument is mandatory when --author, --language, --package, --tag or --type options are not specified"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "-i",
            aliases: [
                "--install",
            ],
            options: [
                (
                    names: [
                        "--interactive",
                    ],
                    description: Some("Allows the command to stop and wait for user input or action. For example, to complete authentication. Available since .NET 5.0 SDK"),
                ),
                (
                    names: [
                        "--nuget-source",
                    ],
                    description: Some("By default, dotnet new --install uses the hierarchy of NuGet configuration files from the current directory to determine the NuGet source the package can be installed from. If --nuget-source is specified, the source will be added to the list of sources to be checked"),
                    arguments: [
                        (
                            name: "source",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "id",
                    description: Some("The dotnet new --install command installs a template package from the PATH or NUGET_ID provided"),
                    generators: [
                        (
                            has_dynamic_script: true,
                            has_post_process: true,
                        ),
                    ],
                    debounce: true,
                ),
            ],
        ),
        (
            name: "-u",
            aliases: [
                "--uninstall",
            ],
            description: Some("The dotnet new --uninstall command uninstalls a template package at the PATH or NUGET_ID provided"),
            arguments: [
                (
                    name: "id",
                ),
            ],
        ),
        (
            name: "--update-check",
            description: Some("The dotnet new --update-check option checks if there are updates available for the template packs that are currently installed"),
        ),
        (
            name: "--update-apply",
            description: Some("The dotnet new --update-apply option checks if there are updates available for the template packages that are currently installed and installs them"),
        ),
    ],
    options: [
        (
            names: [
                "--dry-run",
            ],
            description: Some("Displays a summary of what would happen if the given command were run if it would result in a template creation"),
        ),
        (
            names: [
                "--force",
            ],
            description: Some("Forces content to be generated even if it would change existing files. This is required when the template chosen would override existing files in the output directory"),
        ),
        (
            names: [
                "-?",
                "-h",
                "--help",
            ],
            description: Some("Prints out help for the command. It can be invoked for the dotnet new command itself or for any template. For example, dotnet new mvc --help"),
        ),
        (
            names: [
                "-lang",
                "--language",
            ],
            description: Some("The language of the template to create"),
            arguments: [
                (
                    name: "language",
                    suggestions: [
                        (
                            name: "C#",
                        ),
                        (
                            name: "F#",
                        ),
                        (
                            name: "VB",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-n",
                "--name",
            ],
            description: Some("The name for the created output. If no name is specified, the name of the current directory is used"),
            arguments: [
                (
                    name: "output_name",
                ),
            ],
        ),
        (
            names: [
                "-o",
                "--output",
            ],
            description: Some("Location to place the generated output. The default is the current directory"),
            arguments: [
                (
                    name: "output_directory",
                    template: [
                        Folders,
                    ],
                ),
            ],
            depends_on: [
                "template",
            ],
        ),
    ],
    arguments: [
        (
            name: "template",
            description: Some("The template to instantiate when the command is invoked. Each template might have specific options you can pass"),
            generators: [
                (
                    script: [
                        "dotnet",
                        "new",
                        "--list",
                    ],
                    has_post_process: true,
                ),
            ],
        ),
    ],
)
