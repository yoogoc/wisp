                                (
                                    name: "name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-p",
                                "--password",
                            ],
                            description: Some("Password to be used when connecting to an authenticated source"),
                            arguments: [
                                (
                                    name: "password",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--store-password-in-clear-text",
                            ],
                            description: Some("Enables storing portable package source credentials by disabling password encryption"),
                            arguments: [
                                (
                                    name: "clear-text",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-u",
                                "--username",
                            ],
                            description: Some("Username to be used when connecting to an authenticated source"),
                            arguments: [
                                (
                                    name: "username",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--valid-authentication-types",
                            ],
                            description: Some("Comma-separated list of valid authentication types for this source. Set this to basic if the server advertises NTLM or Negotiate and your credentials must be sent using the Basic mechanism, for instance when using a PAT with on-premises Azure DevOps Server. Other valid values include negotiate, kerberos, ntlm, and digest, but these values are unlikely to be useful"),
                            arguments: [
                                (
                                    name: "types",
                                    suggestions: [
                                        (
                                            name: "negotiate",
                                        ),
                                        (
                                            name: "kerberos",
                                        ),
                                        (
                                            name: "ntlm",
                                        ),
                                        (
                                            name: "digest",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                    ],
                    arguments: [
                        (
                            name: "package_source",
                            description: Some("Path to the package source"),
                        ),
                    ],
                ),
            ],
