(
    version: 1,
    command: "nuget",
    subcommands: [
        (
            name: "delete",
            description: Some("The dotnet nuget delete command deletes or unlists a package from the server. For nuget.org, the action is to unlist the package"),
            options: [
                (
                    names: [
                        "--force-english-output",
                    ],
                    description: Some("Forces the application to run using an invariant, English-based culture"),
                ),
                (
                    names: [
                        "--interactive",
                    ],
                    description: Some("Allows the command to stop and wait for user input or action. For example, to complete authentication. Available since .NET Core 3.0 SDK"),
                ),
                (
                    names: [
                        "-k",
                        "--api-key",
                    ],
                    description: Some("The API key for the server"),
                    arguments: [
                        (
                            name: "key",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-service-endpoint",
                    ],
                    description: Some("Doesn't append \"api/v2/package\" to the source URL. Option available since .NET Core 2.1 SDK"),
                ),
                (
                    names: [
                        "--non-interactive",
                    ],
                    description: Some("Doesn't prompt for user input or confirmations"),
                ),
                (
                    names: [
                        "-s",
                        "--source",
                    ],
                    description: Some("Specifies the server URL. Supported URLs for nuget.org include https://www.nuget.org, https://www.nuget.org/api/v3, and https://www.nuget.org/api/v2/package. For private feeds, replace the host name (for example, %hostname%/api/v3)"),
                    arguments: [
                        (
                            name: "source",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "package_name",
                    description: Some("Name/ID of the package to delete"),
                ),
                (
                    name: "package_version",
                    description: Some("Version of the package to delete"),
                ),
            ],
            presentation: (
                dangerous: true,
            ),
        ),
        (
            name: "locals",
            description: Some("The dotnet nuget locals command clears or lists local NuGet resources in the http-request cache, temporary cache, or machine-wide global packages folder"),
            options: [
                (
                    names: [
                        "-c",
                        "--clear",
                    ],
                    description: Some("The clear option executes a clear operation on the specified cache type. The contents of the cache directories are deleted recursively. The executing user/group must have permission to the files in the cache directories. If not, an error is displayed indicating the files/folders that weren't cleared"),
                ),
                (
                    names: [
                        "-l",
                        "--list",
                    ],
                    description: Some("The list option is used to display the location of the specified cache type"),
                ),
            ],
            arguments: [
                (
                    name: "cache_location",
                    suggestions: [
                        (
                            name: "all",
                        ),
                        (
                            name: "http-cache",
                        ),
                        (
                            name: "global-packages",
                        ),
                        (
                            name: "temp",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "push",
            description: Some("The dotnet nuget push command pushes a package to the server and publishes it. The push command uses server and credential details found in the system's NuGet config file or chain of config files. For more information on config files, see Configuring NuGet Behavior. NuGet's default configuration is obtained by loading %AppData%NuGetNuGet.config (Windows) or $HOME/.local/share (Linux/macOS), then loading any nuget.config or .nuget\nuget.config starting from the root of drive and ending in the current directory"),
            options: [
                (
                    names: [
                        "-d",
                        "--disable-buffering",
                    ],
                    description: Some("Disables buffering when pushing to an HTTP(S) server to reduce memory usage"),
                ),
                (
                    names: [
                        "--force-english-output",
                    ],
                    description: Some("Forces the application to run using an invariant, English-based culture"),
                ),
                (
                    names: [
                        "--interactive",
                    ],
                    description: Some("Allows the command to stop and wait for user input or action. For example, to complete authentication. Available since .NET Core 3.0 SDK"),
                ),
                (
                    names: [
                        "-k",
                        "--api-key",
                    ],
                    description: Some("The API key for the server"),
                    arguments: [
                        (
                            name: "key",
                        ),
                    ],
                ),
                (
                    names: [
                        "-n",
                        "--no-symbols",
                    ],
                    description: Some("Doesn't push symbols (even if present)"),
                ),
                (
                    names: [
                        "--no-service-endpoint",
                    ],
                    description: Some("Doesn't append \"api/v2/package\" to the source URL. Option available since .NET Core 2.1 SDK"),
                ),
                (
                    names: [
                        "-s",
                        "--source",
                    ],
                    description: Some("Specifies the server URL. NuGet identifies a UNC or local folder source and simply copies the file there instead of pushing it using HTTP"),
                    arguments: [
                        (
                            name: "source",
                        ),
                    ],
                ),
                (
                    names: [
                        "--skip-duplicate",
                    ],
                    description: Some("When pushing multiple packages to an HTTP(S) server, treats any 409 Conflict response as a warning so that the push can continue. Available since .NET Core 3.1 SDK"),
                ),
                (
                    names: [
                        "-sk",
                        "--symbol-api-key",
                    ],
                    description: Some("The API key for the symbol server"),
                    arguments: [
                        (
                            name: "key",
                        ),
                    ],
                ),
                (
                    names: [
                        "-ss",
                        "--symbol-source",
                    ],
                    description: Some("Specifies the symbol server URL"),
                    arguments: [
                        (
                            name: "symbol_source",
                        ),
                    ],
                ),
                (
                    names: [
                        "-t",
                        "--timeout",
                    ],
                    description: Some("Specifies the timeout for pushing to a server in seconds. Defaults to 300 seconds (5 minutes). Specifying 0 applies the default value"),
                    arguments: [
                        (
                            name: "timeout",
                            optional: true,
                            default: Some("300"),
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "root",
                    description: Some("Specifies the file path to the package to be pushed"),
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "add",
            subcommands: [
                (
                    name: "source",
                    description: Some("The dotnet nuget add source command adds a new package source to your NuGet configuration files"),
                    options: [
                        (
                            names: [
                                "--configfile",
                            ],
                            description: Some("The NuGet configuration file (nuget.config) to use. If specified, only the settings from this file will be used. If not specified, the hierarchy of configuration files from the current directory will be used"),
                            arguments: [
                                (
                                    name: "file",
                                    generators: [
                                        (
                                            has_custom: true,
                                            has_dynamic_trigger: true,
                                            has_dynamic_query_term: true,
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-n",
                                "--name",
