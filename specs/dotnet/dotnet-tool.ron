(
    version: 1,
    command: "tool",
    description: Some("The dotnet tool install command provides a way for you to install .NET tools on your machine"),
    subcommands: [
        (
            name: "install",
            options: [
                (
                    names: [
                        "--add-source",
                    ],
                    description: Some("Adds an additional NuGet package source to use during installation. Feeds are accessed in parallel, not sequentially in some order of precedence. If the same package and version is in multiple feeds, the fastest feed wins"),
                    arguments: [
                        (
                            name: "source",
                        ),
                    ],
                ),
                (
                    names: [
                        "--configfile",
                    ],
                    description: Some("The NuGet configuration file (nuget.config) to use. If specified, only the settings from this file will be used. If not specified, the hierarchy of configuration files from the current directory will be used"),
                    arguments: [
                        (
                            name: "file",
                            generators: [
                                (
                                    has_custom: true,
                                    has_dynamic_trigger: true,
                                    has_dynamic_query_term: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--disable-parallel",
                    ],
                    description: Some("Prevent restoring multiple projects in parallel"),
                ),
                (
                    names: [
                        "--framework",
                    ],
                    description: Some("Specifies the target framework to install the tool for. By default, the .NET SDK tries to choose the most appropriate target framework"),
                    arguments: [
                        (
                            name: "framework",
                        ),
                    ],
                ),
                (
                    names: [
                        "-g",
                        "--global",
                    ],
                    description: Some("Specifies that the installation is user wide. Can't be combined with the --tool-path option. Omitting both --global and --tool-path specifies a local tool installation"),
                    exclusive_on: [
                        "--tool-path",
                    ],
                ),
                (
                    names: [
                        "--ignore-failed-sources",
                    ],
                    description: Some("Treat package source failures as warnings"),
                ),
                (
                    names: [
                        "--interactive",
                    ],
                    description: Some("Allows the command to stop and wait for user input or action. For example, to complete authentication"),
                ),
                (
                    names: [
                        "--local",
                    ],
                    description: Some("Update the tool and the local tool manifest. Can't be combined with the --global option or the --tool-path option"),
                    exclusive_on: [
                        "--global",
                        "--tool-path",
                    ],
                ),
                (
                    names: [
                        "--no-cache",
                    ],
                    description: Some("Do not cache packages and HTTP requests"),
                ),
                (
                    names: [
                        "--tool-manifest",
                    ],
                    description: Some("Path to the manifest file"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-v",
                        "--verbosity",
                    ],
                    description: Some("Sets the verbosity level of the command. Allowed values are q[uiet], m[inimal], n[ormal], d[etailed], and diag[nostic]. The default is minimal"),
                    arguments: [
                        (
                            name: "verbosity",
                            suggestions: [
                                (
                                    name: "quiet",
                                ),
                                (
                                    name: "minimal",
                                ),
                                (
                                    name: "normal",
                                ),
                                (
                                    name: "detailed",
                                ),
                                (
                                    name: "diagnostic",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--version",
                    ],
                    description: Some("The version of the tool to install. By default, the latest stable package version is installed. Use this option to install preview or older versions of the tool"),
                    arguments: [
                        (
                            name: "version",
                            generators: [
                                (
                                    has_dynamic_script: true,
                                    has_post_process: true,
                                ),
                            ],
                            debounce: true,
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "package",
                    generators: [
                        (
                            has_dynamic_script: true,
                            has_post_process: true,
                        ),
                    ],
                    debounce: true,
                ),
            ],
        ),
        (
            name: "list",
            description: Some("The dotnet tool list command provides a way for you to list all .NET global, tool-path, or local tools installed on your machine. The command lists the package name, version installed, and the tool command"),
            options: [
                (
                    names: [
                        "-g",
                        "--global",
                    ],
                    description: Some("Lists user-wide global tools. Can't be combined with the --tool-path option. Omitting both --global and --tool-path lists local tools"),
                    exclusive_on: [
                        "--tool-path",
                    ],
                ),
                (
                    names: [
                        "--local",
                    ],
                    description: Some("Lists local tools for the current directory. Can't be combined with the --global or --tool-path options. Omitting both --global and --tool-path lists local tools even if --local is not specified"),
                    exclusive_on: [
                        "--global",
                        "--tool-path",
                    ],
                ),
                (
                    names: [
                        "--tool-path",
                    ],
                    description: Some("Specifies a custom location where to find global tools. PATH can be absolute or relative. Can't be combined with the --global option. Omitting both --global and --tool-path lists local tools"),
                    exclusive_on: [
                        "--global",
                    ],
                ),
            ],
        ),
        (
            name: "restore",
            description: Some("The dotnet tool restore command finds the tool manifest file that is in scope for the current directory and installs the tools that are listed in it. For information about manifest files, see Install a local tool and Invoke a local tool"),
            options: [
                (
                    names: [
                        "--configfile",
                    ],
                    description: Some("The NuGet configuration file (nuget.config) to use. If specified, only the settings from this file will be used. If not specified, the hierarchy of configuration files from the current directory will be used"),
                    arguments: [
                        (
                            name: "file",
                            generators: [
                                (
                                    has_custom: true,
                                    has_dynamic_trigger: true,
                                    has_dynamic_query_term: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--add-source",
                    ],
                    description: Some("Adds an additional NuGet package source to use during installation. Feeds are accessed in parallel, not sequentially in some order of precedence. If the same package and version is in multiple feeds, the fastest feed wins"),
                    arguments: [
                        (
                            name: "source",
                        ),
                    ],
                ),
                (
                    names: [
                        "--tool-manifest",
                    ],
                    description: Some("Path to the manifest file"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--ignore-failed-sources",
                    ],
                    description: Some("Treat package source failures as warnings"),
                ),
                (
                    names: [
                        "--no-cache",
                    ],
                    description: Some("Do not cache packages and HTTP requests"),
                ),
                (
                    names: [
                        "--interactive",
                    ],
                    description: Some("Allows the command to stop and wait for user input or action. For example, to complete authentication"),
                ),
                (
                    names: [
                        "-v",
                        "--verbosity",
                    ],
                    description: Some("Sets the verbosity level of the command. Allowed values are q[uiet], m[inimal], n[ormal], d[etailed], and diag[nostic]. The default is minimal"),
                    arguments: [
                        (
                            name: "verbosity",
                            suggestions: [
                                (
                                    name: "quiet",
                                ),
                                (
                                    name: "minimal",
                                ),
                                (
                                    name: "normal",
                                ),
                                (
                                    name: "detailed",
                                ),
                                (
                                    name: "diagnostic",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "run",
            description: Some("The dotnet tool run command searches tool manifest files that are in scope for the current directory. When it finds a reference to the specified tool, it runs the tool"),
            arguments: [
                (
                    name: "command",
                    generators: [
                        (
                            has_dynamic_script: true,
                            has_post_process: true,
                            has_dynamic_trigger: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "search",
            description: Some("The dotnet tool search command provides a way for you to search NuGet for tools that can be used as .NET global, tool-path, or local tools. The command searches the tool names and metadata such as titles, descriptions, and tags"),
            options: [
                (
                    names: [
                        "--detail",
                    ],
                    description: Some("Shows detailed results from the query"),
                ),
                (
                    names: [
                        "--prerelease",
                    ],
                    description: Some("Includes pre-release packages"),
                ),
                (
                    names: [
                        "--skip",
                    ],
                    description: Some("Specifies the number of query results to skip. Used for pagination"),
                    arguments: [
                        (
                            name: "number",
                        ),
                    ],
                ),
                (
                    names: [
                        "--take",
                    ],
                    description: Some("Specifies the number of query results to show. Used for pagination"),
                    arguments: [
                        (
                            name: "number",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "uninstall",
            description: Some("The dotnet tool uninstall command provides a way for you to uninstall .NET tools from your machine"),
            options: [
                (
                    names: [
                        "-g",
                        "--global",
                    ],
                    description: Some("Specifies that the tool to be removed is from a user-wide installation. Can't be combined with the --tool-path option. Omitting both --global and --tool-path specifies that the tool to be removed is a local tool"),
                    exclusive_on: [
                        "--tool-path",
                    ],
                ),
                (
                    names: [
                        "--tool-path",
                    ],
                    description: Some("Specifies the location where to uninstall the tool. PATH can be absolute or relative. Can't be combined with the --global option. Omitting both --global and --tool-path specifies that the tool to be removed is a local tool"),
                    exclusive_on: [
                        "--global",
                    ],
                ),
            ],
            arguments: [
                (
                    name: "package",
                    description: Some("Name/ID of the NuGet package that contains the .NET tool to uninstall. You can find the package name using the dotnet tool list command"),
                    generators: [
                        (
                            has_dynamic_script: true,
                            has_post_process: true,
                            has_dynamic_trigger: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "update",
            description: Some("The dotnet tool update command provides a way for you to update .NET tools on your machine to the latest stable version of the package"),
            options: [
                (
                    names: [
                        "--add-source",
                    ],
                    description: Some("Adds an additional NuGet package source to use during installation. Feeds are accessed in parallel, not sequentially in some order of precedence. If the same package and version is in multiple feeds, the fastest feed wins"),
                    arguments: [
                        (
                            name: "source",
                        ),
                    ],
                ),
                (
                    names: [
                        "--configfile",
                    ],
                    description: Some("The NuGet configuration file (nuget.config) to use. If specified, only the settings from this file will be used. If not specified, the hierarchy of configuration files from the current directory will be used"),
                    arguments: [
                        (
                            name: "file",
                            generators: [
                                (
                                    has_custom: true,
                                    has_dynamic_trigger: true,
                                    has_dynamic_query_term: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--disable-parallel",
                    ],
                    description: Some("Prevent restoring multiple projects in parallel"),
                ),
                (
                    names: [
                        "--framework",
                    ],
                    description: Some("Specifies the target framework to install the tool for. By default, the .NET SDK tries to choose the most appropriate target framework"),
                    arguments: [
                        (
                            name: "framework",
                        ),
                    ],
                ),
                (
                    names: [
                        "-g",
                        "--global",
                    ],
                    description: Some("Specifies that the installation is user wide. Can't be combined with the --tool-path option. Omitting both --global and --tool-path specifies a local tool installation"),
                    exclusive_on: [
                        "--tool-path",
                    ],
                ),
                (
                    names: [
                        "--ignore-failed-sources",
                    ],
                    description: Some("Treat package source failures as warnings"),
                ),
                (
                    names: [
                        "--interactive",
                    ],
                    description: Some("Allows the command to stop and wait for user input or action. For example, to complete authentication"),
                ),
                (
                    names: [
                        "--local",
                    ],
                    description: Some("Update the tool and the local tool manifest. Can't be combined with the --global option or the --tool-path option"),
                    exclusive_on: [
                        "--global",
                        "--tool-path",
                    ],
                ),
                (
                    names: [
                        "--no-cache",
                    ],
                    description: Some("Do not cache packages and HTTP requests"),
                ),
                (
                    names: [
                        "--tool-manifest",
                    ],
                    description: Some("Path to the manifest file"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-v",
                        "--verbosity",
                    ],
                    description: Some("Sets the verbosity level of the command. Allowed values are q[uiet], m[inimal], n[ormal], d[etailed], and diag[nostic]. The default is minimal"),
                    arguments: [
                        (
                            name: "verbosity",
                            suggestions: [
                                (
                                    name: "quiet",
                                ),
                                (
                                    name: "minimal",
                                ),
                                (
                                    name: "normal",
                                ),
                                (
                                    name: "detailed",
                                ),
                                (
                                    name: "diagnostic",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--version",
                    ],
                    description: Some("The version of the tool to install. By default, the latest stable package version is installed. Use this option to install preview or older versions of the tool"),
                    arguments: [
                        (
                            name: "version",
                            generators: [
                                (
                                    has_dynamic_script: true,
                                    has_post_process: true,
                                ),
                            ],
                            debounce: true,
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "package",
                    generators: [
                        (
                            has_dynamic_script: true,
                            has_post_process: true,
                            has_dynamic_trigger: true,
                        ),
                    ],
                ),
            ],
        ),
    ],
)
