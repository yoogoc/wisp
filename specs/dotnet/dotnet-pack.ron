(
    version: 1,
    command: "pack",
    description: Some("The dotnet pack command builds the project and creates NuGet packages. The result of this command is a NuGet package (that is, a .nupkg file)"),
    options: [
        (
            names: [
                "-c",
                "--configuration",
            ],
            description: Some("Defines the build configuration. The default for most projects is Debug, but you can override the build configuration settings in your project"),
            arguments: [
                (
                    name: "configuration",
                    suggestions: [
                        (
                            name: "Debug",
                        ),
                        (
                            name: "Release",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--force",
            ],
            description: Some("Forces all dependencies to be resolved even if the last restore was successful. Specifying this flag is the same as deleting the project.assets.json file"),
        ),
        (
            names: [
                "--include-source",
            ],
            description: Some("Includes the debug symbols NuGet packages in addition to the regular NuGet packages in the output directory. The sources files are included in the src folder within the symbols package"),
        ),
        (
            names: [
                "--include-symbols",
            ],
            description: Some("Includes the debug symbols NuGet packages in addition to the regular NuGet packages in the output directory"),
        ),
        (
            names: [
                "--interactive",
            ],
            description: Some("Allows the command to stop and wait for user input or action. For example, to complete authentication. Available since .NET Core 3.0 SDK"),
        ),
        (
            names: [
                "--no-build",
            ],
            description: Some("Doesn't build the project before packing. It also implicitly sets the --no-restore flag"),
        ),
        (
            names: [
                "--no-dependencies",
            ],
            description: Some("Ignores project-to-project references and only restores the root project"),
        ),
        (
            names: [
                "--no-restore",
            ],
            description: Some("Doesn't execute an implicit restore when running the command"),
        ),
        (
            names: [
                "--nologo",
            ],
            description: Some("Doesn't display the startup banner or the copyright message. Available since .NET Core 3.0 SDK"),
        ),
        (
            names: [
                "-o",
                "--output",
            ],
            description: Some("Places the built packages in the directory specified"),
            arguments: [
                (
                    name: "directory",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--runtime",
            ],
            description: Some("Specifies the target runtime to restore packages for. For a list of Runtime Identifiers (RIDs), see the RID catalog"),
            arguments: [
                (
                    name: "runtime",
                ),
            ],
        ),
        (
            names: [
                "-s",
                "--serviceable",
            ],
            description: Some("Sets the serviceable flag in the package"),
        ),
        (
            names: [
                "--version-suffix",
            ],
            description: Some("Defines the value for the $(VersionSuffix) MSBuild property in the project"),
            arguments: [
                (
                    name: "suffix",
                ),
            ],
        ),
        (
            names: [
                "-v",
                "--verbosity",
            ],
            description: Some("Sets the verbosity level of the command. Allowed values are q[uiet], m[inimal], n[ormal], d[etailed], and diag[nostic]. For more information, see LoggerVerbosity"),
            arguments: [
                (
                    name: "verbosity",
                    suggestions: [
                        (
                            name: "quiet",
                        ),
                        (
                            name: "minimal",
                        ),
                        (
                            name: "normal",
                        ),
                        (
                            name: "detailed",
                        ),
                        (
                            name: "diagnostic",
                        ),
                    ],
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "project",
            description: Some("The project or solution to pack. It's either a path to a csproj, vbproj, or fsproj file, or to a solution file or directory. If not specified, the command searches the current directory for a project or solution file"),
            generators: [
                (
                    has_custom: true,
                    has_dynamic_trigger: true,
                    has_dynamic_query_term: true,
                ),
            ],
        ),
    ],
)
