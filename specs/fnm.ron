(
    version: 1,
    command: "fnm",
    description: Some("Fast Node Manager"),
    subcommands: [
        (
            name: "install",
            description: Some("Install a new Node.js version"),
            options: [
                (
                    names: [
                        "--lts",
                    ],
                    description: Some("Install latest LTS"),
                ),
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Prints help information"),
                ),
                (
                    names: [
                        "--version",
                        "-V",
                    ],
                    description: Some("Prints version information"),
                ),
                (
                    names: [
                        "--arch",
                    ],
                    description: Some("Override the architecture of the installed Node binary. Defaults to arch of fnm binary"),
                    arguments: [
                        (
                            name: "arch",
                            suggestions: [
                                (
                                    name: "x86",
                                ),
                                (
                                    name: "x64",
                                ),
                                (
                                    name: "arm64",
                                ),
                                (
                                    name: "armv7l",
                                ),
                                (
                                    name: "ppc64le",
                                ),
                                (
                                    name: "ppc64",
                                ),
                                (
                                    name: "s390x",
                                ),
                            ],
                            default: Some("x64"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--fnm-dir",
                    ],
                    description: Some("The root directory of fnm installations"),
                    arguments: [
                        (
                            name: "dir",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--log-level",
                    ],
                    description: Some("The log level of fnm commands"),
                    arguments: [
                        (
                            name: "logLevel",
                            suggestions: [
                                (
                                    name: "quiet",
                                ),
                                (
                                    name: "info",
                                ),
                                (
                                    name: "error",
                                ),
                            ],
                            default: Some("info"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--node-dist-mirror",
                    ],
                    description: Some("Mirror of https://nodejs.org/dist"),
                    arguments: [
                        (
                            name: "nodeDistMirror",
                            default: Some("https://nodejs.org/dist"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--version-file-strategy",
                    ],
                    description: Some("Strategy for how to resolve the Node version"),
                    arguments: [
                        (
                            name: "strategy",
                            suggestions: [
                                (
                                    name: "local",
                                ),
                                (
                                    name: "recursive",
                                ),
                            ],
                            default: Some("local"),
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "version",
                    description: Some("A version string. Can be a partial semver or a LTS version name by the format lts/NAME"),
                    generators: [
                        (
                            script: [
                                "fnm",
                                "list-remote",
                            ],
                            has_post_process: true,
                            cache: Some((
                                ttl_ms: Some(86400),
                                stale_while_revalidate: true,
                            )),
                        ),
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                priority: Some(61.0),
