                    arguments: [
                        (
                            name: "SPEC",
                            description: Some("Packages to run this command on, can be a concrete package name (`foobar`) or a prefix glob (`foo*`) [default: *]"),
                            generators: [
                                (
                                    script: [
                                        "scarb",
