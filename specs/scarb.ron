(
    version: 1,
    command: "scarb",
    description: Some("Scarb, The build toolchain and package manager for Cairo and Starknet ecosystems"),
    subcommands: [
        (
            name: "add",
            description: Some("Add dependencies to a Scarb.toml manifest file"),
            options: [
                (
                    names: [
                        "--dry-run",
                    ],
                    description: Some("Do not actually write the manifest"),
                ),
                (
                    names: [
                        "-p",
                        "--package",
                    ],
                    description: Some("Packages to run this command on"),
                    arguments: [
                        (
                            name: "SPEC",
                            description: Some("Packages to run this command on, can be a concrete package name (`foobar`) or a prefix glob (`foo*`) [default: *]"),
                            generators: [
                                (
                                    script: [
                                        "scarb",
                                        "metadata",
                                        "--format-version",
                                        "1",
                                        "--no-deps",
                                    ],
                                    has_post_process: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-v",
                        "--verbose",
                    ],
                    description: Some("More output per occurrence"),
                ),
                (
                    names: [
                        "-q",
                        "--quiet",
                    ],
                    description: Some("Less output per occurrence"),
                ),
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Print help"),
                ),
                (
                    names: [
                        "--path",
                    ],
                    description: Some("Filesystem path to local package to add"),
                    arguments: [
                        (
                            name: "PATH",
                        ),
                    ],
                ),
                (
                    names: [
                        "--git",
                    ],
                    description: Some("Git repository location"),
                    arguments: [
                        (
                            name: "URI",
                        ),
                    ],
                ),
                (
                    names: [
                        "--branch",
                    ],
                    description: Some("Git branch to download the package from"),
                    arguments: [
                        (
                            name: "BRANCH",
                        ),
                    ],
                ),
                (
                    names: [
                        "--tag",
                    ],
                    description: Some("Git tag to download the package from"),
                    arguments: [
                        (
                            name: "TAG",
                        ),
                    ],
                ),
                (
                    names: [
                        "--rev",
                    ],
                    description: Some("Git reference to download the package from"),
                    arguments: [
                        (
                            name: "REV",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "DEP_ID",
                    description: Some("Reference to a package to add as a dependency"),
                ),
            ],
        ),
        (
            name: "remove",
            description: Some("Remove dependencies from a manifest file"),
            options: [
                (
                    names: [
                        "--dry-run",
                    ],
                    description: Some("Do not actually write the manifest"),
                ),
                (
                    names: [
                        "-p",
                        "--package",
                    ],
                    description: Some("Packages to run this command on"),
                    arguments: [
                        (
                            name: "SPEC",
                            description: Some("Packages to run this command on, can be a concrete package name (`foobar`) or a prefix glob (`foo*`) [default: *]"),
                            generators: [
                                (
                                    script: [
                                        "scarb",
                                        "metadata",
                                        "--format-version",
                                        "1",
                                        "--no-deps",
                                    ],
                                    has_post_process: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-v",
                        "--verbose",
                    ],
                    description: Some("More output per occurrence"),
                ),
                (
                    names: [
                        "-q",
                        "--quiet",
                    ],
                    description: Some("Less output per occurrence"),
                ),
                (
                    names: [
                        "-w",
                        "--workspace",
                    ],
                    description: Some("Run for all packages in the workspace"),
                ),
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Print help"),
                ),
            ],
            arguments: [
                (
                    name: "DEP_ID",
                    description: Some("Dependencies to be removed"),
                    variadic: true,
                ),
            ],
        ),
