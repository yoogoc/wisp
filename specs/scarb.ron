                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Print help"),
                ),
            ],
        ),
        (
            name: "metadata",
            description: Some("Output the resolved dependencies of a package, the concrete used versions including overrides, in machine-readable format"),
            options: [
                (
                    names: [
                        "--format-version",
                    ],
                    description: Some("Format version"),
                    arguments: [
                        (
                            name: "VERSION",
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--no-deps",
                    ],
                    description: Some("Output information only about the workspace members and don't fetch dependencies"),
                ),
                (
                    names: [
                        "-v",
                        "--verbose",
                    ],
                    description: Some("More output per occurrence"),
                ),
                (
                    names: [
                        "-q",
                        "--quiet",
                    ],
