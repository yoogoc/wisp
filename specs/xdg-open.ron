(
    version: 1,
    command: "xdg-open",
    description: Some("Opens a file or URL in the user's preferred application"),
    options: [
        (
            names: [
                "--help",
            ],
            description: Some("Show command synopsis"),
        ),
        (
            names: [
                "--manual",
            ],
            description: Some("Show manual page"),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Show the xdg-utils version information"),
        ),
    ],
    arguments: [
        (
            name: "FILE or URL",
            template: [
                FilePaths,
            ],
        ),
    ],
)
