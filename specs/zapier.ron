(
    version: 1,
    command: "zapier-platform-cli",
    description: Some("The Zapier CLI is a developer-focused way to create and maintain Zapier integrations. See more at https://github.com/zapier/zapier-platform"),
    subcommands: [
        (
            name: "analytics",
            description: Some("Show the status of the analytics that are collected. Also used to change what is collected"),
            options: [
                (
                    names: [
                        "-m",
                        "--mode",
                    ],
                    description: Some("Choose how much information to share. Anonymous mode drops the OS type and Zapier user id, but keeps command info. Identifying information is used only for debugging purposes"),
                    arguments: [
                        (
                            name: "mode",
                            suggestions: [
                                (
                                    name: "enabled",
                                ),
                                (
                                    name: "anonymous",
                                ),
                                (
                                    name: "disabled",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
        ),
        (
            name: "build",
            description: Some("Build a pushable zip from the current directory"),
            options: [
                (
                    names: [
                        "--disable-dependency-detection",
                    ],
                    description: Some("Disable \"smart\" file inclusion. By default, Zapier only includes files that are required by `index.js`. If you (or your dependencies) require files dynamically (such as with `require(someVar)`), then you may see \"Cannot find module\" errors. Disabling this may make your `build.zip` too large. If that's the case, try using the `includeInBuild` option in your `.zapierapprc`. See the docs about `includeInBuild` for more info"),
                ),
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
        ),
        (
            name: "convert",
            description: Some("Convert a Legacy Web Builder app or Visual Builder integration to a CLI integration"),
            options: [
                (
                    names: [
                        "-v",
                        "--version",
                    ],
                    description: Some("Convert a specific version. Required when converting a Visual Builder integration"),
                    arguments: [
                        (
                            name: "version",
                        ),
                    ],
                ),
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
            arguments: [
                (
                    name: "integrationId",
                    description: Some("To get the integration/app ID, go to \"https://zapier.com/app/developer\", click on an integration, and copy the number directly after \"/app/\" in the URL"),
                ),
                (
                    name: "path",
                    description: Some("Relative to your current path - IE: `.` for current directory"),
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            name: "delete:integration",
            aliases: [
                "delete:app",
            ],
            description: Some("Delete your integration (including all versions)"),
            options: [
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
            presentation: (
                dangerous: true,
            ),
        ),
        (
            name: "delete:version",
            description: Some("Delete a specific version of your integration"),
            options: [
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
            arguments: [
                (
                    name: "version",
                    description: Some("Specify the version to delete. It must have no users or Zaps"),
                ),
            ],
            presentation: (
                dangerous: true,
            ),
        ),
        (
            name: "deprecate",
            description: Some("Mark a non-production version of your integration as deprecated, with removal by a certain date"),
            options: [
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
            arguments: [
                (
                    name: "version",
                    description: Some("The version to deprecate"),
                ),
                (
                    name: "date",
                    description: Some("The date (YYYY-MM-DD) when Zapier will make the specified version unavailable"),
                ),
            ],
        ),
        (
            name: "describe",
            description: Some("Describe the current integraiton"),
            options: [
                (
                    names: [
                        "-f",
                        "--format",
                    ],
                    description: Some("Change the way structured data is presented. If \"json\" or \"raw\", you can pipe the output of the command into other tools, such as jq"),
                    arguments: [
                        (
                            name: "format",
                            suggestions: [
                                (
                                    name: "plain",
                                ),
                                (
                                    name: "json",
                                ),
                                (
                                    name: "raw",
                                ),
                                (
                                    name: "row",
                                ),
                                (
                                    name: "table",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
        ),
        (
            name: "env:get",
            description: Some("Get environment variables for a version"),
            options: [
                (
                    names: [
                        "-f",
                        "--format",
                    ],
                    description: Some("Change the way structured data is presented. If \"json\" or \"raw\", you can pipe the output of the command into other tools, such as jq"),
                    arguments: [
                        (
                            name: "format",
                            suggestions: [
                                (
                                    name: "plain",
                                ),
                                (
                                    name: "json",
                                ),
                                (
                                    name: "raw",
                                ),
                                (
                                    name: "row",
                                ),
                                (
                                    name: "table",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "version",
                    description: Some("The version to get the environment for"),
                ),
            ],
        ),
        (
            name: "env:set",
            description: Some("Set environment variables for a version"),
            options: [
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
            arguments: [
                (
                    name: "version",
                    description: Some("The version to set the environment for. Values are copied forward when a new version is created, but this command will only ever affect the specified version"),
                ),
                (
                    name: "key-value pairs...",
                    description: Some("The key-value pairs to set. Keys are case-insensitive. Each pair should be space separated and pairs should be separated by an `=`. For example: `A=123 B=456`"),
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "env:unset",
            description: Some("Unset environment variables for a version"),
            options: [
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
            arguments: [
                (
                    name: "version",
                    description: Some("The version to set the environment for"),
                ),
                (
                    name: "keys...",
                    description: Some("The keys to unset. Keys are case-insensitive"),
                    optional: true,
                    variadic: true,
                ),
            ],
            presentation: (
                dangerous: true,
            ),
        ),
        (
            name: "history",
            description: Some("Get the history of your integration"),
            options: [
                (
                    names: [
                        "-f",
                        "--format",
                    ],
                    description: Some("Change the way structured data is presented. If \"json\" or \"raw\", you can pipe the output of the command into other tools, such as jq"),
                    arguments: [
                        (
                            name: "format",
                            suggestions: [
                                (
                                    name: "plain",
                                ),
                                (
                                    name: "json",
                                ),
                                (
                                    name: "raw",
                                ),
                                (
                                    name: "row",
                                ),
                                (
                                    name: "table",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
        ),
        (
            name: "init",
            description: Some("Initialize a new Zapier integration with a project template"),
            options: [
                (
                    names: [
                        "-t",
                        "--template",
                    ],
                    description: Some("The template to start your integration with"),
                    arguments: [
                        (
                            name: "template",
                            suggestions: [
                                (
                                    name: "basic-auth",
                                ),
                                (
                                    name: "callback",
                                ),
                                (
                                    name: "custom-auth",
                                ),
                                (
                                    name: "digest-auth",
                                ),
                                (
                                    name: "dynamic-dropdown",
                                ),
                                (
                                    name: "files",
                                ),
                                (
                                    name: "minimal",
                                ),
                                (
                                    name: "oauth1-trello",
                                ),
                                (
                                    name: "oauth2",
                                ),
                                (
                                    name: "search-or-create",
                                ),
                                (
                                    name: "session-auth",
                                ),
                                (
                                    name: "typescript",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
            arguments: [
                (
                    name: "path",
                    description: Some("Where to create the new integration. If the directory doesn't exist, it will be created. If the directory isn't empty, we'll ask for confirmation"),
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            name: "integrations",
            aliases: [
                "apps",
            ],
            description: Some("List integrations you have admin access to"),
            options: [
                (
                    names: [
                        "-f",
                        "--format",
                    ],
                    description: Some("Change the way structured data is presented. If \"json\" or \"raw\", you can pipe the output of the command into other tools, such as jq"),
                    arguments: [
                        (
                            name: "format",
                            suggestions: [
                                (
                                    name: "plain",
                                ),
                                (
                                    name: "json",
                                ),
                                (
                                    name: "raw",
                                ),
                                (
                                    name: "row",
                                ),
                                (
                                    name: "table",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
        ),
        (
            name: "link",
            description: Some("Link the current directory with an existing integration"),
            options: [
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
        ),
        (
            name: "login",
            description: Some("Configure your `~/.zapierrc` with a deploy key"),
            options: [
                (
                    names: [
                        "-s",
                        "--sso",
                    ],
                    description: Some("Use this flag if you log into Zapier a Single Sign-On (SSO) button and don't have a Zapier password"),
                ),
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
        ),
        (
            name: "logout",
            description: Some("Deactivate your active deploy key and reset `~/.zapierrc`"),
            options: [
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
        ),
        (
            name: "logs",
            description: Some("Print recent logs"),
            options: [
                (
                    names: [
                        "-v",
                        "--version",
                    ],
                    description: Some("Filter logs to the specified version"),
                    arguments: [
                        (
                            name: "version",
                        ),
                    ],
                ),
                (
                    names: [
                        "-s",
                        "--status",
                    ],
                    description: Some("Filter logs to only see errors or successes"),
                    arguments: [
                        (
                            name: "status",
                            suggestions: [
                                (
                                    name: "any",
                                ),
                                (
                                    name: "success",
                                ),
                                (
                                    name: "error",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-t",
                        "--type",
                    ],
                    description: Some("See logs of the specified type"),
                    arguments: [
                        (
                            name: "type",
                            suggestions: [
                                (
                                    name: "console",
                                ),
                                (
                                    name: "bundle",
                                ),
                                (
                                    name: "http",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--detailed",
                    ],
                    description: Some("See extra info, like request/response body and headers"),
                ),
                (
                    names: [
                        "-u",
                        "--user",
                    ],
                    description: Some("Only show logs for this user. Defaults to your account"),
                    arguments: [
                        (
                            name: "user",
                        ),
                    ],
                ),
                (
                    names: [
                        "--limit",
                    ],
                    description: Some("Cap the number of logs returned. Max is 50 (also the default)"),
                    arguments: [
                        (
                            name: "limit",
                        ),
                    ],
                ),
                (
                    names: [
                        "-f",
                        "--format",
                    ],
                    description: Some("Change the way structured data is presented. If \"json\" or \"raw\", you can pipe the output of the command into other tools, such as jq"),
                    arguments: [
                        (
                            name: "format",
                            suggestions: [
                                (
                                    name: "plain",
                                ),
                                (
                                    name: "json",
                                ),
                                (
                                    name: "raw",
                                ),
                                (
                                    name: "row",
                                ),
                                (
                                    name: "table",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
        ),
        (
            name: "migrate",
            description: Some("Migrate users from one version of your integration to another"),
            options: [
                (
                    names: [
                        "--user",
                    ],
                    description: Some("Migrate only this user"),
                    arguments: [
                        (
                            name: "user",
                        ),
                    ],
                ),
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
            arguments: [
                (
                    name: "fromVersion",
                    description: Some("The version FROM which to migrate users"),
                ),
                (
                    name: "toVersion",
                    description: Some("The version TO which to migrate users"),
                ),
                (
                    name: "percent",
                    description: Some("Percentage (between 1 and 100) of users to migrate"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "promote",
            description: Some("Promote a specific version to public access"),
            options: [
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
            arguments: [
                (
                    name: "version",
                    description: Some("The version you want promote"),
                ),
            ],
        ),
        (
            name: "push",
            description: Some("Build and upload the current integration"),
            options: [
                (
                    names: [
                        "--disable-dependency-detection",
                    ],
                    description: Some("Disable \"smart\" file inclusion. By default, Zapier only includes files that are required by `index.js`. If you (or your dependencies) require files dynamically (such as with `require(someVar)`), then you may see \"Cannot find module\" errors. Disabling this may make your `build.zip` too large. If that's the case, try using the `includeInBuild` option in your `.zapierapprc`. See the docs about `includeInBuild` for more info"),
                ),
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
        ),
        (
            name: "register",
            description: Some("Register a new integration in your account"),
            options: [
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
            arguments: [
                (
                    name: "title",
                    description: Some("Your integrations's public title. Asked interactively if not present"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "scaffold",
            description: Some("Add a starting trigger, create, search, or resource to your integration"),
            options: [
                (
                    names: [
                        "-d",
                        "--dest",
                    ],
                    description: Some("Specify the new file's directory. Use this flag when you want to create a different folder structure such as `src/triggers` instead of the default `triggers`. Defaults to `[triggers|searches|creates]/{noun}`"),
                    arguments: [
                        (
                            name: "dest",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--test-dest",
                    ],
                    description: Some("Specify the new test file's directory. Use this flag when you want to create a different folder structure such as `src/triggers` instead of the default `triggers`. Defaults to `test/[triggers|searches|creates]/{noun}`"),
                    arguments: [
                        (
                            name: "test-dest",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-e",
                        "--entry",
                    ],
                    description: Some("Supply the path to your integration's root (`index.js`). Only needed if your `index.js` is in a subfolder, like `src`"),
                    arguments: [
                        (
                            name: "entry",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-f",
                        "--force",
                    ],
                    description: Some("Should we overwrite an existing trigger/search/create file?"),
                ),
                (
                    names: [
                        "--no-help",
                    ],
                    description: Some("When scaffolding, should we skip adding helpful intro comments? Useful if this isn't your first rodeo"),
                ),
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
            arguments: [
                (
                    name: "actionType",
                    suggestions: [
                        (
                            name: "trigger",
                        ),
                        (
                            name: "search",
                        ),
                        (
                            name: "create",
                        ),
                        (
                            name: "resource",
                        ),
                    ],
                ),
                (
                    name: "noun",
                ),
            ],
        ),
        (
            name: "team:add",
            aliases: [
                "team:invite",
            ],
            description: Some("Add a team member to your integration"),
            options: [
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
            arguments: [
                (
                    name: "email",
                    description: Some("The user to be invited. If they don't have a Zapier account, they'll be prompted to create one"),
                ),
                (
                    name: "role",
                    description: Some("The level the invited team member should be at. Admins can edit everything and get email updates. Subscribers only get email updates"),
                    suggestions: [
                        (
                            name: "admin",
                        ),
                        (
                            name: "subscriber",
                        ),
                    ],
                ),
                (
                    name: "message",
                    description: Some("A message sent in the email to your team member, if you need to provide context. Wrap the message in quotes to ensure spaces get saved"),
                    optional: true,
                ),
            ],
            presentation: (
                dangerous: true,
            ),
        ),
        (
            name: "team:get",
            aliases: [
                "team:list",
            ],
            description: Some("Get team members involved with your integration"),
            options: [
                (
                    names: [
                        "-f",
                        "--format",
                    ],
                    description: Some("Change the way structured data is presented. If \"json\" or \"raw\", you can pipe the output of the command into other tools, such as jq"),
                    arguments: [
                        (
                            name: "format",
                            suggestions: [
                                (
                                    name: "plain",
                                ),
                                (
                                    name: "json",
                                ),
                                (
                                    name: "raw",
                                ),
                                (
                                    name: "row",
                                ),
                                (
                                    name: "table",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
        ),
        (
            name: "team:remove",
            aliases: [
                "team:delete",
            ],
            description: Some("Remove a team member from all versions of your integration"),
            options: [
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
            presentation: (
                dangerous: true,
            ),
        ),
        (
            name: "test",
            description: Some("Test your integration via the \"test\" script in your \"package.json\""),
            options: [
                (
                    names: [
                        "--skip-validate",
                    ],
                    description: Some("Forgo running `zapier validate` before tests are run. This will speed up tests if you're modifying functionality of an existing integration rather than adding new actions"),
                ),
                (
                    names: [
                        "--yarn",
                    ],
                    description: Some("Use `yarn` instead of `npm`. This happens automatically if there's a `yarn.lock` file, but you can manually force `yarn` if you run tests from a sub-directory"),
                ),
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
        ),
        (
            name: "upload",
            description: Some("Upload the latest build of your integration to Zapier"),
            options: [
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
        ),
        (
            name: "users:add",
            aliases: [
                "users:invite",
            ],
            description: Some("Add a user to some or all versions of your integration"),
            options: [
                (
                    names: [
                        "-f",
                        "--force",
                    ],
                    description: Some("Skip confirmation. Useful for running programmatically"),
                    presentation: (
                        dangerous: true,
                    ),
                ),
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
            arguments: [
                (
                    name: "email",
                    description: Some("The user to be invited. If they don't have a Zapier account, they'll be prompted to create one"),
                ),
                (
                    name: "version",
                    description: Some("A version string (like 1.2.3). Optional, used only if you want to invite a user to a specific version instead of all versions"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "users:get",
            aliases: [
                "users:list",
            ],
            description: Some("Get a list of users who have been invited to your integration"),
            options: [
                (
                    names: [
                        "-f",
                        "--format",
                    ],
                    description: Some("Change the way structured data is presented. If \"json\" or \"raw\", you can pipe the output of the command into other tools, such as jq"),
                    arguments: [
                        (
                            name: "format",
                            suggestions: [
                                (
                                    name: "plain",
                                ),
                                (
                                    name: "json",
                                ),
                                (
                                    name: "raw",
                                ),
                                (
                                    name: "row",
                                ),
                                (
                                    name: "table",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
        ),
        (
            name: "users:links",
            description: Some("Get a list of links that are used to invite users to your integration"),
            options: [
                (
                    names: [
                        "-f",
                        "--format",
                    ],
                    description: Some("Change the way structured data is presented. If \"json\" or \"raw\", you can pipe the output of the command into other tools, such as jq"),
                    arguments: [
                        (
                            name: "format",
                            suggestions: [
                                (
                                    name: "plain",
                                ),
                                (
                                    name: "json",
                                ),
                                (
                                    name: "raw",
                                ),
                                (
                                    name: "row",
                                ),
                                (
                                    name: "table",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Show extra debugging output"),
                ),
            ],
        ),
        (
            name: "users:remove",
            aliases: [
                "users:delete",
            ],
            description: Some("Remove a user from all versions of your integration"),
            options: [
                (
                    names: [
                        "-f",
                        "--force",
                    ],
