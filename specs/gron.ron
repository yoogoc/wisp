(
    version: 1,
    command: "gron",
    description: Some("Gron is a tool to make it easier to understand big blobs of JSON"),
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for gron"),
        ),
        (
            names: [
                "-u",
                "--ungron",
            ],
            description: Some("Reverse the operation (turn assignments back into JSON)"),
        ),
        (
            names: [
                "-v",
                "--values",
            ],
            description: Some("Print just the values of provided assignments"),
        ),
        (
            names: [
                "-c",
                "--colorize",
            ],
            description: Some("Colorize output (default on tty)"),
        ),
        (
            names: [
                "-m",
                "--monochrome",
            ],
            description: Some("Monochrome (don't colorize output)"),
        ),
        (
            names: [
                "-s",
                "--stream",
            ],
            description: Some("Treat each line of input as a separate JSON object"),
        ),
        (
            names: [
                "-k",
                "--insecure",
            ],
            description: Some("Disable certificate validation"),
        ),
        (
            names: [
                "-j",
                "--json",
            ],
            description: Some("Represent gron data as JSON stream"),
        ),
        (
            names: [
                "--no-sort",
            ],
            description: Some("Don't sort output (faster)"),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Print version information"),
        ),
    ],
)
