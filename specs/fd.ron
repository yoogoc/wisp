(
    version: 1,
    command: "fd",
    description: Some("A simple, fast and user-friendly alternative to 'find'"),
    options: [
        (
            names: [
                "-H",
                "--hidden",
            ],
            description: Some("Search hidden files and directories"),
        ),
        (
            names: [
                "-I",
                "--no-ignore",
            ],
            description: Some("Do not respect .(git|fd)ignore files"),
        ),
        (
            names: [
                "-s",
                "--case-sensitive",
            ],
            description: Some("Case-sensitive search (default: smart case)"),
        ),
        (
            names: [
                "-i",
                "--ignore-case",
            ],
            description: Some("Case-insensitive search (default: smart case)"),
        ),
        (
            names: [
                "-g",
                "--glob",
            ],
            description: Some("Glob-based search (default: regular expression)"),
        ),
        (
            names: [
                "-a",
                "--absolute-path",
            ],
            description: Some("Show absolute instead of relative paths"),
        ),
        (
            names: [
                "-l",
                "--list-details",
            ],
            description: Some("Use a long listing format with file metadata"),
        ),
        (
            names: [
                "-L",
                "--follow",
            ],
            description: Some("Follow symbolic links"),
        ),
        (
            names: [
                "-p",
                "--full-path",
            ],
            description: Some("Search full path (default: file-/dirname only)"),
        ),
        (
            names: [
                "-0",
                "--print0",
            ],
            description: Some("Separate results by the null character"),
        ),
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Prints help information"),
        ),
        (
            names: [
                "-V",
                "--version",
            ],
            description: Some("Prints version information"),
        ),
        (
            names: [
                "-d",
                "--max-depth",
            ],
            description: Some("Set maximum search depth"),
            arguments: [
                (
                    name: "depth",
                ),
            ],
        ),
        (
            names: [
                "-t",
                "--type",
            ],
            description: Some("Filter by type"),
            arguments: [
                (
                    name: "filetype",
                    suggestions: [
                        (
                            name: "f",
                            description: Some("File"),
                        ),
                        (
                            name: "d",
                            description: Some("Directory"),
                        ),
                        (
                            name: "l",
                            description: Some("Symlink"),
                        ),
                        (
                            name: "x",
                            description: Some("Executable"),
                        ),
                        (
                            name: "e",
                            description: Some("Empty"),
                        ),
                        (
                            name: "s",
                            description: Some("Socket"),
                        ),
                        (
                            name: "p",
                            description: Some("Pipe"),
                        ),
                    ],
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "-e",
                "--extension",
            ],
            description: Some("Filter by file extension"),
            arguments: [
                (
                    name: "file extension",
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "-x",
                "--exec",
            ],
            description: Some("Execute a command for each search result"),
            arguments: [
                (
                    name: "cmd",
                    is_command: true,
                ),
            ],
        ),
        (
            names: [
                "-X",
                "--exec-batch",
            ],
            description: Some("Execute a command with all search results at once"),
            arguments: [
                (
                    name: "cmd",
                    is_command: true,
                ),
            ],
        ),
        (
            names: [
                "-E",
                "--exclude",
            ],
            description: Some("Exclude entries that match the given glob pattern"),
            arguments: [
                (
                    name: "pattern",
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "-c",
                "--color",
            ],
            description: Some("When to use colors"),
            arguments: [
                (
                    name: "when",
                    suggestions: [
                        (
                            name: "never",
                        ),
                        (
                            name: "auto",
                        ),
                        (
                            name: "always",
                        ),
                    ],
                    default: Some("auto"),
                ),
            ],
        ),
        (
            names: [
                "-S",
                "--size",
            ],
            description: Some("Limit results based on the size of files"),
            arguments: [
                (
                    name: "size",
                ),
            ],
        ),
        (
            names: [
                "--changed-within",
            ],
            description: Some("Filter by file modification time (newer than)"),
            arguments: [
                (
                    name: "date",
                ),
            ],
        ),
        (
            names: [
                "--changed-before",
            ],
            description: Some("Filter by file modification time (older than)"),
            arguments: [
                (
                    name: "date",
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "pattern",
            description: Some("The search pattern - a regular expression unless '--glob' is used (optional)"),
        ),
        (
            name: "path",
            description: Some("The root directories for the filesystem search"),
            template: [
                Folders,
            ],
            optional: true,
            variadic: true,
        ),
    ],
)
