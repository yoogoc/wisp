(
    version: 1,
    command: "v",
    description: Some("The V Programming Language"),
    subcommands: [
        (
            name: "run",
            description: Some("Compile and run the program"),
            arguments: [
                (
                    name: "file",
                    description: Some("The input file"),
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "crun",
            description: Some("Compile if executable inexistent or not updated and run the program"),
            arguments: [
                (
                    name: "file",
                    description: Some("The input file"),
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "watch",
            description: Some("Watch the file for changes and recompile"),
            subcommands: [
                (
                    name: "run",
                    description: Some("Run the program after recompiling"),
                    arguments: [
                        (
                            name: "file",
                            description: Some("The input file"),
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "file",
                    description: Some("The input file"),
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "new",
            description: Some("Setup the file structure for a V project (in a sub folder)"),
        ),
        (
            name: "init",
            description: Some("Setup the file structure for an already existing V project"),
        ),
        (
            name: "test",
            description: Some("Run all test files in the provided directory"),
        ),
        (
            name: "fmt",
            description: Some("Format the V code provided"),
            arguments: [
                (
                    name: "file",
                    description: Some("The input file"),
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "vet",
            description: Some("Report suspicious code constructs"),
        ),
        (
            name: "doc",
            description: Some("Generate documentation for a V module"),
        ),
        (
            name: "vlib-docs",
            description: Some("Generate and open the documentation of all the vlib modules"),
        ),
        (
            name: "repl",
            description: Some("Run the REPL"),
        ),
        (
            name: "where",
            description: Some("Find and print the location of current project declarations"),
        ),
        (
            name: "symlink",
            description: Some("Create a symbolic link for V"),
        ),
        (
            name: "up",
            description: Some("Run the V self-updater"),
        ),
        (
            name: "self",
            description: Some("Run the V self-compiler"),
            options: [
                (
                    names: [
                        "-prod",
                    ],
                    description: Some("Compile V for production (optimize compilation)"),
                ),
            ],
        ),
        (
            name: "help",
            description: Some("Display help for V"),
            subcommands: [
                (
                    name: "other",
                    description: Some("Display help for less frequently used commands"),
                ),
                (
                    name: "topics",
                    description: Some("Display a list of all known help topics"),
                ),
            ],
            arguments: [
                (
                    name: "",
                    generators: [
                        (
                            script: [
                                "v",
                                "help",
                                "topics",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for V"),
        ),
        (
            names: [
                "version",
                "--version",
                "-v",
            ],
            description: Some("Show V installed version"),
        ),
    ],
    arguments: [
        (
            name: "file",
            description: Some("The file to compile"),
            template: [
                FilePaths,
            ],
        ),
    ],
    parser_directives: Some((
        flags_are_posix_noncompliant: true,
    )),
)
