(
    version: 1,
    command: "mongoimport",
    description: Some("Import data from a JSON, CSV, or TSV file into a MongoDB instance"),
    options: [
        (
            names: [
                "--help",
            ],
            description: Some("Returns information on the options and use of mongoimport"),
        ),
        (
            names: [
                "--verbose",
                "-v",
            ],
            description: Some("Increases the amount of internal reporting returned on standard output or in log files"),
        ),
        (
            names: [
                "--quiet",
            ],
            description: Some("Runs mongoimport in a quiet mode that attempts to limit the amount of output"),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Returns the mongoimport release number"),
        ),
        (
            names: [
                "--config",
            ],
            description: Some("Specifies the full path to a YAML configuration file containing sensitive values for the following options to mongoimport"),
            arguments: [
                (
                    name: "filename",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--uri",
            ],
            description: Some("Specifies the resolvable URI connection string of the MongoDB deployment"),
            arguments: [
                (
                    name: "connectionString",
                    description: Some("MongoDB connection string"),
                    suggestions: [
                        (
                            name: "mongodb://localhost:27017",
                            description: Some("Default Connection String"),
                        ),
                        (
                            name: "mongodb+srv://username:password@cluster0.example.mongodb.net/database",
                            description: Some("Atlas Connection String Example"),
                            presentation: (
                                priority: Some(35.0),
                            ),
                        ),
                    ],
                ),
            ],
            presentation: (
                priority: Some(100.0),
            ),
        ),
        (
            names: [
                "--host",
                "-h",
            ],
            description: Some("Specifies the resolvable hostname of the MongoDB deployment"),
            arguments: [
                (
                    name: "hostname:port",
                    suggestions: [
                        (
                            name: "localhost:27017",
                            description: Some("Default host"),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--port",
            ],
            description: Some("Specifies the TCP port on which the MongoDB instance listens for client connections"),
            arguments: [
                (
                    name: "port",
                    suggestions: [
                        (
                            name: "27017",
                            description: Some("Default port"),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--ssl",
            ],
            description: Some("Enables connection to a mongod or mongos that has TLS/SSL support enabled"),
        ),
        (
            names: [
                "--sslCAFile",
            ],
            description: Some("Specifies the .pem file that contains the root certificate chain from the Certificate Authority"),
            arguments: [
                (
                    name: "filename",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--sslPEMKeyFile",
            ],
            description: Some("Specifies the .pem file that contains both the TLS/SSL certificate and key"),
            arguments: [
                (
                    name: "filename",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--sslPEMKeyPassword",
            ],
            description: Some("Specifies the password to de-crypt the certificate-key file (i.e. --sslPEMKeyFile)"),
            arguments: [
                (
                    name: "value",
                    description: Some("Password"),
                    dangerous: true,
                ),
            ],
        ),
        (
            names: [
                "--sslCRLFile",
            ],
            description: Some("Specifies the .pem file that contains the Certificate Revocation List"),
            arguments: [
                (
                    name: "filename",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--sslAllowInvalidCertificates",
            ],
            description: Some("Bypasses the validation checks for server certificates and allows the use of invalid certificates"),
        ),
        (
            names: [
                "--sslAllowInvalidHostnames",
            ],
            description: Some("Disables the validation of the hostnames in TLS/SSL certificates"),
        ),
        (
            names: [
                "--username",
                "-u",
            ],
            description: Some("Specifies a username with which to authenticate to a MongoDB database that uses authentication"),
            arguments: [
                (
                    name: "username",
                ),
            ],
        ),
        (
            names: [
                "--password",
                "-p",
            ],
            description: Some("Specifies a password with which to authenticate to a MongoDB database that uses authentication"),
            arguments: [
                (
                    name: "password",
                    dangerous: true,
                ),
            ],
            depends_on: [
                "--username",
            ],
        ),
        (
            names: [
                "--awsSessionToken",
            ],
            description: Some("Specifies the session token for MONGODB-AWS authentication mechanism"),
            arguments: [
                (
                    name: "AWS Session Token",
                ),
            ],
        ),
        (
            names: [
                "--authenticationDatabase",
            ],
            description: Some("Specifies the authentication database where the specified --username has been created"),
            arguments: [
                (
                    name: "dbname",
                    description: Some("Database name"),
                ),
            ],
        ),
        (
            names: [
                "--authenticationMechanism",
            ],
            description: Some("Specifies the authentication mechanism the mongoimport instance uses to authenticate to the mongod or mongos"),
            arguments: [
                (
                    name: "name",
                    suggestions: [
                        (
                            name: "SCRAM-SHA-1",
                            description: Some("Default"),
                        ),
                        (
                            name: "SCRAM-SHA-256",
                        ),
                        (
                            name: "MONGODB-X509",
                        ),
                        (
                            name: "MONGODB-AWS",
                        ),
                        (
                            name: "GSSAPI",
                        ),
                        (
                            name: "PLAIN",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--gssapiServiceName",
            ],
            description: Some("Specify the name of the service using GSSAPI/Kerberos. This option is available only in MongoDB Enterprise"),
            arguments: [
                (
                    name: "serviceName",
                ),
            ],
        ),
        (
            names: [
                "--gssapiHostName",
            ],
            description: Some("Specify the hostname of the service using GSSAPI/Kerberos. This option is available only in MongoDB Enterprise"),
            arguments: [
                (
                    name: "hostname",
                ),
            ],
        ),
        (
            names: [
                "--db",
                "-d",
            ],
            description: Some("Specifies the name of the database on which to run the mongoimport"),
            arguments: [
                (
                    name: "database",
                ),
            ],
        ),
        (
            names: [
                "--collection",
                "-c",
            ],
            description: Some("Specifies the name of the collection to import"),
            arguments: [
                (
                    name: "collection",
                ),
            ],
            presentation: (
                priority: Some(90.0),
            ),
        ),
        (
            names: [
                "--fields",
                "-f",
            ],
            description: Some("Specify a comma separated list of field names when importing CSV or TSV files that do not have field names in the first (i.e. header) line of the file"),
            arguments: [
                (
                    name: "field1,field2,...",
                    description: Some("Comma separated list of fields"),
                ),
            ],
            exclusive_on: [
                "--fieldFile",
            ],
        ),
        (
            names: [
                "--fieldFile",
            ],
            description: Some("Specify a file containing a comma separated list of field names when importing CSV or TSV files that do not have field names in the first (i.e. header) line of the file"),
            arguments: [
                (
                    name: "filename",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                ),
            ],
            exclusive_on: [
                "--fields",
                "-f",
            ],
        ),
        (
            names: [
                "--ignoreBlanks",
            ],
            description: Some("Ignores empty fields in CSV and TSV exports"),
        ),
        (
            names: [
                "--type",
            ],
            description: Some("Specifies the file type to import"),
            arguments: [
                (
                    name: "type",
                    suggestions: [
                        (
                            name: "json",
                            description: Some("JSON"),
                        ),
                        (
                            name: "csv",
                            description: Some("Comma-separated values"),
                        ),
                        (
                            name: "tsv",
                            description: Some("Tab-separated values"),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--file",
            ],
            description: Some("Specifies the location and name of a file containing the data to import"),
            arguments: [
                (
                    name: "filename",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                ),
            ],
            presentation: (
                priority: Some(80.0),
            ),
        ),
        (
            names: [
                "--drop",
            ],
            description: Some("Modifies the import process so that the target instance drops the collection before importing the data from the input"),
        ),
        (
            names: [
                "--headerline",
            ],
            description: Some("Treats the first line of the input file as a header line"),
        ),
        (
            names: [
                "--useArrayIndexFields",
            ],
            description: Some("Interpret natural numbers in fields as array indexes when importing CSV or TSV files"),
        ),
        (
            names: [
                "--mode",
            ],
            description: Some("Specifies how the import process should handle existing documents in the database that match documents in the import file"),
            arguments: [
                (
                    name: "mode",
                    suggestions: [
                        (
                            name: "insert",
                            description: Some("Insert the documents in the import file"),
                        ),
                        (
                            name: "upsert",
                            description: Some("Replace existing documents in the database with matching documents from the import file"),
                        ),
                        (
                            name: "merge",
                            description: Some("Merge existing documents that match a document in the import file with the new document"),
                        ),
                        (
                            name: "delete",
                            description: Some("Delete existing documents in the database that match a document in the import file"),
                        ),
                    ],
                ),
            ],
            presentation: (
                priority: Some(80.0),
            ),
        ),
        (
            names: [
                "--upsertFields",
            ],
            description: Some("Specifies a list of fields for the query portion of the import process"),
            arguments: [
                (
                    name: "field1,field2,...",
                    description: Some("Comma separated list of fields"),
                ),
            ],
        ),
        (
            names: [
                "--stopOnError",
            ],
            description: Some("Forces mongoimport to halt the insert operation at the first error rather than continuing the operation despite errors"),
        ),
        (
            names: [
                "jsonArray",
            ],
            description: Some("Accepts the import of data expressed with multiple MongoDB documents within a single JSON array"),
        ),
        (
            names: [
                "--legacy",
            ],
            description: Some("Indicates that the import data is in Extended JSON v1 format"),
        ),
        (
            names: [
                "--maintainInsertionOrder",
            ],
            description: Some("Maintains the order of documents in the import file when inserting documents into the database"),
        ),
        (
            names: [
                "--numInsertionWorkers",
            ],
            description: Some("Specifies the number of insertion workers to run concurrently"),
            arguments: [
                (
                    name: "number",
                    description: Some("Number of workers"),
                    default: Some("1"),
                ),
            ],
        ),
        (
            names: [
                "--writeConcern",
            ],
            description: Some("Specifies the write concern for each write operation that mongoimport performs"),
            arguments: [
                (
                    name: "document",
                    default: Some("{w:'majority'}"),
                ),
            ],
        ),
        (
            names: [
                "--bypassDocumentValidation",
            ],
            description: Some("Enables mongoimport to bypass document validation during the operation"),
        ),
        (
            names: [
                "--columnsHaveTypes",
            ],
            description: Some("Instructs mongoimport that the field list specified in --fields, --fieldFile, or --headerline specifies the types of each field"),
        ),
        (
            names: [
                "--parseGrace",
            ],
            description: Some("Specifies how mongoimport handles type coercion failures when importing CSV or TSV files with --columnsHaveTypes"),
            arguments: [
                (
                    name: "grace",
                    suggestions: [
                        (
                            name: "autoCast",
                        ),
                        (
                            name: "skipField",
                        ),
                        (
                            name: "skipRow",
                        ),
                        (
                            name: "stop",
                        ),
                    ],
                    default: Some("stop"),
                ),
            ],
        ),
    ],
)
