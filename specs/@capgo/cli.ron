(
    version: 1,
    command: "cli",
    description: Some("Manage packages and bundle versions in Capgo Cloud"),
    subcommands: [
        (
            name: "login",
            description: Some("Save apikey to your machine or folder"),
            options: [
                (
                    names: [
                        "--local",
                    ],
                    description: Some("Only save in local folder"),
                ),
            ],
            arguments: [
                (
                    name: "apikey",
                ),
            ],
        ),
        (
            name: "doctor",
            description: Some("Get info about your Capgo app install"),
        ),
        (
            name: "init",
            description: Some("Init a new app"),
            options: [
                (
                    names: [
                        "-n",
                        "--name",
                    ],
                    description: Some("App name"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                ),
                (
                    names: [
                        "-i",
                        "--icon",
                    ],
                    description: Some("App icon path"),
                    arguments: [
                        (
                            name: "icon",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-a",
                        "--apikey",
                    ],
                    description: Some("Apikey to link to your account"),
                    arguments: [
                        (
                            name: "apikey",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "apikey",
                ),
                (
                    name: "appId",
                ),
            ],
        ),
        (
            name: "app",
            description: Some("Manage app"),
            subcommands: [
                (
                    name: "add",
                    aliases: [
                        "a",
                    ],
                    description: Some("Add a new app in Capgo Cloud"),
                    options: [
                        (
                            names: [
                                "-n",
                                "--name",
                            ],
                            description: Some("App name"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-i",
                                "--icon",
                            ],
                            description: Some("App icon path"),
                            arguments: [
                                (
                                    name: "icon",
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-a",
                                "--apikey",
                            ],
                            description: Some("Apikey to link to your account"),
                            arguments: [
                                (
                                    name: "apikey",
                                ),
                            ],
                        ),
                    ],
                    arguments: [
                        (
                            name: "appId",
                        ),
                    ],
                ),
                (
                    name: "delete",
                    aliases: [
                        "d",
                    ],
                    description: Some("Delete an app in Capgo Cloud"),
                    options: [
                        (
                            names: [
                                "-a",
                                "--apikey",
                            ],
                            description: Some("Apikey to link to your account"),
                            arguments: [
                                (
                                    name: "apikey",
                                ),
                            ],
                        ),
                    ],
                    arguments: [
                        (
                            name: "appId",
                        ),
                    ],
                ),
                (
                    name: "list",
                    aliases: [
                        "l",
                    ],
                    description: Some("List apps in Capgo Cloud"),
                    options: [
                        (
                            names: [
                                "-a",
                                "--apikey",
                            ],
                            description: Some("Apikey to link to your account"),
                            arguments: [
                                (
                                    name: "apikey",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "debug",
                    description: Some("Listen for live updates event in Capgo Cloud to debug your app"),
                    options: [
                        (
                            names: [
                                "-a",
                                "--apikey",
                            ],
                            description: Some("Apikey to link to your account"),
                            arguments: [
                                (
                                    name: "apikey",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-d",
                                "--device",
                            ],
                            description: Some("The specific device to debug"),
                            arguments: [
                                (
                                    name: "device",
                                ),
                            ],
                        ),
                    ],
                    arguments: [
                        (
                            name: "appId",
                        ),
                    ],
                ),
                (
                    name: "set",
                    aliases: [
                        "s",
                    ],
                    description: Some("Set an app in Capgo Cloud"),
                    options: [
                        (
                            names: [
                                "-n",
                                "--name",
                            ],
                            description: Some("App name"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-i",
                                "--icon",
                            ],
                            description: Some("App icon path"),
                            arguments: [
                                (
                                    name: "icon",
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-a",
                                "--apikey",
                            ],
                            description: Some("Apikey to link to your account"),
                            arguments: [
                                (
                                    name: "apikey",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-r",
                                "--retention",
                            ],
                            description: Some("Retention period of app bundle in days"),
                            arguments: [
                                (
                                    name: "retention",
                                ),
                            ],
                        ),
                    ],
                    arguments: [
                        (
                            name: "appId",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "bundle",
            description: Some("Manage bundle"),
            subcommands: [
                (
                    name: "delete",
                    aliases: [
                        "d",
                    ],
                    description: Some("Delete a bundle in Capgo Cloud"),
                    options: [
                        (
                            names: [
                                "-a",
                                "--apikey",
                            ],
                            description: Some("Apikey to link to your account"),
                            arguments: [
                                (
                                    name: "apikey",
                                ),
                            ],
                        ),
                    ],
                    arguments: [
                        (
                            name: "bundleId",
                        ),
                        (
                            name: "appId",
                        ),
                    ],
                ),
                (
                    name: "decrypt",
                    aliases: [
                        "l",
                    ],
                    description: Some("Decrypt a signed zip bundle"),
                    options: [
                        (
                            names: [
                                "--key",
                            ],
                            description: Some("Custom path for private signing key"),
                            arguments: [
                                (
                                    name: "key",
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--key-data",
                            ],
                            description: Some("Base64 private signing key"),
                            arguments: [
                                (
                                    name: "keyData",
                                ),
                            ],
                        ),
                    ],
                    arguments: [
                        (
                            name: "zipPath",
                            template: [
                                FilePaths,
                            ],
                        ),
                        (
                            name: "sessionKey",
                        ),
                    ],
                ),
                (
                    name: "encrypt",
                    description: Some("Encrypt a zip bundle"),
                    options: [
                        (
                            names: [
                                "--key",
                            ],
                            description: Some("Custom path for private signing key"),
                            arguments: [
                                (
                                    name: "key",
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--key-data",
                            ],
                            description: Some("Base64 private signing key"),
                            arguments: [
                                (
                                    name: "keyData",
                                ),
                            ],
                        ),
                    ],
                    arguments: [
                        (
                            name: "zipPath",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    name: "zip",
                    description: Some("Zip a bundle"),
                    options: [
                        (
                            names: [
                                "-p",
                                "--path",
                            ],
                            description: Some("Path of the folder to upload"),
                            arguments: [
                                (
                                    name: "path",
                                    template: [
                                        Folders,
                                    ],
                                ),
                            ],
                        ),
                    ],
                    arguments: [
                        (
                            name: "appId",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "channel",
            description: Some("Manage channel"),
            subcommands: [
                (
                    name: "add",
                    aliases: [
                        "a",
                    ],
                    description: Some("Create channel"),
                    options: [
                        (
                            names: [
                                "-d",
                                "--default",
                            ],
                            description: Some("Set the channel as default"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "channelId",
                        ),
                        (
                            name: "appId",
                        ),
                    ],
                ),
                (
                    name: "delete",
                    aliases: [
                        "d",
                    ],
                    description: Some("Delete channel"),
                    arguments: [
                        (
                            name: "channelId",
                        ),
                        (
                            name: "appId",
                        ),
                    ],
                ),
                (
                    name: "list",
                    aliases: [
                        "l",
                    ],
                    description: Some("List channel"),
                    arguments: [
                        (
                            name: "appId",
                        ),
                    ],
                ),
                (
                    name: "currentBundle",
                    description: Some("Get current bundle for specific channel in Capgo Cloud"),
                    options: [
                        (
                            names: [
                                "-c",
                                "--channel",
                            ],
                            description: Some("Channel to get the current bundle from"),
                            arguments: [
                                (
                                    name: "channel",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-a",
                                "--apikey",
                            ],
                            description: Some("Apikey to link to your account"),
                            arguments: [
                                (
                                    name: "apikey",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--quiet",
                            ],
                            description: Some("Only print the bundle version"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "channel",
                        ),
                        (
                            name: "appId",
                        ),
                    ],
                ),
                (
                    name: "set",
                    aliases: [
                        "s",
                    ],
                    description: Some("Set channel"),
                    arguments: [
                        (
                            name: "channelId",
                        ),
                        (
                            name: "appId",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "key",
            description: Some("Manage key"),
            subcommands: [
                (
                    name: "save",
                    description: Some("Save base64 signing key in capacitor config, useful for CI"),
                    options: [
                        (
                            names: [
                                "-f",
                                "--force",
                            ],
                            description: Some("Force generate a new one"),
                        ),
                        (
                            names: [
                                "--key",
                            ],
                            description: Some("Key path to save in capacitor config"),
                            arguments: [
                                (
                                    name: "key",
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--key-data",
                            ],
                            description: Some("Key data to save in capacitor config"),
                            arguments: [
                                (
                                    name: "keyData",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "create",
                    description: Some("Create a new signing key"),
                    options: [
                        (
                            names: [
                                "-f",
                                "--force",
                            ],
                            description: Some("Force generate a new one"),
                        ),
                    ],
                ),
            ],
        ),
    ],
)
