(
    version: 1,
    command: "svtplay-dl",
    description: Some("Download videos from your favourite play services"),
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for svtplay-dl"),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Show program's version number and exit"),
        ),
        (
            names: [
                "-o",
                "--output",
            ],
            description: Some("Outputs to the given filename or folder"),
        ),
        (
            names: [
                "--subfolder",
            ],
            description: Some("Create a subfolder titled as the show, non-series gets in folder movies"),
        ),
        (
            names: [
                "--config",
            ],
            description: Some("Specify configuration file"),
            arguments: [
                (
                    name: "configfile",
                ),
            ],
        ),
        (
            names: [
                "-f",
                "--force",
            ],
            description: Some("Overwrite if file exists already"),
        ),
        (
            names: [
                "-r",
                "--resume",
            ],
            description: Some("Resume a download (RTMP obsolete)"),
        ),
        (
            names: [
                "-l",
                "--live",
            ],
            description: Some("Enable for live streams (RTMP based ones)"),
        ),
        (
            names: [
                "-c",
                "--capture_time",
            ],
            description: Some("Define capture time in minutes of a live stream"),
            arguments: [
                (
                    name: "capture_time",
                ),
            ],
        ),
        (
            names: [
                "-s",
                "--silent",
            ],
            description: Some("Be less verbose"),
        ),
        (
            names: [
                "--silent-semi",
            ],
            description: Some("Only show a message when the file is downloaded"),
        ),
        (
            names: [
                "-u",
                "--username",
            ],
            description: Some("Username (if applicable)"),
            arguments: [
                (
                    name: "username",
                ),
            ],
        ),
        (
            names: [
                "-p",
                "--password",
            ],
            description: Some("Password (if applicable)"),
            arguments: [
                (
                    name: "password",
                ),
            ],
        ),
        (
            names: [
                "-t",
                "--thumbnail",
            ],
            description: Some("Download thumbnail from the site if available"),
        ),
        (
            names: [
                "-g",
                "--get-url",
            ],
            description: Some("Do not download any video, but instead print the URL"),
        ),
        (
            names: [
                "--get-only-episode-url",
            ],
            description: Some("Do not get video URLs, only print the episode URL"),
        ),
        (
            names: [
                "--dont-verify-ssl-cert",
            ],
            description: Some("Don't attempt to verify SSL certificates"),
        ),
        (
            names: [
                "--http-header",
            ],
            description: Some("A header to add to each HTTP request"),
            arguments: [
                (
                    name: "header1=value;header2=value2",
                ),
            ],
        ),
        (
            names: [
                "--cookies",
            ],
            description: Some("A cookies to add to each HTTP request"),
            arguments: [
                (
                    name: "cookie1=value;cookie2=value2",
                ),
            ],
        ),
        (
            names: [
                "--exclude",
            ],
            description: Some("Exclude videos with the WORD(s) in the filename. Comma separated"),
            arguments: [
                (
                    name: "WORD1,WORD2,...",
                ),
            ],
        ),
        (
            names: [
                "--after-date",
            ],
            description: Some("Only videos published on or after this date"),
            arguments: [
                (
                    name: "yyyy-MM-dd",
                ),
            ],
        ),
        (
            names: [
                "--proxy",
            ],
            description: Some("Use the specified HTTP/HTTPS/SOCKS proxy. To enable experimental SOCKS proxy, specify a proper scheme. For example socks5://127.0.0.1:1080/"),
            arguments: [
                (
                    name: "proxy",
                ),
            ],
        ),
        (
            names: [
                "-v",
                "--verbose",
            ],
            description: Some("Explain what is going on"),
        ),
        (
            names: [
                "--nfo",
            ],
            description: Some("Create a NFO file"),
        ),
        (
            names: [
                "--force-nfo",
            ],
            description: Some("Download only NFO if used with --nfo"),
        ),
        (
            names: [
                "--only-audio",
            ],
            description: Some("Only download audio if audio and video is separated"),
        ),
        (
            names: [
                "--only-video",
            ],
            description: Some("Only download video if audio and video is separated"),
        ),
        (
            names: [
                "-q",
                "--quality",
            ],
            description: Some("Choose what format to download based on bitrate/video resolution. It will download the best format by default"),
            arguments: [
                (
                    name: "quality",
                ),
            ],
        ),
        (
            names: [
                "-Q",
                "--flexible-quality",
            ],
            description: Some("Allow given quality (as above) to differ by an amount"),
            arguments: [
                (
                    name: "amount",
                ),
            ],
        ),
        (
            names: [
                "-P",
                "--preferred",
            ],
            description: Some("Preferred download method (dash, hls, or http)"),
            arguments: [
                (
                    name: "preferred",
                ),
            ],
        ),
        (
            names: [
                "--list-quality",
            ],
            description: Some("List the quality for a video"),
        ),
        (
            names: [
                "--stream-priority",
            ],
            description: Some("If two streams have the same quality, choose the one you prefer"),
            arguments: [
                (
                    name: "dash,hls,http",
                ),
            ],
        ),
        (
            names: [
                "--format-preferred",
            ],
            description: Some("Choose the format you prefer, use --list-quality to show which one to choose from"),
            arguments: [
                (
                    name: "h264,h264-51",
                ),
            ],
        ),
        (
            names: [
                "--audio-language",
            ],
            description: Some("Choose the language of the audio (it can override the default one), use --list-quality to show which one to choose from"),
            arguments: [
                (
                    name: "AUDIO_LANGUAGE",
                ),
            ],
        ),
        (
            names: [
                "--audio-role",
            ],
            description: Some("Choose the role of the audio (it can override the default one), use --list-quality to show which one to choose from"),
            arguments: [
                (
                    name: "AUDIO_ROLE",
                ),
            ],
        ),
        (
            names: [
                "-S",
                "--subtitle",
            ],
            description: Some("Download subtitle from the site if available"),
        ),
        (
            names: [
                "-M",
                "--merge-subtitle",
            ],
            description: Some("Merge subtitle with video/audio file with corresponding ISO639-3 language code. This invokes --remux automatically"),
        ),
        (
            names: [
                "--force-subtitle",
            ],
            description: Some("Download only subtitle if its used with -S"),
        ),
        (
            names: [
                "--require-subtitle",
            ],
            description: Some("Download only if a subtitle is available"),
        ),
        (
            names: [
                "--all-subtitles",
            ],
            description: Some("Download all available subtitles for the video"),
        ),
        (
            names: [
                "--raw-subtitles",
            ],
            description: Some("Also download the subtitles in their native format"),
        ),
        (
            names: [
                "--convert-subtitle-colors",
            ],
            description: Some("Converts the color information in subtitles, to <font color=\"\"> tags"),
        ),
        (
            names: [
                "-A",
                "--all-episodes",
            ],
            description: Some("Try to download all episodes"),
        ),
        (
            names: [
                "--all-last",
            ],
            description: Some("Get last NN episodes instead of all episodes"),
            arguments: [
                (
                    name: "NN",
                ),
            ],
        ),
        (
            names: [
                "--include-clips",
            ],
            description: Some("Include clips from websites when using -A"),
        ),
        (
            names: [
                "--cmore-operatorlist",
            ],
            description: Some("Show operatorlist for cmore"),
        ),
        (
            names: [
                "--cmore-operator",
            ],
            arguments: [
                (
                    name: "operator",
                ),
            ],
        ),
        (
            names: [
                "--no-remux",
            ],
            description: Some("Do not automatically remux to mp4"),
        ),
        (
            names: [
                "--no-merge",
            ],
            description: Some("Do not automatically merge video, audio and possibly also subtitle(s) together"),
        ),
        (
            names: [
                "--no-postprocess",
            ],
            description: Some("Do not postprocess anything"),
        ),
        (
            names: [
                "--keep-original",
            ],
            description: Some("Do postprocessing while also keeping original files"),
        ),
        (
            names: [
                "--output-format",
            ],
            description: Some("Format you want resulting file in (mkv or mp4), mp4 is default"),
            arguments: [
                (
                    name: "mp4,mkv",
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "urls",
            description: Some("URLs for the videos you want to download"),
            generators: [
                (
                    script: [
                        "pbpaste",
                    ],
                    has_post_process: true,
                ),
            ],
            variadic: true,
        ),
    ],
)
