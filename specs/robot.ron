(
    version: 1,
    command: "robot",
    description: Some("CLI for running Robot Framework automation tests"),
    options: [
        (
            names: [
                "-h",
                "-?",
                "--help",
            ],
            description: Some("Print usage instructions"),
        ),
        (
            names: [
                "--rpa",
            ],
            description: Some("Turn on the generic automation mode. Mainly affects terminology so that \"test\" is replaced with \"task\" in logs and reports"),
        ),
        (
            names: [
                "-F",
                "--extension",
            ],
            description: Some("Parse only files with this extension when executing a directory"),
            arguments: [
                (
                    name: "extension",
                    description: Some("File extensions divided by colon"),
                    suggestions: [
                        (
                            name: "txt",
                        ),
                        (
                            name: "robot:txt",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-N",
                "--name",
            ],
            description: Some("Set a name of the top level suite"),
            arguments: [
                (
                    name: "name",
                ),
            ],
        ),
        (
            names: [
                "-D",
                "--doc",
            ],
            description: Some("Set a documentation of the top level suite"),
            presentation: (
                insert_value: Some("-D '{cursor}'"),
            ),
        ),
        (
            names: [
                "-M",
                "--metadata",
            ],
            description: Some("Set metadata of the top level suite"),
            arguments: [
                (
                    name: "name:value",
                ),
            ],
            presentation: (
                insert_value: Some("-M {cursor}:"),
            ),
        ),
        (
            names: [
                "-G",
                "--settag",
            ],
            description: Some("Sets given tag to all executed tests"),
            arguments: [
                (
                    name: "tag",
                ),
            ],
        ),
        (
            names: [
                "-t",
                "--test",
            ],
            description: Some("Select tests by name or by long name containing also parent suite name like `Parent.Test`"),
            arguments: [
                (
                    name: "name",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "for i in $(find -E . -regex \".*.robot\" -type f); do cat -s $i ; done",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--task",
            ],
            description: Some("Alias to --test. Especially applicable with --rpa"),
            arguments: [
                (
                    name: "name",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "for i in $(find -E . -regex \".*.robot\" -type f); do cat -s $i ; done",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-s",
                "--suite",
            ],
            description: Some("Select suites by name"),
            arguments: [
                (
                    name: "name",
                ),
            ],
        ),
        (
            names: [
                "-i",
                "--include",
            ],
            description: Some("Select test cases by tag"),
            arguments: [
                (
                    name: "tag",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "for i in $(find -E . -regex \".*.robot\" -type f); do cat -s $i ; done",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-e",
                "--exclude",
            ],
            description: Some("Select test cases not to run by tag"),
            arguments: [
                (
                    name: "tag",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "for i in $(find -E . -regex \".*.robot\" -type f); do cat -s $i ; done",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-R",
                "--rerunfailed",
            ],
            description: Some("Select failed tests from an earlier output file to be re-executed"),
            arguments: [
                (
                    name: "output file",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-S",
                "--rerunfailedsuites",
            ],
            description: Some("Select failed suites from an earlier output file to be re-executed"),
            arguments: [
                (
                    name: "output file",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--runemptysuite",
            ],
            description: Some("Executes suite even if it contains no tests"),
        ),
        (
            names: [
                "--skip",
            ],
            description: Some("Tests having given tag will be skipped"),
            arguments: [
                (
                    name: "tag",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "for i in $(find -E . -regex \".*.robot\" -type f); do cat -s $i ; done",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--skiponfailure",
            ],
            description: Some("Tests having given tag will be skipped if they fail"),
            arguments: [
                (
                    name: "tag",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "for i in $(find -E . -regex \".*.robot\" -type f); do cat -s $i ; done",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-v",
                "--variable",
            ],
            description: Some("Set variables in the test data"),
            arguments: [
                (
                    name: "variable",
                    generators: [
                        (
                            has_custom: true,
                            trigger: Some(OnMatch([
                                    ":",
                                ])),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-V",
                "--variablefile",
            ],
            description: Some("Python or YAML file file to read variables from"),
            arguments: [
                (
                    name: "file",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-d",
                "--outputdir",
            ],
            description: Some("Where to create output files. The default is the directory where tests are run from"),
            arguments: [
                (
                    name: "directory",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-o",
                "--output",
            ],
            description: Some("XML output file relative to --outputdir unless given as an absolute path. Default: output.xml"),
            arguments: [
                (
                    name: "file",
                    suggestions: [
                        (
                            name: "output.xml",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-l",
                "--log",
            ],
            description: Some("HTML log file. Can be disabled by giving a special value `NONE`. Default: log.html"),
            arguments: [
                (
                    name: "file",
                    suggestions: [
                        (
                            name: "log.html",
                        ),
                        (
                            name: "NONE",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-r",
                "--report",
            ],
            description: Some("HTML report file. Can be disabled with `NONE` similarly as --log. Default: report.html"),
            arguments: [
                (
                    name: "file",
                    suggestions: [
                        (
                            name: "report.html",
                        ),
                        (
                            name: "NONE",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-x",
                "--xunit",
            ],
            description: Some("XUnit compatible result file. Not created unless this option is specified"),
            arguments: [
                (
                    name: "file",
                    suggestions: [
                        (
                            name: "xunit.xml",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-b",
                "--debugfile",
            ],
            description: Some("Debug file written during execution. Not created unless this option is specified"),
            arguments: [
                (
                    name: "file",
                ),
            ],
        ),
        (
            names: [
                "-T",
                "--timestampoutputs",
            ],
            description: Some("Adds timestamp in a format `YYYYMMDD-hhmmss` to all generated output files between their basename and extension"),
        ),
        (
            names: [
                "--splitlog",
            ],
            description: Some("Split the log file into smaller pieces that open in browsers transparently"),
        ),
        (
            names: [
                "--logtitle",
            ],
            description: Some("Title for the generated log file. The default title is `<SuiteName> Log.`"),
            arguments: [
                (
                    name: "title",
                ),
            ],
        ),
        (
            names: [
                "--reporttitle",
            ],
            description: Some("Title for the generated report file. The default title is `<SuiteName> Report`"),
            arguments: [
                (
                    name: "title",
                ),
            ],
        ),
        (
            names: [
                "--reportbackground",
            ],
            description: Some("Background colors to use in the report file. Given in format `passed:failed:skipped` where the `:skipped` part can be omitted"),
            arguments: [
                (
                    name: "colors",
                ),
            ],
        ),
        (
            names: [
                "--maxerrorlines",
            ],
            description: Some("Maximum number of error message lines to show in report when tests fail. Default is 40, minimum is 10 and `NONE` can be used to show the full message"),
            arguments: [
                (
                    name: "lines",
                    suggestions: [
                        (
                            name: "40",
                            description: Some("Default number of lines"),
                            presentation: (
                                priority: Some(76.0),
                                display_name: Some("40 (default)"),
                            ),
                        ),
                        (
                            name: "10",
                            description: Some("Minimum number of lines"),
                            presentation: (
                                display_name: Some("10 (minimum)"),
                            ),
                        ),
                        (
                            name: "NONE",
                            description: Some("Unlimited number of lines. Shows the full message"),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--maxassignlength",
            ],
            description: Some("Maximum number of characters to show in log when variables are assigned. Zero or negative values can be used to avoid showing assigned values at all. Default is 200"),
            arguments: [
                (
                    name: "characters",
                    suggestions: [
                        (
                            name: "200",
                            description: Some("Default number of characters"),
                            presentation: (
                                priority: Some(76.0),
                                display_name: Some("200 (default)"),
                            ),
                        ),
                        (
                            name: "0",
                            description: Some("No values at all"),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-L",
                "--loglevel",
            ],
            description: Some("Threshold level for logging"),
            arguments: [
                (
                    name: "level",
                    suggestions: [
                        (
                            name: "TRACE",
                            kind: Some(Option),
                        ),
                        (
                            name: "DEBUG",
                            kind: Some(Option),
                        ),
                        (
                            name: "INFO",
                            kind: Some(Option),
                            presentation: (
                                priority: Some(76.0),
                                display_name: Some("INFO (default)"),
                            ),
                        ),
                        (
                            name: "WARN",
                            kind: Some(Option),
                        ),
                        (
                            name: "NONE",
                            kind: Some(Option),
                            presentation: (
                                display_name: Some("NONE (no logging)"),
                            ),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--suitestatlevel",
            ],
            description: Some("How many levels to show in `Statistics by Suite` in log and report"),
            arguments: [
                (
                    name: "level",
                ),
            ],
        ),
        (
            names: [
                "--tagstatinclude",
            ],
            description: Some("Include only matching tags in `Statistics by Tag` in log and report"),
            arguments: [
                (
                    name: "tag",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "for i in $(find -E . -regex \".*.robot\" -type f); do cat -s $i ; done",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--tagstatexclude",
            ],
            description: Some("Exclude matching tags from `Statistics by Tag`"),
            arguments: [
                (
                    name: "tag",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "for i in $(find -E . -regex \".*.robot\" -type f); do cat -s $i ; done",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--tagstatcombine",
            ],
            description: Some("Create combined statistics based on tags. These statistics are added into `Statistics by Tag`"),
            arguments: [
                (
                    name: "tags:name",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "for i in $(find -E . -regex \".*.robot\" -type f); do cat -s $i ; done",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--tagdoc",
            ],
            description: Some("Add documentation to tags matching the given pattern"),
            arguments: [
                (
                    name: "pattern:doc",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "for i in $(find -E . -regex \".*.robot\" -type f); do cat -s $i ; done",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--tagstatlink",
            ],
            description: Some("Add external links into `Statistics by Tag`. Pattern can use `*`, `?` and `[]` as wildcards"),
            arguments: [
                (
                    name: "pattern:link:title",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "for i in $(find -E . -regex \".*.robot\" -type f); do cat -s $i ; done",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--expandkeywords",
            ],
            description: Some("Matching keywords will be automatically expanded in the log file"),
            arguments: [
                (
                    name: "pattern",
                    suggestions: [
                        (
                            name: "name:<pattern>",
                            kind: Some(Option),
                            presentation: (
                                insert_value: Some("name:{cursor}"),
                            ),
                        ),
                        (
                            name: "tag:<pattern>",
                            kind: Some(Option),
                            presentation: (
                                insert_value: Some("tag:{cursor}"),
                            ),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--removekeywords",
            ],
            description: Some("Remove keyword data from the generated log file"),
            arguments: [
                (
                    name: "pattern",
                    suggestions: [
                        (
                            name: "all",
                            description: Some("Remove data from all keywords"),
                            kind: Some(Option),
                        ),
                        (
                            name: "passed",
                            description: Some("Remove data only from keywords in passed test cases and suites"),
                            kind: Some(Option),
                        ),
                        (
                            name: "for",
                            description: Some("Remove passed iterations from for loops"),
                            kind: Some(Option),
                        ),
                        (
                            name: "while",
                            description: Some("Remove passed iterations from while loops"),
                            kind: Some(Option),
                        ),
                        (
                            name: "wuks",
                            description: Some("Remove all but the last failing keyword inside `BuiltIn.Wait Until Keyword Succeeds`"),
                            kind: Some(Option),
                        ),
                        (
                            name: "name:<pattern>",
                            kind: Some(Option),
                            presentation: (
                                insert_value: Some("name:{cursor}"),
                            ),
                        ),
                        (
                            name: "tag:<pattern>",
                            kind: Some(Option),
                            presentation: (
                                insert_value: Some("tag:{cursor}"),
                            ),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--flattenkeywords",
            ],
            description: Some("Flattens matching keywords in the generated log file"),
            arguments: [
                (
                    name: "pattern",
                    suggestions: [
                        (
                            name: "for",
                            description: Some("Flatten FOR loops fully"),
                            kind: Some(Option),
                        ),
                        (
                            name: "while",
                            description: Some("Flatten WHILE loops fully"),
                            kind: Some(Option),
                        ),
                        (
                            name: "iteration",
                            description: Some("Flatten FOR/WHILE loop iterations"),
                            kind: Some(Option),
                        ),
                        (
                            name: "name:<pattern>",
                            kind: Some(Option),
                            presentation: (
                                insert_value: Some("name:{cursor}"),
                            ),
                        ),
                        (
                            name: "tag:<pattern>",
                            kind: Some(Option),
                            presentation: (
                                insert_value: Some("tag:{cursor}"),
                            ),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--listener",
            ],
            description: Some("A class for monitoring test execution. Gets notifications e.g. when tests start and end"),
            arguments: [
                (
                    name: "class",
                ),
            ],
        ),
        (
            names: [
                "--nostatusrc",
            ],
            description: Some("Sets the return code to zero regardless of failures in test cases. Error codes are returned normally"),
        ),
        (
            names: [
                "--dryrun",
            ],
            description: Some("Sets the return code to zero regardless of failures in test cases. Error codes are returned normally"),
        ),
        (
            names: [
                "-X",
                "--exitonfailure",
            ],
            description: Some("Stops test execution if any test fails"),
        ),
        (
            names: [
                "--exitonerror",
            ],
            description: Some("Stops test execution if any error occurs when parsing test data, importing libraries, and so on"),
        ),
        (
            names: [
                "--skipteardownonexit",
            ],
            description: Some("Causes teardowns to be skipped if test execution is stopped prematurely"),
        ),
        (
            names: [
                "--randomize",
            ],
            description: Some("Randomizes the test execution order"),
            arguments: [
                (
                    name: "type",
                    suggestions: [
                        (
                            name: "all",
                            description: Some("Randomizes both suites and tests"),
                            kind: Some(Option),
                        ),
                        (
                            name: "suites",
                            description: Some("Randomizes suites"),
                            kind: Some(Option),
                        ),
                        (
                            name: "tests",
                            description: Some("Randomizes tests"),
                            kind: Some(Option),
                        ),
                        (
                            name: "none",
                            description: Some("No randomization (default)"),
                            kind: Some(Option),
                            presentation: (
                                priority: Some(76.0),
                                display_name: Some("none (default)"),
                            ),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--prerunmodifier",
            ],
            description: Some("Class to programmatically modify the suite structure before execution"),
            arguments: [
                (
                    name: "class",
                ),
            ],
        ),
        (
            names: [
                "--prerebotmodifier",
            ],
            description: Some("Class to programmatically modify the result model before creating reports and logs"),
            arguments: [
                (
                    name: "class",
                ),
            ],
        ),
        (
            names: [
                "--console",
            ],
            description: Some("How to report execution on the console"),
            arguments: [
                (
                    name: "type",
                    suggestions: [
                        (
                            name: "verbose",
                            description: Some("Report every suite and test (default)"),
                            kind: Some(Option),
                            presentation: (
                                priority: Some(76.0),
                                display_name: Some("verbose (default)"),
                            ),
                        ),
                        (
                            name: "dotted",
                            description: Some("Only show `.` for passed test, `s` for skipped tests, and `F` for failed tests"),
                            kind: Some(Option),
                        ),
                        (
                            name: "quiet",
                            description: Some("No output except for errors and warnings"),
                            kind: Some(Option),
                        ),
                        (
                            name: "none",
                            description: Some("No output whatsoever"),
                            kind: Some(Option),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-.",
                "--dotted",
            ],
            description: Some("Shortcut for `--console dotted`"),
        ),
        (
            names: [
                "--quiet",
            ],
            description: Some("Shortcut for `--console quiet`"),
        ),
        (
            names: [
                "-W",
                "--consolewidth",
            ],
            description: Some("Width of the console output. Default is 78"),
            arguments: [
                (
                    name: "chars",
                    suggestions: [
                        (
                            name: "78",
                            presentation: (
                                priority: Some(76.0),
                                display_name: Some("78 (default)"),
                            ),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-C",
                "--consolecolors",
            ],
            description: Some("Use colors on console output or not"),
            arguments: [
                (
                    name: "option",
                    suggestions: [
                        (
                            name: "auto",
                            description: Some("Use colors when output not redirected (default)"),
                            kind: Some(Option),
                            presentation: (
                                priority: Some(76.0),
                                display_name: Some("auto (default)"),
                            ),
                        ),
                        (
                            name: "on",
                            description: Some("Always use colors"),
                            kind: Some(Option),
                        ),
                        (
                            name: "ansi",
                            description: Some("Like `on` but use ANSI colors also on Windows"),
                            kind: Some(Option),
                        ),
                        (
                            name: "off",
                            description: Some("Disable colors altogether"),
                            kind: Some(Option),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-K",
                "--consolemarkers",
            ],
            description: Some("Show markers on the console when top level keywords in a test case end"),
            arguments: [
                (
                    name: "option",
                    suggestions: [
                        (
                            name: "auto",
                            kind: Some(Option),
                        ),
                        (
                            name: "on",
                            kind: Some(Option),
                        ),
                        (
                            name: "off",
                            kind: Some(Option),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-P",
                "--pythonpath",
            ],
            description: Some("Additional locations (directories, ZIPs) where to search libraries and other extensions when they are imported"),
            arguments: [
                (
                    name: "path",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-A",
                "--argumentfile",
            ],
            description: Some("Text file to read more arguments from. Use special path `STDIN` to read contents from the standard input stream"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Print version information"),
        ),
    ],
    arguments: [
        (
            name: "robot script",
            generators: [
                (
                    has_custom: true,
                    has_dynamic_trigger: true,
                    has_dynamic_query_term: true,
                ),
            ],
            variadic: true,
            is_script: true,
        ),
    ],
)
