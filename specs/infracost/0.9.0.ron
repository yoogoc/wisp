                            arguments: [
                                (
                                    name: "policy-path",
                                ),
                            ],
                            repeat: Many,
                        ),
                        (
                            names: [
                                "--pull-request",
                            ],
                            description: Some("Pull request number to post comment on, mutually exclusive with commit"),
                            arguments: [
                                (
                                    name: "pull-request",
                                    default: Some("0"),
