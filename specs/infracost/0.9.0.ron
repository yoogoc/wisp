                            ],
                        ),
                        (
                            names: [
                                "--commit",
                            ],
                            description: Some("Commit SHA to post comment on, mutually exclusive with merge-request"),
                            arguments: [
                                (
                                    name: "commit",
                                ),
                            ],
                        ),
                        (
