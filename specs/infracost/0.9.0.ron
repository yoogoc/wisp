            subcommands: [
                (
                    name: "get",
                    description: Some("Get global configuration"),
                ),
                (
                    name: "set",
                    description: Some("Set global configuration"),
                ),
            ],
        ),
        (
            name: "diff",
            description: Some("Show diff of monthly costs between current and planned state"),
            options: [
                (
                    names: [
                        "--config-file",
                    ],
                    description: Some("Path to Infracost config file. Cannot be used with path, terraform* or usage-file flags"),
                    arguments: [
