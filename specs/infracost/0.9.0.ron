(
    version: 1,
    command: "infracost",
    description: Some("Cloud cost estimates for Terraform"),
    subcommands: [
        (
            name: "breakdown",
            description: Some("Show full breakdown of costs"),
            options: [
                (
                    names: [
                        "--config-file",
                    ],
                    description: Some("Path to Infracost config file. Cannot be used with path, terraform* or usage-file flags"),
                    arguments: [
                        (
                            name: "config-file",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--fields",
                    ],
                    description: Some("Comma separated list of output fields: all,price,monthlyQuantity,unit,hourlyCost,monthlyCost. Supported by table and html output formats"),
                    arguments: [
                        (
                            name: "fields",
                            default: Some("[monthlyQuantity,unit,monthlyCost]"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--format",
                    ],
                    description: Some("Output format: json, table, html"),
                    arguments: [
                        (
                            name: "format",
                            default: Some("table"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-cache",
                    ],
                    description: Some("Don't attempt to cache Terraform plans"),
                ),
                (
                    names: [
                        "--out-file",
                    ],
                    description: Some("Save output to a file, helpful with format flag"),
                    arguments: [
                        (
                            name: "out-file",
                        ),
                    ],
                ),
                (
                    names: [
                        "--path",
                        "-p",
                    ],
                    description: Some("Path to the Terraform directory or JSON/plan file"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--show-skipped",
                    ],
                    description: Some("Show unsupported resources"),
                ),
                (
                    names: [
                        "--sync-usage-file",
                    ],
                    description: Some("Sync usage-file with missing resources, needs usage-file too (experimental)"),
                ),
                (
                    names: [
                        "--terraform-parse-hcl",
                    ],
                    description: Some("Parse the HCL directly instead of generating a Terraform plan. This option does not need credentials and is faster (experimental)"),
                    presentation: (
                        hidden: true,
                    ),
                ),
                (
                    names: [
                        "--terraform-plan-flags",
                    ],
                    description: Some("Flags to pass to 'terraform plan'. Applicable when path is a Terraform directory"),
                    arguments: [
                        (
                            name: "terraform-plan-flags",
                        ),
                    ],
                ),
                (
                    names: [
                        "--terraform-use-state",
                    ],
                    description: Some("Use Terraform state instead of generating a plan. Applicable when path is a Terraform directory"),
                ),
                (
                    names: [
                        "--terraform-var",
                    ],
                    description: Some("Set a value for one of the input variables, similar to Terraform's -var flag. Only supported with --terraform-parse-hcl (experimental)"),
                    arguments: [
                        (
                            name: "terraform-var",
                        ),
                    ],
                    presentation: (
                        hidden: true,
                    ),
                ),
                (
                    names: [
                        "--terraform-var-file",
                    ],
                    description: Some("Load variable files from the given file, similar to Terraform's -var-file flag. Only supported with --terraform-parse-hcl (experimental)"),
                    arguments: [
                        (
                            name: "terraform-var-file",
                        ),
                    ],
                    presentation: (
                        hidden: true,
                    ),
                ),
                (
                    names: [
                        "--terraform-workspace",
                    ],
                    description: Some("Terraform workspace to use. Applicable when path is a Terraform directory"),
                    arguments: [
                        (
                            name: "terraform-workspace",
                        ),
                    ],
                ),
                (
                    names: [
                        "--usage-file",
                    ],
                    description: Some("Path to Infracost usage file that specifies values for usage-based resources"),
                    arguments: [
                        (
                            name: "usage-file",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "comment",
            description: Some("Post an Infracost comment to GitHub, GitLab, Azure Repos or Bitbucket"),
            subcommands: [
                (
                    name: "azure-repos",
                    description: Some("Post an Infracost comment to Azure Repos"),
                    options: [
                        (
                            names: [
                                "--azure-access-token",
                            ],
                            description: Some("Azure DevOps access token"),
                            arguments: [
                                (
                                    name: "azure-access-token",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--behavior",
                            ],
                            description: Some("Behavior when posting comment, one of:   update (default)  Update latest comment   new               Create a new comment   delete-and-new    Delete previous matching comments and create a new comment"),
                            arguments: [
                                (
                                    name: "behavior",
                                    default: Some("update"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--dry-run",
                            ],
                            description: Some("Generate comment without actually posting to Azure Repos"),
                        ),
                        (
                            names: [
                                "--path",
                                "-p",
                            ],
                            description: Some("Path to Infracost JSON files, glob patterns need quotes"),
                            arguments: [
                                (
                                    name: "path",
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                            required: true,
                            repeat: Many,
                        ),
                        (
                            names: [
                                "--policy-path",
                            ],
                            description: Some("Path to Infracost policy files, glob patterns need quotes (experimental)"),
                            arguments: [
                                (
                                    name: "policy-path",
                                ),
                            ],
                            repeat: Many,
                        ),
                        (
                            names: [
                                "--pull-request",
                            ],
                            description: Some("Pull request number to post comment on"),
                            arguments: [
                                (
                                    name: "pull-request",
                                    default: Some("0"),
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--repo-url",
                            ],
                            description: Some("Repository URL, e.g. https://dev.azure.com/my-org/my-project/_git/my-repo"),
                            arguments: [
                                (
                                    name: "repo-url",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--tag",
                            ],
                            description: Some("Customize hidden markdown tag used to detect comments posted by Infracost"),
                            arguments: [
                                (
                                    name: "tag",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "bitbucket",
                    description: Some("Post an Infracost comment to Bitbucket"),
                    options: [
                        (
                            names: [
                                "--behavior",
                            ],
                            description: Some("Behavior when posting comment, one of:   update (default)  Update latest comment   new               Create a new comment   delete-and-new    Delete previous matching comments and create a new comment"),
                            arguments: [
                                (
                                    name: "behavior",
                                    default: Some("update"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--bitbucket-server-url",
                            ],
                            description: Some("Bitbucket Server URL"),
                            arguments: [
                                (
                                    name: "bitbucket-server-url",
                                    default: Some("https://bitbucket.org"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--bitbucket-token",
                            ],
                            description: Some("Bitbucket access token. Use 'username:app-password' for Bitbucket Cloud and HTTP access token for Bitbucket Server"),
                            arguments: [
                                (
                                    name: "bitbucket-token",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--commit",
                            ],
                            description: Some("Commit SHA to post comment on, mutually exclusive with pull-request. Not available when bitbucket-server-url is set"),
                            arguments: [
                                (
                                    name: "commit",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--dry-run",
                            ],
                            description: Some("Generate comment without actually posting to Bitbucket"),
                        ),
                        (
                            names: [
                                "--path",
                                "-p",
                            ],
                            description: Some("Path to Infracost JSON files, glob patterns need quotes"),
                            arguments: [
                                (
                                    name: "path",
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                            required: true,
                            repeat: Many,
                        ),
                        (
                            names: [
                                "--policy-path",
                            ],
                            description: Some("Path to Infracost policy files, glob patterns need quotes (experimental)"),
                            arguments: [
                                (
                                    name: "policy-path",
                                ),
                            ],
                            repeat: Many,
                        ),
                        (
                            names: [
                                "--pull-request",
                            ],
                            description: Some("Pull request number to post comment on"),
                            arguments: [
                                (
                                    name: "pull-request",
                                    default: Some("0"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--repo",
                            ],
                            description: Some("Repository in format workspace/repo"),
                            arguments: [
                                (
                                    name: "repo",
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--tag",
                            ],
                            description: Some("Customize special text used to detect comments posted by Infracost (placed at the bottom of a comment)"),
                            arguments: [
                                (
                                    name: "tag",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "github",
                    description: Some("Post an Infracost comment to GitHub"),
                    options: [
                        (
                            names: [
                                "--behavior",
                            ],
                            description: Some("Behavior when posting comment, one of:   update (default)  Update latest comment   new               Create a new comment   hide-and-new      Hide previous matching comments and create a new comment   delete-and-new    Delete previous matching comments and create a new comment"),
                            arguments: [
                                (
                                    name: "behavior",
                                    default: Some("update"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--commit",
