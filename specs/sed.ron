(
    version: 1,
    command: "sed",
    description: Some("Stream editor"),
    subcommands: [
        (
            name: "a",
            description: Some("Appends `text` after a line"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            name: "b",
            description: Some("Branch unconditionally to `label`"),
            arguments: [
                (
                    name: "label",
                    optional: true,
                ),
            ],
        ),
        (
            name: "c",
            description: Some("Replace (change) lines with `text`"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            name: "d",
            description: Some("Delete the pattern space; immediately start next cycle"),
        ),
        (
            name: "D",
            description: Some("If pattern space contains newlines, delete text in the pattern space up to the first newline, and restart cycle with the resultant pattern space, without reading a new line of input. If pattern space contains no newline, start a normal new cycle as if the d command was issued"),
        ),
        (
            name: "e",
            description: Some("Executes the command that is found in pattern space and replaces the pattern space with the output; a trailing newline is suppressed"),
            arguments: [
                (
                    name: "command",
                    optional: true,
                    is_command: true,
                ),
            ],
        ),
        (
            name: "F",
            description: Some("Prints the file name of the current input file"),
        ),
        (
            name: "g",
            description: Some("Replaces the contents of the pattern space with the contents of the hold space"),
        ),
        (
            name: "G",
            description: Some("Appends a newline to the contents of the pattern space, and then appends the contents of the hold space to that of the pattern space"),
        ),
        (
            name: "h",
            description: Some("Replaces the contents of the hold space with the contents of the pattern space"),
        ),
        (
            name: "H",
            description: Some("Appends a newline to the contents of the hold space, and then appends the contents of the pattern space to that of the hold space"),
        ),
        (
            name: "i",
            description: Some("Insert text before a line"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            name: "l",
            description: Some("Prints the pattern space in an unambiguous form"),
        ),
        (
            name: "n",
            description: Some("Prints the pattern space, then, regardless, replaces the pattern space with the next line of input. If there is no more input then sed exits without processing any more commands"),
        ),
        (
            name: "N",
            description: Some("Adds a newline to the pattern space, then appends the next line of input to the pattern space. If there is no more input then sed exits without processing any more commands"),
        ),
        (
            name: "p",
            description: Some("Prints the pattern space"),
        ),
        (
            name: "P",
            description: Some("Prints the pattern space up to the first newline"),
        ),
        (
            name: "q",
            description: Some("Exit sed without processing any more commands or input"),
            arguments: [
                (
                    name: "Exit Code",
                    optional: true,
                ),
            ],
        ),
        (
            name: "Q",
            description: Some("This command is the same as q, but will not print the contents of pattern space"),
            arguments: [
                (
                    name: "Exit Code",
                    optional: true,
                ),
            ],
        ),
        (
            name: "r",
            description: Some("Reads file"),
            arguments: [
                (
                    name: "filename",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "R",
            description: Some("Queue a line of filename to be read and inserted into the output stream at the end of the current cycle, or when the next input line is read"),
            arguments: [
                (
                    name: "filename",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "s",
            aliases: [
                "regexp",
                "replacement",
            ],
            description: Some("Match the regular-expression against the content of the pattern space. If found, replace matched string with replacement"),
        ),
        (
            name: "t",
            description: Some("(test) Branch to label only if there has been a successful substitution since the last input line was read or conditional branch was taken. The label may be omitted, in which case the next cycle is started"),
            arguments: [
                (
                    name: "label",
                    optional: true,
                ),
            ],
        ),
        (
            name: "T",
            description: Some("(test) Branch to label only if there have been no successful substitutions since the last input line was read or conditional branch was taken. The label may be omitted, in which case the next cycle is started"),
            arguments: [
                (
                    name: "label",
                    optional: true,
                ),
            ],
        ),
        (
            name: "v",
            description: Some("Makes sed fail if GNU sed extensions are not supported, or if the requested version is not available"),
            arguments: [
                (
                    name: "version",
                    optional: true,
                ),
            ],
        ),
        (
            name: "w",
            description: Some("Writes the pattern space to the file"),
            arguments: [
                (
                    name: "filename",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "W",
            description: Some("Writes to the given filename the portion of the pattern space up to the first newline"),
            arguments: [
                (
                    name: "filename",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "x",
            description: Some("Exchanges the contents of the hold and pattern spaces"),
        ),
        (
            name: "y",
            aliases: [
                "src",
                "dst",
            ],
            description: Some("Transliterate any characters in the pattern space which match any of the source-chars with the corresponding character in dest-chars"),
        ),
        (
            name: "z",
            description: Some("(zap) Empties the content of pattern space"),
        ),
        (
            name: "#",
            description: Some("Comment until the next newline"),
        ),
    ],
    options: [
        (
            names: [
                "-E",
            ],
            description: Some("Interprets regular expressions as extended (modern) regular expressions rather than basic regular expressions"),
        ),
        (
            names: [
                "-a",
            ],
            description: Some("Causes sed to delay opening each file until a command containing the related ``w'' function is applied to a line of input"),
        ),
        (
            names: [
                "-e",
            ],
            description: Some("Appends the editing commands specified by the command argument to the list of commands"),
            arguments: [
                (
                    name: "command",
                ),
            ],
        ),
        (
            names: [
                "-f",
            ],
            description: Some("Appends the editing commands found in the file command_file to the list of commands. The editing commands should each be listed on a separate line"),
            arguments: [
                (
                    name: "command_file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-I",
            ],
            description: Some("Edits files in-place, saving backups with the specified extension.  If a zero-length extension is given, no backup will be saved"),
            arguments: [
                (
                    name: "extension",
                ),
            ],
        ),
        (
            names: [
                "-i",
            ],
            description: Some("Edits files in-place similarly to `-I`, but treats each file independently from other files.  In particular, line numbers in each file start at 1, the ``$'' address matches the last line of the current file, and address ranges are limited to the current file"),
            arguments: [
                (
                    name: "extension",
                ),
            ],
        ),
        (
            names: [
                "-l",
            ],
            description: Some("Makes output line buffered"),
        ),
        (
            names: [
                "-n",
            ],
            description: Some("By default, each line of input is echoed to the standard output after all of the commands have been applied to it.  The `-n` option suppresses this behavior"),
        ),
        (
            names: [
                "-r",
            ],
            description: Some("Same as `-E` for compatibility with GNU sed"),
        ),
        (
            names: [
                "-u",
            ],
            description: Some("Makes output unbuffered"),
        ),
    ],
    arguments: [
        (
            name: "command",
        ),
        (
            name: "file",
            template: [
                FilePaths,
            ],
            optional: true,
            variadic: true,
        ),
    ],
)
