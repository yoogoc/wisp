(
    version: 1,
    command: "ncu",
    description: Some("Upgrade your npm package.json dependencies to the latest versions, ignoring specified versions"),
    options: [
        (
            names: [
                "--cache",
            ],
            description: Some("Cache versions to a local cache file. Default --cacheFile is ~/.ncu-cache.json and default --cacheExpiration is 10 minutes"),
        ),
        (
            names: [
                "--cacheClear",
            ],
            description: Some("Clear the default cache, or the cache file specified by --cacheFile"),
        ),
        (
            names: [
                "--cacheExpiration",
            ],
            description: Some("Cache expiration in minutes. Only works with --cache. (default: 10)"),
            arguments: [
                (
                    name: "min",
                    default: Some("10"),
                ),
            ],
            depends_on: [
                "--cache",
            ],
        ),
        (
            names: [
                "--cacheFile",
            ],
            description: Some("Filepath for the cache file. Only works with --cache. (default: \"~/.ncu-cache.json\")"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                    ],
                    default: Some("~/.ncu-cache.json"),
                ),
            ],
            depends_on: [
                "--cache",
            ],
        ),
        (
            names: [
                "--color",
            ],
            description: Some("Force color in terminal"),
        ),
        (
            names: [
                "--concurrency",
            ],
            description: Some("Max number of concurrent HTTP requests to registry. (default: 8)"),
            arguments: [
                (
                    name: "n",
                    default: Some("8"),
                ),
            ],
        ),
        (
            names: [
                "--configFileName",
            ],
            description: Some("Config file name. (default: .ncurc.{json,yml,js,cjs})"),
            arguments: [
                (
                    name: "s",
                    template: [
                        FilePaths,
                    ],
                    default: Some(".ncurc.{json,yml,js,cjs}"),
                ),
            ],
        ),
        (
            names: [
                "--configFilePath",
            ],
            description: Some("Directory of .ncurc config file. (default: directory of packageFile)"),
            arguments: [
                (
                    name: "path",
                    template: [
                        Folders,
                    ],
                    default: Some("directory of packageFile"),
                ),
            ],
        ),
        (
            names: [
                "--cwd",
            ],
            description: Some("Working directory in which npm will be executed"),
            arguments: [
                (
                    name: "path",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--deep",
            ],
            description: Some("Run recursively in current working directory. Alias of (--packageFile '**/package.json')"),
        ),
        (
            names: [
                "--dep",
            ],
            description: Some("Check one or more sections of dependencies only: dev, optional, peer, prod, or packageManager (comma-delimited). (default: [\"prod\",\"dev\",\"optional\"])"),
            arguments: [
                (
                    name: "value",
                    suggestions: [
                        (
                            name: "dev",
                        ),
                        (
                            name: "optional",
                        ),
                        (
                            name: "peer",
                        ),
                        (
                            name: "prod",
                        ),
                        (
                            name: "packageManager",
                        ),
                    ],
                    default: Some("prod,dev,optional"),
                ),
            ],
        ),
        (
            names: [
                "--deprecated",
            ],
            description: Some("Include deprecated packages"),
        ),
        (
            names: [
                "--doctor",
                "-d",
            ],
            description: Some("Iteratively installs upgrades and runs tests to identify breaking upgrades. Requires -u to execute. Run \"ncu --help --doctor\" for details"),
        ),
        (
            names: [
                "--doctorInstall",
            ],
            description: Some("Specifies the install script to use in doctor mode. (default: npm install/yarn)"),
            arguments: [
                (
                    name: "command",
                    default: Some("npm install/yarn"),
                ),
            ],
        ),
        (
            names: [
                "--doctorTest",
            ],
            description: Some("Specifies the test script to use in doctor mode. (default: npm test)"),
            arguments: [
                (
                    name: "command",
                    default: Some("npm test"),
                ),
            ],
        ),
        (
            names: [
                "--enginesNode",
            ],
            description: Some("Include only packages that satisfy engines.node as specified in the package file"),
        ),
        (
            names: [
                "--errorLevel",
                "-e",
            ],
            description: Some("Set the error level. 1: exits with error code 0 if no errors occur. 2: exits with error code 0 if no packages need updating (useful for continuous integration). (default: 1)"),
            arguments: [
                (
                    name: "n",
                    default: Some("1"),
                ),
            ],
        ),
        (
            names: [
                "--filter",
                "-f",
            ],
            description: Some("Include only package names matching the given string, wildcard, glob, comma-or-space-delimited list, /regex/, or predicate function"),
            arguments: [
                (
                    name: "p",
                ),
            ],
        ),
        (
            names: [
                "--filterResults",
            ],
            description: Some("Filters out upgrades based on a user provided function. Run \"ncu --help --filterResults\" for details"),
        ),
        (
            names: [
                "--filterVersion",
            ],
            description: Some("Filter on package version using comma-or-space-delimited list, /regex/, or predicate function"),
            arguments: [
                (
                    name: "p",
                ),
            ],
        ),
        (
            names: [
                "--format",
            ],
            description: Some("Modify the output formatting or show additional information. Specify one or more comma-delimited values: group, ownerChanged, repo, time, lines. Run \"ncu --help --format\" for details. (default: [])"),
            arguments: [
                (
                    name: "value",
                    suggestions: [
                        (
                            name: "group",
                        ),
                        (
                            name: "ownerChanged",
                        ),
                        (
                            name: "repo",
                        ),
                        (
                            name: "time",
                        ),
                        (
                            name: "lines",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--global",
                "-g",
            ],
            description: Some("Check global packages instead of in the current project"),
        ),
        (
            names: [
                "--groupFunction",
            ],
            description: Some("Customize how packages are divided into groups when using --format group. Run \"ncu --help --groupFunction\" for details"),
        ),
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help"),
        ),
        (
            names: [
                "--interactive",
                "-i",
            ],
            description: Some("Enable interactive prompts for each dependency; implies -u unless one of the json options are set"),
        ),
        (
            names: [
                "--jsonAll",
                "-j",
            ],
            description: Some("Output new package file instead of human-readable message"),
        ),
        (
            names: [
                "--jsonDeps",
            ],
            description: Some("Like jsonAll but only lists dependencies, devDependencies, optionalDependencies, etc of the new package data"),
        ),
        (
            names: [
                "--jsonUpgraded",
            ],
            description: Some("Output upgraded dependencies in json"),
        ),
        (
            names: [
                "--loglevel",
                "-l",
            ],
            description: Some("Amount to log: silent, error, minimal, warn, info, verbose, silly. (default: \"warn\")"),
            arguments: [
                (
                    name: "n",
                    suggestions: [
                        (
                            name: "silent",
                        ),
                        (
                            name: "error",
                        ),
                        (
                            name: "minimal",
                        ),
                        (
                            name: "warn",
                        ),
                        (
                            name: "info",
                        ),
                        (
                            name: "verbose",
                        ),
                        (
                            name: "silly",
                        ),
                    ],
                    default: Some("warn"),
                ),
            ],
        ),
        (
            names: [
                "--mergeConfig",
            ],
            description: Some("Merges nested configs with the root config file for --deep or --packageFile options. (default: false)"),
        ),
        (
            names: [
                "--minimal",
                "-m",
            ],
            description: Some("Do not upgrade newer versions that are already satisfied by the version range according to semver"),
        ),
        (
            names: [
                "--packageData",
            ],
            description: Some("Package file data (you can also use stdin)"),
            arguments: [
                (
                    name: "value",
                ),
            ],
        ),
        (
            names: [
                "--packageFile",
            ],
            description: Some("Package file(s) location. (default: ./package.json)"),
            arguments: [
                (
                    name: "path|glob",
                    template: [
                        FilePaths,
                    ],
                    default: Some("./package.json"),
                ),
            ],
        ),
        (
            names: [
                "--packageManager",
                "-p",
            ],
            description: Some("Npm, yarn, pnpm, deno, staticRegistry (default: npm). Run \"ncu --help --packageManager\" for details"),
            arguments: [
                (
                    name: "s",
                    suggestions: [
                        (
                            name: "npm",
                        ),
                        (
                            name: "yarn",
                        ),
                        (
                            name: "pnpm",
                        ),
                        (
                            name: "deno",
                        ),
                        (
                            name: "staticRegistry",
                        ),
                    ],
                    default: Some("npm"),
                ),
            ],
        ),
        (
            names: [
                "--peer",
            ],
            description: Some("Check peer dependencies of installed packages and filter updates to compatible versions. Run \"ncu --help --peer\" for details"),
        ),
        (
            names: [
                "--pre",
            ],
            description: Some("Include prerelease versions, e.g. -alpha.0, -beta.5, -rc.2. Automatically set to 1 when --target is newest or greatest, or when the current version is a prerelease. (default: 0)"),
            arguments: [
                (
                    name: "n",
                    default: Some("0"),
                ),
            ],
        ),
        (
            names: [
                "--prefix",
            ],
            description: Some("Current working directory of npm"),
            arguments: [
                (
                    name: "path",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--registry",
                "-r",
            ],
            description: Some("Third-party npm registry. Run \"ncu --help --registry\" for details"),
            arguments: [
                (
                    name: "uri",
                ),
            ],
        ),
        (
            names: [
                "--reject",
                "-x",
            ],
            description: Some("Exclude packages matching the given string, wildcard, glob, comma-or-space-delimited list, /regex/, or predicate function"),
            arguments: [
                (
                    name: "p",
                ),
            ],
        ),
        (
            names: [
                "--rejectVersion",
            ],
            description: Some("Exclude package.json versions using comma-or-space-delimited list, /regex/, or predicate function"),
            arguments: [
                (
                    name: "p",
                ),
            ],
        ),
        (
            names: [
                "--removeRange",
            ],
            description: Some("Remove version ranges from the final package version"),
        ),
        (
            names: [
                "--retry",
            ],
            description: Some("Number of times to retry failed requests for package info. (default: 3)"),
            arguments: [
                (
                    name: "n",
                    default: Some("3"),
                ),
            ],
        ),
        (
            names: [
                "--root",
            ],
            description: Some("Runs updates on the root project in addition to specified workspaces. Only allowed with --workspace or --workspaces. (default: false)"),
        ),
        (
            names: [
                "--silent",
                "-s",
            ],
            description: Some("Don't output anything. Alias for --loglevel silent"),
        ),
        (
            names: [
                "--stdin",
            ],
            description: Some("Read package.json from stdin"),
        ),
        (
            names: [
                "--target",
                "-t",
            ],
            description: Some("Determines the version to upgrade to: latest, newest, greatest, minor, patch, @[tag], or [function]. (default: latest) Run \"ncu --help --target\" for details"),
            arguments: [
                (
                    name: "value",
                    suggestions: [
                        (
                            name: "latest",
                        ),
                        (
                            name: "newest",
                        ),
                        (
                            name: "greatest",
                        ),
                        (
                            name: "minor",
                        ),
                        (
                            name: "patch",
                        ),
                    ],
                    default: Some("latest"),
                ),
            ],
        ),
        (
            names: [
                "--timeout",
            ],
            description: Some("Global timeout in milliseconds. (default: no global timeout and 30 seconds per npm-registry-fetch)"),
            arguments: [
                (
                    name: "ms",
                ),
            ],
        ),
        (
            names: [
                "--upgrade",
                "-u",
            ],
            description: Some("Overwrite package file with upgraded versions instead of just outputting to console"),
        ),
        (
            names: [
                "--verbose",
            ],
            description: Some("Log additional information for debugging. Alias for --loglevel verbose"),
        ),
        (
            names: [
                "--version",
                "-v",
            ],
            description: Some("Output the version number of npm-check-updates"),
        ),
        (
            names: [
                "--workspace",
                "-w",
            ],
            description: Some("Run on one or more specified workspaces. Add --root to also upgrade the root project. (default: [])"),
            arguments: [
                (
                    name: "s",
                ),
            ],
        ),
        (
            names: [
                "--workspaces",
                "-ws",
            ],
            description: Some("Run on all workspaces. Add --root to also upgrade the root project"),
        ),
    ],
    arguments: [
        (
            name: "filter",
            description: Some("A list or regex of package names to check (all others will be ignored)"),
            optional: true,
            variadic: true,
        ),
    ],
    parser_directives: Some((
        flags_are_posix_noncompliant: true,
    )),
)
