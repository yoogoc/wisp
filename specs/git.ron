(
    version: 1,
    command: "git",
    description: Some("Distributed version control"),
    options: [
        (names: ["--help", "-h"], description: Some("Show help")),
        (names: ["--version"], description: Some("Show version")),
    ],
    subcommands: [
        (name: "add", description: Some("Add file contents"), arguments: [(name: "path", source: Files)]),
        (name: "branch", description: Some("List or manage branches")),
        (name: "checkout", description: Some("Switch branches"), options: [(names: ["-b"], description: Some("Create a branch"), takes_value: true)], arguments: [(name: "branch", source: Generator("git.branches"))]),
        (name: "commit", description: Some("Record changes"), options: [(names: ["-m", "--message"], description: Some("Commit message"), takes_value: true)]),
        (name: "diff", description: Some("Show changes")),
        (name: "fetch", description: Some("Download refs")),
        (name: "log", description: Some("Show commit logs")),
        (name: "merge", description: Some("Join histories"), arguments: [(name: "branch", source: Generator("git.branches"))]),
        (name: "pull", description: Some("Fetch and integrate")),
        (name: "push", description: Some("Update remote refs")),
        (name: "restore", description: Some("Restore working tree files"), arguments: [(name: "path", source: Files)]),
        (name: "status", description: Some("Show working tree status")),
        (name: "switch", description: Some("Switch branches"), arguments: [(name: "branch", source: Generator("git.branches"))]),
    ],
)
