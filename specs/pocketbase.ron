(
    version: 1,
    command: "pocketbase",
    description: Some("PocketBase CLI"),
    subcommands: [
        (
            name: "help",
            description: Some("Help about any command"),
            arguments: [
                (
                    name: "subcommand",
                    template: [
                        Help,
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "migrate",
            description: Some("Executes DB migration scripts"),
            subcommands: [
                (
                    name: "collections",
                    description: Some("(Experimental) Creates new migration file with the most recent local collections configuration"),
                    arguments: [
                        (
                            name: "folder",
                            description: Some("Migrations folder"),
                            template: [
                                Folders,
                            ],
                            optional: true,
                        ),
                    ],
                ),
                (
                    name: "create",
                    description: Some("Creates new migration template file"),
                    arguments: [
                        (
                            name: "name",
                            description: Some("Migration file name"),
                        ),
                        (
                            name: "folder",
                            description: Some("Migrations folder"),
                            template: [
                                Folders,
                            ],
                            optional: true,
                        ),
                    ],
                ),
                (
                    name: "down",
                    description: Some("Reverts the last [number] applied migrations"),
                    arguments: [
                        (
                            name: "number",
                            description: Some("Number of applied migrations to revert"),
                            optional: true,
                        ),
                    ],
                ),
                (
                    name: "up",
                    description: Some("Runs all available migrations"),
                ),
            ],
        ),
        (
            name: "serve",
            description: Some("Starts the web server (default to 127.0.0.1:8090)"),
            options: [
                (
                    names: [
                        "--http",
                    ],
                    description: Some("API HTTP server address (default \"127.0.0.1:8090\")"),
                    arguments: [
                        (
                            name: "string",
                            description: Some("API HTTP server address"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--https",
                    ],
                    description: Some("API HTTPS server address (auto TLS via Let's Encrypt). The incoming --http address traffic also will be redirected to this address"),
                    arguments: [
                        (
                            name: "string",
                            description: Some("API HTTPS server address (auto TLS via Let's Encrypt)"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--origins",
                    ],
                    description: Some("CORS allowed domain origins list (default [*])"),
                    arguments: [
                        (
                            name: "strings",
                            description: Some("CORS allowed domain origins list"),
                        ),
                    ],
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--debug",
            ],
            description: Some("Enable debug mode, aka showing more detailed logs"),
        ),
        (
            names: [
                "--dir",
            ],
            description: Some("PocketBase data directory (default \"pb_data\")"),
            arguments: [
                (
                    name: "dir",
                    description: Some("PocketBase data directory"),
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--encryptionEnv",
            ],
            description: Some("Environment variable whose value of 32 chars will be used as encryption key for the app settings (default none)"),
            arguments: [
                (
                    name: "env",
                    description: Some("Encryption environment variable name"),
                ),
            ],
        ),
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Show help for pocketbase"),
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Show version for pocketbase"),
        ),
    ],
)
