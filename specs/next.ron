(
    version: 1,
    command: "next",
    description: Some("Next.js CLI to start, build and export your application"),
    subcommands: [
        (
            name: "build",
            description: Some("Create an optimized production build of your application"),
            options: [
                (
                    names: [
                        "--profile",
                    ],
                    description: Some("Enable production profiling"),
                ),
                (
                    names: [
                        "--debug",
                    ],
                    description: Some("Enable more verbose build output"),
                ),
            ],
            arguments: [
                (
                    name: "dir",
                    description: Some("Represent the directory of the Next.js application"),
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                icon: Some("https://nextjs.org/static/favicon/favicon-16x16.png"),
            ),
        ),
        (
            name: "dev",
            description: Some("Start the application in development mode"),
            options: [
                (
                    names: [
                        "-p",
                        "--port",
                    ],
                    description: Some("A port number on which to start the application"),
                    arguments: [
                        (
                            name: "",
                        ),
                    ],
                ),
                (
                    names: [
                        "-H",
                        "--hostname",
                    ],
                    description: Some("Hostname on which to start the application"),
                    arguments: [
                        (
                            name: "",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "dir",
                    description: Some("Represent the directory of the Next.js application"),
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                icon: Some("https://nextjs.org/static/favicon/favicon-16x16.png"),
            ),
        ),
        (
            name: "start",
            description: Some("Start the application in production mode"),
            options: [
                (
                    names: [
                        "-p",
                        "--port",
                    ],
                    description: Some("A port number on which to start the application"),
                    arguments: [
                        (
                            name: "",
                        ),
                    ],
                ),
                (
                    names: [
                        "-H",
                        "--hostname",
                    ],
                    description: Some("Hostname on which to start the application"),
                    arguments: [
                        (
                            name: "",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "dir",
                    description: Some("Represent the directory of the Next.js application"),
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                icon: Some("https://nextjs.org/static/favicon/favicon-16x16.png"),
            ),
        ),
        (
            name: "export",
            description: Some("Exports the application for production deployment"),
            options: [
                (
                    names: [
                        "-s",
                    ],
                    description: Some("Do not print any messages to console"),
                ),
            ],
            arguments: [
                (
                    name: "dir",
                    description: Some("Represent the directory of the Next.js application"),
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                icon: Some("https://nextjs.org/static/favicon/favicon-16x16.png"),
            ),
        ),
        (
            name: "telemetry",
            description: Some("Allows you to control Next.js' telemetry collection"),
            arguments: [
                (
                    name: "status",
                    description: Some("Turn Next.js' telemetry collection on or off"),
                    suggestions: [
                        (
                            name: "enable",
                            description: Some("Enable Next.js' telemetry collection"),
                        ),
                        (
                            name: "disable",
                            description: Some("Disable Next.js' telemetry collection"),
                        ),
                    ],
                ),
            ],
            presentation: (
                icon: Some("https://nextjs.org/static/favicon/favicon-16x16.png"),
            ),
        ),
    ],
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Output usage information"),
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Output the version number"),
        ),
    ],
)
