(
    version: 1,
    command: "sapphire",
    description: Some("CLI for the Sapphire Framework"),
    subcommands: [
        (
            name: "new",
            aliases: [
                "n",
            ],
            description: Some("Creates a new Sapphire project"),
            options: [
                (
                    names: [
                        "-v",
                        "--verbose",
                    ],
                    description: Some("Enable verbose logging"),
                ),
            ],
            arguments: [
                (
                    name: "name",
                    description: Some("Project name"),
                    optional: true,
                ),
            ],
            presentation: (
                priority: Some(100.0),
                display_name: Some("Create a new Sapphire project 📂"),
            ),
        ),
        (
            name: "generate",
            aliases: [
                "g",
            ],
            description: Some("Generates a component/piece"),
            arguments: [
                (
                    name: "component",
                    description: Some("Component/piece name"),
                ),
                (
                    name: "name",
                    description: Some("File name"),
                    template: [
                        FilePaths,
                    ],
                    suggest_current_token: true,
                ),
            ],
            presentation: (
                priority: Some(90.0),
                display_name: Some("Generate a component/piece 📄"),
            ),
        ),
        (
            name: "init",
            aliases: [
                "i",
            ],
            description: Some("Creates a config file on an existing Sapphire project"),
            presentation: (
                priority: Some(80.0),
                display_name: Some("Initalize CLI on an existing project ⚙️"),
            ),
        ),
        (
            name: "help",
            description: Some("Display help for command"),
            arguments: [
                (
                    name: "command",
                    description: Some("Command to display help for"),
                    template: [
                        Help,
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                priority: Some(70.0),
                display_name: Some("Display help for a command 📖"),
            ),
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for sapphire"),
            persistent: true,
            presentation: (
                priority: Some(10.0),
            ),
        ),
        (
            names: [
                "--version",
                "-V",
            ],
            description: Some("Output the version number"),
            presentation: (
                priority: Some(1.0),
            ),
        ),
    ],
)
