(
    version: 1,
    command: "elm-json",
    description: Some("Deal with your elm.json"),
    subcommands: [
        (
            name: "help",
            description: Some("Prints help information or the help of the given subcommand(s)"),
            arguments: [
                (
                    name: "subcommand",
                    template: [
                        Help,
                    ],
                ),
            ],
        ),
        (
            name: "install",
            description: Some("Install a package"),
            options: [
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Prints help information"),
                ),
                (
                    names: [
                        "--test",
                    ],
                    description: Some("Install as a test-dependency"),
                ),
                (
                    names: [
                        "--version",
                        "-V",
                    ],
                    description: Some("Prints version information"),
                ),
                (
                    names: [
                        "--yes",
                    ],
                    description: Some("Answer \"yes\" to all questions"),
                ),
            ],
            arguments: [
                (
                    name: "PACKAGE",
                    description: Some("Package to install, e.g. elm/core or elm/core@1.0.2 or elm/core@1"),
                    generators: [
                        (
                            script: [
                                "curl",
                                "-sH",
                                "accept-encoding: gzip",
                                "--compressed",
                                "https://package.elm-lang.org/search.json",
                            ],
                            has_post_process: true,
                            cache: Some((
                                ttl_ms: Some(259200000),
                                stale_while_revalidate: true,
                            )),
                        ),
                    ],
                    debounce: true,
                ),
                (
                    name: "-- INPUT",
                    description: Some("The elm.json file to upgrade [default: elm.json]"),
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "new",
            description: Some("Create a new elm.json file"),
            options: [
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Prints help information"),
                ),
                (
                    names: [
                        "--version",
                        "-V",
                    ],
                    description: Some("Prints version information"),
                ),
            ],
        ),
        (
            name: "tree",
            description: Some("List entire dependency graph as a tree"),
            options: [
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Prints help information"),
                ),
                (
                    names: [
                        "--test",
                    ],
                    description: Some("Promote test-dependencies to top-level dependencies"),
                ),
                (
                    names: [
                        "--version",
                        "-V",
                    ],
                    description: Some("Prints version information"),
                ),
            ],
            arguments: [
                (
                    name: "PACKAGE",
                    description: Some("Limit output to show path to some (indirect) dependency"),
                    generators: [
                        (
                            script: [
                                "curl",
                                "-sH",
                                "accept-encoding: gzip",
                                "--compressed",
                                "https://package.elm-lang.org/search.json",
                            ],
                            has_post_process: true,
                            cache: Some((
                                ttl_ms: Some(259200000),
                                stale_while_revalidate: true,
                            )),
                        ),
                    ],
                    debounce: true,
                ),
                (
                    name: "-- INPUT",
                    description: Some("The elm.json file to solve [default: elm.json]"),
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "uninstall",
            description: Some("Uninstall a package"),
            options: [
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Prints help information"),
                ),
                (
                    names: [
                        "--version",
                        "-V",
                    ],
                    description: Some("Prints version information"),
                ),
                (
                    names: [
                        "--yes",
                    ],
                    description: Some("Answer \"yes\" to all questions"),
                ),
            ],
            arguments: [
                (
                    name: "PACKAGE",
                    description: Some("Package to uninstall, e.g. elm/html"),
                    generators: [
                        (
                            script: [
                                "curl",
                                "-sH",
                                "accept-encoding: gzip",
                                "--compressed",
                                "https://package.elm-lang.org/search.json",
                            ],
                            has_post_process: true,
                            cache: Some((
                                ttl_ms: Some(259200000),
                                stale_while_revalidate: true,
                            )),
                        ),
                    ],
                    debounce: true,
                ),
                (
                    name: "-- INPUT",
                    description: Some("The elm.json file to upgrade [default: elm.json]"),
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "upgrade",
            description: Some("Bring your dependencies up to date"),
            options: [
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Prints help information"),
                ),
                (
                    names: [
                        "--unsafe",
                    ],
                    description: Some("Allow major versions bumps"),
                ),
                (
                    names: [
                        "--version",
                        "-V",
                    ],
                    description: Some("Prints version information"),
                ),
                (
                    names: [
                        "--yes",
                    ],
                    description: Some("Answer \"yes\" to all questions"),
                ),
            ],
            arguments: [
                (
                    name: "INPUT",
                    description: Some("The elm.json file to upgrade [default: elm.json]"),
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Prints help information"),
        ),
        (
            names: [
                "--offline",
            ],
            description: Some("Enable offline mode, which means no HTTP traffic will happen"),
        ),
        (
            names: [
                "--version",
                "-V",
            ],
            description: Some("Prints version information"),
        ),
        (
            names: [
                "--verbose",
                "-v",
            ],
            description: Some("Sets the level of verbosity"),
        ),
    ],
)
