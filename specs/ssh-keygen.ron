(
    version: 1,
    command: "ssh-keygen",
    description: Some("Generates, manages and converts authentication keys for ssh"),
    options: [
        (
            names: [
                "-A",
            ],
            description: Some("For each of the key types (rsa, dsa, ecdsa and ed25519) for which host keys do not exist, generate the host keys with the default key file path, an empty passphrase, default bits for the key type, and default comment"),
            exclusive_on: [
                "-A",
                "-B",
                "-b",
                "-C",
                "-c",
                "-D",
                "-E",
                "-e",
                "-F",
