                "-w",
                "-Y",
                "-y",
                "-Z",
                "-z",
            ],
        ),
        (
            names: [
                "-a",
            ],
            description: Some("When saving a private key, this option specifies the number of KDF"),
            arguments: [
                (
                    name: "rounds",
                    description: Some("Number of rounds being used"),
                    suggestions: [
                        (
                            name: "16",
                        ),
                    ],
                    optional: true,
                    default: Some("16"),
