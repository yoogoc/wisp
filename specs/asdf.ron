(
    version: 1,
    command: "asdf",
    description: Some("Extendable version manager with support for Ruby, Node.js, Elixir, Erlang & more"),
    subcommands: [
        (
            name: "plugin",
            description: Some("Plugin management sub-commands"),
            subcommands: [
                (
                    name: "add",
                    description: Some("Add a plugin from the plugin repo OR, add a Git repo as a plugin by specifying the name and repo url"),
                    arguments: [
                        (
                            name: "name",
                            generators: [
                                (
                                    has_custom: true,
                                ),
                            ],
                        ),
                        (
                            name: "git-url",
                            optional: true,
                        ),
                    ],
                ),
                (
                    name: "list",
                    description: Some("List installed plugins. Optionally show git urls and git-ref"),
                    subcommands: [
                        (
                            name: "all",
                            description: Some("List plugins registered on asdf-plugins repository with URLs"),
                        ),
                    ],
                    options: [
                        (
                            names: [
                                "--urls",
                            ],
                            description: Some("Show git urls"),
                        ),
                        (
                            names: [
                                "--refs",
                            ],
                            description: Some("Show git refs"),
                        ),
                    ],
                ),
                (
                    name: "remove",
                    description: Some("Remove plugin and package versions"),
                    arguments: [
                        (
                            name: "name",
                            generators: [
                                (
                                    script: [
                                        "asdf",
                                        "plugin-list",
                                    ],
                                    has_post_process: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "update",
                    description: Some("Update a plugin to latest commit on default branch or a particular git-ref"),
                    options: [
                        (
                            names: [
                                "--all",
                            ],
                            description: Some("Update all plugins to latest commit on default branch"),
                            presentation: (
                                dangerous: true,
                            ),
                        ),
                    ],
                    arguments: [
                        (
                            name: "name",
                            optional: true,
                            dangerous: true,
                        ),
                        (
                            name: "git-ref",
                            optional: true,
                            dangerous: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "plugin-add",
            description: Some("Add a plugin from the plugin repo OR, add a Git repo as a plugin by specifying the name and repo url"),
            arguments: [
                (
                    name: "name",
                    generators: [
                        (
                            has_custom: true,
                        ),
                    ],
                ),
                (
                    name: "git-url",
                    optional: true,
                ),
            ],
        ),
        (
            name: "plugin-list",
            description: Some("List installed plugins. Optionally show git urls and git-ref"),
            subcommands: [
                (
                    name: "all",
                    description: Some("List plugins registered on asdf-plugins repository with URLs"),
                ),
            ],
            options: [
                (
                    names: [
                        "--urls",
                    ],
                    description: Some("Show git urls"),
                ),
                (
                    names: [
                        "--refs",
                    ],
                    description: Some("Show git refs"),
                ),
            ],
        ),
        (
            name: "plugin-list-all",
            description: Some("List plugins registered on asdf-plugins repository with URLs"),
        ),
        (
            name: "plugin-remove",
            description: Some("Remove plugin and package versions"),
            arguments: [
                (
                    name: "name",
                    generators: [
                        (
                            script: [
                                "asdf",
                                "plugin-list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "plugin-update",
            description: Some("Update a plugin to latest commit on default branch or a particular git-ref"),
            options: [
                (
                    names: [
                        "--all",
                    ],
                    description: Some("Update all plugins to latest commit on default branch"),
                    presentation: (
                        dangerous: true,
                    ),
                ),
            ],
            arguments: [
                (
                    name: "name",
                    optional: true,
                    dangerous: true,
                ),
                (
                    name: "git-ref",
                    optional: true,
                    dangerous: true,
                ),
            ],
        ),
        (
            name: "install",
            description: Some("Install plugin at stated version, or all from .tools-versions"),
            arguments: [
                (
                    name: "name",
                    generators: [
                        (
                            script: [
                                "asdf",
                                "plugin-list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                    optional: true,
                ),
                (
                    name: "version",
                    suggestions: [
                        (
                            name: "latest",
                            presentation: (
                                dangerous: true,
                            ),
                        ),
                    ],
                    generators: [
                        (
                            has_dynamic_script: true,
                            has_post_process: true,
                            has_dynamic_query_term: true,
                            cache: Some((
                                ttl_ms: Some(3600000),
                                stale_while_revalidate: true,
                            )),
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "uninstall",
            description: Some("Remove a specific version of a package"),
            arguments: [
                (
                    name: "name",
                    generators: [
                        (
                            script: [
                                "asdf",
                                "plugin-list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
                (
                    name: "version",
                    generators: [
                        (
                            has_dynamic_script: true,
                            has_post_process: true,
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "current",
            description: Some("Display current versions for named package (else all)"),
            arguments: [
                (
                    name: "name",
                    generators: [
                        (
                            script: [
                                "asdf",
                                "plugin-list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "where",
            description: Some("Display install path for given package at optional specified version"),
            arguments: [
                (
                    name: "name",
                    generators: [
                        (
                            script: [
                                "asdf",
                                "plugin-list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
                (
                    name: "version",
                    generators: [
                        (
                            has_dynamic_script: true,
                            has_post_process: true,
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "which",
            description: Some("Display path to an executable"),
            arguments: [
                (
                    name: "command",
                    generators: [
                        (
                            has_custom: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "local",
            description: Some("Set package local version"),
            arguments: [
                (
                    name: "name",
                    generators: [
                        (
                            script: [
                                "asdf",
                                "plugin-list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
                (
                    name: "version",
                    generators: [
                        (
                            has_dynamic_script: true,
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "global",
            description: Some("Set package global version"),
            arguments: [
                (
                    name: "name",
                    generators: [
                        (
                            script: [
                                "asdf",
                                "plugin-list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
                (
                    name: "version",
                    generators: [
                        (
                            has_dynamic_script: true,
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "shell",
            description: Some("Set the package version to ASDF_${LANG}_VERSION` in the current shell"),
            arguments: [
                (
                    name: "name",
                    generators: [
                        (
                            script: [
                                "asdf",
                                "plugin-list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
                (
                    name: "version",
                    generators: [
                        (
                            has_dynamic_script: true,
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "latest",
            description: Some("Display latest version available to install for a named package"),
            arguments: [
                (
                    name: "name",
                    generators: [
                        (
                            script: [
                                "asdf",
                                "plugin-list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
                (
                    name: "version",
                    generators: [
                        (
                            has_dynamic_script: true,
                            has_post_process: true,
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "list",
            description: Some("List installed versions of a package"),
            subcommands: [
                (
                    name: "all",
                    description: Some("List all available (remote) versions of a package"),
                    arguments: [
                        (
                            name: "name",
                            generators: [
                                (
                                    script: [
                                        "asdf",
                                        "plugin-list",
                                    ],
                                    has_post_process: true,
                                ),
                            ],
                        ),
                        (
                            name: "version",
                            generators: [
                                (
                                    has_dynamic_script: true,
                                    has_post_process: true,
                                ),
                            ],
                            optional: true,
                        ),
                    ],
                    presentation: (
                        priority: Some(77.0),
                    ),
                ),
            ],
            arguments: [
                (
                    name: "name",
                    generators: [
                        (
                            script: [
                                "asdf",
                                "plugin-list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "list-all",
            description: Some("List all available (remote) versions of a package"),
            arguments: [
                (
                    name: "name",
                    generators: [
                        (
                            script: [
                                "asdf",
                                "plugin-list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
                (
                    name: "version",
                    generators: [
                        (
                            has_dynamic_script: true,
                            has_post_process: true,
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "help",
            description: Some("Output documentation for plugin and tool"),
            arguments: [
                (
                    name: "name",
                    generators: [
                        (
                            script: [
                                "asdf",
                                "plugin-list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
                (
                    name: "version",
                    generators: [
                        (
                            has_dynamic_script: true,
                            has_post_process: true,
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "exec",
            description: Some("Executes the command shim for the current version"),
            arguments: [
                (
                    name: "command",
                    generators: [
                        (
                            has_custom: true,
                        ),
                    ],
                    is_command: true,
                ),
            ],
        ),
        (
            name: "env",
            description: Some("Prints or runs an executable under a command environment"),
            arguments: [
                (
                    name: "command",
                    generators: [
                        (
                            has_custom: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "info",
            description: Some("Print os, shell and asdf debug information"),
        ),
        (
            name: "reshim",
            description: Some("Recreate shims for version of a package"),
            arguments: [
                (
                    name: "name",
                    generators: [
                        (
                            script: [
                                "asdf",
                                "plugin-list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                    optional: true,
                ),
                (
                    name: "version",
                    generators: [
                        (
                            has_dynamic_script: true,
                            has_post_process: true,
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "shim",
            description: Some("Shim management sub-commands"),
            subcommands: [
                (
                    name: "versions",
                    description: Some("List for given command which plugins and versions provide it"),
                    arguments: [
                        (
                            name: "command",
                            generators: [
                                (
                                    has_custom: true,
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "shim-versions",
            description: Some("List for given command which plugins and versions provide it"),
            arguments: [
                (
                    name: "command",
                    generators: [
                        (
                            has_custom: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "update",
            description: Some("Update ASDF to the latest stable release (unless --head)"),
            options: [
                (
                    names: [
                        "--head",
                    ],
                    description: Some("Using HEAD commit"),
                    presentation: (
                        dangerous: true,
                    ),
                ),
            ],
        ),
        (
            name: "version",
            description: Some("Version for asdf"),
        ),
    ],
    options: [
        (
            names: [
                "--version",
            ],
            description: Some("Version for asdf"),
        ),
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Help for asdf"),
        ),
    ],
)
