(
    version: 1,
    command: "g++",
    description: Some("The default C++ compiler for most linux distributions"),
    options: [
        (
            names: [
                "--analyzer-output",
            ],
            description: Some("Static analyzer report output format"),
            arguments: [
                (
                    name: "value",
                    description: Some("Value"),
                    suggestions: [
                        (
                            name: "html",
                        ),
                        (
                            name: "plist",
                        ),
                        (
                            name: "plist-multi-file",
                        ),
                        (
                            name: "plist-html",
                        ),
                        (
                            name: "sarif",
                        ),
                        (
                            name: "text",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--analyze",
            ],
            description: Some("Run the static analyzer"),
        ),
        (
            names: [
                "-arcmt-migrate-emit-errors",
            ],
            description: Some("Emit ARC errors even if the migrator can fix them"),
        ),
        (
            names: [
                "-arcmt-migrate-report-output",
            ],
            description: Some("Output path for the plist report"),
            arguments: [
                (
                    name: "value",
                    description: Some("Value"),
                ),
            ],
        ),
        (
            names: [
                "-B",
            ],
            description: Some("Add <dir> to search path for binaries and object files used implicitly"),
            arguments: [
                (
                    name: "dir",
                    description: Some("Dir"),
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-CC",
            ],
            description: Some("Include comments from within macros in preprocessed output"),
        ),
        (
            names: [
                "-cl-denorms-are-zero",
            ],
            description: Some("OpenCL only. Allow denormals to be flushed to zero"),
        ),
        (
            names: [
                "-cl-fast-relaxed-math",
            ],
            description: Some("OpenCL only. Sets -cl-finite-math-only and -cl-unsafe-math-optimizations, and defines __FAST_RELAXED_MATH__"),
        ),
        (
            names: [
                "-cl-finite-math-only",
            ],
            description: Some("OpenCL only. Allow floating-point optimizations that assume arguments and results are not NaNs or +-Inf"),
        ),
        (
            names: [
                "-cl-fp32-correctly-rounded-divide-sqrt",
            ],
            description: Some("OpenCL only. Specify that single precision floating-point divide and sqrt used in the program source are correctly rounded"),
        ),
        (
            names: [
                "-cl-kernel-arg-info",
            ],
            description: Some("OpenCL only. Generate kernel argument metadata"),
        ),
        (
            names: [
                "-cl-mad-enable",
            ],
            description: Some("OpenCL only. Allow use of less precise MAD computations in the generated binary"),
        ),
        (
            names: [
                "-cl-no-signed-zeros",
            ],
            description: Some("OpenCL only. Allow use of less precise no signed zeros computations in the generated binary"),
        ),
        (
            names: [
                "-cl-opt-disable",
            ],
            description: Some("OpenCL only. This option disables all optimizations. By default optimizations are enabled"),
        ),
        (
            names: [
                "-cl-single-precision-constant",
            ],
            description: Some("OpenCL only. Treat double precision floating-point constant as single precision constant"),
        ),
        (
            names: [
                "-cl-std",
            ],
            description: Some("OpenCL language standard to compile for"),
            arguments: [
                (
                    name: "value",
                    description: Some("Value"),
                ),
            ],
        ),
        (
            names: [
                "-cl-strict-aliasing",
            ],
            description: Some("OpenCL only. This option is added for compatibility with OpenCL 1.0"),
        ),
        (
            names: [
                "-cl-uniform-work-group-size",
            ],
            description: Some("OpenCL only. Defines that the global work-size be a multiple of the work-group size specified to clEnqueueNDRangeKernel"),
        ),
        (
            names: [
                "-cl-unsafe-math-optimizations",
            ],
            description: Some("OpenCL only. Allow unsafe floating-point optimizations"),
        ),
        (
            names: [
                "--config",
            ],
            description: Some("Specifies configuration file"),
            arguments: [
                (
                    name: "value",
                    description: Some("Value"),
                ),
            ],
        ),
        (
            names: [
                "--cuda-compile-host-device",
            ],
            description: Some("Compile CUDA code for both host and device (default)"),
        ),
        (
            names: [
                "--cuda-device-only",
            ],
            description: Some("Compile CUDA code for device only"),
        ),
        (
            names: [
                "--cuda-host-only",
            ],
            description: Some("Compile CUDA code for host only"),
        ),
        (
            names: [
                "--cuda-include-ptx",
            ],
            description: Some("Include PTX for the following GPU architecture (e.g. sm_35) or 'all'. May be specified more than once"),
            arguments: [
                (
                    name: "value",
                    description: Some("Value"),
                    variadic: true,
                ),
            ],
        ),
        (
            names: [
                "--cuda-noopt-device-debug",
            ],
            description: Some("Enable device-side debug info generation. Disables ptxas optimizations"),
        ),
        (
            names: [
                "--cuda-path-ignore-env",
            ],
            description: Some("Ignore environment variables to detect CUDA installation"),
        ),
        (
            names: [
                "--cuda-path",
            ],
            description: Some("CUDA installation path"),
            arguments: [
                (
                    name: "value",
                    description: Some("Value"),
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-cxx-isystem",
            ],
            description: Some("Add directory to the C++ SYSTEM include search path"),
            arguments: [
                (
                    name: "directory",
                    description: Some("Directory"),
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-C",
            ],
            description: Some("Include comments in preprocessed output"),
        ),
        (
            names: [
                "-c",
            ],
            description: Some("Only run preprocess, compile, and assemble steps"),
        ),
        (
            names: [
                "-dD",
            ],
            description: Some("Print macro definitions in -E mode in addition to normal output"),
        ),
        (
            names: [
                "-dependency-dot",
            ],
            description: Some("Filename to write DOT-formatted header dependencies to"),
            arguments: [
                (
                    name: "value",
                    description: Some("Value"),
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-dependency-file",
            ],
            description: Some("Filename (or -) to write dependency output to"),
            arguments: [
                (
                    name: "value",
                    description: Some("Value"),
                    suggestions: [
                        (
                            name: "-",
                        ),
                    ],
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-dI",
            ],
            description: Some("Print include directives in -E mode in addition to normal output"),
        ),
        (
            names: [
                "-dM",
            ],
            description: Some("Print macro definitions in -E mode instead of normal output"),
        ),
        (
            names: [
                "-D",
            ],
            description: Some("Define <macro> to <value> (or 1 if <value> omitted)"),
            arguments: [
                (
                    name: "macro>=<value",
                    description: Some("Macro>=<value"),
                ),
            ],
        ),
        (
            names: [
                "-emit-ast",
            ],
            description: Some("Emit Clang AST files for source inputs"),
        ),
        (
            names: [
                "-emit-interface-stubs",
            ],
            description: Some("Generate Interface Stub Files"),
        ),
        (
            names: [
                "-emit-llvm",
            ],
            description: Some("Use the LLVM representation for assembler and object files"),
        ),
        (
            names: [
                "-emit-merged-ifs",
            ],
            description: Some("Generate Interface Stub Files, emit merged text not binary"),
        ),
        (
            names: [
                "--emit-static-lib",
            ],
            description: Some("Enable linker job to emit a static library"),
        ),
        (
            names: [
                "-enable-trivial-auto-var-init-zero-knowing-it-will-be-removed-from-clang",
            ],
            description: Some("Trivial automatic variable initialization to zero is only here for benchmarks, it'll eventually be removed, and I'm OK with that because I'm only using it to benchmark"),
        ),
        (
            names: [
                "-E",
            ],
            description: Some("Only run the preprocessor"),
        ),
        (
            names: [
                "-fAAPCSBitfieldLoad",
            ],
            description: Some("Follows the AAPCS standard that all volatile bit-field write generates at least one load. (ARM only)"),
        ),
        (
            names: [
                "-faddrsig",
            ],
            description: Some("Emit an address-significance table"),
        ),
        (
            names: [
                "-faligned-allocation",
            ],
            description: Some("Enable C++17 aligned allocation functions"),
        ),
        (
            names: [
                "-fallow-editor-placeholders",
            ],
            description: Some("Treat editor placeholders as valid source code"),
        ),
        (
            names: [
                "-fansi-escape-codes",
            ],
            description: Some("Use ANSI escape codes for diagnostics"),
        ),
        (
            names: [
                "-fapinotes-cache-path",
            ],
            description: Some("Does nothing; API notes are no longer cached separately from modules"),
            arguments: [
                (
                    name: "directory",
                    description: Some("Directory"),
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-fapinotes-modules",
            ],
            description: Some("Enable module-based external API notes support"),
        ),
        (
            names: [
                "-fapinotes-swift-version",
            ],
            description: Some("Specify the Swift version to use when filtering API notes"),
            arguments: [
                (
                    name: "version",
                    description: Some("Version"),
                ),
            ],
        ),
        (
            names: [
                "-fapinotes",
            ],
            description: Some("Enable external API notes support"),
        ),
        (
            names: [
                "-fapple-kext",
            ],
            description: Some("Use Apple's kernel extensions ABI"),
        ),
        (
            names: [
                "-fapple-link-rtlib",
            ],
            description: Some("Force linking the clang builtins runtime library"),
        ),
        (
            names: [
                "-fapple-pragma-pack",
            ],
            description: Some("Enable Apple gcc-compatible #pragma pack handling"),
        ),
        (
            names: [
                "-fapplication-extension",
            ],
            description: Some("Restrict"),
        ),
        (
            names: [
                "-fasm-blocks",
            ],
        ),
        (
            names: [
                "-fautolink",
            ],
        ),
        (
            names: [
                "-fbasic-block-sections",
            ],
            description: Some("Place each function's basic blocks in unique sections (ELF Only) : all | labels | none | list=<file>"),
            arguments: [
                (
                    name: "value",
                    description: Some("Value"),
                    suggestions: [
                        (
                            name: "all",
                        ),
                        (
                            name: "labels",
                        ),
                        (
                            name: "none",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-fblocks",
            ],
            description: Some("Enable the 'blocks' language feature"),
        ),
        (
            names: [
                "-fborland-extensions",
            ],
            description: Some("Accept non-standard constructs supported by the Borland compiler"),
        ),
        (
            names: [
                "-fbranch-target-identification",
            ],
            description: Some("Emit branch target identification instructions for indirect branch destinations"),
        ),
        (
            names: [
                "-fbuild-session-file",
            ],
            description: Some("Use the last modification time of <file> as the build session timestamp"),
            arguments: [
                (
                    name: "file",
                    description: Some("File"),
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-fbuild-session-timestamp",
            ],
            description: Some("Time when the current build session started"),
            arguments: [
                (
                    name: "time since Epoch in seconds",
                    description: Some("Time since Epoch in seconds"),
                ),
            ],
        ),
        (
            names: [
                "-fbuiltin-module-map",
            ],
            description: Some("Load the clang builtins module map file"),
        ),
        (
            names: [
                "-fc++-static-destructors",
            ],
        ),
        (
            names: [
                "-fcall-saved-x10",
            ],
            description: Some("Make the x10 register call-saved (AArch64 only)"),
        ),
        (
            names: [
                "-fcall-saved-x11",
            ],
            description: Some("Make the x11 register call-saved (AArch64 only)"),
        ),
        (
            names: [
                "-fcall-saved-x12",
            ],
            description: Some("Make the x12 register call-saved (AArch64 only)"),
        ),
        (
            names: [
                "-fcall-saved-x13",
            ],
            description: Some("Make the x13 register call-saved (AArch64 only)"),
        ),
        (
            names: [
                "-fcall-saved-x14",
            ],
            description: Some("Make the x14 register call-saved (AArch64 only)"),
        ),
        (
            names: [
                "-fcall-saved-x15",
            ],
            description: Some("Make the x15 register call-saved (AArch64 only)"),
        ),
        (
            names: [
                "-fcall-saved-x18",
            ],
            description: Some("Make the x18 register call-saved (AArch64 only)"),
        ),
        (
            names: [
                "-fcall-saved-x8",
            ],
            description: Some("Make the x8 register call-saved (AArch64 only)"),
        ),
        (
            names: [
                "-fcall-saved-x9",
            ],
            description: Some("Make the x9 register call-saved (AArch64 only)"),
        ),
        (
            names: [
                "-fcaret-diagnostics",
            ],
        ),
        (
            names: [
                "-fcf-protection",
            ],
            description: Some("Enable cf-protection in 'full' mode"),
            arguments: [
                (
                    name: "value",
                    description: Some("Value"),
                    optional: true,
                ),
            ],
        ),
        (
            names: [
                "-fchar8_t",
            ],
            description: Some("Enable C++ builtin type char8_t"),
        ),
        (
            names: [
                "-fclang-abi-compat",
            ],
            description: Some("Attempt to match the ABI of Clang <version>"),
            arguments: [
                (
                    name: "version",
                    description: Some("Version"),
                ),
            ],
        ),
        (
            names: [
                "-fcolor-diagnostics",
            ],
            description: Some("Enable colors in diagnostics"),
        ),
        (
            names: [
                "-fcomment-block-commands",
            ],
            description: Some("Treat each comma separated argument in <arg> as a documentation comment block command"),
            arguments: [
                (
                    name: "arg",
                    description: Some("Arg"),
                ),
            ],
        ),
        (
            names: [
                "-fcommon",
            ],
            description: Some("Place uninitialized global variables in a common block"),
        ),
        (
            names: [
                "-fcomplete-member-pointers",
            ],
            description: Some("Require member pointer base types to be complete if they would be significant under the Microsoft ABI"),
        ),
        (
            names: [
                "-fconvergent-functions",
            ],
            description: Some("Assume functions may be convergent"),
        ),
        (
            names: [
                "-fcoroutines-ts",
            ],
            description: Some("Enable support for the C++ Coroutines TS"),
        ),
        (
            names: [
                "-fcoverage-mapping",
            ],
            description: Some("Generate coverage mapping to enable code coverage analysis"),
        ),
        (
            names: [
                "-fcs-profile-generate",
            ],
            description: Some("Generate instrumented code to collect context sensitive execution counts into <directory>/default.profraw (overridden by LLVM_PROFILE_FILE env var)"),
            arguments: [
                (
                    name: "directory",
                    description: Some("Directory"),
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            names: [
                "-fcuda-approx-transcendentals",
            ],
            description: Some("Use approximate transcendental functions"),
        ),
        (
            names: [
                "-fcuda-flush-denormals-to-zero",
            ],
            description: Some("Flush denormal floating point values to zero in CUDA device mode"),
        ),
        (
            names: [
                "-fcuda-short-ptr",
            ],
            description: Some("Use 32-bit pointers for accessing const/local/shared address spaces"),
        ),
        (
            names: [
                "-fcxx-exceptions",
            ],
            description: Some("Enable C++ exceptions"),
        ),
        (
            names: [
                "-fdata-sections",
            ],
            description: Some("Place each data in its own section"),
        ),
        (
            names: [
                "-fdebug-compilation-dir",
            ],
            description: Some("The compilation directory to embed in the debug info"),
            arguments: [
                (
                    name: "value",
                    description: Some("Value"),
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-fdebug-default-version",
            ],
            description: Some("Default DWARF version to use, if a -g option caused DWARF debug info to be produced"),
            arguments: [
                (
                    name: "value",
                    description: Some("Value"),
                ),
            ],
        ),
        (
            names: [
                "-fdebug-info-for-profiling",
            ],
            description: Some("Emit extra debug info to make sample profile more accurate"),
        ),
        (
            names: [
                "-fdebug-macro",
            ],
            description: Some("Emit macro debug information"),
        ),
        (
            names: [
                "-fdebug-prefix-map",
            ],
            description: Some("Remap file source paths in debug info"),
            arguments: [
                (
                    name: "value",
                    description: Some("Value"),
                ),
            ],
        ),
        (
            names: [
                "-fdebug-ranges-base-address",
            ],
            description: Some("Use DWARF base address selection entries in .debug_ranges"),
        ),
        (
            names: [
                "-fdebug-types-section",
            ],
            description: Some("Place debug types in their own section (ELF Only)"),
        ),
        (
            names: [
                "-fdeclspec",
            ],
            description: Some("Allow __declspec as a keyword"),
        ),
        (
            names: [
                "-fdelayed-template-parsing",
            ],
            description: Some("Parse templated function definitions at the end of the translation unit"),
        ),
        (
            names: [
                "-fdelete-null-pointer-checks",
            ],
            description: Some("Treat usage of null pointers as undefined behavior (default)"),
        ),
        (
            names: [
                "-fdiagnostics-absolute-paths",
            ],
            description: Some("Print absolute paths in diagnostics"),
        ),
        (
            names: [
                "-fdiagnostics-hotness-threshold",
            ],
            description: Some("Prevent optimization remarks from being output if they do not have at least this profile count"),
            arguments: [
                (
                    name: "number",
                    description: Some("Number"),
                ),
            ],
        ),
        (
            names: [
                "-fdiagnostics-parseable-fixits",
            ],
            description: Some("Print fix-its in machine parseable form"),
        ),
        (
            names: [
                "-fdiagnostics-print-source-range-info",
            ],
            description: Some("Print source range spans in numeric form"),
        ),
        (
            names: [
                "-fdiagnostics-show-hotness",
            ],
            description: Some("Enable profile hotness information in diagnostic line"),
        ),
        (
            names: [
                "-fdiagnostics-show-note-include-stack",
            ],
            description: Some("Display include stacks for diagnostic notes"),
        ),
        (
            names: [
                "-fdiagnostics-show-option",
            ],
            description: Some("Print option name with mappable diagnostics"),
        ),
        (
            names: [
                "-fdiagnostics-show-template-tree",
            ],
            description: Some("Print a template comparison tree for differing templates"),
        ),
        (
            names: [
                "-fdigraphs",
            ],
            description: Some("Enable alternative token representations '<:', ':>', '<%', '%>', '%:', '%:%:' (default)"),
        ),
        (
            names: [
                "-fdiscard-value-names",
            ],
            description: Some("Discard value names in LLVM IR"),
        ),
        (
            names: [
                "-fdollars-in-identifiers",
            ],
            description: Some("Allow '$' in identifiers"),
        ),
        (
            names: [
                "-fdouble-square-bracket-attributes",
            ],
            description: Some("Enable '[[]]' attributes in all C and C++ language modes"),
        ),
        (
            names: [
                "-fdwarf-directory-asm",
            ],
        ),
        (
            names: [
                "-fdwarf-exceptions",
            ],
            description: Some("Use DWARF style exceptions"),
        ),
        (
            names: [
                "-fembed-bitcode-marker",
            ],
            description: Some("Embed placeholder LLVM IR data as a marker"),
        ),
        (
            names: [
                "-fembed-bitcode",
            ],
            description: Some("Embed LLVM bitcode (option: off, all, bitcode, marker)"),
            arguments: [
                (
                    name: "option",
                    description: Some("Option"),
                    optional: true,
                ),
            ],
        ),
        (
            names: [
                "-femit-all-decls",
            ],
            description: Some("Emit all declarations, even if unused"),
        ),
        (
            names: [
                "-femulated-tls",
            ],
            description: Some("Use emutls functions to access thread_local variables"),
        ),
        (
            names: [
                "-fenable-globaldse",
            ],
            description: Some("Enable experimental global dead store elimination"),
        ),
        (
            names: [
                "-fenable-matrix",
            ],
            description: Some("Enable matrix data type and related builtin functions"),
        ),
        (
            names: [
                "-fexceptions",
            ],
            description: Some("Enable support for exception handling"),
        ),
        (
            names: [
                "-fexperimental-new-constant-interpreter",
            ],
            description: Some("Enable the experimental new constant interpreter"),
        ),
        (
            names: [
                "-fexperimental-new-pass-manager",
            ],
            description: Some("Enables an experimental new pass manager in LLVM"),
        ),
        (
            names: [
                "-fexperimental-relative-c++-abi-vtables",
            ],
            description: Some("Use the experimental C++ class ABI for classes with virtual tables"),
        ),
        (
            names: [
                "-fexperimental-strict-floating-point",
            ],
            description: Some("Enables experimental strict floating point in LLVM"),
        ),
        (
            names: [
                "-ffast-math",
            ],
            description: Some("Allow aggressive, lossy floating-point optimizations"),
        ),
        (
            names: [
                "-ffile-prefix-map",
            ],
            description: Some("Remap file source paths in debug info and predefined preprocessor macros"),
            arguments: [
                (
                    name: "value",
                    description: Some("Value"),
                ),
            ],
        ),
        (
            names: [
                "-ffine-grained-bitfield-accesses",
            ],
            description: Some("Use separate accesses for consecutive bitfield runs with legal widths and alignments"),
        ),
        (
            names: [
                "-ffixed-point",
            ],
            description: Some("Enable fixed point types"),
        ),
        (
            names: [
                "-ffixed-r19",
            ],
            description: Some("Reserve register r19 (Hexagon only)"),
        ),
        (
            names: [
                "-ffixed-r9",
            ],
            description: Some("Reserve the r9 register (ARM only)"),
        ),
        (
            names: [
                "-ffixed-x10",
            ],
            description: Some("Reserve the x10 register (AArch64/RISC-V only)"),
        ),
        (
            names: [
                "-ffixed-x11",
            ],
            description: Some("Reserve the x11 register (AArch64/RISC-V only)"),
        ),
        (
            names: [
                "-ffixed-x12",
            ],
            description: Some("Reserve the x12 register (AArch64/RISC-V only)"),
        ),
        (
            names: [
                "-ffixed-x13",
            ],
            description: Some("Reserve the x13 register (AArch64/RISC-V only)"),
        ),
        (
            names: [
                "-ffixed-x14",
            ],
            description: Some("Reserve the x14 register (AArch64/RISC-V only)"),
        ),
        (
            names: [
                "-ffixed-x15",
            ],
            description: Some("Reserve the x15 register (AArch64/RISC-V only)"),
        ),
        (
            names: [
                "-ffixed-x16",
            ],
            description: Some("Reserve the x16 register (AArch64/RISC-V only)"),
        ),
        (
            names: [
                "-ffixed-x17",
            ],
            description: Some("Reserve the x17 register (AArch64/RISC-V only)"),
        ),
        (
            names: [
