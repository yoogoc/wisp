                ),
                (
                    names: [
                        "--ignore-rust-version",
                    ],
                    description: Some("Ignore `rust-version` specification in packages"),
                ),
                (
                    names: [
                        "--no-fail-fast",
                    ],
                    description: Some("Run all benchmarks regardless of failure"),
                ),
                (
                    names: [
                        "--unit-graph",
                    ],
                    description: Some("Output build graph in JSON (unstable)"),
                ),
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Print help information"),
                ),
                (
                    names: [
                        "-v",
                        "--verbose",
                    ],
                    description: Some("Use verbose output (-vv very verbose/build.rs output)"),
                    repeat: Many,
                ),
                (
                    names: [
                        "--frozen",
                    ],
                    description: Some("Require Cargo.lock and cache are up to date"),
