                (
                    names: [
                        "--examples",
                    ],
                    description: Some("Benchmark all examples"),
                ),
                (
                    names: [
                        "--tests",
                    ],
                    description: Some("Benchmark all tests"),
                ),
                (
                    names: [
                        "--benches",
                    ],
                    description: Some("Benchmark all benches"),
