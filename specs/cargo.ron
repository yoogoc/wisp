(
    version: 1,
    command: "cargo",
    description: Some("CLI Interface for Cargo"),
    subcommands: [
        (
            name: "bench",
            description: Some("Execute all benchmarks of a local package"),
            options: [
                (
                    names: [
                        "--bin",
                    ],
                    description: Some("Benchmark only the specified binary"),
                    arguments: [
                        (
                            name: "bin",
                            generators: [
                                (
                                    has_custom: true,
                                ),
                            ],
                            variadic: true,
                            filter_strategy: Fuzzy,
                        ),
                    ],
                    repeat: Many,
                ),
                (
                    names: [
                        "--example",
                    ],
                    description: Some("Benchmark only the specified example"),
                    arguments: [
                        (
                            name: "example",
                            generators: [
                                (
                                    has_custom: true,
                                ),
                            ],
                            variadic: true,
                            filter_strategy: Fuzzy,
                        ),
                    ],
                    repeat: Many,
                ),
                (
                    names: [
                        "--test",
                    ],
                    description: Some("Benchmark only the specified test target"),
