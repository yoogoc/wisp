                    names: [
                        "--all-targets",
                    ],
                    description: Some("Benchmark all targets"),
                ),
                (
                    names: [
                        "--no-run",
                    ],
                    description: Some("Compile, but don't run benchmarks"),
                ),
                (
                    names: [
                        "--workspace",
                    ],
