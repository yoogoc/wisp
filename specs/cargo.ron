                            filter_strategy: Fuzzy,
                        ),
                    ],
                    repeat: Many,
                ),
                (
                    names: [
                        "-p",
                        "--package",
                    ],
                    description: Some("Package to run benchmarks for"),
                    arguments: [
                        (
                            name: "package",
                            generators: [
                                (
                                    script: [
                                        "cargo",
                                        "metadata",
                                        "--format-version",
                                        "1",
                                        "--no-deps",
                                    ],
                                    has_post_process: true,
                                ),
                            ],
                            variadic: true,
                            filter_strategy: Fuzzy,
                        ),
                    ],
                    repeat: Many,
                ),
                (
                    names: [
                        "--exclude",
                    ],
                    description: Some("Exclude packages from the benchmark"),
                    arguments: [
                        (
                            name: "exclude",
                            generators: [
                                (
                                    script: [
                                        "cargo",
                                        "metadata",
                                        "--format-version",
                                        "1",
                                        "--no-deps",
                                    ],
                                    has_post_process: true,
                                ),
                            ],
                            filter_strategy: Fuzzy,
                        ),
                    ],
                    repeat: Many,
                ),
                (
                    names: [
                        "-j",
                        "--jobs",
                    ],
                    description: Some("Number of parallel jobs, defaults to # of CPUs"),
                    arguments: [
                        (
                            name: "jobs",
                        ),
                    ],
                ),
                (
                    names: [
                        "--profile",
                    ],
                    description: Some("Build artifacts with the specified profile"),
                    arguments: [
                        (
                            name: "profile",
                        ),
                    ],
                ),
                (
                    names: [
                        "--features",
                    ],
                    description: Some("Space or comma separated list of features to activate"),
                    arguments: [
                        (
                            name: "features",
                            generators: [
                                (
                                    script: [
                                        "cargo",
                                        "read-manifest",
                                    ],
                                    has_post_process: true,
                                ),
                            ],
                            variadic: true,
                        ),
                    ],
                    repeat: Many,
                ),
                (
                    names: [
                        "--target",
                    ],
                    description: Some("Build for the target triple"),
