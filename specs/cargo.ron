                                (
                                    has_custom: true,
                                    has_dynamic_trigger: true,
                                    has_dynamic_query_term: true,
                                ),
                            ],
                        ),
                    ],
                    repeat: Many,
                ),
                (
                    names: [
                        "-Z",
                    ],
                    description: Some("Unstable (nightly-only) flags to Cargo, see 'cargo -Z help' for details"),
                    arguments: [
                        (
                            name: "unstable-features",
                        ),
                    ],
                    repeat: Many,
                ),
                (
                    names: [
                        "-q",
                        "--quiet",
                    ],
                    description: Some("Do not print cargo log messages"),
                ),
                (
                    names: [
                        "--lib",
                    ],
                    description: Some("Benchmark only this package's library"),
                ),
                (
                    names: [
                        "--bins",
                    ],
                    description: Some("Benchmark all binaries"),
