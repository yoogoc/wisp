(
    version: 1,
    command: "glow",
    description: Some("Render markdown on the CLI, with pizzazz!"),
    subcommands: [
        (
            name: "config",
            description: Some("Edit the glow config file"),
        ),
        (
            name: "help",
            description: Some("Help about any command"),
            arguments: [
                (
                    name: "command",
                    template: [
                        Help,
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "stash",
            description: Some("Manage your stash of markdown files"),
            options: [
                (
                    names: [
                        "-m",
                        "--memo",
                    ],
                    description: Some("Memo/note for stashing"),
                    arguments: [
                        (
                            name: "note",
                        ),
                    ],
                    presentation: (
                        insert_value: Some("--memo '{cursor}'"),
                    ),
                ),
            ],
            arguments: [
                (
                    name: "path",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "-a",
                "--all",
            ],
            description: Some("Show system files and directories (TUI-mode only)"),
        ),
        (
            names: [
                "--config",
            ],
            description: Some("Config file"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Help for glow"),
            persistent: true,
        ),
        (
            names: [
                "-l",
                "--local",
            ],
            description: Some("Show local files only; no network (TUI-mode only)"),
        ),
        (
            names: [
                "-p",
                "--pager",
            ],
            description: Some("Display with pager"),
        ),
        (
            names: [
                "-s",
                "--style",
            ],
            description: Some("Style name or JSON path (default 'auto')"),
            arguments: [
                (
                    name: "name",
                    suggestions: [
                        (
                            name: "auto",
                        ),
                        (
                            name: "light",
                        ),
                        (
                            name: "dark",
                        ),
                        (
                            name: "notty",
                        ),
                    ],
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Version for glow"),
        ),
        (
            names: [
                "-w",
                "--width",
            ],
            description: Some("Word-wrap at width"),
            arguments: [
                (
                    name: "column",
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "source|dir",
            generators: [
                (
                    has_custom: true,
                    has_dynamic_trigger: true,
                    has_dynamic_query_term: true,
                ),
            ],
            optional: true,
            variadic: true,
        ),
    ],
)
