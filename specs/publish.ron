(
    version: 1,
    command: "publish",
    subcommands: [
        (
            name: "new",
            description: Some("Set up a new website in the current folder"),
        ),
        (
            name: "run",
            description: Some("Generate and run a localhost server on default port 8000 for the website in the current folder"),
            options: [
                (
                    names: [
                        "-p",
                        "--port",
                    ],
                    description: Some("Customize the port"),
                    arguments: [
                        (
                            name: "port",
                            default: Some("8000"),
                        ),
                    ],
                ),
            ],
            parser_directives: Some((
                flags_are_posix_noncompliant: true,
            )),
        ),
        (
            name: "deploy",
            description: Some("Generate and deploy the website in the current folder"),
        ),
        (
            name: "generate",
            description: Some("Generate the website in the current folder"),
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for publish"),
        ),
    ],
)
