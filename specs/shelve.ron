(
    version: 1,
    command: "shelve",
    description: Some("Shelve CLI a command-line interface designed for the Shelve platform. This tool enables users to authenticate with Shelve, facilitating the seamless transfer of environment variables for project collaboration within a team directly through the terminal interface"),
    subcommands: [
        (
            name: "create",
            aliases: [
                "c",
                "init",
            ],
            description: Some("Create a new project"),
            options: [
                (
                    names: [
                        "--name",
                        "-n",
                    ],
                    description: Some("Name of the project"),
                    arguments: [
                        (
                            name: "project-name",
                        ),
                    ],
                ),
            ],
            presentation: (
                icon: Some("🚀"),
            ),
        ),
        (
            name: "pull",
            aliases: [
                "pl",
            ],
            description: Some("Pull variables for specified environment to .env file"),
            options: [
                (
                    names: [
                        "--env",
                        "-e",
                    ],
                    description: Some("Specify the environment"),
                    arguments: [
                        (
                            name: "environment",
                        ),
                    ],
                ),
            ],
            presentation: (
                icon: Some("📥"),
            ),
        ),
        (
            name: "push",
            aliases: [
                "ps",
            ],
            description: Some("Push variables for specified environment to Shelve"),
            options: [
                (
                    names: [
                        "--env",
                        "-e",
                    ],
                    description: Some("Specify the environment"),
                    arguments: [
                        (
                            name: "environment",
                        ),
                    ],
                ),
            ],
            presentation: (
                icon: Some("📤"),
            ),
        ),
        (
            name: "generate",
            aliases: [
                "g",
            ],
            description: Some("Generate resources for a project"),
            presentation: (
                icon: Some("🔄"),
            ),
        ),
        (
            name: "config",
            aliases: [
                "cf",
            ],
            description: Some("Show the current configuration"),
            presentation: (
                icon: Some("⚙️"),
            ),
        ),
        (
            name: "--help",
            aliases: [
                "-h",
            ],
            description: Some("Show help"),
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help"),
            persistent: true,
        ),
    ],
)
