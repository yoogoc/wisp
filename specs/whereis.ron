(
    version: 1,
    command: "whereis",
    description: Some("Locate the binary, source, and manual page files for a command"),
    options: [
        (
            names: [
                "-b",
            ],
            description: Some("Search only for binaries"),
        ),
        (
            names: [
                "-m",
            ],
            description: Some("Search only for manual sections"),
        ),
        (
            names: [
                "-s",
            ],
            description: Some("Search only for sources"),
        ),
        (
            names: [
                "-u",
            ],
            description: Some("Search for unusual entries"),
        ),
        (
            names: [
                "-B",
            ],
            description: Some("Search for binaries only in the specified directory"),
            arguments: [
                (
                    name: "directory",
                    description: Some("The directory to search in"),
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-M",
            ],
            description: Some("Search for manual pages only in the specified directory"),
            arguments: [
                (
                    name: "directory",
                    description: Some("The directory to search in"),
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-S",
            ],
            description: Some("Search for sources only in the specified directory"),
            arguments: [
                (
                    name: "directory",
                    description: Some("The directory to search in"),
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-f",
            ],
            description: Some("Terminate the -B, -M, and -S options"),
        ),
    ],
    arguments: [
        (
            name: "Filename",
            description: Some("The file to search for"),
        ),
    ],
)
