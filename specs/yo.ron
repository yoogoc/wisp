(
    version: 1,
    command: "yo",
    description: Some("Yeoman generator"),
    options: [
        (
            names: [
                "--help",
            ],
            description: Some("Print info and generator's options and usage"),
        ),
        (
            names: [
                "-f",
                "--force",
            ],
            description: Some("Overwrite files that already exist"),
            presentation: (
                dangerous: true,
            ),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Print version"),
        ),
        (
            names: [
                "--no-color",
            ],
            description: Some("Disable color"),
        ),
        (
            names: [
                "--insight",
            ],
            description: Some("Enable anonymous tracking"),
        ),
        (
            names: [
                "--no-insight",
            ],
            description: Some("Disable anonymous tracking"),
        ),
        (
            names: [
                "--generators",
            ],
            description: Some("Print available generators"),
        ),
        (
            names: [
                "--local-only",
            ],
            description: Some("Disable lookup of globally-installed generators"),
        ),
    ],
    arguments: [
        (
            name: "generator",
            suggestions: [
                (
                    name: "doctor",
                    description: Some("Running sanity checks on your system"),
                    presentation: (
                        icon: Some("fig://icon?type=alert"),
                    ),
                ),
                (
                    name: "completion",
                    description: Some("To enable shell completion for the yo command"),
                    presentation: (
                        icon: Some("fig://icon?type=asterisk"),
                    ),
                ),
            ],
            generators: [
                (
                    script: [
                        "yo",
                        "--generators",
                    ],
                    has_post_process: true,
                ),
            ],
            optional: true,
            is_command: true,
        ),
    ],
)
