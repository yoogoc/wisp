(
    version: 1,
    command: "rustup",
    description: Some("The Rust toolchain installer"),
    subcommands: [
        (
            name: "show",
            description: Some("Show the active and installed toolchains or profiles"),
            subcommands: [
                (
                    name: "active-toolchain",
                    description: Some("Show the active toolchain"),
                ),
                (
                    name: "home",
                    description: Some("Display the computed value of RUSTUP_HOME"),
                ),
                (
                    name: "profile",
                    description: Some("Show the current profile"),
                ),
                (
                    name: "keys",
                    description: Some("Display the known PGP keys"),
                ),
                (
                    name: "help",
                    description: Some("Prints this message or the help of the given subcommand(s)"),
                ),
            ],
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Prints help information"),
                ),
            ],
        ),
        (
            name: "update",
            description: Some("Update Rust toolchains and rustup"),
            options: [
                (
                    names: [
                        "--force",
                    ],
                    description: Some("Force an update, even if some components are missing"),
                ),
                (
                    names: [
                        "--force-non-host",
                    ],
                    description: Some("Install toolchains that require an emulator. See https://github.com/rust-lang/rustup/wiki/Non-host-toolchains"),
                ),
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Prints help information"),
                ),
                (
                    names: [
                        "--no-self-update",
                    ],
                    description: Some("Don't perform self update when running the `rustup update` command"),
                ),
            ],
            arguments: [
                (
                    name: "toolchain",
                    description: Some("Toolchain name. For more information see `rustup help toolchain`"),
                    generators: [
                        (
                            script: [
                                "rustup",
                                "toolchain",
                                "list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
