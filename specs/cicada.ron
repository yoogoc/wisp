                                ),
                                (
                                    name: "podman",
                                ),
                            ],
                            optional: true,
                        ),
                    ],
                    repeat: Many,
                ),
                (
                    names: [
                        "--no-dotenv",
                    ],
                    description: Some("Do not load .env file"),
                ),
