(
    version: 1,
    command: "cicada",
    description: Some("Write CI/CD Pipelines in TypeScript"),
    subcommands: [
        (
            name: "run",
            description: Some("Run a cicada pipeline"),
            options: [
                (
                    names: [
                        "-s",
                        "--secret",
                    ],
                    description: Some("Name of the secret to use, these come from environment variables"),
                    arguments: [
                        (
                            name: "secret",
                            optional: true,
                        ),
                    ],
                    repeat: Many,
                ),
                (
                    names: [
                        "--dotenv",
                    ],
                    description: Some("Load a custom .env file"),
                    arguments: [
                        (
                            name: "dotenv",
                            template: [
                                FilePaths,
                            ],
                            optional: true,
                        ),
                    ],
                    repeat: Many,
                ),
                (
                    names: [
                        "--secrets-json",
                    ],
                    description: Some("Load secrets from a json file"),
