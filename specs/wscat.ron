(
    version: 1,
    command: "wscat",
    description: Some("Communicate over websocket"),
    options: [
        (
            names: [
                "-c",
                "--connect",
            ],
            description: Some("Connect to a WebSocket server"),
            arguments: [
                (
                    name: "url",
                    template: [
                        History,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-V",
                "--version",
            ],
            description: Some("Output the version number"),
        ),
        (
            names: [
                "--auth",
            ],
            description: Some("Add basic HTTP authentication header (--connect only)"),
            arguments: [
                (
                    name: "username:password",
                ),
            ],
            depends_on: [
                "-c",
                "--connect",
            ],
        ),
        (
            names: [
                "--ca",
            ],
            description: Some("Specify a Certificate Authority (--connect only)"),
            arguments: [
                (
                    name: "ca",
                ),
            ],
            depends_on: [
                "-c",
                "--connect",
            ],
        ),
        (
            names: [
                "--cert",
            ],
            description: Some("Specify a Client SSL Certificate (--connect only)"),
            arguments: [
                (
                    name: "cert",
                ),
            ],
            depends_on: [
                "-c",
                "--connect",
            ],
        ),
        (
            names: [
                "--host",
            ],
            description: Some("Optional host"),
            arguments: [
                (
                    name: "host",
                ),
            ],
        ),
        (
            names: [
                "--key",
            ],
            description: Some("Specify a Client SSL Certificate's key (--connect only)"),
            arguments: [
                (
                    name: "key",
                ),
            ],
            depends_on: [
                "-c",
                "--connect",
            ],
        ),
        (
            names: [
                "--max-redirects",
            ],
            description: Some("Maximum number of redirects allowed (--connect only) (default: 10)"),
            arguments: [
                (
                    name: "num",
                ),
            ],
            depends_on: [
                "-c",
                "--connect",
            ],
        ),
        (
            names: [
                "--no-color",
            ],
            description: Some("Run without color"),
        ),
        (
            names: [
                "--passphrase",
            ],
            description: Some("Specify a Client SSL Certificate Key's passphrase (--connect only). If you don't provide a value, it will be prompted for"),
            arguments: [
                (
                    name: "passphrase",
                ),
            ],
            depends_on: [
                "-c",
                "--connect",
            ],
        ),
        (
            names: [
                "--proxy",
            ],
            description: Some("Connect via a proxy. Proxy must support CONNECT method"),
            arguments: [
                (
                    name: "[protocol://]host[:port]",
                ),
            ],
        ),
        (
            names: [
                "--slash",
            ],
            description: Some("Enable slash commands for control frames (/ping, /pong, /close [code [, reason]])"),
        ),
        (
            names: [
                "-H",
                "--header",
            ],
            description: Some("Set an HTTP header. Repeat to set multiple (--connect only) (default: [])"),
            arguments: [
                (
                    name: "header:value",
                ),
            ],
            depends_on: [
                "-c",
                "--connect",
            ],
        ),
        (
            names: [
                "-L",
                "--location",
            ],
            description: Some("Follow redirects (--connect only)"),
            depends_on: [
                "-c",
                "--connect",
            ],
        ),
        (
            names: [
                "-l",
                "--listen",
            ],
            description: Some("Listen on port"),
            arguments: [
                (
                    name: "port",
                ),
            ],
        ),
        (
            names: [
                "-n",
                "--no-check",
            ],
            description: Some("Do not check for unauthorized certificates"),
        ),
        (
            names: [
                "-o",
                "--origin",
            ],
            description: Some("Optional origin"),
            arguments: [
                (
                    name: "origin",
                ),
            ],
        ),
        (
            names: [
                "-p",
                "--protocol",
            ],
            description: Some("Optional protocol version"),
            arguments: [
                (
                    name: "protocol",
                ),
            ],
        ),
        (
            names: [
                "-P",
                "--show-ping-pong",
            ],
            description: Some("Print a notification when a ping or pong is received"),
        ),
        (
            names: [
                "-s",
                "--subprotocol",
            ],
            description: Some("Optional subprotocol (default: [])"),
            arguments: [
                (
                    name: "protocol",
                    suggestions: [
                        (
                            name: "MBWS.huawei.com",
                        ),
