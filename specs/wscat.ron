                        ),
                        (
                            name: "collection-update",
                        ),
                        (
                            name: "TLCP-2.3.0.lightstreamer.com",
                        ),
                        (
                            name: "text.ircv3.net",
                        ),
                        (
                            name: "binary.ircv3.net",
                        ),
                        (
                            name: "v3.penguin-stats.live+proto",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-w",
                "--wait",
            ],
            description: Some("Wait given seconds after executing command"),
            arguments: [
                (
                    name: "seconds",
                ),
            ],
        ),
        (
            names: [
                "-x",
                "--execute",
            ],
            description: Some("Execute command after connecting"),
            arguments: [
                (
                    name: "command",
                ),
            ],
        ),
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Display help for command"),
        ),
    ],
)
