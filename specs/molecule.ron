(
    version: 1,
    command: "molecule",
    description: Some("Molecule aids in the development and testing of Ansible roles"),
    subcommands: [
        (
            name: "check",
            description: Some("Use the provisioner to perform a Dry-Run (destroy, dependency, create, prepare, converge)"),
            options: [
                (
                    names: [
                        "--scenario-name",
                        "-s",
                    ],
                    description: Some("Name of the scenario to target. (default)"),
                    arguments: [
                        (
                            name: "TEXT",
                        ),
                    ],
                ),
                (
                    names: [
                        "--parallel",
                    ],
                    description: Some("Enable parallel mode"),
                    exclusive_on: [
                        "--no-parallel",
                    ],
                ),
                (
                    names: [
                        "--no-parallel",
                    ],
                    description: Some("Disable parallel mode"),
                    exclusive_on: [
                        "--parallel",
                    ],
                ),
            ],
        ),
        (
            name: "cleanup",
            description: Some("Use the provisioner to cleanup any changes made to external systems during the stages of testing"),
            options: [
                (
                    names: [
                        "--scenario-name",
                        "-s",
                    ],
                    description: Some("Name of the scenario to target. (default)"),
                    arguments: [
                        (
                            name: "TEXT",
                        ),
                    ],
                ),
            ],
        ),
