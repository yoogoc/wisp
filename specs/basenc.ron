(
    version: 1,
    command: "basenc",
    description: Some("Encode/decode data and print to standard output"),
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Display this help and exit"),
        ),
        (
            names: [
                "--base64",
            ],
            description: Some("Same as 'base64' program (RFC4648 section 4)"),
        ),
        (
            names: [
                "--base64url",
            ],
            description: Some("File- and url-safe base64 (RFC4648 section 5)"),
        ),
        (
            names: [
                "--base32",
            ],
            description: Some("Same as 'base32' program (RFC4648 section 6)"),
        ),
        (
            names: [
                "--base32hex",
            ],
            description: Some("Extended hex alphabet base32 (RFC4648 section 7)"),
        ),
        (
            names: [
                "--base16",
            ],
            description: Some("Hex encoding (RFC4648 section 8)"),
        ),
        (
            names: [
                "--base2msbf",
            ],
            description: Some("Bit string with most significant bit (msb) first"),
        ),
        (
            names: [
                "--base2lsbf",
            ],
            description: Some("Bit string with least significant bit (lsb) first"),
        ),
        (
            names: [
                "--decode",
                "-d",
            ],
            description: Some("Decode data"),
        ),
        (
            names: [
                "--ignore-garbage",
                "-i",
            ],
            description: Some("When decoding, ignore non-alphabet characters"),
        ),
        (
            names: [
                "--wrap",
                "-w",
            ],
            description: Some("Wrap encoded lines after COLS character (default 76).  Use 0 to disable line wrapping"),
            arguments: [
                (
                    name: "COLS",
                    suggestions: [
                        (
                            name: "76",
                        ),
                        (
                            name: "78",
                        ),
                        (
                            name: "80",
                        ),
                        (
                            name: "100",
                        ),
                        (
                            name: "120",
                        ),
                        (
                            name: "160",
                        ),
                        (
                            name: "0",
                        ),
                    ],
                    default: Some("76"),
                ),
            ],
        ),
        (
            names: [
                "--z85",
            ],
            description: Some("Ascii85-like encoding (ZeroMQ spec:32/Z85); when encoding, input length must be a multiple of 4; when decoding, input length must be a multiple of 5"),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Output version information and exit"),
        ),
    ],
    arguments: [
        (
            name: "FILE",
            description: Some("File(s) to encode/decode"),
            template: [
                FilePaths,
            ],
        ),
    ],
    parser_directives: Some((
        options_must_precede_arguments: true,
    )),
)
