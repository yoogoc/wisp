(
    version: 1,
    command: "cdk8s",
    description: Some("CDK for K8s"),
    subcommands: [
        (
            name: "init",
            description: Some("Create a new, empty CDK8S project"),
            arguments: [
                (
                    name: "type",
                    description: Some("Select language you are using"),
                    suggestions: [
                        (
                            name: "go-app",
                        ),
                        (
                            name: "java-app",
                        ),
                        (
                            name: "python-app",
                        ),
                        (
                            name: "typescript-app",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "import",
            description: Some("Import a CRD schema to generate generate resources"),
            options: [
                (
                    names: [
                        "--language",
                        "-l",
                    ],
                    description: Some("Output programming language"),
                    arguments: [
                        (
                            name: "language",
                            suggestions: [
                                (
                                    name: "typescript",
                                ),
                                (
                                    name: "python",
                                ),
                                (
                                    name: "java",
                                ),
                                (
                                    name: "go",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--class-prefix",
                    ],
                    description: Some("A prefix to add to all generated class names"),
                    exclusive_on: [
                        "--no-class-prefix",
                    ],
                ),
                (
                    names: [
                        "--no-class-prefix",
                    ],
                    description: Some("Does not add a prefix to generated class names"),
                    exclusive_on: [
                        "--class-prefix",
                    ],
                ),
                (
                    names: [
                        "--exclude",
                    ],
                    description: Some("Do not import types that match these regular expressions"),
                    arguments: [
                        (
                            name: "regexp",
                        ),
                    ],
                ),
                (
                    names: [
                        "--output",
                        "-o",
                    ],
                    description: Some("Output directory"),
                    arguments: [
                        (
                            name: "",
                            template: [
                                Folders,
                            ],
                            suggest_current_token: true,
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "spec",
                    description: Some("Path to the CRD schema"),
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "synth",
            description: Some("Synthesizes Kubernetes manifests for all charts in your app"),
            options: [
                (
                    names: [
                        "--app",
                        "-a",
                    ],
                    description: Some("Command to use in order to execute cdk8s app"),
                ),
                (
                    names: [
                        "--output",
                        "-o",
                    ],
                    description: Some("Output directory"),
                    arguments: [
                        (
                            name: "",
                            template: [
                                Folders,
                            ],
                            suggest_current_token: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--stdout",
                        "-s",
                    ],
                    description: Some("Write synthesized manifests to STDOUT instead of the output directory"),
                ),
                (
                    names: [
                        "--plugins-dir",
                    ],
                    description: Some("Directory to store cdk8s plugins"),
                ),
                (
                    names: [
                        "--validate",
                    ],
                    description: Some("Apply validation plugins on the resulting manifests"),
                    exclusive_on: [
                        "--no-validate",
                    ],
                ),
                (
                    names: [
                        "--no-validate",
                    ],
                    description: Some("Disable validation"),
                    exclusive_on: [
                        "--validate",
                    ],
                ),
                (
                    names: [
                        "--validation-reports-output-file",
                    ],
                    description: Some("File to write a JSON representation of the validation reports to"),
                    arguments: [
                        (
                            name: "",
                            template: [
                                FilePaths,
                            ],
                            suggest_current_token: true,
                        ),
                    ],
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--version",
            ],
            description: Some("The current version"),
        ),
        (
            names: [
                "--help",
            ],
            description: Some("Show help"),
        ),
        (
            names: [
                "--check-upgrade",
            ],
            description: Some("Check for cdk8s-cli upgrade"),
        ),
    ],
)
