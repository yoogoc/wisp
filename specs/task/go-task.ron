(
    version: 1,
    command: "go-task",
    description: Some("A task runner / simpler Make alternative written in Go"),
    options: [
        (
            names: [
                "-a",
                "--list-all",
            ],
            description: Some("Lists tasks with or without a description"),
        ),
        (
            names: [
                "-c",
                "--color",
            ],
            description: Some("Colored output. Enabled by default. Set flag to false or use NO_COLOR=1 to disable (default true)"),
            arguments: [
                (
                    name: "color",
                    suggestions: [
                        (
                            name: "true",
                        ),
                        (
                            name: "false",
                        ),
                    ],
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "-C",
                "--concurrency",
            ],
            description: Some("Limit number tasks to run concurrently"),
            arguments: [
                (
                    name: "number",
                ),
            ],
        ),
        (
            names: [
                "-d",
                "--dir",
            ],
            description: Some("Sets directory of execution"),
            arguments: [
                (
                    name: "path",
                    template: [
                        Folders,
                    ],
                ),
            ],
            exclusive_on: [
                "-t",
                "--taskfile",
            ],
        ),
        (
            names: [
                "--dry",
            ],
            description: Some("Compiles and prints tasks in the order that they would be run, without executing them"),
        ),
        (
            names: [
                "-f",
                "--force",
            ],
            description: Some("Forces execution even when the task is up-to-date"),
        ),
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Shows Task usage"),
        ),
        (
            names: [
                "-i",
                "--init",
            ],
            description: Some("Creates a new Taskfile.yml in the current folder"),
        ),
        (
            names: [
                "-l",
                "--list",
            ],
            description: Some("Lists tasks with description of current Taskfile"),
        ),
        (
            names: [
                "-o",
                "--output",
            ],
            description: Some("Sets output style"),
            arguments: [
                (
                    name: "output",
                    suggestions: [
                        (
                            name: "interleaved",
                        ),
                        (
                            name: "group",
                        ),
                        (
                            name: "prefixed",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-p",
                "--parallel",
            ],
            description: Some("Executes tasks provided on command line in parallel"),
        ),
        (
            names: [
                "-s",
                "--silent",
            ],
            description: Some("Disables echoing"),
        ),
        (
            names: [
                "--status",
            ],
            description: Some("Exits with non-zero exit code if any of the given tasks is not up-to-date"),
        ),
        (
            names: [
                "--summary",
            ],
            description: Some("Show summary about a task"),
        ),
        (
            names: [
                "-t",
                "--taskfile",
            ],
            description: Some("Choose which Taskfile to run"),
            arguments: [
                (
                    name: "taskfile",
                    template: [
                        FilePaths,
                    ],
                    default: Some("Taskfile.yml"),
                ),
            ],
            exclusive_on: [
                "-d",
                "--dir",
            ],
        ),
        (
            names: [
                "-v",
                "--verbose",
            ],
            description: Some("Enables verbose mode"),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Show Task version"),
        ),
        (
            names: [
                "-w",
                "--watch",
            ],
            description: Some("Enables watch of the given task"),
        ),
        (
            names: [
                "--",
            ],
            description: Some("Pass variables to the task"),
            arguments: [
                (
                    name: "variables",
                    variadic: true,
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "",
            generators: [
                (
                    script: [
                        "task",
                        "-a",
                    ],
                    has_post_process: true,
                ),
            ],
            optional: true,
            variadic: true,
        ),
    ],
    presentation: (
        icon: Some("https://taskfile.dev/favicon.ico"),
    ),
)
