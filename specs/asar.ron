(
    version: 1,
    command: "asar",
    description: Some("A simple extensive tar-like archive format with indexing"),
    subcommands: [
        (
            name: "pack",
            aliases: [
                "p",
            ],
            description: Some("Create asar archive"),
            arguments: [
                (
                    name: "directory",
                    description: Some("The directory you want to archive"),
                ),
                (
                    name: "output",
                    description: Some("The name of the output file"),
                ),
            ],
        ),
        (
            name: "list",
            aliases: [
                "l",
            ],
            description: Some("List files of asar archive"),
            arguments: [
                (
                    name: "archive",
                    description: Some("The archive file"),
                ),
            ],
        ),
        (
            name: "extract-file",
            aliases: [
                "ef",
            ],
            description: Some("Extract one file from archive"),
            arguments: [
                (
                    name: "archive",
                    description: Some("The archive file"),
                ),
                (
                    name: "filename",
                    description: Some("The name of the file you want to extract"),
                ),
            ],
        ),
        (
            name: "extract",
            aliases: [
                "e",
            ],
            description: Some("Extract archive"),
            arguments: [
                (
                    name: "archive",
                    description: Some("The archive file"),
                ),
                (
                    name: "directory",
                    description: Some("The directory you want to extract to"),
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for asar"),
        ),
        (
            names: [
                "--V",
                "--version",
            ],
            description: Some("Output the version number"),
        ),
    ],
)
