(
    version: 1,
    command: "multipass",
    description: Some("Create, control and connect to Ubuntu instances"),
    subcommands: [
        (
            name: "alias",
            description: Some("Create an alias"),
            arguments: [
                (
                    name: "options",
                    optional: true,
                ),
                (
                    name: "definition",
                    description: Some("Alias definition in the form <instance>:<command>"),
                ),
                (
                    name: "name",
                    description: Some("Name given to the alias being defined, defaults to <command>"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "aliases",
            description: Some("List available aliases"),
            options: [
                (
                    names: [
                        "--format",
                    ],
                    description: Some("Output list in the requested format. Valid formats are: table (default), json, csv and yaml"),
                    arguments: [
                        (
                            name: "format",
                            suggestions: [
                                (
                                    name: "table",
                                ),
                                (
                                    name: "json",
                                ),
                                (
                                    name: "csv",
                                ),
                                (
                                    name: "yaml",
                                ),
                            ],
                            default: Some("table"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "delete",
            description: Some("Delete instances"),
            options: [
                (
                    names: [
                        "--all",
                    ],
                    description: Some("Delete all instances"),
                ),
                (
                    names: [
                        "-p",
                        "--purge",
                    ],
                    description: Some("Purge instances immediately"),
                ),
            ],
            arguments: [
                (
                    name: "name",
                    description: Some("Name of instances to delete"),
                    generators: [
                        (
                            script: [
                                "multipass",
                                "list",
                                "--format=json",
                            ],
                            has_post_process: true,
                        ),
                    ],
                    variadic: true,
                ),
            ],
        ),
        (
            name: "exec",
            description: Some("Run a command on an instance"),
            arguments: [
                (
                    name: "name",
                    description: Some("Name of the instance to run the command on"),
                    generators: [
                        (
                            script: [
                                "multipass",
                                "list",
                                "--format=json",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
                (
                    name: "command",
                    description: Some("Command to execute on the instance"),
                ),
            ],
        ),
        (
            name: "find",
            description: Some("Display available images to create instances from"),
            options: [
                (
                    names: [
                        "--format",
                    ],
                    description: Some("Output list in the requested format. Valid formats are: table (default), json, csv and yaml"),
                    arguments: [
                        (
                            name: "format",
                            suggestions: [
                                (
                                    name: "table",
                                ),
                                (
                                    name: "json",
                                ),
                                (
                                    name: "csv",
                                ),
                                (
                                    name: "yaml",
                                ),
                            ],
                            default: Some("table"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--show-unsupported",
                    ],
                    description: Some("Show unsupported cloud images as well"),
                ),
            ],
            arguments: [
                (
                    name: "string",
                    description: Some("An optional value to search for in [<remote:>]<string> format, where <remote> can be either 'release' or 'daily'. If <remote> is omitted, it will search 'release' first, and if no matches are found, it will then search 'daily'. <string> can be a partial image hash or an Ubuntu release version, codename or alias."),
                    optional: true,
                ),
            ],
        ),
        (
            name: "get",
            description: Some("Get a configuration setting"),
            options: [
                (
                    names: [
                        "--raw",
                    ],
                    description: Some("Output in raw format. For now, this affects only the representation of empty values (i.e. \"\" instead of \"<empty>\")"),
                ),
            ],
            arguments: [
                (
                    name: "key",
                    description: Some("Path to the setting whose configured value should be obtained"),
                    suggestions: [
                        (
                            name: "client.gui.autostart",
                        ),
                        (
                            name: "client.gui.hotkey",
                        ),
                        (
                            name: "client.primary-name",
                        ),
                        (
                            name: "local.bridged-network",
                        ),
                        (
                            name: "local.driver",
                        ),
                        (
                            name: "local.privileged-mounts",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "help",
            description: Some("Display help about a command"),
            arguments: [
                (
                    name: "command",
                    description: Some("Name of command to display help for"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "info",
            description: Some("Display information about instances"),
            options: [
                (
                    names: [
                        "--format",
                    ],
                    description: Some("Output list in the requested format. Valid formats are: table (default), json, csv and yaml"),
                    arguments: [
                        (
                            name: "format",
                            suggestions: [
                                (
                                    name: "table",
                                ),
                                (
                                    name: "json",
                                ),
                                (
                                    name: "csv",
                                ),
                                (
                                    name: "yaml",
                                ),
                            ],
                            default: Some("table"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--all",
                    ],
                    description: Some("Display info for all instances"),
                ),
            ],
            arguments: [
                (
                    name: "name",
                    description: Some("Names of instances to display information about"),
                    generators: [
                        (
                            script: [
                                "multipass",
                                "list",
                                "--format=json",
                            ],
                            has_post_process: true,
                        ),
                    ],
                    variadic: true,
                ),
            ],
        ),
        (
            name: "launch",
            description: Some("Create and start an Ubuntu instance"),
            options: [
                (
                    names: [
                        "--timeout",
                    ],
                    description: Some("Maximum time, in seconds, to wait for the command to complete. Note that some background operations may continue beyond that. By default, instance startup and initialization is limited to 5 minutes each"),
                    arguments: [
                        (
                            name: "timeout",
                            default: Some("300"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-c",
                        "--cpus",
                    ],
                    description: Some("Number of CPUs to allocate. Minimum: 1, default: 1"),
                    arguments: [
                        (
                            name: "cpus",
                            default: Some("1"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-d",
                        "--disk",
                    ],
                    description: Some("Disk space to allocate. Positive integers, in bytes, or with K, M, G suffix Minimum: 512M, default: 5G."),
                    arguments: [
                        (
                            name: "disk",
                            default: Some("5G"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-m",
                        "--mem",
                    ],
                    description: Some("Amount of memory to allocate. Positive integers, in bytes, or with K, M, G suffix Minimum: 128M, default: 1G."),
                    arguments: [
                        (
                            name: "mem",
                            default: Some("1G"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-n",
                        "--name",
                    ],
                    description: Some("Name for the instance. If it is 'primary' (the configured primary instance name), the user's home directory is mounted inside the newly launched instance, in 'Home'"),
                    arguments: [
                        (
                            name: "name",
                            default: Some("primary"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--cloud-init",
                    ],
                    description: Some("Path to a user-data cloud-init configuration, or '-' forstdin"),
                    arguments: [
                        (
                            name: "file",
                        ),
                    ],
                ),
                (
                    names: [
                        "--network",
                    ],
                    description: Some("Add a network interface to the instance, where <spec> is in the \"key=value,key=value\" format"),
                    arguments: [
                        (
                            name: "spec",
                        ),
                    ],
                ),
                (
                    names: [
                        "--bridged",
                    ],
                    description: Some("Adds one `--network bridged` network"),
                ),
            ],
            arguments: [
                (
                    name: "image",
                    description: Some("Optional image to launch. If omitted, then the default Ubuntu LTS will be used"),
                    generators: [
                        (
                            script: [
                                "multipass",
                                "find",
                                "--format=json",
                            ],
                            has_post_process: true,
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "list",
            description: Some("List all available instances"),
            options: [
                (
                    names: [
                        "--format",
                    ],
                    description: Some("Output list in the requested format. Valid formats are: table (default), json, csv and yaml"),
                    arguments: [
                        (
                            name: "format",
                            suggestions: [
                                (
                                    name: "table",
                                ),
                                (
                                    name: "json",
                                ),
                                (
                                    name: "csv",
                                ),
                                (
                                    name: "yaml",
                                ),
                            ],
                            default: Some("table"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "mount",
            description: Some("Mount a local directory in the instance"),
            options: [
                (
                    names: [
                        "-g",
                        "--gid-map",
                    ],
                    description: Some("A mapping of group IDs for use in the mount. File and folder ownership will be mapped from <host> to <instance> inside the instance. Can be used multiple times"),
                    arguments: [
                        (
                            name: "host:instance",
                        ),
                    ],
                ),
                (
                    names: [
                        "-u",
                        "--uid-map",
                    ],
                    description: Some("A mapping of user IDs for use in the mount. File and folder ownership will be mapped from <host> to <instance> inside the instance. Can be used multiple times"),
                    arguments: [
                        (
                            name: "host:instance",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "source",
                    description: Some("Path to the local directory to mount"),
                    template: [
                        Folders,
                    ],
                ),
                (
                    name: "target",
                    description: Some("Target mount points, in <name>[:<path>] format, where <name> is an instance name, and optional <path> is the mount point. If omitted, the mount point will be the same as the source's absolute path"),
                    variadic: true,
                ),
            ],
        ),
        (
            name: "networks",
            description: Some("List all available networks interfaces"),
            options: [
                (
                    names: [
                        "--format",
                    ],
                    description: Some("Output list in the requested format. Valid formats are: table (default), json, csv and yaml"),
                    arguments: [
                        (
                            name: "format",
                            suggestions: [
                                (
                                    name: "table",
                                ),
                                (
                                    name: "json",
                                ),
                                (
                                    name: "csv",
                                ),
                                (
                                    name: "yaml",
                                ),
                            ],
                            default: Some("table"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "purge",
            description: Some("Purge all deleted instances permanently"),
        ),
        (
            name: "recover",
            description: Some("Recover deleted instances"),
            options: [
                (
                    names: [
                        "--all",
                    ],
                    description: Some("Recover all deleted instances"),
                ),
            ],
            arguments: [
                (
                    name: "name",
                    description: Some("Names of instances to recover"),
                    generators: [
                        (
                            script: [
                                "multipass",
                                "list",
                                "--format=json",
                            ],
                            has_post_process: true,
                        ),
                    ],
                    variadic: true,
                ),
            ],
        ),
        (
            name: "restart",
            description: Some("Restart instances"),
            options: [
                (
                    names: [
                        "--timeout",
                    ],
                    description: Some("Maximum time, in seconds, to wait for the command to complete. Note that some background operations may continue beyond that. By default, instance startup and initialization is limited to 5 minutes each"),
                    arguments: [
                        (
                            name: "timeout",
                            default: Some("300"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--all",
                    ],
                    description: Some("Restart all instances"),
                ),
            ],
            arguments: [
                (
                    name: "name",
                    description: Some("Names of instances to restart. If omitted, and without the --all option, 'primary' will be assumed"),
                    generators: [
                        (
                            script: [
                                "multipass",
                                "list",
                                "--format=json",
                            ],
                            has_post_process: true,
                        ),
                    ],
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "set",
            description: Some("Set a configuration setting"),
            arguments: [
                (
                    name: "key=value",
                    description: Some("A key-value pair. The key specifies a path to the setting to configure. The value is its intended value"),
                    suggestions: [
                        (
                            name: "client.gui.autostart=",
                        ),
                        (
                            name: "client.gui.hotkey=",
                        ),
                        (
                            name: "client.primary-name=",
                        ),
                        (
                            name: "local.bridged-network=",
                        ),
                        (
                            name: "local.driver=",
                        ),
                        (
                            name: "local.privileged-mounts=",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "shell",
            description: Some("Open a shell on a running instance"),
            options: [
                (
                    names: [
                        "--timeout",
                    ],
                    description: Some("Maximum time, in seconds, to wait for the command to complete. Note that some background operations may continue beyond that. By default, instance startup and initialization is limited to 5 minutes each"),
                    arguments: [
                        (
                            name: "timeout",
                            default: Some("300"),
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "name",
                    description: Some("Name of the instance to open a shell on. If omitted, 'primary' (the configured primary instance name) will be assumed. If the instance is not running, an attempt is made to start it (see `start` for more info)"),
                    generators: [
                        (
                            script: [
                                "multipass",
                                "list",
                                "--format=json",
                            ],
                            has_post_process: true,
                        ),
                    ],
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "start",
            description: Some("Start instances"),
            options: [
                (
                    names: [
                        "--timeout",
                    ],
                    description: Some("Maximum time, in seconds, to wait for the command to complete. Note that some background operations may continue beyond that. By default, instance startup and initialization is limited to 5 minutes each"),
                    arguments: [
                        (
                            name: "timeout",
                            default: Some("300"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--all",
                    ],
                    description: Some("Start all instances"),
                ),
            ],
            arguments: [
                (
                    name: "name",
                    description: Some("Names of instances to start. If omitted, and without the --all option, 'primary' (the configured primary instance name) will be assumed. If 'primary' does not exist but is included in a successful start command either implicitly or explicitly), it is launched automatically (see`launch` for more info)."),
                    generators: [
                        (
                            script: [
                                "multipass",
                                "list",
                                "--format=json",
                            ],
                            has_post_process: true,
                        ),
                    ],
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "stop",
            description: Some("Stop running instances"),
            options: [
                (
                    names: [
                        "--all",
                    ],
                    description: Some("Stop all instances"),
                ),
                (
                    names: [
                        "-t",
                        "--time",
                    ],
                    description: Some("Time from now, in minutes, to delay shutdown of the instance"),
                    arguments: [
                        (
                            name: "time",
                        ),
                    ],
                ),
                (
                    names: [
                        "-c",
                        "--cancel",
                    ],
                    description: Some("Cancel a pending delayed shutdown"),
                ),
            ],
            arguments: [
                (
                    name: "name",
                    description: Some("Names of instances to stop. If omitted, and without the --all option, 'primary' will be assumed."),
                    generators: [
                        (
                            script: [
                                "multipass",
                                "list",
                                "--format=json",
                            ],
                            has_post_process: true,
                        ),
                    ],
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "suspend",
            description: Some("Suspend running instances"),
            options: [
                (
                    names: [
                        "--all",
                    ],
                    description: Some("Suspend all instances"),
                ),
            ],
            arguments: [
                (
                    name: "name",
                    description: Some("Names of instances to suspend. If omitted, and without the --all option, 'primary' will be assumed."),
                    generators: [
                        (
                            script: [
                                "multipass",
                                "list",
                                "--format=json",
                            ],
                            has_post_process: true,
                        ),
                    ],
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "transfer",
            description: Some("Transfer files between the host and instances"),
            arguments: [
                (
                    name: "source",
                    description: Some("One or more paths to transfer, prefixed with <name:> for paths inside the instance, or '-' for stdin"),
                    template: [
                        FilePaths,
                    ],
                    variadic: true,
                ),
                (
                    name: "destination",
                    description: Some("The destination path, prefixed with <name:> for paths inside the instance, or '-' for stdout"),
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "umount",
            description: Some("Unmount a directory from an instance"),
            arguments: [
                (
                    name: "mount",
                    description: Some("Mount points, in <name>[:<path>] format, where <name> are instance names, and optional <path> are mount points. If omitted, all mounts will be removed from the named instances."),
                    variadic: true,
                ),
            ],
        ),
        (
            name: "unalias",
            description: Some("Remove an alias"),
            arguments: [
                (
                    name: "name",
                    description: Some("The name of the alias to remove"),
                ),
            ],
        ),
        (
            name: "version",
            description: Some("Show version details"),
            options: [
                (
                    names: [
                        "--format",
                    ],
                    description: Some("Output list in the requested format. Valid formats are: table (default), json, csv and yaml"),
                    arguments: [
                        (
                            name: "format",
                            suggestions: [
                                (
                                    name: "table",
                                ),
                                (
                                    name: "json",
                                ),
                                (
                                    name: "csv",
                                ),
                                (
                                    name: "yaml",
                                ),
                            ],
                            default: Some("table"),
                        ),
                    ],
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Displays help on commandline options"),
            persistent: true,
        ),
        (
            names: [
                "--help-all",
            ],
            description: Some("Displays help including Qt specific options"),
            persistent: true,
        ),
        (
            names: [
                "-v",
                "--verbose",
            ],
            description: Some("Increase logging verbosity. Repeat the 'v' in the short option for more detail. Maximum verbosity is obtained with 4 (or more) v's, i.e. -vvvv"),
            persistent: true,
        ),
    ],
)
