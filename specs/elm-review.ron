(
    version: 1,
    command: "elm-review",
    subcommands: [
        (
            name: "init",
            description: Some("Initialize Elm Review in this directory"),
            options: [
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Show help for elm-review init"),
                ),
                (
                    names: [
                        "--config",
                    ],
                    description: Some("Create the configuration files in the specified directory instead of in the review/ directory"),
                    arguments: [
                        (
                            name: "<path-to-review-directory>",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--template",
                    ],
                    description: Some("Copy the review configuration from a GitHub repository, at the root or in a folder"),
                    arguments: [
                        (
                            name: "<author>/<repo>[/path-to-the-config-folder][#branch-or-commit]",
                        ),
                    ],
                ),
                (
                    names: [
                        "--compiler",
                    ],
                    description: Some("Specify the path to the elm compiler"),
                    arguments: [
                        (
                            name: "<path-to-elm>",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "suppress",
            description: Some("Generate suppression files for rules that report many errors"),
            options: [
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Show help for elm-review suppress"),
                ),
                (
                    names: [
                        "--check-after-tests",
                    ],
                    description: Some("Checks whether there are uncommitted suppression files"),
                ),
                (
                    names: [
                        "--unsuppress",
                    ],
                    description: Some("Include suppressed errors in the error report for all rules"),
                ),
                (
                    names: [
                        "--unsuppress-rules",
                    ],
                    description: Some("Include suppressed errors in the error report for all rules"),
                    arguments: [
                        (
                            name: "<rule1,rule2,...>",
                            variadic: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "new-package",
            description: Some("Creates an new project aimed to contain rules and to be published later"),
            options: [
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Show help for elm-review new-package"),
                ),
                (
                    names: [
                        "--compiler",
                    ],
                    description: Some("Specify the path to the elm compiler"),
                    arguments: [
                        (
                            name: "<path-to-elm>",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "new-rule",
            description: Some("Adds a new rule to your review configuration or review package"),
            options: [
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Show help for elm-review new-package"),
                ),
            ],
            arguments: [
                (
                    name: "rule name",
                    description: Some("Add a rule file in src/ and a corresponding test file in tests/. Should be formatted just like an Elm module name, such as NoDoingThis or No.Doing.This"),
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for elm-review"),
        ),
        (
            names: [
                "--unsuppress",
            ],
            description: Some("Include suppressed errors in the error report for all rules"),
        ),
        (
            names: [
                "--rules",
            ],
            description: Some("Run with a subsection of the rules in the configuration. Specify them by their name, and separate them by commas"),
            arguments: [
                (
                    name: "<rule1,rule2,...>",
                    description: Some("Run with a subsection of the rules in the configuration"),
                    variadic: true,
                ),
            ],
        ),
        (
            names: [
                "--watch",
            ],
            description: Some("Re-run elm-review automatically when your project or configuration changes"),
        ),
        (
            names: [
                "--watch-code",
            ],
            description: Some("Re-run elm-review automatically when your project changes"),
        ),
        (
            names: [
                "--elmjson",
            ],
            description: Some("Specify the path to the elm.json file of the project"),
            arguments: [
                (
                    name: "<path-to-elm.json>",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--config",
            ],
            description: Some("Use the review configuration in the specified directory"),
            arguments: [
                (
                    name: "<path-to-review-directory>",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--template",
            ],
            description: Some("Use the review configuration from a GitHub repository"),
            arguments: [
                (
                    name: "<author>/<repo>[/path-to-the-config-folder][#branch-or-commit]",
                ),
            ],
        ),
        (
            names: [
                "--compiler",
            ],
            description: Some("Specify the path to the elm compiler"),
            arguments: [
                (
                    name: "<path-to-elm>",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--version",
                "-v",
            ],
            description: Some("Print the version of the elm-review CLI"),
        ),
        (
            names: [
                "--debug",
            ],
            description: Some("Add helpful information to debug your configuration or rules"),
        ),
        (
            names: [
                "--report",
            ],
            description: Some("Error reports will be in JSON format"),
            arguments: [
                (
                    name: "json or ndjson",
                    suggestions: [
                        (
                            name: "json",
                            description: Some("Prints a single JSON object"),
                        ),
                        (
                            name: "ndjson",
                            description: Some("Print one JSON object per error each on a new line"),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--no-details",
            ],
            description: Some("Hide the details from error reports for a more compact view"),
        ),
        (
            names: [
                "--ignore-dirs",
            ],
            description: Some("Ignore the reports of all rules for the specified directories"),
            arguments: [
                (
                    name: "<dir1,dir2,...>",
                    template: [
                        Folders,
                    ],
                    variadic: true,
                ),
            ],
        ),
        (
            names: [
                "--ignore-files",
            ],
            description: Some("Ignore the reports of all rules for the specified files"),
            arguments: [
                (
                    name: "<file1,file2,...>",
                    template: [
                        FilePaths,
                    ],
                    variadic: true,
                ),
            ],
        ),
        (
            names: [
                "--fix",
            ],
            description: Some("Elm Review will present fixes for the errors that offer an automatic fix, which you can then accept or refuse one by one"),
        ),
        (
            names: [
                "--fix-all",
            ],
            description: Some("Elm Review will present a single fix containing the application of all available automatic fixes, which you can then accept or refuse"),
        ),
        (
            names: [
                "--elm-format-path",
            ],
            description: Some("Specify the path to elm-format"),
            arguments: [
                (
                    name: "<path-to-elm-format>",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--fix-limit",
            ],
            description: Some("Limit the number of fixes applied in a single batch to N"),
            arguments: [
                (
                    name: "N",
                    description: Some("The number of fixes to apply before prompting the user"),
                ),
            ],
        ),
        (
            names: [
                "--extract",
            ],
            description: Some("Enable extracting data from the project for the rules that have a data extractor. Requires running with --report=json. Learn more by reading the section about \"Extracting information\" at https://bit.ly/3UmNr0V"),
        ),
        (
            names: [
                "--benchmark-info",
            ],
            description: Some("Print out how much time it took for rules and phases of the process to run. This is meant for benchmarking purposes"),
        ),
        (
            names: [
                "--no-color",
            ],
            description: Some("Disable colors in the output"),
        ),
    ],
    arguments: [
        (
            name: "files or directories to review",
            template: [
                FilePaths,
                Folders,
            ],
            variadic: true,
        ),
    ],
)
