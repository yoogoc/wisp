                        (
                            names: [
                                "-t",
                                "--title",
                            ],
                            description: Some("Supply a title. Will prompt for one otherwise"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                            presentation: (
                                insert_value: Some("-t '{cursor}'"),
                            ),
                        ),
                        (
                            names: [
                                "-w",
                                "--web",
                            ],
                            description: Some("Open the browser to create an issue"),
