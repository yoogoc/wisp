(
    version: 1,
    command: "gh",
    description: Some("GitHub's CLI tool"),
    subcommands: [
        (
            name: "alias",
            description: Some("Create command shortcuts"),
            subcommands: [
                (
                    name: "delete",
                    description: Some("Delete an alias"),
                    arguments: [
                        (
                            name: "alias",
                            generators: [
                                (
                                    script: [
                                        "gh",
                                        "alias",
                                        "list",
                                    ],
                                    pipeline: Lines((delimiter: Some(":"), name: 0, description: Some(From(1)))),
                                    has_post_process: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "list",
                    description: Some("List available aliases"),
                ),
                (
                    name: "set",
                    description: Some("Set an alias for a gh command"),
                    options: [
                        (
                            names: [
                                "-s",
                                "--shell",
                            ],
                            description: Some("Declare an alias to be passed through a shell interpreter"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "alias",
                            description: Some("A word that will expand to the gh command"),
                        ),
                        (
                            name: "expansion",
                            description: Some("The gh command to be invoked, more info with --help"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "api",
            description: Some("Make an authenticated GitHub API request"),
        ),
        (
            name: "auth",
            description: Some("Login, logout, and refresh your authentication"),
            subcommands: [
                (
                    name: "login",
                    description: Some("Authenticate with a GitHub host"),
                    options: [
                        (
                            names: [
                                "-h",
                                "--hostname",
                            ],
                            description: Some("The hostname of the GitHub instance to authenticate with"),
                            arguments: [
                                (
                                    name: "hostname",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-s",
                                "--scopes",
                            ],
                            description: Some("Additional authentication scopes for gh to have"),
                            arguments: [
                                (
                                    name: "scopes",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-w",
                                "--web",
                            ],
                            description: Some("Open a browser to authenticate"),
                        ),
                        (
                            names: [
                                "--with-token",
                            ],
                            description: Some("Read token from standard input"),
                            arguments: [
                                (
                                    name: "token",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "logout",
                    description: Some("Log out of a GitHub host"),
                    options: [
                        (
                            names: [
                                "-h",
                                "--hostname",
                            ],
                            description: Some("The hostname of the GitHub instance to authenticate with"),
                            arguments: [
                                (
                                    name: "hostname",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "refresh",
                    description: Some("Refresh stored authentication credentials"),
                    options: [
                        (
                            names: [
                                "-h",
                                "--hostname",
                            ],
                            description: Some("The hostname of the GitHub instance to authenticate with"),
                            arguments: [
                                (
                                    name: "hostname",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-s",
                                "--scopes",
                            ],
                            description: Some("Additional authentication scopes for gh to have"),
                            arguments: [
                                (
                                    name: "scopes",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "setup-git",
                    description: Some("Configure git to use GitHub CLI as a credential helper"),
                    options: [
                        (
                            names: [
                                "-h",
                                "--hostname",
                            ],
                            description: Some("The hostname of the GitHub instance to authenticate with"),
                            arguments: [
                                (
                                    name: "hostname",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "status",
                    description: Some("View authentication status"),
                    options: [
                        (
                            names: [
                                "-h",
                                "--hostname",
                            ],
                            description: Some("The hostname of the GitHub instance to authenticate with"),
                            arguments: [
                                (
                                    name: "hostname",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--with-token",
                            ],
                            description: Some("Read token from standard input"),
                            arguments: [
                                (
                                    name: "token",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "gpg-key",
            description: Some("Manage GPG keys registered with your GitHub account"),
            subcommands: [
                (
                    name: "add",
                    description: Some("Add a GPG key to your GitHub account"),
                ),
                (
                    name: "list",
                    description: Some("Lists GPG keys in your GitHub account"),
                ),
            ],
        ),
        (
            name: "browse",
            description: Some("Open the repository in the browser"),
            options: [
                (
                    names: [
                        "-b",
                        "--branch",
                    ],
                    description: Some("Select another branch by passing in the branch name"),
                    arguments: [
                        (
                            name: "branch",
                            generators: [
                                (
                                    script: [
                                        "git",
                                        "--no-optional-locks",
                                        "branch",
                                        "-r",
                                        "--no-color",
                                        "--sort=-committerdate",
                                    ],
                                    pipeline: Lines((strip_prefix: Some("* "), reject_containing: ["HEAD detached"])),
                                    kind: Branch,
                                    has_post_process: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-c",
                        "--commit",
                    ],
                    description: Some("Open the last commit"),
                ),
                (
                    names: [
                        "-n",
                        "--no-browser",
                    ],
                    description: Some("Print destination URL instead of opening the browser"),
                ),
                (
                    names: [
                        "-p",
                        "--projects",
                    ],
                    description: Some("Open repository projects"),
                ),
                (
                    names: [
                        "-R",
                        "--repo",
                    ],
                    description: Some("Select another repository using the [HOST/]OWNER/REPO format"),
                    arguments: [
                        (
                            name: "[HOST/]OWNER/REPO",
                        ),
                    ],
                ),
                (
                    names: [
                        "-s",
                        "--settings",
                    ],
                    description: Some("Open repository settings"),
                ),
                (
                    names: [
                        "-w",
                        "--wiki",
                    ],
                    description: Some("Open repository wiki"),
                ),
            ],
            arguments: [
                (
                    name: "[pr | issue | path[:line]",
                    generators: [
                        (
                            script: [
                                "gh",
                                "pr",
                                "list",
                                "--json=number,title,headRefName,state",
                            ],
                            pipeline: Json((name: Some("number"), description: Some("title"))),
                            has_post_process: true,
                            cache: Some((
                                stale_while_revalidate: true,
                            )),
                        ),
                    ],
                    suggest_current_token: true,
                ),
            ],
        ),
        (
            name: "completion",
            description: Some("Generate shell completion scripts"),
            options: [
                (
                    names: [
                        "-s",
                        "--shell",
                    ],
                    arguments: [
                        (
                            name: "shell",
                            suggestions: [
                                (
                                    name: "bash",
                                ),
                                (
                                    name: "zsh",
                                ),
                                (
                                    name: "fish",
                                ),
                                (
                                    name: "powershell",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "config",
            description: Some("Manage configuration for gh"),
            subcommands: [
                (
                    name: "get",
                    description: Some("Print the value of a given configuration key"),
                    options: [
                        (
                            names: [
                                "-h",
                                "--host",
                            ],
                            description: Some("Get per-host setting"),
                            arguments: [
                                (
                                    name: "host",
                                ),
                            ],
                        ),
                    ],
                    arguments: [
                        (
                            name: "key",
                            suggestions: [
                                (
                                    name: "git_protocol",
                                ),
                                (
                                    name: "editor",
                                ),
                                (
                                    name: "prompt",
                                ),
                                (
                                    name: "pager",
                                ),
                                (
                                    name: "http_unix_socket",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "set",
                    description: Some("Update configuration with a value for the given key"),
                    subcommands: [
                        (
                            name: "git_protocol",
                            description: Some("The protocol to use for git clone and push operations"),
                            arguments: [
                                (
                                    name: "option",
                                    suggestions: [
                                        (
                                            name: "https",
                                        ),
                                        (
                                            name: "ssh",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            name: "editor",
                            description: Some("The text editor program to use for authoring text"),
                            arguments: [
                                (
                                    name: "editor",
                                    suggestions: [
                                        (
                                            name: "vim",
                                        ),
                                        (
                                            name: "nano",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            name: "prompt",
                            description: Some("Toggle interactive prompting in the terminal"),
                            arguments: [
                                (
                                    name: "value",
                                    suggestions: [
                                        (
                                            name: "enable",
                                        ),
                                        (
                                            name: "disable",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            name: "pager",
                            description: Some("The terminal pager program to send standard output to"),
                            arguments: [
                                (
                                    name: "value",
                                ),
                            ],
                            presentation: (
                                insert_value: Some("pager {cursor}"),
                            ),
                        ),
                        (
                            name: "http_unix_socket",
                            description: Some("The path to a unix socket through which to make HTTP connection"),
                            arguments: [
                                (
                                    name: "path",
                                ),
                            ],
                        ),
                    ],
                    options: [
                        (
                            names: [
                                "-h",
                                "--host",
                            ],
                            description: Some("Get per-host setting"),
                            arguments: [
                                (
                                    name: "host",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "extensions",
            description: Some("Manage gh extensions"),
            subcommands: [
                (
                    name: "create",
                    description: Some("Create a new extension"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                ),
                (
                    name: "install",
                    description: Some("Install a gh extension from a repository"),
                    arguments: [
                        (
                            name: "repo",
                        ),
                    ],
                ),
                (
                    name: "list",
                    description: Some("List installed extension commands"),
                ),
                (
                    name: "remove",
                    description: Some("Remove an installed extension"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                ),
                (
                    name: "upgrade",
                    description: Some("Upgrade installed extensions"),
                    options: [
                        (
                            names: [
                                "--all",
                            ],
                            description: Some("Upgrade all extensions"),
                        ),
                        (
                            names: [
                                "--force",
                            ],
                            description: Some("Force upgrade extensions"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "gist",
            description: Some("Manage gists"),
            subcommands: [
                (
                    name: "clone",
                    description: Some("Clone a gist locally"),
                    arguments: [
                        (
                            name: "gist",
                            description: Some("Gist ID or URL"),
                        ),
                        (
                            name: "directory",
                            template: [
                                Folders,
                            ],
                            optional: true,
                        ),
                    ],
                ),
                (
                    name: "create",
                    description: Some("Create a new gist"),
                    options: [
                        (
                            names: [
                                "-d",
                                "--desc",
                            ],
                            description: Some("A description for this gist"),
                            arguments: [
                                (
                                    name: "description",
                                ),
                            ],
                            presentation: (
                                insert_value: Some("-d '{cursor}'"),
                            ),
                        ),
                        (
                            names: [
                                "-f",
                                "--filename",
                            ],
                            description: Some("Provide a filename to be used when reading from STDIN"),
                            arguments: [
                                (
                                    name: "filename",
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-p",
                                "--public",
                            ],
                            description: Some("List the gist publicly (default: secret)"),
                        ),
                        (
                            names: [
                                "-w",
                                "--web",
                            ],
                            description: Some("Open the web browser with created gist"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "filename",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    name: "delete",
                    description: Some("Delete a gist"),
                    arguments: [
                        (
                            name: "gist",
                            description: Some("Gist ID or URL"),
                        ),
                    ],
                ),
                (
                    name: "edit",
                    description: Some("Edit one of your gists"),
                    options: [
                        (
                            names: [
                                "-a",
                                "--add",
                            ],
                            description: Some("Add a new file to the gist"),
                            arguments: [
                                (
                                    name: "filename",
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-f",
                                "--filename",
                            ],
                            description: Some("Select a file to edit"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "gist",
                            description: Some("Gist ID or URL"),
                        ),
                    ],
                ),
                (
                    name: "list",
                    description: Some("List your gists"),
                    options: [
                        (
                            names: [
                                "-L",
                                "--limit",
                            ],
                            description: Some("Maximum number of gists to fetch (default 10)"),
                            arguments: [
                                (
                                    name: "int",
                                ),
                            ],
                            presentation: (
                                display_name: Some("-L, --limit"),
                            ),
                        ),
                        (
                            names: [
                                "--public",
                            ],
                            description: Some("Show only public gists"),
                        ),
                        (
                            names: [
                                "--secret",
                            ],
                            description: Some("Show only secret gists"),
                        ),
                    ],
                ),
                (
                    name: "view",
                    description: Some("View a gist"),
                    options: [
                        (
                            names: [
                                "-f",
                                "--filename",
                            ],
                            description: Some("Display a single file from the gist"),
                        ),
                        (
                            names: [
                                "--files",
                            ],
                            description: Some("List file names from the gist"),
                        ),
                        (
                            names: [
                                "-r",
                                "--raw",
                            ],
                            description: Some("Print raw instead of rendered gist contents"),
                        ),
                        (
                            names: [
                                "-w",
                                "--web",
                            ],
                            description: Some("Open gist in the browser"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "gist",
                            description: Some("Gist ID or URL"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "issue",
            description: Some("Manage issues"),
            subcommands: [
                (
                    name: "close",
                    description: Some("Close issue"),
                    options: [
                        (
                            names: [
                                "-R",
                                "--repo",
                            ],
                            description: Some("Select another repository using the [HOST/]OWNER/REPO format"),
                            arguments: [
                                (
                                    name: "repo",
                                ),
                            ],
                            presentation: (
                                insert_value: Some("-R '{cursor}'"),
                            ),
                        ),
                    ],
                    arguments: [
                        (
                            name: "issue",
                            description: Some("Number or URL"),
                        ),
                    ],
                ),
                (
                    name: "comment",
                    description: Some("Create a new issue comment"),
                    options: [
                        (
                            names: [
                                "-R",
                                "--repo",
                            ],
                            description: Some("Select another repository using the [HOST/]OWNER/REPO format"),
                            arguments: [
                                (
                                    name: "repo",
                                ),
                            ],
                            presentation: (
                                insert_value: Some("-R '{cursor}'"),
                            ),
                        ),
                        (
                            names: [
                                "-b",
                                "--body",
                            ],
                            description: Some("Supply a body. Will prompt for one otherwise"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                            presentation: (
                                insert_value: Some("-b '{cursor}'"),
                            ),
                        ),
                        (
                            names: [
                                "-F",
                                "--body-file",
                            ],
                            description: Some("Read body text from file"),
                            arguments: [
                                (
                                    name: "file",
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-e",
                                "--editor",
                            ],
                            description: Some("Add body using editor"),
                            arguments: [
                                (
                                    name: "editor",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-w",
                                "--web",
                            ],
                            description: Some("Add body in browser"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "issue",
                            description: Some("Number or URL"),
                        ),
                    ],
                ),
                (
                    name: "create",
                    description: Some("Create a new issue"),
                    options: [
                        (
                            names: [
                                "-R",
                                "--repo",
                            ],
                            description: Some("Select another repository using the [HOST/]OWNER/REPO format"),
                            arguments: [
                                (
                                    name: "repo",
                                ),
                            ],
                            presentation: (
                                insert_value: Some("-R '{cursor}'"),
                            ),
                        ),
                        (
                            names: [
                                "-a",
                                "--assignee",
                            ],
                            description: Some("Assign people by their login. Use \"@me\" to self-assign"),
                            arguments: [
                                (
                                    name: "login",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-b",
                                "--body",
                            ],
                            description: Some("Supply a body. Will prompt for one otherwise"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                            presentation: (
                                insert_value: Some("-b '{cursor}'"),
                            ),
