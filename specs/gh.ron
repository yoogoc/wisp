                            ],
                            description: Some("Read body text from file"),
                            arguments: [
                                (
                                    name: "file",
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-l",
                                "--label",
                            ],
                            description: Some("Add labels by name"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                            presentation: (
                                insert_value: Some("-l '{cursor}'"),
                            ),
                        ),
                        (
                            names: [
                                "-m",
                                "--milestone",
                            ],
                            description: Some("Add the issue to a milestone by name"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-p",
                                "--project",
                            ],
                            description: Some("Add the issue to projects by name"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                            presentation: (
                                insert_value: Some("-p '{cursor}'"),
