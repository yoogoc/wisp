(
    version: 1,
    command: "@withfig/autocomplete-tools",
    description: Some("Dev tools for fig's autocomplete"),
    subcommands: [
        (
            name: "init",
            description: Some("Initialize fig custom spec boilerplate in current directory"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Display help for command"),
                    presentation: (
                        priority: Some(49.0),
                    ),
                ),
            ],
        ),
        (
            name: "create-spec",
            description: Some("Create spec with given name"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Display help for command"),
                    presentation: (
                        priority: Some(49.0),
                    ),
                ),
            ],
            arguments: [
                (
                    name: "name",
                    optional: true,
                ),
            ],
        ),
        (
            name: "compile",
            description: Some("Compile specs in the current directory"),
            options: [
                (
                    names: [
                        "-w",
                        "--watch",
                    ],
                    description: Some("Watch files and re-compile on change"),
                ),
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Display help for command"),
                    presentation: (
                        priority: Some(49.0),
                    ),
                ),
            ],
        ),
        (
            name: "dev",
            description: Some("Watch for changes and compile specs"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Display help for command"),
                    presentation: (
                        priority: Some(49.0),
                    ),
                ),
            ],
        ),
        (
            name: "merge",
            description: Some("Deep merge new spec into old spec"),
            options: [
                (
                    names: [
                        "-n",
                        "--new-file",
                    ],
                    description: Some("Create a new spec file instead of updating the old one"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-i",
                        "--ignore-props",
                    ],
                    description: Some("The props that should always be overridden"),
                    arguments: [
                        (
                            name: "props",
                        ),
                    ],
                    exclusive_on: [
                        "--preset",
                    ],
                ),
                (
                    names: [
                        "--ignore-command-props",
                    ],
                    description: Some("The command props that should always be overridden"),
                    arguments: [
                        (
                            name: "props",
                        ),
                    ],
                    exclusive_on: [
                        "--preset",
                    ],
                ),
                (
                    names: [
                        "--ignore-option-props",
                    ],
                    description: Some("The option props that should always be overridden"),
                    arguments: [
                        (
                            name: "props",
                        ),
                    ],
                    exclusive_on: [
                        "--preset",
                    ],
                ),
                (
                    names: [
                        "--ignore-arg-props",
                    ],
                    description: Some("The arg props that should always be overridden"),
                    arguments: [
                        (
                            name: "props",
                        ),
                    ],
                    exclusive_on: [
                        "--preset",
                    ],
                ),
                (
                    names: [
                        "-p",
                        "--preset",
                    ],
                    description: Some("Use a preset"),
                    arguments: [
                        (
                            name: "name",
                            suggestions: [
                                (
                                    name: "commander",
                                ),
                                (
                                    name: "oclif",
                                ),
                                (
                                    name: "cobra",
                                ),
                                (
                                    name: "clap",
                                ),
                                (
                                    name: "swift-argument-parser",
                                ),
                                (
                                    name: "click",
                                ),
                                (
                                    name: "argparse",
                                ),
                                (
                                    name: "cement",
                                ),
                            ],
                        ),
                    ],
                    exclusive_on: [
                        "--ignore-props",
                        "--ignore-command-props",
                        "--ignore-option-props",
                        "--ignore-arg-props",
                    ],
                    presentation: (
                        priority: Some(76.0),
                    ),
                ),
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Display help for command"),
                    presentation: (
                        priority: Some(49.0),
                    ),
                ),
            ],
            arguments: [
                (
                    name: "oldspec",
                    template: [
                        FilePaths,
                    ],
                ),
                (
                    name: "newspec",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "version",
            subcommands: [
                (
                    name: "add-diff",
                    description: Some("Generate version diff from new spec and add into old spec"),
                    options: [
                        (
                            names: [
                                "-n",
                                "--new-path",
                            ],
                            description: Some("The root folder where the updated spec will be saved. Note: this must NOT include the folder spec name"),
                            arguments: [
                                (
                                    name: "path",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--cwd",
                            ],
                            description: Some("Resolve the spec name relative to this directory"),
                            arguments: [
                                (
                                    name: "path",
                                    template: [
                                        Folders,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--use-minor-base",
                            ],
                            description: Some("Create a new version file per minor version"),
                        ),
                        (
                            names: [
                                "-h",
                                "--help",
                            ],
                            description: Some("Display help for command"),
                            presentation: (
                                priority: Some(49.0),
                            ),
                        ),
                    ],
                    arguments: [
                        (
                            name: "specName",
                        ),
                        (
                            name: "newSpecFilePath",
                            generators: [
                                (
                                    has_custom: true,
                                    has_dynamic_trigger: true,
                                    has_dynamic_query_term: true,
                                ),
                            ],
                        ),
                        (
                            name: "diffVersion",
                        ),
                    ],
                ),
                (
                    name: "init-spec",
                    description: Some("Generate versioned spec in folder specified by path"),
                    options: [
                        (
                            names: [
                                "--cwd",
                            ],
                            description: Some("Generate the spec relative to this directory"),
                            arguments: [
                                (
                                    name: "path",
                                    template: [
                                        Folders,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-h",
                                "--help",
                            ],
                            description: Some("Display help for command"),
                            presentation: (
                                priority: Some(49.0),
                            ),
                        ),
                    ],
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                ),
                (
                    name: "precompute-specs",
                    description: Some("[Unimplemented] Precompute versioned specs before publishing the specs repo (unimplemented)"),
                    options: [
                        (
                            names: [
                                "-h",
                                "--help",
                            ],
                            description: Some("Display help for command"),
                            presentation: (
                                priority: Some(49.0),
                            ),
                        ),
                    ],
                    arguments: [
                        (
                            name: "files",
                            variadic: true,
                        ),
                    ],
                ),
                (
                    name: "help",
                    description: Some("Display help for command"),
                    arguments: [
                        (
                            name: "command",
                            template: [
                                Help,
                            ],
                            optional: true,
                        ),
                    ],
                    presentation: (
                        priority: Some(49.0),
                    ),
                ),
            ],
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Display help for command"),
                    presentation: (
                        priority: Some(49.0),
                    ),
                ),
            ],
        ),
        (
            name: "help",
            description: Some("Display help for command"),
            arguments: [
                (
                    name: "command",
                    template: [
                        Help,
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                priority: Some(49.0),
            ),
        ),
    ],
    options: [
        (
            names: [
                "-V",
                "--version",
            ],
            description: Some("Output the version number"),
        ),
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Display help for command"),
            presentation: (
                priority: Some(49.0),
            ),
        ),
    ],
    presentation: (
        icon: Some("https://fig.io/icons/fig-light.png"),
    ),
)
