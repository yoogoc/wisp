(
    version: 1,
    command: "vale",
    description: Some("A syntax-aware linter for prose built with speed and extensibility in mind"),
    subcommands: [
        (
            name: "ls-config",
            description: Some("Print the current configuration to stdout"),
        ),
        (
            name: "ls-metrics",
            description: Some("Print the given file's internal metrics to stdout"),
            arguments: [
                (
                    name: "file",
                    description: Some("The path to a file you want to analyze"),
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for vale"),
        ),
        (
            names: [
                "--version",
                "-v",
            ],
            description: Some("Print the current version"),
        ),
        (
            names: [
                "--ignore-syntax",
            ],
            description: Some("Lint all files line-by-line"),
        ),
        (
            names: [
                "--no-exit",
            ],
            description: Some("Don't return a nonzero exit code on errors"),
        ),
        (
            names: [
                "--no-wrap",
            ],
            description: Some("Don't wrap CLI output"),
        ),
        (
            names: [
                "--ext",
            ],
            description: Some("An extension to associate with stdin"),
            arguments: [
                (
                    name: "ext",
                    suggestions: [
                        (
                            name: ".md",
                        ),
                        (
                            name: ".rst",
                        ),
                        (
                            name: ".adoc",
                        ),
                        (
                            name: ".html",
                        ),
                    ],
                ),
            ],
            requires_separator: Some("="),
            presentation: (
                display_name: Some("--ext=<ext>"),
            ),
        ),
        (
            names: [
                "--glob",
            ],
            description: Some("A glob pattern"),
            arguments: [
                (
                    name: "glob",
                ),
            ],
            requires_separator: Some("="),
            presentation: (
                display_name: Some("--glob=<glob>"),
            ),
        ),
        (
            names: [
                "--minAlertLevel",
            ],
            description: Some("The minimum level to display"),
            arguments: [
                (
                    name: "level",
                    suggestions: [
                        (
                            name: "suggestion",
                        ),
                        (
                            name: "warning",
                        ),
                        (
                            name: "error",
                        ),
                    ],
                ),
            ],
            requires_separator: Some("="),
            presentation: (
                display_name: Some("--minAlertLevel=<level>"),
            ),
        ),
        (
            names: [
                "--output",
            ],
            description: Some("The alert output style to use"),
            arguments: [
                (
                    name: "style",
                    suggestions: [
                        (
                            name: "line",
                        ),
                        (
                            name: "JSON",
                        ),
                    ],
                ),
            ],
            requires_separator: Some("="),
            presentation: (
                display_name: Some("--output=<style>"),
            ),
        ),
        (
            names: [
                "--config",
            ],
            description: Some("A path to a .vale.ini file"),
            arguments: [
                (
                    name: "path",
                ),
            ],
            requires_separator: Some("="),
            presentation: (
                display_name: Some("--config=<path>"),
            ),
        ),
    ],
    arguments: [
        (
            name: "",
            template: [
                FilePaths,
                Folders,
            ],
            variadic: true,
        ),
    ],
)
