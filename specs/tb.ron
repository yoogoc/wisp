(
    version: 1,
    command: "tb",
    description: Some("Tinybird CLI"),
    subcommands: [
        (
            name: "check",
            description: Some("Check file syntax"),
            options: [
                (
                    names: [
                        "--debug",
                    ],
                    description: Some("Print internal representation"),
                ),
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show this message and exit"),
                ),
            ],
            arguments: [
                (
                    name: "path",
                    template: [
                        Folders,
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "dependencies",
            description: Some("Print all data sources dependencies"),
            options: [
                (
                    names: [
                        "--no-deps",
                    ],
                    description: Some("Print only data sources with no pipes using them"),
                ),
                (
                    names: [
                        "--match",
                    ],
                    description: Some("Retrieve any resource matching the pattern"),
                    arguments: [
                        (
                            name: "text",
                        ),
                    ],
                ),
                (
                    names: [
                        "--pipe",
                    ],
                    description: Some("Retrieve any resource used by pipe"),
                    arguments: [
                        (
                            name: "text",
                        ),
                    ],
                ),
                (
                    names: [
                        "--datasource",
                    ],
                    description: Some("Retrieve resources depending on this Data Source"),
                    arguments: [
                        (
                            name: "text",
                        ),
                    ],
                ),
                (
                    names: [
                        "--check-for-partial-replace",
                    ],
                    description: Some("Retrieve dependant Data Sources that will have their data replaced if a partial replace is executed in the Data Source selected"),
                ),
                (
                    names: [
                        "--recursive",
                    ],
                    description: Some("Calculate recursive dependencies"),
                ),
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show this message and exit"),
                ),
            ],
        ),
        (
            name: "diff",
            description: Some("Diffs local datafiles to the corresponding remote files in the workspace"),
            options: [
                (
                    names: [
                        "--fmt",
                    ],
                    description: Some("Format files before doing the diff, default is True so both files match the format"),
                    exclusive_on: [
                        "--no-fmt",
                    ],
                ),
                (
                    names: [
                        "--no-fmt",
                    ],
                    description: Some("Format files before doing the diff, default is True so both files match the format"),
                    exclusive_on: [
                        "--fmt",
                    ],
                ),
                (
                    names: [
                        "--no-color",
                    ],
                    description: Some("Don't colorize diff"),
                ),
                (
                    names: [
                        "--main",
                    ],
                    description: Some("Diffs local datafiles to the corresponding remote files in the main workspace. Only works when authenticated on a branch"),
                ),
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show this message and exit"),
                ),
            ],
            arguments: [
                (
                    name: "path",
                    template: [
                        Folders,
                        FilePaths,
                    ],
                    variadic: true,
                ),
            ],
        ),
        (
            name: "drop-prefix",
            description: Some("Drop all the resources inside a project with prefix. This command is dangerous because it removes everything, use with care"),
            options: [
                (
                    names: [
                        "--yes",
                    ],
                    description: Some("Do not ask for confirmation"),
                ),
                (
                    names: [
                        "--dry-run",
                    ],
                    description: Some("Run the command without removing anything"),
                ),
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show this message and exit"),
                ),
            ],
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            name: "fmt",
            description: Some("Formats a .datasource, .pipe or .incl file\n\nThis command removes comments starting with # from the file, use DESCRIPTION instead.\n\nThe format command tries to parse the datafile so syntax errors might rise.\n\n.incl files must contain a NODE definition"),
            options: [
                (
                    names: [
                        "--line-length",
                    ],
                    description: Some("A number indicating the maximum characters per line in the node SQL, lines will be splitted based on the SQL syntax and the number of characters passed as a parameter"),
                    arguments: [
                        (
                            name: "integer",
                        ),
                    ],
                ),
                (
                    names: [
                        "--dry-run",
                    ],
                    description: Some("Don't ask to override the local file"),
                ),
                (
                    names: [
                        "--yes",
                    ],
                    description: Some("Do not ask for confirmation to overwrite the local file"),
                ),
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show this message and exit"),
                ),
            ],
            arguments: [
                (
                    name: "path",
                    template: [
                        Folders,
                        FilePaths,
                    ],
                    variadic: true,
                ),
            ],
        ),
        (
            name: "init",
            description: Some("Initialize folder layout"),
            options: [
                (
                    names: [
                        "--generate-datasources",
                    ],
                    description: Some("Generate datasources based on CSV, NDJSON and Parquet files in this folder"),
                ),
                (
                    names: [
                        "--folder",
                    ],
                    description: Some("Folder where files will be placed"),
                    arguments: [
                        (
                            name: "directory",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--force",
                    ],
                    description: Some("Overrides existing files"),
                ),
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show this message and exit"),
                ),
            ],
        ),
        (
            name: "materialize",
            description: Some("[BETA] Given a local Pipe datafile path (FILENAME) and optionally a Materialized View name (TARGET_DATASOURCE), choose one of its nodes to materialize.\n\nThis command guides you to generate the Materialized View with name TARGET_DATASOURCE, the only requirement is having a valid Pipe datafile locally. Use `tb pull` to download resources from your workspace when needed.\n\nSyntax: tb materialize path/to/pipe.pipe"),
            options: [
                (
                    names: [
                        "--prefix",
                    ],
                    description: Some("Use prefix for all the resources"),
                    arguments: [
                        (
                            name: "text",
                        ),
                    ],
                ),
                (
                    names: [
                        "--push-deps",
                    ],
                    description: Some("Push dependencies, disabled by default"),
                ),
                (
                    names: [
                        "--workspace_map",
                    ],
                    arguments: [
                        (
                            name: "text",
                        ),
                        (
                            name: "text",
                        ),
                    ],
                    repeat: Many,
                ),
                (
                    names: [
                        "--workspace",
                    ],
                    description: Some("Add a workspace path to the list of external workspaces, usage: --workspace name path/to/folder"),
                    arguments: [
                        (
                            name: "text",
                        ),
                        (
                            name: "text",
                        ),
                    ],
                    repeat: Many,
                ),
                (
                    names: [
                        "--no-versions",
                    ],
                    description: Some("When set, resource dependency versions are not used, it pushes the dependencies as-is"),
                ),
                (
                    names: [
                        "--verbose",
                    ],
                    description: Some("Prints more log"),
                ),
                (
                    names: [
                        "--force-populate",
                    ],
                    description: Some("Subset or full"),
                    arguments: [
                        (
                            name: "text",
                        ),
                    ],
                ),
                (
                    names: [
                        "--unlink-on-populate-error",
                    ],
                    description: Some("If the populate job fails the Materialized View is unlinked and new data won't be ingested in the Materialized View. First time a populate job fails, the Materialized View is always unlinked"),
                ),
                (
                    names: [
                        "--override-pipe",
                    ],
                    description: Some("Override pipe if exists or prompt"),
                ),
                (
                    names: [
                        "--override-datasource",
                    ],
                    description: Some("Override data source if exists or prompt"),
                ),
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show this message and exit"),
                ),
            ],
            arguments: [
                (
                    name: "path",
                    template: [
                        Folders,
                        FilePaths,
                    ],
                ),
                (
                    name: "text",
                ),
            ],
        ),
        (
            name: "prompt",
            description: Some("Learn how to include info about the CLI in your shell PROMPT"),
            options: [
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show this message and exit"),
                ),
            ],
        ),
        (
            name: "pull",
            description: Some("Retrieve latest versions for project files from Tinybird"),
            options: [
                (
                    names: [
                        "--folder",
                    ],
                    description: Some("Folder where files will be placed"),
                    arguments: [
                        (
                            name: "directory",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--auto",
                    ],
                    description: Some("Saves datafiles automatically into their default directories (/datasources or /pipes)"),
                ),
                (
                    names: [
                        "--match",
                    ],
                    description: Some("Retrieve any resourcing matching the pattern. eg --match _test"),
                    arguments: [
                        (
                            name: "text",
                        ),
                    ],
                ),
                (
                    names: [
                        "--prefix",
                    ],
                    description: Some("Download only resources with this prefix"),
                    arguments: [
                        (
                            name: "text",
                        ),
                    ],
                ),
                (
                    names: [
                        "--force",
                    ],
                    description: Some("Override existing files"),
                ),
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show this message and exit"),
                ),
            ],
        ),
        (
            name: "push",
            description: Some("Push files to Tinybird\n"),
            options: [
                (
                    names: [
                        "--prefix",
                    ],
                    description: Some("Use prefix for all the resources"),
                    arguments: [
                        (
                            name: "text",
                        ),
                    ],
                ),
                (
                    names: [
                        "--dry-run",
                    ],
                    description: Some("Run the command without creating resources on the Tinybird account or any side effect"),
                ),
                (
                    names: [
                        "--check",
                    ],
                    description: Some("Enable/Disable output checking, enabled by default"),
                    exclusive_on: [
                        "--no-check",
                    ],
                ),
                (
                    names: [
                        "--no-check",
                    ],
                    description: Some("Enable/Disable output checking, enabled by default"),
                    exclusive_on: [
                        "--check",
                    ],
                ),
                (
                    names: [
                        "--push-deps",
                    ],
                    description: Some("Push dependencies, disabled by default"),
                ),
                (
                    names: [
                        "--debug",
                    ],
                    description: Some("Prints internal representation, can be combined with any command to get more information"),
                ),
                (
                    names: [
                        "-f",
                        "--force",
                    ],
                    description: Some("Override pipes when they already exist"),
                ),
                (
                    names: [
                        "--override-datasource",
                    ],
                    description: Some("When pushing a pipe with a Materialized node if the target Data Source exists it will try to override it"),
                ),
                (
                    names: [
                        "--populate",
                    ],
                    description: Some("Populate materialized nodes when pushing them"),
                ),
                (
                    names: [
                        "--subset",
                    ],
                    description: Some("Populate with a subset percent of the data (limited to a maximum of 2M rows), this is useful to quickly test a materialized node with some data. The subset must be greater than 0 and lower than 0.1. A subset of 0.1 means a 10 percent of the data in the source Data Source will be used to populate the materialized view. Use it together with --populate, it has precedence over --sql-condition"),
                    arguments: [
                        (
                            name: "float",
                        ),
                    ],
                ),
                (
                    names: [
                        "--sql-condition",
                    ],
                    description: Some("Populate with a SQL condition to be applied to the trigger Data Source of the Materialized View. For instance, `--sql-condition='date == toYYYYMM(now())'` it'll populate taking all the rows from the trigger Data Source which `date` is the current month. Use it together with --populate. --sql-condition is not taken into account if the --subset param is present. Including in the ``sql_condition`` any column present in the Data Source ``engine_sorting_key`` will make the populate job process less data"),
                    arguments: [
                        (
                            name: "text",
                        ),
                    ],
                ),
                (
                    names: [
                        "--unlink-on-populate-error",
                    ],
                    description: Some("If the populate job fails the Materialized View is unlinked and new data won't be ingested in the Materialized View. First time a populate job fails, the Materialized View is always unlinked"),
                ),
                (
                    names: [
                        "--fixtures",
                    ],
                    description: Some("Append fixtures to data sources"),
                ),
                (
                    names: [
                        "--wait",
                    ],
                    description: Some("To be used along with --populate command. Waits for populate jobs to finish, showing a progress bar. Disabled by default"),
                ),
                (
                    names: [
                        "--yes",
                    ],
                    description: Some("Do not ask for confirmation"),
                ),
                (
                    names: [
                        "--only-response-times",
                    ],
                    description: Some("Checks only response times, when --force push a pipe"),
                ),
                (
                    names: [
                        "--workspace_map",
                    ],
                    arguments: [
                        (
                            name: "text",
                        ),
                        (
                            name: "text",
                        ),
                    ],
                    repeat: Many,
                ),
                (
                    names: [
                        "--workspace",
                    ],
                    description: Some("Add a workspace path to the list of external workspaces, usage: --workspace name path/to/folder"),
                    arguments: [
                        (
                            name: "text",
                        ),
                        (
                            name: "text",
                        ),
                    ],
                    repeat: Many,
                ),
                (
                    names: [
                        "--no-versions",
                    ],
                    description: Some("When set, resource dependency versions are not used, it pushes the dependencies as-is"),
                ),
                (
                    names: [
                        "--timeout",
                    ],
                    description: Some("Timeout you want to use for the job populate"),
                    arguments: [
                        (
                            name: "float",
                        ),
                    ],
                ),
                (
                    names: [
                        "-l",
                        "--limit",
                    ],
                    description: Some("Number of requests to validate"),
                    arguments: [
                        (
                            name: "integer range",
                        ),
                    ],
                ),
                (
                    names: [
                        "--sample-by-params",
                    ],
                    description: Some("When set, we will aggregate the pipe_stats_rt requests by extractURLParameterNames(assumeNotNull(url)) and for each combination we will take a sample of N requests"),
                    arguments: [
                        (
                            name: "integer range",
                        ),
                    ],
                ),
                (
                    names: [
                        "-ff",
                        "--failfast",
                    ],
                    description: Some("When set, the checker will exit as soon one test fails"),
                ),
                (
                    names: [
                        "--ignore-order",
                    ],
                    description: Some("When set, the checker will ignore the order of list properties"),
                ),
                (
                    names: [
                        "--validate-processed-bytes",
                    ],
                    description: Some("When set, the checker will validate that the new version doesn't process more than 25% than the current version"),
                ),
                (
                    names: [
                        "--last-requests-from-main",
                    ],
                    description: Some("When set, the checker will get top requests requests from main"),
                ),
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show this message and exit"),
                ),
            ],
            arguments: [
                (
                    name: "path",
                    template: [
                        Folders,
                        FilePaths,
                    ],
                    variadic: true,
                ),
            ],
        ),
        (
            name: "sql",
            description: Some("Run SQL query over data sources and pipes"),
            options: [
                (
                    names: [
                        "--rows_limit",
                    ],
                    description: Some("Max number of rows retrieved"),
                    arguments: [
                        (
                            name: "integer",
                        ),
                    ],
                ),
                (
                    names: [
                        "--pipeline",
                    ],
                    description: Some("The name of the Pipe to run the SQL Query"),
                    arguments: [
                        (
                            name: "text",
                        ),
                    ],
                ),
                (
                    names: [
                        "--pipe",
                    ],
                    description: Some("The path to the .pipe file to run the SQL Query of a specific NODE"),
                    arguments: [
                        (
                            name: "text",
                        ),
                    ],
                ),
                (
                    names: [
                        "--node",
                    ],
                    description: Some("The NODE name"),
                    arguments: [
                        (
                            name: "text",
                        ),
                    ],
                ),
                (
                    names: [
                        "--format",
                    ],
                    description: Some("Output format"),
                    arguments: [
                        (
                            name: "choice",
                            suggestions: [
                                (
                                    name: "json",
                                ),
                                (
                                    name: "csv",
                                ),
                                (
                                    name: "human",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--stats",
                    ],
                    description: Some("Show query stats"),
                    exclusive_on: [
                        "--no-stats",
                    ],
                ),
                (
                    names: [
                        "--no-stats",
                    ],
                    description: Some("Show query stats"),
                    exclusive_on: [
                        "--stats",
                    ],
                ),
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show this message and exit"),
                ),
            ],
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--debug",
            ],
            description: Some("Prints internal representation, can be combined with any command to get more information"),
            exclusive_on: [
                "--no-debug",
            ],
        ),
        (
            names: [
                "--no-debug",
            ],
            description: Some("Prints internal representation, can be combined with any command to get more information"),
            exclusive_on: [
                "--debug",
            ],
        ),
        (
            names: [
                "--token",
            ],
            description: Some("Use auth token, defaults to TB_TOKEN envvar, then to the .tinyb file"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            names: [
                "--host",
            ],
            description: Some("Use custom host, defaults to TB_HOST envvar, then to https://api.tinybird.co"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            names: [
                "--gcp-project-id",
            ],
            description: Some("The Google Cloud project ID"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            names: [
                "--gcs-bucket",
            ],
            description: Some("The Google Cloud Storage bucket to write temp files when using the connectors"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            names: [
                "--google-application-credentials",
            ],
            description: Some("Set GOOGLE_APPLICATION_CREDENTIALS"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            names: [
                "--sf-account",
            ],
            description: Some("The Snowflake Account (e.g. your-domain.west-europe.azure)"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            names: [
                "--sf-warehouse",
            ],
            description: Some("The Snowflake warehouse name"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            names: [
                "--sf-database",
            ],
            description: Some("The Snowflake database name"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            names: [
                "--sf-schema",
            ],
            description: Some("The Snowflake schema name"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            names: [
                "--sf-role",
            ],
            description: Some("The Snowflake role name"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            names: [
                "--sf-user",
            ],
            description: Some("The Snowflake user name"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            names: [
                "--sf-password",
            ],
            description: Some("The Snowflake password"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            names: [
                "--sf-storage-integration",
            ],
            description: Some("The Snowflake GCS storage integration name (leave empty to auto-generate one)"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            names: [
                "--sf-stage",
            ],
            description: Some("The Snowflake GCS stage name (leave empty to auto-generate one)"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            names: [
                "--with-headers",
            ],
            description: Some("Flag to enable connector to export with headers"),
        ),
        (
            names: [
                "--version-warning",
            ],
            description: Some("Don't print version warning message if there's a new available version. You can use TB_VERSION_WARNING envar"),
            exclusive_on: [
                "--no-version-warning",
            ],
        ),
        (
            names: [
                "--no-version-warning",
            ],
            description: Some("Don't print version warning message if there's a new available version. You can use TB_VERSION_WARNING envar"),
            exclusive_on: [
                "--version-warning",
            ],
        ),
        (
            names: [
                "--hide-tokens",
            ],
            description: Some("Disable the output of tokens"),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Show the version and exit"),
        ),
        (
            names: [
                "--help",
            ],
            description: Some("Show this message and exit"),
        ),
    ],
)
