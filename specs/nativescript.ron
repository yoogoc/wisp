                        priority: Some(0.0),
                    ),
                ),
            ],
            presentation: (
                dangerous: true,
            ),
        ),
        (
            name: "usage-reporting",
            description: Some("Configures anonymous usage reporting for the NativeScript CLI. All data gathered is used strictly for improving the product and will never be used to identify or contact you"),
            subcommands: [
                (
                    name: "status",
                    description: Some("Shows the current configuration for anonymous usage reporting for the NativeScript CLI"),
                ),
                (
                    name: "enable",
                    description: Some("Enables anonymous usage reporting"),
                ),
                (
                    name: "disable",
                    description: Some("Disables anonymous usage reporting"),
                ),
            ],
            options: [
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Show help for the usage-reporting subcommand"),
                    presentation: (
                        priority: Some(0.0),
                    ),
                ),
            ],
            presentation: (
                priority: Some(1.0),
            ),
        ),
        (
            name: "error-reporting",
            description: Some("Configures anonymous error reporting for the NativeScript CLI. All data gathered is used strictly for improving the product and will never be used to identify or contact you"),
            subcommands: [
                (
                    name: "status",
                    description: Some("Shows the current configuration for anonymous error reporting for the NativeScript CLI"),
                ),
                (
                    name: "enable",
                    description: Some("Enables anonymous error reporting"),
