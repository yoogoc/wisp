                priority: Some(1.0),
            ),
        ),
        (
            name: "proxy",
            description: Some("Displays the current proxy settings of the NativeScript CLI"),
            subcommands: [
                (
                    name: "clear",
                    description: Some("Clears the currently configured proxy settings of the NativeScript CLI"),
                ),
                (
                    name: "set",
                    description: Some("Sets the proxy settings of the NativeScript CLI"),
                    options: [
                        (
                            names: [
                                "--insecure",
                            ],
                            description: Some("Allows insecure SSL connections and transfers to be performed. In case your proxy doesn't have a CA certificate or has an invalid one you need to use this flag"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "proxy url",
                            description: Some("Full url of the proxy. For example, http://127.0.0.1:8888. If you do not provide the url when running the command, the NativeScript CLI will prompt you to provide it"),
                        ),
                        (
                            name: "username",
                            description: Some("Credentials for the proxy"),
                            optional: true,
                        ),
                        (
                            name: "password",
                            description: Some("Credentials for the proxy"),
                            optional: true,
                        ),
                    ],
                ),
            ],
            options: [
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Show help for the proxy subcommand"),
                    presentation: (
                        priority: Some(0.0),
                    ),
                ),
            ],
        ),
        (
            name: "create",
            description: Some("Create a new Nativescript project. Press Enter for an interactive walkthrough"),
            options: [
                (
                    names: [
                        "--template",
                    ],
                    description: Some("Create a project using a predefined template"),
                    arguments: [
                        (
                            name: "template",
                            generators: [
                                (
                                    script: [
                                        "curl",
                                        "-sfL",
                                        "https://api.github.com/repos/NativeScript/nativescript-app-templates/contents/packages",
                                    ],
                                    has_post_process: true,
                                    cache: Some((
                                        ttl_ms: Some(8640000000),
                                        stale_while_revalidate: true,
                                    )),
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--angular",
                        "--ng",
                    ],
                    description: Some("Create a project using the Angular template"),
                ),
                (
                    names: [
                        "--react",
                    ],
                    description: Some("Create a project using the React template"),
                ),
                (
                    names: [
                        "--vue",
                        "--vuejs",
                    ],
                    description: Some("Create a project using the Vue template"),
                ),
                (
                    names: [
                        "--svelte",
                    ],
                    description: Some("Create a project using the Svelte template"),
                ),
                (
                    names: [
                        "--typescript",
                        "--tsc",
                        "--ts",
                    ],
                    description: Some("Create a project using plain TypeScript"),
                ),
                (
                    names: [
                        "--javascript",
                        "--js",
                    ],
                    description: Some("Create a project using plain JavaScript"),
                ),
                (
                    names: [
                        "--path",
                    ],
                    description: Some("Specifies the directory where you want to create the project, if different from the current directory. <directory> is the absolute path to an empty directory in which you want to create the project"),
                    arguments: [
                        (
                            name: "directory",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                    presentation: (
                        priority: Some(10.0),
                    ),
                ),
                (
                    names: [
                        "--appid",
                    ],
                    description: Some("Sets the application identifier of your project. <appid> is the value of the application identifier and it must meet the specific requirements of each platform that you want to target. If not specified, the application identifier is set to org.nativescript.<Project Name>. The application identifier must be a domain name in reverse"),
                    arguments: [
                        (
                            name: "identifier",
                        ),
                    ],
                ),
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Show help for the create subcommand"),
                    presentation: (
                        priority: Some(0.0),
                    ),
                ),
            ],
            arguments: [
                (
                    name: "application name",
                    description: Some("The name of the Nativescript project"),
                    optional: true,
                ),
            ],
        ),
