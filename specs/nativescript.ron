            subcommands: [
                (
                    name: "get",
                    description: Some("Prints the value of the current package manager"),
                ),
                (
                    name: "set",
                    description: Some("Enables the specified package manager for the NativeScript CLI. Supported values are npm, yarn and pnpm"),
                ),
            ],
            options: [
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Show help for the package-manager subcommand"),
                    presentation: (
                        priority: Some(0.0),
                    ),
                ),
            ],
        ),
        (
            name: "doctor",
            description: Some("Checks your system for configuration problems which might prevent the NativeScript CLI from working properly for the specified platform, if configured"),
            subcommands: [
                (
                    name: "android",
                    description: Some("Check your system configuration for android"),
                ),
                (
                    name: "ios",
                    description: Some("Check your system configuration for ios"),
                ),
            ],
            options: [
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Show help for the doctor subcommand"),
                    presentation: (
                        priority: Some(0.0),
                    ),
                ),
            ],
        ),
        (
            name: "migrate",
