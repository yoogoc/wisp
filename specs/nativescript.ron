                (
                    name: "next",
                    description: Some("The latest development release"),
                ),
            ],
            options: [
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Show help for the update subcommand"),
                    presentation: (
                        priority: Some(0.0),
                    ),
                ),
            ],
            arguments: [
                (
                    name: "version",
                    description: Some("The version to update the project to"),
                    optional: true,
                ),
            ],
            presentation: (
                dangerous: true,
            ),
        ),
        (
            name: "package-manager",
