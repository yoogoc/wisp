(
    version: 1,
    command: "supabase",
    description: Some("Supabase CLI"),
    subcommands: [
        (
            name: "completion",
            description: Some("Generate the autocompletion script for the specified shell"),
            subcommands: [
                (
                    name: "bash",
                    description: Some("Generate the autocompletion script for bash"),
                    options: [
                        (
                            names: [
                                "--no-descriptions",
                            ],
                            description: Some("Disable completion descriptions"),
                        ),
                    ],
                ),
                (
                    name: "fish",
                    description: Some("Generate the autocompletion script for fish"),
                    options: [
                        (
                            names: [
                                "--no-descriptions",
                            ],
                            description: Some("Disable completion descriptions"),
                        ),
                    ],
                ),
                (
                    name: "powershell",
                    description: Some("Generate the autocompletion script for powershell"),
                    options: [
                        (
                            names: [
                                "--no-descriptions",
                            ],
                            description: Some("Disable completion descriptions"),
                        ),
                    ],
                ),
                (
                    name: "zsh",
                    description: Some("Generate the autocompletion script for zsh"),
                    options: [
                        (
                            names: [
                                "--no-descriptions",
                            ],
                            description: Some("Disable completion descriptions"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "db",
            description: Some("Manage local Postgres databases"),
            subcommands: [
                (
                    name: "branch",
                    description: Some("Manage local database branches"),
                    subcommands: [
                        (
                            name: "create",
                            description: Some("Create a branch"),
                        ),
                        (
                            name: "delete",
                            description: Some("Delete a branch"),
                        ),
                        (
                            name: "list",
                            description: Some("List branches"),
                        ),
                        (
                            name: "switch",
                            description: Some("Switch the active branch"),
                        ),
                    ],
                ),
                (
                    name: "diff",
                    description: Some("Diffs the local database for schema changes"),
                    options: [
                        (
                            names: [
                                "--file",
                                "-f",
                            ],
                            description: Some("Saves schema diff to a file"),
                            arguments: [
                                (
                                    name: "file",
                                    template: [
                                        FilePaths,
                                    ],
                                    suggest_current_token: true,
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--schema",
                                "-s",
                            ],
                            description: Some("List of schema to include"),
                            arguments: [
                                (
                                    name: "schema",
                                    default: Some("[public]"),
                                ),
                            ],
                            repeat: Many,
                        ),
                        (
                            names: [
                                "--use-migra",
                            ],
                            description: Some("Use migra to generate schema diff"),
                        ),
                    ],
                ),
                (
                    name: "dump",
                    description: Some("Dumps data or schemas from the remote database"),
                    options: [
                        (
                            names: [
                                "--data-only",
                            ],
                            description: Some("Dumps only data records"),
                        ),
                        (
                            names: [
                                "--db-url",
                            ],
                            description: Some("Dumps from the database specified by the connection string (must be percent-encoded)"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--dry-run",
                            ],
                            description: Some("Prints the pg_dump script that would be executed"),
                        ),
                        (
                            names: [
                                "--file",
                                "-f",
                            ],
                            description: Some("File path to save the dumped contents"),
                            arguments: [
                                (
                                    name: "string",
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-h",
                                "--help",
                            ],
                            description: Some("Help for dump"),
                        ),
                        (
                            names: [
                                "--keep-comments",
                            ],
                            description: Some("Keeps commented lines from pg_dump output"),
                        ),
                        (
                            names: [
                                "--linked",
                            ],
                            description: Some("Dumps from the linked project. (default true)"),
                        ),
                        (
                            names: [
                                "--local",
                            ],
                            description: Some("Dumps from the local database"),
                        ),
                        (
                            names: [
                                "--password",
                                "-p",
                            ],
                            description: Some("Password to your remote Postgres database"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--role-only",
                            ],
                            description: Some("Dumps only cluster roles"),
                        ),
                        (
                            names: [
                                "--schema",
                                "-s",
                            ],
                            description: Some("Comma separated list of schema to include. (default all)"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--use-copy",
                            ],
                            description: Some("Uses copy statements in place of inserts"),
                        ),
                    ],
                ),
                (
                    name: "lint",
                    description: Some("Checks local database for typing error"),
                    options: [
                        (
                            names: [
                                "--level",
                            ],
                            description: Some("Error level to emit"),
                            arguments: [
                                (
                                    name: "level",
                                    default: Some("warning"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--schema",
                                "-s",
                            ],
                            description: Some("List of schema to include"),
                            arguments: [
                                (
                                    name: "schema",
                                    default: Some("[public]"),
                                ),
                            ],
                            repeat: Many,
                        ),
                    ],
                ),
                (
                    name: "pull",
                    description: Some("Pull schema from the remote database"),
                ),
                (
                    name: "push",
                    description: Some("Push new migrations to the remote database"),
                    options: [
                        (
                            names: [
                                "--dry-run",
                            ],
                            description: Some("Print the migrations that would be applied, but don't actually apply them"),
                        ),
                        (
                            names: [
                                "--password",
                                "-p",
                            ],
                            description: Some("Password to your remote Postgres database"),
                            arguments: [
                                (
                                    name: "password",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "remote",
                    description: Some("Manage remote databases"),
                    subcommands: [
                        (
                            name: "changes",
                            description: Some("Show changes on the remote database"),
                        ),
                        (
                            name: "commit",
                            description: Some("Commit remote changes as a new migration"),
                        ),
                    ],
                    options: [
                        (
                            names: [
                                "--password",
                                "-p",
                            ],
                            description: Some("Password to your remote Postgres database"),
                            arguments: [
                                (
                                    name: "password",
                                ),
                            ],
                            persistent: true,
                        ),
                    ],
                ),
                (
                    name: "reset",
                    description: Some("Resets the local database to current migrations"),
                ),
            ],
        ),
        (
            name: "functions",
            description: Some("Manage Supabase Edge functions"),
            subcommands: [
                (
                    name: "delete",
                    description: Some("Delete a Function from Supabase"),
                    options: [
                        (
                            names: [
                                "--project-ref",
                            ],
                            description: Some("Project ref of the Supabase project"),
                            arguments: [
                                (
                                    name: "project-ref",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "deploy",
                    description: Some("Deploy a Function to Supabase"),
                    options: [
                        (
                            names: [
                                "--no-verify-jwt",
                            ],
                            description: Some("Disable JWT verification for the Function"),
                        ),
                        (
                            names: [
                                "--project-ref",
                            ],
                            description: Some("Project ref of the Supabase project"),
                            arguments: [
                                (
                                    name: "project-ref",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "new",
                    description: Some("Create a new Function locally"),
                ),
                (
                    name: "serve",
                    description: Some("Serve a Function locally"),
                    options: [
                        (
                            names: [
                                "--env-file",
                            ],
                            description: Some("Path to an env file to be populated to the Function environment"),
                            arguments: [
                                (
                                    name: "env-file",
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--no-verify-jwt",
                            ],
                            description: Some("Disable JWT verification for the Function"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "gen",
            description: Some("Run code generation tools"),
            subcommands: [
                (
                    name: "types",
                    description: Some("Generate types from Postgres schema"),
                    subcommands: [
                        (
                            name: "typescript",
                            description: Some("Generate types for TypeScript"),
                            options: [
                                (
                                    names: [
                                        "--db-url",
                                    ],
                                    description: Some("Generate types from a database url"),
                                    arguments: [
                                        (
                                            name: "db-url",
                                        ),
                                    ],
                                ),
                                (
                                    names: [
                                        "--local",
                                    ],
                                    description: Some("Generate types from the local dev database"),
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "init",
            description: Some("Initialize a local project"),
        ),
        (
            name: "link",
            description: Some("Link to a Supabase project"),
            options: [
                (
                    names: [
                        "--password",
                        "-p",
                    ],
                    description: Some("Password to your remote Postgres database"),
                    arguments: [
                        (
                            name: "password",
                        ),
                    ],
                ),
                (
                    names: [
                        "--project-ref",
                    ],
                    description: Some("Project ref of the Supabase project"),
                    arguments: [
                        (
                            name: "project-ref",
                        ),
                    ],
                    required: true,
                ),
            ],
        ),
        (
            name: "login",
            description: Some("Authenticate using an access token"),
        ),
        (
            name: "migration",
            description: Some("Manage database migration scripts"),
            subcommands: [
                (
                    name: "list",
                    description: Some("List local and remote migrations"),
                    options: [
                        (
                            names: [
                                "--password",
                                "-p",
                            ],
                            description: Some("Password to your remote Postgres database"),
                            arguments: [
                                (
                                    name: "password",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--local",
                            ],
                            description: Some("Lists migrations applied to the local database"),
                        ),
                        (
                            names: [
                                "--linked",
                            ],
                            description: Some("Lists migrations applied to the linked project (default true)"),
                        ),
                        (
                            names: [
                                "--db-url",
                            ],
                            description: Some("Database URL to connect to"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "new",
                    description: Some("Create an empty migration script"),
                    arguments: [
                        (
                            name: "migration name",
                        ),
                    ],
                ),
                (
                    name: "repair",
                    description: Some("Repair the migration history table"),
                    options: [
                        (
                            names: [
                                "--status",
                            ],
                            description: Some("Version status to update"),
                            arguments: [
                                (
                                    name: "status",
                                    suggestions: [
                                        (
                                            name: "applied",
                                        ),
                                        (
                                            name: "reverted",
                                        ),
                                    ],
                                ),
                            ],
                            presentation: (
                                priority: Some(100.0),
                            ),
                        ),
                        (
                            names: [
                                "--password",
                                "-p",
                            ],
                            description: Some("Password to your remote Postgres database"),
                            arguments: [
                                (
                                    name: "password",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--local",
                            ],
                            description: Some("Repairs the migration history of the local database"),
                        ),
                        (
                            names: [
                                "--linked",
                            ],
                            description: Some("Repairs the migration history of the linked project (default true)"),
                        ),
                        (
                            names: [
                                "--db-url",
                            ],
                            description: Some("Database URL to connect to"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                        ),
                    ],
                    arguments: [
                        (
                            name: "version",
                        ),
                    ],
                ),
                (
                    name: "squash",
                    description: Some("Squash migrations to a single file"),
                    options: [
                        (
                            names: [
                                "--password",
                                "-p",
                            ],
                            description: Some("Password to your remote Postgres database"),
                            arguments: [
                                (
                                    name: "password",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--local",
                            ],
                            description: Some("Squashes the migration history of the local database"),
                        ),
                        (
                            names: [
                                "--version",
                            ],
                            description: Some("Squash up to the specified version"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--linked",
                            ],
                            description: Some("Squashes the migration history of the linked project (default true)"),
                        ),
                        (
                            names: [
                                "--db-url",
                            ],
                            description: Some("Database URL to connect to"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "up",
                    description: Some("Apply pending migrations to local database"),
                ),
            ],
        ),
        (
            name: "orgs",
            description: Some("Manage Supabase organizations"),
            subcommands: [
                (
                    name: "list",
                    description: Some("List all organizations"),
                ),
            ],
        ),
        (
            name: "projects",
            description: Some("Manage Supabase projects"),
            subcommands: [
                (
                    name: "create",
                    description: Some("Create a project on Supabase"),
                    options: [
                        (
                            names: [
                                "--db-password",
                            ],
                            description: Some("Database password of the project"),
                            arguments: [
                                (
                                    name: "db-password",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--interactive",
                                "-i",
                            ],
                            description: Some("Enables interactive mode"),
                        ),
                        (
                            names: [
                                "--org-id",
                            ],
                            description: Some("Organization ID to create the project in"),
                            arguments: [
                                (
                                    name: "org-id",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--plan",
                            ],
                            description: Some("Select a plan that suits your needs"),
                            arguments: [
                                (
                                    name: "plan",
                                    default: Some("free"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--region",
                            ],
                            description: Some("Select a region close to you for the best performance"),
                            arguments: [
                                (
                                    name: "region",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "list",
                    description: Some("List all Supabase projects"),
                ),
            ],
        ),
        (
            name: "secrets",
            description: Some("Manage Supabase secrets"),
            subcommands: [
                (
                    name: "list",
                    description: Some("List all secrets on Supabase"),
                ),
                (
                    name: "set",
                    description: Some("Set a secret(s) on Supabase"),
                    options: [
                        (
                            names: [
                                "--env-file",
                            ],
                            description: Some("Read secrets from a .env file"),
                            arguments: [
                                (
                                    name: "env-file",
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "unset",
                    description: Some("Unset a secret(s) on Supabase"),
                ),
            ],
        ),
        (
            name: "start",
            description: Some("Start containers for Supabase local development"),
        ),
        (
            name: "status",
            description: Some("Show status of local Supabase containers"),
        ),
        (
            name: "stop",
            description: Some("Stop all local Supabase containers"),
        ),
        (
            name: "help",
            description: Some("Help about any command"),
            subcommands: [
                (
                    name: "completion",
                    description: Some("Generate the autocompletion script for the specified shell"),
                    subcommands: [
                        (
                            name: "bash",
                            description: Some("Generate the autocompletion script for bash"),
                        ),
                        (
                            name: "fish",
                            description: Some("Generate the autocompletion script for fish"),
                        ),
                        (
                            name: "powershell",
                            description: Some("Generate the autocompletion script for powershell"),
                        ),
                        (
                            name: "zsh",
                            description: Some("Generate the autocompletion script for zsh"),
                        ),
                    ],
                ),
                (
                    name: "db",
                    description: Some("Manage local Postgres databases"),
                    subcommands: [
                        (
                            name: "branch",
                            description: Some("Manage local database branches"),
                            subcommands: [
                                (
                                    name: "create",
                                    description: Some("Create a branch"),
                                ),
                                (
                                    name: "delete",
                                    description: Some("Delete a branch"),
                                ),
                                (
                                    name: "list",
                                    description: Some("List branches"),
                                ),
                                (
                                    name: "switch",
                                    description: Some("Switch the active branch"),
                                ),
                            ],
                        ),
                        (
                            name: "diff",
                            description: Some("Diffs the local database for schema changes"),
                        ),
                        (
                            name: "lint",
                            description: Some("Checks local database for typing error"),
                        ),
                        (
                            name: "push",
                            description: Some("Push new migrations to the remote database"),
                        ),
                        (
                            name: "remote",
                            description: Some("Manage remote databases"),
                            subcommands: [
                                (
                                    name: "changes",
                                    description: Some("Show changes on the remote database"),
                                ),
                                (
                                    name: "commit",
                                    description: Some("Commit remote changes as a new migration"),
                                ),
                            ],
                        ),
                        (
                            name: "reset",
                            description: Some("Resets the local database to current migrations"),
                        ),
                    ],
                ),
                (
                    name: "functions",
                    description: Some("Manage Supabase Edge functions"),
                    subcommands: [
                        (
                            name: "delete",
                            description: Some("Delete a Function from Supabase"),
                        ),
                        (
                            name: "deploy",
                            description: Some("Deploy a Function to Supabase"),
                        ),
                        (
                            name: "new",
                            description: Some("Create a new Function locally"),
                        ),
                        (
                            name: "serve",
                            description: Some("Serve a Function locally"),
                        ),
                    ],
                ),
                (
                    name: "gen",
                    description: Some("Run code generation tools"),
                    subcommands: [
                        (
                            name: "types",
                            description: Some("Generate types from Postgres schema"),
                            subcommands: [
                                (
                                    name: "typescript",
                                    description: Some("Generate types for TypeScript"),
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "init",
                    description: Some("Initialize a local project"),
                ),
                (
                    name: "link",
                    description: Some("Link to a Supabase project"),
                ),
                (
                    name: "login",
                    description: Some("Authenticate using an access token"),
                ),
                (
                    name: "migration",
                    description: Some("Manage database migration scripts"),
                    subcommands: [
                        (
                            name: "list",
                            description: Some("List local and remote migrations"),
                        ),
                        (
                            name: "new",
                            description: Some("Create an empty migration script"),
                        ),
                    ],
                ),
                (
                    name: "orgs",
                    description: Some("Manage Supabase organizations"),
                    subcommands: [
                        (
                            name: "list",
                            description: Some("List all organizations"),
                        ),
                    ],
                ),
                (
                    name: "projects",
                    description: Some("Manage Supabase projects"),
                    subcommands: [
                        (
                            name: "create",
                            description: Some("Create a project on Supabase"),
                        ),
                        (
                            name: "list",
                            description: Some("List all Supabase projects"),
                        ),
                    ],
                ),
                (
                    name: "secrets",
                    description: Some("Manage Supabase secrets"),
                    subcommands: [
                        (
                            name: "list",
                            description: Some("List all secrets on Supabase"),
                        ),
                        (
                            name: "set",
                            description: Some("Set a secret(s) on Supabase"),
                        ),
                        (
                            name: "unset",
                            description: Some("Unset a secret(s) on Supabase"),
                        ),
                    ],
                ),
                (
                    name: "start",
                    description: Some("Start containers for Supabase local development"),
                ),
                (
                    name: "status",
                    description: Some("Show status of local Supabase containers"),
                ),
                (
                    name: "stop",
                    description: Some("Stop all local Supabase containers"),
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--debug",
            ],
            description: Some("Output debug logs to stderr"),
            persistent: true,
        ),
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Display help"),
            persistent: true,
        ),
    ],
)
