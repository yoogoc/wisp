(
    version: 1,
    command: "scc",
    description: Some("Sloc, Cloc and Code. Count lines of code in a directory with complexity estimation"),
    options: [
        (
            names: [
                "--avg-wage",
            ],
            description: Some("Average salary value used for COCOMO calculations"),
            arguments: [
                (
                    name: "int",
                    default: Some("56286"),
                ),
            ],
        ),
        (
            names: [
                "--binary",
            ],
            description: Some("Disable binary file detection"),
        ),
        (
            names: [
                "--by-file",
            ],
            description: Some("Display output for every file"),
        ),
        (
            names: [
                "--ci",
            ],
            description: Some("Enable CI output settings where stdout is ASCII"),
        ),
        (
            names: [
                "--cocomo-project-type",
            ],
            description: Some("Change the COCOMO model type (allows custom models, eg. \"name,1,1,1,1\")"),
            arguments: [
                (
                    name: "string",
                    suggestions: [
                        (
                            name: "organic",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "semi-detached",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "embedded",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                    ],
                    default: Some("organic"),
                ),
            ],
        ),
        (
            names: [
                "--count-as",
            ],
            description: Some("Count a file extension as a language (comma-separated key:value list, eg. jst:js,tpl:Markdown)"),
            arguments: [
                (
                    name: "string",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--debug",
            ],
            description: Some("Enable debug output"),
        ),
        (
            names: [
                "--exclude-dir",
            ],
            description: Some("Directories to exclude"),
            arguments: [
                (
                    name: "strings",
                    generators: [
                        (
                            template: [
                                Folders,
                            ],
                            query_term: Some(AfterLast(",")),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--file-gc-count",
            ],
            description: Some("Number of files to parse before turning the GC on"),
            arguments: [
                (
                    name: "int",
                    default: Some("10000"),
                ),
            ],
        ),
        (
            names: [
                "-f",
                "--format",
            ],
            description: Some("Set output format"),
            arguments: [
                (
                    name: "string",
                    suggestions: [
                        (
                            name: "tabular",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "wide",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "json",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "csv",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "csv-stream",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "cloc-yaml",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "html",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "html-table",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "sql",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "sql-insert",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                    ],
                    default: Some("tabular"),
                ),
            ],
        ),
        (
            names: [
                "--format-multi",
            ],
            description: Some("Multiple outputs with different formats (comma-separated key:value list, eg. tabular:stdout,csv:scc.csv)"),
            arguments: [
                (
                    name: "string",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--gen",
            ],
            description: Some("Identify generated files"),
        ),
        (
            names: [
                "--generated-markers",
            ],
            description: Some("Identify generated files by the presence of a string (comma-separated list)"),
            arguments: [
                (
                    name: "strings",
                    default: Some("do not edit,<auto-generated />"),
                ),
            ],
            presentation: (
                insert_value: Some("--generated-markers '{cursor}'"),
            ),
        ),
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Help for scc"),
        ),
        (
            names: [
                "-i",
                "--include-ext",
            ],
            description: Some("Limit to these file extensions (comma-separated list)"),
            arguments: [
                (
                    name: "strings",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--include-symlinks",
            ],
            description: Some("Count symbolic links"),
        ),
        (
            names: [
                "-l",
                "--languages",
            ],
            description: Some("Print supported languages and extensions"),
        ),
        (
            names: [
                "--large-byte-count",
            ],
            description: Some("Number of bytes a file can contain before being omitted"),
            arguments: [
                (
                    name: "int",
                    default: Some("1000000"),
                ),
            ],
        ),
        (
            names: [
                "--large-line-count",
            ],
            description: Some("Number of lines a file can contain before being omitted"),
            arguments: [
                (
                    name: "int",
                    default: Some("40000"),
                ),
            ],
        ),
        (
            names: [
                "--min",
            ],
            description: Some("Identify minified files"),
        ),
        (
            names: [
                "-z",
                "--min-gen",
            ],
            description: Some("Identify minified or generated files"),
        ),
        (
            names: [
                "--min-gen-line-length",
            ],
            description: Some("Number of bytes per average line for file to be considered minified or generated"),
            arguments: [
                (
                    name: "int",
                    default: Some("255"),
                ),
            ],
        ),
        (
            names: [
                "--no-cocomo",
            ],
            description: Some("Skip COCOMO calculation"),
        ),
        (
            names: [
                "-c",
                "--no-complexity",
            ],
            description: Some("Skip code complexity calculation"),
        ),
        (
            names: [
                "-d",
                "--no-duplicates",
            ],
            description: Some("Remove duplicate files from stats and output"),
        ),
        (
            names: [
                "--no-gen",
            ],
            description: Some("Ignore generated files in output (implies --gen)"),
        ),
        (
            names: [
                "--no-gitignore",
            ],
            description: Some("Disables .gitignore file logic"),
        ),
        (
            names: [
                "--no-ignore",
            ],
            description: Some("Disables .ignore file logic"),
        ),
        (
            names: [
                "--no-large",
            ],
            description: Some("Ignore files over certain byte and line size set by --max-line-count and --max-byte-count"),
        ),
        (
            names: [
                "--no-min",
            ],
            description: Some("Ignore minified files in output (implies --min)"),
        ),
        (
            names: [
                "--no-min-gen",
            ],
            description: Some("Ignore minified or generated files in output (implies --min-gen)"),
        ),
        (
            names: [
                "--no-size",
            ],
            description: Some("Remove size calculation output"),
        ),
        (
            names: [
                "-M",
                "--not-match",
            ],
            description: Some("Ignore files and directories matching regular expression"),
            arguments: [
                (
                    name: "regex",
                ),
            ],
            presentation: (
                insert_value: Some("-M '{cursor}'"),
            ),
        ),
        (
            names: [
                "-o",
                "--output",
            ],
            description: Some("Output filename (defaults to stdout if not provided)"),
            arguments: [
                (
                    name: "string",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--remap-all",
            ],
            description: Some("Inspect every file and set its type by checking for a string (comma-separated key:value list, eg. \"-*- C++ -*-\":\"C Header\")"),
            arguments: [
                (
                    name: "string",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--remap-unknown",
            ],
            description: Some("Inspect files of unknown type and set its type by checking for a string (comma-separated key:value list, eg. \"-*- C++ -*-\":\"C Header\")"),
            arguments: [
                (
                    name: "string",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--size-unit",
            ],
            description: Some("Set the unit used for file size output"),
            arguments: [
                (
                    name: "string",
                    description: Some("See https://xkcd.com/394/"),
                    suggestions: [
                        (
                            name: "si",
                            description: Some("1000^2 bytes"),
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "binary",
                            description: Some("1024^2 bytes"),
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "mixed",
                            description: Some("1,024,000 bytes (Binary kilobytes, SI megabytes)"),
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "xkcd-kb",
                            description: Some("1000 bytes during leap years, 1024 otherwise"),
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "xkcd-kelly",
                            description: Some("1012 bytes (a compromise between 1000 and 1024 bytes)"),
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "xkcd-imaginary",
                            description: Some("1024*sqrt(-1) bytes (used in quantum computing)"),
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "xkcd-intel",
                            description: Some("1023.937528 bytes (calculated on Pentium FPU)"),
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "xkcd-drive",
                            description: Some("Currently 856 bytes (shrinks by 4 each year for marketing reasons)"),
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "xkcd-bakers",
                            description: Some("1152 bytes (9 bits per byte, because you're such a good customer)"),
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                    ],
                    default: Some("si"),
                ),
            ],
        ),
        (
            names: [
                "-s",
                "--sort",
            ],
            description: Some("Column to sort by"),
            arguments: [
                (
                    name: "string",
                    suggestions: [
                        (
                            name: "files",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "name",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "lines",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "blanks",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "code",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "comments",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "complexity",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                    ],
                    default: Some("files"),
                ),
            ],
        ),
        (
            names: [
                "--sql-project",
            ],
            description: Some("Use supplied name as the project identifier for the current run. Only valid with the '--format sql' or '--format sql-insert' option"),
            arguments: [
                (
                    name: "string",
                ),
            ],
        ),
        (
            names: [
                "-t",
                "--trace",
            ],
            description: Some("Enable trace output (not recommended when processing multiple files)"),
        ),
        (
            names: [
                "-v",
                "--verbose",
            ],
            description: Some("Verbose output"),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Version for scc"),
        ),
        (
            names: [
                "-w",
                "--wide",
            ],
            description: Some("Wider output with additional statistics (implies --complexity)"),
        ),
    ],
    arguments: [
        (
            name: "files or directories",
            template: [
                FilePaths,
                Folders,
            ],
            optional: true,
            variadic: true,
        ),
    ],
)
