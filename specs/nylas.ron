                (
                    name: "access_token",
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--config_dir",
            ],
            description: Some("Config directory"),
            arguments: [
                (
                    name: "config_dir",
                    template: [
                        Folders,
                    ],
                    default: Some("~/.nylas"),
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--config_file",
            ],
            description: Some("Config file (default is config.yaml)"),
            arguments: [
                (
                    name: "config_file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
            persistent: true,
        ),
