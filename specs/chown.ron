(
    version: 1,
    command: "chown",
    description: Some("Change the user and/or group ownership of a given file, directory, or symbolic link"),
    options: [
        (
            names: [
                "-f",
            ],
            description: Some("Don't report any failure to change file owner or group, nor modify the exit status to reflect such failures"),
        ),
        (
            names: [
                "-h",
            ],
            description: Some("If the file is a symbolic link, change the user ID and/or the group ID of the link itself"),
        ),
        (
            names: [
                "-n",
            ],
            description: Some("Interpret user ID and group ID as numeric, avoiding name lookups"),
        ),
        (
            names: [
                "-v",
            ],
            description: Some("Cause chown to be verbose, showing files as the owner is modified"),
        ),
        (
            names: [
                "-R",
            ],
            description: Some("Change the user ID and/or the group ID for the file hierarchies rooted in the files instead of just the files themselves"),
        ),
        (
            names: [
                "-H",
            ],
            description: Some("If the -R option is specified, symbolic links on the command line are followed"),
            exclusive_on: [
                "-L",
                "-P",
            ],
            depends_on: [
                "-R",
            ],
        ),
        (
            names: [
                "-L",
            ],
            description: Some("If the -R option is specified, all symbolic links are followed"),
            exclusive_on: [
                "-H",
                "-P",
            ],
            depends_on: [
                "-R",
            ],
        ),
        (
            names: [
                "-P",
            ],
            description: Some("If the -R option is specified, no symbolic links are followed"),
            exclusive_on: [
                "-H",
                "-L",
            ],
            depends_on: [
                "-R",
            ],
        ),
    ],
    arguments: [
        (
            name: "owner[:group] or :group",
            generators: [
                (
                    has_custom: true,
                    trigger: Some(OnMatch([
                            ":",
                        ])),
                    query_term: Some(AfterLast(":")),
                ),
            ],
        ),
        (
            name: "file/directory",
            template: [
                FilePaths,
                Folders,
            ],
            variadic: true,
        ),
    ],
)
