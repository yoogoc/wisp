(
    version: 1,
    command: "sam",
    description: Some("AWS Serverless Application Model CLI"),
    subcommands: [
        (
            name: "init",
            description: Some("Init an AWS SAM application"),
            options: [
                (
                    names: [
                        "--config-env",
                    ],
                    description: Some("The environment name specifying the default parameter values in the configuration file to use"),
                    arguments: [
                        (
                            name: "environment",
                        ),
                    ],
                ),
                (
                    names: [
                        "--config-file",
                    ],
                    description: Some("The path and file name of the configuration file containing default parameter values to use"),
                    arguments: [
                        (
                            name: "config file",
                        ),
                    ],
                ),
                (
                    names: [
                        "--debug",
                    ],
                    description: Some("Turn on debug logging to print debug message generated by SAM CLI and display timestamps"),
                ),
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Show help for sam"),
                ),
                (
                    names: [
                        "--no-interactive",
                    ],
                    description: Some("Disable interactive prompting for init parameters, and fail if any required values are missing"),
                ),
                (
                    names: [
                        "-a",
                        "--architecture",
                    ],
                    description: Some("Architectures your Lambda function will run on"),
                    arguments: [
                        (
                            name: "architecture",
                            suggestions: [
                                (
                                    name: "arm64",
                                ),
                                (
                                    name: "x86_64",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-l",
                        "--location",
                    ],
                    description: Some("Template location (git, mercurial, http(s), zip, path)"),
                    arguments: [
                        (
                            name: "location",
                        ),
                    ],
                ),
                (
                    names: [
                        "-r",
                        "--runtime",
                    ],
                    description: Some("Lambda Runtime for your app"),
                    arguments: [
                        (
                            name: "runtime",
                            suggestions: [
                                (
                                    name: "dotnet8",
                                ),
                                (
                                    name: "dotnet6",
                                ),
                                (
                                    name: "go1.x",
                                ),
                                (
                                    name: "java21",
                                ),
                                (
                                    name: "java17",
                                ),
                                (
                                    name: "java11",
                                ),
                                (
                                    name: "java8.al2",
                                ),
                                (
                                    name: "nodejs20.x",
                                ),
                                (
                                    name: "nodejs18.x",
                                ),
                                (
                                    name: "nodejs16.x",
                                ),
                                (
                                    name: "provided.al2023",
                                ),
                                (
                                    name: "provided.al2",
                                ),
                                (
                                    name: "provided",
                                ),
                                (
                                    name: "python3.12",
                                ),
                                (
                                    name: "python3.11",
                                ),
                                (
                                    name: "python3.10",
                                ),
                                (
                                    name: "python3.9",
                                ),
                                (
                                    name: "python3.8",
                                ),
                                (
                                    name: "ruby3.2",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-p",
                        "--package-type",
                    ],
                    description: Some("Package type for your app"),
                    arguments: [
                        (
                            name: "type",
                            suggestions: [
                                (
                                    name: "zip",
                                ),
                                (
                                    name: "image",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-i",
                        "--base-image",
                    ],
                    description: Some("Lambda Image of your app"),
                    arguments: [
                        (
                            name: "image name",
                            suggestions: [
                                (
                                    name: "amazon/dotnet8-base",
                                ),
                                (
                                    name: "amazon/dotnet6-base",
                                ),
                                (
                                    name: "amazon/go1.x-base",
                                ),
                                (
                                    name: "amazon/go-provided.al2-base",
                                ),
                                (
                                    name: "amazon/go-provided.al2023-base",
                                ),
                                (
                                    name: "amazon/java21-base",
                                ),
                                (
                                    name: "amazon/java17-base",
                                ),
                                (
                                    name: "amazon/java11-base",
                                ),
                                (
                                    name: "amazon/java8.al2-base",
                                ),
                                (
                                    name: "amazon/nodejs20.x-base",
                                ),
                                (
                                    name: "amazon/nodejs18.x-base",
                                ),
                                (
                                    name: "amazon/nodejs16.x-base",
                                ),
                                (
                                    name: "amazon/python3.12-base",
                                ),
                                (
                                    name: "amazon/python3.11-base",
                                ),
                                (
                                    name: "amazon/python3.10-base",
                                ),
                                (
                                    name: "amazon/python3.9-base",
                                ),
                                (
                                    name: "amazon/python3.8-base",
                                ),
                                (
                                    name: "amazon/ruby3.2-base",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-d",
                        "--dependency-manager",
                    ],
                    description: Some("Dependency manager for your Lambda runtime"),
                    arguments: [
                        (
                            name: "manager",
                            suggestions: [
                                (
                                    name: "npm",
                                ),
                                (
                                    name: "mod",
                                ),
                                (
                                    name: "gradle",
                                ),
                                (
                                    name: "cli-package",
                                ),
                                (
                                    name: "bundler",
                                ),
                                (
                                    name: "pip",
                                ),
                                (
                                    name: "maven",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-o",
                        "--output-dir",
                    ],
                    description: Some("Where to output the initialized app into"),
                    arguments: [
                        (
                            name: "path",
                        ),
                    ],
                ),
                (
                    names: [
                        "-n",
                        "--name",
                    ],
                    description: Some("Name of your project to be generated as a folder"),
                    arguments: [
                        (
                            name: "text",
                        ),
                    ],
                ),
                (
                    names: [
                        "--app-template",
                    ],
                    description: Some("Identifier of the managed application template you want to use"),
                    arguments: [
                        (
                            name: "text",
                            description: Some("Template name"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-input",
                    ],
                    description: Some("Disable Cookiecutter prompting and accept default values defined template config"),
                ),
                (
                    names: [
                        "--extra-context",
                    ],
                    description: Some("Override any custom parameters in the template's cookiecutter.json configuration"),
                    arguments: [
                        (
                            name: "text",
                            description: Some("E.g. {\"customParam1\": \"customValue1\", \"customParam2\":\"customValue2\"}"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "validate",
            description: Some("Validate an AWS SAM template"),
            options: [
                (
                    names: [
                        "--config-env",
                    ],
                    description: Some("The environment name specifying the default parameter values in the configuration file to use"),
                    arguments: [
                        (
                            name: "environment",
                        ),
                    ],
                ),
                (
                    names: [
                        "--config-file",
                    ],
                    description: Some("The path and file name of the configuration file containing default parameter values to use"),
                    arguments: [
                        (
                            name: "config file",
                        ),
                    ],
                ),
                (
                    names: [
                        "--debug",
                    ],
                    description: Some("Turn on debug logging to print debug message generated by SAM CLI and display timestamps"),
                ),
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Show help for sam"),
                ),
                (
                    names: [
                        "--profile",
                    ],
                    description: Some("Select a specific profile from your credential file to get AWS credentials"),
                    arguments: [
                        (
                            name: "profile name",
                            description: Some("The name of the AWS profile"),
                            generators: [
                                (
                                    script: [
                                        "aws",
                                        "configure",
                                        "list-profiles",
                                    ],
                                    has_post_process: true,
                                    cache: Some((
                                        by_directory: true,
                                        stale_while_revalidate: true,
                                    )),
                                ),
                            ],
                            filter_strategy: Fuzzy,
                        ),
                    ],
                ),
                (
                    names: [
                        "--region",
                    ],
                    description: Some("Set the AWS Region of the service"),
                    arguments: [
                        (
                            name: "region",
                        ),
                    ],
                ),
                (
                    names: [
                        "-t",
                        "--template-file",
                        "--template",
                    ],
                    description: Some("AWS SAM template file"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "build",
            description: Some("Build your Lambda function code"),
            options: [
                (
                    names: [
                        "--config-env",
                    ],
                    description: Some("The environment name specifying the default parameter values in the configuration file to use"),
                    arguments: [
                        (
                            name: "environment",
                        ),
                    ],
                ),
                (
                    names: [
                        "--config-file",
                    ],
