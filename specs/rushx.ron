(
    version: 1,
    command: "rushx",
    description: Some("Run arbitrary package scripts for rush project. analogous to npm run"),
    subcommands: [],
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Show this help message and exit"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-q",
                "--quiet",
            ],
            description: Some("Hide rushx startup information"),
            takes_value: false,
            arguments: [],
        ),
    ],
    arguments: [
        (
            name: "Scripts",
            source: Unavailable,
            optional: false,
            variadic: false,
            imported_generator: Some((
                script: [
                    "bash",
                    "-c",
                    "until [[ -f package.json ]] || [[ $PWD = \'/\' ]]; do cd ..; done; cat package.json",
                ],
                has_post_process: true,
                has_custom: false,
            )),
        ),
    ],
)