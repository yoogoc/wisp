(
    version: 1,
    command: "rushx",
    description: Some("Run arbitrary package scripts for rush project. analogous to npm run"),
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Show this help message and exit"),
        ),
        (
            names: [
                "-q",
                "--quiet",
            ],
            description: Some("Hide rushx startup information"),
        ),
    ],
    arguments: [
        (
            name: "Scripts",
            description: Some("Script to run from your package.json"),
            generators: [
                (
                    script: [
                        "bash",
                        "-c",
                        "until [[ -f package.json ]] || [[ $PWD = '/' ]]; do cd ..; done; cat package.json",
                    ],
                    has_post_process: true,
                    cache: Some((
                        by_directory: true,
                        stale_while_revalidate: true,
                    )),
                ),
            ],
            filter_strategy: Fuzzy,
            is_command: true,
        ),
    ],
)
