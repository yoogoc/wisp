(
    version: 1,
    command: "composer",
    description: Some("Create and manage Cloud Composer Environments"),
    subcommands: [
        (
            name: "environments",
            description: Some("Create and manage Cloud Composer environments"),
            subcommands: [
                (
                    name: "create",
                    description: Some("Create and initialize a Cloud Composer environment"),
                    options: [
                        (
                            names: [
                                "--account",
                            ],
                            description: Some("Google Cloud Platform user account to use for invocation. Overrides the default *core/account* property value for this command invocation"),
                            arguments: [
                                (
                                    name: "ACCOUNT",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--airflow-configs",
                            ],
                            description: Some("A list of Airflow software configuration override KEY=VALUE pairs to set. For\ninformation on how to structure KEYs and VALUEs, run\n`$ {top_command} help composer environments update`"),
                            arguments: [
                                (
                                    name: "KEY=VALUE",
                                    description: Some("Dict"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--airflow-version",
                            ],
                            description: Some("Version of Airflow to run in the environment.\n+\n      Must be of the form `X.Y[.Z]`.\n+\n      The latest supported Cloud Composer version will be used within\n      the created environment"),
                            arguments: [
                                (
                                    name: "AIRFLOW_VERSION",
                                    description: Some("Googlecloudsdk.calliope.arg_parsers:Parse"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--async",
                            ],
                            description: Some("Return immediately, without waiting for the operation in progress to\ncomplete"),
                        ),
                        (
                            names: [
                                "--billing-project",
                            ],
                            description: Some("The Google Cloud Platform project that will be charged quota for operations performed in gcloud. If you need to operate on one project, but need quota against a different project, you can use this flag to specify the billing project. If both `billing/quota_project` and `--billing-project` are specified, `--billing-project` takes precedence. Run `$ gcloud config set --help` to see more information about `billing/quota_project`"),
                            arguments: [
                                (
                                    name: "BILLING_PROJECT",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--cloud-sql-ipv4-cidr",
                            ],
                            description: Some("IPv4 CIDR range to use for the Cloud SQL network. This should have a size\nof the netmask not greater than 24.\n+\nCannot be specified unless '--enable-private-environment' is also\nspecified"),
                            arguments: [
                                (
                                    name: "CLOUD_SQL_IPV4_CIDR",
                                    description: Some("Googlecloudsdk.calliope.arg_parsers:Parse"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--cluster-ipv4-cidr",
                            ],
                            description: Some("IP address range for the pods in this cluster in CIDR notation\n(e.g. 10.0.0.0/14).\n+\nCannot be specified unless '--enable-ip-alias' is also specified"),
                            arguments: [
                                (
                                    name: "CLUSTER_IPV4_CIDR",
                                    description: Some("Googlecloudsdk.calliope.arg_parsers:Parse"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--cluster-secondary-range-name",
                            ],
                            description: Some("Secondary range to be used as the source for pod IPs. Alias ranges will be\nallocated from this secondary range. NAME must be the name of an existing\nsecondary range in the cluster subnetwork.\n+\nCannot be specified unless '--enable-ip-alias' is also specified"),
                            arguments: [
                                (
                                    name: "CLUSTER_SECONDARY_RANGE_NAME",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--configuration",
                            ],
                            description: Some("The configuration to use for this command invocation. For more\ninformation on how to use configurations, run:\n`gcloud topic configurations`.  You can also use the CLOUDSDK_ACTIVE_CONFIG_NAME environment\nvariable to set the equivalent of this flag for a terminal\nsession"),
                            arguments: [
                                (
                                    name: "CONFIGURATION",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--disk-size",
                            ],
                            description: Some("The disk size for each VM node in the environment. The minimum size is 20GB, and the maximum is 64TB. Specified value must be an integer multiple of gigabytes. Cannot be updated after the environment has been created. If units are not provided, defaults to GB"),
                            arguments: [
                                (
                                    name: "DISK_SIZE",
                                    description: Some("Googlecloudsdk.calliope.arg_parsers:ParseWithBoundsChecking"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--enable-ip-alias",
                            ],
                            description: Some("Enable use of alias IPs (https://cloud.google.com/compute/docs/alias-ip/)\nfor Pod IPs. This will require at least two secondary ranges in the\nsubnetwork, one for the pod IPs and another to reserve space for the\nservices range"),
                        ),
                        (
                            names: [
                                "--enable-private-endpoint",
                            ],
                            description: Some("Environment cluster is managed using the private IP address of the master\nAPI endpoint. Therefore access to the master endpoint must be from\ninternal IP addresses.\n+\nIf not specified, the master API endpoint will be accessible by its public\nIP address.\n+\nCannot be specified unless '--enable-private-environment' is also\nspecified"),
                        ),
                        (
                            names: [
                                "--enable-private-environment",
                            ],
                            description: Some("Environment cluster is created with no public IP addresses on the cluster\nnodes.\n+\nIf not specified, cluster nodes will be assigned public IP addresses.\n+\nCannot be specified unless '--enable-ip-alias' is also specified"),
                        ),
                        (
                            names: [
                                "--env-variables",
                            ],
                            description: Some("A comma-delimited list of environment variable `NAME=VALUE` pairs to provide to the Airflow scheduler, worker, and webserver processes. NAME may contain upper and lowercase letters, digits, and underscores, but they may not begin with a digit. To include commas as part of a `VALUE`, see `{top_command} topics escaping` for information about overriding the delimiter"),
                            arguments: [
                                (
                                    name: "NAME=VALUE",
                                    description: Some("Dict"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--flags-file",
                            ],
                            description: Some("A YAML or JSON file that specifies a *--flag*:*value* dictionary.\nUseful for specifying complex flag values with special characters\nthat work with any command interpreter. Additionally, each\n*--flags-file* arg is replaced by its constituent flags. See\n$ gcloud topic flags-file for more information"),
                            arguments: [
                                (
                                    name: "YAML_FILE",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--flatten",
                            ],
                            description: Some("Flatten _name_[] output resource slices in _KEY_ into separate records\nfor each item in each slice. Multiple keys and slices may be specified.\nThis also flattens keys for *--format* and *--filter*. For example,\n*--flatten=abc.def* flattens *abc.def[].ghi* references to\n*abc.def.ghi*. A resource record containing *abc.def[]* with N elements\nwill expand to N records in the flattened output. This flag interacts\nwith other flags that are applied in this order: *--flatten*,\n*--sort-by*, *--filter*, *--limit*"),
                            arguments: [
                                (
                                    name: "KEY",
                                    description: Some("List"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--format",
                            ],
                            description: Some("Set the format for printing command output resources. The default is a\ncommand-specific human-friendly output format. The supported formats\nare: `config`, `csv`, `default`, `diff`, `disable`, `flattened`, `get`, `json`, `list`, `multi`, `none`, `object`, `table`, `text`, `value`, `yaml`. For more details run $ gcloud topic formats"),
                            arguments: [
                                (
                                    name: "FORMAT",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--help",
                            ],
                            description: Some("Display detailed help"),
                        ),
                        (
                            names: [
                                "--image-version",
                            ],
                            description: Some("Version of the image to run in the environment.\n+\n      The image version encapsulates the versions of both Cloud Composer\n      and Apache Airflow. Must be of the form\n      `composer-A.B.C[-D.E]-airflow-X.Y[.Z]`.\n+\n      The Cloud Composer and Airflow versions are semantic versions.\n      `latest` can be provided instead of an explicit Cloud Composer\n      version number indicating that the server will replace `latest`\n      with the current Cloud Composer version. For the Apache Airflow\n      portion, the patch version can be omitted and the current\n      version will be selected. The version numbers that are used will\n      be stored"),
                            arguments: [
                                (
                                    name: "IMAGE_VERSION",
                                    description: Some("Googlecloudsdk.calliope.arg_parsers:Parse"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--impersonate-service-account",
                            ],
                            description: Some("For this gcloud invocation, all API requests will be made as the given service account instead of the currently selected account. This is done without needing to create, download, and activate a key for the account. In order to perform operations as the service account, your currently selected account must have an IAM role that includes the iam.serviceAccounts.getAccessToken permission for the service account. The roles/iam.serviceAccountTokenCreator role has this permission or you may create a custom role. Overrides the default *auth/impersonate_service_account* property value for this command invocation"),
                            arguments: [
                                (
                                    name: "SERVICE_ACCOUNT_EMAIL",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--labels",
                            ],
                            description: Some("List of label KEY=VALUE pairs to add.\n+\nKeys must start with a lowercase character and contain only hyphens (`-`), underscores (```_```), lowercase characters, and numbers. Values must contain only hyphens (`-`), underscores (```_```), lowercase characters, and numbers"),
                            arguments: [
                                (
                                    name: "KEY=VALUE",
                                    description: Some("Dict"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--location",
                            ],
                            description: Some("Compute Engine region in which to create the environment"),
                            arguments: [
                                (
                                    name: "LOCATION",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--log-http",
                            ],
                            description: Some("Log all HTTP server requests and responses to stderr. Overrides the default *core/log_http* property value for this command invocation"),
                        ),
                        (
                            names: [
                                "--machine-type",
                            ],
                            description: Some("The Compute Engine machine type (https://cloud.google.com/compute/docs/machine-types) to use for nodes. For example `--machine-type=n1-standard-1`"),
                            arguments: [
                                (
                                    name: "MACHINE_TYPE",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--master-ipv4-cidr",
                            ],
                            description: Some("IPv4 CIDR range to use for the cluste master network. This should have a\nsize of the netmask between 23 and 28.\n+\nCannot be specified unless '--enable-private-environment' is also\nspecified"),
                            arguments: [
                                (
                                    name: "MASTER_IPV4_CIDR",
                                    description: Some("Googlecloudsdk.calliope.arg_parsers:Parse"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--network",
                            ],
                            description: Some("The Compute Engine Network to which the environment will be connected. If a 'Custom Subnet Network' is provided, `--subnetwork` must be specified as well"),
                            arguments: [
                                (
                                    name: "NETWORK",
                                    description: Some("String"),
                                ),
                            ],
                            presentation: (
                                priority: Some(100.0),
                            ),
                        ),
                        (
                            names: [
                                "--node-count",
                            ],
                            description: Some("The number of nodes to create to run the environment"),
                            arguments: [
                                (
                                    name: "NODE_COUNT",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--oauth-scopes",
                            ],
                            description: Some("The set of Google API scopes to be made available on all of the node VMs. Defaults to ['https://www.googleapis.com/auth/cloud-platform']. Cannot be updated"),
                            arguments: [
                                (
                                    name: "SCOPE",
                                    description: Some("List"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--project",
                            ],
                            description: Some("The Google Cloud Platform project ID to use for this invocation. If\nomitted, then the current project is assumed; the current project can\nbe listed using `gcloud config list --format='text(core.project)'`\nand can be set using `gcloud config set project PROJECTID`.\n+\n`--project` and its fallback `core/project` property play two roles\nin the invocation. It specifies the project of the resource to\noperate on. It also specifies the project for API enablement check,\nquota, and billing. To specify a different project for quota and\nbilling, use `--billing-project` or `billing/quota_project` property"),
                            arguments: [
                                (
                                    name: "PROJECT_ID",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--python-version",
                            ],
                            description: Some("The Python version to be used within the created environment. Supplied value should represent the desired major Python version. Cannot be updated. _PYTHON_VERSION_ must be one of:\n+\n*2*::: Created environment will use Python 2\n*3*::: Created environment will use Python 3\n:::\n+"),
                            arguments: [
                                (
                                    name: "PYTHON_VERSION",
                                    description: Some("String"),
                                    suggestions: [
                                        (
                                            name: "2",
                                        ),
                                        (
                                            name: "3",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--quiet",
                            ],
                            description: Some("Disable all interactive prompts when running gcloud commands. If input\nis required, defaults will be used, or an error will be raised.\nOverrides the default core/disable_prompts property value for this\ncommand invocation. This is equivalent to setting the environment\nvariable `CLOUDSDK_CORE_DISABLE_PROMPTS` to 1"),
                        ),
                        (
                            names: [
                                "--service-account",
                            ],
                            description: Some("The Google Cloud Platform service account to be used by the node VMs. If a service account is not specified, the \"default\" Compute Engine service account for the project is used. Cannot be updated"),
                            arguments: [
                                (
                                    name: "SERVICE_ACCOUNT",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--services-ipv4-cidr",
                            ],
                            description: Some("IP range for the services IPs.\n+\nCan be specified as a netmask size (e.g. '/20') or as in CIDR notion\n(e.g. '10.100.0.0/20'). If given as a netmask size, the IP range will\nbe chosen automatically from the available space in the network.\n+\nIf unspecified, the services CIDR range will be chosen with a default\nmask size.\n+\nCannot be specified unless '--enable-ip-alias' is also specified"),
                            arguments: [
                                (
                                    name: "SERVICES_IPV4_CIDR",
                                    description: Some("Googlecloudsdk.calliope.arg_parsers:Parse"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--services-secondary-range-name",
                            ],
                            description: Some("Secondary range to be used for services (e.g. ClusterIPs). NAME must be the\nname of an existing secondary range in the cluster subnetwork.\n+\nCannot be specified unless '--enable-ip-alias' is also specified"),
                            arguments: [
                                (
                                    name: "SERVICES_SECONDARY_RANGE_NAME",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--subnetwork",
                            ],
                            description: Some("The Compute Engine subnetwork (https://cloud.google.com/compute/docs/subnetworks) to which the environment will be connected"),
                            arguments: [
                                (
                                    name: "SUBNETWORK",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--tags",
                            ],
                            description: Some("The set of instance tags applied to all node VMs. Tags are used to identify valid sources or targets for network firewalls. Each tag within the list must comply with RFC 1035. Cannot be updated"),
                            arguments: [
                                (
                                    name: "TAG",
                                    description: Some("List"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--trace-token",
                            ],
                            description: Some("Token used to route traces of service requests for investigation of issues. Overrides the default *core/trace_token* property value for this command invocation"),
                            arguments: [
                                (
                                    name: "TRACE_TOKEN",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--user-output-enabled",
                            ],
                            description: Some("Print user intended output to the console. Overrides the default *core/user_output_enabled* property value for this command invocation. Use *--no-user-output-enabled* to disable"),
                        ),
                        (
                            names: [
                                "--verbosity",
                            ],
                            description: Some("Override the default verbosity for this command. Overrides the default *core/verbosity* property value for this command invocation. _VERBOSITY_ must be one of: *debug*, *info*, *warning*, *error*, *critical*, *none*"),
                            arguments: [
                                (
                                    name: "VERBOSITY",
                                    description: Some("String"),
                                    suggestions: [
                                        (
                                            name: "debug",
                                        ),
                                        (
                                            name: "info",
                                        ),
                                        (
                                            name: "warning",
                                        ),
                                        (
                                            name: "error",
                                        ),
                                        (
                                            name: "critical",
                                        ),
                                        (
                                            name: "none",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--web-server-ipv4-cidr",
                            ],
                            description: Some("IPv4 CIDR range to use for the Airflow web server network. This should have\na size of the netmask between 24 and 29.\n+\nCannot be specified unless '--enable-private-environment' is also\nspecified"),
                            arguments: [
                                (
                                    name: "WEB_SERVER_IPV4_CIDR",
                                    description: Some("Googlecloudsdk.calliope.arg_parsers:Parse"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--zone",
                            ],
                            description: Some("The Compute Engine zone in which the environment will be created. For example `--zone=us-central1-a`"),
                            arguments: [
                                (
                                    name: "ZONE",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                    ],
                    arguments: [
                        (
                            name: "ENVIRONMENT",
                            description: Some("ID of the environment or fully qualified identifier for the environment"),
                        ),
                    ],
                ),
                (
                    name: "delete",
                    description: Some("Delete one or more Cloud Composer environments"),
                    options: [
                        (
                            names: [
                                "--account",
                            ],
                            description: Some("Google Cloud Platform user account to use for invocation. Overrides the default *core/account* property value for this command invocation"),
                            arguments: [
                                (
                                    name: "ACCOUNT",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--async",
                            ],
                            description: Some("Return immediately, without waiting for the operation in progress to\ncomplete"),
                        ),
                        (
                            names: [
                                "--billing-project",
                            ],
                            description: Some("The Google Cloud Platform project that will be charged quota for operations performed in gcloud. If you need to operate on one project, but need quota against a different project, you can use this flag to specify the billing project. If both `billing/quota_project` and `--billing-project` are specified, `--billing-project` takes precedence. Run `$ gcloud config set --help` to see more information about `billing/quota_project`"),
                            arguments: [
                                (
                                    name: "BILLING_PROJECT",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--configuration",
                            ],
                            description: Some("The configuration to use for this command invocation. For more\ninformation on how to use configurations, run:\n`gcloud topic configurations`.  You can also use the CLOUDSDK_ACTIVE_CONFIG_NAME environment\nvariable to set the equivalent of this flag for a terminal\nsession"),
                            arguments: [
                                (
                                    name: "CONFIGURATION",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--flags-file",
                            ],
                            description: Some("A YAML or JSON file that specifies a *--flag*:*value* dictionary.\nUseful for specifying complex flag values with special characters\nthat work with any command interpreter. Additionally, each\n*--flags-file* arg is replaced by its constituent flags. See\n$ gcloud topic flags-file for more information"),
                            arguments: [
                                (
                                    name: "YAML_FILE",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--flatten",
                            ],
                            description: Some("Flatten _name_[] output resource slices in _KEY_ into separate records\nfor each item in each slice. Multiple keys and slices may be specified.\nThis also flattens keys for *--format* and *--filter*. For example,\n*--flatten=abc.def* flattens *abc.def[].ghi* references to\n*abc.def.ghi*. A resource record containing *abc.def[]* with N elements\nwill expand to N records in the flattened output. This flag interacts\nwith other flags that are applied in this order: *--flatten*,\n*--sort-by*, *--filter*, *--limit*"),
                            arguments: [
                                (
                                    name: "KEY",
                                    description: Some("List"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--format",
                            ],
                            description: Some("Set the format for printing command output resources. The default is a\ncommand-specific human-friendly output format. The supported formats\nare: `config`, `csv`, `default`, `diff`, `disable`, `flattened`, `get`, `json`, `list`, `multi`, `none`, `object`, `table`, `text`, `value`, `yaml`. For more details run $ gcloud topic formats"),
                            arguments: [
                                (
                                    name: "FORMAT",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--help",
                            ],
                            description: Some("Display detailed help"),
                        ),
                        (
                            names: [
                                "--impersonate-service-account",
                            ],
                            description: Some("For this gcloud invocation, all API requests will be made as the given service account instead of the currently selected account. This is done without needing to create, download, and activate a key for the account. In order to perform operations as the service account, your currently selected account must have an IAM role that includes the iam.serviceAccounts.getAccessToken permission for the service account. The roles/iam.serviceAccountTokenCreator role has this permission or you may create a custom role. Overrides the default *auth/impersonate_service_account* property value for this command invocation"),
                            arguments: [
                                (
                                    name: "SERVICE_ACCOUNT_EMAIL",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--location",
                            ],
                            description: Some("Compute Engine region in which to create the environments"),
                            arguments: [
