(
    version: 1,
    command: "ml",
    description: Some("Use Google Cloud machine learning capabilities"),
    subcommands: [
        (
            name: "language",
            description: Some("Use the Google Cloud Natural Language API to analyze text"),
            subcommands: [
                (
                    name: "analyze-entities",
                    description: Some("Use Google Cloud Natural Language API to identify entities in text"),
                    options: [
                        (
                            names: [
                                "--account",
                            ],
                            description: Some("Google Cloud Platform user account to use for invocation. Overrides the default *core/account* property value for this command invocation"),
                            arguments: [
                                (
                                    name: "ACCOUNT",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--billing-project",
                            ],
                            description: Some("The Google Cloud Platform project that will be charged quota for operations performed in gcloud. If you need to operate on one project, but need quota against a different project, you can use this flag to specify the billing project. If both `billing/quota_project` and `--billing-project` are specified, `--billing-project` takes precedence. Run `$ gcloud config set --help` to see more information about `billing/quota_project`"),
                            arguments: [
                                (
                                    name: "BILLING_PROJECT",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--configuration",
                            ],
                            description: Some("The configuration to use for this command invocation. For more\ninformation on how to use configurations, run:\n`gcloud topic configurations`.  You can also use the CLOUDSDK_ACTIVE_CONFIG_NAME environment\nvariable to set the equivalent of this flag for a terminal\nsession"),
                            arguments: [
                                (
                                    name: "CONFIGURATION",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--content",
                            ],
                            description: Some("Specify input text on the command line. Useful for experiments, or\nfor extremely short text"),
                            arguments: [
                                (
                                    name: "CONTENT",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--content-file",
                            ],
                            description: Some("Specify a local file or Google Cloud Storage (format\n`gs://bucket/object`) file path containing the text to be analyzed.\nMore useful for longer text or data output from another system"),
                            arguments: [
                                (
                                    name: "CONTENT_FILE",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--content-type",
                            ],
                            description: Some("Specify the format of the input text. _CONTENT_TYPE_ must be one of: *html*, *plain-text*"),
                            arguments: [
                                (
                                    name: "CONTENT_TYPE",
                                    description: Some("Googlecloudsdk.command_lib.util.apis.arg_utils:EnumNameToChoice"),
                                    suggestions: [
                                        (
                                            name: "html",
                                        ),
                                        (
                                            name: "plain-text",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--encoding-type",
                            ],
                            description: Some("The encoding type used by the API to calculate offsets. If set to `none`,\nencoding-dependent offsets will be set at -1. This is an optional flag\nonly used for the entity mentions in results, and does not affect how the\ninput is read or analyzed. _ENCODING_TYPE_ must be one of: *none*, *utf16*, *utf32*, *utf8*"),
                            arguments: [
                                (
                                    name: "ENCODING_TYPE",
                                    description: Some("Googlecloudsdk.command_lib.util.apis.arg_utils:EnumNameToChoice"),
                                    suggestions: [
                                        (
                                            name: "none",
                                        ),
                                        (
                                            name: "utf16",
                                        ),
                                        (
                                            name: "utf32",
                                        ),
                                        (
                                            name: "utf8",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--flags-file",
                            ],
                            description: Some("A YAML or JSON file that specifies a *--flag*:*value* dictionary.\nUseful for specifying complex flag values with special characters\nthat work with any command interpreter. Additionally, each\n*--flags-file* arg is replaced by its constituent flags. See\n$ gcloud topic flags-file for more information"),
                            arguments: [
                                (
                                    name: "YAML_FILE",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--flatten",
                            ],
                            description: Some("Flatten _name_[] output resource slices in _KEY_ into separate records\nfor each item in each slice. Multiple keys and slices may be specified.\nThis also flattens keys for *--format* and *--filter*. For example,\n*--flatten=abc.def* flattens *abc.def[].ghi* references to\n*abc.def.ghi*. A resource record containing *abc.def[]* with N elements\nwill expand to N records in the flattened output. This flag interacts\nwith other flags that are applied in this order: *--flatten*,\n*--sort-by*, *--filter*, *--limit*"),
                            arguments: [
                                (
                                    name: "KEY",
                                    description: Some("List"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--format",
                            ],
                            description: Some("Set the format for printing command output resources. The default is a\ncommand-specific human-friendly output format. The supported formats\nare: `config`, `csv`, `default`, `diff`, `disable`, `flattened`, `get`, `json`, `list`, `multi`, `none`, `object`, `table`, `text`, `value`, `yaml`. For more details run $ gcloud topic formats"),
                            arguments: [
                                (
                                    name: "FORMAT",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--help",
                            ],
                            description: Some("Display detailed help"),
                        ),
                        (
                            names: [
                                "--impersonate-service-account",
                            ],
                            description: Some("For this gcloud invocation, all API requests will be made as the given service account instead of the currently selected account. This is done without needing to create, download, and activate a key for the account. In order to perform operations as the service account, your currently selected account must have an IAM role that includes the iam.serviceAccounts.getAccessToken permission for the service account. The roles/iam.serviceAccountTokenCreator role has this permission or you may create a custom role. Overrides the default *auth/impersonate_service_account* property value for this command invocation"),
                            arguments: [
                                (
                                    name: "SERVICE_ACCOUNT_EMAIL",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--language",
                            ],
                            description: Some("Specify the language of the input text. If omitted, the server will\nattempt to auto-detect. Both ISO (such as `en` or `es`) and BCP-47 (such\nas `en-US` or `ja-JP`) language codes are accepted"),
                            arguments: [
                                (
                                    name: "LANGUAGE",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--log-http",
                            ],
                            description: Some("Log all HTTP server requests and responses to stderr. Overrides the default *core/log_http* property value for this command invocation"),
                        ),
                        (
                            names: [
                                "--project",
                            ],
                            description: Some("The Google Cloud Platform project ID to use for this invocation. If\nomitted, then the current project is assumed; the current project can\nbe listed using `gcloud config list --format='text(core.project)'`\nand can be set using `gcloud config set project PROJECTID`.\n+\n`--project` and its fallback `core/project` property play two roles\nin the invocation. It specifies the project of the resource to\noperate on. It also specifies the project for API enablement check,\nquota, and billing. To specify a different project for quota and\nbilling, use `--billing-project` or `billing/quota_project` property"),
                            arguments: [
                                (
                                    name: "PROJECT_ID",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--quiet",
                            ],
                            description: Some("Disable all interactive prompts when running gcloud commands. If input\nis required, defaults will be used, or an error will be raised.\nOverrides the default core/disable_prompts property value for this\ncommand invocation. This is equivalent to setting the environment\nvariable `CLOUDSDK_CORE_DISABLE_PROMPTS` to 1"),
                        ),
                        (
                            names: [
                                "--trace-token",
                            ],
                            description: Some("Token used to route traces of service requests for investigation of issues. Overrides the default *core/trace_token* property value for this command invocation"),
                            arguments: [
                                (
                                    name: "TRACE_TOKEN",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--user-output-enabled",
                            ],
                            description: Some("Print user intended output to the console. Overrides the default *core/user_output_enabled* property value for this command invocation. Use *--no-user-output-enabled* to disable"),
                        ),
                        (
                            names: [
                                "--verbosity",
                            ],
                            description: Some("Override the default verbosity for this command. Overrides the default *core/verbosity* property value for this command invocation. _VERBOSITY_ must be one of: *debug*, *info*, *warning*, *error*, *critical*, *none*"),
                            arguments: [
                                (
                                    name: "VERBOSITY",
