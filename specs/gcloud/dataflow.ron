                        ),
                        (
                            names: [
                                "--sdk-language",
                            ],
                            description: Some("SDK language of the flex template job. _SDK_LANGUAGE_ must be one of: *JAVA*, *PYTHON*"),
                            arguments: [
                                (
                                    name: "SDK_LANGUAGE",
