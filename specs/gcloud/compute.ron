                    name: "update",
                    description: Some("Update a firewall rule"),
                    options: [
                        (
                            names: [
                                "--account",
                            ],
                            description: Some("Google Cloud Platform user account to use for invocation. Overrides the default *core/account* property value for this command invocation"),
                            arguments: [
                                (
                                    name: "ACCOUNT",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--allow",
                            ],
                            description: Some("A list of protocols and ports whose traffic will be allowed.\n+\nThe protocols allowed over this connection. This can be the\n(case-sensitive) string values `tcp`, `udp`, `icmp`, `esp`, `ah`, `sctp`,\nor any IP protocol number. An IP-based protocol must be specified for each\nrule. The rule applies only to specified protocol.\n+\nFor port-based protocols - `tcp`, `udp`, and `sctp` - a list of\ndestination ports or port ranges to which the rule applies may optionally\nbe specified. If no port or port range is specified, the rule applies to\nall destination ports.\n+\nThe ICMP protocol is supported, but there is no support for configuring\nICMP packet filtering by ICMP code.\n+\nFor example, to create a rule that allows TCP traffic through port 80 and\nICMP traffic:\n+\n  $ {command} MY-RULE --allow tcp:80,icmp\n+\nTo create a rule that allows TCP traffic from port 20000 to 25000:\n+\n  $ {command} MY-RULE --allow tcp:20000-25000\n+\nTo create a rule that allows all TCP traffic:\n+\n  $ {command} MY-RULE --allow tcp\n+\n\nSetting this will override the current values"),
                            arguments: [
                                (
                                    name: "PROTOCOL[:PORT[-PORT]]",
                                    description: Some("List"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--billing-project",
                            ],
                            description: Some("The Google Cloud Platform project that will be charged quota for operations performed in gcloud. If you need to operate on one project, but need quota against a different project, you can use this flag to specify the billing project. If both `billing/quota_project` and `--billing-project` are specified, `--billing-project` takes precedence. Run `$ gcloud config set --help` to see more information about `billing/quota_project`"),
                            arguments: [
                                (
                                    name: "BILLING_PROJECT",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--configuration",
                            ],
                            description: Some("The configuration to use for this command invocation. For more\ninformation on how to use configurations, run:\n`gcloud topic configurations`.  You can also use the CLOUDSDK_ACTIVE_CONFIG_NAME environment\nvariable to set the equivalent of this flag for a terminal\nsession"),
                            arguments: [
                                (
                                    name: "CONFIGURATION",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--description",
                            ],
                            description: Some("A textual description for the firewall rule. Set to an empty string to clear existing"),
                            arguments: [
                                (
                                    name: "DESCRIPTION",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--destination-ranges",
                            ],
                            description: Some("The firewall rule will apply to traffic that has destination IP address\nin these IP address block list. The IP address blocks must be specified\nin CIDR format:\nlink:http://en.wikipedia.org/wiki/Classless_Inter-Domain_Routing[].\n+\nSetting this will override the existing destination ranges for the\nfirewall. The following will clear the existing destination ranges:\n+\n  $ {command} MY-RULE --destination-ranges"),
                            arguments: [
                                (
                                    name: "CIDR_RANGE",
                                    description: Some("List"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--disabled",
                            ],
                            description: Some("Disable a firewall rule and stop it from being enforced in the network.\nIf a firewall rule is disabled, the associated network behaves as if the\nrule did not exist. To enable a disabled rule, use:\n+\n $ {parent_command} update MY-RULE --no-disabled\n+"),
