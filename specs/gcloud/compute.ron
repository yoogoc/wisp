                        (
                            names: [
                                "--boot-disk-size",
                            ],
                            description: Some("The size of the boot disk. This option can only be specified if a new\nboot disk is being created (as opposed to mounting an existing\npersistent disk). The value must be a whole number followed by a size\nunit of ``KB'' for kilobyte, ``MB'' for megabyte, ``GB'' for gigabyte,\nor ``TB'' for terabyte. For example, ``10GB'' will produce a 10 gigabyte\ndisk. The minimum size a boot disk can have is 10 GB. Disk size must be a\nmultiple of 1 GB. Limit boot disk size to 2 TB to account for MBR\npartition table limitations. Default size unit is ``GB''"),
                            arguments: [
                                (
                                    name: "BOOT_DISK_SIZE",
                                    description: Some("Googlecloudsdk.calliope.arg_parsers:ParseWithBoundsChecking"),
