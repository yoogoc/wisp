                    name: "add-backend",
                    description: Some("Add a backend to a backend service"),
                    options: [
                        (
                            names: [
                                "--account",
                            ],
                            description: Some("Google Cloud Platform user account to use for invocation. Overrides the default *core/account* property value for this command invocation"),
                            arguments: [
                                (
                                    name: "ACCOUNT",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--balancing-mode",
                            ],
                            description: Some("Defines how to measure whether a backend can handle additional traffic or is\nfully loaded. For more information, see\nhttps://cloud.google.com/load-balancing/docs/backend-service#balancing-mode.\n+\nThis cannot be used when the endpoint type of an attached network endpoint\ngroup is INTERNET_IP_PORT, INTERNET_FQDN_PORT, or SERVERLESS.\n+\n_BALANCING_MODE_ must be one of:\n+\n*CONNECTION*::: \nAvailable if the backend service's load balancing scheme is either\n`INTERNAL` or `EXTERNAL`.\nAvailable if the backend service's protocol is one of `SSL`, `TCP`,\nor `UDP`.\n+\nSpreads load based on how many concurrent connections the backend\ncan handle.\n+\nFor backend services with --load-balancing-scheme `EXTERNAL`, you\nmust specify exactly one of these additional parameters:\n`--max-connections`, `--max-connections-per-instance`, or\n`--max-connections-per-endpoint`.\n+\nFor backend services where `--load-balancing-scheme` is `INTERNAL`,\nyou must omit all of these parameters.\n+\n*RATE*::: \nAvailable if the backend service's load balancing scheme is\n`INTERNAL_MANAGED`, `INTERNAL_SELF_MANAGED`, or `EXTERNAL`. Available\nif the backend service's protocol is one of HTTP, HTTPS, or HTTP/2.\n+\nSpreads load based on how many HTTP requests per second (RPS) the\nbackend can handle.\n+\nYou must specify exactly one of these additional parameters:\n`--max-rate`, `--max-rate-per-instance`, or `--max-rate-per-endpoint`.\n+\n*UTILIZATION*::: \nAvailable if the backend service's load balancing scheme is\n`INTERNAL_MANAGED`, `INTERNAL_SELF_MANAGED`, or `EXTERNAL`. Available only\nfor managed or unmanaged instance group backends.\n+\nSpreads load based on the backend utilization of instances in a backend\ninstance group.\n+\nThe following additional parameters may be specified:\n`--max-utilization`, `--max-rate`, `--max-rate-per-instance`,\n`--max-connections`, `--max-connections-per-instance`.\nFor valid combinations, see `--max-utilization`.\n+\n:::\n+"),
                            arguments: [
                                (
                                    name: "BALANCING_MODE",
                                    description: Some("Googlecloudsdk.command_lib.compute.backend_services.backend_flags:<lambda>"),
                                    suggestions: [
                                        (
                                            name: "CONNECTION",
                                        ),
                                        (
                                            name: "RATE",
                                        ),
                                        (
                                            name: "UTILIZATION",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--billing-project",
                            ],
                            description: Some("The Google Cloud Platform project that will be charged quota for operations performed in gcloud. If you need to operate on one project, but need quota against a different project, you can use this flag to specify the billing project. If both `billing/quota_project` and `--billing-project` are specified, `--billing-project` takes precedence. Run `$ gcloud config set --help` to see more information about `billing/quota_project`"),
                            arguments: [
                                (
                                    name: "BILLING_PROJECT",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--capacity-scaler",
                            ],
                            description: Some("A setting that applies to all balancing modes. This value is multiplied\n  by the balancing mode value to set the current max usage of the instance\n  group. You can set the capacity scaler to `0.0` or from `0.1` (10%) to\n  `1.0` (100%). You cannot configure a setting that is larger than `0.0` and\n  smaller than `0.1`. A scale factor of zero (`0.0`) prevents all new\n  connections. You cannot configure a setting of\n  `0.0` when there is only one backend attached to the backend service. Note\n  that draining a backend service only prevents new connections to instances\n  in the group. All existing connections are allowed to continue until they\n  close by normal means. This cannot be used for internal load balancing.\n+\nThis cannot be used when the endpoint type of an attached network endpoint\ngroup is INTERNET_IP_PORT, INTERNET_FQDN_PORT, or SERVERLESS"),
                            arguments: [
                                (
                                    name: "CAPACITY_SCALER",
                                    description: Some("Googlecloudsdk.calliope.arg_parsers:Parse"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--configuration",
                            ],
                            description: Some("The configuration to use for this command invocation. For more\ninformation on how to use configurations, run:\n`gcloud topic configurations`.  You can also use the CLOUDSDK_ACTIVE_CONFIG_NAME environment\nvariable to set the equivalent of this flag for a terminal\nsession"),
                            arguments: [
                                (
                                    name: "CONFIGURATION",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--description",
                            ],
                            description: Some("An optional, textual description for the backend"),
                            arguments: [
                                (
                                    name: "DESCRIPTION",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--failover",
                            ],
                            description: Some("Designates whether this is a failover backend. More than one\nfailover backend can be configured for a given BackendService.\nNot compatible with the --global flag"),
                        ),
                        (
                            names: [
                                "--flags-file",
                            ],
                            description: Some("A YAML or JSON file that specifies a *--flag*:*value* dictionary.\nUseful for specifying complex flag values with special characters\nthat work with any command interpreter. Additionally, each\n*--flags-file* arg is replaced by its constituent flags. See\n$ gcloud topic flags-file for more information"),
                            arguments: [
                                (
                                    name: "YAML_FILE",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--flatten",
                            ],
                            description: Some("Flatten _name_[] output resource slices in _KEY_ into separate records\nfor each item in each slice. Multiple keys and slices may be specified.\nThis also flattens keys for *--format* and *--filter*. For example,\n*--flatten=abc.def* flattens *abc.def[].ghi* references to\n*abc.def.ghi*. A resource record containing *abc.def[]* with N elements\nwill expand to N records in the flattened output. This flag interacts\nwith other flags that are applied in this order: *--flatten*,\n*--sort-by*, *--filter*, *--limit*"),
                            arguments: [
                                (
                                    name: "KEY",
                                    description: Some("List"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--format",
                            ],
                            description: Some("Set the format for printing command output resources. The default is a\ncommand-specific human-friendly output format. The supported formats\nare: `config`, `csv`, `default`, `diff`, `disable`, `flattened`, `get`, `json`, `list`, `multi`, `none`, `object`, `table`, `text`, `value`, `yaml`. For more details run $ gcloud topic formats"),
                            arguments: [
                                (
                                    name: "FORMAT",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--global",
                            ],
                            description: Some("If set, the backend service is global"),
                        ),
                        (
                            names: [
                                "--global-network-endpoint-group",
                            ],
                            description: Some("If set, the network endpoint group is global"),
                        ),
                        (
                            names: [
                                "--help",
                            ],
                            description: Some("Display detailed help"),
                        ),
                        (
                            names: [
                                "--impersonate-service-account",
                            ],
                            description: Some("For this gcloud invocation, all API requests will be made as the given service account instead of the currently selected account. This is done without needing to create, download, and activate a key for the account. In order to perform operations as the service account, your currently selected account must have an IAM role that includes the iam.serviceAccounts.getAccessToken permission for the service account. The roles/iam.serviceAccountTokenCreator role has this permission or you may create a custom role. Overrides the default *auth/impersonate_service_account* property value for this command invocation"),
                            arguments: [
                                (
                                    name: "SERVICE_ACCOUNT_EMAIL",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--instance-group",
                            ],
                            description: Some("Name of the instance group to add to the backend service. For details on valid instance names, refer to the criteria documented under the field 'name' at: https://cloud.google.com/compute/docs/reference/rest/v1/instances"),
                            arguments: [
                                (
                                    name: "INSTANCE_GROUP",
                                    description: Some("String"),
                                ),
                            ],
                            presentation: (
                                priority: Some(100.0),
                            ),
                        ),
                        (
                            names: [
                                "--instance-group-region",
                            ],
                            description: Some("Region of the instance group to add to the backend service. If not specified, you may be prompted to select a region.\n+\nTo avoid prompting when this flag is omitted, you can set the\n``compute/region'' property:\n+\n  $ gcloud config set compute/region REGION\n+\nA list of regions can be fetched by running:\n+\n  $ gcloud compute regions list\n+\nTo unset the property, run:\n+\n  $ gcloud config unset compute/region\n+\nAlternatively, the region can be stored in the environment\nvariable ``CLOUDSDK_COMPUTE_REGION''"),
                            arguments: [
                                (
                                    name: "INSTANCE_GROUP_REGION",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--instance-group-zone",
                            ],
                            description: Some("Zone of the instance group to add to the backend service. If not specified and the ``compute/zone'' property isn't set, you\nmay be prompted to select a zone.\n+\nTo avoid prompting when this flag is omitted, you can set the\n``compute/zone'' property:\n+\n  $ gcloud config set compute/zone ZONE\n+\nA list of zones can be fetched by running:\n+\n  $ gcloud compute zones list\n+\nTo unset the property, run:\n+\n  $ gcloud config unset compute/zone\n+\nAlternatively, the zone can be stored in the environment variable\n``CLOUDSDK_COMPUTE_ZONE''"),
                            arguments: [
                                (
                                    name: "INSTANCE_GROUP_ZONE",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--log-http",
                            ],
                            description: Some("Log all HTTP server requests and responses to stderr. Overrides the default *core/log_http* property value for this command invocation"),
                        ),
                        (
                            names: [
                                "--max-connections",
                            ],
                            description: Some("Maximum concurrent connections that the backend can handle. Valid for\n    network endpoint group and instance group backends (except for regional\n    managed instance groups).\n+\nThis cannot be used when the endpoint type of an attached network endpoint\ngroup is INTERNET_IP_PORT, INTERNET_FQDN_PORT, or SERVERLESS"),
                            arguments: [
                                (
                                    name: "MAX_CONNECTIONS",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--max-connections-per-endpoint",
                            ],
                            description: Some("Only valid for network endpoint group backends. Defines a maximum\n    number of connections per endpoint if all endpoints are healthy. When\n    one or more endpoints are unhealthy, an effective maximum number of\n    connections per healthy endpoint is calculated by multiplying\n    `MAX_CONNECTIONS_PER_ENDPOINT` by the number of endpoints in the network\n    endpoint group, then dividing by the number of healthy endpoints.\n+\nThis cannot be used when the endpoint type of an attached network endpoint\ngroup is INTERNET_IP_PORT, INTERNET_FQDN_PORT, or SERVERLESS"),
                            arguments: [
                                (
                                    name: "MAX_CONNECTIONS_PER_ENDPOINT",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--max-connections-per-instance",
                            ],
                            description: Some("Only valid for instance group backends. Defines a maximum number\nof concurrent connections per instance if all instances in the\ninstance group are healthy. When one or more instances are\nunhealthy, an effective maximum number of connections per healthy\ninstance is calculated by multiplying `MAX_CONNECTIONS_PER_INSTANCE`\nby the number of instances in the instance group, then dividing by\nthe number of healthy instances"),
                            arguments: [
                                (
                                    name: "MAX_CONNECTIONS_PER_INSTANCE",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--max-rate",
                            ],
                            description: Some("Maximum number of HTTP requests per second (RPS) that the backend can\n    handle. Valid for network endpoint group and instance group backends\n    (except for regional managed instance groups). Must not be defined if the\n    backend is a managed instance group using load balancing-based autoscaling.\n+\nThis cannot be used when the endpoint type of an attached network endpoint\ngroup is INTERNET_IP_PORT, INTERNET_FQDN_PORT, or SERVERLESS"),
                            arguments: [
                                (
                                    name: "MAX_RATE",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--max-rate-per-endpoint",
                            ],
                            description: Some("Only valid for network endpoint group backends. Defines a maximum\n    number of HTTP requests per second (RPS) per endpoint if all endpoints\n    are healthy. When one or more endpoints are unhealthy, an effective\n    maximum rate per healthy endpoint is calculated by multiplying\n    `MAX_RATE_PER_ENDPOINT` by the number of endpoints in the network\n    endpoint group, then dividing by the number of healthy endpoints.\n+\nThis cannot be used when the endpoint type of an attached network endpoint\ngroup is INTERNET_IP_PORT, INTERNET_FQDN_PORT, or SERVERLESS"),
                            arguments: [
                                (
                                    name: "MAX_RATE_PER_ENDPOINT",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--max-rate-per-instance",
                            ],
                            description: Some("Only valid for instance group backends. Defines a maximum number of\nHTTP requests per second (RPS) per instance if all instances in the\ninstance group are healthy. When one or more instances are unhealthy,\nan effective maximum RPS per healthy instance is calculated by\nmultiplying `MAX_RATE_PER_INSTANCE` by the number of instances in the\ninstance group, then dividing by the number of healthy instances. This\nparameter is compatible with managed instance group backends that use\nautoscaling based on load balancing"),
                            arguments: [
                                (
                                    name: "MAX_RATE_PER_INSTANCE",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--max-utilization",
                            ],
                            description: Some("Defines the maximum target for average utilization of the backend instance\nin the backend instance group. Acceptable values are `0.0` (0%) through\n`1.0`(100%). Available for all backend service protocols, with\n`--balancing-mode=UTILIZATION`.\n+\nFor backend services that use SSL, TCP, or UDP protocols, the following\nconfiguration options are supported:\n+\n* no additional parameter\n* only `--max-utilization`\n* only `--max-connections` (except for regional managed instance groups)\n* only `--max-connections-per-instance`\n* both `--max-utilization` and `--max-connections` (except for regional\n  managed instance groups)\n* both `--max-utilization` and `--max-connections-per-instance`\n+\nThe meanings for `-max-connections` and `--max-connections-per-instance`\nare the same as for --balancing-mode=CONNECTION. If one is used  with\n`--max-utilization`, instances are considered at capacity\nwhen either maximum utilization or maximum connections is reached.\n+\nFor backend services that use HTTP, HTTPS, or HTTP/2 protocols, the\nfollowing configuration options are supported:\n+\n* no additional parameter\n* only `--max-utilization`\n* only `--max-rate` (except for regional managed instance groups)\n* only `--max-rate-per-instance`\n* both `--max-utilization` and `--max-rate` (except for regional managed\n  instance groups)\n* both `--max-utilization` and `--max-rate-per-instance`\n+\nThe meanings for `--max-rate` and `--max-rate-per-instance` are the same\nas for --balancing-mode=RATE. If one is used in conjunction with\n`--max-utilization`, instances are considered at capacity when *either*\nmaximum utilization or the maximum rate is reached"),
                            arguments: [
                                (
                                    name: "MAX_UTILIZATION",
                                    description: Some("Googlecloudsdk.calliope.arg_parsers:Parse"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--network-endpoint-group",
                            ],
                            description: Some("Name of the network endpoint group to add to the backend service"),
                            arguments: [
                                (
                                    name: "NETWORK_ENDPOINT_GROUP",
                                    description: Some("String"),
                                ),
                            ],
                            presentation: (
                                priority: Some(100.0),
                            ),
                        ),
                        (
                            names: [
                                "--network-endpoint-group-region",
                            ],
                            description: Some("Region of the network endpoint group to add to the backend service. If not specified, you may be prompted to select a region.\n+\nTo avoid prompting when this flag is omitted, you can set the\n``compute/region'' property:\n+\n  $ gcloud config set compute/region REGION\n+\nA list of regions can be fetched by running:\n+\n  $ gcloud compute regions list\n+\nTo unset the property, run:\n+\n  $ gcloud config unset compute/region\n+\nAlternatively, the region can be stored in the environment\nvariable ``CLOUDSDK_COMPUTE_REGION''"),
                            arguments: [
                                (
                                    name: "NETWORK_ENDPOINT_GROUP_REGION",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--network-endpoint-group-zone",
                            ],
                            description: Some("Zone of the network endpoint group to add to the backend service. If not specified and the ``compute/zone'' property isn't set, you\nmay be prompted to select a zone.\n+\nTo avoid prompting when this flag is omitted, you can set the\n``compute/zone'' property:\n+\n  $ gcloud config set compute/zone ZONE\n+\nA list of zones can be fetched by running:\n+\n  $ gcloud compute zones list\n+\nTo unset the property, run:\n+\n  $ gcloud config unset compute/zone\n+\nAlternatively, the zone can be stored in the environment variable\n``CLOUDSDK_COMPUTE_ZONE''"),
                            arguments: [
                                (
                                    name: "NETWORK_ENDPOINT_GROUP_ZONE",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--project",
                            ],
                            description: Some("The Google Cloud Platform project ID to use for this invocation. If\nomitted, then the current project is assumed; the current project can\nbe listed using `gcloud config list --format='text(core.project)'`\nand can be set using `gcloud config set project PROJECTID`.\n+\n`--project` and its fallback `core/project` property play two roles\nin the invocation. It specifies the project of the resource to\noperate on. It also specifies the project for API enablement check,\nquota, and billing. To specify a different project for quota and\nbilling, use `--billing-project` or `billing/quota_project` property"),
                            arguments: [
                                (
                                    name: "PROJECT_ID",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--quiet",
                            ],
                            description: Some("Disable all interactive prompts when running gcloud commands. If input\nis required, defaults will be used, or an error will be raised.\nOverrides the default core/disable_prompts property value for this\ncommand invocation. This is equivalent to setting the environment\nvariable `CLOUDSDK_CORE_DISABLE_PROMPTS` to 1"),
                        ),
                        (
                            names: [
                                "--region",
                            ],
                            description: Some("Region of the backend service to operate on. Overrides the default *compute/region* property value for this command invocation"),
                            arguments: [
                                (
                                    name: "REGION",
                                    description: Some("String"),
                                ),
