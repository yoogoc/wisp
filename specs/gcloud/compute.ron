                                    name: "REGION",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--reservation",
                            ],
                            description: Some("The name of the reservation, required when `--reservation-affinity=specific`"),
                            arguments: [
                                (
                                    name: "RESERVATION",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--reservation-affinity",
                            ],
                            description: Some("The type of reservation for instances created from this template. _RESERVATION_AFFINITY_ must be one of: *any*, *none*, *specific*"),
                            arguments: [
                                (
                                    name: "RESERVATION_AFFINITY",
                                    description: Some("String"),
                                    suggestions: [
                                        (
                                            name: "any",
                                        ),
                                        (
                                            name: "none",
                                        ),
                                        (
                                            name: "specific",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--restart-on-failure",
                            ],
                            description: Some("The instances will be restarted if they are terminated by Compute Engine.\nThis does not affect terminations performed by the user. Enabled by default, use *--no-restart-on-failure* to disable"),
                        ),
                        (
                            names: [
                                "--scopes",
                            ],
                            description: Some("If not provided, the instance will be assigned the default scopes, described below. \n+\nSCOPE can be either the full URI of the scope or an alias. *default* scopes are\nassigned to all instances. Available aliases are:\n+\nAlias | URI\n--- | ---\nbigquery | https://www.googleapis.com/auth/bigquery\ncloud-platform | https://www.googleapis.com/auth/cloud-platform\ncloud-source-repos | https://www.googleapis.com/auth/source.full_control\ncloud-source-repos-ro | https://www.googleapis.com/auth/source.read_only\ncompute-ro | https://www.googleapis.com/auth/compute.readonly\ncompute-rw | https://www.googleapis.com/auth/compute\ndatastore | https://www.googleapis.com/auth/datastore\ndefault | https://www.googleapis.com/auth/devstorage.read_only\n| https://www.googleapis.com/auth/logging.write\n| https://www.googleapis.com/auth/monitoring.write\n| https://www.googleapis.com/auth/pubsub\n| https://www.googleapis.com/auth/service.management.readonly\n| https://www.googleapis.com/auth/servicecontrol\n| https://www.googleapis.com/auth/trace.append\ngke-default | https://www.googleapis.com/auth/devstorage.read_only\n| https://www.googleapis.com/auth/logging.write\n| https://www.googleapis.com/auth/monitoring\n| https://www.googleapis.com/auth/service.management.readonly\n| https://www.googleapis.com/auth/servicecontrol\n| https://www.googleapis.com/auth/trace.append\nlogging-write | https://www.googleapis.com/auth/logging.write\nmonitoring | https://www.googleapis.com/auth/monitoring\nmonitoring-read | https://www.googleapis.com/auth/monitoring.read\nmonitoring-write | https://www.googleapis.com/auth/monitoring.write\npubsub | https://www.googleapis.com/auth/pubsub\nservice-control | https://www.googleapis.com/auth/servicecontrol\nservice-management | https://www.googleapis.com/auth/service.management.readonly\nsql (deprecated) | https://www.googleapis.com/auth/sqlservice\nsql-admin | https://www.googleapis.com/auth/sqlservice.admin\nstorage-full | https://www.googleapis.com/auth/devstorage.full_control\nstorage-ro | https://www.googleapis.com/auth/devstorage.read_only\nstorage-rw | https://www.googleapis.com/auth/devstorage.read_write\ntaskqueue | https://www.googleapis.com/auth/taskqueue\ntrace | https://www.googleapis.com/auth/trace.append\nuserinfo-email | https://www.googleapis.com/auth/userinfo.email\n+\nDEPRECATION WARNING: https://www.googleapis.com/auth/sqlservice account scope\nand `sql` alias do not provide SQL instance management capabilities and have\nbeen deprecated. Please, use https://www.googleapis.com/auth/sqlservice.admin\nor `sql-admin` to manage your Google SQL Service instances.\n+"),
                            arguments: [
                                (
                                    name: "SCOPE",
                                    description: Some("List"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--service-account",
                            ],
                            description: Some("A service account is an identity attached to the instance. Its access tokens\ncan be accessed through the instance metadata server and are used to\nauthenticate applications on the instance. The account can be set using an\nemail address corresponding to the required service account. \n+\nIf not provided, the instance will use the project's default service account.\n+"),
                            arguments: [
                                (
                                    name: "SERVICE_ACCOUNT",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--service-proxy",
                            ],
                            description: Some("Controls whether the Traffic Director service proxy (Envoy) and agent are installed and configured on the VM.\n\"cloud-platform\" scope is enabled automatically to allow connections to the Traffic Director API.\nDo not use the --no-scopes flag.\n+\n*enabled*::: If specified, the service-proxy software will be installed when the instance is created.\nThe instance is configured to work with Traffic Director.\n+\n*serving-ports*::: Semi-colon-separated (;) list of the ports, specified inside quotation marks (\"), on which the customer's application/workload\nis serving.\n+\nFor example:\n+\n      --serving-ports=\"80;8080\"\n+\nThe service proxy will intercept inbound traffic, then forward it to the specified serving port(s) on localhost.\nIf not provided, no incoming traffic is intercepted.\n+\n*proxy-port*::: The port on which the service proxy listens.\nThe VM intercepts traffic and redirects it to this port to be handled by the service proxy.\nIf omitted, the default value is '15001'.\n+\n*tracing*::: Enables the service proxy to generate distributed tracing information.\nIf set to ON, the service proxy's control plane generates a configuration that enables request ID-based tracing.\nFor more information, refer to the `generate_request_id` documentation\nfor the Envoy proxy. Allowed values are `ON` and `OFF`.\n+\n*access-log*::: The filepath for access logs sent to the service proxy by the control plane.\nAll incoming and outgoing requests are recorded in this file.\nFor more information, refer to the file access log documentation for the Envoy proxy.\n+\n*network*::: The name of a valid VPC network. The Google Cloud Platform VPC network used by the service proxy's control plane\nto generate dynamic configuration for the service proxy"),
                            arguments: [
                                (
                                    name: "SERVICE_PROXY",
                                    description: Some("Dict"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--service-proxy-labels",
                            ],
                            description: Some("Labels that you can apply to your service proxy. These will be reflected in your Envoy proxy's bootstrap metadata.\nThese can be any `key=value` pairs that you want to set as proxy metadata (for example, for use with config filtering).\nYou might use these flags for application and version labels: `app=review` and/or `version=canary`"),
                            arguments: [
                                (
                                    name: "KEY=VALUE, ...",
                                    description: Some("Dict"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--shielded-integrity-monitoring",
                            ],
                            description: Some("Enables monitoring and attestation of the boot integrity of the\ninstance. The attestation is performed against the integrity policy\nbaseline. This baseline is initially derived from the implicitly\ntrusted boot image when the instance is created. This baseline can be\nupdated by using `--shielded-vm-learn-integrity-policy`. On Shielded\nVMs, integrity monitoring is enabled by default. For information about\nhow to modify Shielded VM options, see\nhttps://cloud.google.com/compute/docs/instances/modifying-shielded-vm"),
                        ),
                        (
                            names: [
                                "--shielded-secure-boot",
                            ],
                            description: Some("The instance boots with secure boot enabled. On Shielded VMs, Secure\nBoot is not enabled by default. For information about how to modify\nShielded VM options, see\nhttps://cloud.google.com/compute/docs/instances/modifying-shielded-vm"),
                        ),
                        (
                            names: [
                                "--shielded-vtpm",
                            ],
                            description: Some("The instance boots with the TPM (Trusted Platform Module) enabled.\nA TPM is a hardware module that can be used for different security\noperations such as remote attestation, encryption, and sealing of keys.\nOn Shielded VMs, vTPM is enabled by default. For information about how\nto modify Shielded VM options, see\nhttps://cloud.google.com/compute/docs/instances/modifying-shielded-vm"),
                        ),
                        (
                            names: [
                                "--source-instance",
                            ],
                            description: Some("The name of the source instance that the instance template will be created from.\n+\nYou can override machine type and labels. Values of other flags will be ignored and values from the source instance will be used instead"),
                            arguments: [
                                (
                                    name: "SOURCE_INSTANCE",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--source-instance-zone",
                            ],
                            description: Some("Zone of the instance to operate on. Overrides the default *compute/zone* property value for this command invocation"),
                            arguments: [
                                (
                                    name: "SOURCE_INSTANCE_ZONE",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--subnet",
                            ],
                            description: Some("Specifies the subnet that the instances will be part of. If --network is\nalso specified subnet must be a subnetwork of network specified by\n--network"),
                            arguments: [
                                (
                                    name: "SUBNET",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--tags",
                            ],
                            description: Some("Specifies a list of tags to apply to the instance. These tags allow\nnetwork firewall rules and routes to be applied to specified VM instances.\nSee gcloud_compute_firewall-rules_create(1) for more details.\n+\nTo read more about configuring network tags, read this guide:\nhttps://cloud.google.com/vpc/docs/add-remove-network-tags\n+\nTo list instances with their respective status and tags, run:\n+\n  $ gcloud compute instances list --format='table(name,status,tags.list())'\n+\nTo list instances tagged with a specific tag, `tag1`, run:\n+\n  $ gcloud compute instances list --filter='tags:tag1'"),
                            arguments: [
                                (
                                    name: "TAG",
                                    description: Some("List"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--trace-token",
                            ],
                            description: Some("Token used to route traces of service requests for investigation of issues. Overrides the default *core/trace_token* property value for this command invocation"),
                            arguments: [
                                (
                                    name: "TRACE_TOKEN",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--user-output-enabled",
                            ],
                            description: Some("Print user intended output to the console. Overrides the default *core/user_output_enabled* property value for this command invocation. Use *--no-user-output-enabled* to disable"),
                        ),
                        (
                            names: [
                                "--verbosity",
                            ],
                            description: Some("Override the default verbosity for this command. Overrides the default *core/verbosity* property value for this command invocation. _VERBOSITY_ must be one of: *debug*, *info*, *warning*, *error*, *critical*, *none*"),
                            arguments: [
                                (
                                    name: "VERBOSITY",
                                    description: Some("String"),
                                    suggestions: [
                                        (
                                            name: "debug",
                                        ),
                                        (
                                            name: "info",
                                        ),
                                        (
                                            name: "warning",
                                        ),
                                        (
                                            name: "error",
                                        ),
                                        (
                                            name: "critical",
                                        ),
                                        (
                                            name: "none",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                    ],
                    arguments: [
                        (
                            name: "NAME",
                            description: Some("Name of the instance template to create"),
                        ),
                    ],
                ),
                (
                    name: "create-with-container",
                    description: Some("Creates a Compute Engine a virtual machine instance template that runs     a Docker container"),
                    options: [
                        (
                            names: [
                                "--account",
                            ],
                            description: Some("Google Cloud Platform user account to use for invocation. Overrides the default *core/account* property value for this command invocation"),
                            arguments: [
                                (
                                    name: "ACCOUNT",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--address",
                            ],
                            description: Some("Assigns the given external IP address to the instance that is created.\nThis option can only be used when creating a single instance"),
                            arguments: [
                                (
                                    name: "ADDRESS",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--billing-project",
                            ],
                            description: Some("The Google Cloud Platform project that will be charged quota for operations performed in gcloud. If you need to operate on one project, but need quota against a different project, you can use this flag to specify the billing project. If both `billing/quota_project` and `--billing-project` are specified, `--billing-project` takes precedence. Run `$ gcloud config set --help` to see more information about `billing/quota_project`"),
                            arguments: [
                                (
                                    name: "BILLING_PROJECT",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--boot-disk-auto-delete",
                            ],
                            description: Some("Automatically delete boot disks when their instances are deleted. Enabled by default, use *--no-boot-disk-auto-delete* to disable"),
                        ),
                        (
                            names: [
                                "--boot-disk-device-name",
                            ],
                            description: Some("The name the guest operating system will see for the boot disk.  This\noption can only be specified if a new boot disk is being created (as\nopposed to mounting an existing persistent disk)"),
                            arguments: [
                                (
                                    name: "BOOT_DISK_DEVICE_NAME",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--boot-disk-size",
                            ],
                            description: Some("The size of the boot disk. This option can only be specified if a new\nboot disk is being created (as opposed to mounting an existing\npersistent disk). The value must be a whole number followed by a size\nunit of ``KB'' for kilobyte, ``MB'' for megabyte, ``GB'' for gigabyte,\nor ``TB'' for terabyte. For example, ``10GB'' will produce a 10 gigabyte\ndisk. The minimum size a boot disk can have is 10 GB. Disk size must be a\nmultiple of 1 GB. Limit boot disk size to 2 TB to account for MBR\npartition table limitations. Default size unit is ``GB''"),
                            arguments: [
                                (
                                    name: "BOOT_DISK_SIZE",
                                    description: Some("Googlecloudsdk.calliope.arg_parsers:ParseWithBoundsChecking"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--boot-disk-type",
                            ],
                            description: Some("The type of the boot disk. This option can only be specified if a new boot\ndisk is being created (as opposed to mounting an existing persistent\ndisk). To get a list of available disk types, run\n`$ gcloud compute disk-types list`"),
                            arguments: [
                                (
                                    name: "BOOT_DISK_TYPE",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--can-ip-forward",
                            ],
                            description: Some("If provided, allows the instances to send and receive packets with non-matching destination or source IP addresses"),
                        ),
                        (
                            names: [
                                "--configuration",
                            ],
                            description: Some("The configuration to use for this command invocation. For more\ninformation on how to use configurations, run:\n`gcloud topic configurations`.  You can also use the CLOUDSDK_ACTIVE_CONFIG_NAME environment\nvariable to set the equivalent of this flag for a terminal\nsession"),
                            arguments: [
                                (
                                    name: "CONFIGURATION",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--container-arg",
                            ],
                            description: Some("Argument to append to container entrypoint or to override container CMD.\nEach argument must have a separate flag. Arguments are appended in the\norder of flags. Example:\n+\nAssuming the default entry point of the container (or an entry point\noverridden with --container-command flag) is a Bourne shell-compatible\nexecutable, in order to execute 'ls -l' command in the container,\nthe user could use:\n+\n`--container-arg=\"-c\" --container-arg=\"ls -l\"`\n+\nCaveat: due to the nature of the argument parsing, it's impossible to\nprovide the flag value that starts with a dash (`-`) without the `=` sign\n(that is, `--container-arg \"-c\"` will not work correctly).\n+\nDefault: None. (no arguments appended)"),
                            arguments: [
                                (
                                    name: "CONTAINER_ARG",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--container-command",
                            ],
                            description: Some("Specifies what executable to run when the container starts (overrides\ndefault entrypoint), eg. `nc`.\n+\nDefault: None (default container entrypoint is used)"),
                            arguments: [
                                (
                                    name: "CONTAINER_COMMAND",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--container-env",
                            ],
                            description: Some("Declare environment variables KEY with value VALUE passed to container.\nOnly the last value of KEY is taken when KEY is repeated more than once.\n+\nValues, declared with --container-env flag override those with the same\nKEY from file, provided in --container-env-file"),
                            arguments: [
                                (
                                    name: "KEY=VALUE, ...",
                                    description: Some("Dict"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--container-env-file",
                            ],
                            description: Some("Declare environment variables in a file. Values, declared with\n--container-env flag override those with the same KEY from file.\n+\nFile with environment variables in format used by docker (almost).\nThis means:\n- Lines are in format KEY=VALUE.\n- Values must contain equality signs.\n- Variables without values are not supported (this is different from\n  docker format).\n- If `#` is first non-whitespace character in a line the line is ignored\n  as a comment.\n- Lines with nothing but whitespace are ignored"),
                            arguments: [
                                (
                                    name: "CONTAINER_ENV_FILE",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--container-image",
                            ],
                            description: Some("Full container image name, which should be pulled onto VM instance,\neg. `docker.io/tomcat`"),
                            arguments: [
                                (
                                    name: "CONTAINER_IMAGE",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--container-mount-disk",
                            ],
                            description: Some("Mounts a disk to the specified mount path in the container. Multiple '\nflags are allowed. Must be used with `--disk` or `--create-disk`.\n+\n\n*name*::: Name of the disk. If exactly one additional disk is attached\nto the instance using `--disk` or `--create-disk`, specifying disk\nname here is optional. The name of the single additional disk will be\nused by default.\n+\n\n*mount-path*::: Path on container to mount to. Mount paths with spaces\n      and commas (and other special characters) are not supported by this\n      command.\n+\n*partition*::: Optional. The partition of the disk to mount. Multiple\npartitions of a disk may be mounted. May not be used with --create-disk.\n+\n*mode*::: Volume mount mode: `rw` (read/write) or `ro` (read-only).\nDefaults to `rw`. Fails if the disk mode is `ro` and volume mount mode\nis `rw`"),
                            arguments: [
                                (
                                    name: "CONTAINER_MOUNT_DISK",
                                    description: Some("Dict"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--container-mount-host-path",
                            ],
                            description: Some("Mounts a volume by using host-path.\n+\n*host-path*::: Path on host to mount from.\n+\n*mount-path*::: Path on container to mount to. Mount paths with spaces\nand commas (and other special characters) are not supported by this\ncommand.\n+\n*mode*::: Volume mount mode: rw (read/write) or ro (read-only).\n+\nDefault: rw"),
                            arguments: [
                                (
                                    name: "host-path=HOSTPATH,mount-path=MOUNTPATH[,mode=MODE]",
                                    description: Some("Dict"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--container-mount-tmpfs",
                            ],
                            description: Some("Mounts empty tmpfs into container at MOUNTPATH.\n+\n*mount-path*::: Path on container to mount to. Mount paths with spaces\nand commas (and other special characters) are not supported by this\ncommand"),
                            arguments: [
                                (
                                    name: "mount-path=MOUNTPATH",
                                    description: Some("Dict"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--container-privileged",
                            ],
                            description: Some("Specify whether to run container in privileged mode.\n+\nDefault: `--no-container-privileged`"),
                        ),
                        (
                            names: [
                                "--container-restart-policy",
                            ],
                            description: Some("Specify whether to restart a container on exit. _POLICY_ must be one of: *never*, *on-failure*, *always*"),
                            arguments: [
                                (
                                    name: "POLICY",
                                    description: Some("Googlecloudsdk.command_lib.compute.instances.flags:<lambda>"),
                                    suggestions: [
                                        (
                                            name: "never",
                                        ),
                                        (
                                            name: "on-failure",
                                        ),
                                        (
                                            name: "always",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--container-stdin",
                            ],
                            description: Some("Keep container STDIN open even if not attached.\n+\nDefault: `--no-container-stdin`"),
                        ),
                        (
                            names: [
                                "--container-tty",
                            ],
                            description: Some("Allocate a pseudo-TTY for the container.\n+\nDefault: `--no-container-tty`"),
                        ),
                        (
                            names: [
                                "--create-disk",
                            ],
                            description: Some("Creates and attaches persistent disks to the instances.\n+\n*name*::: Specifies the name of the disk. This option cannot be\nspecified if more than one instance is being created. Must specify this option if attaching the disk to a container with `--container-mount-disk`.\n+\n*description*::: Optional textual description for the disk being created.\n+\n*mode*::: Specifies the mode of the disk. Supported options\nare ``ro'' for read-only and ``rw'' for read-write. If\nomitted, ``rw'' is used as a default. It is an error to create a disk in `ro` mode if attaching it to a container with `--container-mount-disk`.\n+\n*image*::: Specifies the name of the image that the disk will be\ninitialized with. A new disk will be created based on the given\nimage. To view a list of public images and projects, run\n`$ gcloud compute images list`. It is best practice to use image when\na specific version of an image is needed. If both image and image-family\nflags are omitted a blank disk will be created.\n+\n*image-family*::: The image family for the operating system that the boot\ndisk will be initialized with. Compute Engine offers multiple Linux\ndistributions, some of which are available as both regular and\nShielded VM images.  When a family is specified instead of an image,\nthe latest non-deprecated image associated with that family is\nused. It is best practice to use --image-family when the latest\nversion of an image is needed.\n+\n*image-project*::: The Google Cloud project against which all image and\nimage family references will be resolved. It is best practice to define\nimage-project. A full list of available projects can be generated by\nrunning `gcloud projects list`.\n+\n  * If specifying one of our public images, image-project must be\n    provided.\n  * If there are several of the same image-family value in multiple\n    projects, image-project must be specified to clarify the image to be\n    used.\n  * If not specified and either image or image-family is provided, the\n    current default project is used.\n+\n*size*::: The size of the disk. The value must be a whole number\nfollowed by a size unit of ``KB'' for kilobyte, ``MB'' for\nmegabyte, ``GB'' for gigabyte, or ``TB'' for terabyte. For\nexample, ``10GB'' will produce a 10 gigabyte disk. Disk size must\nbe a multiple of 1 GB. If not specified, the default image size\nwill be used for the new disk.\n+\n*type*::: The type of the disk. To get a list of available disk\ntypes, run $ gcloud compute disk-types list. The default disk type\nis ``pd-standard''.\n+\n*device-name*::: An optional name that indicates the disk name the guest operating system will see. Must be the same as `name` if used with `--container-mount-disk`. If omitted, a device name of the form `persistent-disk-N` will be used. If omitted and used with `--container-mount-disk` (where the `name` of the container mount disk is the same as in this flag), a device name equal to disk `name` will be used.\n+\n*auto-delete*::: If ``yes'', this persistent disk will be\nautomatically deleted when the instance is deleted. However,\nif the disk is later detached from the instance, this option\nwon't apply. The default value for this is ``yes''"),
                            arguments: [
                                (
                                    name: "PROPERTY=VALUE",
                                    description: Some("Dict"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--custom-cpu",
                            ],
                            description: Some("A whole number value indicating how many cores are desired in the custom\nmachine type"),
                            arguments: [
                                (
                                    name: "CUSTOM_CPU",
                                    description: Some("String"),
                                ),
                            ],
                            presentation: (
                                priority: Some(100.0),
                            ),
                        ),
                        (
                            names: [
                                "--custom-extensions",
                            ],
                            description: Some("Use the extended custom machine type"),
                        ),
                        (
                            names: [
                                "--custom-memory",
                            ],
                            description: Some("A whole number value indicating how much memory is desired in the custom\nmachine type. A size unit should be provided (eg. 3072MB or 9GB) - if no\nunits are specified, GB is assumed"),
                            arguments: [
                                (
                                    name: "CUSTOM_MEMORY",
                                    description: Some("Googlecloudsdk.calliope.arg_parsers:ParseWithBoundsChecking"),
                                ),
                            ],
                            presentation: (
                                priority: Some(100.0),
                            ),
                        ),
                        (
                            names: [
                                "--custom-vm-type",
                            ],
                            description: Some("Specifies VM type. n1 - VMs with CPU platforms Skylake and older,\nn2 - VMs with CPU platform Cascade Lake. n2 offers flexible sizing from\n2 to 80 vCPUs, and 1 to 640GBs of memory.\nIt also features a number of performance enhancements including exposing\na more accurate NUMA topology to the guest OS. The default is `n1`"),
                            arguments: [
                                (
                                    name: "CUSTOM_VM_TYPE",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--description",
                            ],
                            description: Some("Specifies a textual description for the instance template"),
                            arguments: [
                                (
                                    name: "DESCRIPTION",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--disk",
                            ],
                            description: Some("Attaches persistent disks to the instances. The disks\nspecified must already exist.\n+\n*name*::: The disk to attach to the instances. When creating\nmore than one instance and using this property, the only valid\nmode for attaching the disk is read-only (see *mode* below).\n+\n*mode*::: Specifies the mode of the disk. Supported options\nare ``ro'' for read-only and ``rw'' for read-write. If\nomitted, ``rw'' is used as a default. It is an error for mode\nto be ``rw'' when creating more than one instance because\nread-write disks can only be attached to a single instance.\n+\n*boot*::: If ``yes'', indicates that this is a boot disk. The\nvirtual machines will use the first partition of the disk for\ntheir root file systems. The default value for this is ``no''.\n+\n*device-name*::: An optional name that indicates the disk name the guest operating system will see. Must be the same as `name` if used with `--container-mount-disk`. If omitted, a device name of the form `persistent-disk-N` will be used. If omitted and used with `--container-mount-disk` (where the `name` of the container mount disk is the same as in this flag), a device name equal to disk `name` will be used.\n+\n*auto-delete*::: If ``yes'',  this persistent disk will be\nautomatically deleted when the instance is deleted. However,\nif the disk is later detached from the instance, this option\nwon't apply. The default value for this is ``yes''"),
                            arguments: [
                                (
                                    name: "DISK",
                                    description: Some("Dict"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--flags-file",
                            ],
                            description: Some("A YAML or JSON file that specifies a *--flag*:*value* dictionary.\nUseful for specifying complex flag values with special characters\nthat work with any command interpreter. Additionally, each\n*--flags-file* arg is replaced by its constituent flags. See\n$ gcloud topic flags-file for more information"),
                            arguments: [
                                (
                                    name: "YAML_FILE",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--flatten",
                            ],
                            description: Some("Flatten _name_[] output resource slices in _KEY_ into separate records\nfor each item in each slice. Multiple keys and slices may be specified.\nThis also flattens keys for *--format* and *--filter*. For example,\n*--flatten=abc.def* flattens *abc.def[].ghi* references to\n*abc.def.ghi*. A resource record containing *abc.def[]* with N elements\nwill expand to N records in the flattened output. This flag interacts\nwith other flags that are applied in this order: *--flatten*,\n*--sort-by*, *--filter*, *--limit*"),
                            arguments: [
