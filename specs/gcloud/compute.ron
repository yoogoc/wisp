                                    name: "MAX_CONNECTIONS",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--max-connections-per-endpoint",
                            ],
                            description: Some("Only valid for network endpoint group backends. Defines a maximum\nnumber of connections per endpoint if all endpoints are healthy. When\none or more endpoints are unhealthy, an effective maximum number of\nconnections per healthy endpoint is calculated by multiplying\n`MAX_CONNECTIONS_PER_ENDPOINT` by the number of endpoints in the network\nendpoint group, then dividing by the number of healthy endpoints"),
                            arguments: [
                                (
