                        (
                            names: [
                                "--custom-vm-type",
                            ],
                            description: Some("Specifies VM type. n1 - VMs with CPU platforms Skylake and older,\nn2 - VMs with CPU platform Cascade Lake. n2 offers flexible sizing from\n2 to 80 vCPUs, and 1 to 640GBs of memory.\nIt also features a number of performance enhancements including exposing\na more accurate NUMA topology to the guest OS. The default is `n1`"),
                            arguments: [
                                (
                                    name: "CUSTOM_VM_TYPE",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--description",
                            ],
                            description: Some("Specifies a textual description for the instance template"),
                            arguments: [
                                (
                                    name: "DESCRIPTION",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--disk",
                            ],
                            description: Some("Attaches persistent disks to the instances. The disks\nspecified must already exist.\n+\n*name*::: The disk to attach to the instances. When creating\nmore than one instance and using this property, the only valid\nmode for attaching the disk is read-only (see *mode* below).\n+\n*mode*::: Specifies the mode of the disk. Supported options\nare ``ro'' for read-only and ``rw'' for read-write. If\nomitted, ``rw'' is used as a default. It is an error for mode\nto be ``rw'' when creating more than one instance because\nread-write disks can only be attached to a single instance.\n+\n*boot*::: If ``yes'', indicates that this is a boot disk. The\nvirtual machines will use the first partition of the disk for\ntheir root file systems. The default value for this is ``no''.\n+\n*device-name*::: An optional name that indicates the disk name the guest operating system will see. If omitted, a device name of the form `persistent-disk-N` will be used.\n+\n*auto-delete*::: If ``yes'',  this persistent disk will be\nautomatically deleted when the instance is deleted. However,\nif the disk is later detached from the instance, this option\nwon't apply. The default value for this is ``yes''"),
                            arguments: [
                                (
                                    name: "DISK",
                                    description: Some("Dict"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--flags-file",
                            ],
                            description: Some("A YAML or JSON file that specifies a *--flag*:*value* dictionary.\nUseful for specifying complex flag values with special characters\nthat work with any command interpreter. Additionally, each\n*--flags-file* arg is replaced by its constituent flags. See\n$ gcloud topic flags-file for more information"),
                            arguments: [
                                (
                                    name: "YAML_FILE",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--flatten",
                            ],
                            description: Some("Flatten _name_[] output resource slices in _KEY_ into separate records\nfor each item in each slice. Multiple keys and slices may be specified.\nThis also flattens keys for *--format* and *--filter*. For example,\n*--flatten=abc.def* flattens *abc.def[].ghi* references to\n*abc.def.ghi*. A resource record containing *abc.def[]* with N elements\nwill expand to N records in the flattened output. This flag interacts\nwith other flags that are applied in this order: *--flatten*,\n*--sort-by*, *--filter*, *--limit*"),
                            arguments: [
                                (
                                    name: "KEY",
                                    description: Some("List"),
                                ),
                            ],
