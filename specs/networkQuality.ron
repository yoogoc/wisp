(
    version: 1,
    command: "networkQuality",
    description: Some("Measure the different aspects of network quality"),
    options: [
        (
            names: [
                "-h",
            ],
            description: Some("Show help for networkQuality"),
        ),
        (
            names: [
                "-c",
            ],
            description: Some("Produce computer readable output"),
        ),
        (
            names: [
                "-s",
            ],
            description: Some("Run tests sequentially instead of in parallel"),
        ),
        (
            names: [
                "-v",
            ],
            description: Some("Verbose output"),
        ),
        (
            names: [
                "-C",
            ],
            description: Some("Use a custom configuration URL"),
            arguments: [
                (
                    name: "URL",
                ),
            ],
        ),
        (
            names: [
                "-I",
            ],
            description: Some("Bind test to interface"),
            arguments: [
                (
                    name: "interface",
                    generators: [
                        (
                            script: [
                                "networksetup",
                                "-listallhardwareports",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
    ],
)
