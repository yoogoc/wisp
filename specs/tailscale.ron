(
    version: 1,
    command: "tailscale",
    subcommands: [
        (
            name: "up",
            description: Some("Connect to Tailscale, logging in if needed"),
            options: [
                (
                    names: [
                        "--accept-dns",
                    ],
                    description: Some("Accept DNS configuration from the admin panel"),
                ),
                (
                    names: [
                        "--accept-routes",
                    ],
                    description: Some("Accept routes advertised by other Tailscale nodes"),
                ),
                (
                    names: [
                        "--advertise-exit-node",
                    ],
                    description: Some("Offer to be an exit node for internet traffic for the tailnet"),
                ),
                (
                    names: [
                        "--advertise-routes",
                    ],
                    description: Some("Routes to advertise to other nodes (comma-separated, e.g. \"10.0.0.0/8,192.168.0.0/24\") or empty string to not advertise routes"),
                    arguments: [
                        (
                            name: "routes",
                        ),
                    ],
                ),
                (
                    names: [
                        "--advertise-tags",
                    ],
                    description: Some("Comma-separated ACL tags to request; each must start with \"tag:\" (e.g. \"tag:eng,tag:montreal,tag:ssh\")"),
                    arguments: [
                        (
                            name: "tags",
                        ),
                    ],
                ),
                (
                    names: [
                        "--auth-key",
                    ],
                    description: Some("Node authorization key; if it begins with \"file:\", then it's a path to a file containing the authkey"),
                    arguments: [
                        (
                            name: "authkey",
                        ),
                    ],
                ),
                (
                    names: [
                        "--exit-node",
                    ],
                    description: Some("Tailscale exit node (IP or base name) for internet traffic, or empty string to not use an exit node"),
                    arguments: [
                        (
                            name: "exitnode",
                        ),
                    ],
                ),
                (
                    names: [
                        "--exit-node-allow-lan-access",
                    ],
                    description: Some("Allow direct access to the local network when routing traffic via an exit node"),
                ),
                (
                    names: [
                        "--force-reauth",
                    ],
                    description: Some("Force reauthentication"),
                ),
                (
                    names: [
                        "--host-routes",
                    ],
                    description: Some("Install host routes to other Tailscale nodes"),
                ),
                (
                    names: [
                        "--hostname",
                    ],
                    description: Some("Hostname to use instead of the one provided by the OS"),
                ),
                (
                    names: [
                        "--json",
                    ],
                    description: Some("Output in JSON format"),
                ),
                (
                    names: [
                        "--login-server",
                    ],
                    description: Some("Login server to use"),
                ),
                (
                    names: [
                        "--operator",
                    ],
                    description: Some("Unix username to allow to operate on tailscaled without sudo"),
                    arguments: [
                        (
                            name: "username",
                            suggestions: [
                                (
                                    name: "$USER",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--qr",
                    ],
                    description: Some("Show QR code for login URLs"),
                ),
                (
                    names: [
                        "--reset",
                    ],
                    description: Some("Reset unspecified settings to their default values"),
                ),
                (
                    names: [
                        "--shields-up",
                    ],
                    description: Some("Don't allow incoming connections"),
                ),
                (
                    names: [
                        "--ssh",
                    ],
                    description: Some("Run an SSH server, permitting access per tailnet admin's declared policy"),
                ),
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show help message"),
                ),
            ],
        ),
        (
            name: "down",
            description: Some("Disconnect from Tailscale"),
            options: [
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show help message"),
                ),
            ],
        ),
        (
            name: "logout",
            description: Some("Disconnect from Tailscale and expire current node key"),
            options: [
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show help message"),
                ),
            ],
        ),
        (
            name: "netcheck",
            description: Some("Print an analysis of local network conditions"),
            options: [
                (
                    names: [
                        "--every",
                    ],
                    description: Some("If non-zero, do an incremental report with the given frequency"),
                ),
                (
                    names: [
                        "--format",
                    ],
                    description: Some("Output format"),
                    arguments: [
                        (
                            name: "format",
                            suggestions: [
                                (
                                    name: "json",
                                ),
                                (
                                    name: "json-line",
                                ),
                                (
                                    name: "human-readable",
                                    presentation: (
                                        insert_value: Some("'' "),
                                    ),
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--verbose",
                    ],
                    description: Some("Verbose logs"),
                ),
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show help message"),
                ),
            ],
        ),
        (
            name: "ip",
            description: Some("Show Tailscale IP addresses"),
            options: [
                (
                    names: [
                        "--1",
                    ],
                    description: Some("Only print one IP address"),
                ),
                (
                    names: [
                        "--4",
                    ],
                    description: Some("Only print IPv4 address"),
                ),
                (
                    names: [
                        "--6",
                    ],
                    description: Some("Only print IPv6 address"),
                ),
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show help message"),
                ),
            ],
            arguments: [
                (
                    name: "",
                    generators: [
                        (
                            script: [
                                "tailscale",
                                "status",
                                "--json",
                            ],
                            has_post_process: true,
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "status",
            description: Some("Show state of tailscaled and its connections"),
            options: [
                (
                    names: [
                        "--active",
                    ],
                    description: Some("Filter output to only peers with active sessions"),
                ),
                (
                    names: [
                        "--browser",
                    ],
                    description: Some("Open a browser in web mode"),
                ),
                (
                    names: [
                        "--json",
                    ],
                    description: Some("Output in JSON format"),
                ),
                (
                    names: [
                        "--listen",
                    ],
                    description: Some("Listen address for web mode; use port 0 for automatic (default 127.0.0.1:8384)"),
                    arguments: [
                        (
                            name: "address",
                        ),
                    ],
                ),
                (
                    names: [
                        "--peers",
                    ],
                    description: Some("Show status of peers"),
                ),
                (
                    names: [
                        "--self",
                    ],
                    description: Some("Show status of local machine"),
                ),
                (
                    names: [
                        "--web",
                    ],
                    description: Some("Run webserver with HTML showing status"),
                ),
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show help message"),
                ),
            ],
        ),
        (
            name: "ping",
            description: Some("Ping a host at the Tailscale layer, see how it routed"),
            options: [
                (
                    names: [
                        "--c",
                    ],
                    description: Some("Max number of pings to send"),
                    arguments: [
                        (
                            name: "count",
                        ),
                    ],
                ),
                (
                    names: [
                        "--timeout",
                    ],
                    description: Some("Timeout before giving up on a ping"),
                    arguments: [
                        (
                            name: "timeout",
                        ),
                    ],
                ),
                (
                    names: [
                        "--tsmp",
                    ],
                    description: Some("Do a TSMP-level ping (through IP + wireguard, but not involving host OS stack)"),
                ),
                (
                    names: [
                        "--until-direct",
                    ],
                    description: Some("Stop once a direct path is established"),
                ),
                (
                    names: [
                        "--verbose",
                    ],
                    description: Some("Verbose logs"),
                ),
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show help message"),
                ),
            ],
        ),
        (
            name: "nc",
            description: Some("Connect to a port on a host, connected to stdin/stdout"),
            options: [
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show help message"),
                ),
            ],
            arguments: [
                (
                    name: "hosname-or-ip",
                ),
                (
                    name: "port",
                ),
            ],
        ),
        (
            name: "ssh",
            description: Some("SSH to a Tailscale machine"),
            options: [
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show help message"),
                ),
            ],
            arguments: [
                (
                    name: "[user@]<host>",
                ),
            ],
        ),
        (
            name: "version",
            description: Some("Print Tailscale version"),
            options: [
                (
                    names: [
                        "--daemon",
                    ],
                    description: Some("Also print local node's daemon version"),
                ),
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show help message"),
                ),
            ],
        ),
        (
            name: "web",
            description: Some("Run a web server for controlling Tailscale"),
            options: [
                (
                    names: [
                        "--cgi",
                    ],
                    description: Some("Run as CGI script"),
                ),
                (
                    names: [
                        "--listen",
                    ],
                    description: Some("Listen address; use port 0 for automatic (default localhost:8088)"),
                    arguments: [
                        (
                            name: "address",
                        ),
                    ],
                ),
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show help message"),
                ),
            ],
        ),
        (
            name: "file",
            description: Some("Send or receive files"),
            subcommands: [
                (
                    name: "cp",
                    description: Some("Copy file(s) to a host"),
                    arguments: [
                        (
                            name: "file",
                            template: [
                                FilePaths,
                            ],
                        ),
                        (
                            name: "file or host",
                            generators: [
                                (
                                    script: [
                                        "tailscale",
                                        "status",
                                        "--json",
                                    ],
                                    has_post_process: true,
                                ),
                                (
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                            variadic: true,
                        ),
                    ],
                ),
                (
                    name: "get",
                    description: Some("Move files out of the Tailscale file inbox"),
                    arguments: [
                        (
                            name: "target-directory",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
            ],
            options: [
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show help message"),
                ),
            ],
        ),
        (
            name: "bugreport",
            description: Some("Print a shareable identifier to help diagnose issues"),
            options: [
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show help message"),
                ),
            ],
            arguments: [
                (
                    name: "note",
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "cert",
            description: Some("Get TLS certs"),
            options: [
                (
                    names: [
                        "--cert-file",
                    ],
                    description: Some("Output cert file or \"-\" for stdout"),
                    arguments: [
                        (
                            name: "file",
                            suggestions: [
                                (
                                    name: "-",
                                    description: Some("Stdout"),
                                ),
                            ],
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--key-file",
                    ],
                    description: Some("Output cert file or \"-\" for stdout"),
                    arguments: [
                        (
                            name: "file",
                            suggestions: [
                                (
                                    name: "-",
                                    description: Some("Stdout"),
                                ),
                            ],
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--serve-demo",
                    ],
                    description: Some("Serve on port :443 using the cert as a demo, instead of writing out the files to disk"),
                ),
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show help message"),
                ),
            ],
        ),
        (
            name: "help",
            description: Some("Print help message"),
        ),
    ],
    options: [
        (
            names: [
                "--socket",
            ],
            description: Some("Path to tailscaled's unix socket"),
            arguments: [
                (
                    name: "socket",
                    default: Some("/var/run/tailscaled.socket"),
                ),
            ],
        ),
    ],
)
