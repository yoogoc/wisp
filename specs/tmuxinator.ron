(
    version: 1,
    command: "tmuxinator",
    description: Some("Create and manage tmux sessions easily"),
    subcommands: [
        (
            name: "commands",
            description: Some("Lists commands available in tmuxinator"),
        ),
        (
            name: "completions",
            description: Some("Used for shell completion"),
        ),
        (
            name: "copy",
            description: Some("Copy an existing project to a new project and open it in your editor"),
            arguments: [
                (
                    name: "source",
                    description: Some("The source project name"),
                    generators: [
                        (
                            script: [
                                "tmuxinator",
                                "list",
                                "-n",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
                (
                    name: "target",
                    description: Some("The target project name"),
                    generators: [
                        (
                            script: [
                                "tmuxinator",
                                "list",
                                "-n",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "debug",
            description: Some("Output the shell commands that are generated by tmuxinator"),
            options: [
                (
                    names: [
                        "-a",
                        "--attach",
                    ],
                    description: Some("Attach to tmux session after creation"),
                    arguments: [
                        (
                            name: "attach-session",
                            description: Some("Attach to tmux session"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-n",
                        "--name",
                    ],
                    description: Some("Give the session a different name"),
                    arguments: [
                        (
                            name: "name",
                            description: Some("Give the session a different name"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-p",
                        "--project-config",
                    ],
                    description: Some("Path to project config file"),
                    arguments: [
                        (
                            name: "project-config",
                            description: Some("Path to project config file"),
                            template: [
                                Folders,
                                FilePaths,
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "delete",
            description: Some("Deletes given project"),
            arguments: [
                (
                    name: "project",
                    description: Some("The project name"),
                    generators: [
                        (
                            script: [
                                "tmuxinator",
                                "list",
                                "-n",
                            ],
                            has_post_process: true,
                        ),
                    ],
                    variadic: true,
                ),
            ],
        ),
        (
            name: "doctor",
            description: Some("Look for problems in your configuration"),
        ),
        (
            name: "help",
            description: Some("Describe available commands or one specific command"),
            arguments: [
                (
                    name: "command",
                    description: Some("The tmuxinator commands"),
                    template: [
                        Help,
                    ],
                ),
            ],
        ),
        (
            name: "implode",
            description: Some("Deletes all tmuxinator projects"),
        ),
        (
            name: "list",
            description: Some("Lists all tmuxinator projects"),
            options: [
                (
                    names: [
                        "-n",
                        "--newline",
                    ],
                    description: Some("Force output to be one entry per line"),
                ),
            ],
        ),
        (
            name: "local",
            description: Some("Start a tmux session using ./.tmuxinator.y[a]ml"),
            options: [
                (
                    names: [
                        "--suppress-tmux-version-warning",
                    ],
                    description: Some("Don't show a warning for unsupported tmux versions"),
                ),
            ],
        ),
        (
            name: "new",
            description: Some("Create a new project file and open it in your editor"),
            options: [
                (
                    names: [
                        "-l",
                    ],
                    description: Some("Create local project file at ./.tmuxinator.y[a]ml"),
                ),
            ],
            arguments: [
                (
                    name: "project",
                    description: Some("The project name"),
                ),
                (
                    name: "tmux-session",
                    description: Some("The tmux session name"),
                    generators: [
                        (
                            script: [
                                "tmux",
                                "ls",
                            ],
                            has_post_process: true,
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "edit",
            description: Some("Open a project file it in your editor"),
            options: [
                (
                    names: [
                        "-l",
                    ],
                    description: Some("Open local project file at ./.tmuxinator.y[a]ml"),
                ),
            ],
            arguments: [
                (
                    name: "project",
                    description: Some("The project name"),
                    generators: [
                        (
                            script: [
                                "tmuxinator",
                                "list",
                                "-n",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "open",
            description: Some("Open a project file it in your editor"),
            options: [
                (
                    names: [
                        "-l",
                    ],
                    description: Some("Open local project file at ./.tmuxinator.y[a]ml"),
                ),
            ],
            arguments: [
                (
                    name: "project",
                    description: Some("The project name"),
                    generators: [
                        (
                            script: [
                                "tmuxinator",
                                "list",
                                "-n",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "start",
            description: Some("Start a tmux session using a project's name (with an optional [ALIAS] for project reuse) or a path to a project config file (via the -p flag)"),
            arguments: [
                (
                    name: "project",
                    description: Some("The project name"),
                    generators: [
                        (
                            script: [
                                "tmuxinator",
                                "list",
                                "-n",
                            ],
                            has_post_process: true,
                        ),
                    ],
                    load_spec_inline: Some((
                        name: "project",
                        options: [
                            (
                                names: [
                                    "-a",
                                    "--attach",
                                ],
                                description: Some("Attach to tmux session after creation"),
                                arguments: [
                                    (
                                        name: "attach-session",
                                        description: Some("Attach to tmux session"),
                                    ),
                                ],
                            ),
                            (
                                names: [
                                    "-n",
                                    "--name",
                                ],
                                description: Some("Give the session a different name"),
                                arguments: [
                                    (
                                        name: "name",
                                        description: Some("Give the session a different name"),
                                    ),
                                ],
                            ),
                            (
                                names: [
                                    "-p",
                                    "--project-config",
                                ],
                                description: Some("Path to project config file"),
                                arguments: [
                                    (
                                        name: "project-config",
                                        description: Some("Path to project config file"),
                                        template: [
                                            Folders,
                                            FilePaths,
                                        ],
                                    ),
                                ],
                            ),
                            (
                                names: [
                                    "--suppress-tmux-version-warning",
                                ],
                                description: Some("Don't show a warning for unsupported tmux versions"),
                            ),
                        ],
                    )),
                ),
            ],
        ),
        (
            name: "stop",
            description: Some("Stop a tmux session using a project's tmuxinator config"),
            arguments: [
                (
                    name: "project",
                    description: Some("The project name"),
                    generators: [
                        (
                            script: [
                                "tmuxinator",
                                "list",
                                "-n",
                            ],
                            has_post_process: true,
                        ),
                    ],
                    load_spec_inline: Some((
                        name: "project",
                        options: [
                            (
                                names: [
                                    "--suppress-tmux-version-warning",
                                ],
                                description: Some("Don't show a warning for unsupported tmux versions"),
                            ),
                        ],
                    )),
                ),
            ],
        ),
        (
            name: "version",
            description: Some("Display installed tmuxinator version"),
        ),
    ],
)
