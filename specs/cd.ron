(
    version: 1,
    command: "cd",
    description: Some("Change the shell working directory"),
    arguments: [
        (
            name: "",
            suggestions: [
                (
                    name: "-",
                    description: Some("Switch to the last used folder"),
                    presentation: (
                        hidden: true,
                    ),
                ),
                (
                    name: "~",
                    description: Some("Switch to the home directory"),
                    presentation: (
                        hidden: true,
                    ),
                ),
            ],
            generators: [
                (
                    has_custom: true,
                    has_dynamic_trigger: true,
                    has_dynamic_query_term: true,
                ),
            ],
            filter_strategy: Fuzzy,
        ),
    ],
)
