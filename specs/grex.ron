(
    version: 1,
    command: "grex",
    description: Some("Command-line tool for generating regular expressions from user-provided test cases"),
    options: [
        (
            names: [
                "-d",
                "--digits",
            ],
            description: Some("Converts any Unicode decimal digit to \\d"),
        ),
        (
            names: [
                "-D",
                "--non-digits",
            ],
            description: Some("Converts any character which is not a Unicode decimal digit to \\D"),
        ),
        (
            names: [
                "-s",
                "--spaces",
            ],
            description: Some("Converts any Unicode whitespace character to \\s"),
        ),
        (
            names: [
                "-S",
                "--non-spaces",
            ],
            description: Some("Converts any character which is not a Unicode whitespace character to \\S"),
        ),
        (
            names: [
                "-w",
                "--words",
            ],
            description: Some("Converts any Unicode word character to \\w"),
        ),
        (
            names: [
                "-W",
                "--non-words",
            ],
            description: Some("Converts any character which is not a Unicode word character to \\W"),
        ),
        (
            names: [
                "-r",
                "--repetitions",
            ],
            description: Some("Detects repeated non-overlapping substrings and converts them to {min,max} quantifier notation"),
        ),
        (
            names: [
                "-e",
                "--escape",
            ],
            description: Some("Replaces all non-ASCII characters with unicode escape sequences"),
        ),
        (
            names: [
                "--with-surrogates",
            ],
            description: Some("Converts astral code points to surrogate pairs if --escape is set"),
        ),
        (
            names: [
                "-i",
                "--ignore-case",
            ],
            description: Some("Performs case-insensitive matching, letters match both upper and lower case"),
        ),
        (
            names: [
                "-g",
                "--capture-groups",
            ],
            description: Some("Replaces non-capturing groups by capturing ones"),
        ),
        (
            names: [
                "-c",
                "--colorize",
            ],
            description: Some("Provides syntax highlighting for the resulting regular expression"),
        ),
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Prints help information"),
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Prints version information"),
        ),
        (
            names: [
                "-f",
                "--file",
            ],
            description: Some("Reads test cases on separate lines from a file"),
            arguments: [
                (
                    name: "",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
