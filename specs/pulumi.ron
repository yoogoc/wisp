(
    version: 1,
    command: "pulumi",
    description: Some("Pulumi's open source infrastructure as code SDK enables you to create, deploy, and manage infrastructure on any cloud, using your favorite languages"),
    subcommands: [
        (
            name: "about",
            description: Some("Print information about the Pulumi environment"),
            options: [
                (
                    names: [
                        "--color",
                    ],
                    description: Some("Colorize output. Choices are: always, never, raw, auto (default \"auto\")"),
                    arguments: [
                        (
                            name: "mode",
                            suggestions: [
                                (
                                    name: "always",
                                ),
                                (
                                    name: "never",
                                ),
                                (
                                    name: "raw",
                                ),
                                (
                                    name: "auto",
                                ),
                            ],
                            default: Some("auto"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-C",
                        "--cwd",
                    ],
                    description: Some("Run pulumi as if it had been started in another directory"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--disable-integrity-checking",
                    ],
                    description: Some("Disable integrity checking of checkpoint files"),
                ),
                (
                    names: [
                        "-e",
                        "--emoji",
                    ],
                    description: Some("Enable emojis in the output"),
                ),
                (
                    names: [
                        "--logflow",
                    ],
                    description: Some("Flow log settings to child processes (like plugins)"),
                ),
                (
                    names: [
                        "--logtostderr",
                    ],
                    description: Some("Log to stderr instead of to files"),
                ),
                (
                    names: [
                        "--non-interactive",
                    ],
                    description: Some("Disable interactive mode for all commands"),
                ),
                (
                    names: [
                        "--profiling",
                    ],
                    description: Some("Emit CPU and memory profiles and an execution trace to '[filename].[pid].{cpu,mem,trace}', respectively"),
                ),
                (
                    names: [
                        "--tracing",
                    ],
                    description: Some("Emit tracing to the specified endpoint. Use the file: scheme to write tracing data to a local file"),
                    arguments: [
                        (
                            name: "file",
                        ),
                    ],
                ),
                (
                    names: [
