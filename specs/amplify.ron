                ),
            ],
            options: [
                (
                    names: [
                        "-y",
                    ],
                    description: Some("Answer all question as 'Yes'"),
                ),
            ],
        ),
        (
            name: "pull",
            description: Some("Fetch upstream backend environment definition changes from the cloud and updates the local environment to match that definition"),
        ),
        (
            name: "publish",
            description: Some("Executes amplify push, and then builds and publishes client-side application for hosting"),
        ),
        (
            name: "serve",
            description: Some("Executes amplify push, and then executes the project's start command to test run the client-side application locally"),
        ),
