(
    version: 1,
    command: "aliases",
    description: Some("Bash aliases on steroids, dynamic alias functions for bash"),
    subcommands: [
        (
            name: "add",
            description: Some("Add an alias via the cli"),
            arguments: [
                (
                    name: "name",
                    description: Some("The name of the alias"),
                ),
                (
                    name: "command",
                    description: Some("The command you want to run"),
                ),
            ],
        ),
        (
            name: "clone",
            description: Some("Clone external aliases"),
            options: [
                (
                    names: [
                        "-E",
                        "--enable",
                    ],
                    description: Some("Whether to enable the user if they are not currently enabled"),
                ),
            ],
            arguments: [
                (
                    name: "username",
                    description: Some("The username of the aliases you want to clone"),
                ),
                (
                    name: "repo_url",
                    description: Some("The git repo url of the aliases (defaults to github/<username>/dot-aliases)"),
                ),
            ],
        ),
        (
            name: "directories",
            description: Some("List all directories initialized with aliases"),
        ),
        (
            name: "exec",
            description: Some("Execute an alias for a given directory"),
            arguments: [
                (
                    name: "directory",
                    description: Some("Directory where the alias is defined"),
                    template: [
                        Folders,
                    ],
                ),
                (
                    name: "name",
                    description: Some("Name of alias"),
                    variadic: true,
                ),
            ],
        ),
        (
            name: "help",
            description: Some("Prints help information"),
        ),
        (
            name: "init",
            description: Some("Initialize a directory for aliases"),
            options: [
                (
                    names: [
                        "-g",
                        "--global",
                    ],
                    description: Some("Returns the global initialization for the app"),
                ),
                (
                    names: [
                        "-u",
                        "--user",
                    ],
                    description: Some("Initialize aliases for a specific user"),
                    arguments: [
                        (
                            name: "user",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "list",
            description: Some("List the aliases available"),
            options: [
                (
                    names: [
                        "-g",
                        "--global",
                    ],
                    description: Some("List only global aliases"),
                ),
                (
                    names: [
                        "-l",
                        "--local",
                    ],
                    description: Some("List only local aliases"),
                ),
                (
                    names: [
                        "-d",
                        "--directory",
                    ],
                    description: Some("List aliases for a specific directory"),
                    arguments: [
                        (
                            name: "directory",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "name",
                    ],
                    description: Some("List aliases for with a specific name"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "pull",
            description: Some("Pull a cloned user's aliases"),
            arguments: [
                (
                    name: "username",
                    description: Some("The username of the aliases you want to pull, leave blank to pull all user aliases"),
                ),
            ],
        ),
        (
            name: "rehash",
            description: Some("Update the aliases"),
        ),
        (
            name: "remove",
            description: Some("Remove an alias via the cli"),
            arguments: [
                (
                    name: "name",
                    description: Some("The name of the alias"),
                ),
            ],
        ),
        (
            name: "users",
            description: Some("List the users"),
            subcommands: [
                (
                    name: "disable",
                    description: Some("Disable a user's aliases"),
                    arguments: [
                        (
                            name: "username",
                        ),
                    ],
                ),
                (
                    name: "enable",
                    description: Some("Enable a user's aliases"),
                    arguments: [
                        (
                            name: "username",
                        ),
                    ],
                ),
                (
                    name: "help",
                    description: Some("Prints this message or the help of the given subcommand(s)"),
                ),
                (
                    name: "move",
                    description: Some("Move a user up or down the prioritization list"),
                    arguments: [
                        (
                            name: "username",
                        ),
                        (
                            name: "prioritization",
                        ),
                    ],
                ),
                (
                    name: "use",
                    description: Some("Assign a user to the top of the priority list"),
                    arguments: [
                        (
                            name: "username",
                        ),
                    ],
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Prints help information"),
            persistent: true,
        ),
        (
            names: [
                "--version",
                "-V",
            ],
            description: Some("Prints version information"),
            persistent: true,
        ),
    ],
)
