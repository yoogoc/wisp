(
    version: 1,
    command: "turbo",
    description: Some("Turborepo is a high-performance build system for JavaScript and TypeScript codebases"),
    subcommands: [
        (
            name: "bin",
            description: Some("Get the path to the turbo binary"),
        ),
        (
            name: "link",
            description: Some("Link your local directory to a Vercel organization and enable remote caching"),
            options: [
                (
                    names: [
                        "--no-gitignore",
                    ],
                    description: Some("Do not create or modify .gitignore"),
                ),
            ],
        ),
        (
            name: "login",
            description: Some("Login to your Vercel account"),
            options: [
                (
                    names: [
                        "--sso-team",
                    ],
                    description: Some("Attempt to authenticate to the specified team using SSO"),
                    requires_separator: Some("="),
                ),
            ],
        ),
        (
            name: "logout",
            description: Some("Logout of your Vercel account"),
        ),
        (
            name: "prune",
            description: Some("Prepare a subset of your monorepo"),
            options: [
                (
                    names: [
                        "--scope",
                    ],
                    description: Some("Specify package to act as entry point for pruned monorepo"),
                    arguments: [
                        (
                            name: "package",
                        ),
                    ],
                    required: true,
                    requires_separator: Some("="),
                ),
                (
                    names: [
                        "--docker",
                    ],
                    description: Some("Output pruned workspace into 'fill' and 'json' directories optimized for Docker layer caching"),
                ),
            ],
        ),
        (
            name: "unlink",
            description: Some("Unlink the current directory from your Vercel organization and disable remote caching"),
        ),
        (
            name: "run",
            description: Some("Run tasks in your monorepo"),
            options: [
                (
                    names: [
                        "--scope",
                    ],
                    description: Some("Specify packages to act as entry points for task execution"),
                    arguments: [
                        (
                            name: "package",
                        ),
                    ],
                    requires_separator: Some("="),
                ),
                (
                    names: [
                        "--cache-dir",
                    ],
                    description: Some("Specify local filesystem cache directory"),
                    arguments: [
                        (
                            name: "dir",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                    requires_separator: Some("="),
                ),
                (
                    names: [
                        "--concurrency",
                    ],
                    description: Some("Limit the concurrency of task execution (use `1` for serial)"),
                    arguments: [
                        (
                            name: "limit",
                        ),
                    ],
                    requires_separator: Some("="),
                ),
                (
                    names: [
                        "--continue",
                    ],
                    description: Some("Continue execution even if a task exits with an error"),
                ),
                (
                    names: [
                        "--force",
                    ],
                    description: Some("Ignore the existing cache"),
                ),
                (
                    names: [
                        "--graph",
                    ],
                    description: Some("Generate a Dot graph of the task execution"),
                ),
                (
                    names: [
                        "--global-deps",
                    ],
                    description: Some("Specify glob of global filesystem dependencies to be hashed (useful for .env and files in the root directory)"),
                    arguments: [
                        (
                            name: "glob",
                        ),
                    ],
                    repeat: Many,
                    requires_separator: Some("="),
                    presentation: (
                        insert_value: Some("--global-deps='{cursor}'"),
                    ),
                ),
                (
                    names: [
                        "--since",
                    ],
                    description: Some("Limit/set scope to changed packages since a mergebase"),
                    arguments: [
                        (
                            name: "branch",
                            generators: [
                                (
                                    script: [
                                        "git",
                                        "--no-optional-locks",
                                        "branch",
                                        "-a",
                                        "--no-color",
                                        "--sort=-committerdate",
                                    ],
                                    has_post_process: true,
                                ),
                            ],
                        ),
                    ],
                    requires_separator: Some("="),
                ),
                (
                    names: [
                        "--team",
                    ],
                    description: Some("The slug of a turborepo.com team"),
                    arguments: [
                        (
                            name: "slug",
                        ),
                    ],
                    requires_separator: Some("="),
                ),
                (
                    names: [
                        "--token",
                    ],
                    description: Some("A turborepo.com access token"),
                    arguments: [
                        (
                            name: "token",
                        ),
                    ],
                    requires_separator: Some("="),
                ),
                (
                    names: [
                        "--ignore",
                    ],
                    description: Some("Files to ignore when calculating changed files (supports globs)"),
                    arguments: [
                        (
                            name: "files",
                        ),
                    ],
                    requires_separator: Some("="),
                ),
                (
                    names: [
                        "--profile",
                    ],
                    description: Some("File to write turbo's performance profile into"),
                    arguments: [
                        (
                            name: "file",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                    requires_separator: Some("="),
                ),
                (
                    names: [
                        "--parallel",
                    ],
                    description: Some("Execute all tasks in parallel"),
                ),
                (
                    names: [
                        "--include-dependencies",
                    ],
                    description: Some("Include the dependencies of tasks in execution"),
                ),
                (
                    names: [
                        "--no-deps",
                    ],
                    description: Some("Exclude dependent task consumers from execution"),
                ),
                (
                    names: [
                        "--no-cache",
                    ],
                    description: Some("Avoid saving task results to the cache (useful for development/watch tasks)"),
                ),
                (
                    names: [
                        "--output-logs",
                    ],
                    arguments: [
                        (
                            name: "level",
                            suggestions: [
                                (
                                    name: "new-only",
                                    description: Some("Only new output with hashes for cached tasks"),
                                ),
                                (
                                    name: "hash-only",
                                    description: Some("Only turbo-computed task hashes"),
                                ),
                                (
                                    name: "full",
                                    description: Some("Show all output"),
                                ),
                                (
                                    name: "none",
                                    description: Some("Hide process output"),
                                ),
                            ],
                        ),
                    ],
                    requires_separator: Some("="),
                ),
                (
                    names: [
                        "--dry",
                        "--dry-run",
                    ],
                    description: Some("List the packages in scope and the tasks that would be run"),
                    arguments: [
                        (
                            name: "format",
                            suggestions: [
                                (
                                    name: "json",
                                ),
                            ],
                            optional: true,
                        ),
                    ],
                    requires_separator: Some("="),
                ),
            ],
            arguments: [
                (
                    name: "tasks",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "until [[ ( -f turbo.json || $PWD = '/' ) ]]; do cd ..; done; cat turbo.json",
                            ],
                            has_post_process: true,
                        ),
                    ],
                    variadic: true,
                ),
            ],
            presentation: (
                icon: Some("data:image/png;base64,"),
            ),
        ),
    ],
    options: [
        (
            names: [
                "--version",
            ],
            description: Some("Print the version"),
        ),
        (
            names: [
                "--help",
            ],
            description: Some("Print a help message"),
            persistent: true,
        ),
    ],
)
