(
    version: 1,
    command: "ganache-cli",
    description: Some("Fast Ethereum RPC client"),
    subcommands: [
        (
            name: "forkCacheSize",
            description: Some("The maximum size, in bytes, of the in-memory cache for queries on a chain fork. Defaults to 1_073_741_824 bytes (1 gigabyte)"),
            arguments: [
                (
                    name: "number",
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "-a",
                "--accounts",
            ],
            description: Some("Specify the number of accounts to generate at startup"),
            arguments: [
                (
                    name: "number",
                ),
            ],
        ),
        (
            names: [
                "-e",
                "--defaultBalanceEther",
            ],
            description: Some("Amount of ether to assign each test account. Default is 100"),
            arguments: [
                (
                    name: "number",
                    default: Some("100"),
                ),
            ],
        ),
        (
            names: [
                "-b",
                "--blockTime",
            ],
            description: Some("Specify blockTime in seconds for automatic mining. If you don't specify this flag, ganache will instantly mine a new block for every transaction"),
            arguments: [
                (
                    name: "seconds",
                ),
            ],
        ),
        (
            names: [
                "-d",
                "--deterministic",
            ],
            description: Some("Generate deterministic addresses based on a pre-defined mnemonic"),
        ),
        (
            names: [
                "-n",
                "--secure",
            ],
            description: Some("Lock available accounts by default (good for third party transaction signing)"),
        ),
        (
            names: [
                "-m",
                "--mnemonic",
            ],
            description: Some("Use a bip39 mnemonic phrase for generating a PRNG seed, which is in turn used for hierarchical deterministic (HD) account generation"),
        ),
        (
            names: [
                "-p",
                "--port",
            ],
            description: Some("Port number to listen on. Defaults to 8545"),
            arguments: [
                (
                    name: "port number",
                ),
            ],
        ),
        (
            names: [
                "-h",
                "--host",
            ],
            description: Some("Hostname to listen on. Defaults to 127.0.0.1 (defaults to 0.0.0.0 for Docker instances of ganache-cli)"),
            arguments: [
                (
                    name: "Hostname",
                ),
            ],
        ),
        (
            names: [
                "-s",
                "--seed",
            ],
            description: Some("Use arbitrary data to generate the HD wallet mnemonic to be used"),
        ),
        (
            names: [
                "-g",
                "--gasPrice",
            ],
            description: Some("The price of gas in wei (defaults to 20000000000)"),
            arguments: [
                (
                    name: "price",
                ),
            ],
        ),
        (
            names: [
                "-l",
                "--gasLimit",
            ],
            description: Some("The block gas limit (defaults to 0x6691b7)"),
            arguments: [
                (
                    name: "limit",
                ),
            ],
        ),
        (
            names: [
                "--callGasLimit",
            ],
            description: Some("Sets the transaction gas limit for eth_call and eth_estimateGas calls"),
            arguments: [
                (
                    name: "limit",
                ),
            ],
        ),
        (
            names: [
                "-k",
                "--hardfork",
            ],
            description: Some("Allows users to specify which hardfork should be used"),
            arguments: [
                (
                    name: "hardfork",
                    suggestions: [
                        (
                            name: "byzantium",
                        ),
                        (
                            name: "constantinople",
                        ),
                        (
                            name: "petersburg",
                        ),
                        (
                            name: "istanbul",
                        ),
                        (
                            name: "muirGlacier",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-f",
                "--fork",
            ],
            description: Some("Fork from another currently running Ethereum client at a given block. Input should be the HTTP location and port of the other client"),
            arguments: [
                (
                    name: "HTTP location & port",
                ),
            ],
        ),
        (
            names: [
                "-i",
                "--networkId",
            ],
            description: Some("Specify the network id ganache-cli will use to identify itself (defaults to the current time or the network id of the forked blockchain if configured)"),
            arguments: [
                (
                    name: "Network ID",
                ),
            ],
        ),
        (
            names: [
                "--chainId",
            ],
            description: Some("Specify the Chain ID ganache-cli will use for eth_chainId RPC and the CHAINID opcode"),
            arguments: [
                (
                    name: "Chain ID",
                ),
            ],
        ),
        (
            names: [
                "--db",
            ],
            description: Some("Specify a path to a directory to save the chain database. If a database already exists, ganache-cli will initialize that chain instead of creating a new one"),
            arguments: [
                (
                    name: "folder",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--debug",
            ],
            description: Some("Output VM opcodes for debugging"),
        ),
        (
            names: [
                "--mem",
            ],
            description: Some("Output ganache-cli memory usage statistics. This replaces normal output"),
        ),
        (
            names: [
                "-q",
                "--quiet",
            ],
            description: Some("Run ganache-cli without any logs"),
        ),
        (
            names: [
                "-?",
                "--help",
            ],
            description: Some("Display help information"),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Display the version of ganache-cli"),
        ),
        (
            names: [
                "--account_keys_path",
                "--acctKeys",
            ],
            description: Some("Specifies a file to save accounts and private keys to, for testing"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--noVMErrorsOnRPCResponse",
            ],
            description: Some("Do not transmit transaction failures as RPC errors"),
        ),
        (
            names: [
                "--allowUnlimitedContractSize",
            ],
            description: Some("Allows unlimited contract sizes while debugging"),
        ),
        (
            names: [
                "--keepAliveTimeout",
            ],
            description: Some("Sets the HTTP server's keepAliveTimeout in milliseconds"),
            arguments: [
                (
                    name: "timeout",
                ),
            ],
        ),
        (
            names: [
                "-t",
                "--time",
            ],
            description: Some("Date (ISO 8601) that the first block should start"),
            arguments: [
                (
                    name: "date",
                ),
            ],
        ),
        (
            names: [
                "--account",
            ],
            description: Some("Specify any number of times passing arbitrary private keys and their associated balances to generate initial addresses"),
            arguments: [
                (
                    name: "<privatekey>, balance",
                    variadic: true,
                ),
            ],
        ),
        (
            names: [
                "-u",
                "--unlock",
            ],
            description: Some("Specify any number of times passing either an address or an account index to unlock specific accounts"),
            arguments: [
                (
                    name: "address or account index",
                    variadic: true,
                ),
            ],
        ),
    ],
)
