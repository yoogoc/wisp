(
    version: 1,
    command: "adr",
    description: Some("Manage Architectural Design Records"),
    subcommands: [
        (
            name: "init",
            description: Some("Create an ADR directory in the root of your project, example usage: ' adr init doc/architecture/decisions'"),
            arguments: [
                (
                    name: "Location where to create the ADR, example 'adr init doc/architecture/decisions'",
                ),
            ],
        ),
        (
            name: "new",
            description: Some("Create a new, numbered ADR file"),
            options: [
                (
                    names: [
                        "-s",
                    ],
                    description: Some("Create a new ADR that supercedes a previous one (ADR 9, for example), use the -s option"),
                    arguments: [
                        (
                            name: "number",
                            description: Some("Which ADR to supercede"),
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "ADR name",
                    description: Some("Name for the ADR separated with '-'"),
                ),
            ],
        ),
        (
            name: "help",
            description: Some("Built in help"),
        ),
    ],
)
