(
    version: 1,
    command: "elixir",
    description: Some("Elixir Language"),
    options: [
        (
            names: [
                "-e",
                "--eval",
            ],
            description: Some("Evaluates the given command"),
            arguments: [
                (
                    name: "EXPRESSION",
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Prints this message and exits"),
        ),
        (
            names: [
                "-r",
            ],
            description: Some("Requires the given files/patterns"),
            arguments: [
                (
                    name: "FILE",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-S",
            ],
            description: Some("Finds and executes the given script in $PATH"),
            arguments: [
                (
                    name: "SCRIPT",
                ),
            ],
        ),
        (
            names: [
                "-pr",
            ],
            description: Some("Requires the given files/patterns in parallel"),
            arguments: [
                (
                    name: "FILE",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "-pa",
            ],
            description: Some("Prepends the given path to Erlang code path"),
            arguments: [
                (
                    name: "PATH",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "-pz",
            ],
            description: Some("Appends the given path to Erlang code path"),
            arguments: [
                (
                    name: "PATH",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Prints Elixir version and exits"),
        ),
        (
            names: [
                "--app",
            ],
            description: Some("Starts the given app and its dependencies"),
            arguments: [
                (
                    name: "APP",
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "--erl",
            ],
            description: Some("Switches to be passed down to Erlang"),
            arguments: [
                (
                    name: "SWITCHES",
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "--logger-otp-reports",
            ],
            description: Some("Enables or disables OTP reporting"),
            arguments: [
                (
                    name: "BOOL",
                ),
            ],
        ),
        (
            names: [
                "--logger-sasl-reports",
            ],
            description: Some("Enables or disables SASL reporting"),
            arguments: [
                (
                    name: "BOOL",
                ),
            ],
        ),
        (
            names: [
                "--no-halt",
            ],
            description: Some("Does not halt the Erlang VM after execution"),
        ),
        (
            names: [
                "--werl",
            ],
            description: Some("Uses Erlang's Windows shell GUI (Windows only)"),
        ),
        (
            names: [
                "--cookie",
            ],
            description: Some("Sets a cookie for this distributed node"),
            arguments: [
                (
                    name: "COOKIE",
                ),
            ],
        ),
        (
            names: [
                "--hidden",
            ],
            description: Some("Makes a hidden node"),
        ),
        (
            names: [
                "--name",
            ],
            description: Some("Makes and assigns a name to the distributed node"),
            arguments: [
                (
                    name: "NAME",
                ),
            ],
        ),
        (
            names: [
                "--rpc-eval",
            ],
            description: Some("Evaluates the given command on the given remote node"),
            arguments: [
                (
                    name: "NODE",
                ),
                (
                    name: "COMMAND",
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "--sname",
            ],
            description: Some("Makes and assigns a short name to the distributed node"),
            arguments: [
                (
                    name: "NAME",
                ),
            ],
        ),
        (
            names: [
                "--boot",
            ],
            description: Some("Uses the given FILE.boot to start the system"),
            arguments: [
                (
                    name: "FILE",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--boot-var",
            ],
            description: Some("Makes $VAR available as VALUE to FILE.boot"),
            arguments: [
                (
                    name: "VAR",
                ),
                (
                    name: "VALUE",
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "--erl-config",
            ],
            description: Some("Loads configuration in FILE.config written in Erlang"),
            arguments: [
                (
                    name: "FILE",
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "--pipe-to",
            ],
            description: Some("Starts the Erlang VM as a named PIPEDIR and LOGDIR"),
            arguments: [
                (
                    name: "PIPEDIR",
                ),
                (
                    name: "LOGDIR",
                ),
            ],
        ),
        (
            names: [
                "--vm-args",
            ],
            description: Some("Passes the contents in file as arguments to the VM"),
            arguments: [
                (
                    name: "FILE",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "file",
            description: Some(".exs file"),
            generators: [
                (
                    has_custom: true,
                    has_dynamic_trigger: true,
                    has_dynamic_query_term: true,
                ),
            ],
        ),
        (
            name: "data",
            optional: true,
        ),
    ],
)
