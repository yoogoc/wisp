(
    version: 1,
    command: "arduino-cli",
    description: Some("Arduino Command Line Interface"),
    subcommands: [
        (
            name: "board",
            description: Some("Arduino board commands"),
            subcommands: [
                (
                    name: "attach",
                    description: Some("Sets the default values for port and FQBN. If no port or FQBN are specified, the current default port and FQBN are displayed"),
                    options: [
                        (
                            names: [
                                "--board-options",
                            ],
                            description: Some("List of board options separated by commas. Or can be used multiple times for multiple options"),
                            arguments: [
                                (
                                    name: "",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--discovery-timeout",
                            ],
                            description: Some("Max time to wait for port discovery, example: '30s, 1m (default 1s)'"),
                            arguments: [
                                (
                                    name: "duration",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-b",
                                "--fqbn",
                            ],
                            description: Some("Fully Qualified Board Name, example: 'arduino:avr:uno'"),
                            arguments: [
                                (
                                    name: "FQBN",
                                    description: Some("Fully qualified board name"),
                                    generators: [
                                        (
                                            script: [
                                                "arduino-cli",
                                                "board",
                                                "list",
                                                "--format",
                                                "json",
                                            ],
                                            has_post_process: true,
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-h",
                                "--help",
                            ],
                            description: Some("Help for attach"),
                        ),
                        (
                            names: [
                                "-p",
                                "--port",
                            ],
                            description: Some("Upload port address, example: 'COM3 or /dev/ttyACM2'"),
                            arguments: [
                                (
                                    name: "port",
