(
    version: 1,
    command: "mackup",
    description: Some("Mackup"),
    subcommands: [
        (
            name: "list",
            description: Some("List all the supported mackup applications"),
        ),
        (
            name: "backup",
            description: Some("Sync your conf files to your synced storage"),
        ),
        (
            name: "restore",
            description: Some("Link the conf files already in your synced storage on your system"),
        ),
        (
            name: "show",
            description: Some("Show the current configuration"),
            arguments: [
                (
                    name: "application",
                    generators: [
                        (
                            script: [
                                "mackup",
                                "list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "uninstall",
            description: Some("Reset everything as it was before using Mackup"),
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help"),
        ),
        (
            names: [
                "--force",
                "-f",
            ],
            description: Some("Force every question asked to be answered with 'Yes'"),
        ),
        (
            names: [
                "--root",
                "-r",
            ],
            description: Some("Allow mackup to be run as superuser"),
        ),
        (
            names: [
                "--dry-run",
                "-n",
            ],
            description: Some("Show steps without executing"),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Show version"),
        ),
    ],
)
