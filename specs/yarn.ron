(
    version: 1,
    command: "yarn",
    description: Some("Manage packages and run scripts"),
    subcommands: [
        (
            name: "add",
            description: Some("Installs a package and any packages that it depends on"),
            options: [
                (
                    names: [
                        "-s",
                        "--silent",
                    ],
                    description: Some("Skip Yarn console logs"),
                ),
                (
                    names: [
                        "--no-default-rc",
                    ],
                    description: Some("Prevent Yarn from automatically detecting yarnrc and npmrc files"),
                ),
                (
                    names: [
                        "--use-yarnrc",
                    ],
                    description: Some("Specifies a yarnrc file that Yarn should use (.yarnrc only, not .npmrc) (default: )"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--verbose",
                    ],
                    description: Some("Output verbose messages on internal operations"),
                ),
                (
                    names: [
                        "--offline",
                    ],
                    description: Some("Trigger an error if any required dependencies are not available in local cache"),
                ),
                (
                    names: [
                        "--prefer-offline",
                    ],
                    description: Some("Use network only if dependencies are not available in local cache"),
                ),
                (
                    names: [
                        "--enable-pnp",
                        "--pnp",
                    ],
                    description: Some("Enable the Plug'n'Play installation"),
                ),
                (
                    names: [
                        "--json",
                    ],
                    description: Some("Format Yarn log messages as lines of JSON"),
                ),
                (
                    names: [
                        "--ignore-scripts",
                    ],
                    description: Some("Don't run lifecycle scripts"),
                ),
                (
                    names: [
                        "--har",
                    ],
                    description: Some("Save HAR output of network traffic"),
                ),
                (
                    names: [
                        "--ignore-platform",
                    ],
                    description: Some("Ignore platform checks"),
                ),
                (
                    names: [
                        "--ignore-engines",
                    ],
                    description: Some("Ignore engines check"),
                ),
                (
                    names: [
                        "--ignore-optional",
                    ],
                    description: Some("Ignore optional dependencies"),
                ),
                (
                    names: [
                        "--force",
                    ],
                    description: Some("Install and build packages even if they were built before, overwrite lockfile"),
                ),
                (
                    names: [
                        "--skip-integrity-check",
                    ],
                    description: Some("Run install without checking if node_modules is installed"),
                ),
                (
                    names: [
                        "--check-files",
                    ],
                    description: Some("Install will verify file tree of packages for consistency"),
                ),
                (
                    names: [
                        "--no-bin-links",
                    ],
                    description: Some("Don't generate bin links when setting up packages"),
                ),
                (
                    names: [
                        "--flat",
                    ],
                    description: Some("Only allow one version of a package"),
                ),
                (
                    names: [
                        "--prod",
                        "--production",
                    ],
                    description: Some("Instruct Yarn to ignore NODE_ENV and take its production-or-not status from this flag instead"),
                ),
                (
                    names: [
                        "--no-lockfile",
                    ],
                    description: Some("Don't read or generate a lockfile"),
                ),
                (
                    names: [
                        "--pure-lockfile",
                    ],
                    description: Some("Don't generate a lockfile"),
                ),
                (
                    names: [
                        "--frozen-lockfile",
                    ],
                    description: Some("Don't generate a lockfile and fail if an update is needed"),
                ),
                (
                    names: [
                        "--update-checksums",
                    ],
                    description: Some("Update package checksums from current repository"),
                ),
                (
                    names: [
                        "--link-duplicates",
                    ],
                    description: Some("Create hardlinks to the repeated modules in node_modules"),
                ),
                (
                    names: [
                        "--link-folder",
                    ],
                    description: Some("Specify a custom folder to store global links"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--global-folder",
                    ],
                    description: Some("Specify a custom folder to store global packages"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--modules-folder",
                    ],
                    description: Some("Rather than installing modules into the node_modules folder relative to the cwd, output them here"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--preferred-cache-folder",
                    ],
                    description: Some("Specify a custom folder to store the yarn cache if possible"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--cache-folder",
                    ],
                    description: Some("Specify a custom folder that must be used to store the yarn cache"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--mutex",
                    ],
                    description: Some("Use a mutex to ensure only one yarn instance is executing"),
                    arguments: [
                        (
                            name: "type[:specifier]",
                        ),
                    ],
                ),
                (
                    names: [
                        "--emoji",
                    ],
                    description: Some("Enables emoji in output"),
                    arguments: [
                        (
                            name: "",
                            suggestions: [
                                (
                                    name: "true",
                                ),
                                (
                                    name: "false",
                                ),
                            ],
                            default: Some("true"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--cwd",
                    ],
                    description: Some("Working directory to use"),
                    arguments: [
                        (
                            name: "cwd",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--proxy",
                        "--https-proxy",
                    ],
                    arguments: [
                        (
                            name: "host",
                        ),
                    ],
                ),
                (
                    names: [
                        "--registry",
                    ],
                    description: Some("Override configuration registry"),
                    arguments: [
                        (
                            name: "url",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-progress",
                    ],
                    description: Some("Disable progress bar"),
                ),
                (
                    names: [
                        "--network-concurrency",
                    ],
                    description: Some("Maximum number of concurrent network requests"),
                    arguments: [
                        (
                            name: "number",
                        ),
                    ],
                ),
                (
                    names: [
                        "--network-timeout",
                    ],
                    description: Some("TCP timeout for network requests"),
                    arguments: [
                        (
                            name: "milliseconds",
                        ),
                    ],
                ),
                (
                    names: [
                        "--non-interactive",
                    ],
                    description: Some("Do not show interactive prompts"),
                ),
                (
                    names: [
                        "--scripts-prepend-node-path",
                    ],
                    description: Some("Prepend the node executable dir to the PATH in scripts"),
                ),
                (
                    names: [
                        "--no-node-version-check",
                    ],
                    description: Some("Do not warn when using a potentially unsupported Node version"),
                ),
                (
                    names: [
                        "--focus",
                    ],
                    description: Some("Focus on a single workspace by installing remote copies of its sibling workspaces"),
                ),
                (
                    names: [
                        "--otp",
                    ],
                    description: Some("One-time password for two factor authentication"),
                    arguments: [
                        (
                            name: "otpcode",
                        ),
                    ],
                ),
                (
                    names: [
                        "-W",
                        "--ignore-workspace-root-check",
                    ],
                    description: Some("Required to run yarn add inside a workspace root"),
                ),
                (
                    names: [
                        "-D",
                        "--dev",
                    ],
                    description: Some("Save package to your `devDependencies`"),
                ),
                (
                    names: [
                        "-P",
                        "--peer",
                    ],
                    description: Some("Save package to your `peerDependencies`"),
                ),
                (
                    names: [
                        "-O",
                        "--optional",
                    ],
                    description: Some("Save package to your `optionalDependencies`"),
                ),
                (
                    names: [
                        "-E",
                        "--exact",
                    ],
                    description: Some("Install exact version"),
                    depends_on: [
                        "--latest",
                    ],
                ),
                (
                    names: [
                        "-T",
                        "--tilde",
                    ],
                    description: Some("Install most recent release with the same minor version"),
                ),
                (
                    names: [
                        "-A",
                        "--audit",
                    ],
                    description: Some("Run vulnerability audit on installed packages"),
                ),
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Output usage information"),
                ),
            ],
            arguments: [
                (
                    name: "package",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            query_term: Some(AfterLast("@")),
                            cache: Some((
                                ttl_ms: Some(172800000),
                                stale_while_revalidate: true,
                            )),
                        ),
                    ],
                    variadic: true,
                    debounce: true,
                ),
            ],
        ),
        (
            name: "audit",
            description: Some("Perform a vulnerability audit against the installed packages"),
            options: [
                (
                    names: [
                        "--summary",
                    ],
                    description: Some("Only print the summary"),
                ),
                (
                    names: [
                        "--groups",
                    ],
                    description: Some("Only audit dependencies from listed groups. Default: devDependencies, dependencies, optionalDependencies"),
                    arguments: [
                        (
                            name: "group_name",
                            variadic: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--level",
                    ],
                    description: Some("Only print advisories with severity greater than or equal to one of the following: info|low|moderate|high|critical. Default: info"),
                    arguments: [
                        (
                            name: "severity",
                            suggestions: [
                                (
                                    name: "info",
                                ),
                                (
                                    name: "low",
                                ),
                                (
                                    name: "moderate",
                                ),
                                (
                                    name: "high",
                                ),
                                (
                                    name: "critical",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Output usage information"),
                ),
            ],
        ),
        (
            name: "autoclean",
            description: Some("Cleans and removes unnecessary files from package dependencies"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Output usage information"),
                ),
                (
                    names: [
                        "-i",
                        "--init",
                    ],
                    description: Some("Creates the .yarnclean file if it does not exist, and adds the default entries"),
                ),
                (
                    names: [
                        "-f",
                        "--force",
                    ],
                    description: Some("If a .yarnclean file exists, run the clean process"),
                ),
            ],
        ),
        (
            name: "bin",
            description: Some("Displays the location of the yarn bin folder"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Output usage information"),
                ),
            ],
        ),
