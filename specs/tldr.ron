(
    version: 1,
    command: "tldr",
    description: Some("A simpler man page than the existing man page"),
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Display help for command"),
        ),
        (
            names: [
                "-s",
                "--search",
            ],
            description: Some("Search all pages for the query"),
            arguments: [
                (
                    name: "query",
                ),
            ],
        ),
        (
            names: [
                "--linux",
            ],
            description: Some("Show command page for Linux"),
            arguments: [
                (
                    name: "",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "command ls -Al ~/.tldrc/tldr/pages/linux/ 2>/dev/null",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--osx",
            ],
            description: Some("Show command page for OSX"),
            arguments: [
                (
                    name: "",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "command ls -l ~/.tldrc/tldr/pages/osx/ 2>/dev/null",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--sunos",
            ],
            description: Some("Show command page for SunOS"),
            arguments: [
                (
                    name: "",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "command ls -l ~/.tldrc/tldr/pages/sunos/ 2>/dev/null",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-l",
                "--list",
            ],
            description: Some("Show all pages for current platform"),
        ),
        (
            names: [
                "-u",
                "--update",
            ],
            description: Some("Download the latest pages and generate search index"),
        ),
        (
            names: [
                "-c",
                "--clear-cache",
            ],
            description: Some("Delete the entire local cache"),
        ),
        (
            names: [
                "--platform",
                "-p",
            ],
            description: Some("Select platform"),
            arguments: [
                (
                    name: "platform",
                    suggestions: [
                        (
                            name: "linux",
                        ),
                        (
                            name: "osx",
                        ),
                        (
                            name: "sunos",
                        ),
                        (
                            name: "windows",
                        ),
                        (
                            name: "common",
                        ),
                    ],
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "",
            generators: [
                (
                    has_custom: true,
                ),
            ],
        ),
    ],
)
