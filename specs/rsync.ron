(
    version: 1,
    command: "rsync",
    description: Some("Rsync is a file transfer program capable of efficient remote update via a fast differencing algorithm"),
    options: [
        (
            names: [
                "-v",
                "--verbose",
            ],
            description: Some("Increase verbosity"),
        ),
        (
            names: [
                "--info",
            ],
            description: Some("Fine-grained informational verbosity"),
            arguments: [
                (
                    name: "BACKUP",
                    description: Some("Mention files backed up"),
                ),
                (
                    name: "COPY",
                    description: Some("Mention files copied locally on the receiving side"),
                ),
                (
                    name: "DEL",
                    description: Some("Mention deletions on the receiving side"),
                ),
                (
                    name: "FLIST",
                    description: Some("Mention file-list receiving/sending (levels 1-2)"),
                ),
                (
                    name: "MISC",
                    description: Some("Mention miscellaneous information (levels 1-2)"),
                ),
                (
                    name: "MOUNT",
                    description: Some("Mention mounts that were found or skipped"),
                ),
                (
                    name: "NAME",
                    description: Some("Mention 1) updated file/dir names, 2) unchanged names"),
                ),
                (
                    name: "PROGRESS",
                    description: Some("Mention 1) per-file progress or 2) total transfer progress"),
                ),
                (
                    name: "REMOVE",
                    description: Some("Mention files removed on the sending side"),
                ),
                (
                    name: "SKIP",
                    description: Some("Mention files that are skipped due to options used"),
                ),
                (
                    name: "STATS",
                    description: Some("Mention statistics at end of run (levels 1-3)"),
                ),
                (
                    name: "SYMSAFE",
                    description: Some("Mention symlinks that are unsafe"),
                ),
                (
                    name: "ALL",
                    description: Some("Set all --info options (e.g. all4)"),
                ),
                (
                    name: "NONE",
                    description: Some("Silence all --info options (same as all0)"),
                ),
                (
                    name: "HELP",
                    description: Some("Output this help message"),
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--debug",
            ],
            description: Some("Fine-grained debug verbosity"),
            arguments: [
                (
                    name: "BACKUP",
                    description: Some("Mention files backed up"),
                ),
                (
                    name: "COPY",
                    description: Some("Mention files copied locally on the receiving side"),
                ),
                (
                    name: "DEL",
                    description: Some("Mention deletions on the receiving side"),
                ),
                (
                    name: "FLIST",
                    description: Some("Mention file-list receiving/sending (levels 1-2)"),
                ),
                (
                    name: "MISC",
                    description: Some("Mention miscellaneous information (levels 1-2)"),
                ),
                (
                    name: "MOUNT",
                    description: Some("Mention mounts that were found or skipped"),
                ),
                (
                    name: "NAME",
                    description: Some("Mention 1) updated file/dir names, 2) unchanged names"),
                ),
                (
                    name: "PROGRESS",
                    description: Some("Mention 1) per-file progress or 2) total transfer progress"),
                ),
                (
                    name: "REMOVE",
                    description: Some("Mention files removed on the sending side"),
                ),
                (
                    name: "SKIP",
                    description: Some("Mention files that are skipped due to options used"),
                ),
                (
                    name: "STATS",
                    description: Some("Mention statistics at end of run (levels 1-3)"),
                ),
                (
                    name: "SYMSAFE",
                    description: Some("Mention symlinks that are unsafe"),
                ),
                (
                    name: "ALL",
                    description: Some("Set all --info options (e.g. all4)"),
                ),
                (
                    name: "NONE",
                    description: Some("Silence all --info options (same as all0)"),
                ),
                (
                    name: "HELP",
                    description: Some("Output this help message"),
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--msgs2stderr",
            ],
            description: Some("Special output handling for debugging"),
        ),
        (
            names: [
                "--quiet",
                "-q",
            ],
            description: Some("Suppress non-error messages"),
        ),
        (
            names: [
                "--no-motd",
            ],
            description: Some("Suppress daemon-mode MOTD (see manpage caveat)"),
        ),
        (
            names: [
                "--checksum",
                "-c",
            ],
            description: Some("Skip based on checksum, not mod-time & size"),
        ),
        (
            names: [
                "-a",
                "--archive",
            ],
            description: Some("Archive mode; equals -rlptgoD (no -H,-A,-X)"),
            exclusive_on: [
                "-H",
                "-A",
                "-X",
            ],
        ),
        (
            names: [
                "--no-OPTION",
            ],
            description: Some("Turn off an implied OPTION (e.g. --no-D)"),
        ),
        (
            names: [
                "-r",
                "--recursive",
            ],
            description: Some("Recurse into directories"),
        ),
        (
            names: [
                "-R",
                "--relative",
            ],
            description: Some("Use relative path names"),
        ),
        (
            names: [
                "--no-implied-dirs",
            ],
            description: Some("Don't send implied dirs with --relative"),
            depends_on: [
                "--relative",
            ],
        ),
        (
            names: [
                "-b",
                "--backup",
            ],
            description: Some("Make backups (see --suffix & --backup-dir)"),
        ),
        (
            names: [
                "--backup-dir",
            ],
            description: Some("Make backups into hierarchy based in DIR"),
            arguments: [
                (
                    name: "DIR",
                    template: [
                        Folders,
                    ],
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--suffix",
            ],
            description: Some("Set backup suffix (default ~ w/o --backup-dir)"),
            arguments: [
                (
                    name: "SUFFIX",
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "-u",
                "--update",
            ],
            description: Some("Skip files that are newer on the receiver"),
        ),
        (
            names: [
                "--inplace",
            ],
            description: Some("Update destination files in-place (SEE MAN PAGE)"),
        ),
        (
            names: [
                "--append",
            ],
            description: Some("Append data onto shorter files"),
        ),
        (
            names: [
                "--append-verify",
            ],
            description: Some("Like --append, but with old data in file checksum"),
        ),
        (
            names: [
                "-d",
                "--dirs",
            ],
            description: Some("Transfer directories without recursing"),
            arguments: [
                (
                    name: "DIR",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-l",
                "--links",
            ],
            description: Some("Copy symlinks as symlinks"),
        ),
        (
            names: [
                "-L",
                "--copy-links",
            ],
            description: Some("Transform symlink into referent file/dir"),
        ),
        (
            names: [
                "--copy-unsafe-links",
            ],
            description: Some("Only \"unsafe\" symlinks are transformed"),
        ),
        (
            names: [
                "--safe-links",
            ],
            description: Some("Ignore symlinks that point outside the source tree"),
        ),
        (
            names: [
                "--munge-links",
            ],
            description: Some("Munge symlinks to make them safer (but unusable)"),
        ),
        (
            names: [
                "-k",
                "--copy-dirlinks",
            ],
            description: Some("Transform symlink to a dir into referent dir"),
        ),
        (
            names: [
                "-K",
                "--keep-dirlinks",
            ],
            description: Some("Treat symlinked dir on receiver as dir"),
        ),
        (
            names: [
                "-H",
                "--hard-links",
            ],
            description: Some("Preserve hard links"),
        ),
        (
            names: [
                "-p",
                "--perms",
            ],
            description: Some("Preserve permissions"),
        ),
        (
            names: [
                "-E",
                "--executability",
            ],
            description: Some("Preserve the file's executability"),
        ),
        (
            names: [
                "--chmod",
            ],
            description: Some("Affect file and/or directory permissions"),
            arguments: [
                (
                    name: "CHMOD",
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "-A",
                "--acls",
            ],
            description: Some("Preserve ACLs (implies --perms)"),
            depends_on: [
                "--perms",
            ],
        ),
        (
            names: [
                "-X",
                "--xattrs",
            ],
            description: Some("Preserve extended attributes"),
        ),
        (
            names: [
                "-o",
                "--owner",
            ],
            description: Some("Preserve owner (super-user only)"),
        ),
        (
            names: [
                "-g",
                "--group",
            ],
            description: Some("Preserve group"),
        ),
        (
            names: [
                "--devices",
            ],
            description: Some("Preserve device files (super-user only)"),
        ),
        (
            names: [
                "--copy-devices",
            ],
            description: Some("Copy device contents as regular file"),
        ),
        (
            names: [
                "--specials",
            ],
            description: Some("Preserve special files"),
        ),
        (
            names: [
                "-D",
            ],
            description: Some("Same as --devices --specials"),
        ),
        (
            names: [
                "-t",
                "--times",
            ],
            description: Some("Preserve modification times"),
        ),
        (
            names: [
                "-O",
                "--omit-dir-times",
            ],
            description: Some("Omit directories from --times"),
            arguments: [
                (
                    name: "DIR",
                    template: [
                        Folders,
                    ],
                    variadic: true,
                ),
            ],
            depends_on: [
                "--times",
            ],
        ),
        (
            names: [
                "-J",
                "--omit-link-times",
            ],
            description: Some("Omit symlinks from --times"),
            depends_on: [
                "--times",
            ],
        ),
        (
            names: [
                "--super",
            ],
            description: Some("Receiver attempts super-user activities"),
        ),
        (
            names: [
                "--fake-super",
            ],
            description: Some("Store/recover privileged attrs using xattrs"),
        ),
        (
            names: [
                "-S",
                "--sparse",
            ],
            description: Some("Turn sequences of nulls into sparse blocks"),
        ),
        (
            names: [
                "--preallocate",
            ],
            description: Some("Allocate dest files before writing them"),
        ),
        (
            names: [
                "-n",
                "--dry-run",
            ],
            description: Some("Perform a trial run with no changes made"),
        ),
        (
            names: [
                "-W",
                "--whole-file",
            ],
            description: Some("Copy files whole (without delta-xfer algorithm)"),
        ),
        (
            names: [
                "--checksum-choice",
            ],
            description: Some("Choose the checksum algorithms"),
            arguments: [
                (
                    name: "ALGORITHM",
                    suggestions: [
                        (
                            name: "auto",
                        ),
                        (
                            name: "md4",
                        ),
                        (
                            name: "md5",
                        ),
                        (
                            name: "none",
                        ),
                    ],
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "-x",
                "--one-file-system",
            ],
            description: Some("Don't cross filesystem boundaries"),
        ),
        (
            names: [
                "-B",
                "--block-size",
            ],
            description: Some("Force a fixed checksum block-size"),
            arguments: [
                (
                    name: "SIZE",
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "-e",
                "--rsh",
            ],
            description: Some("Specify the remote shell to use"),
            arguments: [
                (
                    name: "COMMAND",
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--rsync-path",
            ],
            description: Some("Specify the rsync to run on the remote machine"),
            arguments: [
                (
                    name: "PATH",
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--existing",
            ],
            description: Some("Skip creating new files on receiver"),
        ),
        (
            names: [
                "--ignore-existing",
            ],
            description: Some("Skip updating files that already exist on receiver"),
        ),
        (
            names: [
                "--remove-source-files",
            ],
            description: Some("Sender removes synchronized files (non-dirs)"),
        ),
        (
            names: [
                "--delete",
            ],
            description: Some("Delete extraneous files from destination dirs"),
        ),
        (
            names: [
                "--delete-before",
            ],
            description: Some("Receiver deletes before transfer, not during"),
        ),
        (
            names: [
                "--delete-during",
                "--del",
            ],
            description: Some("Receiver deletes during the transfer"),
        ),
        (
            names: [
                "--delete-delay",
            ],
            description: Some("Find deletions during, delete after"),
        ),
        (
            names: [
                "--delete-after",
            ],
            description: Some("Receiver deletes after transfer, not during"),
        ),
        (
            names: [
                "--delete-excluded",
            ],
            description: Some("Also delete excluded files from destination dirs"),
        ),
        (
            names: [
                "--ignore-missing-args",
            ],
            description: Some("Ignore missing source args without error"),
        ),
        (
            names: [
                "--delete-missing-args",
            ],
            description: Some("Delete missing source args from destination"),
        ),
        (
            names: [
                "--ignore-errors",
            ],
            description: Some("Delete even if there are I/O errors"),
        ),
        (
            names: [
                "--force",
            ],
            description: Some("Force deletion of directories even if not empty"),
        ),
        (
            names: [
                "--max-delete",
            ],
            description: Some("Don't delete more than NUM files"),
            arguments: [
                (
                    name: "NUM",
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--max-size",
            ],
            description: Some("Don't transfer any file larger than SIZE"),
            arguments: [
                (
                    name: "SIZE",
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--min-size",
            ],
            description: Some("Don't transfer any file smaller than SIZE"),
            arguments: [
                (
                    name: "SIZE",
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--partial",
            ],
            description: Some("Keep partially transferred files"),
        ),
        (
            names: [
                "--partial-dir=DIR",
            ],
            description: Some("Put a partially transferred file into DIR"),
            arguments: [
                (
                    name: "DIR",
                    template: [
                        Folders,
                    ],
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--delay-updates",
            ],
            description: Some("Put all updated files into place at transfer's end"),
        ),
        (
            names: [
                "-m",
                "--prune-empty-dirs",
            ],
            description: Some("Prune empty directory chains from the file-list"),
        ),
        (
            names: [
                "--numeric-ids",
            ],
            description: Some("Don't map uid/gid values by user/group name"),
        ),
        (
            names: [
                "--usermap",
            ],
            description: Some("Custom username mapping"),
            arguments: [
                (
                    name: "STRING",
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--groupmap",
            ],
            description: Some("Custom groupname mapping"),
            arguments: [
                (
                    name: "STRING",
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--chown=USER:GROUP",
            ],
            description: Some("Simple username/groupname mapping"),
            arguments: [
                (
                    name: "USER:GROUP",
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--timeout",
            ],
            description: Some("Set I/O timeout in seconds"),
            arguments: [
                (
                    name: "SECONDS",
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--contimeout",
            ],
            description: Some("Set daemon connection timeout in seconds"),
            arguments: [
                (
                    name: "SECONDS",
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "-I",
                "--ignore-times",
            ],
            description: Some("Don't skip files that match in size and mod-time"),
        ),
        (
            names: [
                "-M",
            ],
            description: Some("Send OPTION to the remote side only"),
            arguments: [
                (
                    name: "OPTION",
                ),
            ],
        ),
        (
            names: [
                "--remote-option",
            ],
            description: Some("Send OPTION to the remote side only"),
            arguments: [
                (
                    name: "OPTION",
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--size-only",
            ],
            description: Some("Skip files that match in size"),
        ),
        (
            names: [
                "-@",
            ],
            description: Some("Set the accuracy for mod-time comparisons"),
            arguments: [
                (
                    name: "NUM",
                ),
            ],
        ),
        (
            names: [
                "--modify-window",
            ],
            description: Some("Set the accuracy for mod-time comparisons"),
            arguments: [
                (
                    name: "NUM",
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "-T",
            ],
            description: Some("Create temporary files in directory DIR"),
            arguments: [
                (
                    name: "DIR",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--temp-dir",
            ],
            description: Some("Create temporary files in directory DIR"),
            arguments: [
                (
                    name: "DIR",
                    template: [
                        Folders,
                    ],
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "-y",
                "--fuzzy",
            ],
            description: Some("Find similar file for basis if no dest file"),
        ),
        (
            names: [
                "--compare-dest",
            ],
            description: Some("Also compare destination files relative to DIR"),
            arguments: [
                (
                    name: "DIR",
                    template: [
                        Folders,
                    ],
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--copy-dest",
            ],
            description: Some("Also compare destination files relative to DIR and include copies of unchanged files"),
            arguments: [
                (
                    name: "DIR",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--link-dest",
            ],
            description: Some("Hardlink to files in DIR when unchanged"),
            arguments: [
                (
                    name: "DIR",
                    template: [
                        Folders,
                    ],
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "-z",
                "--compress",
            ],
            description: Some("Compress file data during the transfer"),
        ),
        (
            names: [
                "--compress-level",
            ],
            description: Some("Explicitly set compression level"),
            arguments: [
                (
                    name: "NUM",
                    suggestions: [
                        (
                            name: "0",
                        ),
                        (
                            name: "1",
                        ),
                        (
                            name: "2",
                        ),
                        (
                            name: "3",
                        ),
                        (
                            name: "4",
                        ),
                        (
                            name: "5",
                        ),
                        (
                            name: "6",
                        ),
                        (
                            name: "7",
                        ),
                        (
                            name: "8",
                        ),
                        (
                            name: "9",
                        ),
                    ],
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--skip-compress",
            ],
            description: Some("Skip compressing files with a suffix in LIST"),
            arguments: [
                (
                    name: "LIST",
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "-C",
                "--cvs-exclude",
            ],
            description: Some("Auto-ignore files the same way CVS does"),
        ),
        (
            names: [
                "-f",
            ],
            description: Some("Add a file-filtering RULE"),
            arguments: [
                (
                    name: "RULE",
                ),
            ],
        ),
        (
            names: [
                "--filter",
            ],
            description: Some("Add a file-filtering RULE"),
            arguments: [
                (
                    name: "RULE",
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "-F",
            ],
            description: Some("Same as --filter='dir-merge /.rsync-filter'"),
            arguments: [
                (
                    name: "DIR",
                    template: [
                        Folders,
                    ],
                    variadic: true,
                ),
            ],
        ),
        (
            names: [
                "--exclude",
            ],
            description: Some("Exclude files matching PATTERN"),
            arguments: [
                (
                    name: "PATTERN",
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--exclude-from",
            ],
            description: Some("Read exclude patterns from FILE"),
            arguments: [
                (
                    name: "FILE",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--include",
            ],
            description: Some("Don't exclude files matching PATTERN"),
            arguments: [
                (
                    name: "PATTERN",
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--include-from",
            ],
            description: Some("Read include patterns from FILE"),
            arguments: [
                (
                    name: "FILE",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--files-from",
            ],
            description: Some("Read list of source-file names from FILE"),
            arguments: [
                (
                    name: "FILE",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "-0",
                "--from0",
            ],
            description: Some("All *-from/filter files are delimited by 0s"),
        ),
        (
            names: [
                "-s",
                "--protect-args",
            ],
            description: Some("No space-splitting; only wildcard special-chars"),
        ),
        (
            names: [
                "--address",
            ],
            description: Some("Bind address for outgoing socket to daemon"),
            arguments: [
                (
                    name: "ADDRESS",
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--port",
            ],
            description: Some("Specify double-colon alternate port number"),
            arguments: [
                (
                    name: "PORT",
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--sockopts",
            ],
            description: Some("Specify custom TCP options"),
            arguments: [
                (
                    name: "OPTIONS",
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--blocking-io",
            ],
            description: Some("Use blocking I/O for the remote shell"),
        ),
        (
            names: [
                "--stats",
            ],
            description: Some("Give some file-transfer stats"),
        ),
        (
            names: [
                "-8",
                "--8-bit-output",
            ],
            description: Some("Leave high-bit chars unescaped in output"),
        ),
        (
            names: [
                "-h",
                "--human-readable",
            ],
            description: Some("Output numbers in a human-readable format"),
        ),
        (
            names: [
                "--progress",
            ],
            description: Some("Show progress during transfer"),
        ),
        (
            names: [
                "-P",
            ],
            description: Some("Same as --partial --progress"),
        ),
        (
            names: [
                "-i",
                "--itemize-changes",
            ],
            description: Some("Output a change-summary for all updates"),
