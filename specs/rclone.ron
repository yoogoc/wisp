                    ],
                ),
                (
                    name: "dest:path",
                    generators: [
                        (
                            script: [
                                "rclone",
                                "listremotes",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "copyurl",
            description: Some("Copy url content to dest"),
            arguments: [
                (
                    name: "url",
                ),
                (
                    name: "dest:path",
                    generators: [
                        (
                            script: [
                                "rclone",
                                "listremotes",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "cryptcheck",
            description: Some("Cryptcheck checks the integrity of a crypted remote"),
            options: [
                (
                    names: [
                        "--combined",
                    ],
                    description: Some("Make a combined report of changes to this file"),
                    arguments: [
                        (
                            name: "",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--differ",
                    ],
                    description: Some("Report all non-matching files to this file"),
                    arguments: [
                        (
                            name: "",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--error",
                    ],
                    description: Some("Report all files with errors (hashing or reading) to this file"),
                    arguments: [
                        (
                            name: "",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--match",
                    ],
                    description: Some("Report all matching files to this file"),
                    arguments: [
                        (
                            name: "",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--missing-on-dst",
                    ],
                    description: Some("Report all files missing from the destination to this file"),
                    arguments: [
                        (
                            name: "",
                            template: [
                                FilePaths,
                            ],
