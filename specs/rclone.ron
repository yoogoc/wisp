            description: Some("List directories and objects in remote:path formatted for parsing"),
            options: [
                (
                    names: [
                        "--dirs-only",
                    ],
                    description: Some("Only list directories"),
                ),
                (
                    names: [
                        "--files-only",
                    ],
                    description: Some("Only list files"),
