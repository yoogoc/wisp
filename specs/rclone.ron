                        Folders,
                    ],
                ),
            ],
        ),
        (
            name: "hashsum",
            description: Some("Produces a hashsum file for all the objects in the path"),
            options: [
                (
                    names: [
                        "--base64",
                    ],
                    description: Some("Output base64 encoded hashsum"),
                ),
                (
                    names: [
                        "--download",
                    ],
                    description: Some("Download the file and hash it locally; if this flag is not specified, the hash is requested from the remote"),
                ),
                (
                    names: [
                        "--output-file",
                    ],
                    description: Some("Output hashsums to a file rather than the terminal"),
                    arguments: [
                        (
                            name: "",
                            template: [
