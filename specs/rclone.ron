            ],
            arguments: [
                (
                    name: "remote:path",
                    generators: [
                        (
                            script: [
                                "rclone",
                                "listremotes",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
                (
                    name: "cryptedremote",
                    generators: [
                        (
                            script: [
                                "rclone",
                                "listremotes",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "cryptdecode",
            description: Some("Cryptdecode returns unencrypted file names"),
            options: [
                (
                    names: [
                        "--reverse",
                    ],
                    description: Some("Reverse cryptdecode, encrypts filenames"),
                ),
            ],
            arguments: [
                (
                    name: "cryptedremote",
                    generators: [
                        (
                            script: [
                                "rclone",
                                "listremotes",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
                (
                    name: "encryptedfilename",
                    variadic: true,
                ),
            ],
        ),
        (
            name: "dedupe",
            description: Some("Interactively find duplicate filenames and delete/rename them"),
            options: [
                (
                    names: [
                        "--by-hash",
                    ],
                    description: Some("Find identical hashes rather than names"),
                ),
                (
                    names: [
                        "--dedupe-mode",
                    ],
                    description: Some("Dedupe mode"),
                    arguments: [
                        (
                            name: "mode",
                            suggestions: [
                                (
                                    name: "interactive",
                                    description: Some("Interactive"),
                                ),
                                (
                                    name: "skip",
                                    description: Some("Removes identical files then skips anything left"),
                                ),
                                (
                                    name: "rename",
                                    description: Some("Removes identical files then renames the rest to be different"),
                                ),
                                (
                                    name: "list",
                                    description: Some("Lists duplicate dirs and files only and changes nothing"),
                                ),
                                (
                                    name: "first",
                                    description: Some("removes identical files then keeps the first one."),
                                ),
                                (
                                    name: "newest",
                                    description: Some("removes identical files then keeps the newest one."),
                                ),
                                (
                                    name: "oldest",
                                    description: Some("removes identical files then keeps the oldest one."),
                                ),
                                (
                                    name: "largest",
                                    description: Some("removes identical files then keeps the largest one."),
                                ),
                                (
                                    name: "smallest",
                                    description: Some("removes identical files then keeps the smallest one."),
                                ),
                            ],
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "remote:path",
                    generators: [
                        (
                            script: [
                                "rclone",
                                "listremotes",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "delete",
            description: Some("Remove the files in path"),
            options: [
                (
                    names: [
                        "--rmdirs",
                    ],
                    description: Some("Rmdirs removes empty directories but leaves root intact"),
                ),
            ],
            arguments: [
                (
                    name: "remote:path",
                    generators: [
                        (
                            script: [
                                "rclone",
                                "listremotes",
                            ],
                            has_post_process: true,
                        ),
