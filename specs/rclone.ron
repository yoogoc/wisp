(
    version: 1,
    command: "rclone",
    description: Some("The Swiss army knife of cloud storage"),
    subcommands: [
        (
            name: "about",
            description: Some("Get quota information from the remote"),
            options: [
                (
                    names: [
                        "--full",
                    ],
                    description: Some("Full numbers instead of SI units"),
                ),
                (
                    names: [
                        "--json",
                    ],
                    description: Some("Format output as JSON"),
                ),
            ],
            arguments: [
                (
                    name: "remote:",
                    generators: [
                        (
                            script: [
                                "rclone",
                                "listremotes",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "authorize",
            description: Some("Remote authorization"),
            options: [
                (
                    names: [
                        "--auth-no-open-browser",
                    ],
                    description: Some("Do not automatically open auth link in default browser"),
                ),
            ],
        ),
        (
            name: "backend",
            description: Some("Run a backend specific command"),
            options: [
                (
                    names: [
                        "--json",
                    ],
                    description: Some("Format output as JSON"),
                ),
            ],
        ),
        (
            name: "cat",
            description: Some("Concatenates any files and sends them to stdout"),
            options: [
                (
                    names: [
                        "--discard",
                    ],
                    description: Some("Discard the output instead of printing"),
                ),
                (
                    names: [
                        "--count",
                    ],
                    description: Some("Only print N characters. (default -1)"),
                    arguments: [
                        (
                            name: "int",
                        ),
                    ],
                ),
                (
                    names: [
                        "--head",
                    ],
                    description: Some("Only print the first N characters"),
                    arguments: [
                        (
                            name: "int",
                        ),
                    ],
                ),
                (
                    names: [
                        "--offset",
                    ],
                    description: Some("Start printing at offset N (or from end if -ve)"),
                    arguments: [
                        (
                            name: "int",
                        ),
                    ],
                ),
                (
                    names: [
                        "--tail",
                    ],
                    description: Some("Only print the last N characters"),
                    arguments: [
                        (
                            name: "int",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "remote:path",
                    generators: [
                        (
                            script: [
                                "rclone",
                                "listremotes",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "check",
            description: Some("Checks the files in the source and destination match"),
            options: [
                (
                    names: [
                        "--download",
                    ],
                    description: Some("Check by downloading rather than with hash"),
                ),
                (
                    names: [
                        "--combined",
                    ],
                    description: Some("Make a combined report of changes to this file"),
                    arguments: [
                        (
                            name: "",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--differ",
                    ],
                    description: Some("Report all non-matching files to this file"),
                    arguments: [
                        (
                            name: "",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--error",
                    ],
                    description: Some("Report all files with errors (hashing or reading) to this file"),
                    arguments: [
                        (
                            name: "",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--match",
                    ],
                    description: Some("Report all matching files to this file"),
                    arguments: [
                        (
                            name: "",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--missing-on-dst",
                    ],
                    description: Some("Report all files missing from the destination to this file"),
                    arguments: [
                        (
                            name: "",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--missing-on-src",
                    ],
                    description: Some("Report all files missing from the source to this file"),
                    arguments: [
                        (
                            name: "",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--one-way",
                    ],
                    description: Some("Check one way only, source files must exist on remote"),
                ),
            ],
            arguments: [
                (
                    name: "source:path",
                    generators: [
                        (
                            script: [
                                "rclone",
                                "listremotes",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
                (
                    name: "remote:path",
                    generators: [
                        (
                            script: [
                                "rclone",
                                "listremotes",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "cleanup",
            description: Some("Clean up the remote if possible"),
            arguments: [
                (
                    name: "remote:path",
                    generators: [
                        (
                            script: [
                                "rclone",
                                "listremotes",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "config",
            description: Some("Enter an interactive configuration session"),
            subcommands: [
                (
                    name: "create",
                    description: Some("Create a new remote with name, type and options"),
                    arguments: [
                        (
                            name: "name",
                        ),
                        (
                            name: "type",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "copy",
            description: Some("Copy files from source to dest, skipping already copied"),
            arguments: [
                (
                    name: "source:path",
                    generators: [
                        (
                            script: [
                                "rclone",
                                "listremotes",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
                (
                    name: "dest:path",
                    generators: [
                        (
                            script: [
                                "rclone",
                                "listremotes",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "copyto",
            description: Some("Copy files from source to dest, skipping already copied"),
            arguments: [
                (
                    name: "source:path",
                    generators: [
                        (
                            script: [
                                "rclone",
                                "listremotes",
                            ],
                            has_post_process: true,
