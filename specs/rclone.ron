            presentation: (
                dangerous: true,
            ),
        ),
        (
            name: "deletefile",
            description: Some("Remove a single file from remote"),
            arguments: [
                (
                    name: "remote:path",
                    generators: [
                        (
                            script: [
                                "rclone",
                                "listremotes",
                            ],
                            has_post_process: true,
