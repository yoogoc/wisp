                    ],
                ),
            ],
            presentation: (
                dangerous: true,
            ),
        ),
        (
            name: "genautocomplete",
            description: Some("Output completion script for a given shell"),
            subcommands: [
                (
                    name: "bash",
                    description: Some("Output bash completion script for rclone."),
                    arguments: [
                        (
                            name: "output_file",
                            description: Some("If output_file is \"-\", then the output will be written to stdout"),
                            optional: true,
                        ),
                    ],
                ),
                (
                    name: "fish",
                    description: Some("Output fish completion script for rclone."),
                    arguments: [
                        (
                            name: "output_file",
                            description: Some("If output_file is \"-\", then the output will be written to stdout"),
                            optional: true,
                        ),
