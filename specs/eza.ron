(
    version: 1,
    command: "eza",
    description: Some("A modern replacement for ls"),
    options: [
        (
            names: [
                "-?",
                "--help",
            ],
            description: Some("Show list of command-line options"),
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Show version of eza"),
        ),
        (
            names: [
                "-1",
                "--oneline",
            ],
            description: Some("Display one entry per line"),
        ),
        (
            names: [
                "-l",
                "--long",
            ],
            description: Some("Display extended file metadata as a table"),
        ),
        (
            names: [
                "-G",
                "--grid",
            ],
            description: Some("Display entries as a grid (default)"),
        ),
        (
            names: [
                "-x",
                "--across",
            ],
            description: Some("Sort the grid across, rather than downward"),
        ),
        (
            names: [
                "-R",
                "--recurse",
            ],
            description: Some("Recurse into directories"),
        ),
        (
            names: [
                "-T",
                "--tree",
            ],
            description: Some("Recurse into directories as a tree"),
        ),
        (
            names: [
                "-X",
                "--dereference",
            ],
            description: Some("Dereference symbolic links when displaying information"),
        ),
        (
            names: [
                "-F",
                "--classify",
            ],
            description: Some("Display type indicator by file names"),
            arguments: [
                (
                    name: "when",
                    suggestions: [
                        (
                            name: "auto",
                            aliases: [
                                "automatic",
                            ],
                            description: Some("Display file kind indicators only when the standard output is connected to a real terminal"),
                        ),
                        (
                            name: "always",
                            description: Some("Always display file kind indicators"),
                        ),
                        (
                            name: "never",
                            description: Some("Disables the use of file kind indicators"),
                        ),
                    ],
                    default: Some("automatic"),
                ),
            ],
        ),
        (
            names: [
                "--color",
                "--colour",
            ],
            description: Some("When to use terminal colours"),
            arguments: [
                (
                    name: "when",
                    suggestions: [
                        (
                            name: "auto",
                            aliases: [
                                "automatic",
                            ],
                            description: Some("To colorize the output only when the standard output is connected to a real terminal"),
                        ),
                        (
                            name: "always",
                            description: Some("Always output terminal color"),
                        ),
                        (
                            name: "never",
                            description: Some("Disables the use of terminal color"),
                        ),
                    ],
                    default: Some("automatic"),
                ),
            ],
        ),
        (
            names: [
                "--color-scale",
                "--colour-scale",
            ],
            description: Some("Highlight levels of 'field' distinctly"),
            arguments: [
                (
                    name: "field",
                    suggestions: [
                        (
                            name: "all",
                        ),
                        (
                            name: "age",
                        ),
                        (
                            name: "size",
                        ),
                    ],
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--color-scale-mode",
                "--colour-scale-mode",
            ],
            description: Some("Use gradient or fixed colors in --color-scale"),
            arguments: [
                (
                    name: "mode",
                    suggestions: [
                        (
                            name: "fixed",
                        ),
                        (
                            name: "gradient",
                        ),
                    ],
                    default: Some("gradient"),
                ),
            ],
        ),
        (
            names: [
                "--icons",
            ],
            description: Some("When to display icons"),
            arguments: [
                (
                    name: "when",
                    suggestions: [
                        (
                            name: "auto",
                            aliases: [
                                "automatic",
                            ],
                            description: Some("Display icons only when the standard output is connected to a real terminal"),
                        ),
                        (
                            name: "always",
                            description: Some("Always display icons"),
                        ),
                        (
                            name: "never",
                            description: Some("Disables the use of icons"),
                        ),
                    ],
                    default: Some("automatic"),
                ),
            ],
        ),
        (
            names: [
                "--no-quotes",
            ],
            description: Some("Don't quote file names with spaces"),
        ),
        (
            names: [
                "--hyperlink",
            ],
            description: Some("Display entries as hyperlinks"),
        ),
        (
            names: [
                "--absolute",
            ],
            description: Some("Display entries with their absolute path"),
            arguments: [
                (
                    name: "mode",
                    suggestions: [
                        (
                            name: "off",
                        ),
                        (
                            name: "on",
                        ),
                        (
                            name: "follow",
                        ),
                    ],
                    default: Some("off"),
                ),
            ],
        ),
        (
            names: [
                "--follow-symlinks",
            ],
            description: Some("Drill down into symbolic links that point to directories"),
        ),
        (
            names: [
                "-w",
                "--width",
            ],
            description: Some("Set screen width in columns"),
            arguments: [
                (
                    name: "columns",
                ),
            ],
        ),
        (
            names: [
                "-a",
                "--all",
            ],
            description: Some("Show hidden and 'dot' files"),
            repeat: Times(2),
        ),
        (
            names: [
                "-A",
                "--almost-all",
            ],
            description: Some("Equivalent to '--all'"),
            repeat: Times(2),
        ),
        (
            names: [
                "-d",
                "--list-dirs",
            ],
            description: Some("List directories like regular files"),
        ),
        (
            names: [
                "-D",
                "--only-dirs",
            ],
            description: Some("List only directories"),
        ),
        (
            names: [
                "-f",
                "--only-files",
            ],
            description: Some("List only files"),
        ),
        (
            names: [
                "--show-symlinks",
            ],
            description: Some("Explicitly show symbolic links"),
            depends_on: [
                "--only-dirs",
                "--only-files",
            ],
        ),
        (
            names: [
                "--no-symlinks",
            ],
            description: Some("Do not show symbolic links"),
        ),
        (
            names: [
                "-L",
                "--level",
            ],
            description: Some("Limit the depth of recursion"),
            arguments: [
                (
                    name: "depth",
                ),
            ],
        ),
        (
            names: [
                "-r",
                "--reverse",
            ],
            description: Some("Reverse the sort order"),
        ),
        (
            names: [
                "-s",
                "--sort",
            ],
            description: Some("Which field to sort by"),
            arguments: [
                (
                    name: "field",
                    suggestions: [
                        (
                            name: "name",
                            description: Some("Lowercase precede UPERCASE"),
                        ),
                        (
                            name: "Name",
                            description: Some("UPERCASE precede lowercase"),
                        ),
                        (
                            name: "extension",
                            description: Some("Lowercase precede UPERCASE"),
                        ),
                        (
                            name: "Extension",
                            description: Some("UPERCASE precede lowercase"),
                        ),
                        (
                            name: "size",
                        ),
                        (
                            name: "modified",
                        ),
                        (
                            name: "changed",
                        ),
                        (
                            name: "accessed",
                        ),
                        (
                            name: "created",
                        ),
                        (
                            name: "inode",
                        ),
                        (
                            name: "type",
                        ),
                        (
                            name: "none",
                        ),
                        (
                            name: "date",
                            aliases: [
                                "time",
                                "new",
                                "newest",
                            ],
                        ),
                        (
                            name: "age",
                            aliases: [
                                "old",
                                "oldest",
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--group-directories-first",
            ],
            description: Some("List directories before other files"),
        ),
        (
            names: [
                "--group-directories-last",
            ],
            description: Some("List directories after other files"),
        ),
        (
            names: [
                "-I",
                "--ignore-glob",
            ],
            description: Some("Glob patterns (pipe-separated) of files to ignore"),
            arguments: [
                (
                    name: "globs",
                ),
            ],
        ),
        (
            names: [
                "--git-ignore",
            ],
            description: Some("Ignore files mentioned in '.gitignore'"),
        ),
        (
            names: [
                "-b",
                "--binary",
            ],
            description: Some("List file sizes with binary prefixes"),
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "-B",
                "--bytes",
            ],
            description: Some("List file sizes in bytes, without any prefixes"),
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "-g",
                "--group",
            ],
            description: Some("List each file's group"),
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "--smart-group",
            ],
            description: Some("Only show group if it has a different name from owner"),
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "-h",
                "--header",
            ],
            description: Some("Add a header row to each column"),
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "-H",
                "--links",
            ],
            description: Some("List each file's number of hard links"),
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "-i",
                "--inode",
            ],
            description: Some("List each file's inode number"),
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "-M",
                "--mounts",
            ],
            description: Some("Show mount details"),
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "-n",
                "--numeric",
            ],
            description: Some("List numeric user and group IDs"),
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "-O",
                "--flags",
            ],
            description: Some("List file flags"),
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "-S",
                "--blocksize",
            ],
            description: Some("Show size of allocated file system blocks"),
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "-t",
                "--time",
            ],
            description: Some("Which timestamp field to list"),
            arguments: [
                (
                    name: "field",
                    suggestions: [
                        (
                            name: "modified",
                        ),
                        (
                            name: "changed",
                        ),
                        (
                            name: "accessed",
                        ),
                        (
                            name: "created",
                        ),
                    ],
                ),
            ],
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "-m",
                "--modified",
            ],
            description: Some("Use the modified timestamp field"),
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "-u",
                "--accessed",
            ],
            description: Some("Use the accessed timestamp field"),
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "-U",
                "--created",
            ],
            description: Some("Use the created timestamp field"),
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "--changed",
            ],
            description: Some("Use the changed timestamp field"),
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "--time-style",
            ],
            description: Some("How to format timestamps"),
            arguments: [
                (
                    name: "format",
                    suggestions: [
                        (
                            name: "default",
                        ),
                        (
                            name: "iso",
                        ),
                        (
                            name: "long-iso",
                        ),
                        (
                            name: "relative",
                        ),
                        (
                            name: "+%Y-%m-%d %H:%M",
                        ),
                    ],
                ),
            ],
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "--total-size",
            ],
            description: Some("Show the size of a directory as the size of all files and directories inside"),
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "-o",
                "--octal-permissions",
            ],
            description: Some("List each file's permission in octal format"),
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "--no-permissions",
            ],
            description: Some("Suppress the permissions field"),
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "--no-filesize",
            ],
            description: Some("Suppress the filesize field"),
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "--no-user",
            ],
            description: Some("Suppress the user field"),
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "--no-time",
            ],
            description: Some("Suppress the time field"),
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "--stdin",
            ],
            description: Some("Read file names from stdin, one per line or other separator specified in environment"),
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "--git",
            ],
            description: Some("List each file's Git status, if tracked or ignored"),
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "--no-git",
            ],
            description: Some("Suppress Git status"),
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "--git-repos",
            ],
            description: Some("List root of git-tree status"),
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "--git-repos-no-status",
            ],
            description: Some("List each git-repos branch name (much faster)"),
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "-@",
                "--extended",
            ],
            description: Some("List each file's extended attributes and sizes"),
            depends_on: [
                "-l",
                "--long",
            ],
        ),
        (
            names: [
                "-Z",
                "--context",
            ],
            description: Some("List each file's security context"),
            depends_on: [
                "-l",
                "--long",
            ],
        ),
    ],
    arguments: [
        (
            name: "",
            template: [
                Folders,
            ],
            variadic: true,
            default: Some("."),
        ),
    ],
)
