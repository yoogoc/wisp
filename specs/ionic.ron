                                    name: "quantity",
                                    default: Some("2"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--min-background-duration",
                            ],
                            description: Some("The minimum duration after which the app checks for an update in the background"),
                            arguments: [
                                (
                                    name: "seconds",
                                    default: Some("30"),
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "build",
                    description: Some("Create a deploy build on Appflow"),
                    options: [
                        (
                            names: [
