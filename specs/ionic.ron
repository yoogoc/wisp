                            suggestions: [
                                (
                                    name: "ios",
                                ),
                                (
                                    name: "android",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "copy",
                    description: Some("Copy web assets to native platforms"),
                    options: [
