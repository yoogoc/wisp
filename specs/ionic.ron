                    name: "sync",
                    description: Some("Sync (copy + update) an Ionic project"),
                    options: [
                        (
                            names: [
                                "--no-build",
                            ],
                            description: Some("Do not invoke an Ionic build"),
                        ),
                        (
                            names: [
                                "--prod",
                            ],
                            description: Some("Flag to use the production configuration"),
                        ),
                        (
                            names: [
                                "--configuration",
