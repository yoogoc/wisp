                            ],
                            description: Some("Do not invoke Ionic build"),
                        ),
                        (
                            names: [
                                "--no-open",
                            ],
                            description: Some("Do not invoke Capacitor open"),
                        ),
                        (
                            names: [
                                "--prod",
                            ],
                            description: Some("Flag to use the production configuration"),
                        ),
                        (
                            names: [
                                "configuration",
                                "-c",
                            ],
                            description: Some("Specify the configuration to use"),
                        ),
                        (
                            names: [
