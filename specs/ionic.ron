                                        Folders,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--source-map",
                            ],
                            description: Some("Output source maps"),
                        ),
                        (
                            names: [
                                "--watch",
                            ],
                            description: Some("Rebuild when files change"),
                        ),
