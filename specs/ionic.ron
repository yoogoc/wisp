        (
            name: "deploy",
            description: Some("AppFlow deploy commands for Ionic"),
            subcommands: [
                (
                    name: "add",
                    description: Some("Adds Appflow Deploy to the project"),
                    options: [
                        (
                            names: [
                                "--app-id",
                            ],
