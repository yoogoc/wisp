                            arguments: [
                                (
                                    name: "port",
                                    default: Some("8100"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--public-host",
                            ],
                            description: Some("The host used for the browser or web view"),
                            arguments: [
                                (
                                    name: "host",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--livereload",
                                "-l",
                            ],
                            description: Some("Spin up dev server to live-reload www files"),
                        ),
                        (
                            names: [
                                "--livereload-url",
                            ],
                            description: Some("Provide a custom URL to the dev server"),
                            arguments: [
                                (
                                    name: "url",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--prod",
                            ],
                            description: Some("Flag to use the production configuration"),
                        ),
                        (
                            names: [
                                "--configuration",
                                "-c",
                            ],
                            description: Some("Specify the configuration to use"),
                            arguments: [
                                (
                                    name: "conf",
                                    template: [
