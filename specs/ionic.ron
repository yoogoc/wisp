(
    version: 1,
    command: "ionic",
    description: Some("The Ionic command-line interface (CLI) is the go-to tool for developing Ionic apps"),
    subcommands: [
        (
            name: "build",
            description: Some("Build web assets and prepare your app for any platform targets"),
            options: [
                (
                    names: [
                        "--engine",
                    ],
                    description: Some("Target engine (e.g. browser, cordova)"),
                    arguments: [
                        (
                            name: "engine",
                            suggestions: [
                                (
                                    name: "browser",
                                ),
                                (
                                    name: "cordova",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--platform",
                    ],
                    description: Some("Target platform on chosen engine (e.g. ios, android)"),
                    arguments: [
                        (
                            name: "platform",
                            suggestions: [
                                (
                                    name: "ios",
                                ),
                                (
                                    name: "android",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--prod",
                    ],
                    description: Some("Flag to use the production configuration"),
                ),
                (
                    names: [
                        "--configuration",
                        "-c",
                    ],
                    description: Some("Specify the configuration to use"),
                    arguments: [
                        (
                            name: "conf",
                            template: [
                                FilePaths,
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--source-map",
                    ],
                    description: Some("Output source maps"),
                ),
                (
                    names: [
                        "--watch",
                    ],
                    description: Some("Rebuild when files change"),
                ),
            ],
        ),
        (
            name: "completion",
            description: Some("Enables tab-completion for Ionic CLI commands"),
        ),
        (
            name: "docs",
            description: Some("Open the Ionic documentation website"),
            options: [
                (
                    names: [
                        "--browser",
                        "-w",
                    ],
                    description: Some("Specifies the browser to use (safari, firefox, google chrome)"),
                    arguments: [
                        (
                            name: "browser",
                            suggestions: [
                                (
                                    name: "safari",
                                ),
                                (
                                    name: "firefox",
                                ),
                                (
                                    name: "google chrome",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "info",
            description: Some("Print project, system, and environment information"),
            options: [
                (
                    names: [
                        "--json",
                    ],
                    description: Some("Print system/environment info in JSON format"),
                ),
            ],
        ),
        (
            name: "init",
            description: Some("Initialize existing projects with Ionic"),
            options: [
                (
                    names: [
                        "--type",
                    ],
                    description: Some("Type of project (e.g. angular, react, vue, custom)"),
                    arguments: [
                        (
                            name: "type",
                            suggestions: [
                                (
                                    name: "angular",
                                ),
                                (
                                    name: "react",
                                ),
                                (
                                    name: "vue",
                                ),
                                (
                                    name: "custom",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--force",
                        "-f",
                    ],
                    description: Some("Initialize even if a project already exists"),
                ),
                (
                    names: [
                        "--multi-app",
                    ],
                    description: Some("Initialize a multi-app project"),
                ),
                (
                    names: [
                        "--project-id",
                    ],
                    description: Some("Specify a slug for your app"),
                    arguments: [
                        (
                            name: "slug",
                        ),
                    ],
                ),
                (
                    names: [
                        "--default",
                    ],
                    description: Some("Mark the initialized app as the default project"),
                ),
            ],
            arguments: [
                (
                    name: "name",
                    description: Some("The name of your project (e.g. myApp, \"My App\")"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "link",
            description: Some("Connect local apps to Ionic"),
            arguments: [
                (
                    name: "id",
                    description: Some("The Appflow ID of the app to link (e.g. a1b2c3d4)"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "login",
            description: Some("Log in to Ionic"),
            arguments: [
                (
                    name: "email",
                    description: Some("Your email address"),
                    optional: true,
                ),
                (
                    name: "password",
                    description: Some("Your password"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "logout",
            description: Some("Log out of Ionic"),
        ),
        (
            name: "repair",
            description: Some("Remove and recreate dependencies and generated files"),
            options: [
                (
                    names: [
                        "--cordova",
                    ],
                    description: Some("Only perform the repair steps for Cordova platforms and plugins"),
                ),
            ],
        ),
        (
            name: "serve",
            description: Some("Start a local dev server for app dev/testing"),
            options: [
                (
                    names: [
                        "--external",
                    ],
                    description: Some("Host dev server on all network interfaces (i.e. --host=0.0.0.0)"),
                ),
                (
                    names: [
                        "--host",
                    ],
                    description: Some("Use specific host for the dev server"),
                    arguments: [
                        (
                            name: "host",
                        ),
                    ],
                ),
                (
                    names: [
                        "--port",
                        "-p",
                    ],
                    description: Some("Use specific port for the dev server"),
                    arguments: [
                        (
                            name: "port",
                            default: Some("8100"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--public-host",
                    ],
                    description: Some("The host used for the browser or web view"),
                    arguments: [
                        (
                            name: "host",
                            default: Some("localhost"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-livereload",
                    ],
                    description: Some("Do not spin up dev server--just serve files"),
                ),
                (
                    names: [
                        "--lab-host",
                    ],
                    description: Some("Use specific host for Ionic Lab server"),
                    arguments: [
                        (
                            name: "host",
                            default: Some("8200"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--lab-port",
                    ],
                    description: Some("Use specific port for Ionic Lab server"),
                    arguments: [
                        (
                            name: "port",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-open",
                    ],
                    description: Some("Do not open a browser window"),
                ),
                (
                    names: [
                        "--browser",
                        "-w",
                    ],
                    description: Some("Specifies the browser to use (safari, firefox, google chrome)"),
                    arguments: [
                        (
                            name: "browser",
                            suggestions: [
                                (
                                    name: "safari",
                                ),
                                (
                                    name: "firefox",
                                ),
                                (
                                    name: "google chrome",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--browseroption",
                        "-o",
                    ],
                    description: Some("Specifies a path to open to (/#/tab/dash)"),
                    arguments: [
                        (
                            name: "path",
                        ),
                    ],
                ),
                (
                    names: [
                        "--lab",
                        "-l",
                    ],
                    description: Some("Test your apps on multiple platform types in the browser"),
                ),
                (
                    names: [
                        "--ssl",
                    ],
                    description: Some("Use HTTPS for the dev server"),
                ),
                (
                    names: [
                        "--prod",
                    ],
                    description: Some("Flag to use the production configuration"),
                ),
                (
                    names: [
                        "--consolelogs",
                    ],
                    description: Some("Print app console logs to the terminal"),
                ),
                (
                    names: [
                        "--consolelogs-port",
                    ],
                    description: Some("Use specific port for console logs server"),
                    arguments: [
                        (
                            name: "port",
                        ),
                    ],
                ),
                (
                    names: [
                        "--configuration",
                        "-c",
                    ],
                    description: Some("Specify the configuration to use"),
                    arguments: [
                        (
                            name: "conf",
                            template: [
                                FilePaths,
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--source-map",
                    ],
                    description: Some("Output sourcemaps"),
                ),
            ],
        ),
        (
            name: "signup",
            description: Some("Create an Ionic account"),
        ),
        (
            name: "start",
            description: Some("Create a new project"),
            options: [
                (
                    names: [
                        "--list",
                        "-l",
                    ],
                    description: Some("List available starter templates"),
                ),
                (
                    names: [
                        "--type",
                    ],
                    description: Some("Type of project to start (e.g. vue, angular, react, ionic-angular, ionic1)"),
                    arguments: [
                        (
                            name: "type",
                            suggestions: [
                                (
                                    name: "vue",
                                ),
                                (
                                    name: "angular",
                                ),
                                (
                                    name: "react",
                                ),
                                (
                                    name: "ionic-angular",
                                ),
                                (
                                    name: "ionic1",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--cordova",
                    ],
                    description: Some("Include Cordova integration"),
                ),
                (
                    names: [
                        "--capacitor",
                    ],
                    description: Some("Include Capacitor integration"),
                ),
                (
                    names: [
                        "--no-deps",
                    ],
                    description: Some("Do not install npm/yarn dependencies"),
                ),
                (
                    names: [
                        "--no-git",
                    ],
                    description: Some("Do not initialize a git repo"),
                ),
                (
                    names: [
                        "--link",
                    ],
                    description: Some("Connect your new app to Ionic"),
                ),
                (
                    names: [
                        "--id",
                    ],
                    description: Some("Specify an Ionic App ID to link"),
                    arguments: [
                        (
                            name: "id",
                        ),
                    ],
                ),
                (
                    names: [
                        "--project-id",
                    ],
                    description: Some("Specify a slug for your app (used for the directory name and package name)"),
                    arguments: [
                        (
                            name: "slug",
                        ),
                    ],
                ),
                (
                    names: [
                        "--package-id",
                    ],
                    description: Some("Specify the bundle ID/application ID for your app (reverse-DNS notation)"),
                    arguments: [
                        (
                            name: "id",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "name",
                    description: Some("The name of your new project (e.g. myApp, \"My App\")"),
                ),
                (
                    name: "template",
                    description: Some("The starter template to use (e.g. blank, tabs; use --list to see all)"),
                ),
            ],
        ),
        (
            name: "config",
            description: Some("Config commands for Ionic"),
            subcommands: [
                (
                    name: "get",
                    description: Some("Print config values"),
                    options: [
                        (
                            names: [
                                "--global",
                                "-g",
                            ],
                            description: Some("Use global CLI config"),
                        ),
                        (
                            names: [
                                "--json",
                            ],
                            description: Some("Output config values in JSON"),
                        ),
                        (
                            names: [
                                "--root",
                            ],
                            description: Some("Operate on root of ionic.config.json"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "property",
                            description: Some("The property name you wish to get"),
                            optional: true,
                        ),
                    ],
                ),
                (
                    name: "set",
                    description: Some("Set config values"),
                    options: [
                        (
                            names: [
                                "--global",
                                "-g",
                            ],
                            description: Some("Use global CLI config"),
                        ),
                        (
                            names: [
                                "--json",
                            ],
                            description: Some("Always interpret value as JSON"),
                        ),
                        (
                            names: [
                                "--force",
                            ],
                            description: Some("Always overwrite existing values"),
                        ),
                        (
                            names: [
                                "--root",
                            ],
                            description: Some("Operate on root of ./ionic.config.json"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "property",
                            description: Some("The property name you wish to set"),
                        ),
                        (
                            name: "value",
                            description: Some("The new value of the given property"),
                        ),
                    ],
                ),
                (
                    name: "unset",
                    description: Some("Delete config values"),
                    options: [
                        (
                            names: [
                                "--global",
                                "-g",
                            ],
                            description: Some("Use global CLI config"),
                        ),
                        (
                            names: [
                                "--root",
                            ],
                            description: Some("Operate on root of ./ionic.config.json"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "property",
                            description: Some("The property name you wish to delete"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "capacitor",
            description: Some("Capacitor commands Ionic"),
            subcommands: [
