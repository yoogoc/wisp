                        ),
                        (
                            names: [
                                "--update-method",
                            ],
                            description: Some("The update method that dictates the behavior of the plugin"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--max-store",
                            ],
                            description: Some("The maximum number of downloaded versions to store on the device"),
                            arguments: [
                                (
                                    name: "quantity",
                                ),
                            ],
                        ),
