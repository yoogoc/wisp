                            name: "platform",
                            description: Some("The platform to copy (e.g. android, ios)"),
                            optional: true,
                        ),
                    ],
                ),
                (
                    name: "open",
                    description: Some("Open the IDE for a given native platform project"),
                    arguments: [
                        (
                            name: "platform",
                            description: Some("The platform to open (e.g. android, ios)"),
                            suggestions: [
                                (
                                    name: "ios",
                                ),
                                (
                                    name: "android",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "run",
                    description: Some("Run an Ionic project on a connected device"),
                    options: [
                        (
                            names: [
                                "--list",
                            ],
                            description: Some("List all available targets"),
                        ),
                        (
                            names: [
                                "--target",
                            ],
                            description: Some("Deploy to a specific device by its ID (use --list to see all)"),
                            arguments: [
                                (
                                    name: "target",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--open",
                            ],
                            description: Some("Open native IDE instead of using capacitor run"),
                        ),
                        (
                            names: [
                                "--no-build",
                            ],
                            description: Some("Do not invoke Ionic build"),
                        ),
                        (
                            names: [
                                "--external",
                            ],
                            description: Some("Host dev server on all network interfaces (i.e. --host=0.0.0.0)"),
                        ),
                        (
                            names: [
                                "--host",
                            ],
                            description: Some("Use specific host for the dev server"),
                            arguments: [
                                (
                                    name: "host",
                                    default: Some("localhost"),
                                ),
