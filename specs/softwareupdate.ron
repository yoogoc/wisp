(
    version: 1,
    command: "softwareupdate",
    description: Some("Software Update checks for new and updated versions of your software based on information about your computer and current software"),
    subcommands: [
        (
            name: "-l",
            aliases: [
                "--list",
            ],
            description: Some("List all appropriate update labels"),
        ),
        (
            name: "-d",
            aliases: [
                "--download",
            ],
            description: Some("Download Only"),
        ),
        (
            name: "-i",
            aliases: [
                "--install",
            ],
            description: Some("Install"),
            options: [
                (
                    names: [
                        "-a",
                        "--all",
                    ],
                    description: Some("All appropriate updates"),
                    exclusive_on: [
                        "-r",
                        "--recommended",
                    ],
                ),
                (
                    names: [
                        "-R",
                        "--restart",
                    ],
                    description: Some("Automatically restart (or shut down) if required to complete installation"),
                ),
                (
                    names: [
                        "-r",
                        "--recommended",
                    ],
                    description: Some("Only recommended updates"),
                    exclusive_on: [
                        "-a",
                        "--all",
                    ],
                ),
            ],
            arguments: [
                (
                    name: "label",
                    generators: [
                        (
                            script: [
                                "softwareupdate",
                                "--list",
                            ],
                            script_timeout_ms: Some(20000),
                            has_post_process: true,
                            cache: Some((
                                ttl_ms: Some(7200000),
                                stale_while_revalidate: true,
                            )),
                        ),
                    ],
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "--list-full-installers",
            description: Some("List the available macOS Installers"),
        ),
        (
            name: "--fetch-full-installer",
            description: Some("Install the latest recommended macOS Installer"),
        ),
        (
            name: "--full-installer-version",
            description: Some("The version of macOS to install"),
            arguments: [
                (
                    name: "version",
                ),
            ],
        ),
        (
            name: "--install-rosetta",
            description: Some("Install Rosetta 2"),
        ),
        (
            name: "--background",
            description: Some("Trigger a background scan and update operation"),
        ),
        (
            name: "--dump-state",
            description: Some("Log the internal state of the SU daemon to /var/log/install.log"),
        ),
        (
            name: "--evaluate-products",
            description: Some("Evaluate a list of product keys specified by the --products option"),
        ),
        (
            name: "--history",
            description: Some("Show the install history.  By default, only displays updates installed by softwareupdate"),
            options: [
                (
                    names: [
                        "--all",
                    ],
                    description: Some("Include all processes in history (including App installs)"),
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--no-scan",
            ],
            description: Some("Do not scan when listing or installing updates (use available updates previously scanned)"),
            persistent: true,
        ),
        (
            names: [
                "--product-types",
            ],
            description: Some("Limit a scan to a particular product type only - ignoring all others"),
            arguments: [
                (
                    name: "type",
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--products",
            ],
            description: Some("A comma-separated (no spaces) list of product keys to operate on"),
            persistent: true,
        ),
        (
            names: [
                "--force",
            ],
            description: Some("Force an operation to complete.  Use with --background to trigger a background scan regardless of \"Automatically check\" pref"),
            persistent: true,
            presentation: (
                dangerous: true,
            ),
        ),
        (
            names: [
                "--agree-to-license",
            ],
            description: Some("Agree to the software license agreement without user interaction"),
            persistent: true,
        ),
        (
            names: [
                "--verbose",
            ],
            description: Some("Enable verbose output"),
            persistent: true,
        ),
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for softwareupdate"),
        ),
    ],
)
