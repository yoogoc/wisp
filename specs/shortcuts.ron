(
    version: 1,
    command: "shortcuts",
    description: Some("Command-line utility for running shortcuts"),
    subcommands: [
        (
            name: "run",
            description: Some("Run a shortcut"),
            options: [
                (
                    names: [
                        "-i",
                        "--input-path",
                    ],
                    description: Some("The input to provide to the shortcut"),
                    arguments: [
                        (
                            name: "input-path",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-o",
                        "--output-path",
                    ],
                    description: Some("Where to write the shortcut output, if applicable"),
                    arguments: [
                        (
                            name: "output-path",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--output-type",
                    ],
                    description: Some("What type to output data in, in Universal Type Identifier format"),
                    arguments: [
                        (
                            name: "output-type",
                            suggestions: [
                                (
                                    name: "public.json",
                                    description: Some("JavaScript Object Notation (JSON)"),
                                ),
                                (
                                    name: "public.plain-text",
                                    description: Some("Plain text"),
                                ),
                                (
                                    name: "public.html",
                                    description: Some("HTML"),
                                ),
                                (
                                    name: "public.xml",
                                    description: Some("XML"),
                                ),
                                (
                                    name: "com.adobe.pdf",
                                    description: Some("Adobe PDF"),
                                ),
                                (
                                    name: "public.vcard",
                                    description: Some("VCard"),
                                ),
                            ],
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "shortcut-name",
                    description: Some("The name of the shortcut to run"),
                    generators: [
                        (
                            script: [
                                "shortcuts",
                                "list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
            presentation: (
                icon: Some("▶️"),
            ),
        ),
        (
            name: "list",
            description: Some("List your shortcuts"),
            options: [
                (
                    names: [
                        "--folder-name",
                        "-f",
                    ],
                    description: Some("The name of the folder to list"),
                    arguments: [
                        (
                            name: "folder-name",
                            generators: [
                                (
                                    script: [
                                        "shortcuts",
                                        "list",
                                        "--folders",
                                    ],
                                    has_post_process: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--folders",
                    ],
                    description: Some("List folders instead of shortcuts"),
                    presentation: (
                        icon: Some("📂"),
                    ),
                ),
            ],
            presentation: (
                icon: Some("📂"),
            ),
        ),
        (
            name: "view",
            description: Some("View a shortcut in Shortcuts"),
            arguments: [
                (
                    name: "shortcut-name",
                    description: Some("The name of the shortcut to view"),
                    generators: [
                        (
                            script: [
                                "shortcuts",
                                "list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
            presentation: (
                icon: Some("🔍"),
            ),
        ),
        (
            name: "sign",
            description: Some("Sign a shortcut file"),
            options: [
                (
                    names: [
                        "--input",
                        "-i",
                    ],
                    description: Some("The shortcut file to sign"),
                    arguments: [
                        (
                            name: "input",
                            generators: [
                                (
                                    has_custom: true,
                                    has_dynamic_trigger: true,
                                    has_dynamic_query_term: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--output",
                        "-o",
                    ],
                    description: Some("Output path for the signed shortcut file"),
                    arguments: [
                        (
                            name: "output",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--mode",
                        "-m",
                    ],
                    description: Some("The signing mode. (default: people-who-know-me)"),
                    arguments: [
                        (
                            name: "mode",
                            suggestions: [
                                (
                                    name: "people-who-know-me",
                                ),
                                (
                                    name: "anyone",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
            presentation: (
                icon: Some("🔏"),
            ),
        ),
        (
            name: "help",
            description: Some("Show help information"),
            subcommands: [
                (
                    name: "run",
                    description: Some("Run a shortcut"),
                    presentation: (
                        icon: Some("▶️"),
                    ),
                ),
                (
                    name: "list",
                    description: Some("List your shortcuts"),
                    presentation: (
                        icon: Some("📂"),
                    ),
                ),
                (
                    name: "view",
                    description: Some("View a shortcut in Shortcuts"),
                    presentation: (
                        icon: Some("🔍"),
                    ),
                ),
                (
                    name: "sign",
                    description: Some("Sign a shortcut file"),
                    presentation: (
                        icon: Some("🔏"),
                    ),
                ),
            ],
        ),
    ],
)
