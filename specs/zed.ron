(
    version: 1,
    command: "zed",
    description: Some("A lightning-fast, collaborative code editor written in Rust"),
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Print help information"),
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Print Zed's version and the app path"),
        ),
        (
            names: [
                "-w",
                "--wait",
            ],
            description: Some("Wait for all of the given paths to be closed before exiting"),
        ),
        (
            names: [
                "-b",
                "--bundle-path",
            ],
            description: Some("Custom Zed.app path"),
            arguments: [
                (
                    name: "bundle_path",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "path",
            description: Some("A sequence of space-separated paths that you want to open"),
            template: [
                FilePaths,
            ],
            optional: true,
            variadic: true,
        ),
    ],
)
