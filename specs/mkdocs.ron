(
    version: 1,
    command: "mkdocs",
    description: Some("Project documentation with Markdown"),
    subcommands: [
        (
            name: "build",
            description: Some("Build the MkDocs documentation"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("help for build"),
                ),
                (
                    names: [
                        "-q",
                        "--quiet",
                    ],
                    description: Some("Silence warnings"),
                ),
                (
                    names: [
                        "-v",
                        "--verbose",
                    ],
                    description: Some("Enable verbose output"),
                ),
                (
                    names: [
                        "-f",
                        "--config-file",
                    ],
                    description: Some("Provide a specific MkDocs config"),
                    arguments: [
                        (
                            name: "",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-s",
                        "--strict",
                    ],
                    description: Some("Enable strict mode. This will cause MkDocs to abort the build on any warnings"),
                ),
                (
                    names: [
                        "-t",
                        "--theme",
                    ],
                    description: Some("The theme to use when building your documentation"),
                    arguments: [
                        (
                            name: "theme",
                        ),
                    ],
                ),
                (
                    names: [
                        "--use-directory-urls",
                    ],
                    description: Some("Use directory URLs when building pages (the default)"),
                ),
                (
                    names: [
                        "--no-directory-urls",
                    ],
                    description: Some("Don't use directory URLs when building pages"),
                ),
                (
                    names: [
                        "-c",
                        "--clean",
                    ],
                    description: Some("Remove old files from the site directory before building (the default)"),
                ),
                (
                    names: [
                        "--dirty",
                    ],
                    description: Some("Only rebuild pages that have been modified since last build"),
                ),
                (
                    names: [
                        "-d",
                        "--site-dir",
                    ],
                    description: Some("The directory to output the result of the documentation build"),
                    arguments: [
                        (
                            name: "",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "gh-deploy",
            description: Some("Deploy your documentation to GitHub Pages"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("help for gh-deploy"),
                ),
                (
                    names: [
                        "-q",
                        "--quiet",
                    ],
                    description: Some("Silence warnings"),
                ),
                (
                    names: [
                        "-v",
                        "--verbose",
                    ],
                    description: Some("Enable verbose output"),
                ),
                (
                    names: [
                        "-f",
                        "--config-file",
                    ],
                    description: Some("Provide a specific MkDocs config"),
                    arguments: [
                        (
                            name: "",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-s",
                        "--strict",
                    ],
                    description: Some("Enable strict mode. This will cause MkDocs to abort the build on any warnings"),
                ),
                (
                    names: [
                        "-t",
                        "--theme",
                    ],
                    description: Some("The theme to use when building your documentation"),
                    arguments: [
                        (
                            name: "theme",
                        ),
                    ],
                ),
                (
                    names: [
                        "--use-directory-urls",
                    ],
                    description: Some("Use directory URLs when building pages (the default)"),
                ),
                (
                    names: [
                        "--no-directory-urls",
                    ],
                    description: Some("Don't use directory URLs when building pages"),
                ),
                (
                    names: [
                        "-c",
                        "--clean",
                    ],
                    description: Some("Remove old files from the site directory before building (the default)"),
                ),
                (
                    names: [
                        "--dirty",
                    ],
                    description: Some("Only rebuild pages that have been modified since last build"),
                ),
                (
                    names: [
                        "-m",
                        "--message",
                    ],
                    description: Some("A commit message to use when committing to the GitHub Pages remote branch. Commit {sha} and MkDocs {version} are available as expansions"),
                    arguments: [
                        (
                            name: "message",
                        ),
                    ],
                ),
                (
                    names: [
                        "-b",
                        "--remote-branch",
                    ],
                    description: Some("The remote branch to commit to for GitHub Pages. This overrides the value specified in config"),
                    arguments: [
                        (
                            name: "branch name",
                        ),
                    ],
                ),
                (
                    names: [
                        "-r",
                        "--remote-name",
                    ],
                    description: Some("The remote name to commit to for GitHub Pages. This overrides the value specified in config"),
                    arguments: [
                        (
                            name: "remote name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--force",
                    ],
                    description: Some("Force the push to the repository"),
                    presentation: (
                        dangerous: true,
                    ),
                ),
                (
                    names: [
                        "--no-history",
                    ],
                    description: Some("Replace the whole Git history with one new commit"),
                    presentation: (
                        dangerous: true,
                    ),
                ),
                (
                    names: [
                        "--ignore-version",
                    ],
                    description: Some("Ignore check that build is not being deployed with an older version of MkDocs"),
                ),
                (
                    names: [
                        "--shell",
                    ],
                    description: Some("Use the shell when invoking Git"),
                ),
            ],
        ),
        (
            name: "new",
            description: Some("Create a new MkDocs project"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("help for new"),
                ),
                (
                    names: [
                        "-q",
                        "--quiet",
                    ],
                    description: Some("Silence warnings"),
                ),
                (
                    names: [
                        "-v",
                        "--verbose",
                    ],
                    description: Some("Enable verbose output"),
                ),
            ],
            arguments: [
                (
                    name: "",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            name: "serve",
            description: Some("Run the builtin development server"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("help for serve"),
                ),
                (
                    names: [
                        "-q",
                        "--quiet",
                    ],
                    description: Some("Silence warnings"),
                ),
                (
                    names: [
                        "-v",
                        "--verbose",
                    ],
                    description: Some("Enable verbose output"),
                ),
                (
                    names: [
                        "-f",
                        "--config-file",
                    ],
                    description: Some("Provide a specific MkDocs config"),
                    arguments: [
                        (
                            name: "",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-s",
                        "--strict",
                    ],
                    description: Some("Enable strict mode. This will cause MkDocs to abort the build on any warnings"),
                ),
                (
                    names: [
                        "-t",
                        "--theme",
                    ],
                    description: Some("The theme to use when building your documentation"),
                    arguments: [
                        (
                            name: "theme",
                        ),
                    ],
                ),
                (
                    names: [
                        "--use-directory-urls",
                    ],
                    description: Some("Use directory URLs when building pages (the default)"),
                ),
                (
                    names: [
                        "--no-directory-urls",
                    ],
                    description: Some("Don't use directory URLs when building pages"),
                ),
                (
                    names: [
                        "-a",
                        "--dev-addr",
                    ],
                    description: Some("IP address and port to serve documentation locally (default: localhost:8000)"),
                    arguments: [
                        (
                            name: "IP:PORT",
                        ),
                    ],
                ),
                (
                    names: [
                        "--live-reload",
                    ],
                    description: Some("Enable the live reloading in the development server (this is the default)"),
                ),
                (
                    names: [
                        "--no-reload",
                    ],
                    description: Some("Disable the live reloading in the development server"),
                ),
                (
                    names: [
                        "--dirtyreload",
                    ],
                    description: Some("Enable the live reloading in the development server, but only re-build files that have changed"),
                ),
                (
                    names: [
                        "--watch-theme",
                    ],
                    description: Some("Include the theme in list of files to watch for live reloading. Ignored when live reload is not used"),
                ),
                (
                    names: [
                        "-w",
                        "--watch",
                    ],
                    description: Some("A directory or file to watch for live reloading. Can be supplied multiple times"),
                    arguments: [
                        (
                            name: "",
                            template: [
                                Folders,
                                FilePaths,
                            ],
                        ),
                    ],
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Show help message and exit"),
        ),
        (
            names: [
                "-V",
                "--version",
            ],
            description: Some("Show the version and exit"),
        ),
    ],
)
