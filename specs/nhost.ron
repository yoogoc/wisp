(
    version: 1,
    command: "nhost",
    description: Some("Nhost's command-line"),
    subcommands: [
        (
            name: "deploy",
            description: Some("Deploy local migrations and metadata changes to Nhost production"),
        ),
        (
            name: "dev",
            description: Some("Start Nhost project for local development"),
        ),
        (
            name: "down",
            description: Some("Stop and remove local Nhost backend started by `nhost dev`"),
        ),
        (
            name: "env",
            aliases: [
                "env:ls",
            ],
            description: Some("List environment variables"),
        ),
        (
            name: "env:pull",
            description: Some("Sync remote environment variables to your local environment"),
        ),
        (
            name: "help",
            description: Some("Display help for nhost"),
        ),
        (
            name: "init",
            description: Some("Initialize current working directory as a Nhost project"),
        ),
        (
            name: "link",
            description: Some("Link Nhost Project"),
        ),
        (
            name: "login",
            description: Some("Login to your Nhost account"),
            options: [
                (
                    names: [
                        "--email",
                        "-e",
                    ],
                    description: Some("Email address"),
                    arguments: [
                        (
                            name: "email",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "logout",
            description: Some("Logout from your Nhost account"),
        ),
    ],
)
