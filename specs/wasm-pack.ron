(
    version: 1,
    command: "wasm-pack",
    subcommands: [
        (
            name: "build",
            description: Some("Build an npm package"),
            presentation: (
                icon: Some("🏗️"),
            ),
        ),
        (
            name: "help",
            description: Some("Prints this message or the help of the given subcommand(s)"),
            arguments: [
                (
                    name: "subcommand",
                    template: [
                        Help,
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "login",
            aliases: [
                "adduser",
                "add-user",
            ],
            description: Some("Add an npm registry user account"),
            presentation: (
                icon: Some("👤"),
            ),
        ),
        (
            name: "new",
            description: Some("Create a new project with a template"),
            presentation: (
                icon: Some("🐑"),
            ),
        ),
        (
            name: "pack",
            description: Some("Create a tarball of the npm package (does not publish)"),
            presentation: (
                icon: Some("📦"),
            ),
        ),
        (
            name: "publish",
            description: Some("Pack and publish a package to npm"),
            presentation: (
                icon: Some("🎆"),
            ),
        ),
        (
            name: "test",
            description: Some("Run tests for WebAssembly module"),
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for wasm-pack or for the given subcommand(s)"),
        ),
        (
            names: [
                "--quiet",
                "-q",
            ],
            description: Some("Suppress output from stdout"),
        ),
        (
            names: [
                "--version",
                "-V",
            ],
            description: Some("Show version for wasm-pack"),
        ),
        (
            names: [
                "--verbose",
                "-v",
            ],
            description: Some("Log verbosity is based off the number of v used"),
        ),
        (
            names: [
                "--log-level",
                "-l",
            ],
            description: Some("The maximum level of messages that should be logged by wasm-pack"),
            arguments: [
                (
                    name: "log-level",
                    suggestions: [
                        (
                            name: "info",
                        ),
                        (
                            name: "warn",
                        ),
                        (
                            name: "error",
                        ),
                    ],
                    default: Some("info"),
                ),
            ],
        ),
    ],
)
