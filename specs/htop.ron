(
    version: 1,
    command: "htop",
    description: Some("Improved top (interactive process viewer)"),
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for htop"),
        ),
        (
            names: [
                "--no-color",
                "-C",
            ],
            description: Some("Use a monochrome color scheme"),
        ),
        (
            names: [
                "--delay",
                "-d",
            ],
            description: Some("Delay between updates, in tenths of sec"),
            arguments: [
                (
                    name: "delay",
                    suggestions: [
                        (
                            name: "10",
                        ),
                        (
                            name: "1",
                        ),
                        (
                            name: "60",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--filter",
                "-F",
            ],
            description: Some("Filter commands"),
            arguments: [
                (
                    name: "filter",
                ),
            ],
        ),
        (
            names: [
                "--highlight-changes",
                "-H",
            ],
            description: Some("Highlight new and old processes"),
            arguments: [
                (
                    name: "delay",
                    description: Some("Delay between updates of highlights, in tenths of sec"),
                    suggestions: [
                        (
                            name: "10",
                        ),
                        (
                            name: "1",
                        ),
                        (
                            name: "60",
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            names: [
                "--no-mouse",
                "-M",
            ],
            description: Some("Disable the mouse"),
        ),
        (
            names: [
                "--pid",
                "-p",
            ],
            description: Some("Show only the given PIDs"),
            arguments: [
                (
                    name: "PID",
                    variadic: true,
                ),
            ],
        ),
        (
            names: [
                "--sort-key",
                "-s",
            ],
            description: Some("Sort by COLUMN in list view"),
            arguments: [
                (
                    name: "column",
                ),
            ],
        ),
        (
            names: [
                "--tree",
                "-t",
            ],
            description: Some("Show the tree view"),
        ),
        (
            names: [
                "--user",
                "-u",
            ],
            description: Some("Show only processes for a given user (or $USER)"),
            arguments: [
                (
                    name: "user",
                    suggestions: [
                        (
                            name: "$USER",
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            names: [
                "--no-unicode",
                "-U",
            ],
            description: Some("Do not use unicode but plain ASCII"),
        ),
        (
            names: [
                "--version",
                "-V",
            ],
            description: Some("Print version info"),
        ),
    ],
)
