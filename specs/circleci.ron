(
    version: 1,
    command: "circleci",
    description: Some("CircleCI CLI"),
    subcommands: [
        (
            name: "completion",
            description: Some("Generate shell completion scripts"),
            subcommands: [
                (
                    name: "bash",
                    description: Some("Generate bash completion scripts"),
                ),
                (
                    name: "zsh",
                    description: Some("Generate zsh completion scripts"),
                ),
            ],
        ),
        (
            name: "config",
            description: Some("Operate on build config files"),
            subcommands: [
                (
                    name: "pack",
                    description: Some("Pack CircleCI config files into a single file"),
                ),
                (
                    name: "process",
                    description: Some("Validate and display extended config"),
                ),
                (
                    name: "validate",
                    description: Some("Checks that config is valid"),
                ),
            ],
        ),
        (
            name: "context",
            description: Some("Secure and share environment variables across projects"),
            subcommands: [
                (
                    name: "create",
                    description: Some("Create a new context"),
                    arguments: [
                        (
                            name: "vcs-type",
                            description: Some("Your VCS provider, can be either 'github' or 'bitbucket'"),
                            suggestions: [
                                (
                                    name: "github",
                                ),
                                (
                                    name: "bitbucket",
                                ),
                            ],
                            optional: true,
                        ),
                        (
                            name: "org-name",
                            description: Some("The name of your organization"),
                            optional: true,
                        ),
                        (
                            name: "context-name",
                            description: Some("The name for your context"),
                        ),
                    ],
                ),
                (
                    name: "delete",
                    description: Some("Delete the named context"),
                    arguments: [
                        (
                            name: "vcs-type",
                            description: Some("Your VCS provider, can be either 'github' or 'bitbucket'"),
                            suggestions: [
                                (
                                    name: "github",
                                ),
                                (
                                    name: "bitbucket",
                                ),
                            ],
                        ),
                        (
                            name: "org-name",
                            description: Some("The name of your organization"),
                        ),
                        (
                            name: "context-name",
                            description: Some("The name for your context"),
                        ),
                    ],
                ),
                (
                    name: "list",
                    description: Some("List all contexts"),
                    arguments: [
                        (
                            name: "vcs-type",
                            description: Some("Your VCS provider, can be either 'github' or 'bitbucket'"),
                            suggestions: [
                                (
                                    name: "github",
                                ),
                                (
                                    name: "bitbucket",
                                ),
                            ],
                        ),
                        (
                            name: "org-name",
                            description: Some("The name of your organization"),
                        ),
                    ],
                ),
                (
                    name: "remove-secret",
                    description: Some("Remove environment variable from a context"),
                    arguments: [
                        (
                            name: "vcs-type",
                            description: Some("Your VCS provider, can be either 'github' or 'bitbucket'"),
                            suggestions: [
                                (
                                    name: "github",
                                ),
                                (
                                    name: "bitbucket",
                                ),
                            ],
                        ),
                        (
                            name: "org-name",
                            description: Some("The name of your organization"),
                        ),
                        (
                            name: "context-name",
                            description: Some("The name for your context"),
                        ),
                        (
                            name: "secret name",
                            description: Some("The name of the env variable to remove"),
                        ),
                    ],
                ),
                (
                    name: "show",
                    description: Some("Show a context"),
                    arguments: [
                        (
                            name: "vcs-type",
                            description: Some("Your VCS provider, can be either 'github' or 'bitbucket'"),
                            suggestions: [
                                (
                                    name: "github",
                                ),
                                (
                                    name: "bitbucket",
                                ),
                            ],
                        ),
                        (
                            name: "org-name",
                            description: Some("The name of your organization"),
                        ),
                        (
                            name: "context-name",
                            description: Some("The name for your context"),
                        ),
                    ],
                ),
                (
                    name: "store-secret",
                    description: Some("Store environment variables"),
                    arguments: [
                        (
                            name: "vcs-type",
                            description: Some("Your VCS provider, can be either 'github' or 'bitbucket'"),
                            suggestions: [
                                (
                                    name: "github",
                                ),
                                (
                                    name: "bitbucket",
                                ),
                            ],
                        ),
                        (
                            name: "org-name",
                            description: Some("The name of your organization"),
                        ),
                        (
                            name: "context-name",
                            description: Some("The name for your context"),
                        ),
                        (
                            name: "secret name",
                            description: Some("The name of the env variable to store"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "diagnostic",
            description: Some("Check the status of your CircleCI CLI"),
        ),
        (
            name: "follow",
            description: Some("Attempt to follow the project for the current git repo"),
        ),
        (
            name: "help",
            description: Some("Help about any command"),
        ),
        (
            name: "local",
            description: Some("Debug jobs on the local machine"),
            subcommands: [
                (
                    name: "execute",
                    description: Some("Run a job in a container on the local machine"),
                ),
            ],
        ),
        (
            name: "namespace",
            description: Some("Operate on namespaces"),
            subcommands: [
                (
                    name: "create",
                    description: Some("Create a namespace"),
                ),
            ],
        ),
        (
            name: "open",
            description: Some("Open the current project in the browser"),
        ),
        (
            name: "orb",
            description: Some("Operate on orbs"),
            subcommands: [
                (
                    name: "add-to-category",
                    description: Some("Add an orb to a category"),
                    arguments: [
                        (
                            name: "namespace/orb",
                            description: Some("The namespace and orb to add to a category"),
                        ),
                        (
                            name: "category name",
                            description: Some("The name of the category to add the orb to, in quotes"),
                        ),
                    ],
                ),
                (
                    name: "create",
                    description: Some("Create an orb in a namespace"),
                    options: [
                        (
                            names: [
                                "--private",
                            ],
                            description: Some("Specify that this orb is for private use within your org, unlisted from the public registry"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "namespace/orb",
                            description: Some("Create an orb in the specified namespace"),
                        ),
                    ],
                ),
                (
                    name: "info",
                    description: Some("Show metadata of an orb"),
                    arguments: [
                        (
                            name: "orb",
                            description: Some("The namespace and orb to show metadata for"),
                        ),
                    ],
                ),
                (
                    name: "init",
                    description: Some("Initialize a new orb"),
                    options: [
                        (
                            names: [
                                "--private",
                            ],
                            description: Some("Specify that this orb is for private use within your org, unlisted from the public registry"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "path",
                            description: Some("The /path/to/myProject-orb"),
                        ),
                    ],
                ),
                (
                    name: "list",
                    description: Some("List orbs"),
                    options: [
                        (
                            names: [
                                "--private",
                            ],
                            description: Some("Specify that this orb is for private use within your org, unlisted from the public registry"),
                        ),
                        (
                            names: [
                                "--sort",
                            ],
                            description: Some("Specify the sorting"),
                            arguments: [
                                (
                                    name: "",
                                    suggestions: [
                                        (
                                            name: "builds",
                                        ),
                                        (
                                            name: "projects",
                                        ),
                                        (
                                            name: "orgs",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-u",
                                "--uncertified",
                            ],
                            description: Some("Include uncertified orbs"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "namespace",
                            description: Some("The namespace used for the orb (i.e. circleci)"),
                        ),
                    ],
                ),
                (
                    name: "list-categories",
                    description: Some("List orb categories"),
                ),
                (
                    name: "pack",
                    description: Some("Pack an orb with local scripts"),
                    arguments: [
                        (
                            name: "path",
                            description: Some("The /path/to/myProject-orb"),
                        ),
                    ],
                ),
                (
                    name: "process",
                    description: Some("Validate an orb and print its form after all pre-registration processing is complete"),
                    arguments: [
                        (
                            name: "path",
                            description: Some("The path to your orb (use '-' for STDIN)"),
                        ),
                    ],
                ),
                (
                    name: "publish",
                    description: Some("Publish an orb to the registry"),
                    arguments: [
                        (
                            name: "path",
                            description: Some("The /path/to/myProject-orb"),
                        ),
                        (
                            name: "orb",
                            description: Some("A fully-qualified reference to an orb, i.e. namespace/orb@version"),
                        ),
                    ],
                ),
                (
                    name: "remove-from-category",
                    description: Some("Remove an orb from a category"),
                    arguments: [
                        (
                            name: "namespace/orb",
                            description: Some("The namespace and orb to add to a category"),
                        ),
                        (
                            name: "category name",
                            description: Some("The name of the category to add the orb to, in quotes"),
                        ),
                    ],
                ),
                (
                    name: "source",
                    description: Some("Show source code of an orb"),
                    arguments: [
                        (
                            name: "orb",
                            description: Some("A fully-qualified reference to an orb, i.e. namespace/orb@version"),
                        ),
                    ],
                ),
                (
                    name: "unlist",
                    description: Some("Disable/enable an orb's listing in the registry"),
                    arguments: [
                        (
                            name: "namespace/orb",
                            description: Some("The namespace and orb to unlist/list from the registry"),
                        ),
                        (
                            name: "condition",
                            description: Some("Use either true|false"),
                            suggestions: [
                                (
                                    name: "true",
                                ),
                                (
                                    name: "false",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "validate",
                    description: Some("Validate an orb.yml"),
                    arguments: [
                        (
                            name: "path",
                            description: Some("The /path/to/myProject-orb"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "policy",
            description: Some("Manage security policies"),
            subcommands: [
                (
                    name: "decide",
                    description: Some("Make a decision"),
                    options: [
                        (
                            names: [
                                "--input",
                            ],
                            description: Some("Path to input file, i.e. ./.circleci/config.yml"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--metafile",
                            ],
                            description: Some("Path to decision metadata file"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--owner-id",
                            ],
                            description: Some("The id of the policy's owner"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--strict",
                            ],
                            description: Some("Return non-zero status code for decision resulting in HARD_FAIL"),
                        ),
                        (
                            names: [
                                "--context",
                            ],
                            description: Some("Policy context for decision, default is 'config'"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                        ),
                    ],
                    arguments: [
                        (
                            name: "path",
                            description: Some("Policy file or directory path"),
                        ),
                    ],
                ),
                (
                    name: "diff",
                    description: Some("Get diff between local and remote policy bundles"),
                    options: [
                        (
                            names: [
                                "--context",
                            ],
                            description: Some("Policy context for decision, default is 'config'"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--owner-id",
                            ],
                            description: Some("The id of the policy's owner"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                        ),
                    ],
                    arguments: [
                        (
                            name: "policy_dir_path",
                            description: Some("Policy file or directory path"),
                        ),
                    ],
                ),
                (
                    name: "eval",
                    description: Some("Perform raw opa evaluation locally"),
                    options: [
                        (
                            names: [
                                "--input",
                            ],
                            description: Some("Path to input file, i.e. ./.circleci/config.yml"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--metafile",
                            ],
                            description: Some("Path to decision metadata file"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--query",
                            ],
                            description: Some("Policy decision query, default is 'data'"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                        ),
                    ],
                    arguments: [
                        (
                            name: "policy_dir_path",
                            description: Some("Policy file or directory path"),
                        ),
                    ],
                ),
                (
                    name: "fetch",
                    description: Some("Fetch policy bundle (or a single policy)"),
                    options: [
                        (
                            names: [
                                "--context",
                            ],
                            description: Some("Policy context for decision, default is 'config'"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--owner-id",
                            ],
                            description: Some("The id of the policy's owner"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "policy name",
                            description: Some("Name of policy to fetch"),
                        ),
                    ],
                ),
                (
                    name: "logs",
                    description: Some("Get policy decision logs / decision log (or policy bundle) by decision ID"),
                    options: [
                        (
                            names: [
                                "--after",
                            ],
                            description: Some("Filter decision logs triggered AFTER this datetime"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--before",
                            ],
                            description: Some("Filter decision logs triggered BEFORE this datetime"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--branch",
                            ],
                            description: Some("Filter decision logs based on branch name"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--context",
                            ],
                            description: Some("Policy context for decision, default is 'config'"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--owner-id",
                            ],
                            description: Some("The id of the policy's owner"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--out",
                            ],
                            description: Some("Specify output file name"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--policy-bundle",
                            ],
                            description: Some("Get only the policy bundle for given decisionID"),
                        ),
                        (
                            names: [
                                "--project-id",
                            ],
                            description: Some("Filter decision logs based on project-id"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--status",
                            ],
                            description: Some("Filter decision logs based on their status"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                        ),
                    ],
                    arguments: [
                        (
                            name: "decision ID",
                            description: Some("Decision ID to get logs for"),
                        ),
                    ],
                ),
                (
                    name: "push",
                    description: Some("Push policy bundle (or a single policy)"),
                    options: [
                        (
                            names: [
                                "--context",
                            ],
                            description: Some("Policy context for decision, default is 'config'"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--owner-id",
                            ],
                            description: Some("The id of the policy's owner"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--no-prompt",
                            ],
                            description: Some("Removes the prompt"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "policy_dir_path",
                            description: Some("Policy file or directory path"),
                        ),
                    ],
                ),
                (
                    name: "settings",
                    description: Some("Get/set policy decision settings (To read settings: run command without any settings flags)"),
                    options: [
                        (
                            names: [
                                "--context",
                            ],
                            description: Some("Policy context for decision, default is 'config'"),
                        ),
                        (
                            names: [
                                "--enabled",
                            ],
                            description: Some("Enable/disable policy decision evaluation in build pipeline"),
                            arguments: [
                                (
                                    name: "boolean",
                                    suggestions: [
                                        (
                                            name: "true",
                                        ),
                                        (
                                            name: "false",
                                        ),
                                    ],
                                    optional: true,
                                ),
                            ],
                            requires_separator: Some("="),
                        ),
                        (
                            names: [
                                "--owner-id",
                            ],
                            description: Some("The id of the policy's owner"),
                            arguments: [
                                (
                                    name: "string",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "runner",
            description: Some("Operate on runners"),
            subcommands: [
                (
                    name: "instance",
                    description: Some("Operate on runner instances"),
                ),
                (
                    name: "resource-class",
                    description: Some("Operate on runner resource-classes"),
                ),
                (
                    name: "token",
                    description: Some("Operate on runner tokens"),
                ),
            ],
        ),
        (
            name: "setup",
            description: Some("Setup CLI with your credentials"),
        ),
        (
            name: "update",
            description: Some("Update and switch to new CLI version"),
            subcommands: [
                (
                    name: "check",
                    description: Some("Check for new CLI version"),
                ),
                (
                    name: "install",
                    description: Some("Install new CLI version"),
                ),
            ],
        ),
        (
            name: "version",
            description: Some("Display CircleCI CLI version"),
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for CircleCI"),
            persistent: true,
        ),
        (
            names: [
                "--skip-update-check",
            ],
            description: Some("Skip update check before every command"),
            persistent: true,
        ),
    ],
)
