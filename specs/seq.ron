(
    version: 1,
    command: "seq",
    description: Some("Print sequences of numbers. (Defaults to increments of 1)"),
    options: [
        (
            names: [
                "-w",
                "--fixed-width",
            ],
            description: Some("Equalize the widths of all numbers by padding with zeros as necessary"),
        ),
        (
            names: [
                "-s",
                "--separator",
            ],
            description: Some("String separator between numbers. Default is newline"),
            arguments: [
                (
                    name: "string",
                    description: Some("Separator"),
                ),
            ],
            presentation: (
                insert_value: Some("-s \"{cursor}\""),
            ),
        ),
        (
            names: [
                "-f",
                "--format",
            ],
            description: Some("Use a printf(3) style format to print each number"),
            arguments: [
                (
                    name: "format",
                    description: Some("Print all numbers using format"),
                ),
            ],
            presentation: (
                insert_value: Some("-f %{cursor}"),
            ),
        ),
        (
            names: [
                "-t",
                "--terminator",
            ],
            description: Some("Use string to terminate sequence of numbers"),
            arguments: [
                (
                    name: "string",
                    description: Some("Terminator"),
                ),
            ],
            presentation: (
                insert_value: Some("-t \"{cursor}\""),
            ),
        ),
    ],
    arguments: [
        (
            name: "first",
            description: Some("Starting number in sequence"),
        ),
        (
            name: "step",
            description: Some("Increment interval"),
            optional: true,
        ),
        (
            name: "last",
            description: Some("Last number in sequence"),
            optional: true,
        ),
    ],
)
