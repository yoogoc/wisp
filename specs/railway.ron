(
    version: 1,
    command: "railway",
    description: Some("CLI for managing Railway Apps"),
    subcommands: [
        (
            name: "add",
            description: Some("Add a plugin to your project"),
        ),
        (
            name: "completion",
            description: Some("Generate shell-completions"),
            arguments: [
                (
                    name: "shell",
                    description: Some("The shell to generate completions for"),
                    suggestions: [
                        (
                            name: "bash",
                        ),
                        (
                            name: "zsh",
                        ),
                        (
                            name: "fish",
                        ),
                        (
                            name: "powershell",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "connect",
            description: Some("Connect to a plugin"),
            arguments: [
                (
                    name: "plugin",
                    description: Some("The plugin to connect to"),
                    suggestions: [
                        (
                            name: "postgresql",
                        ),
                        (
                            name: "mysql",
                        ),
                        (
                            name: "redis",
                        ),
                        (
                            name: "mongodb",
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "delete",
            description: Some("Delete a project"),
            arguments: [
                (
                    name: "project-id",
                    description: Some("The project to delete"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "docs",
            description: Some("Open Railway Documentation in default browser"),
        ),
        (
            name: "down",
            description: Some("Remove the most recent deployment"),
            options: [
                (
                    names: [
                        "-e",
                        "--environment",
                    ],
                    description: Some("Environment to delete from"),
                    arguments: [
                        (
                            name: "",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "environment",
            description: Some("Change your environment"),
            arguments: [
                (
                    name: "environment",
                    description: Some("The environment to change to"),
                    suggestions: [
                        (
                            name: "production",
                        ),
                        (
                            name: "preview",
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "help",
            description: Some("Get help about any command"),
            arguments: [
                (
                    name: "command",
                    description: Some("The command to get help about"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "init",
            description: Some("Create a new railway project"),
        ),
        (
            name: "link",
            description: Some("Connect to an existing railway project"),
            arguments: [
                (
                    name: "project-id",
                    description: Some("The project to link to"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "list",
            description: Some("List all railway projects"),
        ),
        (
            name: "login",
            description: Some("Login to railway"),
            options: [
                (
                    names: [
                        "--browserless",
                    ],
                    description: Some("Login without opening a browser"),
                ),
            ],
        ),
        (
            name: "logout",
            description: Some("Logout of railway"),
        ),
        (
            name: "logs",
            description: Some("Show logs for the most-recent deployment"),
            options: [
                (
                    names: [
                        "-n",
                        "--lines",
                    ],
                    description: Some("Output a specific number of lines"),
                    arguments: [
                        (
                            name: "Number of lines",
                            description: Some("The number of lines to output"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "open",
            description: Some("Open the project"),
            subcommands: [
                (
                    name: "live",
                    description: Some("Open the live project"),
                ),
                (
                    name: "metrics",
                    description: Some("Open project metrics"),
                ),
                (
                    name: "settings",
                    description: Some("Open project settings"),
                ),
            ],
        ),
        (
            name: "run",
            description: Some("Run a local command using variables from the active environment"),
            options: [
                (
                    names: [
                        "-e",
                        "--environment",
                    ],
                    description: Some("Environment to run in"),
                    arguments: [
                        (
                            name: "",
                        ),
                    ],
                ),
                (
                    names: [
                        "-s",
                        "--service",
                    ],
                    description: Some("Define specific service"),
                    arguments: [
                        (
                            name: "Service name",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "shell",
            description: Some("Open a subshell with Railway variables available"),
            options: [
                (
                    names: [
                        "-s",
                        "--service",
                    ],
                    description: Some("Deploy app to specific service"),
                    arguments: [
                        (
                            name: "Service name",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "status",
            description: Some("View the status of railway project"),
        ),
        (
            name: "unlink",
            description: Some("Disconnects the current directory from a Railway project"),
        ),
        (
            name: "up",
            description: Some("Deploy to railway"),
            options: [
                (
                    names: [
                        "-d",
                        "--detach",
                    ],
                    description: Some("Detach from build logs"),
                ),
                (
                    names: [
                        "-e",
                        "--environment",
                    ],
                    description: Some("Environment to run in"),
                ),
                (
                    names: [
                        "-s",
                        "--service",
                    ],
                    description: Some("Deploy app to specific service"),
                    arguments: [
                        (
                            name: "Service name",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "path",
                    description: Some("Path to deploy to"),
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "variables",
            description: Some("Work with environment variables"),
            subcommands: [
                (
                    name: "delete",
                    description: Some("Delete variable"),
                    arguments: [
                        (
                            name: "variable",
                            description: Some("The name of the variable you want to delete"),
                        ),
                    ],
                ),
                (
                    name: "get",
                    description: Some("Get variable value"),
                    arguments: [
                        (
                            name: "variable",
                            description: Some("The name of the variable you want to get"),
                        ),
                    ],
                ),
                (
                    name: "set",
                    description: Some("Set variable value"),
                    arguments: [
                        (
                            name: "variable",
                            description: Some("The name of the variable you want to set"),
                        ),
                        (
                            name: "value",
                            description: Some("Value of the variable"),
                        ),
                    ],
                ),
            ],
            options: [
                (
                    names: [
                        "-e",
                        "--environment",
                    ],
                    description: Some("Environment"),
                ),
                (
                    names: [
                        "-s",
                        "--service",
                    ],
                    description: Some("Deploy app to specific service"),
                    arguments: [
                        (
                            name: "Service name",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "version",
            description: Some("Get the version of railway's CLI"),
        ),
        (
            name: "whoami",
            description: Some("Get the logged in user"),
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for railway"),
        ),
        (
            names: [
                "--version",
                "-V",
            ],
            description: Some("Show railway version"),
        ),
        (
            names: [
                "--verbose",
                "-v",
            ],
            description: Some("Enable verbose output"),
        ),
    ],
)
