(
    version: 1,
    command: "hexo",
    description: Some("Command line interface for Hexo, a static site generator"),
    subcommands: [
        (
            name: "config",
            description: Some("Get or set configurations"),
            arguments: [
                (
                    name: "name",
                    description: Some("Setting name. Leave it blank if you want to show all configurations"),
                    optional: true,
                ),
                (
                    name: "value",
                    description: Some("New value of a setting. Leave it blank if you just want to show a single configuration"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "help",
            description: Some("Displays a help for each command"),
            arguments: [
                (
                    name: "command",
                    description: Some("The command to display help for"),
                    template: [
                        Help,
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "init",
            description: Some("Create a new Hexo folder"),
            options: [
                (
                    names: [
                        "--no-clone",
                    ],
                    description: Some("Copy files instead of cloning from GitHub"),
                ),
                (
                    names: [
                        "--no-install",
                    ],
                    description: Some("Skip npm install"),
                ),
            ],
            arguments: [
                (
                    name: "destination",
                    description: Some("Folder path. Initialize in current folder if not specified"),
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "new",
            description: Some("Create a new article"),
            options: [
                (
                    names: [
                        "-p",
                        "--path",
                    ],
                    description: Some("Post path. Customize the path of the post"),
                    arguments: [
                        (
                            name: "path",
                            description: Some("The path of the post"),
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-r",
                        "--replace",
                    ],
                    description: Some("Replace the current post if it existed"),
                ),
                (
                    names: [
                        "-s",
                        "--slug",
                    ],
                    description: Some("Post slug. Customize the URL of the post"),
                    arguments: [
                        (
                            name: "slug",
                            description: Some("The slug of the post"),
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "layout",
                    description: Some("The layout to use"),
                    suggestions: [
                        (
                            name: "post",
                        ),
                        (
                            name: "page",
                        ),
                        (
                            name: "draft",
                        ),
                    ],
                    optional: true,
                ),
                (
                    name: "title",
                    description: Some("The title of the post"),
                ),
            ],
        ),
        (
            name: "generate",
            description: Some("Generate static files"),
            options: [
                (
                    names: [
                        "-d",
                        "--deploy",
                    ],
                    description: Some("Deploy after generation finishes"),
                ),
                (
                    names: [
                        "-f",
                        "--force",
                    ],
                    description: Some("Force regenerate"),
                ),
                (
                    names: [
                        "-w",
                        "--watch",
                    ],
                    description: Some("Watch file changes"),
                ),
                (
                    names: [
                        "-b",
                        "--bail",
                    ],
                    description: Some("Raise an error if any unhandled exception is thrown during generation"),
                ),
                (
                    names: [
                        "-c",
                        "--concurrency",
                    ],
                    description: Some("Maximum number of files to be generated in parallel. Default is infinity"),
                    arguments: [
                        (
                            name: "concurrency",
                            description: Some("The number of files to generate in parallel"),
                            optional: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "publish",
            description: Some("Publish a draft"),
            arguments: [
                (
                    name: "layout",
                    description: Some("The layout to use"),
                    suggestions: [
                        (
                            name: "post",
                        ),
                        (
                            name: "page",
                        ),
                        (
                            name: "draft",
                        ),
                    ],
                    optional: true,
                ),
                (
                    name: "filename",
                    description: Some("The name of the post"),
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "hexo list post | grep -E ^Draft",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "server",
            description: Some("Start a local server. By default, this is at http://localhost:4000/"),
            options: [
                (
                    names: [
                        "-i",
                        "--ip",
                    ],
                    description: Some("Override the default server IP. Bind to all IP address by default"),
                    arguments: [
                        (
                            name: "ip",
                            description: Some("The IP address to bind to"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-p",
                        "--port",
                    ],
                    description: Some("Override default port"),
                    arguments: [
                        (
                            name: "port",
                            description: Some("Only serve static files"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-s",
                        "--static",
                    ],
                    description: Some("Serve static files from the given directory"),
                ),
                (
                    names: [
                        "-l",
                        "--log",
                    ],
                    description: Some("Enable logger. Override logger format"),
                    arguments: [
                        (
                            name: "format",
                            description: Some("The morgan logger format. Can be predefined or customized"),
                            suggestions: [
                                (
                                    name: "combined",
                                ),
                                (
                                    name: "common",
                                ),
                                (
                                    name: "tiny",
                                ),
                                (
                                    name: "dev",
                                ),
                                (
                                    name: "short",
                                ),
                            ],
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "-o",
                        "--open",
                    ],
                    description: Some("Immediately open the server url in your default web browser"),
                ),
            ],
        ),
        (
            name: "deploy",
            description: Some("Deploy your website"),
            options: [
                (
                    names: [
                        "--setup",
                    ],
                    description: Some("Setup without deployment"),
                ),
                (
                    names: [
                        "-g",
                        "--generate",
                    ],
                    description: Some("Generate static files before deploying"),
                ),
            ],
        ),
        (
            name: "render",
            description: Some("Render files with renderer plugins (e.g. Markdown) and save them at the specified path"),
            options: [
                (
                    names: [
                        "--engine",
                    ],
                    description: Some("Specify render engine"),
                ),
                (
                    names: [
                        "-o",
                        "--output",
                    ],
                    description: Some("Output destination. Result will be printed in the terminal if the output destination is not set"),
                    arguments: [
                        (
                            name: "output directory",
                            description: Some("The path to output directory"),
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--pretty",
                    ],
                    description: Some("Prettify JSON output"),
                ),
            ],
            arguments: [
                (
                    name: "file",
                    description: Some("The file to render"),
                    template: [
                        FilePaths,
                    ],
                    variadic: true,
                ),
            ],
        ),
        (
            name: "migrate",
            description: Some("Migrate content from other blog systems"),
            arguments: [
                (
                    name: "type",
                    description: Some("The type of migration. check https://hexo.io/docs/migration for more details"),
                ),
            ],
        ),
        (
            name: "clean",
            description: Some("Clean the cache file (`db.json`) and generated files (`public`)"),
        ),
        (
            name: "list",
            description: Some("List all routes"),
            arguments: [
                (
                    name: "type",
                    description: Some("The type of routes to list"),
                    suggestions: [
                        (
                            name: "post",
                        ),
                        (
                            name: "route",
                        ),
                        (
                            name: "page",
                        ),
                        (
                            name: "tag",
                        ),
                        (
                            name: "category",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "version",
            description: Some("Display version information"),
        ),
    ],
    options: [
        (
            names: [
                "--config",
            ],
            description: Some("Uses a custom config file (instead of `_config.yml`). Also accepts a comma-separated list (no spaces) of JSON or YAML config files that will combine the files into a single `_multiconfig.yml`"),
            arguments: [
                (
                    name: "config file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--safe",
            ],
            description: Some("Disable loading plugins and scripts"),
            persistent: true,
        ),
        (
            names: [
                "--debug",
            ],
            description: Some("Log verbose messages to the terminal and to `debug.log`"),
            persistent: true,
        ),
        (
            names: [
                "--silent",
            ],
            description: Some("Silence output to the terminal"),
            persistent: true,
        ),
        (
            names: [
                "--draft",
            ],
            description: Some("Display draft posts (stored in the `source/_drafts` folder)"),
            persistent: true,
        ),
        (
            names: [
                "--cwd",
            ],
            description: Some("Customize the path of current working directory"),
            arguments: [
                (
                    name: "directory",
                    template: [
                        Folders,
                    ],
                ),
            ],
            persistent: true,
        ),
    ],
)
