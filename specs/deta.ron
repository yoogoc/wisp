(
    version: 1,
    command: "deta",
    description: Some("Deta CLI for managing Deta Micros"),
    subcommands: [
        (
            name: "login",
            description: Some("Trigger the login process for the Deta CLI"),
            options: [
                (
                    names: [
                        "-h",
                    ],
                    description: Some("Show help for login"),
                ),
            ],
        ),
        (
            name: "version",
            description: Some("Print the Deta version"),
            subcommands: [
                (
                    name: "upgrade",
                    description: Some("Upgrade Deta CLI version"),
                    options: [
                        (
                            names: [
                                "-h",
                            ],
                            description: Some("Show help for upgrade"),
                        ),
                        (
                            names: [
                                "-v",
                            ],
                            description: Some("Upgrade CLI to specific version"),
                            arguments: [
                                (
                                    name: "Version number",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
            options: [
                (
                    names: [
                        "-h",
                    ],
                    description: Some("Show help for version"),
                ),
            ],
        ),
        (
            name: "projects",
            description: Some("List Deta projects"),
            options: [
                (
                    names: [
                        "-h",
                    ],
                    description: Some("Show help for projects"),
                ),
            ],
        ),
        (
            name: "new",
            description: Some("Create a new Deta Micro"),
            options: [
                (
                    names: [
                        "-h",
                    ],
                    description: Some("Show help for new"),
                ),
                (
                    names: [
                        "-n",
                    ],
                    description: Some("Create a micro with Node (node14.x) runtime"),
                ),
                (
                    names: [
                        "-p",
                    ],
                    description: Some("Create a micro with Python (python 3.9) runtime"),
                ),
                (
                    names: [
                        "--name",
                    ],
                    description: Some("Set the name of the new micro"),
                    arguments: [
                        (
                            name: "name",
                            description: Some("Name of the new micro"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--project",
                    ],
                    description: Some("Set the project under which the micro is created"),
                    arguments: [
                        (
                            name: "project",
                            description: Some("Name of the existing project"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--runtime",
                    ],
                    description: Some("Create a micro with a specified runtime"),
                    arguments: [
                        (
                            name: "runtime",
                            description: Some("The selected runtime"),
                            suggestions: [
                                (
                                    name: "node12",
                                    description: Some("Runtime"),
                                ),
                                (
                                    name: "node14",
                                    description: Some("Runtime"),
                                ),
                                (
                                    name: "python3.7",
                                    description: Some("Runtime"),
                                ),
                                (
                                    name: "python3.9",
                                    description: Some("Runtime"),
                                ),
                            ],
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "path",
                    description: Some("Path to new directory for the micro"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "deploy",
            description: Some("Deploy new code to a Deta Micro"),
            options: [
                (
                    names: [
                        "-h",
                    ],
                    description: Some("Show help for deploy"),
                ),
            ],
            arguments: [
                (
                    name: "path",
                    description: Some("Path to project directory"),
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "details",
            description: Some("Get detailed information about a specific Deta micro"),
            options: [
                (
                    names: [
                        "-h",
                    ],
                    description: Some("Show help for details"),
                ),
            ],
            arguments: [
                (
                    name: "path",
                    description: Some("Path to project directory"),
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "watch",
            description: Some("Auto-deploy locally saved changes in real time to your Deta micro"),
            options: [
                (
                    names: [
                        "-h",
                    ],
                    description: Some("Show help for watch"),
                ),
            ],
            arguments: [
                (
                    name: "path",
                    description: Some("Path to project directory"),
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "auth",
            description: Some("Change auth settings for a Deta Micro"),
            subcommands: [
                (
                    name: "disable",
                    description: Some("Disable HTTP Auth for a Deta Micro"),
                    options: [
                        (
                            names: [
                                "-h",
                            ],
                            description: Some("Show help for auth disable"),
                        ),
                    ],
                ),
                (
                    name: "enable",
                    description: Some("Enable HTTP Auth for a Deta Micro"),
                    options: [
                        (
                            names: [
                                "-h",
                            ],
                            description: Some("Show help for auth enable"),
                        ),
                    ],
                ),
                (
                    name: "create-api-key",
                    description: Some("Create an API key for a Deta Micro"),
                    options: [
                        (
                            names: [
                                "-h",
                            ],
                            description: Some("Show help for auth create-api-key"),
                        ),
                        (
                            names: [
                                "-d",
                            ],
                            description: Some("Set the api-key description"),
                            arguments: [
                                (
                                    name: "description",
                                    description: Some("The api-key description"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-n",
                            ],
                            description: Some("Set the api-key name"),
                            arguments: [
                                (
                                    name: "name",
                                    description: Some("The api-key name"),
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "-o",
                            ],
                            description: Some("Set the api-key output file"),
                            arguments: [
                                (
                                    name: "outfile",
                                    description: Some("The api-key output file"),
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "delete-api-key",
                    description: Some("Delete an API key for a Deta Micro"),
                    options: [
                        (
                            names: [
                                "-h",
                            ],
                            description: Some("Show help for auth delete-api-key"),
                        ),
                        (
                            names: [
                                "-n",
                            ],
                            description: Some("Set the api-key name"),
                            arguments: [
                                (
                                    name: "name",
                                    description: Some("The api-key name"),
                                ),
                            ],
                            required: true,
                        ),
                    ],
                ),
            ],
            options: [
                (
                    names: [
                        "-h",
                    ],
                    description: Some("Show help for auth"),
                ),
            ],
        ),
        (
            name: "pull",
            description: Some("Pull the latest deployed code of a Deta Micro to your local machine"),
            options: [
                (
                    names: [
                        "-h",
                    ],
                    description: Some("Show help for pull"),
                ),
                (
                    names: [
                        "-f",
                    ],
                    description: Some("Force the overwrite of existing files"),
                ),
            ],
        ),
        (
            name: "clone",
            description: Some("Clone a Deta Micro"),
            options: [
                (
                    names: [
                        "-h",
                    ],
                    description: Some("Show help for clone"),
                ),
                (
                    names: [
                        "-n",
                    ],
                    description: Some("The name of the micro to be cloned"),
                    arguments: [
                        (
                            name: "name",
                            description: Some("Name of the micro"),
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "-p",
                    ],
                    description: Some("The name of the project with the micro to be cloned"),
                    arguments: [
                        (
                            name: "project",
                            description: Some("Name of the project"),
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "path",
                    description: Some("Path to new directory for the clone"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "update",
            description: Some("Update a Deta Micro's name or environment variables"),
            options: [
                (
                    names: [
                        "-h",
                    ],
                    description: Some("Show help for pull"),
                ),
                (
                    names: [
                        "-n",
                    ],
                    description: Some("The new name of the micro"),
                    arguments: [
                        (
                            name: "name",
                            description: Some("New name for the micro"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-r",
                    ],
                    description: Some("The new runtime of the micro"),
                    arguments: [
                        (
                            name: "runtime",
                            description: Some("New runtime for the micro"),
                            suggestions: [
                                (
                                    name: "node12",
                                    description: Some("Runtime"),
                                ),
                                (
                                    name: "node14",
                                    description: Some("Runtime"),
                                ),
                                (
                                    name: "python3.7",
                                    description: Some("Runtime"),
                                ),
                                (
                                    name: "python3.9",
                                    description: Some("Runtime"),
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-e",
                    ],
                    description: Some("The new env file of the micro"),
                    arguments: [
                        (
                            name: "env",
                            description: Some("Path to env file"),
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "visor",
            description: Some("Change the Visor settings for a Deta Micro"),
            subcommands: [
                (
                    name: "open",
                    description: Some("Open Micro's visor page in the browser"),
                    options: [
                        (
                            names: [
                                "-h",
                            ],
                            description: Some("Show help for visor open"),
                        ),
                    ],
                ),
                (
                    name: "enable",
                    description: Some("Enable Visor for a Deta Micro"),
                    options: [
                        (
                            names: [
                                "-h",
                            ],
                            description: Some("Show help for visor enable"),
                        ),
                    ],
                ),
                (
                    name: "disable",
                    description: Some("Disable Visor for a Deta Micro"),
                    options: [
                        (
                            names: [
                                "-h",
                            ],
                            description: Some("Show help for visor disable"),
                        ),
                    ],
                ),
            ],
            options: [
                (
                    names: [
                        "-h",
                    ],
                    description: Some("Show help for visor"),
                ),
            ],
        ),
        (
            name: "run",
            description: Some("Run a Deta Micro from the CLI"),
            options: [
                (
                    names: [
                        "-h",
                    ],
                    description: Some("Show help for run"),
                ),
                (
                    names: [
                        "-l",
                    ],
                    description: Some("Show the micro logs"),
                ),
            ],
            arguments: [
                (
                    name: "action",
                    description: Some("The action to be performed on the micro. See docs for full examples and details"),
                ),
            ],
        ),
        (
            name: "cron",
            description: Some("Change cron settings for a Deta Micro"),
            subcommands: [
                (
                    name: "set",
                    description: Some("Set Deta Micro to run on a schedule"),
                    options: [
                        (
                            names: [
                                "-h",
                            ],
                            description: Some("Show help for cron set"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "expression",
                            description: Some("The cron expression to be set"),
                        ),
                    ],
                ),
                (
                    name: "remove",
                    description: Some("Remove a schedule from a Deta Micro"),
                    options: [
                        (
                            names: [
                                "-h",
                            ],
                            description: Some("Show help for cron remove"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "expression",
                            description: Some("The cron expression to be removed"),
                        ),
                    ],
                ),
            ],
            options: [
                (
                    names: [
                        "-h",
                    ],
                    description: Some("Show help for cron"),
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "-h",
            ],
            description: Some("Show help for deta"),
        ),
    ],
)
