                            variadic: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-rebuild",
                    ],
                    description: Some("Do not rebuild project dependencies. Useful for debugging and fine-tuning buildSrc, but can lead to wrong results. Use with caution"),
                    presentation: (
                        dangerous: true,
                    ),
                ),
                (
                    names: [
                        "-b",
                        "--build-file",
                    ],
                    description: Some("Specifies the build file. For example: gradle --build-file=foo.gradle"),
                    arguments: [
                        (
