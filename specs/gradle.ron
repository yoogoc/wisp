                            name: "mode",
                            suggestions: [
                                (
                                    name: "all",
                                    description: Some("Log all warnings"),
                                ),
                                (
                                    name: "fail",
                                    description: Some("Log all warnings and fail the build if there are any warnings"),
                                ),
                                (
                                    name: "summary",
                                    description: Some("Suppress all warnings and log a summary at the end of the build"),
                                ),
                                (
                                    name: "none",
                                    description: Some("Suppress all warnings, including the summary at the end of the build"),
                                ),
                            ],
                            default: Some("summary"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--warning-mode",
                    ],
                    description: Some("Specifies how to log warning"),
                    arguments: [
                        (
                            name: "mode",
                            suggestions: [
                                (
                                    name: "all",
                                    description: Some("Log all warnings"),
                                ),
                                (
                                    name: "fail",
                                    description: Some("Log all warnings and fail the build if there are any warnings"),
