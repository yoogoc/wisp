(
    version: 1,
    command: "gradle",
    description: Some("Gradle is an open-source build automation tool that is designed to be flexible enough to build almost any type of software"),
    subcommands: [
        (
            name: "build",
            description: Some("Compute all outputs"),
            options: [
                (
                    names: [
                        "-?",
                        "-h",
                        "--help",
                    ],
                    description: Some("Shows a help message with all available CLI options"),
                ),
                (
                    names: [
                        "-v",
                        "--version",
                    ],
                    description: Some("Prints Gradle, Groovy, Ant, JVM, and operating system version information"),
                ),
                (
                    names: [
                        "-S",
                        "--full-stacktrace",
                    ],
                    description: Some("Print out the full (very verbose) stacktrace for any exceptions"),
                ),
                (
                    names: [
                        "-s",
                        "--stacktrace",
                    ],
                    description: Some("Print out the stacktrace also for user exceptions (e.g. compile error)"),
                ),
                (
                    names: [
                        "--scan",
                    ],
                    description: Some("Create a build scan with fine-grained information about all aspects of your Gradle build"),
                ),
                (
                    names: [
                        "-Dorg.gradle.debug",
                    ],
                    description: Some("Debug Gradle client (non-Daemon) process. Gradle will wait for you to attach a debugger at localhost:5005 by default"),
                ),
                (
                    names: [
                        "-Dorg.gradle.daemon.debug",
                    ],
                    description: Some("Debug Gradle Daemon process"),
                ),
                (
                    names: [
                        "--build-cache",
                    ],
                    description: Some("Toggles the Gradle build cache. Gradle will try to reuse outputs from previous builds. Default is off"),
                    exclusive_on: [
                        "--no-build-cache",
                    ],
                ),
                (
                    names: [
                        "--no-build-cache",
                    ],
                    description: Some("Toggles the Gradle build cache. Gradle will try to reuse outputs from previous builds. Default is off"),
                    exclusive_on: [
                        "--build-cache",
                    ],
                ),
                (
                    names: [
                        "--configure-on-demand",
                    ],
                    description: Some("Toggles Configure-on-demand. Only relevant projects are configured in this build run. Default is off"),
                    exclusive_on: [
                        "--configure-on-demand",
                    ],
                ),
                (
                    names: [
                        "--no-configure-on-demand",
                    ],
                    description: Some("Toggles Configure-on-demand. Only relevant projects are configured in this build run. Default is off"),
                    exclusive_on: [
                        "--configure-on-demand",
                    ],
                ),
                (
                    names: [
                        "--max-workers",
                    ],
                    description: Some("Sets maximum number of workers that Gradle may use. Default is number of processors"),
                    arguments: [
                        (
                            name: "number",
                        ),
                    ],
                ),
                (
                    names: [
                        "--parallel",
                    ],
                    description: Some("Build projects in parallel. For limitations of this option, see Parallel Project Execution. Default is off"),
                    exclusive_on: [
                        "--no-parallel",
                    ],
                ),
                (
                    names: [
                        "--no-parallel",
                    ],
                    description: Some("Disables --parallel"),
                    exclusive_on: [
                        "--parallel",
                    ],
                ),
                (
                    names: [
                        "--priority",
                    ],
                    description: Some("Specifies the scheduling priority for the Gradle daemon and all processes launched by it"),
                    arguments: [
                        (
                            name: "priority",
                            suggestions: [
                                (
                                    name: "normal",
                                ),
                                (
                                    name: "low",
                                ),
                            ],
                            default: Some("normal"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--profile",
                    ],
                    description: Some("Generates a high-level performance report in the $buildDir/reports/profile directory. --scan is preferred"),
                ),
                (
                    names: [
                        "--scan",
                    ],
                    description: Some("Generate a build scan with detailed performance diagnostics"),
                ),
                (
                    names: [
                        "--watch-fs",
                    ],
                    description: Some("Toggles watching the file system. When enabled Gradle re-uses information it collects about the file system between builds. Enabled by default on operating systems where Gradle supports this feature"),
                    exclusive_on: [
                        "--no-watch-fs",
                    ],
                ),
                (
                    names: [
                        "--no-watch-fs",
                    ],
                    description: Some("Toggles watching the file system. When enabled Gradle re-uses information it collects about the file system between builds. Enabled by default on operating systems where Gradle supports this feature"),
                    exclusive_on: [
                        "--watch-fs",
                    ],
                ),
                (
                    names: [
                        "--daemon",
                    ],
                    description: Some("Use the Gradle Daemon to run the build. Starts the daemon if not running or existing daemon busy. Default is on"),
                    exclusive_on: [
                        "--no-daemon",
                    ],
                ),
                (
                    names: [
                        "--no-daemon",
                    ],
                    description: Some("Disables --daemon"),
                    exclusive_on: [
                        "--daemon",
                    ],
                ),
                (
                    names: [
                        "--foreground",
                    ],
                    description: Some("Starts the Gradle Daemon in a foreground process"),
                ),
                (
                    names: [
                        "-Dorg.gradle.daemon.idletimeout",
                    ],
                    description: Some("Gradle Daemon will stop itself after this number of milliseconds of idle time"),
                    arguments: [
                        (
                            name: "milliseconds",
                            default: Some("10800000"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-Dorg.gradle.logging.level",
                    ],
                    description: Some("Set logging level via Gradle properties"),
                    arguments: [
                        (
                            name: "level",
                            suggestions: [
                                (
                                    name: "quiet",
                                ),
                                (
                                    name: "warn",
                                ),
                                (
                                    name: "lifecycle",
                                ),
                                (
                                    name: "info",
                                ),
                                (
                                    name: "debug",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-q",
                        "--quiet",
                    ],
                    description: Some("Log errors only"),
                ),
                (
                    names: [
                        "-w",
                        "--warn",
                    ],
                    description: Some("Set log level to warn"),
                ),
                (
                    names: [
                        "-i",
                        "--info",
                    ],
                    description: Some("Set log level to info"),
                ),
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Log in debug mode (includes normal stacktrace)"),
                ),
                (
                    names: [
                        "-Dorg.gradle.console",
                    ],
                    description: Some("Specify console mode via Gradle properties"),
                    arguments: [
                        (
                            name: "mode",
                            suggestions: [
                                (
                                    name: "auto",
                                    description: Some("Enables color and other rich output in the console output when the build process is attached to a console, or to generate plain text only when not attached to a console"),
                                ),
                                (
                                    name: "plain",
                                    description: Some("Disables all color and other rich output in the console output. This is the default when Gradle is not attached to a terminal"),
                                ),
                                (
                                    name: "rich",
                                    description: Some("Enables color and other rich output in the console output, regardless of whether the build process is not attached to a console"),
                                ),
                                (
                                    name: "verbose",
                                    description: Some("Enables color and other rich output like the rich, but output task names and outcomes at the lifecycle log level, as is done by default in Gradle 3.5 and earlier"),
                                ),
                            ],
                            default: Some("auto"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--console",
                    ],
                    description: Some("Specifies which type of console output to generate"),
                    arguments: [
                        (
                            name: "mode",
                            suggestions: [
                                (
                                    name: "auto",
                                    description: Some("Enables color and other rich output in the console output when the build process is attached to a console, or to generate plain text only when not attached to a console"),
                                ),
                                (
                                    name: "plain",
                                    description: Some("Disables all color and other rich output in the console output. This is the default when Gradle is not attached to a terminal"),
                                ),
                                (
                                    name: "rich",
                                    description: Some("Enables color and other rich output in the console output, regardless of whether the build process is not attached to a console"),
                                ),
