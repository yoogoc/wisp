(
    version: 1,
    command: "man",
    description: Some("Format and display the on-line manual pages"),
    options: [
        (
            names: [
                "-C",
            ],
            description: Some("Specify the configuration file to use"),
            arguments: [
                (
                    name: "config_file",
                ),
            ],
        ),
        (
            names: [
                "-M",
            ],
            description: Some("Specify the list of directories to search (colon separated)"),
            arguments: [
                (
                    name: "path",
                    generators: [
                        (
                            template: [
                                Folders,
                            ],
                            query_term: Some(AfterLast(":")),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-P",
            ],
            description: Some("Specify the pager program"),
            arguments: [
                (
                    name: "pager",
                ),
            ],
        ),
        (
            names: [
                "-B",
            ],
            description: Some("Specify which browser to use for HTML files"),
            arguments: [
                (
                    name: "browser",
                    default: Some("/usr/bin/less -is"),
                ),
            ],
        ),
        (
            names: [
                "-H",
            ],
            description: Some("Specify a command that renders HTML files as text"),
            arguments: [
                (
                    name: "command",
                    default: Some("/bin/cat"),
                ),
            ],
        ),
        (
            names: [
                "-S",
            ],
            description: Some("Specify a colon-separated list of manual sections to search"),
            arguments: [
                (
                    name: "sections",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-a",
            ],
            description: Some("Open every matching page instead of just the first"),
        ),
        (
            names: [
                "-c",
            ],
            description: Some("Reformat the source page, even when an up-to-date cat-page exists"),
        ),
        (
            names: [
                "-d",
            ],
            description: Some("Don't actually display the pages (dry run)"),
        ),
        (
            names: [
                "-D",
            ],
            description: Some("Both display and print debugging info"),
        ),
        (
            names: [
                "-f",
            ],
            description: Some("Equivalent to `whatis`"),
        ),
        (
            names: [
                "-F",
                "--preformat",
            ],
            description: Some("Format only, do not display"),
        ),
        (
            names: [
                "-h",
            ],
            description: Some("Print a help message and exit"),
        ),
        (
            names: [
                "-k",
            ],
            description: Some("Equivalent to apropos"),
        ),
        (
            names: [
                "-K",
            ],
            description: Some("Search for a given string in all pages"),
        ),
        (
            names: [
                "-m",
            ],
            description: Some("Specify an alternate set of pages to search based on the system name given"),
            arguments: [
                (
                    name: "system",
                ),
            ],
        ),
        (
            names: [
                "-p",
            ],
            description: Some("Specify the sequence of preprocessors to run before nroff or troff"),
            arguments: [
                (
                    name: "preprocessors",
                ),
            ],
        ),
        (
            names: [
                "-t",
            ],
            description: Some("Use `/usr/bin/groff -Tps -mandoc -c` to format the page"),
        ),
        (
            names: [
                "-w",
                "--path",
            ],
            description: Some("Print the location of files that would be displayed"),
        ),
        (
            names: [
                "-W",
            ],
            description: Some("Print file locations, one per line"),
        ),
    ],
    arguments: [
        (
            name: "",
            generators: [
                (
                    script_timeout_ms: Some(15000),
                    has_custom: true,
                    has_dynamic_trigger: true,
                ),
            ],
            optional: true,
            variadic: true,
        ),
    ],
)
