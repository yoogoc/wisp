(
    version: 1,
    command: "fisher",
    description: Some("A plugin manager for Fish"),
    subcommands: [
        (
            name: "install",
            description: Some("Install plugin"),
            subcommands: [
                (
                    name: "IlanCosman/tide@v5",
                    description: Some("[Prompt] - 🌊 The ultimate Fish prompt"),
                    presentation: (
                        priority: Some(99.0),
                        icon: Some("fig://icon?type=box"),
                        display_name: Some("Tide"),
                    ),
                ),
                (
                    name: "pure-fish/pure",
                    description: Some("[Prompt] - Pretty, minimal, and fast prompt for Fish from Zsh"),
                    presentation: (
                        priority: Some(98.0),
                        icon: Some("fig://icon?type=box"),
                        display_name: Some("Pure"),
                    ),
                ),
                (
                    name: "jorgebucaran/hydro",
                    description: Some("[Prompt] - Minimal, lag-free prompt with async Git status"),
                    presentation: (
                        icon: Some("fig://icon?type=box"),
                        display_name: Some("Hydro"),
                    ),
                ),
                (
                    name: "jethrokuan/z",
                    description: Some("[Plugin] - Pure-fish z directory jumping"),
                    presentation: (
                        icon: Some("fig://icon?type=package"),
                        display_name: Some("Z"),
                    ),
                ),
                (
                    name: "PatrickF1/fzf.fish",
                    description: Some("[Plugin] - Augment your fish command line with fzf key bindings"),
                    presentation: (
                        icon: Some("fig://icon?type=package"),
                        display_name: Some("FZF.fish"),
                    ),
                ),
                (
                    name: "jorgebucaran/nvm.fish",
                    description: Some("[Plugin] -  Node.js version manager lovingly made for Fish"),
                    presentation: (
                        icon: Some("fig://icon?type=package"),
                        display_name: Some("NVM.fish"),
                    ),
                ),
                (
                    name: "franciscolourenco/done",
                    description: Some("[Plugin] - A fish-shell package to automatically receive notifications when long processes finish"),
                    presentation: (
                        icon: Some("fig://icon?type=package"),
                        display_name: Some("Done"),
                    ),
                ),
                (
                    name: "jorgebucaran/replay.fish",
                    description: Some("[Plugin] - Run Bash commands replaying changes in Fish. 🍤"),
                    presentation: (
                        icon: Some("fig://icon?type=package"),
                        display_name: Some("Replay.fish"),
                    ),
                ),
                (
                    name: "jorgebucaran/spark.fish",
                    description: Some("[Plugin] - Visualize a range of numbers right in your terminal"),
                    presentation: (
                        icon: Some("fig://icon?type=package"),
                        display_name: Some("Spark.fish"),
                    ),
                ),
                (
                    name: "joseluisq/gitnow@2.10.0",
                    description: Some("[Plugin] - Speed up your Git workflow. 🐠"),
                    presentation: (
                        icon: Some("fig://icon?type=package"),
                        display_name: Some("GitNow"),
                    ),
                ),
            ],
        ),
        (
            name: "remove",
            description: Some("Remove plugins"),
            arguments: [
                (
                    name: "installed plugins",
                    description: Some("The plugin you want to remove"),
                    generators: [
                        (
                            script: [
                                "fish",
                                "-c",
                                "fisher list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                    variadic: true,
                    dangerous: true,
                ),
            ],
        ),
        (
            name: "update",
            description: Some("Update plugins"),
            arguments: [
                (
                    name: "installed plugins",
                    description: Some("The plugin you want to update"),
                    generators: [
                        (
                            script: [
                                "fish",
                                "-c",
                                "fisher list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                    variadic: true,
                ),
            ],
        ),
        (
            name: "list",
            description: Some("List plugins"),
            arguments: [
                (
                    name: "RegEx",
                    description: Some("Search in list with regular expression"),
                    optional: true,
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for fisher"),
        ),
        (
            names: [
                "--version",
                "-v",
            ],
            description: Some("Show fisher version"),
        ),
    ],
)
