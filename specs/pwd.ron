(
    version: 1,
    command: "pwd",
    description: Some("Return working directory name"),
    options: [
        (
            names: [
                "-L",
            ],
            description: Some("Display the logical current working directory"),
        ),
        (
            names: [
                "-P",
            ],
            description: Some("Display the physical current working directory"),
        ),
    ],
)
