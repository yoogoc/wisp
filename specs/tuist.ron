(
    version: 1,
    command: "tuist",
    description: Some("Generate, build and test your Xcode projects. For more info please see https://docs.tuist.io/"),
    subcommands: [
        (
            name: "build",
            description: Some("Build the project in the current directory"),
            options: [
                (
                    names: [
                        "--build-output-path",
                    ],
                    description: Some("Build the project to a custom directory, example usage: 'tuist build --build-output-path .build':"),
                ),
                (
                    names: [
                        "--device",
                    ],
                    description: Some("Build the project to a specific device, example usage: 'tuist build --device \"iPhone X\"':"),
                ),
                (
                    names: [
                        "--os",
                    ],
                    description: Some("Build the project to a specific OS, example usage: 'tuist build --os 14.0':"),
                ),
            ],
            arguments: [
                (
                    name: "scheme",
                    description: Some("The scheme to be built. By default it builds all the buildable schemes of the project in the current directory"),
                ),
            ],
        ),
        (
            name: "cache",
            description: Some("A set of utilities related to the caching of targets. For more info see https://docs.tuist.io/building-at-scale/caching USAGE: tuist cache <subcommand>"),
            subcommands: [
                (
                    name: "warm",
                    description: Some("Warms the local and remote cache"),
                    options: [
                        (
                            names: [
                                "--path",
                                "-p",
                            ],
                            description: Some("The path to the directory that contains the project whose targets will be cached"),
                        ),
                        (
                            names: [
                                "--profile",
                                "-P",
                            ],
                            description: Some("The name of the profile to be used when warming up the cache"),
                        ),
                        (
                            names: [
                                "--xcframeworks",
                                "-x",
                            ],
                            description: Some("When passed it caches the targets for simulator and device using xcframeworks"),
                        ),
                        (
                            names: [
                                "--dependencies-only",
                            ],
                            description: Some("If passed, the command doesn't cache the targets passed in the `--targets` argument, but only their dependencies"),
                        ),
                    ],
                ),
                (
                    name: "print-hashes",
                    description: Some("Print the hashes of the cacheable frameworks in the given project"),
                    options: [
                        (
                            names: [
                                "--path",
                                "-p",
                            ],
                            description: Some("The path to the directory that contains the project whose targets will be cached"),
                        ),
                        (
                            names: [
                                "--profile",
                                "-P",
                            ],
                            description: Some("The name of the profile to be used when warming up the cache"),
                        ),
                        (
                            names: [
                                "--xcframeworks",
                                "-x",
                            ],
                            description: Some("When passed it caches the targets for simulator and device using xcframeworks"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "clean",
            description: Some("Clean all the data generated by Tuist. USAGE: tuist clean [<clean-categories> ...] [--path <path>]"),
            options: [
                (
                    names: [
                        "--path",
                        "-p",
                    ],
                    description: Some("The path to the directory that contains the project that should be cleaned"),
                ),
                (
                    names: [
                        "plugins",
                    ],
                    description: Some("Clean only the plugins cache generated by Tuist, example usage: 'tuist clean plugins':"),
                ),
                (
                    names: [
                        "builds",
                    ],
                    description: Some("Clean only the builds artifacts cache generated by Tuist, example usage: 'tuist clean builds':"),
                ),
                (
                    names: [
                        "tests",
                    ],
                    description: Some("Clean only the tests cache generated by Tuist, example usage: 'tuist clean tests':"),
                ),
                (
                    names: [
                        "generatedAutomationProjects",
                    ],
                    description: Some("Clean only the automation projects cache generated by Tuist, example usage: 'tuist clean generatedAutomationProjects':"),
                ),
                (
                    names: [
                        "projectDescriptionHelpers",
                    ],
                    description: Some("Clean only the project description helpers cache generated by Tuist, example usage: 'tuist clean projectDescriptionHelpers':"),
                ),
                (
                    names: [
                        "manifests",
                    ],
                    description: Some("Clean only the manifests cache generated by Tuist, example usage: 'tuist clean manifests':"),
                ),
            ],
            arguments: [
                (
                    name: "clean-categories",
                    description: Some("The cache and artifact categories to be cleaned. If no category is specified, everything is cleaned. (default: plugins, builds, tests, generatedAutomationProjects, projectDescriptionHelpers, manifests, dependencies)"),
                ),
            ],
        ),
        (
            name: "fetch",
            description: Some("Dependencies can be fetched by running the following command. They are stored in your project's `Tuist/Dependencies` directory. For more info see https://docs.tuist.io/commands/dependencies"),
            options: [
                (
                    names: [
                        "--path",
                        "-p",
                    ],
                    description: Some("The path to the directory that contains the workspace or project whose dependencies will be fetched/updated. The default is the current directory"),
                ),
                (
                    names: [
                        "--update",
                    ],
                    description: Some("Clean only the builds artifacts cache generated by Tuist, example usage: 'tuist fetch --update':"),
                ),
            ],
        ),
        (
            name: "edit",
            description: Some("Editing your projects is easy; position yourself in a directory where there's a project defined and run the edit command. It will open a temporary Xcode project with all the project manifests and the project description helpers, so you will be able to edit the whole project configuration. After making changes you can run the target from Xcode and it will call tuist generate for you. For more info see https://docs.tuist.io/commands/edit"),
            options: [
                (
                    names: [
                        "--permanent",
                    ],
                    description: Some("The project is deleted automatically once you are done with editing. If you wish to generate and keep the project in the current directory, you can run the command passing the --permanent argument. That will generate a Manifest.xcodeproj project that you can open manually"),
                ),
            ],
        ),
        (
            name: "graph",
            description: Some("Generates a graph from the workspace or project in the current directory. For more info see https://docs.tuist.io/commands/graph USAGE: tuist graph [--skip-test-targets] [--skip-external-dependencies] [--format <format>] [--algorithm <algorithm>] [<targets> ...] [--path <path>] [--output-path <output-path>]"),
            options: [
                (
                    names: [
                        "--skip-test-targets",
                        "-t",
                    ],
                    description: Some("Excludes test targets from the generated graph"),
                ),
                (
                    names: [
                        "--skip-external-dependencies",
                        "-d",
                    ],
                    description: Some("Excludes external dependencies from the generated graph"),
                ),
                (
                    names: [
                        "--format",
                        "-f",
                    ],
                    description: Some("If you prefer to have the dot or json representations of the graph and render it separately. Available formats: dot, png, json (default: png)"),
                    arguments: [
                        (
                            name: "format",
                            suggestions: [
                                (
                                    name: "dot",
                                ),
                                (
                                    name: "png",
                                ),
                                (
                                    name: "json",
                                ),
                            ],
                            default: Some("png"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--algorithm",
                        "-a",
                    ],
                    description: Some("Available formats: dot, neato, twopi, circo, fdp, sfddp, patchwork (default: dot)"),
                    arguments: [
                        (
                            name: "format",
                            suggestions: [
                                (
                                    name: "dot",
                                ),
                                (
                                    name: "neato",
                                ),
                                (
                                    name: "twopi",
                                ),
                                (
                                    name: "circo",
                                ),
                                (
                                    name: "fdp",
                                ),
                                (
                                    name: "sfddp",
                                ),
                                (
                                    name: "patchwork",
                                ),
                            ],
                            default: Some("dot"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--path",
                        "-p",
                    ],
                    description: Some("The path to the directory that contains the definition of the project. Default is current directory"),
                    arguments: [
                        (
                            name: "project dir",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--output-path",
                        "-o",
                    ],
                    description: Some("The path to where the image will be exported. When not specified, it exports the image in the current directory"),
                    arguments: [
                        (
                            name: "output path",
                            template: [
                                Folders,
                            ],
                            suggest_current_token: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-open",
                        "-n",
                    ],
                    description: Some("If set, the generated graph is not opened automatically. Default is yes"),
                ),
                (
                    names: [
                        "--platform",
                        "-l",
                    ],
                    description: Some("If set, show only the targets for the given platform. Default is all platforms. Available platforms: ios, macos, tvos, watchos"),
                    arguments: [
                        (
                            name: "platform",
                            suggestions: [
                                (
                                    name: "ios",
                                ),
                                (
                                    name: "macos",
                                ),
                                (
                                    name: "tvos",
                                ),
                                (
                                    name: "watchos",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "targets",
                    description: Some("A list of targets to filter. Those and their dependent targets will be showed in the graph"),
                ),
            ],
        ),
        (
            name: "generate",
            description: Some("Generates an Xcode workspace to start working on the project. For more info see https://docs.tuist.io/commands/generate"),
            options: [
                (
                    names: [
                        "--path",
                        "-p",
                    ],
                    description: Some("The path to the directory that contains the definition of the project. Default is current directory"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-open",
                        "-n",
                    ],
                    description: Some("Don't open the project after generating it. Default is false"),
                ),
                (
                    names: [
                        "--xcframeworks",
                        "-x",
                    ],
                    description: Some("When passed it uses xcframeworks (simulator and device) from the cache instead of frameworks (only simulator). Default is false"),
                ),
                (
                    names: [
                        "--no-cache",
                    ],
                    description: Some("Ignore cached targets, and use their sources instead.\tDefault is false"),
                ),
                (
                    names: [
                        "--profile",
                        "-P",
                    ],
                    description: Some("The name of the cache profile"),
                    arguments: [
                        (
                            name: "cache profile",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "sources",
                    description: Some("A list of targets to focus on. Other targets will be linked as binaries if possible. If no target is specified, all the project targets will be generated (except external ones, such as Swift packages)"),
                ),
            ],
        ),
        (
            name: "migration",
            description: Some("To help developers with the process of adopting Tuist, Tuist provides a set of commands under tuist migration. For more info see https://docs.tuist.io/commands/migration"),
            subcommands: [
                (
                    name: "settings-to-xcconfig",
                    description: Some("It's recommended to make .xcconfig files the source of truth for build settings. For that, Tuist provides a tuist migration settings-to-xcconfig command that extracts the build settings from targets and projects"),
                    options: [
                        (
                            names: [
                                "--xcodeproj-path",
                                "-p",
                            ],
                            description: Some("Required. Path to the Xcode project whose build settings will be extracted"),
                            arguments: [
                                (
                                    name: "path",
                                    template: [
                                        Folders,
                                    ],
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--xcconfig-path",
                                "-x",
                            ],
                            description: Some("Required. Path to the Xcode project whose build settings will be extracted"),
                            arguments: [
                                (
                                    name: "path",
                                    template: [
                                        Folders,
                                    ],
                                ),
                            ],
                            required: true,
                        ),
                        (
                            names: [
                                "--target",
                                "-t",
                            ],
                            description: Some("Optional. The name of the target whose build settings will be extracted. When not passed, it extracts the build settings of the project"),
                            arguments: [
                                (
                                    name: "target",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "check-empty-settings",
                    description: Some("After making .xcconfig files the source of truth for build settings, it's important to ensure that build settings are no longer set to the project. To help with that, Tuist includes a command that fails if the build settings of a project or a target are not empty"),
                    options: [
                        (
                            names: [
                                "--xcodeproj-path",
                                "-p",
                            ],
                            description: Some("Required. Path to the Xcode project whose build settings will be checked"),
                        ),
                        (
                            names: [
                                "--target",
                                "-t",
                            ],
                            description: Some("Optional. The name of the target whose build settings will be checked. When not passed, it checks the build settings of the project"),
                        ),
                    ],
                ),
                (
                    name: "list-targets",
                    description: Some("When passed it uses xcframeworks (simulator and device) from the cache instead of frameworks (only simulator). Default is false"),
                    options: [
                        (
                            names: [
                                "--xcodeproj-path",
                                "-p",
                            ],
                            description: Some("Required. Path to the Xcode project whose build settings will be checked"),
                            required: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "scaffold",
            description: Some("Generates new project based on a template. For more info see https://docs.tuist.io/commands/scaffold USAGE: tuist scaffold <template> [--json] [--path <path>] <subcommand>"),
            subcommands: [
                (
                    name: "list",
                    description: Some("Lists available scaffold templates"),
                ),
            ],
            options: [
                (
                    names: [
                        "--path",
                        "-p",
                    ],
                    description: Some("The path to the folder where the template will be generated (Default: Current directory)"),
                    arguments: [
                        (
                            name: "path",
                        ),
                    ],
                ),
                (
                    names: [
                        "--json",
                    ],
                    description: Some("The output in JSON format"),
                ),
                (
                    names: [
                        "--name",
                    ],
                    description: Some("The name of the generate project"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--platform",
                    ],
                    description: Some("The platform used by the project"),
                    arguments: [
                        (
                            name: "platform",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "template",
                    description: Some("Name of template you want to use"),
                ),
            ],
        ),
        (
            name: "test",
            description: Some("Tests a project. For more info see https://docs.tuist.io/commands/test USAGE: tuist test [<scheme>] [--clean] [--path <path>] [--device <device>] [--os <os>] [--configuration <configuration>] [--skip-ui-tests] [--result-bundle-path <result-bundle-path>] [--retry-count <retry-count>]"),
            options: [
                (
                    names: [
                        "--path",
                        "-p",
                    ],
                    description: Some("The path to the directory that contains the project to be tested"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--clean",
                        "-c",
                    ],
                    description: Some("When passed, it cleans the project before testing it"),
                ),
                (
                    names: [
                        "--device",
                        "-d",
                    ],
                    description: Some("Test on a specific device"),
                    arguments: [
                        (
                            name: "device",
                        ),
                    ],
                ),
                (
                    names: [
                        "--os",
                        "-o",
                    ],
                    description: Some("Test with a specific version of the OS"),
                    arguments: [
                        (
                            name: "os",
                        ),
                    ],
                ),
                (
                    names: [
                        "--configuration",
                        "-C",
                    ],
                    description: Some("The configuration to be used when testing the scheme"),
                ),
                (
                    names: [
                        "--skip-ui-tests",
                    ],
                    description: Some("When passed, it skips testing UI Tests targets"),
                ),
                (
                    names: [
                        "--result-bundle-path",
                        "-T",
                    ],
                    description: Some("Path where test result bundle will be saved"),
                ),
                (
                    names: [
                        "--retry-count",
                    ],
                    description: Some("Tests will retry <number> of times until success. Example: if 1 is specified, the test will be retried at most once, hence it will run up to 2 times. (default: 0)"),
                    arguments: [
                        (
                            name: "times",
                            default: Some("0"),
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "scheme",
                    description: Some("The scheme to be tested. By default it tests all the testable targets of the project in the current directory"),
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for tuist"),
        ),
    ],
)
