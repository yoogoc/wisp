(
    version: 1,
    command: "xxd",
    description: Some("Make a hexdump or do the reverse"),
    options: [
        (
            names: [
                "-help",
                "-h",
            ],
            description: Some("Show help for xxd"),
        ),
        (
            names: [
                "-autoskip",
                "-a",
            ],
            description: Some("Toggle autoskip: A single '*' replaces nul-lines.  Default off"),
        ),
        (
            names: [
                "-bits",
                "-b",
            ],
            description: Some("Switch to bits (binary digits) dump, rather than hexdump"),
            exclusive_on: [
                "-postscript",
                "-plain",
                "-ps",
                "-p",
                "-r",
                "-i",
            ],
        ),
        (
            names: [
                "-cols",
                "-c",
            ],
            description: Some("Format <cols> octets per line. Default 16"),
            arguments: [
                (
                    name: "cols",
                ),
            ],
        ),
        (
            names: [
                "-capitalize",
                "-C",
            ],
            description: Some("Capitalize variable names in C include file style, when using -i"),
        ),
        (
            names: [
                "-EBCDIC",
                "-E",
            ],
            description: Some("Change the character encoding in the righthand column from ASCII to EBCDIC"),
            exclusive_on: [
                "-postscript",
                "-plain",
                "-ps",
                "-p",
                "-r",
                "-i",
            ],
        ),
        (
            names: [
                "-e",
            ],
            description: Some("Switch to little-endian hexdump"),
        ),
        (
            names: [
                "-groupsize",
                "-g",
            ],
            description: Some("Separate the output of every <bytes> bytes"),
            arguments: [
                (
                    name: "bytes",
                ),
            ],
        ),
        (
            names: [
                "-include",
                "-i",
            ],
            description: Some("Output in C include file style"),
            exclusive_on: [
                "-EBCDIC",
                "-E",
                "-bits",
                "-b",
            ],
        ),
        (
            names: [
                "-len",
                "-l",
            ],
            description: Some("Stop after writing <len> octets"),
            arguments: [
                (
                    name: "len",
                ),
            ],
        ),
        (
            names: [
                "-name",
                "-n",
            ],
            description: Some("Override the variable name output when -i is used"),
            arguments: [
                (
                    name: "name",
                ),
            ],
        ),
        (
            names: [
                "-o",
            ],
            description: Some("Add <offset> to the displayed file position"),
            arguments: [
                (
                    name: "offset",
                ),
            ],
        ),
        (
            names: [
                "-postscript",
                "-plain",
                "-ps",
                "-p",
            ],
            description: Some("Output in postscript continuous hexdump style"),
            exclusive_on: [
                "-EBCDIC",
                "-E",
                "-bits",
                "-b",
            ],
        ),
        (
            names: [
                "-revert",
                "-r",
            ],
            description: Some("Reverse operation: convert (or patch) hexdump into binary"),
            exclusive_on: [
                "-EBCDIC",
                "-E",
                "-bits",
                "-b",
            ],
        ),
        (
            names: [
                "-seek",
            ],
            description: Some("When used after -r: revert with <offset> added to file positions found in hexdump"),
            arguments: [
                (
                    name: "offset",
                ),
            ],
        ),
        (
            names: [
                "-u",
            ],
            description: Some("Use upper case hex letters. Default is lower case"),
        ),
        (
            names: [
                "-version",
                "-v",
            ],
            description: Some("Show version string"),
        ),
    ],
    arguments: [
        (
            name: "infile",
            template: [
                FilePaths,
            ],
        ),
        (
            name: "outfile",
            template: [
                FilePaths,
            ],
        ),
    ],
    parser_directives: Some((
        flags_are_posix_noncompliant: true,
    )),
)
