(
    version: 1,
    command: "asciinema",
    description: Some("Terminal session recorder"),
    subcommands: [
        (
            name: "rec",
            description: Some("Start a recording"),
            options: [
                (
                    names: [
                        "--stdin",
                    ],
                    description: Some("Enable stdin (keyboard) recording"),
                ),
                (
                    names: [
                        "--append",
                    ],
                    description: Some("Append to existing recording"),
                ),
                (
                    names: [
                        "--raw",
                    ],
                    description: Some("Save raw output, without timing or other metadata"),
                ),
                (
                    names: [
                        "--overwrite",
                    ],
                    description: Some("Overwrite the recording if it already exists"),
                ),
                (
                    names: [
                        "-c",
                        "--command",
                    ],
                    description: Some("Specify command to record, defaults to $SHELL"),
                    arguments: [
                        (
                            name: "command",
                            is_command: true,
                        ),
                    ],
                    requires_separator: Some("="),
                    presentation: (
                        insert_value: Some("-c='{cursor}'"),
                    ),
                ),
                (
                    names: [
                        "-e",
                        "--env",
                    ],
                    description: Some("List of environment variables to capture"),
                    arguments: [
                        (
                            name: "variables",
                        ),
                    ],
                    requires_separator: Some("="),
                    presentation: (
                        insert_value: Some("-c='{cursor}'"),
                    ),
                ),
                (
                    names: [
                        "-t",
                        "--title",
                    ],
                    description: Some("Specify the title of the asciicast"),
                    arguments: [
                        (
                            name: "title",
                        ),
                    ],
                    requires_separator: Some("="),
                    presentation: (
                        insert_value: Some("-t='{cursor}'"),
                    ),
                ),
                (
                    names: [
                        "-i",
                        "--idle-time-limit",
                    ],
                    description: Some("Limit recorded terminal inactivity to max amount of seconds"),
                    arguments: [
                        (
                            name: "seconds",
                        ),
                    ],
                    requires_separator: Some("="),
                ),
                (
                    names: [
                        "--cols",
                    ],
                    description: Some("Override terminal columns for recorded process"),
                    arguments: [
                        (
                            name: "cols",
                        ),
                    ],
                    requires_separator: Some("="),
                ),
                (
                    names: [
                        "--rows",
                    ],
                    description: Some("Override terminal rows for recorded process"),
                    arguments: [
                        (
                            name: "rows",
                        ),
                    ],
                    requires_separator: Some("="),
                ),
                (
                    names: [
                        "-y",
                        "--yes",
                    ],
                    description: Some("Answer “yes” to all prompts (e.g. upload confirmation)"),
                ),
                (
                    names: [
                        "-q",
                        "--quiet",
                    ],
                    description: Some("Be quiet, suppress all notices/warnings (implies -y)"),
                ),
            ],
            arguments: [
                (
                    name: "filename",
                    optional: true,
                ),
            ],
        ),
        (
            name: "play",
            description: Some("Replay recorded asciicast in a terminal"),
            options: [
                (
                    names: [
                        "-i",
                        "--idle-time-linit",
                    ],
                    description: Some("Limit replayed terminal inactivity"),
                    arguments: [
                        (
                            name: "seconds",
                            description: Some("Can be fractional"),
                        ),
                    ],
                    requires_separator: Some("="),
                ),
                (
                    names: [
                        "-s",
                        "--speed",
                    ],
                    description: Some("Playback speed"),
                    arguments: [
                        (
                            name: "factor",
                            description: Some("Can be fractional"),
                        ),
                    ],
                    requires_separator: Some("="),
                ),
            ],
            arguments: [
                (
                    name: "file or URL",
                    suggestions: [
                        (
                            name: "-",
                            description: Some("Stdin"),
                        ),
                    ],
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "cat",
            description: Some("Print full output of recorded asciicast to a terminal"),
            arguments: [
                (
                    name: "file or URL",
                    suggestions: [
                        (
                            name: "-",
                            description: Some("Stdin"),
                        ),
                    ],
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "upload",
            description: Some("Upload recorded asciicast to asciinema.org site"),
            arguments: [
                (
                    name: "file or URL",
                    suggestions: [
                        (
                            name: "-",
                            description: Some("Stdin"),
                        ),
                    ],
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "auth",
            description: Some("Link and manage your install ID with your asciinema.org user account"),
        ),
    ],
    options: [
        (
            names: [
                "--version",
            ],
            description: Some("Ouput version information and exit"),
        ),
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Output help message and exit"),
            persistent: true,
        ),
    ],
)
