(
    version: 1,
    command: "hyper",
    description: Some("Hyper is an Electron-based terminal"),
    subcommands: [
        (
            name: "install",
            aliases: [
                "i",
            ],
            description: Some("Install a plugin"),
            arguments: [
                (
                    name: "plugin",
                ),
            ],
        ),
        (
            name: "docs",
            aliases: [
                "d",
                "h",
                "home",
            ],
            description: Some("Open the npm page of a plugin"),
            arguments: [
                (
                    name: "plugin",
                ),
            ],
        ),
        (
            name: "help",
            description: Some("Display help"),
        ),
        (
            name: "list",
            aliases: [
                "ls",
            ],
            description: Some("List installed plugins"),
        ),
        (
            name: "list-remote",
            aliases: [
                "lsr",
                " ls-remote",
            ],
            description: Some("List plugins available on npm"),
        ),
        (
            name: "search",
            aliases: [
                "s",
            ],
            description: Some("Search for plugins on npm"),
            arguments: [
                (
                    name: "query",
                    description: Some("Your search query"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "uninstall",
            aliases: [
                "u",
                "rm",
                "remove",
            ],
            description: Some("Uninstall plugin"),
            arguments: [
                (
                    name: "plugin",
                    description: Some("Plugin to uninstall"),
                    generators: [
                        (
                            script: [
                                "hyper",
                                "list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "version",
            description: Some("Show version"),
        ),
    ],
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Output usage information"),
        ),
        (
            names: [
                "-v",
                "--verbose",
            ],
            description: Some("Verbose mode (disabled by default)"),
        ),
    ],
    arguments: [
        (
            name: "",
            template: [
                Folders,
            ],
        ),
    ],
)
