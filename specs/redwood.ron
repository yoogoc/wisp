(
    version: 1,
    command: "redwood",
    description: Some("Redwood provides a first-class CLI that helps you at every stage of development, from your first commit to your first deploy"),
    subcommands: [
        (
            name: "dev",
            description: Some("Start development servers for api and web"),
            options: [
                (
                    names: [
                        "--forward",
                        "--fwd",
                    ],
                    description: Some("String of one or more Webpack Dev Server config options"),
                    arguments: [
                        (
                            name: "options",
                            description: Some("Options to pass to Webpack Dev Server"),
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "side",
                    description: Some("Which side(s) to build"),
                    suggestions: [
                        (
                            name: "api",
                            description: Some("Build the api server"),
                        ),
                        (
                            name: "web",
                            description: Some("Build the web server"),
                        ),
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                icon: Some("https://avatars.githubusercontent.com/u/45050444?s=200&v=4"),
            ),
        ),
        (
            name: "deploy",
            description: Some("Deploy your redwood project to a hosting provider target"),
            subcommands: [
                (
                    name: "aws",
                    description: Some("Deploy to AWS using the selected provider"),
                    options: [
                        (
                            names: [
                                "--side",
                            ],
                            description: Some("Show help for command"),
                            arguments: [
                                (
                                    name: "side",
                                    description: Some("Which side(s) to deploy"),
                                    suggestions: [
                                        (
                                            name: "api",
                                            description: Some("Deploy the api server"),
                                        ),
                                        (
                                            name: "web",
                                            description: Some("Deploy the web server"),
                                        ),
                                    ],
                                ),
                            ],
                            presentation: (
                                priority: Some(1.0),
                            ),
                        ),
                    ],
                    arguments: [
                        (
                            name: "provider",
                            description: Some("AWS Deploy provider to configure"),
                            suggestions: [
                                (
                                    name: "serverless",
                                ),
                            ],
                            optional: true,
                        ),
                    ],
                ),
                (
                    name: "netlify",
                    description: Some("Build command for Netlify deploy"),
                    options: [
                        (
                            names: [
                                "--build",
                            ],
                            description: Some("Build for production [default: \"true\"]"),
                        ),
                        (
                            names: [
                                "--prisma",
                            ],
                            description: Some("Apply database migrations [default: \"true\"]"),
                        ),
                        (
                            names: [
                                "--data-migrate",
                                "--dm",
                            ],
                            description: Some("Migrate the data in your database [default: \"true\"]"),
                        ),
                    ],
                ),
                (
                    name: "render",
                    description: Some("Build (web) and Start (api) command for Render deploy"),
                    options: [
                        (
                            names: [
                                "--serve",
                            ],
                            description: Some("Run server for api in production [default: \"true\"]"),
                        ),
                        (
                            names: [
                                "--prisma",
                            ],
                            description: Some("Apply database migrations [default: \"true\"]"),
                        ),
                        (
                            names: [
                                "--data-migrate",
                                "--dm",
                            ],
                            description: Some("Migrate the data in your database [default: \"true\"]"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "side",
                            description: Some("Select side to build"),
                            suggestions: [
                                (
                                    name: "api",
                                ),
                                (
                                    name: "web",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "vercel",
                    description: Some("Build command for Vercel deploy"),
                    options: [
                        (
                            names: [
                                "--build",
                            ],
                            description: Some("Build for production [default: \"true\"]"),
                        ),
                        (
                            names: [
                                "--prisma",
                            ],
                            description: Some("Apply database migrations [default: \"true\"]"),
                        ),
                        (
                            names: [
                                "--data-migrate",
                                "--dm",
                            ],
                            description: Some("Migrate the data in your database [default: \"true\"]"),
                        ),
                    ],
                ),
            ],
            presentation: (
                icon: Some("https://avatars.githubusercontent.com/u/45050444?s=200&v=4"),
            ),
        ),
        (
            name: "destroy",
            aliases: [
                "d",
            ],
            description: Some("Rollback changes made by the generate command"),
            subcommands: [
                (
                    name: "cell",
                    description: Some("Destroy a cell component"),
                    arguments: [
                        (
                            name: "name",
                            description: Some("Name of the cell component"),
                        ),
                    ],
                ),
                (
                    name: "component",
                    description: Some("Destroy a component"),
                    arguments: [
                        (
                            name: "name",
                            description: Some("Name of the component"),
                        ),
                    ],
                ),
                (
                    name: "function",
                    description: Some("Destroy a Function"),
                    arguments: [
                        (
                            name: "name",
                            description: Some("Name of the Function"),
                        ),
                    ],
                ),
                (
                    name: "layout",
                    description: Some("Destroy a layout component"),
                    arguments: [
                        (
                            name: "name",
                            description: Some("Name of the layout component"),
                        ),
                    ],
                ),
                (
                    name: "page",
                    description: Some("Destroy a page and route component"),
                    arguments: [
                        (
                            name: "name",
                            description: Some("Name of the page"),
                        ),
                        (
                            name: "path",
                            description: Some("URL path to the page. Defaults to name"),
                            optional: true,
                        ),
                    ],
                ),
                (
                    name: "scaffold",
                    description: Some("Destroy pages, SDL, and Services files based on a given DB schema Model"),
                    arguments: [
                        (
                            name: "name",
                            description: Some("Name of the scaffold"),
                        ),
                    ],
                ),
                (
                    name: "sdl",
                    description: Some("Destroy a GraphQL schema and service component based on a given DB schema Model"),
                    arguments: [
                        (
                            name: "name",
                            description: Some("Name of the sdl"),
                        ),
                    ],
                ),
                (
                    name: "service",
                    description: Some("Destroy a service component"),
                    arguments: [
                        (
                            name: "name",
                            description: Some("Name of the service"),
                        ),
                    ],
                ),
            ],
            presentation: (
                icon: Some("https://avatars.githubusercontent.com/u/45050444?s=200&v=4"),
            ),
        ),
        (
            name: "generate",
            aliases: [
                "g",
