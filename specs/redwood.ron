        (
            name: "exec",
            description: Some("Execute scripts generated by yarn redwood generate script to run one-off operations, long-running jobs, or utility scripts"),
            arguments: [
                (
                    name: "script",
                    description: Some("Name of the script to execute"),
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "until [[ -f redwood.toml ]] || [[ $PWD = '/' ]]; do cd ..; done; ls -1p scripts/",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
            presentation: (
                icon: Some("https://avatars.githubusercontent.com/u/45050444?s=200&v=4"),
            ),
