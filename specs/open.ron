(
    version: 1,
    command: "open",
    description: Some("Open files, apps, or URLs using default application"),
    options: [
        (
            names: [
                "-a",
            ],
            description: Some("Specify the application to use for opening the file"),
            arguments: [
                (
                    name: "Application",
                    generators: [
                        (
                            script: [
                                "mdfind",
                                "kMDItemContentTypeTree=com.apple.application-bundle",
                                "-onlyin",
                                "/",
                            ],
                            has_post_process: true,
                            cache: Some((
                                stale_while_revalidate: true,
                            )),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-b",
            ],
            description: Some("Specify the bundle identifier of the app to use to open the file"),
            arguments: [
                (
                    name: "Bundle Identifier",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "mdfind kMDItemContentTypeTree=com.apple.application-bundle -onlyin / | while read line; do echo $(mdls -name kMDItemCFBundleIdentifier -r \"$line\") $line; done",
                            ],
                            script_timeout_ms: Some(15000),
                            has_post_process: true,
                            cache: Some((
                                stale_while_revalidate: true,
                            )),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-D",
            ],
            description: Some("Reveals the enclosing folder in finder"),
        ),
        (
            names: [
                "-e",
            ],
            description: Some("Opens the file with /Applications/TextEdit"),
        ),
        (
            names: [
                "-t",
            ],
            description: Some("Open the file with the default text editor"),
        ),
        (
            names: [
                "-f",
            ],
            description: Some("Read input from standard input and open the results in the default text editor"),
        ),
        (
            names: [
                "-F",
                "--fresh",
            ],
            description: Some("Opens the application without restoring windows"),
        ),
        (
            names: [
                "-W",
                "--wait-apps",
            ],
            description: Some("Waits until the applications exit"),
        ),
        (
            names: [
                "-R",
                "--reveal",
            ],
            description: Some("Reveals the file(s) in the Finder instead of opening them"),
        ),
        (
            names: [
                "-n",
                "--new",
            ],
            description: Some("Open a new instance of the application(s) even if one is already running"),
        ),
        (
            names: [
                "-j",
                "--hide",
            ],
            description: Some("Launches the app hidden"),
        ),
        (
            names: [
                "-g",
                "--background",
            ],
            description: Some("Do not bring the application to the foreground"),
        ),
        (
            names: [
                "-h",
                "--header",
            ],
            description: Some("Searches header locations for a header whose name matches the given string and then opens it"),
        ),
        (
            names: [
                "-s",
            ],
            description: Some("For -h, the SDK to use; if supplied, only SDKs whose names contain the argument value are searched"),
            arguments: [
                (
                    name: "partial SDK name",
                ),
            ],
        ),
        (
            names: [
                "-u",
                "--url",
            ],
            description: Some("Open this URL, even if it matches exactly a filepath"),
            arguments: [
                (
                    name: "URL",
                ),
            ],
        ),
        (
            names: [
                "-i",
                "--stdin",
            ],
            description: Some("Launches the application with stdin connected to PATH; defaults to /dev/null"),
            arguments: [
                (
                    name: "PATH",
                    template: [
                        FilePaths,
                    ],
                    default: Some("/dev/null"),
                ),
            ],
        ),
        (
            names: [
                "-o",
                "--stdout",
            ],
            description: Some("Launches the application with /dev/stdout connected to PATH"),
            arguments: [
                (
                    name: "PATH",
                    template: [
                        FilePaths,
                    ],
                    default: Some("/dev/null"),
                ),
            ],
        ),
        (
            names: [
                "--stderr",
            ],
            description: Some("Launches the application with /dev/stderr connected to PATH"),
            arguments: [
                (
                    name: "PATH",
                    template: [
                        FilePaths,
                    ],
                    default: Some("/dev/null"),
                ),
            ],
        ),
        (
            names: [
                "--env",
            ],
            description: Some("Add an enviroment variable to the launched process, where VAR is formatted AAA=foo"),
            arguments: [
                (
                    name: "VAR",
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "--args",
            ],
            description: Some("All remaining arguments are passed to the opened application in the argv parameter to main().  These arguments are not opened or interpreted by the open tool"),
            arguments: [
                (
                    name: "Arguments",
                    variadic: true,
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "",
            template: [
                FilePaths,
                Folders,
            ],
            variadic: true,
        ),
    ],
)
