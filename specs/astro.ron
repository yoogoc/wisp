(
    version: 1,
    command: "astro",
    description: Some("CLI provided by Astro to develop, build, and preview your project from a terminal window"),
    subcommands: [
        (
            name: "add",
            description: Some("Add an integration"),
            options: [
                (
                    names: [
                        "--yes",
                    ],
                    description: Some("Accept all prompts"),
                ),
            ],
            arguments: [
                (
                    name: "integration",
                ),
            ],
        ),
        (
            name: "build",
            description: Some("Build your project and write it to disk"),
            options: [
                (
                    names: [
                        "--drafts",
                    ],
                    description: Some("Include Markdown draft pages in the build"),
                ),
            ],
        ),
        (
            name: "check",
            description: Some("Check your project for errors"),
            options: [
                (
                    names: [
                        "--watch",
                    ],
                    description: Some("Watch Astro files for changes and re-run checks"),
                ),
            ],
        ),
        (
            name: "dev",
            description: Some("Starts the development server"),
            options: [
                (
                    names: [
                        "--port",
                    ],
                    description: Some("Specify a port to listen on"),
                    arguments: [
                        (
                            name: "port",
                            default: Some("3000"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--host",
                    ],
                    description: Some("Listen on all addresses, including LAN and public addresses"),
                    arguments: [
                        (
                            name: "custom address",
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--open",
                    ],
                    description: Some("Automatically open the app in the browser on server start"),
                ),
            ],
        ),
        (
            name: "docs",
            description: Some("Open documentation in your web browser"),
        ),
        (
            name: "preview",
            description: Some("Preview your build locally"),
            options: [
                (
                    names: [
                        "--open",
                    ],
                    description: Some("Automatically open the app in the browser on server start"),
                ),
            ],
        ),
        (
            name: "sync",
            description: Some("Generate content collection types"),
        ),
        (
            name: "telemetry",
            description: Some("Configure telemetry settings"),
            subcommands: [
                (
                    name: "enable",
                    description: Some("Enable anonymous data collection"),
                ),
                (
                    name: "disable",
                    description: Some("Disable anonymous data collection"),
                ),
                (
                    name: "reset",
                    description: Some("Reset anonymous data collection settings"),
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--config",
            ],
            description: Some("Specify your config file"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--root",
            ],
            description: Some("Specify your project root folder"),
            arguments: [
                (
                    name: "path",
                    template: [
                        Folders,
                    ],
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--site",
            ],
            description: Some("Specify your project site"),
            arguments: [
                (
                    name: "url",
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--base",
            ],
            description: Some("Specify your project base"),
            arguments: [
                (
                    name: "pathname",
                    template: [
                        Folders,
                    ],
                ),
            ],
            persistent: true,
        ),
        (
            names: [
                "--verbose",
            ],
            description: Some("Enable verbose logging"),
            persistent: true,
        ),
        (
            names: [
                "--silent",
            ],
            description: Some("Disable all logging"),
            persistent: true,
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Show the version number and exit"),
            persistent: true,
        ),
        (
            names: [
                "--help",
            ],
            description: Some("Show help for astro"),
            persistent: true,
        ),
    ],
    presentation: (
        icon: Some("https://astro.build/favicon.svg"),
    ),
)
