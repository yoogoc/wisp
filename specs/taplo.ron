                                FilePaths,
                            ],
                            suggest_current_token: true,
                        ),
                    ],
                    required: true,
                ),
                (
                    names: [
                        "--colors",
                    ],
                    description: Some("Set color values for the output"),
                    arguments: [
                        (
                            name: "COLORS",
                            suggestions: [
                                (
                                    name: "auto",
                                ),
                                (
                                    name: "always",
                                ),
                                (
                                    name: "never",
                                ),
                            ],
                            default: Some("auto"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Print help information for get"),
                ),
                (
                    names: [
                        "--log-spans",
                    ],
                    description: Some("Enable logging spans"),
                ),
                (
                    names: [
                        "-o",
                        "--output-format",
                    ],
                    description: Some("The format specifying how the output is printed"),
                    arguments: [
                        (
                            name: "OUTPUT_FORMAT",
                            suggestions: [
                                (
                                    name: "value",
                                ),
                                (
                                    name: "json",
                                ),
                                (
                                    name: "toml",
                                ),
                            ],
                            default: Some("value"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--strip-newline",
                        "-s",
                    ],
                    description: Some("Strip the trailing newline from the output"),
                ),
                (
                    names: [
                        "--verbose",
                    ],
                    description: Some("Enable verbose logging format"),
                ),
            ],
        ),
        (
            name: "help",
            description: Some("Print help information for taplo"),
        ),
        (
            name: "lint",
            aliases: [
                "check",
                "validate",
            ],
            description: Some("Lint a TOML documents"),
            options: [
                (
                    names: [
                        "--config",
                        "-c",
                    ],
                    description: Some("Path to the Taplo configuration file"),
                    arguments: [
                        (
                            name: "CONFIG",
                            template: [
