                    ],
                    description: Some("Set color values for the output"),
                    arguments: [
                        (
                            name: "COLORS",
                            suggestions: [
                                (
                                    name: "auto",
                                ),
                                (
                                    name: "always",
                                ),
                                (
                                    name: "never",
                                ),
                            ],
                            default: Some("auto"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--default-schema-catalogs",
                    ],
                    description: Some("Use the default online catalogs for schemas"),
                ),
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Print help information for lint"),
                ),
                (
                    names: [
                        "--log-spans",
                    ],
                    description: Some("Enable logging spans"),
                ),
                (
                    names: [
                        "--no-schema",
                    ],
