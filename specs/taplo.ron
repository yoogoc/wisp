(
    version: 1,
    command: "taplo",
    description: Some("Tool for validation, formatting, and querying TOML documents with a jq-like fashion"),
    subcommands: [
        (
            name: "config",
            aliases: [
                "cfg",
            ],
            description: Some("Operations with the Taplo config file"),
            subcommands: [
                (
                    name: "default",
                    description: Some("Print the default `.taplo.toml` configuration file"),
                ),
                (
                    name: "help",
                    description: Some("Print this message or the help of the given subcommand(s)"),
                    arguments: [
                        (
                            name: "",
                            template: [
                                Help,
                            ],
                        ),
                    ],
                ),
                (
                    name: "schema",
                    description: Some("Print the JSON schema of the `.taplo.toml` configuration file"),
                ),
            ],
            options: [
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Print help information for config"),
                ),
                (
                    names: [
                        "--log-spans",
                    ],
                    description: Some("Enable logging spans"),
                ),
                (
                    names: [
                        "--verbose",
                    ],
                    description: Some("Enable verbose logging format"),
                ),
                (
                    names: [
                        "--colors",
                    ],
                    description: Some("Set color values for the output"),
                    arguments: [
                        (
                            name: "COLORS",
                            suggestions: [
                                (
                                    name: "auto",
                                ),
                                (
                                    name: "always",
                                ),
                                (
                                    name: "never",
                                ),
                            ],
                            default: Some("auto"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "format",
            aliases: [
                "fmt",
            ],
            description: Some("Format TOML documents"),
            options: [
                (
                    names: [
                        "--config",
                        "-c",
                    ],
                    description: Some("Path to the Taplo configuration file"),
                    arguments: [
                        (
                            name: "CONFIG",
                            template: [
                                FilePaths,
                            ],
                            suggest_current_token: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--cache-path",
                    ],
                    description: Some("Set a cache path"),
                    arguments: [
                        (
                            name: "CACHE_PATH",
                            template: [
                                FilePaths,
                            ],
                            suggest_current_token: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--check",
                    ],
                    description: Some("Report any files that are not correctly formatted"),
                    arguments: [
                        (
                            name: "CACHE_PATH",
                            template: [
                                FilePaths,
                            ],
                            optional: true,
                            suggest_current_token: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--colors",
                    ],
                    description: Some("Set color values for the output"),
                    arguments: [
                        (
                            name: "COLORS",
                            suggestions: [
                                (
                                    name: "auto",
                                ),
                                (
                                    name: "always",
                                ),
                                (
                                    name: "never",
                                ),
                            ],
                            default: Some("auto"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--diff",
                    ],
                    description: Some("Print the differences in patch formatting to `stdout`"),
                ),
                (
                    names: [
                        "f",
                        "--force",
                    ],
                    description: Some("Force formatting of files"),
                    arguments: [
                        (
                            name: "FILES ...",
                            template: [
                                FilePaths,
                            ],
                            optional: true,
                            variadic: true,
                            suggest_current_token: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Print help information for format"),
                ),
                (
                    names: [
                        "--log-spans",
                    ],
                    description: Some("Enable logging spans"),
                ),
                (
                    names: [
                        "--no-auto-config",
                    ],
                    description: Some("Do not search for a configuration file"),
                ),
                (
                    names: [
                        "--option",
                        "-o",
                    ],
                    description: Some("A formatter option given as a 'key=value', can be set multiple times"),
                    arguments: [
                        (
                            name: "OPTIONS",
                            suggestions: [
                                (
                                    name: "indent_tables=true",
                                ),
                                (
                                    name: "indent_tables=false",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--stdin-filepath",
                    ],
                    description: Some("A path to the file that the taplo will treat like stdin"),
                    arguments: [
                        (
                            name: "STDIN_FILEPATH",
                            template: [
                                FilePaths,
                            ],
                            suggest_current_token: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--verbose",
                    ],
                    description: Some("Enable verbose logging format"),
                ),
            ],
            arguments: [
                (
                    name: "FILES ...",
                    description: Some("Paths or glob patterns to TOML documents"),
                    template: [
                        FilePaths,
                    ],
                    optional: true,
                    variadic: true,
                    suggest_current_token: true,
                ),
            ],
        ),
        (
            name: "get",
            description: Some("Extract a value from the given TOML document"),
            options: [
                (
                    names: [
                        "--file-path",
                        "-f",
                    ],
                    description: Some("Path to the TOML document"),
                    arguments: [
                        (
                            name: "FILE_PATH",
