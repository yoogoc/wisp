                ),
                (
                    names: [
                        "--schema-catalog",
                    ],
                    description: Some("URL to the schema catalog to be used for validation"),
                    arguments: [
                        (
                            name: "SCHEMA_CATALOG",
                            template: [
                                History,
                            ],
