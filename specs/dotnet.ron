    options: [
        (
            names: [
                "--version",
            ],
            description: Some("Prints out the version of the .NET SDK used by dotnet commands. Includes the effects of any global.json"),
        ),
        (
            names: [
                "--info",
            ],
            description: Some("Prints out detailed information about a .NET installation and the machine environment, such as the current operating system, and commit SHA of the .NET version"),
        ),
        (
            names: [
                "--list-runtimes",
            ],
            description: Some("Prints out a list of the installed .NET runtimes. An x86 version of the SDK lists only x86 runtimes, and an x64 version of the SDK lists only x64 runtimes"),
        ),
        (
            names: [
                "--list-sdks",
            ],
            description: Some("Prints out a list of the installed .NET SDKs"),
        ),
        (
            names: [
                "-?",
                "-h",
                "--help",
            ],
            description: Some("Prints out a list of available commands"),
        ),
        (
            names: [
                "-d",
                "--diagnostics",
            ],
            description: Some("Enables diagnostic output"),
        ),
        (
            names: [
                "-v",
                "--verbosity",
            ],
            description: Some("Sets the verbosity level of the command. Allowed values are q[uiet], m[inimal], n[ormal], d[etailed], and diag[nostic]. Not supported in every command. See specific command page to determine if this option is available"),
            arguments: [
                (
                    name: "verbosity",
                    suggestions: [
                        (
                            name: "quiet",
                        ),
                        (
                            name: "minimal",
                        ),
                        (
                            name: "normal",
                        ),
                        (
                            name: "detailed",
                        ),
                        (
                            name: "diagnostic",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--additionalprobingpath",
            ],
            description: Some("Path containing probing policy and assemblies to probe"),
            arguments: [
                (
                    name: "path",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--additional-deps",
            ],
            description: Some("Path to an additional .deps.json file. A deps.json file contains a list of dependencies, compilation dependencies, and version information used to address assembly conflicts. For more information, see Runtime Configuration Files on GitHub"),
            arguments: [
                (
                    name: "deps",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-depsfile",
            ],
            description: Some("Path to the deps.json file. A deps.json file is a configuration file that contains information about dependencies necessary to run the application. This file is generated by the .NET SDK"),
            arguments: [
                (
                    name: "deps",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--runtimeconfig",
            ],
            description: Some("Path to a runtimeconfig.json file. A runtimeconfig.json file is a configuration file that contains run-time settings"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--roll-forward",
            ],
            description: Some("Controls how roll forward is applied to the app. The SETTING can be one of the following values. If not specified, Minor is the default"),
            arguments: [
                (
                    name: "setting",
                    suggestions: [
                        (
                            name: "LatestPatch",
                        ),
                        (
                            name: "Minor",
                        ),
                        (
                            name: "Major",
                        ),
                        (
                            name: "LatestMinor",
                        ),
                        (
                            name: "LatestMajor",
                        ),
                        (
                            name: "Disable",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--fx-version",
            ],
            description: Some("Version of the .NET runtime to use to run the application"),
            arguments: [
                (
                    name: "version",
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "command",
            generators: [
                (
                    has_custom: true,
                    has_dynamic_trigger: true,
                    has_dynamic_query_term: true,
                ),
            ],
            optional: true,
        ),
    ],
    has_generate_spec: true,
    presentation: (
        icon: Some("https://upload.wikimedia.org/wikipedia/commons/7/7d/Microsoft_.NET_logo.svg"),
    ),
)
