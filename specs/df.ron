(
    version: 1,
    command: "df",
    description: Some("Display free disk space"),
    subcommands: [],
    options: [
        (
            names: [
                "-a",
            ],
            description: Some("Show all mount points"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-b",
                "-P",
            ],
            description: Some("Use 512-byte blocks (default)"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-g",
            ],
            description: Some("Use 1073741824-byte (1-Gbyte) blocks"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-m",
            ],
            description: Some("Use 1048576-byte (1-Mbyte) blocks"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-k",
            ],
            description: Some("Use 1024-byte (1-Kbyte) blocks"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
