(
    version: 1,
    command: "df",
    description: Some("Display free disk space"),
    options: [
        (
            names: [
                "-a",
            ],
            description: Some("Show all mount points"),
        ),
        (
            names: [
                "-b",
                "-P",
            ],
            description: Some("Use 512-byte blocks (default)"),
            exclusive_on: [
                "-g",
                "-k",
                "-m",
            ],
        ),
        (
            names: [
                "-g",
            ],
            description: Some("Use 1073741824-byte (1-Gbyte) blocks"),
            exclusive_on: [
                "-b",
                "-P",
                "-m",
                "-k",
            ],
        ),
        (
            names: [
                "-m",
            ],
            description: Some("Use 1048576-byte (1-Mbyte) blocks"),
            exclusive_on: [
                "-b",
                "-P",
                "-g",
                "-k",
            ],
        ),
        (
            names: [
                "-k",
            ],
            description: Some("Use 1024-byte (1-Kbyte) blocks"),
            exclusive_on: [
                "-b",
                "-P",
                "-g",
                "-m",
            ],
        ),
        (
            names: [
                "-H",
            ],
            description: Some("\"Human-readable\" output, uses base 10 unit suffixes"),
            exclusive_on: [
                "-h",
            ],
        ),
        (
            names: [
                "-h",
            ],
            description: Some("\"Human-readable\" output, uses base 2 unit suffixes"),
            exclusive_on: [
                "-H",
            ],
        ),
        (
            names: [
                "-i",
            ],
            description: Some("Include the number of free inodes"),
        ),
        (
            names: [
                "-l",
            ],
            description: Some("Only display information about locally-mounted filesystems"),
        ),
        (
            names: [
                "-n",
            ],
            description: Some("Print out the previously obtained statistics"),
        ),
        (
            names: [
                "-T",
            ],
            description: Some("Only print out statistics for filesystems of the specified types (comma separated)"),
            arguments: [
                (
                    name: "filesystem",
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "file or filesystem",
        ),
    ],
)
