                    presentation: (
                        hidden: true,
                    ),
                ),
                (
                    names: [
                        "--no-remote",
                    ],
                    description: Some("Do not resolve remote modules"),
                ),
                (
                    names: [
                        "--no-config",
                    ],
                    description: Some("Disable automatic loading of the configuration file"),
