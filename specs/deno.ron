(
    version: 1,
    command: "deno",
    description: Some("A modern JavaScript and TypeScript runtime"),
    subcommands: [
        (
            name: "bench",
            description: Some("Run benchmarks"),
            options: [
                (
                    names: [
                        "--import-map",
                    ],
                    description: Some("Load import map file"),
                    arguments: [
                        (
                            name: "import-map",
                            template: [
                                FilePaths,
                            ],
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "-c",
                        "--config",
                    ],
                    description: Some("Specify the configuration file"),
                    arguments: [
                        (
                            name: "config",
                            template: [
                                FilePaths,
                            ],
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-check",
                    ],
                    description: Some("Skip type-checking modules"),
                    arguments: [
                        (
                            name: "no-check",
                            suggestions: [
                                (
                                    name: "remote",
                                ),
                            ],
                            optional: true,
                            variadic: true,
                        ),
                    ],
                    requires_separator: Some("="),
                ),
                (
                    names: [
                        "--check",
                    ],
                    description: Some("Type-check modules"),
                    arguments: [
                        (
                            name: "check",
                            suggestions: [
                                (
                                    name: "all",
                                ),
                            ],
                            optional: true,
                            variadic: true,
                        ),
                    ],
                    requires_separator: Some("="),
                    exclusive_on: [
                        "--no-check",
                    ],
                ),
                (
                    names: [
                        "-r",
                        "--reload",
                    ],
                    description: Some("Reload source code cache (recompile TypeScript)"),
                    arguments: [
                        (
                            name: "reload",
                            template: [
                                FilePaths,
                            ],
                            optional: true,
                            variadic: true,
