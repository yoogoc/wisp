(
    version: 1,
    command: "remix",
    description: Some("Remix CLI to start, build and export your application"),
    subcommands: [
        (
            name: "build",
            description: Some("Create an optimized production build of your application"),
            options: [
                (
                    names: [
                        "--sourcemap",
                    ],
                    description: Some("Enables production sourcemap"),
                ),
            ],
            arguments: [
                (
                    name: "dir",
                    description: Some("Represent the directory of the Remix application"),
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                icon: Some("https://remix.run/favicon-dark.1.png"),
            ),
        ),
        (
            name: "dev",
            description: Some("Start the application in development mode"),
            arguments: [
                (
                    name: "dir",
                    description: Some("Represent the directory of the Remix application"),
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                icon: Some("https://remix.run/favicon-dark.1.png"),
            ),
        ),
        (
            name: "setup",
            description: Some("Prepare node_modules/remix folder (after installation of packages)"),
            arguments: [
                (
                    name: "dir",
                    description: Some("Represent the directory of the Remix application"),
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                icon: Some("https://remix.run/favicon-dark.1.png"),
            ),
        ),
        (
            name: "routes",
            description: Some("Generate the route config of the application"),
            options: [
                (
                    names: [
                        "--json",
                    ],
                    description: Some("Print the route config as JSON"),
                ),
            ],
            arguments: [
                (
                    name: "dir",
                    description: Some("Represent the directory of the Remix application"),
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                icon: Some("https://remix.run/favicon-dark.1.png"),
            ),
        ),
    ],
    options: [
        (
            names: [
                "--help",
            ],
            description: Some("Output usage information"),
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Output the version number"),
        ),
    ],
)
