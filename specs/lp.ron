(
    version: 1,
    command: "lp",
    description: Some("Print files"),
    options: [
        (
            names: [
                "-E",
            ],
            description: Some("Force encryption when connecting to the server"),
        ),
        (
            names: [
                "-U",
            ],
            description: Some("Specifies the username to use when connecting to the server"),
            arguments: [
                (
                    name: "Username",
                ),
            ],
        ),
        (
            names: [
                "-c",
            ],
            description: Some("This  option is provided for backwards-compatibility only. On systems that support it, this option forces the print file to be copied to the spool directory before printing.  In CUPS, print files are always sent to the scheduler via IPP which has the  same effect"),
        ),
        (
            names: [
                "-d",
            ],
            description: Some("Print files to the named printer"),
            arguments: [
                (
                    name: "Destination printer name",
                ),
            ],
        ),
        (
