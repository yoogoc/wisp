(
    version: 1,
    command: "truncate",
    description: Some("Shrink or extend the size of a file to the specified size"),
    options: [
        (
            names: [
                "--no-create",
                "-c",
            ],
            description: Some("Do not create any files"),
        ),
        (
            names: [
                "--io-blocks",
                "-o",
            ],
            description: Some("Treat SIZE as number of IO blocks instead of bytes"),
        ),
        (
            names: [
                "--reference",
                "-r",
            ],
            description: Some("Base size on RFILE"),
            arguments: [
                (
                    name: "RFILE",
                ),
            ],
        ),
        (
            names: [
                "--size",
                "-s",
            ],
            description: Some("Set or adjust the file size by SIZE bytes"),
            arguments: [
                (
                    name: "SIZE",
                    description: Some("The SIZE argument is an integer and optional unit; units are K,M,G,T,P,E,Z,Y (powers of 1024) or KB,MB,... (powers of 1000). Binary prefixes can be used, too: KiB=K, MiB=M, and so on"),
                ),
            ],
        ),
        (
            names: [
                "--help",
            ],
            description: Some("Show help for truncate"),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Output version information and exit"),
        ),
    ],
    arguments: [
        (
            name: "FILE",
            template: [
                FilePaths,
            ],
            variadic: true,
        ),
    ],
)
