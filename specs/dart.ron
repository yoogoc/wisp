(
    version: 1,
    command: "dart",
    description: Some("A command-line utility for Dart development"),
    subcommands: [
        (
            name: "analyze",
            description: Some("Analyze Dart code in a directory"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Print this usage information"),
                ),
                (
                    names: [
                        "--fatal-infos",
                    ],
                    description: Some("Treat info level issues as fatal"),
                ),
                (
                    names: [
                        "--fatal-warnings",
                    ],
                    description: Some("Treat warning level issues as fatal (defaults to on)"),
                    exclusive_on: [
                        "--no-fatal-warnings",
                    ],
                ),
                (
                    names: [
                        "--no-fatal-warnings",
                    ],
                    description: Some("Do not treat warning level issues as fatal (defaults to on)"),
                    exclusive_on: [
                        "--fatal-warnings",
                    ],
                ),
            ],
            arguments: [
                (
                    name: "directory",
                    description: Some("Dart project directory to analyze"),
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            name: "compile",
