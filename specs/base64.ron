(
    version: 1,
    command: "base64",
    description: Some("Encode and decode using Base64 representation"),
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Display this help and exit"),
        ),
        (
            names: [
                "--break",
                "-b",
            ],
            description: Some("Insert line breaks every count characters.  Default is 0, which generates an unbroken stream"),
            arguments: [
                (
                    name: "count",
                    suggestions: [
                        (
                            name: "0",
                        ),
                    ],
                    default: Some("0"),
                ),
            ],
        ),
        (
            names: [
                "--decode",
                "-d",
                "-D",
            ],
            description: Some("Decode incoming Base64 stream into binary data"),
        ),
        (
            names: [
                "--input",
                "-i",
            ],
            description: Some("Read input from input_file.  Default is stdin; passing - also represents stdin"),
            arguments: [
                (
                    name: "input_file",
                    suggestions: [
                        (
                            name: "stdin",
                        ),
                        (
                            name: "-",
                        ),
                    ],
                    template: [
                        FilePaths,
                    ],
                    default: Some("stdin"),
                ),
            ],
        ),
        (
            names: [
                "--output",
                "-o",
            ],
            description: Some("Write output to output_file.  Default is stdout; passing - also represents stdout"),
            arguments: [
                (
                    name: "output_file",
                    suggestions: [
                        (
                            name: "stdout",
                        ),
                        (
                            name: "-",
                        ),
                    ],
                    template: [
                        FilePaths,
                    ],
                    default: Some("stdout"),
                ),
            ],
        ),
    ],
    parser_directives: Some((
        options_must_precede_arguments: true,
    )),
)
