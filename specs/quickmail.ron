(
    version: 1,
    command: "quickmail",
    description: Some("Quickmail is a terminal-based solution to send mails"),
    subcommands: [
        (
            name: "init",
            description: Some("Initialise cli"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Get help regarding init command"),
                ),
            ],
            arguments: [
                (
                    name: "",
                    template: [
                        FilePaths,
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "clear",
            description: Some("Clear the files stored locally"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Get help regarding clear command"),
                ),
                (
                    names: [
                        "-j",
                        "--justdoit",
                    ],
                    description: Some("Clear entire cli storage including token"),
                ),
            ],
        ),
        (
            name: "send",
            description: Some("Send mail"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Get help regarding send command"),
                ),
                (
                    names: [
                        "-r",
                        "--receiver",
                    ],
                    description: Some("Receiver's email address"),
                    arguments: [
                        (
                            name: "receiver",
                        ),
                    ],
                ),
                (
                    names: [
                        "-sub",
                        "--subject",
                    ],
                    description: Some("Subject of mail"),
                    arguments: [
                        (
                            name: "Subject",
                        ),
                    ],
                ),
                (
                    names: [
                        "-t",
                        "--template",
                    ],
                    description: Some("Templates for mail body"),
                    arguments: [
                        (
                            name: "Template",
                            generators: [
                                (
                                    script: [
                                        "quickmail",
                                        "template",
                                        "listall",
                                    ],
                                    has_post_process: true,
                                ),
                            ],
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "-b",
                        "--body",
                    ],
                    description: Some("Body of the mail"),
                    arguments: [
                        (
                            name: "Body",
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "-a",
                        "--attachment",
                    ],
                    description: Some("Path to attachment file"),
                    arguments: [
                        (
                            name: "Attachment file",
                            template: [
                                FilePaths,
                            ],
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "-l",
                        "--lessgo",
                    ],
                    description: Some("Skip confirmation, and send mail"),
                ),
            ],
        ),
        (
            name: "template",
            description: Some("Manage templates"),
            subcommands: [
                (
                    name: "add",
                    description: Some("Add a new template"),
                    options: [
                        (
                            names: [
                                "-h",
                                "--help",
                            ],
                            description: Some("Get help regarding template add subcommand"),
                        ),
                        (
                            names: [
                                "-n",
                            ],
                            description: Some("Set template id"),
                            arguments: [
                                (
                                    name: "Template id",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "listall",
                    description: Some("List all templates stored"),
                    options: [
                        (
                            names: [
                                "-h",
                                "--help",
                            ],
                            description: Some("Get help regarding template listall subcommand"),
                        ),
                    ],
                ),
                (
                    name: "edit",
                    description: Some("Edit any particular template"),
                    options: [
                        (
                            names: [
                                "-h",
                                "--help",
                            ],
                            description: Some("Get help regarding template edit subcommand"),
                        ),
                        (
                            names: [
                                "-n",
                            ],
                            description: Some("Edit template by id"),
                            arguments: [
                                (
                                    name: "Template id",
                                    generators: [
                                        (
                                            script: [
                                                "quickmail",
                                                "template",
                                                "listall",
                                            ],
                                            has_post_process: true,
                                        ),
                                    ],
                                ),
                            ],
                        ),
                    ],
                ),
            ],
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Get help regarding template command"),
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Output cli version"),
        ),
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Output cli help"),
        ),
    ],
    parser_directives: Some((
        flags_are_posix_noncompliant: true,
    )),
)
