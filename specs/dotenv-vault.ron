(
    version: 1,
    command: "dotenv-vault",
    description: Some("CLI for dotenv-vault"),
    subcommands: [
        (
            name: "new",
            description: Some("Create your project"),
            options: [
                (
                    names: [
                        "--yes",
                        "-y",
                    ],
                    description: Some("Automatic yes to prompts. Assume yes to all prompts and run non-interactively"),
                ),
            ],
            arguments: [
                (
                    name: "DOTENV_VAULT",
                    description: Some("Set .env.vault identifier. Defaults to generated value"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "login",
            description: Some("Log in to dotenv-vault"),
            options: [
                (
                    names: [
                        "--yes",
                        "-y",
                    ],
                    description: Some("Automatic yes to prompts. Assume yes to all prompts and run non-interactively"),
                ),
            ],
            arguments: [
                (
                    name: "DOTENV_ME",
                    description: Some("Set .env.me credential. Defaults to generated value"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "logout",
            description: Some("Log out from dotenv-vault"),
            options: [
                (
                    names: [
                        "--yes",
                        "-y",
                    ],
                    description: Some("Automatic yes to prompts. Assume yes to all prompts and run non-interactively"),
                ),
            ],
        ),
        (
