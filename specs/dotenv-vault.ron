                (
                    names: [
                        "--yes",
                        "-y",
                    ],
                    description: Some("Automatic yes to prompts. Assume yes to all prompts and run non-interactively"),
                ),
            ],
            arguments: [
                (
                    name: "ENVIRONMENT",
                    description: Some("Set environment to open to. Defaults to development"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "push",
            description: Some("Push .env securely"),
            options: [
                (
                    names: [
                        "--yes",
                        "-y",
                    ],
                    description: Some("Automatic yes to prompts. Assume yes to all prompts and run non-interactively"),
                ),
                (
                    names: [
                        "-m",
                        "--dotenvMe",
                    ],
                    description: Some("Pass .env.me (DOTENV_ME) credential directly (rather than reading from .env.me file)"),
                    arguments: [
                        (
                            name: "DOTENV_ME",
                            description: Some("Pass .env.me (DOTENV_ME) credential directly"),
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "ENVIRONMENT",
                    description: Some("Set environment to open to. Defaults to development"),
                    optional: true,
                ),
                (
                    name: "FILENAME",
                    description: Some("Set input filename. Defaults to .env for development and .env.{environment} for other environments"),
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
