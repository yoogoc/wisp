(
    version: 1,
    command: "chmod",
    description: Some("Change file modes or Access Control Lists"),
    subcommands: [],
    options: [
        (
            names: [
                "-f",
            ],
            description: Some("Do not display a diagnostic message if chmod could not modify the mode for file, nor modify the exit status to reflect such failures"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-H",
            ],
            description: Some("If the -R option is specified, symbolic links on the command line are followed and hence unaffected by the command.  (Symbolic links encountered during tree traversal are not followed.)"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-h",
            ],
            description: Some("If the file is a symbolic link, change the mode of the link itself rather than the file that the link points to"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-L",
            ],
            description: Some("If the -R option is specified, all symbolic links are followed"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-P",
            ],
            description: Some("If the -R option is specified, no symbolic links are followed. This is the default"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-R",
            ],
            description: Some("Change the modes of the file hierarchies rooted in the files, instead of just the files themselves. Beware of unintentionally matching the ``..\'\' hard link to the parent directory when using wildcards like ``.*\'\'"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-v",
            ],
            description: Some("Cause chmod to be verbose, showing filenames as the mode is modified. If the -v flag is specified more than once, the old and new modes of the file will also be printed, in both octal and symbolic notation"),
            takes_value: false,
            arguments: [],
        ),
    ],
    arguments: [
        (
            name: "mode",
            source: Static([
                "u+x",
                "a+rx",
                "744",
                "664",
                "777",
            ]),
            optional: false,
            variadic: false,
            imported_generator: None,
        ),
        (
            name: "value",
            source: Files,
            optional: false,
            variadic: false,
            imported_generator: None,
        ),
    ],
)