(
    version: 1,
    command: "@fig/publish-spec",
    description: Some("Publish a spec to fig teams"),
    subcommands: [
        (
            name: "help",
            description: Some("Display help for command"),
            arguments: [
                (
                    name: "command",
                    optional: true,
                ),
            ],
            presentation: (
                priority: Some(49.0),
            ),
        ),
    ],
    options: [
        (
            names: [
                "-V",
                "--version",
            ],
            description: Some("Output the version number"),
        ),
        (
            names: [
                "-i",
                "--interactive",
            ],
            description: Some("Publish a spec interactively"),
        ),
        (
            names: [
                "-t",
                "--token",
            ],
            description: Some("A fig token"),
            arguments: [
                (
                    name: "string",
                ),
            ],
        ),
        (
            names: [
                "--team",
            ],
            description: Some("Set the namespace of the published spec"),
            arguments: [
                (
                    name: "string",
                ),
            ],
        ),
        (
            names: [
                "-n",
                "--name",
            ],
            description: Some("Set the name of the published spec"),
            arguments: [
                (
                    name: "string",
                ),
            ],
        ),
        (
            names: [
                "-p",
                "--spec-path",
            ],
            description: Some("The local path of the spec to publish"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-b",
                "--binary-path",
            ],
            description: Some("The path of the binary to run to generate the spec"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-s",
                "--subcommand-name",
            ],
            description: Some("The subcommand of the binary used to generate the spec"),
            arguments: [
                (
                    name: "string",
                ),
            ],
        ),
        (
            names: [
                "--is-script",
            ],
            description: Some("The spec is a local script and will only be loaded when referenced in a fig/config.json file"),
        ),
        (
            names: [
                "-f",
                "--framework",
            ],
            description: Some("Framework used to build the CLI"),
            arguments: [
                (
                    name: "string",
                ),
            ],
        ),
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Display help for command"),
            presentation: (
                priority: Some(49.0),
            ),
        ),
    ],
)
