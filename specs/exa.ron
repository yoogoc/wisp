(
    version: 1,
    command: "exa",
    description: Some("A modern replacement for ls"),
    options: [
        (
            names: [
                "-?",
                "--help",
            ],
            description: Some("Show list of command-line options"),
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Show version of exa"),
        ),
        (
            names: [
                "-1",
                "--oneline",
            ],
            description: Some("Display one entry per line"),
        ),
        (
            names: [
                "-l",
                "--long",
            ],
            description: Some("Display extended file metadata as a table"),
        ),
        (
            names: [
                "-G",
                "--grid",
            ],
            description: Some("Display entries as a grid (default)"),
        ),
        (
            names: [
                "-x",
                "--across",
            ],
            description: Some("Sort the grid across, rather than downwards"),
        ),
        (
            names: [
                "-R",
                "--recurse",
            ],
            description: Some("Recurse into directories"),
        ),
        (
            names: [
                "-T",
                "--tree",
            ],
            description: Some("Recurse into directories as a tree"),
        ),
        (
            names: [
                "-F",
                "--classify",
            ],
            description: Some("Display type indicator by file names"),
        ),
        (
            names: [
                "--colour",
                "--color",
            ],
            description: Some("When to use terminal colours (always, auto, never)"),
            arguments: [
                (
                    name: "when",
                    suggestions: [
                        (
                            name: "always",
                        ),
                        (
                            name: "auto",
                        ),
                        (
                            name: "never",
                        ),
                    ],
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--colour-scale",
                "--color-scale",
            ],
            description: Some("Highlight levels of file sizes distinctly"),
        ),
        (
            names: [
                "-a",
                "--all",
            ],
            description: Some("Show hidden and 'dot' files"),
        ),
        (
            names: [
                "-d",
                "--list-dirs",
            ],
            description: Some("List directories like regular files"),
        ),
        (
            names: [
                "-L",
                "--level",
            ],
            description: Some("Limit the depth of recursion"),
            arguments: [
                (
                    name: "DEPTH",
                ),
            ],
        ),
        (
            names: [
                "-r",
                "--reverse",
            ],
            description: Some("Reverse the sort order"),
        ),
        (
            names: [
                "-s",
                "--sort",
            ],
            description: Some("Which field to sort by"),
            arguments: [
                (
                    name: "sort field",
                    suggestions: [
                        (
                            name: "name",
                        ),
                        (
                            name: "Name",
                        ),
                        (
                            name: "extension",
                        ),
                        (
                            name: "Extension",
                        ),
                        (
                            name: "size",
                        ),
                        (
                            name: "type",
                        ),
                        (
                            name: "modified",
                        ),
                        (
                            name: "accessed",
                        ),
                        (
                            name: "created",
                        ),
                        (
                            name: "inode",
                        ),
                        (
                            name: "none",
                        ),
                        (
                            name: "date",
                        ),
                        (
                            name: "time",
                        ),
                        (
                            name: "old",
                        ),
                        (
                            name: "new",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--group-directories-first",
            ],
            description: Some("List directories before other files"),
        ),
        (
            names: [
                "-D",
                "--only-dirs",
            ],
            description: Some("List only directories"),
        ),
        (
            names: [
                "-I",
                "--ignore-glob",
            ],
            description: Some("Glob patterns (pipe-separated) of files to ignore"),
            arguments: [
                (
                    name: "GLOB",
                ),
            ],
        ),
        (
            names: [
                "--git-ignore",
            ],
            description: Some("Ignore files mentioned in '.gitignore'"),
        ),
        (
            names: [
                "-b",
                "--binary",
            ],
            description: Some("List file sizes with binary prefixes"),
        ),
        (
            names: [
                "-B",
                "--bytes",
            ],
            description: Some("List file sizes in bytes, without any prefixes"),
        ),
        (
            names: [
                "-g",
                "--group",
            ],
            description: Some("List each file's group"),
        ),
        (
            names: [
                "-h",
                "--header",
            ],
            description: Some("Add a header row to each column"),
        ),
        (
            names: [
                "-H",
                "--links",
            ],
            description: Some("List each file's number of hard links"),
        ),
        (
            names: [
                "-i",
                "--inode",
            ],
            description: Some("List each file's inode number"),
        ),
        (
            names: [
                "-m",
                "--modified",
            ],
            description: Some("Use the modified timestamp field"),
        ),
        (
            names: [
                "-S",
                "--blocks",
            ],
            description: Some("Show number of file system blocks"),
        ),
        (
            names: [
                "-t",
                "--time",
            ],
            description: Some("Which timestamp field to list (modified, accessed, created)"),
            arguments: [
                (
                    name: "FIELD",
                    suggestions: [
                        (
                            name: "modified",
                        ),
                        (
                            name: "accessed",
                        ),
                        (
                            name: "created",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-u",
                "--accessed",
            ],
            description: Some("Use the accessed timestamp field"),
        ),
        (
            names: [
                "-U",
                "--created",
            ],
            description: Some("Use the created timestamp field"),
        ),
        (
            names: [
                "--time-style",
            ],
            description: Some("How to format timestamps (default, iso, long-iso, full-iso)"),
            arguments: [
                (
                    name: "style",
                    suggestions: [
                        (
                            name: "default",
                        ),
                        (
                            name: "iso",
                        ),
                        (
                            name: "long-iso",
                        ),
                        (
                            name: "full-iso",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--git",
            ],
            description: Some("List each file's Git status, if tracked or ignored"),
        ),
        (
            names: [
                "-@",
                "--extended",
            ],
            description: Some("List each file's extended attributes and sizes"),
        ),
        (
            names: [
                "--icons",
            ],
            description: Some("Shows icons before each folder or file"),
            exclusive_on: [
                "--no-icons",
            ],
        ),
        (
            names: [
                "--no-icons",
            ],
            description: Some("Does not display icons"),
            exclusive_on: [
                "--icons",
            ],
        ),
        (
            names: [
                "--changed",
            ],
            description: Some("Displays when a file or folder got changed instead of modified in the header"),
        ),
    ],
    arguments: [
        (
            name: "files...",
            template: [
                FilePaths,
            ],
            variadic: true,
        ),
    ],
)
