(
    version: 1,
    command: "more",
    description: Some("Opposite of less"),
    options: [
        (
            names: [
                "-d",
                "--silent",
            ],
            description: Some("Prompt with '[Press space to continue, 'q' to quit.]', and display '[Press 'h' for instructions.]' instead of ringing the bell when an illegal key is pressed"),
        ),
        (
            names: [
                "-l",
                "--logical",
            ],
            description: Some("Do not pause after any line containing a ^L (form feed)"),
        ),
        (
            names: [
                "-f",
                "--no-pause",
            ],
            description: Some("Count logical lines, rather than screen lines"),
        ),
        (
            names: [
                "-p",
                "--print-over",
            ],
            description: Some("Instead, clear the whole screen and then display the text"),
        ),
        (
            names: [
                "-c",
                "--clean-print",
            ],
            description: Some("Instead, paint each screen from the top, clearing the remainder of each line as it is displayed"),
        ),
        (
            names: [
                "-s",
                "--squeeze",
            ],
            description: Some("Squeeze multiple blank lines into one"),
        ),
        (
            names: [
                "-u",
                "--plain",
            ],
            description: Some("Silently ignored as backwards compatibility"),
        ),
        (
            names: [
                "-n",
                "--lines",
            ],
            description: Some("Specify the number of lines per screenful"),
            arguments: [
                (
                    name: "n",
                ),
            ],
        ),
        (
            names: [
                "--help",
            ],
            description: Some("Display help text"),
        ),
        (
            names: [
                "-V",
                "--version",
            ],
            description: Some("Display version information"),
        ),
    ],
    arguments: [
        (
            name: "",
            template: [
                FilePaths,
            ],
            variadic: true,
        ),
    ],
)
