(
    version: 1,
    command: "networksetup",
    description: Some("Configuration tool for network settings in System Preferences"),
    subcommands: [
        (
            name: "-listnetworkserviceorder",
            description: Some("Displays a list of network services in the order they are contacted for a connection, along with the corresponding port and device for each"),
        ),
        (
            name: "-listallnetworkservices",
            description: Some("Displays a list of all the network services on the server's hardware ports"),
        ),
        (
            name: "-listallhardwareports",
            description: Some("Displays list of hardware ports with corresponding device name and ethernet address"),
        ),
        (
            name: "-detectnewhardware",
            description: Some("Detects new network hardware and creates a default network service on the hardware"),
        ),
        (
            name: "-getmacaddress",
            description: Some("Displays ethernet (or Wi-Fi) address for hardwareport or device specified"),
            arguments: [
                (
                    name: "hardwareport",
                    generators: [
                        (
                            script: [
                                "networksetup",
                                "-listallhardwareports",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "-getcomputername",
            description: Some("Displays the computer name"),
        ),
        (
            name: "-setcomputername",
            description: Some("Sets computer name to <computername>. This name is used by AFP"),
            arguments: [
                (
                    name: "computername",
                    description: Some("The new name for your computer on the network"),
                ),
            ],
        ),
        (
            name: "-getinfo",
            description: Some("Displays the IP address, subnet mask, router, and hardware address for the <networkservice> that you specify"),
            arguments: [
                (
                    name: "networkservice",
                    generators: [
                        (
                            script: [
                                "networksetup",
                                "-listallnetworkservices",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "-setmanual",
            description: Some("Set the TCP/IP configuration for <networkservice> to manual with IP address set to <ip>, Subnet Mask set to <subnet>, and Router address set to <router>"),
            arguments: [
                (
                    name: "networkservice",
                    generators: [
                        (
                            script: [
                                "networksetup",
                                "-listallnetworkservices",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
                (
                    name: "ip",
                    description: Some("The IP address to set for the network service"),
                ),
                (
                    name: "subnet",
                    description: Some("The subnet mask to apply"),
                ),
                (
                    name: "router",
                    description: Some("The router address to set"),
                ),
            ],
        ),
        (
            name: "-setdhcp",
            description: Some("Use this command to set the TCP/IP configuration for the specified <networkservice> to use DHCP. The client ID is optional. Specify \"Empty\" for [clientid] to clear the DHCP client id"),
            arguments: [
                (
                    name: "networkservice",
                    generators: [
                        (
                            script: [
                                "networksetup",
                                "-listallnetworkservices",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
                (
                    name: "clientid",
                    description: Some("Optional DHCP client ID. Use 'Empty' to clear it"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "-setbootp",
            description: Some("Use this command to set the TCP/IP configuration for the specified <networkservice> to use BOOTP"),
            arguments: [
                (
                    name: "networkservice",
                    generators: [
                        (
                            script: [
                                "networksetup",
                                "-listallnetworkservices",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "-setmanualwithdhcprouter",
            description: Some("Use this command to specify a manual IP address to use for DHCP for the specified <networkservice>"),
            arguments: [
                (
                    name: "networkservice",
                    generators: [
                        (
                            script: [
                                "networksetup",
                                "-listallnetworkservices",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
                (
                    name: "ip",
                    description: Some("The IP address to set for the network service"),
                ),
            ],
        ),
        (
            name: "-getadditionalroutes",
            description: Some("Use this command to display the list of additional IPv4 routes configured for the service"),
            arguments: [
                (
                    name: "networkservice",
                    generators: [
                        (
                            script: [
                                "networksetup",
                                "-listallnetworkservices",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "-setadditionalroutes",
            description: Some("Use this command to set the list of IPv4 additional routes configured for the service. Each route is specified as a (destination address, subnet mask, gateway address) tuple. Specifying no tuples clears the list of routes"),
            arguments: [
                (
                    name: "networkservice",
                    generators: [
                        (
                            script: [
                                "networksetup",
                                "-listallnetworkservices",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
                (
                    name: "dest mask gate",
                    description: Some("One or more tuples of (destination address, subnet mask, gateway address). Specify 'Empty' to clear routes"),
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "-setv4off",
            description: Some("Use this command to turn IPv4 off on the specified <networkservice>"),
            arguments: [
                (
                    name: "networkservice",
                    generators: [
                        (
                            script: [
                                "networksetup",
                                "-listallnetworkservices",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "-setv6off",
            description: Some("Use this command to turn IPv6 off on the specified <networkservice>"),
            arguments: [
                (
                    name: "networkservice",
                    generators: [
                        (
                            script: [
                                "networksetup",
                                "-listallnetworkservices",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "-setv6automatic",
            description: Some("Use this command to set IPv6 to get its addresses automatically for <networkservice>"),
            arguments: [
                (
                    name: "networkservice",
                    generators: [
                        (
                            script: [
                                "networksetup",
                                "-listallnetworkservices",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "-setv6linklocal",
            description: Some("Use this command to set IPv6 to only use link local for <networkservice>"),
            arguments: [
                (
                    name: "networkservice",
                    generators: [
                        (
                            script: [
                                "networksetup",
                                "-listallnetworkservices",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "-setv6manual",
            description: Some("Use this command to set IPv6 to get its addresses manually for <networkservice>. Specify the ip address, the prefix length and the router"),
            arguments: [
                (
                    name: "ip",
                    description: Some("The IPv6 address to assign"),
                ),
                (
                    name: "prefixlength",
                    description: Some("The prefix length for the IPv6 address (e.g., 64)"),
                ),
                (
                    name: "router",
                    description: Some("The IPv6 address of the router"),
                ),
            ],
        ),
        (
            name: "-getv6additionalroutes",
            description: Some("Use this command to display the list of additional IPv6 routes configured for the service"),
            arguments: [
                (
                    name: "networkservice",
                    generators: [
                        (
                            script: [
                                "networksetup",
                                "-listallnetworkservices",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "-setv6additionalroutes",
            description: Some("Use this command to set the list of additional routes configured for the service. Each route is specified as a (destination address, prefix length, gateway address) tuple. Specifying no tuples clears the list of routes"),
            arguments: [
                (
                    name: "networkservice",
                    generators: [
                        (
                            script: [
                                "networksetup",
                                "-listallnetworkservices",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
                (
                    name: "dest prefixlength gate",
                    description: Some("The list of routes, each specified as a tuple of destination address, prefix length, and gateway address. Provide multiple routes or omit this to clear all routes"),
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "-getdnsservers",
            description: Some("Displays DNS info for <networkservice>"),
            arguments: [
                (
                    name: "networkservice",
                    generators: [
                        (
                            script: [
                                "networksetup",
                                "-listallnetworkservices",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "-setdnsservers",
            description: Some("Use this command to specify the IP addresses of servers you want the specified <networkservice> to use to resolve domain names. You can list any number of servers (replace dns1, dns2, and so on with the IP addresses of domain name servers). If you want to clear all DNS entries for the specified network service, type \"empty\" in place of the DNS server names"),
            arguments: [
                (
                    name: "networkservice",
                    generators: [
                        (
                            script: [
                                "networksetup",
                                "-listallnetworkservices",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
                (
                    name: "dns",
                    description: Some("IP addresses of DNS servers. Use 'empty' to clear all DNS entries"),
                    variadic: true,
                ),
            ],
        ),
        (
            name: "-getsearchdomains",
            description: Some("Displays Domain Name info for <networkservice>"),
            arguments: [
                (
                    name: "networkservice",
                    generators: [
                        (
                            script: [
                                "networksetup",
                                "-listallnetworkservices",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "-setsearchdomains",
            description: Some("Use this command to designate the search domain for the specified <networkservice>. You can list any number of search domains (replace domain1, domain2, and so on with the name of a local domain). If you want to clear all search domain entries for the specified network service, type “empty” in place of the domain name"),
            arguments: [
                (
                    name: "networkservice",
                    generators: [
                        (
                            script: [
                                "networksetup",
                                "-listallnetworkservices",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
                (
                    name: "domain",
                    description: Some("List of search domains. Use 'empty' to clear all existing domains"),
                    variadic: true,
                ),
            ],
        ),
        (
            name: "-create6to4service",
            description: Some("Use this command to create a new 6 to 4 service with name <newnetworkservicename>"),
            arguments: [
                (
                    name: "newnetworkservicename",
                    description: Some("The name of the new 6 to 4 service to be created"),
                ),
            ],
        ),
        (
            name: "-set6to4automatic",
            description: Some("Use this command to set the 6 to 4 service such that it will get the relay address automatically"),
            arguments: [
                (
                    name: "newnetworkservicename",
                    description: Some("The name of the 6 to 4 service to be configured for automatic relay address retrieval"),
                ),
            ],
        ),
        (
            name: "-set6to4manual",
            description: Some("Use this command to set the 6 to 4 service such that it will get the relay address manually. Specify the <relayaddress> that you would like to set"),
            arguments: [
                (
                    name: "newnetworkservicename",
                    description: Some("The name of the 6 to 4 service to be configured"),
                ),
                (
                    name: "relayaddress",
                    description: Some("The manually specified relay address to be used by the 6 to 4 service"),
                ),
            ],
        ),
        (
            name: "-getwebproxy",
            description: Some("Displays Web proxy (server, port, enabled value) info for <networkservice>"),
            arguments: [
                (
                    name: "networkservice",
                    generators: [
                        (
                            script: [
                                "networksetup",
                                "-listallnetworkservices",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "-setwebproxy",
            description: Some("Set Web proxy for <networkservice> with <domain> and <port number>. Turns proxy on. Optionally, specify <on> or <off> for <authenticated> to enable and disable authenticated proxy support. Specify <username> and <password> if you turn authenticated proxy support on"),
            arguments: [
                (
                    name: "networkservice",
                    generators: [
                        (
                            script: [
                                "networksetup",
                                "-listallnetworkservices",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
                (
                    name: "domain",
                    description: Some("The domain name or IP address of the proxy server"),
                ),
                (
                    name: "portnumber",
                    description: Some("The port number for the proxy server"),
                ),
                (
                    name: "authenticated",
                    description: Some("Specify whether proxy authentication is required"),
                    suggestions: [
                        (
                            name: "on",
                            description: Some("Specify <on> for <authenticated> to enable authenticated proxy support"),
                        ),
                        (
                            name: "off",
                            description: Some("Specify <off> for <authenticated> to disable authenticated proxy support"),
                        ),
                    ],
                    optional: true,
                ),
                (
                    name: "username",
                    description: Some("The username for proxy authentication"),
                ),
                (
                    name: "password",
                    description: Some("The password for proxy authentication"),
                ),
            ],
        ),
        (
            name: "-setwebproxystate",
            description: Some("Set Web proxy on <networkservice> to either <on> or <off>"),
            arguments: [
                (
                    name: "networkservice",
                    generators: [
                        (
                            script: [
                                "networksetup",
                                "-listallnetworkservices",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
                (
                    name: "on | off",
                    suggestions: [
                        (
                            name: "on",
                        ),
                        (
                            name: "off",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "-getsecurewebproxy",
