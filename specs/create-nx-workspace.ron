(
    version: 1,
    command: "create-nx-workspace",
    description: Some("Create a new Nx workspace"),
    subcommands: [],
    options: [
        (
            names: [
                "--name",
            ],
            description: Some("Workspace name (e.g., org name)"),
            takes_value: true,
            arguments: [
                (
                    name: "workspace",
                    source: Files,
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "--preset",
            ],
            description: Some("What to create in a new workspace (options: \"empty\", \"npm\", \"web-components\", \"angular\", \"angular-nest\", \"react\", \"react-express\", \"react-native\", \"next\", \"gatsby\", \"nest\", \"express\")"),
            takes_value: true,
            arguments: [
                (
                    name: "preset",
                    source: Static([
                        "empty",
                        "npm",
                        "web-components",
                        "angular",
                        "angular-nest",
                        "react",
                        "react-express",
                        "react-native",
                        "next",
                        "gatsby",
                        "nest",
                        "express",
                    ]),
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "--appName",
            ],
            description: Some("The name of the application created by some presets"),
            takes_value: true,
            arguments: [
                (
                    name: "appName",
                    source: Files,
                    optional: true,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "--cli",
            ],
            description: Some("CLI to power the Nx workspace (options: \"nx\", \"angular\")"),
            takes_value: true,
            arguments: [
                (
                    name: "cli",
                    source: Static([
                        "nx",
                        "angular",
                    ]),
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "--style",
            ],
            description: Some("Default style option to be used when a non-empty preset is selected options: (\"css\", \"scss\", \"less\") plus (\"styl\") for all non-Angular and (\"styled-components\", \"@emotion/styled\", \"styled-jsx\") for React, Next.js, Gatsby"),
            takes_value: true,
            arguments: [
                (
                    name: "style",
                    source: Static([
                        "css",
                        "scss",
                        "less",
                        "styl",
                        "styled-components",
                        "@emotion/styled",
                        "styled-jsx",
                    ]),
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "--interactive",
            ],
            description: Some("Enable interactive mode when using presets (boolean)"),
            takes_value: true,
            arguments: [
                (
                    name: "interactive",
                    source: Static([
                        "true",
                        "false",
                    ]),
                    optional: true,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "--packageManager",
                "--pm",
            ],
            description: Some("Package manager to use (npm, yarn, pnpm)"),
            takes_value: true,
            arguments: [
                (
                    name: "packageManager",
                    source: Static([
                        "npm",
                        "yarn",
                        "pnpm",
                    ]),
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "--nx-cloud",
            ],
            description: Some("Use Nx Cloud (boolean)"),
            takes_value: true,
            arguments: [
                (
                    name: "nx-cloud",
                    source: Static([
                        "true",
                        "false",
                    ]),
                    optional: true,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for create-nx-workspace"),
            takes_value: false,
            arguments: [],
        ),
    ],
    arguments: [
        (
            name: "workspace",
            source: Files,
            optional: false,
            variadic: false,
            imported_generator: None,
        ),
