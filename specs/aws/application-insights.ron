(
    version: 1,
    command: "application-insights",
    description: Some("Amazon CloudWatch Application Insights  Amazon CloudWatch Application Insights is a service that helps you detect common problems with your applications. It enables you to pinpoint the source of issues in your applications (built with technologies such as Microsoft IIS, .NET, and Microsoft SQL Server), by providing key insights into detected problems. After you onboard your application, CloudWatch Application Insights identifies, recommends, and sets up metrics and logs. It continuously analyzes and correlates your metrics and logs for unusual behavior to surface actionable problems with your application. For example, if your application is slow and unresponsive and leading to HTTP 500 errors in your Application Load Balancer (ALB), Application Insights informs you that a memory pressure problem with your SQL Server database is occurring. It bases this analysis on impactful metrics and log errors"),
    subcommands: [
        (
            name: "add-workload",
            description: Some("Adds a workload to a component. Each component can have at most five workloads"),
            options: [
                (
                    names: [
                        "--resource-group-name",
                    ],
                    description: Some("The name of the resource group"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--component-name",
                    ],
                    description: Some("The name of the component"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--workload-configuration",
                    ],
                    description: Some("The configuration settings of the workload. The value is the escaped JSON of the configuration"),
                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
                    names: [
                        "--cli-input-json",
                    ],
                    description: Some("Performs service operation based on the JSON string provided. The JSON string follows the format provided by ``--generate-cli-skeleton``. If other arguments are provided on the command line, the CLI values will override the JSON-provided values. It is not possible to pass arbitrary binary values using a JSON-provided value as the string will be taken literally"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--generate-cli-skeleton",
                    ],
                    description: Some("Prints a JSON skeleton to standard output without sending an API request. If provided with no value or the value ``input``, prints a sample input JSON that can be used as an argument for ``--cli-input-json``. If provided with the value ``output``, it validates the command inputs and returns a sample output JSON for that command"),
                    arguments: [
                        (
                            name: "string",
                            suggestions: [
                                (
                                    name: "input",
                                ),
                                (
                                    name: "output",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "create-application",
            description: Some("Adds an application that is created from a resource group"),
            options: [
                (
                    names: [
                        "--resource-group-name",
                    ],
                    description: Some("The name of the resource group"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--ops-center-enabled",
                    ],
                    description: Some("When set to true, creates opsItems for any problems detected on an application"),
                ),
                (
                    names: [
                        "--no-ops-center-enabled",
                    ],
                    description: Some("When set to true, creates opsItems for any problems detected on an application"),
                ),
                (
                    names: [
                        "--cwe-monitor-enabled",
                    ],
                    description: Some("Indicates whether Application Insights can listen to CloudWatch events for the application resources, such as instance terminated, failed deployment, and others"),
                ),
                (
                    names: [
                        "--no-cwe-monitor-enabled",
                    ],
                    description: Some("Indicates whether Application Insights can listen to CloudWatch events for the application resources, such as instance terminated, failed deployment, and others"),
                ),
                (
                    names: [
                        "--ops-item-sns-topic-arn",
                    ],
                    description: Some("The SNS topic provided to Application Insights that is associated to the created opsItem. Allows you to receive notifications for updates to the opsItem"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--sns-notification-arn",
                    ],
                    description: Some("The SNS notification topic ARN"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--tags",
                    ],
                    description: Some("List of tags to add to the application. tag key (Key) and an associated tag value (Value). The maximum length of a tag key is 128 characters. The maximum length of a tag value is 256 characters"),
                    arguments: [
                        (
                            name: "list",
                        ),
                    ],
                ),
                (
                    names: [
                        "--auto-config-enabled",
                    ],
                    description: Some("Indicates whether Application Insights automatically configures unmonitored resources in the resource group"),
                ),
                (
                    names: [
                        "--no-auto-config-enabled",
                    ],
                    description: Some("Indicates whether Application Insights automatically configures unmonitored resources in the resource group"),
                ),
                (
                    names: [
                        "--auto-create",
                    ],
                    description: Some("Configures all of the resources in the resource group by applying the recommended configurations"),
                ),
                (
                    names: [
                        "--no-auto-create",
                    ],
                    description: Some("Configures all of the resources in the resource group by applying the recommended configurations"),
                ),
                (
                    names: [
                        "--grouping-type",
                    ],
                    description: Some("Application Insights can create applications based on a resource group or on an account. To create an account-based application using all of the resources in the account, set this parameter to ACCOUNT_BASED"),
                    arguments: [
                        (
                            name: "string",
