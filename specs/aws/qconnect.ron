            options: [
                (
                    names: [
                        "--knowledge-base-id",
                    ],
                    description: Some("The identifier of the knowledge base. Can be either the ID or the ARN. URLs cannot contain the ARN"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--message-template-id",
                    ],
                    description: Some("The identifier of the message template. Can be either the ID or the ARN. It cannot contain any qualifier"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--version-number",
                    ],
                    description: Some("The version number of the message template version to activate"),
                    arguments: [
                        (
                            name: "long",
                        ),
                    ],
                ),
                (
                    names: [
                        "--cli-input-json",
                    ],
                    description: Some("Performs service operation based on the JSON string provided. The JSON string follows the format provided by ``--generate-cli-skeleton``. If other arguments are provided on the command line, the CLI values will override the JSON-provided values. It is not possible to pass arbitrary binary values using a JSON-provided value as the string will be taken literally"),
                    arguments: [
                        (
