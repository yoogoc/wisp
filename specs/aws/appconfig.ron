                ),
                (
                    names: [
                        "--tags",
                    ],
                    description: Some("Metadata to assign to the environment. Tags help organize and categorize your AppConfig resources. Each tag consists of a key and an optional value, both of which you define"),
                    arguments: [
                        (
                            name: "map",
