                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--server-side-kms-key-id",
                    ],
                    description: Some("Provides the identifier of the KMS key used to encrypt inference scheduler data by Amazon Lookout for Equipment"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--client-token",
                    ],
                    description: Some("A unique identifier for the request. If you do not set the client request token, Amazon Lookout for Equipment generates one"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--tags",
                    ],
                    description: Some("Any tags associated with the inference scheduler"),
                    arguments: [
                        (
                            name: "list",
