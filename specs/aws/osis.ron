(
    version: 1,
    command: "osis",
    description: Some("Use the Amazon OpenSearch Ingestion API to create and manage ingestion pipelines. OpenSearch Ingestion is a fully managed data collector that delivers real-time log and trace data to OpenSearch Service domains. For more information, see Getting data into your cluster using OpenSearch Ingestion"),
    subcommands: [
        (
            name: "create-pipeline",
            description: Some("Creates an OpenSearch Ingestion pipeline. For more information, see Creating Amazon OpenSearch Ingestion pipelines"),
            options: [
                (
                    names: [
                        "--pipeline-name",
                    ],
                    description: Some("The name of the OpenSearch Ingestion pipeline to create. Pipeline names are unique across the pipelines owned by an account within an Amazon Web Services Region"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--min-units",
                    ],
                    description: Some("The minimum pipeline capacity, in Ingestion Compute Units (ICUs)"),
                    arguments: [
                        (
                            name: "integer",
                        ),
                    ],
                ),
                (
                    names: [
                        "--max-units",
                    ],
                    description: Some("The maximum pipeline capacity, in Ingestion Compute Units (ICUs)"),
                    arguments: [
                        (
                            name: "integer",
                        ),
                    ],
                ),
                (
                    names: [
                        "--pipeline-configuration-body",
                    ],
                    description: Some("The pipeline configuration in YAML format. The command accepts the pipeline configuration as a string or within a .yaml file. If you provide the configuration as a string, each new line must be escaped with \\n"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--log-publishing-options",
                    ],
                    description: Some("Key-value pairs to configure log publishing"),
                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
                    names: [
                        "--vpc-options",
                    ],
                    description: Some("Container for the values required to configure VPC access for the pipeline. If you don't specify these values, OpenSearch Ingestion creates the pipeline with a public endpoint"),
                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
                    names: [
                        "--buffer-options",
                    ],
                    description: Some("Key-value pairs to configure persistent buffering for the pipeline"),
                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
                    names: [
                        "--encryption-at-rest-options",
                    ],
                    description: Some("Key-value pairs to configure encryption for data that is written to a persistent buffer"),
                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
                    names: [
                        "--tags",
                    ],
                    description: Some("List of tags to add to the pipeline upon creation"),
                    arguments: [
                        (
                            name: "list",
                        ),
                    ],
