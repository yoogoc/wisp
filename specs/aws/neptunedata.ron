                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--ml-model-training-job-id",
                    ],
                    description: Some("The job Id of the completed model-training job that has created the model that the inference endpoint will point to. You must supply either the mlModelTrainingJobId or the mlModelTransformJobId"),
