(
    version: 1,
    command: "savingsplans",
    description: Some("Savings Plans are a pricing model that offer significant savings on Amazon Web Services usage (for example, on Amazon EC2 instances). You commit to a consistent amount of usage per hour, in the specified currency, for a term of one or three years, and receive a lower price for that usage. For more information, see the Amazon Web Services Savings Plans User Guide"),
    subcommands: [
        (
            name: "create-savings-plan",
            description: Some("Creates a Savings Plan"),
            options: [
                (
                    names: [
                        "--savings-plan-offering-id",
                    ],
                    description: Some("The ID of the offering"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--commitment",
                    ],
                    description: Some("The hourly commitment, in the same currency of the savingsPlanOfferingId. This is a value between 0.001 and 1 million. You cannot specify more than five digits after the decimal point"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--upfront-payment-amount",
                    ],
                    description: Some("The up-front payment amount. This is a whole number between 50 and 99 percent of the total value of the Savings Plan. This parameter is only supported if the payment option is Partial Upfront"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--purchase-time",
                    ],
                    description: Some("The purchase time of the Savings Plan in UTC format (YYYY-MM-DDTHH:MM:SSZ)"),
                    arguments: [
                        (
                            name: "timestamp",
                        ),
                    ],
                ),
                (
                    names: [
                        "--client-token",
                    ],
                    description: Some("A unique, case-sensitive identifier that you provide to ensure the idempotency of the request"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--tags",
                    ],
                    description: Some("One or more tags"),
                    arguments: [
                        (
                            name: "map",
                        ),
