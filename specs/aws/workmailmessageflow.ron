(
    version: 1,
    command: "workmailmessageflow",
    description: Some("The WorkMail Message Flow API provides access to email messages as they are being sent and received by a WorkMail organization"),
    subcommands: [
        (
            name: "get-raw-message-content",
            description: Some("Retrieves the raw content of an in-transit email message, in MIME format"),
            options: [
                (
                    names: [
                        "--message-id",
                    ],
                    description: Some("The identifier of the email message to retrieve"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "outfile",
                    ],
                    description: Some("Filename where the content will be saved"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "put-raw-message-content",
            description: Some("Updates the raw content of an in-transit email message, in MIME format. This example describes how to update in-transit email message. For more information and examples for using this API, see  Updating message content with AWS Lambda.  Updates to an in-transit message only appear when you call PutRawMessageContent from an AWS Lambda function configured with a synchronous  Run Lambda rule. If you call PutRawMessageContent on a delivered or sent message, the message remains unchanged, even though GetRawMessageContent returns an updated message"),
            options: [
                (
                    names: [
                        "--message-id",
                    ],
                    description: Some("The identifier of the email message being updated"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--content",
                    ],
                    description: Some("Describes the raw message content of the updated email message"),
                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
                    names: [
                        "--cli-input-json",
                    ],
                    description: Some("Performs service operation based on the JSON string provided. The JSON string follows the format provided by ``--generate-cli-skeleton``. If other arguments are provided on the command line, the CLI values will override the JSON-provided values. It is not possible to pass arbitrary binary values using a JSON-provided value as the string will be taken literally"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--generate-cli-skeleton",
                    ],
                    description: Some("Prints a JSON skeleton to standard output without sending an API request. If provided with no value or the value ``input``, prints a sample input JSON that can be used as an argument for ``--cli-input-json``. If provided with the value ``output``, it validates the command inputs and returns a sample output JSON for that command"),
                    arguments: [
                        (
                            name: "string",
                            suggestions: [
                                (
                                    name: "input",
                                ),
                                (
                                    name: "output",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
    ],
)
