                    names: [
                        "--name",
                    ],
                    description: Some("The unique name of the invoice unit that is shown on the generated invoice. This can't be changed once it is set. To change this name, you must delete the invoice unit recreate"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--invoice-receiver",
                    ],
                    description: Some("The Amazon Web Services account ID chosen to be the receiver of an invoice unit. All invoices generated for that invoice unit will be sent to this account ID"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--description",
                    ],
                    description: Some("The invoice unit's description. This can be changed at a later time"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
