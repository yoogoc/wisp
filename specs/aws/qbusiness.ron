                        (
                            name: "list",
                        ),
                    ],
                ),
                (
                    names: [
                        "--client-token",
                    ],
                    description: Some("A unique, case-sensitive identifier you provide to ensure idempotency of the request"),
                    arguments: [
                        (
                            name: "string",
                        ),
