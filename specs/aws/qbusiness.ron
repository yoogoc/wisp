                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
                    names: [
                        "--personalization-configuration",
                    ],
                    description: Some("Configuration information about chat response personalization. For more information, see Personalizing chat responses"),
                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
