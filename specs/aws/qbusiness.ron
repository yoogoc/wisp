        (
            name: "chat-sync",
            description: Some("Starts or continues a non-streaming Amazon Q Business conversation"),
            options: [
                (
                    names: [
                        "--application-id",
                    ],
                    description: Some("The identifier of the Amazon Q Business application linked to the Amazon Q Business conversation"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--user-id",
                    ],
                    description: Some("The identifier of the user attached to the chat input"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--user-groups",
                    ],
                    description: Some("The group names that a user associated with the chat input belongs to"),
                    arguments: [
                        (
                            name: "list",
                        ),
                    ],
                ),
                (
                    names: [
                        "--user-message",
                    ],
                    description: Some("A end user message in a conversation"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--attachments",
                    ],
                    description: Some("A list of files uploaded directly during chat. You can upload a maximum of 5 files of upto 10 MB each"),
                    arguments: [
                        (
                            name: "list",
                        ),
                    ],
                ),
                (
                    names: [
                        "--action-execution",
                    ],
                    description: Some("A request from an end user to perform an Amazon Q Business plugin action"),
                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
                    names: [
                        "--auth-challenge-response",
                    ],
                    description: Some("An authentication verification event response by a third party authentication server to Amazon Q Business"),
                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
                    names: [
                        "--conversation-id",
                    ],
                    description: Some("The identifier of the Amazon Q Business conversation"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--parent-message-id",
                    ],
                    description: Some("The identifier of the previous system message in a conversation"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--attribute-filter",
                    ],
                    description: Some("Enables filtering of Amazon Q Business web experience responses based on document attributes or metadata fields"),
                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
                    names: [
                        "--chat-mode",
                    ],
                    description: Some("The chatMode parameter determines the chat modes available to Amazon Q Business users:    RETRIEVAL_MODE - If you choose this mode, Amazon Q generates responses solely from the data sources connected and indexed by the application. If an answer is not found in the data sources or there are no data sources available, Amazon Q will respond with a \"No Answer Found\" message, unless LLM knowledge has been enabled. In that case, Amazon Q will generate a response from the LLM knowledge    CREATOR_MODE - By selecting this mode, you can choose to generate responses only from the LLM knowledge. You can also attach files and have Amazon Q generate a response based on the data in those files. If the attached files do not contain an answer for the query, Amazon Q will automatically fall back to generating a response from the LLM knowledge.    PLUGIN_MODE - By selecting this mode, users can choose to use plugins in chat to get their responses.    If none of the modes are selected, Amazon Q will only respond using the information from the attached files.  For more information, see Admin controls and guardrails, Plugins, and Response sources"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--chat-mode-configuration",
                    ],
                    description: Some("The chat mode configuration for an Amazon Q Business application"),
                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
                    names: [
                        "--client-token",
                    ],
                    description: Some("A token that you provide to identify a chat request"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--cli-input-json",
                    ],
                    description: Some("Performs service operation based on the JSON string provided. The JSON string follows the format provided by ``--generate-cli-skeleton``. If other arguments are provided on the command line, the CLI values will override the JSON-provided values. It is not possible to pass arbitrary binary values using a JSON-provided value as the string will be taken literally"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--generate-cli-skeleton",
                    ],
                    description: Some("Prints a JSON skeleton to standard output without sending an API request. If provided with no value or the value ``input``, prints a sample input JSON that can be used as an argument for ``--cli-input-json``. If provided with the value ``output``, it validates the command inputs and returns a sample output JSON for that command"),
                    arguments: [
                        (
                            name: "string",
                            suggestions: [
                                (
                                    name: "input",
                                ),
                                (
                                    name: "output",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "create-application",
            description: Some("Creates an Amazon Q Business application.  There are new tiers for Amazon Q Business. Not all features in Amazon Q Business Pro are also available in Amazon Q Business Lite. For information on what's included in Amazon Q Business Lite and what's included in Amazon Q Business Pro, see Amazon Q Business tiers. You must use the Amazon Q Business console to assign subscription tiers to users.  An Amazon Q Apps service linked role will be created if it's absent in the Amazon Web Services account when QAppsConfiguration is enabled in the request. For more information, see  Using service-linked roles for Q Apps. When you create an application, Amazon Q Business may securely transmit data for processing from your selected Amazon Web Services region, but within your geography. For more information, see Cross region inference in Amazon Q Business"),
            options: [
                (
                    names: [
                        "--display-name",
                    ],
                    description: Some("A name for the Amazon Q Business application"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--role-arn",
                    ],
                    description: Some("The Amazon Resource Name (ARN) of an IAM role with permissions to access your Amazon CloudWatch logs and metrics. If this property is not specified, Amazon Q Business will create a service linked role (SLR) and use it as the application's role"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--identity-type",
                    ],
                    description: Some("The authentication type being used by a Amazon Q Business application"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--iam-identity-provider-arn",
                    ],
                    description: Some("The Amazon Resource Name (ARN) of an identity provider being used by an Amazon Q Business application"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--identity-center-instance-arn",
                    ],
                    description: Some("The Amazon Resource Name (ARN) of the IAM Identity Center instance you are either creating for—or connecting to—your Amazon Q Business application"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--client-ids-for-oidc",
                    ],
                    description: Some("The OIDC client ID for a Amazon Q Business application"),
                    arguments: [
                        (
                            name: "list",
                        ),
                    ],
                ),
                (
                    names: [
                        "--description",
                    ],
                    description: Some("A description for the Amazon Q Business application"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--encryption-configuration",
                    ],
                    description: Some("The identifier of the KMS key that is used to encrypt your data. Amazon Q Business doesn't support asymmetric keys"),
                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
                    names: [
                        "--tags",
                    ],
                    description: Some("A list of key-value pairs that identify or categorize your Amazon Q Business application. You can also use tags to help control access to the application. Tag keys and values can consist of Unicode letters, digits, white space, and any of the following symbols: _ . : / = + - @"),
                    arguments: [
                        (
                            name: "list",
                        ),
                    ],
                ),
                (
                    names: [
                        "--client-token",
                    ],
                    description: Some("A token that you provide to identify the request to create your Amazon Q Business application"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--attachments-configuration",
                    ],
                    description: Some("An option to allow end users to upload files directly during chat"),
                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
                    names: [
                        "--q-apps-configuration",
                    ],
