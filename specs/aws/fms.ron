            name: "delete-policy",
            aliases: [],
            description: Some("Permanently deletes an Firewall Manager policy"),
            subcommands: [],
            options: [
                (
                    names: [
                        "--policy-id",
                    ],
                    description: Some("The ID of the policy that you want to delete. You can retrieve this ID from PutPolicy and ListPolicies"),
                    takes_value: true,
                    arguments: [
