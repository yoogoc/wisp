(
    version: 1,
    command: "rolesanywhere",
    description: Some("Identity and Access Management Roles Anywhere provides a secure way for your workloads such as servers, containers, and applications that run outside of Amazon Web Services to obtain temporary Amazon Web Services credentials. Your workloads can use the same IAM policies and roles you have for native Amazon Web Services applications to access Amazon Web Services resources. Using IAM Roles Anywhere eliminates the need to manage long-term credentials for workloads running outside of Amazon Web Services.  To use IAM Roles Anywhere, your workloads must use X.509 certificates issued by their certificate authority (CA). You register the CA with IAM Roles Anywhere as a trust anchor to establish trust between your public key infrastructure (PKI) and IAM Roles Anywhere. If you don't manage your own PKI system, you can use Private Certificate Authority to create a CA and then use that to establish trust with IAM Roles Anywhere.  This guide describes the IAM Roles Anywhere operations that you can call programmatically. For more information about IAM Roles Anywhere, see the IAM Roles Anywhere User Guide"),
    subcommands: [
        (
            name: "create-profile",
            description: Some("Creates a profile, a list of the roles that Roles Anywhere service is trusted to assume. You use profiles to intersect permissions with IAM managed policies.  Required permissions:  rolesanywhere:CreateProfile"),
            options: [
                (
                    names: [
                        "--accept-role-session-name",
                    ],
                    description: Some("Used to determine if a custom role session name will be accepted in a temporary credential request"),
                ),
                (
                    names: [
                        "--no-accept-role-session-name",
                    ],
                    description: Some("Used to determine if a custom role session name will be accepted in a temporary credential request"),
                ),
                (
                    names: [
                        "--duration-seconds",
                    ],
                    description: Some("Used to determine how long sessions vended using this profile are valid for. See the Expiration section of the CreateSession API documentation page for more details. In requests, if this value is not provided, the default value will be 3600"),
                    arguments: [
                        (
                            name: "integer",
                        ),
                    ],
                ),
                (
                    names: [
                        "--enabled",
                    ],
                    description: Some("Specifies whether the profile is enabled"),
                ),
                (
                    names: [
                        "--no-enabled",
                    ],
                    description: Some("Specifies whether the profile is enabled"),
                ),
                (
                    names: [
                        "--managed-policy-arns",
                    ],
                    description: Some("A list of managed policy ARNs that apply to the vended session credentials"),
                    arguments: [
                        (
                            name: "list",
                        ),
                    ],
                ),
                (
                    names: [
                        "--name",
                    ],
                    description: Some("The name of the profile"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--require-instance-properties",
                    ],
                    description: Some("Specifies whether instance properties are required in temporary credential requests with this profile"),
                ),
                (
                    names: [
                        "--no-require-instance-properties",
                    ],
                    description: Some("Specifies whether instance properties are required in temporary credential requests with this profile"),
                ),
                (
                    names: [
                        "--role-arns",
                    ],
                    description: Some("A list of IAM roles that this profile can assume in a temporary credential request"),
                    arguments: [
                        (
                            name: "list",
                        ),
                    ],
                ),
                (
                    names: [
                        "--session-policy",
                    ],
                    description: Some("A session policy that applies to the trust boundary of the vended session credentials"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--tags",
                    ],
                    description: Some("The tags to attach to the profile"),
                    arguments: [
                        (
                            name: "list",
                        ),
                    ],
                ),
                (
                    names: [
                        "--cli-input-json",
                    ],
                    description: Some("Performs service operation based on the JSON string provided. The JSON string follows the format provided by ``--generate-cli-skeleton``. If other arguments are provided on the command line, the CLI values will override the JSON-provided values. It is not possible to pass arbitrary binary values using a JSON-provided value as the string will be taken literally"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--generate-cli-skeleton",
                    ],
                    description: Some("Prints a JSON skeleton to standard output without sending an API request. If provided with no value or the value ``input``, prints a sample input JSON that can be used as an argument for ``--cli-input-json``. If provided with the value ``output``, it validates the command inputs and returns a sample output JSON for that command"),
                    arguments: [
                        (
                            name: "string",
                            suggestions: [
                                (
                                    name: "input",
                                ),
                                (
                                    name: "output",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "create-trust-anchor",
            description: Some("Creates a trust anchor to establish trust between IAM Roles Anywhere and your certificate authority (CA). You can define a trust anchor as a reference to an Private Certificate Authority (Private CA) or by uploading a CA certificate. Your Amazon Web Services workloads can authenticate with the trust anchor using certificates issued by the CA in exchange for temporary Amazon Web Services credentials.  Required permissions:  rolesanywhere:CreateTrustAnchor"),
            options: [
                (
                    names: [
                        "--enabled",
                    ],
                    description: Some("Specifies whether the trust anchor is enabled"),
                ),
                (
                    names: [
                        "--no-enabled",
                    ],
                    description: Some("Specifies whether the trust anchor is enabled"),
                ),
                (
                    names: [
                        "--name",
                    ],
                    description: Some("The name of the trust anchor"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--notification-settings",
                    ],
                    description: Some("A list of notification settings to be associated to the trust anchor"),
                    arguments: [
                        (
                            name: "list",
                        ),
                    ],
                ),
                (
                    names: [
                        "--source",
                    ],
                    description: Some("The trust anchor type and its related certificate data"),
                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
                    names: [
                        "--tags",
                    ],
                    description: Some("The tags to attach to the trust anchor"),
                    arguments: [
                        (
                            name: "list",
                        ),
                    ],
                ),
                (
                    names: [
                        "--cli-input-json",
                    ],
                    description: Some("Performs service operation based on the JSON string provided. The JSON string follows the format provided by ``--generate-cli-skeleton``. If other arguments are provided on the command line, the CLI values will override the JSON-provided values. It is not possible to pass arbitrary binary values using a JSON-provided value as the string will be taken literally"),
                    arguments: [
