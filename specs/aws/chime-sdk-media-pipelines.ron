(
    version: 1,
    command: "chime-sdk-media-pipelines",
    description: Some("The Amazon Chime SDK media pipeline APIs in this section allow software developers to create Amazon Chime SDK media pipelines that capture, concatenate, or stream your Amazon Chime SDK meetings. For more information about media pipelines, see Amazon Chime SDK media pipelines"),
    subcommands: [
        (
            name: "create-media-capture-pipeline",
            description: Some("Creates a media pipeline"),
            options: [
                (
                    names: [
                        "--source-type",
                    ],
                    description: Some("Source type from which the media artifacts are captured. A Chime SDK Meeting is the only supported source"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--source-arn",
                    ],
                    description: Some("ARN of the source from which the media artifacts are captured"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--sink-type",
                    ],
                    description: Some("Destination type to which the media artifacts are saved. You must use an S3 bucket"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--sink-arn",
                    ],
                    description: Some("The ARN of the sink type"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--client-request-token",
                    ],
                    description: Some("The unique identifier for the client request. The token makes the API request idempotent. Use a unique token for each media pipeline request"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--chime-sdk-meeting-configuration",
                    ],
                    description: Some("The configuration for a specified media pipeline. SourceType must be ChimeSdkMeeting"),
                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
                    names: [
                        "--sse-aws-key-management-params",
                    ],
                    description: Some("An object that contains server side encryption parameters to be used by media capture pipeline. The parameters can also be used by media concatenation pipeline taking media capture pipeline as a media source"),
                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
                    names: [
                        "--sink-iam-role-arn",
                    ],
                    description: Some("The Amazon Resource Name (ARN) of the sink role to be used with AwsKmsKeyId in SseAwsKeyManagementParams. Can only interact with S3Bucket sink type. The role must belong to the caller’s account and be able to act on behalf of the caller during the API call. All minimum policy permissions requirements for the caller to perform sink-related actions are the same for SinkIamRoleArn. Additionally, the role must have permission to kms:GenerateDataKey using KMS key supplied as AwsKmsKeyId in SseAwsKeyManagementParams. If media concatenation will be required later, the role must also have permission to kms:Decrypt for the same KMS key"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--tags",
