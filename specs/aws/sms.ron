(
    version: 1,
    command: "sms",
    description: Some("Product update  We recommend Amazon Web Services Application Migration Service (Amazon Web Services MGN) as the primary migration service for lift-and-shift migrations. If Amazon Web Services MGN is unavailable in a specific Amazon Web Services Region, you can use the Server Migration Service APIs through March 2023.  Server Migration Service (Server Migration Service) makes it easier and faster for you to migrate your on-premises workloads to Amazon Web Services. To learn more about Server Migration Service, see the following resources:    Server Migration Service product page     Server Migration Service User Guide"),
    subcommands: [
        (
            name: "create-app",
            description: Some("Creates an application. An application consists of one or more server groups. Each server group contain one or more servers"),
            options: [
                (
                    names: [
                        "--name",
                    ],
                    description: Some("The name of the new application"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--description",
                    ],
                    description: Some("The description of the new application"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--role-name",
                    ],
                    description: Some("The name of the service role in the customer's account to be used by Server Migration Service"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--client-token",
                    ],
                    description: Some("A unique, case-sensitive identifier that you provide to ensure the idempotency of application creation"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--server-groups",
                    ],
                    description: Some("The server groups to include in the application"),
                    arguments: [
                        (
                            name: "list",
                        ),
                    ],
                ),
                (
                    names: [
                        "--tags",
                    ],
                    description: Some("The tags to be associated with the application"),
                    arguments: [
                        (
                            name: "list",
                        ),
                    ],
                ),
                (
                    names: [
                        "--cli-input-json",
                    ],
                    description: Some("Performs service operation based on the JSON string provided. The JSON string follows the format provided by ``--generate-cli-skeleton``. If other arguments are provided on the command line, the CLI values will override the JSON-provided values. It is not possible to pass arbitrary binary values using a JSON-provided value as the string will be taken literally"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--generate-cli-skeleton",
                    ],
                    description: Some("Prints a JSON skeleton to standard output without sending an API request. If provided with no value or the value ``input``, prints a sample input JSON that can be used as an argument for ``--cli-input-json``. If provided with the value ``output``, it validates the command inputs and returns a sample output JSON for that command"),
                    arguments: [
                        (
                            name: "string",
                            suggestions: [
                                (
                                    name: "input",
                                ),
                                (
                                    name: "output",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "create-replication-job",
            description: Some("Creates a replication job. The replication job schedules periodic replication runs to replicate your server to Amazon Web Services. Each replication run creates an Amazon Machine Image (AMI)"),
            options: [
                (
                    names: [
                        "--server-id",
                    ],
                    description: Some("The ID of the server"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--seed-replication-time",
                    ],
                    description: Some("The seed replication time"),
                    arguments: [
                        (
                            name: "timestamp",
                        ),
                    ],
                ),
                (
                    names: [
                        "--frequency",
                    ],
                    description: Some("The time between consecutive replication runs, in hours"),
                    arguments: [
                        (
                            name: "integer",
                        ),
                    ],
                ),
                (
                    names: [
                        "--run-once",
                    ],
                    description: Some("Indicates whether to run the replication job one time"),
                ),
                (
                    names: [
                        "--no-run-once",
                    ],
                    description: Some("Indicates whether to run the replication job one time"),
                ),
                (
                    names: [
                        "--license-type",
                    ],
                    description: Some("The license type to be used for the AMI created by a successful replication run"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--role-name",
                    ],
                    description: Some("The name of the IAM role to be used by the Server Migration Service"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--description",
                    ],
                    description: Some("The description of the replication job"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--number-of-recent-amis-to-keep",
                    ],
                    description: Some("The maximum number of SMS-created AMIs to retain. The oldest is deleted after the maximum number is reached and a new AMI is created"),
                    arguments: [
                        (
                            name: "integer",
                        ),
                    ],
                ),
                (
                    names: [
                        "--encrypted",
                    ],
                    description: Some("Indicates whether the replication job produces encrypted AMIs"),
                ),
                (
                    names: [
                        "--no-encrypted",
                    ],
                    description: Some("Indicates whether the replication job produces encrypted AMIs"),
                ),
                (
                    names: [
                        "--kms-key-id",
                    ],
                    description: Some("The ID of the KMS key for replication jobs that produce encrypted AMIs. This value can be any of the following:   KMS key ID   KMS key alias   ARN referring to the KMS key ID   ARN referring to the KMS key alias    If encrypted is true but a KMS key ID is not specified, the customer's default KMS key for Amazon EBS is used"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
