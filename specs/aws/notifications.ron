                (
                    names: [
                        "--notification-configuration-arn",
                    ],
                    description: Some("The Amazon Resource Name (ARN) of the NotificationConfiguration associated with this EventRule"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--source",
                    ],
                    description: Some("The matched event source. Must match one of the valid EventBridge sources. Only AWS service sourced events are supported. For example, aws.ec2 and aws.cloudwatch. For more information, see Event delivery from AWS services in the Amazon EventBridge User Guide"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
