        (
            name: "create-application",
            description: Some("Creates an application that has one configuration template named default and no application versions"),
            options: [
                (
                    names: [
                        "--application-name",
                    ],
                    description: Some("The name of the application. Must be unique within your account"),
                    arguments: [
                        (
                            name: "string",
