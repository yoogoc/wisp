                    ],
                ),
            ],
        ),
        (
            name: "create-configuration-template",
            description: Some("Creates an AWS Elastic Beanstalk configuration template, associated with a specific Elastic Beanstalk application. You define application configuration settings in a configuration template. You can then use the configuration template to deploy different versions of the application with the same configuration settings. Templates aren't associated with any environment. The EnvironmentName response element is always null. Related Topics    DescribeConfigurationOptions     DescribeConfigurationSettings     ListAvailableSolutionStacks"),
            options: [
                (
                    names: [
                        "--application-name",
                    ],
                    description: Some("The name of the Elastic Beanstalk application to associate with this configuration template"),
                    arguments: [
                        (
                            name: "string",
                            generators: [
                                (
                                    script: [
                                        "aws",
                                        "elasticbeanstalk",
                                        "describe-applications",
                                    ],
                                    has_post_process: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--template-name",
                    ],
                    description: Some("The name of the configuration template. Constraint: This name must be unique per application"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--solution-stack-name",
                    ],
                    description: Some("The name of an Elastic Beanstalk solution stack (platform version) that this configuration uses. For example, 64bit Amazon Linux 2013.09 running Tomcat 7 Java 7. A solution stack specifies the operating system, runtime, and application server for a configuration template. It also determines the set of configuration options as well as the possible and default values. For more information, see Supported Platforms in the AWS Elastic Beanstalk Developer Guide. You must specify SolutionStackName if you don't specify PlatformArn, EnvironmentId, or SourceConfiguration. Use the  ListAvailableSolutionStacks  API to obtain a list of available solution stacks"),
                    arguments: [
                        (
                            name: "string",
                            generators: [
                                (
                                    script: [
                                        "aws",
                                        "elasticbeanstalk",
                                        "list-available-solution-stacks",
                                    ],
                                    has_post_process: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--platform-arn",
                    ],
                    description: Some("The Amazon Resource Name (ARN) of the custom platform. For more information, see  Custom Platforms in the AWS Elastic Beanstalk Developer Guide.  If you specify PlatformArn, then don't specify SolutionStackName"),
                    arguments: [
                        (
                            name: "string",
                            generators: [
                                (
                                    script: [
                                        "aws",
                                        "elasticbeanstalk",
                                        "list-platform-versions",
                                    ],
                                    has_post_process: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--source-configuration",
                    ],
                    description: Some("An Elastic Beanstalk configuration template to base this one on. If specified, Elastic Beanstalk uses the configuration values from the specified configuration template to create a new configuration. Values specified in OptionSettings override any values obtained from the SourceConfiguration. You must specify SourceConfiguration if you don't specify PlatformArn, EnvironmentId, or SolutionStackName. Constraint: If both solution stack name and source configuration are specified, the solution stack of the source configuration template must match the specified solution stack name"),
                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
                    names: [
                        "--environment-id",
                    ],
                    description: Some("The ID of an environment whose settings you want to use to create the configuration template. You must specify EnvironmentId if you don't specify PlatformArn, SolutionStackName, or SourceConfiguration"),
                    arguments: [
                        (
                            name: "string",
                            generators: [
                                (
                                    script: [
                                        "aws",
                                        "elasticbeanstalk",
                                        "describe-environments",
                                    ],
                                    has_post_process: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--description",
                    ],
                    description: Some("An optional description for this configuration"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--option-settings",
                    ],
                    description: Some("Option values for the Elastic Beanstalk configuration, such as the instance type. If specified, these values override the values obtained from the solution stack or the source configuration template. For a complete list of Elastic Beanstalk configuration options, see Option Values in the AWS Elastic Beanstalk Developer Guide"),
                    arguments: [
                        (
                            name: "list",
                            variadic: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--tags",
                    ],
                    description: Some("Specifies the tags applied to the configuration template"),
                    arguments: [
                        (
                            name: "list",
                            variadic: true,
                        ),
                    ],
                ),
                (
                    names: [
