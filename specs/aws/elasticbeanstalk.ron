                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--resource-lifecycle-config",
                    ],
                    description: Some("Specifies an application resource lifecycle configuration to prevent your application from accumulating too many versions"),
                    arguments: [
