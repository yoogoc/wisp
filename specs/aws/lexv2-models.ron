                        ),
                    ],
                ),
                (
                    names: [
                        "--sample-utterances",
                    ],
                    description: Some("An array of strings that a user might say to signal the intent. For example, \"I want a pizza\", or \"I want a {PizzaSize} pizza\".  In an utterance, slot names are enclosed in curly braces (\"{\", \"}\") to indicate where they should be displayed in the utterance shown to the user"),
                    arguments: [
