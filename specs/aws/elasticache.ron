        (
            name: "modify-cache-cluster",
            description: Some("Modifies the settings for a cluster. You can use this operation to change one or more cluster configuration parameters by specifying the parameters and the new values"),
            options: [
                (
                    names: [
                        "--cache-cluster-id",
                    ],
                    description: Some("The cluster identifier. This value is stored as a lowercase string"),
                    arguments: [
