        (
            name: "associate-phone-numbers-with-voice-connector",
            description: Some("Associates phone numbers with the specified Amazon Chime SDK Voice Connector"),
            options: [
                (
                    names: [
                        "--voice-connector-id",
                    ],
                    description: Some("The Voice Connector ID"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--e164-phone-numbers",
                    ],
                    description: Some("List of phone numbers, in E.164 format"),
                    arguments: [
                        (
                            name: "list",
                        ),
                    ],
                ),
                (
                    names: [
                        "--force-associate",
                    ],
                    description: Some("If true, associates the provided phone numbers with the provided Amazon Chime SDK Voice Connector and removes any previously existing associations. If false, does not associate any phone numbers that have previously existing associations"),
                ),
                (
                    names: [
                        "--no-force-associate",
                    ],
                    description: Some("If true, associates the provided phone numbers with the provided Amazon Chime SDK Voice Connector and removes any previously existing associations. If false, does not associate any phone numbers that have previously existing associations"),
                ),
                (
                    names: [
                        "--cli-input-json",
                    ],
                    description: Some("Performs service operation based on the JSON string provided. The JSON string follows the format provided by ``--generate-cli-skeleton``. If other arguments are provided on the command line, the CLI values will override the JSON-provided values. It is not possible to pass arbitrary binary values using a JSON-provided value as the string will be taken literally"),
