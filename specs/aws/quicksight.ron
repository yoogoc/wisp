(
    version: 1,
    command: "quicksight",
    description: Some("Amazon QuickSight API Reference Amazon QuickSight is a fully managed, serverless business intelligence service for the Amazon Web Services Cloud that makes it easy to extend data and insights to every user in your organization. This API reference contains documentation for a programming interface that you can use to manage Amazon QuickSight"),
    subcommands: [
        (
            name: "batch-create-topic-reviewed-answer",
            description: Some("Creates new reviewed answers for a Q Topic"),
            options: [
                (
                    names: [
                        "--aws-account-id",
                    ],
                    description: Some("The ID of the Amazon Web Services account that you want to create a reviewed answer in"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--topic-id",
                    ],
                    description: Some("The ID for the topic reviewed answer that you want to create. This ID is unique per Amazon Web Services Region for each Amazon Web Services account"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--answers",
                    ],
                    description: Some("The definition of the Answers to be created"),
                    arguments: [
                        (
                            name: "list",
                        ),
                    ],
                ),
                (
                    names: [
                        "--cli-input-json",
                    ],
                    description: Some("Performs service operation based on the JSON string provided. The JSON string follows the format provided by ``--generate-cli-skeleton``. If other arguments are provided on the command line, the CLI values will override the JSON-provided values. It is not possible to pass arbitrary binary values using a JSON-provided value as the string will be taken literally"),
