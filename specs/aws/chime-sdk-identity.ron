(
    version: 1,
    command: "chime-sdk-identity",
    description: Some("The Amazon Chime SDK Identity APIs in this section allow software developers to create and manage unique instances of their messaging applications. These APIs provide the overarching framework for creating and sending messages. For more information about the identity APIs, refer to Amazon Chime SDK identity"),
    subcommands: [
        (
            name: "create-app-instance",
