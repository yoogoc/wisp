(
    version: 1,
    command: "marketplace-deployment",
    description: Some("The AWS Marketplace Deployment Service supports the Quick Launch experience, which is a deployment option for software as a service (SaaS) products. Quick Launch simplifies and reduces the time, resources, and steps required to configure, deploy, and launch a products. The AWS Marketplace Deployment Service provides sellers with a secure method for passing deployment parameters (for example, API keys and external IDs) to buyers during the Quick Launch experience"),
    subcommands: [
        (
            name: "list-tags-for-resource",
            description: Some("Lists all tags that have been added to a deployment parameter resource"),
            options: [
                (
                    names: [
                        "--resource-arn",
                    ],
                    description: Some("The Amazon Resource Name (ARN) associated with the deployment parameter resource you want to list tags on"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--cli-input-json",
                    ],
                    description: Some("Performs service operation based on the JSON string provided. The JSON string follows the format provided by ``--generate-cli-skeleton``. If other arguments are provided on the command line, the CLI values will override the JSON-provided values. It is not possible to pass arbitrary binary values using a JSON-provided value as the string will be taken literally"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--generate-cli-skeleton",
                    ],
                    description: Some("Prints a JSON skeleton to standard output without sending an API request. If provided with no value or the value ``input``, prints a sample input JSON that can be used as an argument for ``--cli-input-json``. If provided with the value ``output``, it validates the command inputs and returns a sample output JSON for that command"),
                    arguments: [
                        (
                            name: "string",
                            suggestions: [
                                (
                                    name: "input",
                                ),
                                (
                                    name: "output",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "put-deployment-parameter",
            description: Some("Creates or updates a deployment parameter and is targeted by catalog and agreementId"),
            options: [
                (
                    names: [
                        "--agreement-id",
                    ],
                    description: Some("The unique identifier of the agreement"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--catalog",
                    ],
                    description: Some("The catalog related to the request. Fixed value: AWS Marketplace"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--client-token",
                    ],
                    description: Some("The idempotency token for deployment parameters. A unique identifier for the new version"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--deployment-parameter",
                    ],
                    description: Some("The deployment parameter targeted to the acceptor of an agreement for which to create the AWS Secret Manager resource"),
                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
                    names: [
                        "--expiration-date",
                    ],
                    description: Some("The date when deployment parameters expire and are scheduled for deletion"),
                    arguments: [
                        (
                            name: "timestamp",
                        ),
                    ],
                ),
                (
                    names: [
                        "--product-id",
                    ],
                    description: Some("The product for which AWS Marketplace will save secrets for the buyer’s account"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--tags",
                    ],
                    description: Some("A map of key-value pairs, where each pair represents a tag saved to the resource. Tags will only be applied for create operations, and they'll be ignored if the resource already exists"),
                    arguments: [
                        (
                            name: "map",
                        ),
