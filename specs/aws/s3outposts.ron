(
    version: 1,
    command: "s3outposts",
    description: Some("Amazon S3 on Outposts provides access to S3 on Outposts operations"),
    subcommands: [
        (
            name: "create-endpoint",
            description: Some("Creates an endpoint and associates it with the specified Outpost.  It can take up to 5 minutes for this action to finish.   Related actions include:    DeleteEndpoint     ListEndpoints"),
            options: [
                (
                    names: [
                        "--outpost-id",
                    ],
                    description: Some("The ID of the Outposts"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--subnet-id",
                    ],
                    description: Some("The ID of the subnet in the selected VPC. The endpoint subnet must belong to the Outpost that has Amazon S3 on Outposts provisioned"),
