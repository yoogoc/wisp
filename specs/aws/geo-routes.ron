(
    version: 1,
    command: "geo-routes",
    description: Some("With the Amazon Location Routes API you can calculate routes and estimate travel time based on up-to-date road network and live traffic information. Calculate optimal travel routes and estimate travel times using up-to-date road network and traffic data. Key features include:   Point-to-point routing with estimated travel time, distance, and turn-by-turn directions   Multi-point route optimization to minimize travel time or distance   Route matrices for efficient multi-destination planning   Isoline calculations to determine reachable areas within specified time or distance thresholds   Map-matching to align GPS traces with the road network"),
    subcommands: [
        (
            name: "calculate-isolines",
            description: Some("Use the CalculateIsolines action to find service areas that can be reached in a given threshold of time, distance"),
            options: [
                (
                    names: [
                        "--allow",
                    ],
                    description: Some("Features that are allowed while calculating. a route"),
                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
                    names: [
                        "--arrival-time",
                    ],
                    description: Some("Time of arrival at the destination. Time format: YYYY-MM-DDThh:mm:ss.sssZ | YYYY-MM-DDThh:mm:ss.sss+hh:mm  Examples:  2020-04-22T17:57:24Z   2020-04-22T17:57:24+02:00"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--avoid",
                    ],
                    description: Some("Features that are avoided while calculating a route. Avoidance is on a best-case basis. If an avoidance can't be satisfied for a particular case, it violates the avoidance and the returned response produces a notice for the violation"),
                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
                    names: [
                        "--depart-now",
                    ],
                    description: Some("Uses the current time as the time of departure"),
                ),
                (
                    names: [
                        "--no-depart-now",
                    ],
                    description: Some("Uses the current time as the time of departure"),
                ),
                (
                    names: [
                        "--departure-time",
                    ],
                    description: Some("Time of departure from thr origin. Time format:YYYY-MM-DDThh:mm:ss.sssZ | YYYY-MM-DDThh:mm:ss.sss+hh:mm  Examples:  2020-04-22T17:57:24Z   2020-04-22T17:57:24+02:00"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--destination",
                    ],
                    description: Some("The final position for the route. In the World Geodetic System (WGS 84) format: [longitude, latitude]"),
                    arguments: [
                        (
                            name: "list",
                        ),
                    ],
                ),
                (
                    names: [
                        "--destination-options",
                    ],
                    description: Some("Destination related options"),
                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
                    names: [
                        "--isoline-geometry-format",
                    ],
                    description: Some("The format of the returned IsolineGeometry.  Default Value:FlexiblePolyline"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--isoline-granularity",
                    ],
                    description: Some("Defines the granularity of the returned Isoline"),
                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
                    names: [
                        "--key",
                    ],
                    description: Some("Optional: The API key to be used for authorization. Either an API key or valid SigV4 signature must be provided when making a request"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--optimize-isoline-for",
                    ],
                    description: Some("Specifies the optimization criteria for when calculating an isoline. AccurateCalculation generates an isoline of higher granularity that is more precise. FastCalculation generates an isoline faster by reducing the granularity, and in turn the quality of the isoline. BalancedCalculation generates an isoline by balancing between quality and performance.  Default Value: BalancedCalculation"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--optimize-routing-for",
                    ],
                    description: Some("Specifies the optimization criteria for calculating a route. Default Value: FastestRoute"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--origin",
                    ],
                    description: Some("The start position for the route"),
                    arguments: [
                        (
                            name: "list",
                        ),
                    ],
                ),
                (
                    names: [
                        "--origin-options",
                    ],
                    description: Some("Origin related options"),
                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
                    names: [
                        "--thresholds",
                    ],
                    description: Some("Threshold to be used for the isoline calculation. Up to 3 thresholds per provided type can be requested"),
                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
                    names: [
                        "--traffic",
                    ],
                    description: Some("Traffic related options"),
                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
                    names: [
                        "--travel-mode",
                    ],
                    description: Some("Specifies the mode of transport when calculating a route. Used in estimating the speed of travel and road compatibility.   The mode Scooter also applies to motorcycles, set to Scooter when wanted to calculate options for motorcycles.  Default Value: Car"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--travel-mode-options",
                    ],
                    description: Some("Travel mode related options for the provided travel mode"),
                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
                    names: [
                        "--cli-input-json",
                    ],
                    description: Some("Performs service operation based on the JSON string provided. The JSON string follows the format provided by ``--generate-cli-skeleton``. If other arguments are provided on the command line, the CLI values will override the JSON-provided values. It is not possible to pass arbitrary binary values using a JSON-provided value as the string will be taken literally"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--generate-cli-skeleton",
                    ],
                    description: Some("Prints a JSON skeleton to standard output without sending an API request. If provided with no value or the value ``input``, prints a sample input JSON that can be used as an argument for ``--cli-input-json``. If provided with the value ``output``, it validates the command inputs and returns a sample output JSON for that command"),
                    arguments: [
                        (
                            name: "string",
                            suggestions: [
                                (
                                    name: "input",
                                ),
                                (
                                    name: "output",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
