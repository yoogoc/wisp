                            name: "integer",
                        ),
                    ],
                ),
                (
                    names: [
                        "--default-encryption-key",
                    ],
                    description: Some("The default encryption key, which is an AWS managed key, is used when no specific type of encryption key is specified. It is used to encrypt all data before it is placed in permanent or semi-permanent storage"),
                    arguments: [
                        (
                            name: "string",
                        ),
