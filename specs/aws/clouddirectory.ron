(
    version: 1,
    command: "clouddirectory",
    description: Some("Amazon Cloud Directory Amazon Cloud Directory is a component of the AWS Directory Service that simplifies the development and management of cloud-scale web, mobile, and IoT applications. This guide describes the Cloud Directory operations that you can call programmatically and includes detailed information on data types and errors. For information about Cloud Directory features, see AWS Directory Service and the Amazon Cloud Directory Developer Guide"),
    subcommands: [
        (
            name: "add-facet-to-object",
            description: Some("Adds a new Facet to an object. An object can have more than one facet applied on it"),
            options: [
                (
                    names: [
                        "--directory-arn",
                    ],
                    description: Some("The Amazon Resource Name (ARN) that is associated with the Directory where the object resides. For more information, see arns"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--schema-facet",
                    ],
                    description: Some("Identifiers for the facet that you are adding to the object. See SchemaFacet for details"),
                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
                    names: [
                        "--object-attribute-list",
                    ],
                    description: Some("Attributes on the facet that you are adding to the object"),
                    arguments: [
                        (
                            name: "list",
                        ),
                    ],
                ),
                (
                    names: [
                        "--object-reference",
                    ],
                    description: Some("A reference to the object you are adding the specified facet to"),
                    arguments: [
                        (
                            name: "structure",
                        ),
                    ],
                ),
                (
                    names: [
                        "--cli-input-json",
                    ],
                    description: Some("Performs service operation based on the JSON string provided. The JSON string follows the format provided by ``--generate-cli-skeleton``. If other arguments are provided on the command line, the CLI values will override the JSON-provided values. It is not possible to pass arbitrary binary values using a JSON-provided value as the string will be taken literally"),
