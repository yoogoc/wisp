(
    version: 1,
    command: "route53-recovery-control-config",
    description: Some("Recovery Control Configuration API Reference for Amazon Route 53 Application Recovery Controller"),
    subcommands: [
        (
            name: "create-cluster",
            description: Some("Create a new cluster. A cluster is a set of redundant Regional endpoints against which you can run API calls to update or get the state of one or more routing controls. Each cluster has a name, status, Amazon Resource Name (ARN), and an array of the five cluster endpoints (one for each supported Amazon Web Services Region) that you can use with API calls to the cluster data plane"),
            options: [
                (
                    names: [
                        "--client-token",
                    ],
                    description: Some("A unique, case-sensitive string of up to 64 ASCII characters. To make an idempotent API request with an action, specify a client token in the request"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--cluster-name",
                    ],
                    description: Some("The name of the cluster"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--tags",
                    ],
                    description: Some("The tags associated with the cluster"),
                    arguments: [
                        (
                            name: "map",
                        ),
                    ],
