                        ),
                    ],
                ),
                (
                    names: [
                        "--instance-ids",
                    ],
                    description: Some("(Optional) A list of managed node IDs on which you want to cancel the command. If not provided, the command is canceled on every node on which it was requested"),
                    arguments: [
                        (
                            name: "list",
