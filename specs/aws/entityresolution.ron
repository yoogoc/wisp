                            name: "list",
                        ),
                    ],
                ),
                (
                    names: [
                        "--arn",
                    ],
                    description: Some("The Amazon Resource Name (ARN) of the resource that will be accessed by the principal"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--condition",
                    ],
                    description: Some("A set of condition keys that you can use in key policies"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--effect",
                    ],
                    description: Some("Determines whether the permissions specified in the policy are to be allowed (Allow) or denied (Deny).   If you set the value of the effect parameter to Deny for the AddPolicyStatement operation, you must also set the value of the effect parameter in the policy to Deny for the PutPolicy operation"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--principal",
                    ],
                    description: Some("The Amazon Web Services service or Amazon Web Services account that can access the resource defined as ARN"),
                    arguments: [
                        (
                            name: "list",
                        ),
                    ],
                ),
                (
                    names: [
                        "--statement-id",
                    ],
                    description: Some("A statement identifier that differentiates the statement from others in the same policy"),
                    arguments: [
                        (
                            name: "string",
                        ),
                    ],
                ),
                (
                    names: [
                        "--cli-input-json",
                    ],
                    description: Some("Performs service operation based on the JSON string provided. The JSON string follows the format provided by ``--generate-cli-skeleton``. If other arguments are provided on the command line, the CLI values will override the JSON-provided values. It is not possible to pass arbitrary binary values using a JSON-provided value as the string will be taken literally"),
