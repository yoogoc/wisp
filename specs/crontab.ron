(
    version: 1,
    command: "crontab",
    description: Some("Maintain crontab file for individual users"),
    options: [
        (
            names: [
                "-e",
            ],
            description: Some("Edit the current crontab"),
        ),
        (
            names: [
                "-l",
            ],
            description: Some("Display the current crontab"),
        ),
        (
            names: [
                "-r",
            ],
            description: Some("Remove the current crontab"),
            presentation: (
                dangerous: true,
            ),
        ),
        (
            names: [
                "-u",
            ],
            description: Some("Specify the name of the user whose crontab is to be tweaked"),
        ),
    ],
)
