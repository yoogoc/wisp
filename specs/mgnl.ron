(
    version: 1,
    command: "mgnl",
    description: Some("Magnolia CLI is a command line interface (CLI) tool to set up and facilitate light development with Magnolia"),
    subcommands: [
        (
            name: "add-availability",
            description: Some("This command makes a component available to a page"),
            options: [
                (
                    names: [
                        "-p",
                        "--path",
                    ],
                    description: Some("The path to the light module that contains the page template"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-g",
                    ],
                    description: Some("Add this parameter to autogenerate the component instead of providing plain availability"),
                ),
            ],
            arguments: [
                (
                    name: "<[module-id:]path-to-component>",
                    description: Some("The component you want to make available"),
                ),
                (
                    name: "<path-to-page[@area]>",
                    description: Some("The page you want to make the component available to"),
                ),
            ],
        ),
        (
            name: "create-app",
            description: Some("This command creates a content type and an app"),
            options: [
                (
                    names: [
                        "-p",
                        "--path",
                    ],
                    description: Some("The path to the light module where you want to create the app"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-P",
                        "--prototype",
                    ],
                    description: Some("The name of the prototype variant to create the app"),
                    arguments: [
                        (
                            name: "prototype",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "name",
                    description: Some("The name of the new app. The name cannot contain spaces"),
                ),
            ],
        ),
        (
            name: "create-block",
            description: Some("This command creates a block"),
            options: [
                (
                    names: [
                        "-p",
                        "--path",
                    ],
                    description: Some("The path to the light module to add the new block to"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-P",
                        "--prototype",
                    ],
                    description: Some("The name of the prototype variant to create the block"),
                    arguments: [
                        (
                            name: "prototype",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "blockName",
                    description: Some("The name of the new block definition. The block name cannot contain spaces"),
                ),
            ],
        ),
        (
            name: "create-component",
            description: Some("This command creates a new component template"),
            options: [
                (
                    names: [
                        "-p",
                        "--path",
                    ],
                    description: Some("The path to the light module you want to add the component template to"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-a",
                        "--available",
                    ],
                    description: Some("The page you want to make the component available to"),
                    arguments: [
                        (
                            name: "<path-to-page[@area]>",
                        ),
                    ],
                ),
                (
                    names: [
                        "-g",
                        "--autogenerate",
                    ],
                    description: Some("Add this parameter to autogenerate the component instead of providing plain availability"),
                    arguments: [
                        (
                            name: "<path-to-page[@area]>",
                        ),
                    ],
                ),
                (
                    names: [
                        "-P",
                        "--prototype",
                    ],
                    description: Some("The name of the prototype variant to create the component"),
                    arguments: [
                        (
                            name: "prototype",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "name",
                    description: Some("The name of the new component template. The name cannot contain spaces"),
                ),
            ],
        ),
        (
            name: "create-content-type",
            description: Some("This command creates a content type"),
            options: [
                (
                    names: [
                        "-a",
                    ],
                    description: Some("Creates also a new app that references the content type. With the -a option, the command is functionally equivalent to the create-app command"),
                ),
                (
                    names: [
                        "-p",
                        "--path",
                    ],
                    description: Some("The path to the light module where you want to create the content type"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-P",
                        "--prototype",
                    ],
                    description: Some("The name of the prototype variant to create the content type"),
                    arguments: [
                        (
                            name: "prototype",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "name",
                    description: Some("The name of the new content type. The name cannot contain spaces"),
                ),
            ],
        ),
        (
            name: "create-light-module",
            description: Some("This command creates a new light module in the form of a set of empty light module folders"),
            options: [
                (
                    names: [
                        "-p",
                        "--path",
                    ],
                    description: Some("The path of the parent directory for the new light module"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-P",
                        "--prototype",
                    ],
                    description: Some("The name of the prototype variant to create the light module"),
                    arguments: [
                        (
                            name: "prototype",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "moduleName",
                    description: Some("The name of the new light module. Avoid spaces and special characters since this name is used as folder name"),
                ),
            ],
        ),
        (
            name: "create-page",
            description: Some("This command creates a new page template"),
            options: [
                (
                    names: [
                        "-p",
                        "--path",
                    ],
                    description: Some("The path to the light module to add the new template to"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-P",
                        "--prototype",
                    ],
                    description: Some("The name of the prototype variant to create the page"),
                    arguments: [
                        (
                            name: "prototype",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "templateName",
                    description: Some("The name of the new page template. The template name cannot contain spaces"),
                ),
            ],
        ),
        (
            name: "create-virtual-uri",
            description: Some("The command creates a virtual URI mapping configuration file (a YAML definition file) in the light module"),
            options: [
                (
                    names: [
                        "-p",
                        "--path",
                    ],
                    description: Some("The path to the light module"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-f",
                        "--formUri",
                    ],
                    description: Some("The pattern to be matched in the requested URI. Enclose the <uri> value in quotes"),
                    arguments: [
                        (
                            name: "uri",
                        ),
                    ],
                ),
                (
                    names: [
                        "-t",
                        "--toUri",
                    ],
                    description: Some("A concrete URI that the request is mapped to. Enclose the <prefix:uri> value in quotes"),
                    arguments: [
                        (
                            name: "<prefix:uri>",
                        ),
                    ],
                ),
                (
                    names: [
                        "-P",
                        "--prototype",
                    ],
                    description: Some("The name of the prototype variant to create the mapping"),
                    arguments: [
                        (
                            name: "prototype",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "virtualUriName",
                    description: Some("The name of the new URI configuration"),
                ),
            ],
        ),
        (
            name: "customize-local-config",
            description: Some("Run this command to create a local configuration"),
            options: [
                (
                    names: [
                        "-p",
                        "--path",
                    ],
                    description: Some("The path into which the mgnl-cli-prototypes folder and mgnl-cli.json file are installed"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "install",
            description: Some("Downloads and installs one or more light modules from npm to the light module directory"),
            options: [
                (
                    names: [
                        "-p",
                        "--path",
                    ],
                    description: Some("The path to the light-modules folder"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "light-module-name",
                    description: Some("At least one name of a light module to be downloaded from npm. If you are installing more than one module from the repository, separate the module names with a space"),
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            query_term: Some(AfterLast("@")),
                            cache: Some((
                                ttl_ms: Some(172800000),
                                stale_while_revalidate: true,
                            )),
                        ),
                    ],
                    variadic: true,
                    debounce: true,
                ),
            ],
        ),
        (
            name: "jumpstart",
            description: Some("This command downloads, unpacks and pre-configures a Magnolia Tomcat server together with a specific webapp"),
            options: [
                (
                    names: [
                        "-p",
                        "--path",
                    ],
                    description: Some("The path to the light modules root folder which is observed for changes"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-m",
                        "--magnolia-version",
                    ],
                    description: Some("Use to choose a specific version of the Magnolia webapp. If not provided, the latest stable version of the specified webapp is downloaded"),
                    arguments: [
                        (
                            name: "version",
                        ),
                    ],
                ),
                (
                    names: [
                        "-i",
                        "--install-sample-module",
                    ],
                    description: Some("If provided, a sample light module under the light modules root folder with the given name is created"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                ),
                (
                    names: [
                        "-s",
                        "--snapshot",
                    ],
                    description: Some("Downloads the latest snapshot development version of the specified webapp"),
                ),
                (
                    names: [
                        "-w",
                        "--webapp",
                    ],
                    description: Some("Use to directly specify which Magnolia webapp you want to install"),
                    arguments: [
                        (
                            name: "webapp",
                            suggestions: [
                                (
                                    name: "magnolia-empty-webapp",
                                ),
                                (
                                    name: "magnolia-community-webapp",
                                ),
                                (
                                    name: "magnolia-community-demo-webapp",
                                ),
                                (
                                    name: "magnolia-dx-core-webapp",
                                ),
                                (
                                    name: "magnolia-dx-core-demo-webapp",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "tab-completion",
            description: Some("Run the command to install or uninstall autocompletion for Magnolia CLI commands"),
            arguments: [
                (
                    name: "command",
                    suggestions: [
                        (
                            name: "install",
                        ),
                        (
                            name: "uninstall",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "search",
            description: Some("Searches for Magnolia-related packages available from npm"),
            arguments: [
                (
                    name: "query",
                    description: Some("The search query sent to the npm's API. The query can contain multiple terms separated with commas and no spaces"),
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            query_term: Some(AfterLast("@")),
                            cache: Some((
                                ttl_ms: Some(172800000),
                                stale_while_revalidate: true,
                            )),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "start",
            description: Some("This command starts up Magnolia and displays the main log file"),
            options: [
                (
                    names: [
                        "-p",
                        "--path",
                    ],
                    description: Some("The path to the apache-tomcat folder"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-d",
                    ],
                    description: Some("Does NOT ignore the open files limit check. The files limit check is ignored by default"),
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for mgnl"),
            persistent: true,
        ),
    ],
    presentation: (
        icon: Some("https://avatars.githubusercontent.com/u/25686615?s=200&v=4"),
    ),
)
