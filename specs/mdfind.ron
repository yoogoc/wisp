(
    version: 1,
    command: "mdfind",
    description: Some("Finds files matching a given query"),
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for mdfind"),
        ),
        (
            names: [
                "-0",
            ],
            description: Some("Prints an ASCII NUL character after each result path"),
        ),
        (
            names: [
                "-live",
            ],
            description: Some("Provide live-updates to the number of files matching the query"),
        ),
        (
            names: [
                "-count",
            ],
            description: Some("Output the total number of matches, instead of the path to the matching items"),
        ),
        (
            names: [
                "-onlyin",
            ],
            description: Some("Limit the scope of the search to <dir>"),
            arguments: [
                (
                    name: "dir",
                    description: Some("Directory"),
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-name",
            ],
            description: Some("Search for matching file names to <filename> only"),
            arguments: [
                (
                    name: "filename",
                ),
            ],
        ),
        (
            names: [
                "-reprint",
            ],
            description: Some("Reprint results on live update"),
        ),
        (
            names: [
                "-s",
            ],
            description: Some("Show contents of smart folder ~/Library/Saved Searches/<folder>.savedSearch"),
            arguments: [
                (
                    name: "folder",
                    description: Some("Smart folder in  ~/Library/Saved Searches"),
                    generators: [
                        (
                            has_custom: true,
                            trigger: Some(OnMatch([
                                    "/",
                                ])),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-literal",
            ],
            description: Some("Force the provided query string to be taken as a literal query string, without interpretation"),
        ),
        (
            names: [
                "-interpret",
            ],
            description: Some("Force the provided query string to be interpreted as if it had been typed into the Spotlight menu"),
        ),
    ],
    arguments: [
        (
            name: "query",
        ),
    ],
    parser_directives: Some((
        flags_are_posix_noncompliant: true,
    )),
)
