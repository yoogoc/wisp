(
    version: 1,
    command: "mosh",
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for mosh"),
        ),
        (
            names: [
                "--client",
            ],
            description: Some("Mosh client on local machine (default: \"mosh-client\")"),
        ),
        (
            names: [
                "--server",
            ],
            description: Some("Mosh server on remote machine (default: \"mosh-server\")"),
        ),
        (
            names: [
                "--predict",
            ],
            description: Some("Local echo options"),
            arguments: [
                (
                    name: "",
                    suggestions: [
                        (
                            name: "adaptive",
                            description: Some("Local echo for slower links [default]"),
                        ),
                        (
                            name: "always",
                            description: Some("Use local echo even on fast links"),
                        ),
                        (
                            name: "never",
                            description: Some("Never use local echo"),
                        ),
                        (
                            name: "experimental",
                            description: Some("Aggressively echo even when incorrect"),
                        ),
                    ],
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "-4",
            ],
            description: Some("Use IPv4 only"),
        ),
        (
            names: [
                "-6",
            ],
            description: Some("Use IPv6 only"),
        ),
        (
            names: [
                "--family",
            ],
            description: Some("Network Type"),
            arguments: [
                (
                    name: "",
                    suggestions: [
                        (
                            name: "inet",
                            description: Some("Use IPv4 only"),
                        ),
                        (
                            name: "ine6",
                            description: Some("Use IPv6 only"),
                        ),
                        (
                            name: "auto",
                            description: Some("Autodetect network type for single-family hosts only"),
                        ),
                        (
                            name: "all",
                            description: Some("Try all network types"),
                        ),
                        (
                            name: "prefer-inet4",
                            description: Some("Use all network types, but try IPv4 first [default]"),
                        ),
                        (
                            name: "prefer-inet6",
                            description: Some("Use all network types, but try IPv6 first"),
                        ),
                    ],
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--port",
                "-p",
            ],
            description: Some("Server-side UDP port or range, (No effect on server-side SSH port)"),
        ),
        (
            names: [
                "--bind-server",
            ],
            description: Some("{ssh|any|IP}, ask the server to reply from an IP address, (default: \"ssh\")"),
        ),
        (
            names: [
                "--ssh",
            ],
            description: Some("Ssh command to run when setting up session, (example: \"ssh -p 2222\")"),
            arguments: [
                (
                    name: "command",
                    is_command: true,
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--no-ssh-pty",
            ],
            description: Some("Do not allocate a pseudo tty on ssh connection"),
        ),
        (
            names: [
                "--no-init",
            ],
            description: Some("Do not send terminal initialization string"),
        ),
        (
            names: [
                "--local",
            ],
            description: Some("Run mosh-server locally without using ssh"),
        ),
        (
            names: [
                "--experimental-remote-ip",
            ],
            description: Some("Select the method for discovering the remote IP address to use for mosh"),
            arguments: [
                (
                    name: "method",
                    suggestions: [
                        (
                            name: "local",
                        ),
                        (
                            name: "remote",
                        ),
                        (
                            name: "proxy",
                        ),
                    ],
                    default: Some("proxy"),
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Version and copyright information"),
        ),
    ],
    arguments: [
        (
            name: "user@hostname",
            description: Some("Address of remote machine to log into"),
            generators: [
                (
                    has_custom: true,
                    trigger: Some(OnMatch([
                            "@",
                        ])),
                ),
                (
                    has_custom: true,
                ),
                (
                    template: [
                        History,
                    ],
                ),
            ],
        ),
    ],
)
