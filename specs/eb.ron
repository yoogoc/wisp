(
    version: 1,
    command: "eb",
    description: Some("AWS Elastic Beanstalk"),
    subcommands: [
        (
            name: "init",
            description: Some("Initialize a new AWS Elastic Beanstalk application"),
            options: [
                (
                    names: [
                        "-i",
                        "--interactive",
                    ],
                    description: Some("Forces EB CLI to prompt you to provide a value for every eb init command option"),
                ),
                (
                    names: [
                        "-k",
                        "--keyname",
                    ],
                    description: Some("The name of the AWS EC2 key pair"),
                    arguments: [
                        (
                            name: "keyname",
                        ),
                    ],
                ),
                (
                    names: [
                        "--modules",
                    ],
                    description: Some("List of child directories to initialize"),
                ),
                (
                    names: [
                        "-p",
                        "--platform",
                    ],
                    description: Some("The platform version to use"),
                    arguments: [
                        (
                            name: "plataform-version",
                        ),
                    ],
                ),
                (
                    names: [
                        "--tags",
                    ],
                    description: Some("List of tags to apply to the application"),
                    arguments: [
                        (
                            name: "key=value",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "name",
                    description: Some("The name of the application"),
                ),
            ],
        ),
        (
            name: "deploy",
            description: Some("Deploys the application source bundle from the initialized project directory to the running application"),
            options: [
                (
                    names: [
                        "-l",
                        "--label",
                    ],
                    description: Some("Specify a label to use for the version that the EB CLI creates"),
                    arguments: [
                        (
                            name: "version-label",
                            description: Some("The label to use for the version"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--env-group-suffix",
                    ],
                    description: Some("Group name to append to the environment name"),
                    arguments: [
                        (
                            name: "groupname",
                            description: Some("The group name to append to the environment name"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-m",
                        "--message",
                    ],
                    description: Some("The description for the application version, enclosed in double quotation marks"),
                    arguments: [
                        (
                            name: "version-description",
                            description: Some("Description for the application version"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--modules",
                    ],
                    description: Some("List of components to update. Only for Compose Environments"),
                    arguments: [
                        (
                            name: "component",
                            description: Some("Component to update"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-p",
                        "--platform",
                    ],
                    description: Some("Preprocess and validate the environment manifest and configuration files in the source bundle"),
                ),
                (
                    names: [
                        "--source",
                    ],
                    description: Some("CodeCommit repository and branch"),
                    arguments: [
                        (
                            name: "repository-name/repository-branch",
                            description: Some("The name of the CodeCommit repository and branch"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--staged",
                    ],
                    description: Some("Deploy files staged in the git index instead of the HEAD commit"),
                ),
                (
                    names: [
                        "--timeout",
                    ],
                    description: Some("The number of minutes before the command times out"),
                    arguments: [
                        (
                            name: "minutes",
                            description: Some("Minutes before timeout"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--version",
                    ],
                    description: Some("An existing application version to deploy"),
                    arguments: [
                        (
                            name: "version-label",
                            description: Some("Label of the existing version to deploy"),
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "environment-name",
                    generators: [
                        (
                            script: [
                                "eb",
                                "list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "abort",
            description: Some("Abort the current running process"),
        ),
        (
            name: "clone",
            description: Some("Clones an environment to a new environment so that both have identical environment settings"),
            options: [
                (
                    names: [
                        "-n",
                        "--clone_name",
                    ],
                    description: Some("Desired name for the cloned environment"),
                    arguments: [
                        (
                            name: "string",
                            description: Some("The name for the cloned environment"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-c",
                        "--cname",
                    ],
                    description: Some("Desired CNAME prefix for the cloned environment"),
                    arguments: [
                        (
                            name: "cname",
                            description: Some("CNAME prefix"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--envvars",
                    ],
                    description: Some("Environment properties in a comma-separated list with the format name=value"),
                ),
                (
                    names: [
                        "--exact",
                    ],
                    description: Some("Prevents Elastic Beanstalk from updating the solution stack version for the new clone environment to the most recent version available"),
                ),
                (
                    names: [
                        "--scale",
                    ],
                    description: Some("The number of instances to run in the clone environment when it is launched"),
                    arguments: [
                        (
                            name: "number",
                            description: Some("Number of instances"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--tags",
                    ],
                    description: Some("Tags for the resources in your environment in a comma-separated list with the format name=value"),
                    arguments: [
                        (
                            name: "name=value",
                            description: Some("Tags for the resources in your environment"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--timeout",
                    ],
                    description: Some("The number of minutes before the command times out"),
                ),
            ],
            arguments: [
                (
                    name: "environment-name",
                    description: Some("The name of the environment to clone"),
                    generators: [
                        (
                            script: [
                                "eb",
                                "list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "open",
            description: Some("Opens the public URL of your website in the default browser"),
            arguments: [
                (
                    name: "environment-name",
                    description: Some("The name of the environment to open"),
                    generators: [
                        (
                            script: [
                                "eb",
                                "list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "list",
            description: Some("List environments"),
            options: [
                (
                    names: [
                        "-a",
                        "--all",
                    ],
                    description: Some("List all environments from all applications"),
                ),
                (
                    names: [
                        "-v",
                        "--verbose",
                    ],
                    description: Some("Provides more detailed information about all environments, including instances"),
                ),
            ],
        ),
        (
            name: "printenv",
            description: Some("Prints all the environment properties in the command window"),
            arguments: [
                (
                    name: "environment-name",
                    description: Some("The name of the environment to print"),
                    generators: [
                        (
                            script: [
                                "eb",
                                "list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "ssh",
            description: Some("Connect to a Linux Amazon EC2 instance in your environment using Secure Shell"),
            options: [
                (
                    names: [
                        "-i",
                        "--instance",
                    ],
                    description: Some("The ID of the instance to connect to"),
                ),
                (
                    names: [
                        "-n",
                        "--number",
                    ],
                    description: Some("The number of the instance to connect to by number"),
                ),
                (
                    names: [
                        "-o",
                        "--keep_open",
                    ],
                    description: Some("Leave port 22 open on the security group after the SSH session ends"),
                ),
                (
                    names: [
                        "--command",
                    ],
                    description: Some("Execute a shell command on the specified instance instead of starting an SSH session"),
                ),
                (
                    names: [
                        "--custom",
                    ],
                    description: Some("Specify an SSH command to use instead of 'ssh -i keyfile'. Do not include the remote user and hostname"),
                ),
                (
                    names: [
                        "--setup",
                    ],
                    description: Some("Change the key pair assigned to the environment's instances"),
                ),
                (
                    names: [
                        "--force",
                    ],
                    description: Some("Open port 22 to incoming traffic from 0.0.0.0/0 in the environment's security group, even if the security group is already configured for SSH"),
                ),
                (
                    names: [
                        "--timeout",
                    ],
                    description: Some("Set number of minutes before the command times out"),
                    arguments: [
                        (
                            name: "minutes",
                            description: Some("Number of minutes before timeout"),
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "environment-name",
                    description: Some("The name of the environment to connect to"),
                    generators: [
                        (
                            script: [
                                "eb",
                                "list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "use",
            description: Some("Sets the specified environment as the default environment"),
            options: [
                (
                    names: [
                        "-r",
                        "--region",
                    ],
                    description: Some("Change the region in which you create environments"),
                    arguments: [
                        (
                            name: "region",
                            description: Some("The region to use"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--source",
                    ],
                    description: Some("CodeCommit repository and branch"),
                    arguments: [
                        (
                            name: "codecommit/repository-name/repository-branch",
                            description: Some("The name of the CodeCommit repository and branch"),
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "environment-name",
                    description: Some("The name of the environment to use"),
                    generators: [
                        (
                            script: [
                                "eb",
                                "list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
    ],
)
