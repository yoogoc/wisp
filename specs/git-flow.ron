(
    version: 1,
    command: "git-flow",
    description: Some("A collection of Git extensions to provide high-level repository operations for Vincent Driessen's branching model"),
    subcommands: [
        (
            name: "init",
            description: Some("Initialize a new git repo with support for the branching model"),
            options: [
                (
                    names: [
                        "-d",
                    ],
                    description: Some("Use default branch naming conventions"),
                ),
                (
                    names: [
                        "-f",
                    ],
                    description: Some("Force setting of gitflow branches, even if already configured"),
                ),
            ],
        ),
        (
            name: "feature",
            description: Some("List all feature branches"),
            subcommands: [
                (
                    name: "start",
                    description: Some("Create a new feature branch"),
                    arguments: [
                        (
                            name: "name",
                            description: Some("The name of the new feature branch"),
                        ),
                    ],
                ),
                (
                    name: "finish",
                    description: Some("Merge a feature branch into develop"),
                    arguments: [
                        (
                            name: "name",
                            description: Some("The name of the feature branch to finish"),
                            generators: [
                                (
                                    has_custom: true,
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "publish",
                    description: Some("Push a feature branch to the remote repository"),
                    arguments: [
                        (
                            name: "name",
                            description: Some("The name of the feature branch to publish"),
                        ),
                    ],
                ),
                (
                    name: "pull",
                    description: Some("Pull a feature branch from the remote repository"),
                    arguments: [
                        (
                            name: "origin",
                            description: Some("The name of the remote feature branch"),
                        ),
                        (
                            name: "name",
                            description: Some("The name of the local feature branch"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "release",
            description: Some("List all release branches"),
            subcommands: [
                (
                    name: "start",
                    description: Some("Create a new release branch"),
                    arguments: [
                        (
                            name: "name",
                            description: Some("The name of the new release branch"),
                        ),
                    ],
                ),
                (
                    name: "finish",
                    description: Some("Merge a release branch into develop"),
                    arguments: [
                        (
                            name: "name",
                            description: Some("The name of the release branch to finish"),
                            generators: [
                                (
                                    has_custom: true,
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "hotfix",
            description: Some("List all hotfix branches"),
            subcommands: [
                (
                    name: "start",
                    description: Some("Create a new hotfix branch"),
                    arguments: [
                        (
                            name: "name",
                            description: Some("The name of the new hotfix branch"),
                        ),
                    ],
                ),
                (
                    name: "finish",
                    description: Some("Merge a hotfix branch into develop"),
                    arguments: [
                        (
                            name: "name",
                            description: Some("The name of the hotfix branch to finish"),
                            generators: [
                                (
                                    has_custom: true,
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "support",
            description: Some("List all support branches"),
            subcommands: [
                (
                    name: "start",
                    description: Some("Create a new support branch"),
                    arguments: [
                        (
                            name: "name",
                            description: Some("The name of the new support branch"),
                        ),
                    ],
                ),
            ],
        ),
    ],
)
