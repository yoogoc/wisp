                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Verbose logging to stdout"),
                ),
                (
                    names: [
                        "-k",
                        "--add-keys-to-agent",
                    ],
                    description: Some("Controls how keys are handled. Valid values are [auto no yes only]"),
                ),
                (
                    names: [
                        "--enable-escape-sequences",
                    ],
                    description: Some("Enable support for SSH escape sequences. Type '~?' during an SSH session to list supported sequences. Default is enabled"),
                ),
                (
                    names: [
                        "--bind-addr",
                    ],
                    description: Some("Override host:port used when opening a browser for cluster logins"),
                ),
                (
                    names: [
                        "-J",
                        "--jumphost",
                    ],
                    description: Some("SSH jumphost"),
                ),
