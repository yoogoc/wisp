(
    version: 1,
    command: "tsh",
    description: Some("TSH: Teleport Authentication Gateway Client"),
    subcommands: [
        (
            name: "version",
            description: Some("Print the version"),
        ),
        (
            name: "ssh",
            description: Some("Run shell or execute a command on a remote SSH node"),
            options: [
                (
                    names: [
                        "-1",
                    ],
                    description: Some("Forces ssh to try protocol version 1 only"),
                ),
                (
                    names: [
                        "-2",
                    ],
                    description: Some("Forces ssh to try protocol version 2 only"),
                ),
                (
                    names: [
                        "-4",
                    ],
                    description: Some("Forces ssh to use IPv4 addresses only"),
                ),
                (
                    names: [
                        "-6",
                    ],
                    description: Some("Forces ssh to use IPv6 addresses only"),
                ),
                (
                    names: [
                        "-A",
                    ],
                    description: Some("Enables forwarding of the authentication agent connection"),
                ),
                (
                    names: [
                        "-a",
                    ],
                    description: Some("Disables forwarding of the authentication agent connection"),
                ),
                (
                    names: [
                        "-b",
                    ],
                    description: Some("Use bind_address on the local machine as the source address of the connection"),
                    arguments: [
                        (
                            name: "bind address",
                            description: Some("Source address of the connection"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-C",
                    ],
                    description: Some("Requests compression of all data (including stdin, stdout, stderr, and data for forwarded X11 and TCP connections)"),
                ),
                (
                    names: [
                        "-c",
                    ],
                    description: Some("Selects the cipher specification for encrypting the session"),
                    arguments: [
                        (
                            name: "cipher spec",
                            description: Some("The selected cipher specification"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-D",
                    ],
                    description: Some("Specifies a local 'dynamic' application-level port forwarding"),
                    arguments: [
                        (
                            name: "port",
                            description: Some("Port of the bind address"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-e",
                    ],
                    description: Some("Sets the escape character for sessions with a pty (default: '~')"),
                    arguments: [
                        (
                            name: "escape char",
                            description: Some("Specified escape character"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-F",
                    ],
                    description: Some("Specifies an alternative per-user configuration file"),
                    arguments: [
                        (
                            name: "configfile",
                            description: Some("Path to alternative config file"),
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-f",
                    ],
                    description: Some("Requests ssh to go to background just before command execution"),
                ),
                (
                    names: [
                        "-g",
                    ],
                    description: Some("Allows remote hosts to connect to local forwarded ports"),
                ),
                (
                    names: [
                        "-I",
                    ],
                    description: Some("Specify the PKCS#11 shared library ssh should use to communicate with a PKCS#11 token providing the user's private RSA key"),
                    arguments: [
                        (
                            name: "pkcs11",
                        ),
                    ],
                ),
                (
                    names: [
                        "-i",
                    ],
                    description: Some("Selects a file from which the identity (private key) for public key authentication is read"),
                    arguments: [
                        (
                            name: "identity file",
                            description: Some("Path to identity (private key)"),
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                    repeat: Many,
                ),
                (
                    names: [
                        "-K",
                    ],
                    description: Some("Enables GSSAPI-based authentication and forwarding (delegation) of GSSAPI credentials to the server"),
                ),
                (
                    names: [
                        "-k",
                    ],
                    description: Some("Disables forwarding (delegation) of GSSAPI credentials to the server"),
                ),
                (
                    names: [
                        "-L",
                    ],
                    description: Some("Specifies that the given port on the local (client) host is to be forwarded to the given host and port on the remote side"),
                    arguments: [
                        (
                            name: "port:host:hostport",
                            description: Some("Local port, followed by host and host port to forward to"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-l",
                    ],
                    description: Some("Specifies the user to log in as on the remote machine"),
                    arguments: [
                        (
                            name: "login name",
                            description: Some("Name of user logging into remote machine"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-M",
                    ],
                    description: Some("Places the ssh client into ``master'' mode for connection sharing"),
                    repeat: Many,
                ),
                (
                    names: [
                        "-m",
                    ],
                    description: Some("Additionally, for protocol version 2 a comma-separated list of MAC (message authentication code) algorithms can be specified in order of preference"),
                    arguments: [
                        (
                            name: "mac spec",
                        ),
                    ],
                ),
                (
                    names: [
                        "-N",
                    ],
                    description: Some("Do not execute a remote command"),
                ),
                (
                    names: [
                        "-n",
                    ],
                    description: Some("Redirects stdin from /dev/null (actually, prevents reading from stdin)"),
                ),
                (
                    names: [
                        "-O",
                    ],
                    description: Some("Control an active connection multiplexing master process"),
                    arguments: [
                        (
                            name: "ctl cmd",
                            description: Some("Command that's passed to the master process"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-o",
                    ],
                    description: Some("Can be used to give options in the format used in the configuration file"),
                    arguments: [
                        (
                            name: "option",
                            description: Some("Options that can be specified in the format of the config file"),
                            suggestions: [
                                (
                                    name: "AddressFamily",
                                ),
                                (
                                    name: "BatchMode",
                                ),
                                (
                                    name: "BindAddress",
                                ),
                                (
