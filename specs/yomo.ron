(
    version: 1,
    command: "yomo",
    description: Some("CLI interface for YoMo"),
    subcommands: [
        (
            name: "init",
            description: Some("Initial an example StreamFunction"),
            options: [
                (
                    names: [
                        "--rx",
                    ],
                    description: Some("Generate Rx code template"),
                ),
            ],
            arguments: [
                (
                    name: "function name",
                    description: Some("StreamFunction name to initialize locally"),
                ),
            ],
        ),
        (
            name: "build",
            description: Some("Build a StreamFunction to WebAssembly"),
            options: [
                (
                    names: [
                        "--target",
                    ],
                    description: Some("Build to wasm or binary"),
                    arguments: [
                        (
                            name: "wasm",
                        ),
                        (
                            name: "binary",
                        ),
                    ],
                ),
                (
                    names: [
                        "-m",
                        "--modfile",
                    ],
                    description: Some("Custom go.mod filepath"),
                    arguments: [
                        (
                            name: "module",
                            generators: [
                                (
                                    has_custom: true,
                                    has_dynamic_trigger: true,
                                    has_dynamic_query_term: true,
                                ),
                            ],
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: ".go file",
                    description: Some("The .go file to build"),
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "run",
            description: Some("Run a wasm stream function"),
            options: [
                (
                    names: [
                        "-z",
                        "--zipper",
                    ],
                    description: Some("Zipper endpoint this StreamFunction will connect to"),
                ),
                (
                    names: [
                        "-n",
                        "--name",
                    ],
                    description: Some("Specify the name of this StreamFunction"),
                ),
            ],
            arguments: [
                (
                    name: ".wasm file",
                    description: Some("The .wasm file to run"),
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for yomo"),
        ),
    ],
)
