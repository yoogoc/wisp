(
    version: 1,
    command: "mkfifo",
    description: Some("Make FIFOs (first-in, first-out)"),
    options: [
        (
            names: [
                "-m",
            ],
            description: Some("Set the file permission bits of newly-created fifos to mode, without respect to the current umask; the mode is specified as in chmod(1)"),
            arguments: [
                (
                    name: "MODE",
                    suggestions: [
                        (
                            name: "0666",
                        ),
                        (
                            name: "0644",
                        ),
                        (
                            name: "0444",
                        ),
                    ],
                    default: Some("0666"),
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "FIFO",
            description: Some("FIFO(s) to create"),
            variadic: true,
        ),
    ],
)
