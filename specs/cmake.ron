(
    version: 1,
    command: "cmake",
    description: Some("Command-line interface of the cross-platform buildsystem generator CMake"),
    subcommands: [
        (
            name: "--build",
            description: Some("Project binary directory to be built and must be first. This is required unless a preset is specified"),
            options: [
                (
                    names: [
                        "--preset",
                    ],
                    description: Some("Use a build preset to specify build options"),
                    arguments: [
                        (
                            name: "preset",
                        ),
                    ],
                ),
                (
                    names: [
                        "--list-presets",
                    ],
                    description: Some("Lists the available presets. If no option is specified only configure presets will be listed. The current working directory must contain CMake preset files"),
                ),
                (
                    names: [
                        "--parallel",
                        "-j",
                    ],
                    description: Some("The maximum number of concurrent processes to use when building. If <jobs> is omitted the native build tool's default number is used"),
                    arguments: [
                        (
                            name: "jobs",
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--target",
                        "-t",
                    ],
                    description: Some("Build <tgt> instead of the default target. Multiple targets may be given, separated by spaces"),
                    arguments: [
                        (
                            name: "target",
                            variadic: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--config",
                    ],
                    description: Some("For multi-configuration tools, choose configuration <cfg>"),
                    arguments: [
                        (
                            name: "cfg",
                        ),
                    ],
                ),
                (
                    names: [
                        "--clean-first",
                    ],
                    description: Some("Build target clean first, then build"),
                ),
                (
                    names: [
                        "--use-stderr",
                    ],
                    description: Some("Ignored. Behavior is default in CMake >= 3.0"),
                ),
                (
                    names: [
                        "--verbose",
                        "-v",
                    ],
                    description: Some("Enable verbose output - if supported - including the build commands to be executed"),
                ),
                (
                    names: [
                        "--",
                    ],
                    description: Some("Pass remaining options to the native tool"),
                ),
            ],
            arguments: [
                (
                    name: "dir",
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "--install",
            description: Some("Project binary directory to install. This is required and must be first"),
            options: [
                (
                    names: [
                        "--config",
                    ],
                    description: Some("For multi-configuration generators"),
                    arguments: [
                        (
                            name: "cfg",
                        ),
                    ],
                ),
                (
                    names: [
                        "--component",
                    ],
                    description: Some("Component-based install. Only install component specified"),
                    arguments: [
                        (
                            name: "cfg",
                        ),
                    ],
                ),
                (
                    names: [
                        "--default-directory-permissions",
                    ],
                    description: Some("Default directory install permissions"),
                    arguments: [
                        (
                            name: "permissions",
                            description: Some("Format: <u=rwx,g=rx,o=rx>"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--prefix",
                    ],
                    description: Some("Override the installation prefix"),
                    arguments: [
                        (
                            name: "prefix",
                        ),
                    ],
                ),
                (
                    names: [
                        "--strip",
                    ],
                    description: Some("Strip before installing"),
                ),
                (
                    names: [
                        "--verbose",
                        "-v",
                    ],
                    description: Some("Enable verbose output"),
                ),
            ],
            arguments: [
                (
                    name: "dir",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            name: "--open",
            description: Some("Open the generated project in the associated application. This is only supported by some generators"),
            arguments: [
                (
                    name: "dir",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            name: "-P",
            description: Some("Process the given cmake file as a script written in the CMake language. No configure or generate step is performed and the cache is not modified. If variables are defined using -D, this must be done before the -P argument"),
            arguments: [
                (
                    name: "cmake script file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "-E",
            description: Some("CMake provides builtin command-line tools through the signature"),
            subcommands: [
                (
                    name: "capabilities",
                    description: Some("Report cmake capabilities in JSON format. The output is a JSON object with the following keys"),
                ),
                (
                    name: "cat",
                    description: Some("Concatenate files and print on the standard output"),
                    arguments: [
                        (
                            name: "files",
                            template: [
                                FilePaths,
                            ],
                            variadic: true,
                        ),
                    ],
                ),
                (
                    name: "chdir",
                    description: Some("Change the current working directory and run a command"),
                    arguments: [
                        (
                            name: "dir",
                            template: [
                                Folders,
                            ],
                        ),
                        (
                            name: "command",
                        ),
                    ],
                ),
                (
                    name: "compare_files",
                    description: Some("Check if file1 is the same as file2. If fails are the same, then returns 0, if not returns 1. In case of invalid arguments, it returns 2"),
                    options: [
                        (
                            names: [
                                "--ignore-eol",
                            ],
                            description: Some("Implies line-wise comparison and ignores LF/CRLF differences"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "file1",
                            template: [
                                FilePaths,
                            ],
                        ),
                        (
                            name: "file2",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    name: "copy",
                    description: Some("Copy files to <destination> (either file or directory). If multiple files are specified, the <destination> must be directory and it must exist. Wildcards are not supported. copy does follow symlinks. That means it does not copy symlinks, but the files or directories it point to"),
                    arguments: [
                        (
                            name: "file",
                            template: [
                                FilePaths,
                            ],
                            variadic: true,
                        ),
                        (
                            name: "destination",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    name: "copy_directory",
                    description: Some("Copy content of <dir>... directories to <destination> directory. If <destination> directory does not exist it will be created. copy_directory does follow symlinks"),
                    arguments: [
                        (
                            name: "dir",
                            template: [
                                Folders,
                            ],
                            variadic: true,
                        ),
                        (
                            name: "destination",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    name: "copy_if_different",
                    description: Some("Copy files to <destination> (either file or directory) if they have changed. If multiple files are specified, the <destination> must be directory and it must exist. copy_if_different does follow symlinks"),
                    arguments: [
                        (
                            name: "file",
                            template: [
                                FilePaths,
                            ],
                            variadic: true,
                        ),
                        (
                            name: "destination",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    name: "create_symlink",
                    description: Some("Create a symbolic link <new> naming <old>"),
                    arguments: [
                        (
                            name: "old",
                        ),
                        (
                            name: "new",
                        ),
                    ],
                ),
                (
                    name: "create_hardlink",
                    description: Some("Create a hard link <new> naming <old>"),
                    arguments: [
                        (
                            name: "old",
                        ),
                        (
                            name: "new",
                        ),
                    ],
                ),
                (
                    name: "echo",
                    description: Some("Displays arguments as text"),
                    arguments: [
                        (
                            name: "string",
                            optional: true,
                        ),
                    ],
                ),
                (
                    name: "echo_append",
                    description: Some("Displays arguments as text but no new line"),
                    arguments: [
                        (
                            name: "string",
                            optional: true,
                        ),
                    ],
                ),
                (
                    name: "env",
                    description: Some("Run command in a modified environment"),
                    options: [
                        (
                            names: [
                                "--unset",
                            ],
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                        ),
                    ],
                    arguments: [
                        (
                            name: "key value pair",
                            description: Some("Format: NAME=VALUE"),
                            optional: true,
                            variadic: true,
                        ),
                        (
                            name: "command",
                        ),
                    ],
                ),
                (
                    name: "environment",
                    description: Some("Display the current environment variables"),
                ),
                (
                    name: "false",
                    description: Some("Do nothing, with an exit code of 1"),
                ),
                (
                    name: "make_directory",
                    description: Some("Create <dir> directories. If necessary, create parent directories too. If a directory already exists it will be silently ignored"),
                    arguments: [
                        (
                            name: "dir",
                            template: [
                                Folders,
                            ],
                            variadic: true,
                        ),
                    ],
                ),
                (
                    name: "md5sum",
                    description: Some("Create MD5 checksum of files in md5sum compatible format"),
                    arguments: [
                        (
                            name: "file",
                            template: [
                                FilePaths,
                            ],
                            variadic: true,
                        ),
                    ],
                ),
                (
                    name: "sha1sum",
                    description: Some("Create SHA1 checksum of files in sha1sum compatible format"),
                    arguments: [
                        (
                            name: "file",
                            template: [
                                FilePaths,
                            ],
                            variadic: true,
                        ),
                    ],
                ),
                (
                    name: "sha224sum",
                    description: Some("Create SHA224 checksum of files in sha224sum compatible format"),
                    arguments: [
                        (
                            name: "file",
                            template: [
                                FilePaths,
                            ],
                            variadic: true,
                        ),
                    ],
                ),
                (
                    name: "sha226sum",
                    description: Some("Create SHA226 checksum of files in sha226sum compatible format"),
                    arguments: [
                        (
                            name: "file",
                            template: [
                                FilePaths,
                            ],
                            variadic: true,
                        ),
                    ],
                ),
                (
                    name: "sha384sum",
                    description: Some("Create SHA384 checksum of files in sha384sum compatible format"),
                    arguments: [
                        (
                            name: "file",
                            template: [
                                FilePaths,
                            ],
                            variadic: true,
                        ),
                    ],
                ),
                (
                    name: "sha512sum",
                    description: Some("Create SHA512 checksum of files in sha512sum compatible format"),
                    arguments: [
                        (
                            name: "file",
                            template: [
                                FilePaths,
                            ],
                            variadic: true,
                        ),
                    ],
                ),
                (
                    name: "remove",
                    description: Some("Remove the file(s). The planned behavior was that if any of the listed files already do not exist, the command returns a non-zero exit code, but no message is logged"),
                    options: [
                        (
                            names: [
                                "-f",
                            ],
                            description: Some("The -f option changes the behavior to return a zero exit code (i.e. success) in such situations instead. remove does not follow symlinks. That means it remove only symlinks and not files it point to"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "file",
                            template: [
                                FilePaths,
                            ],
                            variadic: true,
                        ),
                    ],
                ),
                (
                    name: "remove_directory",
                    description: Some("Remove <dir> directories and their contents. If a directory does not exist it will be silently ignored. If <dir> is a symlink to a directory, just the symlink will be removed. Use rm instead"),
                    arguments: [
                        (
                            name: "dir",
                            template: [
                                Folders,
                            ],
                            variadic: true,
                        ),
                    ],
                ),
                (
                    name: "rm",
                    description: Some("Remove the files <file> or directories dir"),
                    options: [
                        (
                            names: [
                                "-r",
                                "-R",
                            ],
                            description: Some("Use -r or -R to remove directories and their contents recursively. If any of the listed files/directories do not exist, the command returns a non-zero exit code, but no message is logged"),
                        ),
                        (
                            names: [
                                "-f",
                            ],
                            description: Some("The -f option changes the behavior to return a zero exit code (i.e. success) in such situations instead"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "file",
                            template: [
                                FilePaths,
                            ],
                            variadic: true,
                        ),
                        (
                            name: "dir",
                            template: [
                                Folders,
                            ],
                            variadic: true,
                        ),
                    ],
                ),
                (
                    name: "server",
                    description: Some("Launch cmake-server(7) mode"),
                ),
                (
                    name: "sleep",
                    description: Some("Sleep for given number of seconds"),
                    arguments: [
                        (
                            name: "number",
                            variadic: true,
                        ),
                    ],
                ),
                (
                    name: "tar",
                    description: Some("Create or extract a tar or zip archive"),
                    options: [
                        (
                            names: [
                                "c",
                            ],
                            description: Some("Create a new archive containing the specified files. If used, the pathname argument is mandatory"),
                        ),
                        (
                            names: [
                                "x",
                            ],
                            description: Some("Extract to disk from the archive. The <pathname>... argument could be used to extract only selected files or directories. When extracting selected files or directories, you must provide their exact names including the path, as printed by list (-t)"),
                        ),
                        (
                            names: [
                                "t",
                            ],
                            description: Some("List archive contents. The <pathname>... argument could be used to list only selected files or directories"),
                        ),
                        (
                            names: [
                                "v",
                            ],
                            description: Some("Produce verbose output"),
                        ),
                        (
                            names: [
                                "z",
                            ],
                            description: Some("Compress the resulting archive with gzip"),
                        ),
                        (
                            names: [
                                "j",
                            ],
                            description: Some("Compress the resulting archive with bzip2"),
                        ),
                        (
                            names: [
                                "J",
                            ],
                            description: Some("Compress the resulting archive with XZ"),
                        ),
                        (
                            names: [
                                "--zstd",
                            ],
                            description: Some("Compress the resulting archive with Zstandard"),
                        ),
                        (
                            names: [
                                "--files-from",
                            ],
                            description: Some("Read file names from the given file, one per line. Blank lines are ignored. Lines may not start in - except for --add-file=<name> to add files whose names start in -"),
                            arguments: [
                                (
                                    name: "file",
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--format",
                            ],
                            description: Some("Specify the format of the archive to be created"),
                            arguments: [
                                (
                                    name: "format",
                                    suggestions: [
                                        (
                                            name: "7zip",
                                        ),
                                        (
                                            name: "gnutar",
                                        ),
                                        (
                                            name: "pax",
                                        ),
                                        (
                                            name: "paxr",
                                        ),
                                        (
                                            name: "zip",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--mtime",
                            ],
                            description: Some("Specify modification time recorded in tarball entries"),
                            arguments: [
                                (
                                    name: "date",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--",
                            ],
                            description: Some("Stop interpreting options and treat all remaining arguments as file names, even if they start with -"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "pathname",
                            optional: true,
                        ),
                    ],
                ),
                (
                    name: "time",
                    description: Some("Run command and display elapsed time"),
                    arguments: [
                        (
                            name: "command",
                            is_command: true,
                        ),
                    ],
                ),
                (
                    name: "touch",
                    description: Some("Creates <file> if file do not exist. If <file> exists, it is changing <file> access and modification times"),
                    arguments: [
                        (
                            name: "file",
                            template: [
                                FilePaths,
                            ],
                            variadic: true,
                        ),
                    ],
                ),
                (
                    name: "touch_nocreate",
                    description: Some("Touch a file if it exists but do not create it. If a file does not exist it will be silently ignored"),
                    arguments: [
                        (
                            name: "file",
                            template: [
                                FilePaths,
                            ],
                            variadic: true,
                        ),
                    ],
                ),
                (
                    name: "true",
                    description: Some("Do nothing, with an exit code of 0"),
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "-S",
            ],
            description: Some("Path to root directory of the CMake project to build"),
            arguments: [
                (
                    name: "path-to-source",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--help",
            ],
        ),
        (
            names: [
                "-B",
            ],
            description: Some("Path to directory which CMake will use as the root of build directory. If the directory doesn't already exist CMake will make it"),
            arguments: [
                (
                    name: "path-to-source",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-C",
            ],
            description: Some("Pre-load a script to populate the cache"),
            arguments: [
                (
                    name: "initial-cache",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-D",
            ],
            description: Some("Create or update a CMake CACHE entry"),
            arguments: [
                (
                    name: "key value pair",
                    description: Some("<var>:<type>=<value> or <var>=<value>"),
                ),
            ],
        ),
        (
            names: [
                "-U",
            ],
            description: Some("Remove matching entries from CMake CACHE"),
            arguments: [
                (
                    name: "globbing_expr",
                ),
            ],
        ),
        (
            names: [
                "-G",
            ],
            description: Some("Specify a build system generator"),
            arguments: [
                (
                    name: "generator-name",
                ),
            ],
        ),
        (
            names: [
                "-T",
            ],
            description: Some("Toolset specification for the generator, if supported"),
            arguments: [
                (
                    name: "toolset-spec",
                ),
            ],
        ),
        (
            names: [
                "-A",
            ],
            description: Some("Specify platform name if supported by generator"),
            arguments: [
                (
                    name: "platform-name",
                ),
            ],
        ),
        (
            names: [
                "toolchain",
            ],
            description: Some("Specify the cross compiling toolchain file, equivalent to setting CMAKE_TOOLCHAIN_FILE variable"),
            arguments: [
                (
                    name: "path-to-file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--install-prefix",
            ],
            description: Some("Specify the installation directory, used by the CMAKE_INSTALL_PREFIX variable. Must be an absolute path"),
            arguments: [
                (
                    name: "directory",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-Wno-dev",
            ],
            description: Some("Suppress developer warnings"),
        ),
        (
            names: [
                "-Wdev",
            ],
            description: Some("Enable developer warnings"),
        ),
        (
            names: [
                "-Werror",
            ],
            description: Some("Enable the type of warnings"),
            arguments: [
                (
                    name: "type",
                    suggestions: [
                        (
                            name: "dev",
                            description: Some("Make developer warnings errors"),
                        ),
                        (
                            name: "deprecated",
                            description: Some("Make deprecated macro and function warnings errors"),
                        ),
                    ],
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "-Wno-error",
            ],
            description: Some("Disable the type of warnings"),
            arguments: [
                (
                    name: "type",
                    suggestions: [
                        (
                            name: "dev",
                            description: Some("Make developer warnings not errors"),
                        ),
                        (
                            name: "deprecated",
                            description: Some("Make deprecated macro and function warnings not errors"),
                        ),
                    ],
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "-Wdeprecated",
            ],
            description: Some("Enable deprecated functionality warnings"),
        ),
        (
            names: [
                "-Wno-deprecated",
            ],
            description: Some("Suppress deprecated functionality warnings"),
        ),
        (
            names: [
                "-L",
            ],
            description: Some("List non-advanced cached-variables"),
        ),
        (
            names: [
                "-N",
            ],
            description: Some("View mode only"),
        ),
        (
            names: [
                "--graphviz",
            ],
            description: Some("Generate graphviz of dependencies"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            names: [
                "--system-information",
            ],
            description: Some("Dump information about this system"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            names: [
                "--log-level",
            ],
            description: Some("Set log-level"),
            arguments: [
                (
                    name: "log-level",
                    suggestions: [
                        (
                            name: "ERROR",
                        ),
                        (
                            name: "WARNING",
                        ),
                        (
                            name: "NOTICE",
                        ),
                        (
                            name: "STATUS",
                        ),
                        (
                            name: "VERBOSE",
                        ),
                        (
                            name: "DEBUG",
                        ),
                        (
                            name: "TRACE",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--log-context",
            ],
            description: Some("Enable the message() command outputting context attached to each message"),
        ),
        (
            names: [
                "--debug-trycompile",
            ],
            description: Some("Do not delete the try_compile() build tree"),
        ),
        (
            names: [
                "--debug-output",
            ],
            description: Some("Put cmake in a debug mode"),
        ),
        (
            names: [
                "--debug-find",
            ],
            description: Some("Put cmake find commands in a debug mode"),
        ),
        (
            names: [
                "--trace",
            ],
            description: Some("Put cmake in trace mode"),
        ),
        (
            names: [
                "--trace-expand",
            ],
            description: Some("Put cmake in trace mode with variables expanded"),
        ),
        (
            names: [
                "--trace-format",
            ],
            description: Some("Put cmake in trace mode and sets the trace output format"),
            arguments: [
                (
                    name: "format",
                    suggestions: [
                        (
                            name: "human",
                        ),
                        (
                            name: "json-v1",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--trace-source",
            ],
            description: Some("Put cmake in trace mode, but output only lines of a specified file"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--trace-redirect",
            ],
            description: Some("Put cmake in trace mode and redirect trace output to a file instead of stderr"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--warn-uninitialized",
            ],
            description: Some("Warn about uninitialized values"),
        ),
        (
            names: [
                "--warn-unused-vars",
            ],
            description: Some("Does nothing. In CMake versions 3.2 and below this enabled warnings about unused variables. In CMake versions 3.3 through 3.18 the option was broken. In CMake 3.19 and above the option has been removed"),
        ),
        (
            names: [
                "--no-warn-unused-cli",
            ],
            description: Some("Don't warn about command line options. Don't find variables that are declared on the command line, but not used"),
        ),
        (
            names: [
                "--check-system-vars",
            ],
            description: Some("Find problems with variable usage in system files"),
        ),
        (
            names: [
                "--preset",
            ],
            description: Some("Reads a preset from <path-to-source>/CMakePresets.json and <path-to-source>/CMakeUserPresets.json. The preset may specify the generator and the build directory, and a list of variables and other arguments to pass to CMake. The current working directory must contain CMake preset files. The CMake GUI can also recognize CMakePresets.json and CMakeUserPresets.json files"),
            arguments: [
                (
                    name: "preset",
                ),
            ],
        ),
        (
            names: [
                "--list-presets",
            ],
            description: Some("Lists the available presets"),
            arguments: [
                (
                    name: "type",
                    suggestions: [
                        (
                            name: "configure",
                        ),
                        (
                            name: "build",
                        ),
                        (
                            name: "test",
                        ),
                        (
                            name: "all",
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "path-to-source | path-to-existing-build",
            template: [
                Folders,
            ],
        ),
    ],
)
