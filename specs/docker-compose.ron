                        ),
                    ],
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "logs",
            description: Some("View output from containers"),
            options: [
                (
                    names: [
                        "--follow",
                        "-f",
                    ],
                    description: Some("Follow log output"),
                ),
                (
                    names: [
                        "--no-color",
                    ],
                    description: Some("Produce monochrome output"),
                ),
                (
                    names: [
                        "--no-log-prefix",
                    ],
                    description: Some("Don't print prefix in logs"),
                ),
                (
                    names: [
                        "--since",
                    ],
                    description: Some("Show logs since timestamp (e.g. 2013-01-02T13:23:37Z) or relative (e.g. 42m for 42 minutes)"),
                    arguments: [
                        (
                            name: "since",
                        ),
                    ],
                ),
                (
                    names: [
                        "--tail",
                    ],
                    description: Some("Number of lines to show from the end of the logs for each container"),
                    arguments: [
                        (
                            name: "lines",
                            suggestions: [
                                (
                                    name: "all",
                                ),
                            ],
                            default: Some("all"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--timestamps",
                        "-t",
                    ],
                    description: Some("Show timestamps"),
                ),
                (
                    names: [
                        "--until",
                    ],
                    description: Some("Show logs before a timestamp (e.g. 2013-01-02T13:23:37Z) or relative (e.g. 42m for 42 minutes)"),
                    arguments: [
                        (
                            name: "timestamp",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "service",
                    generators: [
                        (
                            has_dynamic_script: true,
                            split_on: Some("\n"),
                        ),
                    ],
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "ls",
            description: Some("List running compose projects"),
            options: [
                (
                    names: [
                        "--all",
                        "-a",
                    ],
                    description: Some("Show all stopped Compose projects"),
                ),
                (
                    names: [
                        "--filter",
                    ],
                    description: Some("Filter output based on conditions provided"),
                    arguments: [
                        (
                            name: "filter",
                        ),
                    ],
                ),
                (
                    names: [
                        "--format",
                    ],
                    description: Some("Format the output. Values: [pretty | json]"),
                    arguments: [
                        (
                            name: "format",
