        (
            name: "pause",
            description: Some("Pause services"),
            arguments: [
                (
                    name: "service",
                    generators: [
                        (
                            has_dynamic_script: true,
                            split_on: Some("\n"),
                        ),
                    ],
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "port",
            description: Some("Print the public port for a port binding"),
            options: [
                (
                    names: [
                        "--index",
                    ],
                    description: Some("Index of the container if service has multiple replicas"),
                    arguments: [
                        (
                            name: "index",
                            default: Some("1"),
                        ),
                    ],
