(
    version: 1,
    command: "docker-compose",
    description: Some("Define and run multi-container applications with Docker"),
    subcommands: [
        (
            name: "build",
            description: Some("Build or rebuild services"),
            options: [
                (
                    names: [
                        "--build-arg",
                    ],
                    description: Some("Set build-time variables for services"),
                    arguments: [
                        (
                            name: "key=value",
                            generators: [
                                (
                                    has_dynamic_script: true,
                                    split_on: Some("\n"),
                                ),
                            ],
                        ),
                    ],
                    repeat: Many,
                ),
                (
                    names: [
                        "--compress",
                    ],
                    description: Some("Compress the build context using gzip. DEPRECATED"),
                    presentation: (
                        hidden: true,
                    ),
                ),
                (
                    names: [
                        "--force-rm",
                    ],
                    description: Some("Always remove intermediate containers. DEPRECATED"),
                    presentation: (
                        hidden: true,
                    ),
                ),
                (
                    names: [
                        "--memory",
                        "-m",
                    ],
                    description: Some("Set memory limit for the build container. Not supported on buildkit yet"),
                    arguments: [
                        (
                            name: "memory",
                        ),
                    ],
                    presentation: (
                        hidden: true,
                    ),
                ),
                (
                    names: [
                        "--no-cache",
                    ],
                    description: Some("Do not use cache when building the image"),
                ),
                (
                    names: [
                        "--no-rm",
                    ],
                    description: Some("Do not remove intermediate containers after a successful build. DEPRECATED"),
                    presentation: (
                        hidden: true,
                    ),
                ),
                (
                    names: [
                        "--parallel",
                    ],
                    description: Some("Build images in parallel. DEPRECATED"),
                    presentation: (
                        hidden: true,
                    ),
                ),
                (
                    names: [
                        "--progress",
                    ],
                    description: Some("Set type of progress output (auto, tty, plain, quiet)"),
                    arguments: [
                        (
                            name: "progress",
                            suggestions: [
                                (
                                    name: "auto",
                                ),
                                (
                                    name: "tty",
                                ),
                                (
                                    name: "plain",
                                ),
                                (
                                    name: "quiet",
                                ),
                            ],
                            default: Some("auto"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--pull",
                    ],
                    description: Some("Always attempt to pull a newer version of the image"),
                ),
                (
                    names: [
                        "--quiet",
                        "-q",
                    ],
                    description: Some("Don't print anything to STDOUT"),
                ),
                (
                    names: [
                        "--ssh",
                    ],
                    description: Some("Set SSH authentications used when building service images. (use 'default' for using your default SSH Agent)"),
                    arguments: [
                        (
                            name: "ssh",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "services",
                    generators: [
                        (
                            has_dynamic_script: true,
                            split_on: Some("\n"),
                        ),
                    ],
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "config",
            aliases: [
                "convert",
            ],
            description: Some("Converts the compose file to platform's canonical format"),
            options: [
                (
                    names: [
                        "--format",
                    ],
                    description: Some("Format the output. Values: [yaml | json]"),
                    arguments: [
                        (
                            name: "format",
                            suggestions: [
                                (
                                    name: "yaml",
                                ),
                                (
                                    name: "json",
                                ),
                            ],
                            default: Some("yaml"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--hash",
                    ],
                    description: Some("Print the service config hash, one per line"),
                    arguments: [
                        (
                            name: "hash",
                        ),
                    ],
                ),
                (
                    names: [
                        "--images",
                    ],
                    description: Some("Print the image names, one per line"),
                ),
                (
                    names: [
                        "--no-interpolate",
                    ],
                    description: Some("Don't interpolate environment variables"),
                ),
                (
                    names: [
                        "--no-normalize",
                    ],
                    description: Some("Don't normalize compose model"),
                ),
                (
                    names: [
                        "--output",
                        "-o",
                    ],
                    description: Some("Save to file (default to stdout)"),
                    arguments: [
                        (
                            name: "output",
                            template: [
                                FilePaths,
                            ],
                            suggest_current_token: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--profiles",
                    ],
                    description: Some("Print the profile names, one per line"),
                ),
                (
                    names: [
                        "--quiet",
                        "-q",
                    ],
                    description: Some("Only validate the configuration, don't print anything"),
                ),
                (
                    names: [
                        "--resolve-image-digests",
                    ],
                    description: Some("Pin image tags to digests"),
                ),
                (
                    names: [
                        "--services",
                    ],
                    description: Some("Print the service names, one per line"),
                ),
                (
                    names: [
                        "--volumes",
                    ],
                    description: Some("Print the volume names, one per line"),
                ),
            ],
            arguments: [
                (
                    name: "services",
                    generators: [
                        (
                            has_dynamic_script: true,
                            split_on: Some("\n"),
                        ),
                    ],
                    variadic: true,
                ),
            ],
        ),
        (
            name: "cp",
            description: Some("Copy files/folders between a service container and the local filesystem"),
            options: [
                (
                    names: [
                        "--all",
                    ],
                    description: Some("Copy to all the containers of the service"),
                    presentation: (
                        hidden: true,
                    ),
                ),
                (
                    names: [
                        "--archive",
                        "-a",
                    ],
                    description: Some("Archive mode (copy all uid/gid information)"),
                ),
                (
                    names: [
                        "--follow-link",
                        "-L",
                    ],
                    description: Some("Always follow symbol link in SRC_PATH"),
                ),
                (
                    names: [
                        "--index",
                    ],
                    description: Some("Index of the container if there are multiple instances of a service"),
                    arguments: [
                        (
                            name: "index",
                            default: Some("0"),
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "source path",
                ),
                (
                    name: "dest path",
                ),
            ],
        ),
        (
            name: "create",
            description: Some("Creates containers for a service"),
            options: [
                (
                    names: [
                        "--build",
                    ],
                    description: Some("Build images before starting containers"),
                ),
                (
                    names: [
                        "--force-recreate",
                    ],
                    description: Some("Recreate containers even if their configuration and image haven't changed"),
                ),
                (
                    names: [
                        "--no-build",
                    ],
                    description: Some("Don't build an image, even if it's missing"),
                ),
                (
                    names: [
                        "--no-recreate",
                    ],
                    description: Some("If containers already exist, don't recreate them. Incompatible with --force-recreate"),
                ),
            ],
            arguments: [
                (
                    name: "service",
                    generators: [
                        (
                            has_dynamic_script: true,
                            split_on: Some("\n"),
                        ),
                    ],
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "down",
            description: Some("Stop and remove containers, networks"),
            options: [
                (
                    names: [
                        "--remove-orphans",
                    ],
                    description: Some("Remove containers for services not defined in the Compose file"),
                ),
                (
                    names: [
                        "--rmi",
                    ],
                    description: Some("Remove images used by services. \"local\" remove only images that don't have a custom tag (\"local\"|\"all\")"),
                    arguments: [
                        (
                            name: "rmi",
                        ),
                    ],
                ),
                (
                    names: [
                        "--timeout",
                        "-t",
                    ],
                    description: Some("Specify a shutdown timeout in seconds"),
                    arguments: [
                        (
                            name: "timeout",
                            default: Some("10"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--volumes",
                        "-v",
                    ],
                    description: Some("Remove named volumes declared in the `volumes` section of the Compose file and anonymous volumes attached to containers"),
                ),
            ],
        ),
        (
            name: "events",
            description: Some("Receive real time events from containers"),
            options: [
                (
                    names: [
                        "--json",
                    ],
                    description: Some("Output events as a stream of json objects"),
                ),
            ],
            arguments: [
                (
                    name: "service",
                    generators: [
                        (
                            has_dynamic_script: true,
                            split_on: Some("\n"),
                        ),
                    ],
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "exec",
            description: Some("Execute a command in a running container"),
            options: [
                (
                    names: [
                        "--detach",
                        "-d",
                    ],
                    description: Some("Detached mode: Run command in the background"),
                ),
                (
                    names: [
                        "--env",
                        "-e",
                    ],
                    description: Some("Set environment variables"),
                    arguments: [
                        (
                            name: "key=value",
                        ),
                    ],
                    repeat: Many,
                ),
                (
                    names: [
                        "--index",
                    ],
                    description: Some("Index of the container if there are multiple instances of a service [default: 1]"),
                    arguments: [
                        (
                            name: "index",
                            default: Some("1"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--interactive",
                        "-i",
                    ],
                    description: Some("Keep STDIN open even if not attached"),
                    presentation: (
                        hidden: true,
                    ),
                ),
                (
                    names: [
                        "--no-TTY",
                        "-T",
                    ],
                    description: Some("Disable pseudo-TTY allocation. By default `docker compose exec` allocates a TTY"),
                ),
                (
                    names: [
                        "--privileged",
                    ],
                    description: Some("Give extended privileges to the process"),
                ),
                (
                    names: [
                        "--tty",
                        "-t",
                    ],
                    description: Some("Allocate a pseudo-TTY"),
                    presentation: (
                        hidden: true,
                    ),
                ),
                (
                    names: [
                        "--user",
                        "-u",
                    ],
                    description: Some("Run the command as this user"),
                    arguments: [
                        (
                            name: "user",
                        ),
                    ],
                ),
                (
                    names: [
                        "--workdir",
                        "-w",
                    ],
                    description: Some("Path to workdir directory for this command"),
                    arguments: [
                        (
                            name: "workdir",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "service",
                    generators: [
                        (
                            has_dynamic_script: true,
                            split_on: Some("\n"),
                        ),
                    ],
                ),
                (
                    name: "command",
                    variadic: true,
                    is_command: true,
                ),
            ],
        ),
        (
            name: "images",
            description: Some("List images used by the created containers"),
            options: [
                (
                    names: [
                        "--quiet",
                        "-q",
                    ],
                    description: Some("Only display IDs"),
                ),
            ],
            arguments: [
                (
                    name: "service",
                    generators: [
                        (
                            has_dynamic_script: true,
                            split_on: Some("\n"),
                        ),
                    ],
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "kill",
            description: Some("Force stop service containers"),
            options: [
                (
                    names: [
                        "--signal",
                        "-s",
                    ],
                    description: Some("SIGNAL to send to the container"),
                    arguments: [
                        (
                            name: "signal",
                            default: Some("SIGKILL"),
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "service",
                    generators: [
                        (
                            has_dynamic_script: true,
