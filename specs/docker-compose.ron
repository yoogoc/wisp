                (
                    names: [
                        "--quiet",
                        "-q",
                    ],
                    description: Some("Only display IDs"),
                ),
                (
                    names: [
                        "--services",
                    ],
                    description: Some("Display services"),
                ),
                (
                    names: [
                        "--status",
                    ],
                    description: Some("Filter services by status. Values: [paused | restarting | removing | running | dead | created | exited]"),
                    arguments: [
