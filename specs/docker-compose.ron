                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "pull",
            description: Some("Pull service images"),
            options: [
                (
                    names: [
                        "--ignore-pull-failures",
                    ],
                    description: Some("Pull what it can and ignores images with pull failures"),
                ),
                (
                    names: [
                        "--include-deps",
                    ],
                    description: Some("Also pull services declared as dependencies"),
