                                    name: "tcp",
                                ),
                                (
                                    name: "udp",
                                ),
                            ],
                            default: Some("tcp"),
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "service",
                    generators: [
                        (
                            has_dynamic_script: true,
                            split_on: Some("\n"),
                        ),
                    ],
                ),
                (
                    name: "private_port",
                ),
            ],
        ),
        (
            name: "ps",
            description: Some("List containers"),
            options: [
                (
                    names: [
                        "--all",
                        "-a",
                    ],
                    description: Some("Show all stopped containers (including those created by the run command)"),
                ),
                (
                    names: [
                        "--filter",
                    ],
                    description: Some("Filter services by a property (supported filters: status)"),
                    arguments: [
                        (
                            name: "filter",
                        ),
                    ],
                ),
                (
                    names: [
                        "--format",
                    ],
                    description: Some("Format the output. Values: [pretty | json]"),
                    arguments: [
                        (
                            name: "format",
                            suggestions: [
                                (
                                    name: "pretty",
                                ),
                                (
                                    name: "json",
                                ),
