(
    version: 1,
    command: "ubuntu-advantage",
    description: Some("Manage Ubuntu Pro services from Canonical"),
    subcommands: [
        (
            name: "attach",
            description: Some("Connect an Ubuntu Pro support contract to this machine"),
            options: [
                (
                    names: [
                        "--no-auto-enable",
                    ],
                    description: Some("Disable  the  automatic enablement of recommended entitlements"),
                ),
                (
                    names: [
                        "--attach-config",
                    ],
                    description: Some("Provide a file with configuration options"),
                    arguments: [
                        (
                            name: "file path",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                    requires_separator: Some("="),
                ),
            ],
            arguments: [
                (
                    name: "token",
                    description: Some("Auth token. Not required if specified in --attach-config file"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "collect-logs",
            description: Some("Create a tarball with all relevant logs and debug data"),
            options: [
                (
                    names: [
                        "-o",
                        "--output",
                    ],
                    description: Some("Path for tarball. Uses ua_logs.tar.gz in current directory if not specified"),
                    arguments: [
                        (
                            name: "file",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "detach",
            description: Some("Remove Ubuntu Pro from this machine"),
            presentation: (
                dangerous: true,
            ),
        ),
        (
            name: "disable",
            description: Some("Disable this machine's access to an Ubuntu Pro service"),
            arguments: [
                (
                    name: "service",
                    suggestions: [
                        (
                            name: "cc-eal",
                        ),
                        (
                            name: "cis",
                        ),
                        (
                            name: "esm",
                        ),
                        (
                            name: "fips",
                        ),
                        (
                            name: "fips-updates",
                        ),
                        (
                            name: "livepatch",
                        ),
                        (
                            name: "ros",
                        ),
                        (
                            name: "ros-updates",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "enable",
            description: Some("Activate and configure this machine's access to an Ubuntu Pro service"),
            arguments: [
                (
                    name: "service",
                    suggestions: [
                        (
                            name: "cc-eal",
                        ),
                        (
                            name: "cis",
                        ),
                        (
                            name: "esm",
                        ),
                        (
                            name: "fips",
                        ),
                        (
                            name: "fips-updates",
                        ),
                        (
                            name: "livepatch",
                        ),
                        (
                            name: "ros",
                        ),
                        (
                            name: "ros-updates",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "fix",
            description: Some("Fix a CVE or USN on the  system  by  upgrading  the  appropriate package(s)"),
            arguments: [
                (
                    name: "security issue",
                ),
            ],
        ),
        (
            name: "refresh",
            description: Some("Refresh contract and service details from Canonical"),
        ),
        (
            name: "security-status",
            description: Some("Show  security updates for packages in the system, including all available ESM related content"),
        ),
        (
            name: "status",
            description: Some("Report current status of Ubuntu Pro services on system"),
            options: [
                (
                    names: [
                        "--format",
                    ],
                    description: Some("Output format"),
                    arguments: [
                        (
                            name: "",
                            suggestions: [
                                (
                                    name: "tabular",
                                ),
                                (
                                    name: "json",
                                ),
                                (
                                    name: "yaml",
                                ),
                            ],
                        ),
                    ],
                    requires_separator: Some("="),
                ),
                (
                    names: [
                        "--simulate-with-token",
                    ],
                    arguments: [
                        (
                            name: "token",
                        ),
                    ],
                ),
                (
                    names: [
                        "--all",
                    ],
                    description: Some("Include beta and unavailable services"),
                ),
            ],
        ),
    ],
)
