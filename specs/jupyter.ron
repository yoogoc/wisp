        (
            name: "bundlerextension",
            description: Some("Work with Jupyter bundler extensions"),
            subcommands: [
                (
                    name: "enable",
                    description: Some("Enable a bundler extension"),
                ),
                (
                    name: "disable",
                    description: Some("Disable a bundler extension"),
                ),
                (
                    name: "list",
                    description: Some("List bundler extensions"),
                ),
            ],
            options: [
                (
                    names: [
