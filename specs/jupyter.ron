                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Show this message"),
                ),
                (
                    names: [
                        "--log-level",
                    ],
                    description: Some("Set the log level by value or name"),
                    arguments: [
                        (
                            name: "level",
                        ),
                    ],
                ),
                (
                    names: [
                        "--config",
                    ],
                    description: Some("Choose a config file"),
                    arguments: [
                        (
                            name: "config",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--user",
                    ],
