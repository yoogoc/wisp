(
    version: 1,
    command: "create-react-native-app",
    description: Some("Creates a new React Native project"),
    options: [
        (
            names: [
                "--template",
            ],
            description: Some("The name of a template from expo/examples or URL to a GitHub repo that contains an example"),
            arguments: [
                (
                    name: "template",
                ),
            ],
            presentation: (
                priority: Some(76.0),
                icon: Some("https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/export.png"),
            ),
        ),
        (
            names: [
                "--template-path",
            ],
            description: Some("The path inside of a GitHub repo where the example lives"),
            arguments: [
                (
                    name: "name",
                ),
            ],
            presentation: (
                priority: Some(76.0),
                icon: Some("https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/path.png"),
            ),
        ),
        (
            names: [
                "--yes",
            ],
            description: Some("Use the default options for creating a project"),
            arguments: [
                (
                    name: "boolean",
                    suggestions: [
                        (
                            name: "true",
                            presentation: (
                                icon: Some("https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/true.png"),
                            ),
                        ),
                        (
                            name: "false",
                            presentation: (
                                icon: Some("https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/false.png"),
                            ),
                        ),
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                priority: Some(76.0),
                icon: Some("https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/skip.png"),
            ),
        ),
        (
            names: [
                "--no-install",
            ],
            description: Some("Skip installing npm packages or CocoaPods"),
            arguments: [
                (
                    name: "boolean",
                    suggestions: [
                        (
                            name: "true",
                            presentation: (
                                icon: Some("https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/true.png"),
                            ),
                        ),
                        (
                            name: "false",
                            presentation: (
                                icon: Some("https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/false.png"),
                            ),
                        ),
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                priority: Some(76.0),
                icon: Some("https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/skip.png"),
            ),
        ),
        (
            names: [
                "--use-npm",
            ],
            description: Some("Use npm to install dependencies. (default when Yarn is not installed)"),
            arguments: [
                (
                    name: "boolean",
                    suggestions: [
                        (
                            name: "true",
                            presentation: (
                                icon: Some("https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/true.png"),
                            ),
                        ),
                        (
                            name: "false",
                            presentation: (
                                icon: Some("https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/false.png"),
                            ),
                        ),
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                priority: Some(76.0),
                icon: Some("fig://icon?type=npm"),
            ),
        ),
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Output usage information"),
            presentation: (
                priority: Some(1.0),
                icon: Some("https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/help.png"),
            ),
        ),
        (
            names: [
                "-V",
                "--version",
            ],
            description: Some("Output the version number"),
            presentation: (
                priority: Some(1.0),
                icon: Some("https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/info.png"),
            ),
        ),
    ],
    arguments: [
        (
            name: "name",
            template: [
                Folders,
            ],
        ),
    ],
