(
    version: 1,
    command: "wc",
    description: Some("World, line, character, and byte count"),
    options: [
        (
            names: [
                "-c",
            ],
            description: Some("Output the number of bytes to the standard input"),
        ),
        (
            names: [
                "-l",
            ],
            description: Some("Output the number of lines to the standard input"),
        ),
        (
            names: [
                "-m",
            ],
            description: Some("Output the number of characters to the standard input"),
        ),
        (
            names: [
                "-w",
            ],
            description: Some("Output the number of words to the standard input"),
        ),
    ],
    arguments: [
        (
            name: "file",
            description: Some("File to count in"),
            template: [
                FilePaths,
            ],
            optional: true,
            variadic: true,
        ),
    ],
)
