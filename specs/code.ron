(
    version: 1,
    command: "code",
    description: Some("Visual Studio Code"),
    options: [
        (
            names: [
                "-",
            ],
            description: Some("Read from stdin (e.g. 'ps aux | grep code | code -')"),
        ),
        (
            names: [
                "-d",
                "--diff",
            ],
            description: Some("Compare two files with each other"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-m",
                "--merge",
            ],
            description: Some("Perform a three-way merge by providing paths for two modified versions of a file, the common origin of both modified versions and the output file to save merge results"),
            arguments: [
                (
                    name: "path1",
                    template: [
                        FilePaths,
                    ],
                ),
                (
                    name: "path2",
                    template: [
                        FilePaths,
                    ],
                ),
                (
                    name: "base",
                    template: [
                        FilePaths,
                    ],
                ),
                (
                    name: "result",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-a",
                "--add",
            ],
            description: Some("Add folder(s) to the last active window"),
            arguments: [
                (
                    name: "folder",
                    template: [
                        Folders,
                    ],
                    variadic: true,
                ),
            ],
        ),
        (
            names: [
                "-g",
                "--goto",
            ],
            description: Some("Open a file at the path on the specified line and character position"),
            arguments: [
                (
                    name: "file:line[:character]",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-n",
                "--new-window",
            ],
            description: Some("Force to open a new window"),
        ),
        (
            names: [
                "-r",
                "--reuse-window",
            ],
            description: Some("Force to open a file or folder in an already opened window"),
        ),
        (
            names: [
                "-w",
                "--wait",
            ],
            description: Some("Wait for the files to be closed before returning"),
        ),
        (
            names: [
                "--locale",
            ],
            description: Some("The locale to use (e.g. en-US or zh-TW)"),
            arguments: [
                (
                    name: "locale",
                    suggestions: [
                        (
                            name: "en",
                            description: Some("English (US)"),
                            presentation: (
                                icon: Some("🇺🇸"),
                            ),
                        ),
                        (
                            name: "zh-CN",
                            description: Some("Simplified Chinese"),
                            presentation: (
                                icon: Some("🇨🇳"),
                            ),
                        ),
                        (
                            name: "zh-TW",
                            description: Some("Traditional Chinese"),
                            presentation: (
                                icon: Some("🇹🇼"),
                            ),
                        ),
                        (
                            name: "fr",
                            description: Some("French"),
                            presentation: (
                                icon: Some("🇫🇷"),
                            ),
                        ),
                        (
                            name: "de",
                            description: Some("German"),
                            presentation: (
                                icon: Some("🇩🇪"),
                            ),
                        ),
                        (
                            name: "it",
                            description: Some("Italian"),
                            presentation: (
                                icon: Some("🇮🇹"),
                            ),
                        ),
                        (
                            name: "es",
                            description: Some("Spanish"),
                            presentation: (
                                icon: Some("🇪🇸"),
                            ),
                        ),
                        (
                            name: "ja",
                            description: Some("Japanese"),
                            presentation: (
                                icon: Some("🇯🇵"),
                            ),
                        ),
                        (
                            name: "ko",
                            description: Some("Korean"),
                            presentation: (
                                icon: Some("🇰🇷"),
                            ),
                        ),
                        (
                            name: "ru",
                            description: Some("Russian"),
                            presentation: (
                                icon: Some("🇷🇺"),
                            ),
                        ),
                        (
                            name: "bg",
                            description: Some("Bulgarian"),
                            presentation: (
                                icon: Some("🇧🇬"),
                            ),
                        ),
                        (
                            name: "hu",
                            description: Some("Hungarian"),
                            presentation: (
                                icon: Some("🇭🇺"),
                            ),
                        ),
                        (
                            name: "pt-br",
                            description: Some("Portuguese (Brazil)"),
                            presentation: (
                                icon: Some("🇧🇷"),
                            ),
                        ),
                        (
                            name: "tr",
                            description: Some("Turkish"),
                            presentation: (
                                icon: Some("🇹🇷"),
                            ),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--user-data-dir",
            ],
            description: Some("Specifies the directory that user data is kept in. Can be used to open multiple distinct instances of Code"),
            arguments: [
                (
                    name: "dir",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--profile",
            ],
            description: Some("Opens the provided folder or workspace with the given profile and associates the profile with the workspace. If the profile does not exist, a new empty one is created. A folder or workspace must be provided for the profile to take effect"),
            arguments: [
                (
                    name: "settingsProfileName",
                ),
            ],
        ),
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Print usage"),
        ),
        (
            names: [
                "--extensions-dir",
            ],
            description: Some("Set the root path for extensions"),
            arguments: [
                (
                    name: "dir",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--list-extensions",
            ],
            description: Some("List the installed extensions"),
        ),
        (
            names: [
                "--show-versions",
            ],
            description: Some("Show versions of installed extensions, when using --list-extensions"),
        ),
        (
            names: [
                "--category",
            ],
            description: Some("Filters installed extensions by provided category, when using --list-extensions"),
            arguments: [
                (
                    name: "category",
                    suggestions: [
                        (
                            name: "azure",
                        ),
                        (
                            name: "data science",
                        ),
                        (
                            name: "debuggers",
                        ),
                        (
                            name: "extension packs",
                        ),
                        (
                            name: "education",
                        ),
                        (
                            name: "formatters",
                        ),
                        (
                            name: "keymaps",
                        ),
                        (
                            name: "language packs",
                        ),
                        (
                            name: "linters",
                        ),
                        (
                            name: "machine learning",
                        ),
                        (
                            name: "notebooks",
                        ),
                        (
                            name: "programming languages",
                        ),
                        (
                            name: "scm providers",
                        ),
                        (
                            name: "snippets",
                        ),
                        (
                            name: "testing",
                        ),
                        (
                            name: "themes",
                        ),
                        (
                            name: "visualization",
                        ),
                        (
                            name: "other",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--install-extension",
            ],
            description: Some("Installs or updates an extension. The argument is either an extension id or a path to a VSIX. The identifier of an extension is '${publisher}.${name}'. Use '--force' argument to update to latest version. To install a specific version provide '@${version}'. For example: 'vscode.csharp@1.2.3'"),
            arguments: [
                (
                    name: "extension-id[@version] | path-to-vsix",
                ),
            ],
        ),
        (
            names: [
                "--pre-release",
            ],
            description: Some("Installs the pre-release version of the extension, when using --install-extension"),
        ),
        (
            names: [
                "--uninstall-extension",
            ],
            description: Some("Uninstalls an extension"),
            arguments: [
                (
                    name: "extension-id",
                ),
            ],
        ),
        (
            names: [
                "--enable-proposed-api",
            ],
            description: Some("Enables proposed API features for extensions. Can receive one or more extension IDs to enable individually"),
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Print version"),
        ),
        (
            names: [
                "--verbose",
            ],
            description: Some("Print verbose output (implies --wait)"),
        ),
        (
            names: [
                "--log",
            ],
            description: Some("Log level to use. Default is 'info' when unspecified"),
            arguments: [
                (
                    name: "level",
                    suggestions: [
                        (
                            name: "critical",
                        ),
                        (
                            name: "error",
                        ),
                        (
                            name: "warn",
                        ),
                        (
                            name: "info",
                        ),
                        (
                            name: "debug",
                        ),
                        (
                            name: "trace",
                        ),
                        (
                            name: "off",
                        ),
                    ],
                    default: Some("info"),
                ),
            ],
        ),
        (
            names: [
                "-s",
                "--status",
            ],
            description: Some("Print process usage and diagnostics information"),
        ),
        (
            names: [
                "--prof-startup",
            ],
            description: Some("Run CPU profiler during startup"),
        ),
        (
            names: [
                "--disable-extensions",
            ],
            description: Some("Disable all installed extensions"),
        ),
        (
            names: [
                "--disable-extension",
            ],
            description: Some("Disable an extension"),
            arguments: [
                (
                    name: "extension-id",
                ),
            ],
        ),
        (
            names: [
                "--sync",
            ],
            description: Some("Turn sync on or off"),
            arguments: [
                (
                    name: "sync",
                    description: Some("Whether to enable sync"),
                    suggestions: [
                        (
                            name: "on",
                        ),
                        (
                            name: "off",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--inspect-extensions",
            ],
            description: Some("Allow debugging and profiling of extensions. Check the developer tools for the connection URI"),
            arguments: [
                (
                    name: "port",
                ),
            ],
        ),
        (
            names: [
                "--inspect-brk-extensions",
            ],
            description: Some("Allow debugging and profiling of extensions with the extension host being paused after start. Check the developer tools for the connection URI"),
            arguments: [
                (
                    name: "port",
                ),
            ],
        ),
        (
            names: [
                "--disable-gpu",
            ],
            description: Some("Disable GPU hardware acceleration"),
        ),
        (
            names: [
                "--max-memory",
            ],
            description: Some("Max memory size for a window (in Mbytes)"),
            arguments: [
                (
                    name: "memory",
                    description: Some("Memory in megabytes"),
                ),
            ],
        ),
        (
            names: [
                "--telemetry",
            ],
            description: Some("Shows all telemetry events which VS code collects"),
        ),
    ],
    arguments: [
        (
            name: "",
            template: [
                FilePaths,
                Folders,
            ],
            variadic: true,
        ),
    ],
)
