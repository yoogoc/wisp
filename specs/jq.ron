            arguments: [],
        ),
        (
            names: [
                "--null-input",
                "-n",
            ],
            description: Some("Don\'t read any input at all! Instead, the filter is run once using null as the input"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "--compact-output",
                "-c",
            ],
            description: Some("By default, jq pretty-prints JSON output. Using this option will result in more compact output by instead putting each JSON object on a single line"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "--tab",
            ],
            description: Some("Use a tab for each indentation level instead of two spaces"),
            takes_value: false,
            arguments: [],
        ),
