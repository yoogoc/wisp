(
    version: 1,
    command: "playwright",
    subcommands: [
        (
            name: "test",
            description: Some("Run tests with Playwright Test"),
            options: [
                (
                    names: [
                        "-g",
                    ],
                    description: Some("Run the test with the title"),
                    arguments: [
                        (
                            name: "title",
                        ),
                    ],
                ),
                (
                    names: [
                        "--headed",
                    ],
                    description: Some("Run tests in headed browsers"),
                ),
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Display help for command"),
                    presentation: (
                        priority: Some(1.0),
                    ),
                ),
            ],
            arguments: [
                (
                    name: "tests",
                    description: Some("Test files to run"),
                    template: [
                        FilePaths,
                        Folders,
                    ],
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "install",
            description: Some("Running without arguments will install default browsers"),
            options: [
                (
                    names: [
                        "--with-deps",
                    ],
                    description: Some("Install system dependencies for browsers"),
                ),
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Display help for command"),
                    presentation: (
                        priority: Some(1.0),
                    ),
                ),
            ],
            arguments: [
                (
                    name: "browsers",
                    description: Some("Browser to install"),
                    suggestions: [
                        (
                            name: "chromium",
                            presentation: (
                                display_name: Some("Chromium"),
                            ),
                        ),
                        (
                            name: "chrome",
                            presentation: (
                                display_name: Some("Chrome"),
                            ),
                        ),
                        (
                            name: "chrome-beta",
                            presentation: (
                                display_name: Some("Chrome Beta"),
                            ),
                        ),
                        (
                            name: "msedge",
                            presentation: (
                                display_name: Some("Microsoft Edge"),
                            ),
                        ),
                        (
                            name: "msedge-beta",
                            presentation: (
                                display_name: Some("Microsoft Edge Beta"),
                            ),
                        ),
                        (
                            name: "msedge-dev",
                            presentation: (
                                display_name: Some("Microsoft Edge Dev"),
                            ),
                        ),
                        (
                            name: "firefox",
                            presentation: (
                                display_name: Some("Firefox"),
                            ),
                        ),
                        (
                            name: "webkit",
                            presentation: (
                                display_name: Some("WebKit"),
                            ),
                        ),
                    ],
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--version",
                "-V",
            ],
            description: Some("Output the version number"),
        ),
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Display help for command"),
            presentation: (
                priority: Some(1.0),
            ),
        ),
    ],
)
