(
    version: 1,
    command: "pytest",
    options: [
        (
            names: [
                "--assert",
            ],
            description: Some("Control assertion debugging tools. 'plain' performs no assertion debugging. 'rewrite' (the default) rewrites assert statements in test modules on import to provide assert expression information"),
            arguments: [
                (
                    name: "Mode",
                    suggestions: [
                        (
                            name: "plain",
                        ),
                        (
                            name: "rewrite",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--basetemp",
            ],
            description: Some("Base temporary directory for this test run.(warning: this directory is removed if it exists)"),
            arguments: [
                (
                    name: "Directory",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-c",
            ],
            description: Some("Load configuration from `file` instead of trying to locate one of the implicit configuration files"),
            arguments: [
                (
                    name: "File",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--cache-clear",
            ],
            description: Some("Remove all cache contents at start of test run"),
        ),
        (
            names: [
                "--cache-show",
            ],
            description: Some("Show cache contents, don't perform collection or tests. Optional argument: glob (default: '*')"),
            arguments: [
                (
                    name: "Glob",
                    optional: true,
                    default: Some("*"),
                ),
            ],
        ),
        (
            names: [
                "--capture",
            ],
            description: Some("Per-test capturing method"),
            arguments: [
                (
                    name: "Method",
                    description: Some("One of fd|sys|no|tee-sys"),
                    suggestions: [
                        (
                            name: "fd",
                        ),
                        (
                            name: "sys",
                        ),
                        (
                            name: "no",
                        ),
                        (
                            name: "tee-sys",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--code-highlight",
            ],
            description: Some("Whether code should be highlighted (only if --color is also enabled)"),
            arguments: [
                (
                    name: "Highlight",
                    suggestions: [
                        (
                            name: "yes",
                        ),
                        (
                            name: "no",
                        ),
                    ],
                ),
            ],
            depends_on: [
                "--color",
            ],
        ),
        (
            names: [
                "--co",
                "--collect-only",
            ],
            description: Some("Only collect tests, don't execute them"),
        ),
        (
            names: [
                "--collect-in-virtualenv",
            ],
            description: Some("Don't ignore tests in a local virtualenv directory"),
        ),
        (
            names: [
                "--color",
            ],
            description: Some("Color terminal output"),
            arguments: [
                (
                    name: "Color",
                    suggestions: [
                        (
                            name: "yes",
                        ),
                        (
                            name: "no",
                        ),
                        (
                            name: "auto",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--confcutdir",
            ],
            description: Some("Only load conftest.py's relative to specified dir"),
            arguments: [
                (
                    name: "Dir",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--continue-on-collection-errors",
            ],
            description: Some("Force test execution even if collection errors occur"),
        ),
        (
            names: [
                "--debug",
            ],
            description: Some("Store internal tracing debug information in this log file. This file is opened with 'w' and truncated as a result, care advised. Defaults to 'pytestdebug.log'"),
            arguments: [
                (
                    name: "Debug File Name",
                    optional: true,
                    default: Some("pytestdebug.log"),
                ),
            ],
        ),
        (
            names: [
                "--durations",
            ],
            description: Some("Show N slowest setup/test durations (N=0 for all)"),
            arguments: [
                (
                    name: "N",
                    description: Some("(N=0 for all)"),
                ),
            ],
        ),
        (
            names: [
                "--durations-min",
            ],
            description: Some("Minimal duration in seconds for inclusion in slowest list"),
            arguments: [
                (
                    name: "N",
                    default: Some("0.005"),
                ),
            ],
        ),
        (
            names: [
                "--deselect",
            ],
            description: Some("Deselect item (via node id prefix) during collection (multi-allowed)"),
            arguments: [
                (
                    name: "nodeid_prefix",
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "--disable-warnings",
                "--disable-pytest-warnings",
            ],
            description: Some("Disable warnings summary"),
        ),
        (
            names: [
                "--doctest-continue-on-failure",
            ],
            description: Some("For a given doctest, continue to run after the first failure"),
        ),
        (
            names: [
                "--doctest-ignore-import-errors",
            ],
            description: Some("Ignore doctest ImportErrors"),
        ),
        (
            names: [
                "--doctest-modules",
            ],
            description: Some("Run doctests in all .py modules"),
        ),
        (
            names: [
                "--doctest-report",
            ],
            description: Some("Choose another output format for diffs on doctest failure"),
            arguments: [
                (
                    name: "Output format",
                    description: Some("None,cdiff,ndiff,udiff,only_first_failure"),
                    suggestions: [
                        (
                            name: "none",
                        ),
                        (
                            name: "cdiff",
                        ),
                        (
                            name: "ndiff",
                        ),
                        (
                            name: "udiff",
                        ),
                        (
                            name: "only_first_failure",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--doctest-glob",
            ],
            description: Some("Doctests file matching pattern, default: test*.txt"),
            arguments: [
                (
                    name: "Pattern",
                    default: Some("test*.txt"),
                ),
            ],
        ),
        (
            names: [
                "--exitfirst",
                "-x",
            ],
            description: Some("Exit instantly on first error or failed test"),
        ),
        (
            names: [
                "--failed-first",
                "--ff",
            ],
            description: Some("Run all tests, but run the last failures first"),
        ),
        (
            names: [
                "--fixtures",
            ],
            description: Some("Shows builtin and custom fixtures. Note that this command omits fixtures with leading _ unless the -v option is added"),
        ),
        (
            names: [
                "--fixtures-per-test",
            ],
            description: Some("Show fixtures per test"),
        ),
        (
            names: [
                "--full-trace",
            ],
            description: Some("Don't cut any tracebacks (default is to cut)"),
        ),
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("This shows help on command line and config-line options"),
        ),
        (
            names: [
                "--ignore",
            ],
            description: Some("Ignore path during collection (multi-allowed)"),
            arguments: [
                (
                    name: "Path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "--ignore-glob",
            ],
            description: Some("Ignore path pattern during collection (multi-allowed)"),
            arguments: [
                (
                    name: "Path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "--import-mode",
            ],
            description: Some("Prepend/append to sys.path when importing test modules and conftest files, default is to prepend"),
            arguments: [
                (
                    name: "Mode",
                    suggestions: [
                        (
                            name: "prepend",
                        ),
                        (
                            name: "append",
                        ),
                        (
                            name: "importlib",
                        ),
                    ],
                    default: Some("prepend"),
                ),
            ],
        ),
        (
            names: [
                "--junit-xml",
            ],
            description: Some("Create junit-xml style report file at given path"),
            arguments: [
                (
                    name: "Path",
                    template: [
                        FilePaths,
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--junit-prefix",
            ],
            description: Some("Prepend prefix to classnames in junit-xml output"),
            arguments: [
                (
                    name: "Str",
                    description: Some("String to prepend"),
                ),
            ],
        ),
        (
            names: [
                "-k",
            ],
            description: Some("Only run tests which match the given substring expression. An expression is a python evaluatable expression where all names are substring-matched against test names and their parent classes. Example: -k 'test_method or test_other' matches all test functions and classes whose name contains 'test_method' or 'test_other', while -k 'not test_method' matches those that don't contain 'test_method' in their names. -k 'not test_method and not test_other' will eliminate the matches. Additionally keywords are matched to classes and functions containing extra names in their 'extra_keyword_matches' set, as well as functions which have names assigned directly to them. The matching is case- insensitive"),
            arguments: [
                (
                    name: "Expression",
                    description: Some("Ex: 'test_method or test_other'"),
                ),
            ],
        ),
        (
            names: [
                "--keep-duplicates",
            ],
            description: Some("Keep duplicate tests"),
        ),
        (
            names: [
                "--showlocals",
                "-l",
            ],
            description: Some("Show locals in tracebacks (disabled by default)"),
        ),
        (
            names: [
                "--last-failed-no-failures",
                "--lfnf",
            ],
            description: Some("Which tests to run with no previously (known) failures"),
            arguments: [
                (
                    name: "Tests",
                    suggestions: [
                        (
                            name: "all",
                        ),
                        (
                            name: "none",
                        ),
                    ],
                    default: Some("all"),
                ),
            ],
        ),
        (
            names: [
                "--last-failed",
                "--lf",
            ],
            description: Some("Rerun only the tests that failed at the last run (or all if none failed)"),
        ),
        (
            names: [
                "--log-auto-indent",
            ],
            description: Some("Auto-indent multiline messages passed to the logging module. Accepts true|on, false|off or an integer"),
            arguments: [
                (
                    name: "Log Auto Indent Setting",
                    suggestions: [
                        (
                            name: "true",
                        ),
                        (
                            name: "false",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--log-cli-level",
            ],
            description: Some("Cli logging level"),
            arguments: [
                (
                    name: "Log CLI Level",
                    suggestions: [
                        (
                            name: "CRITICAL",
                        ),
                        (
                            name: "ERROR",
                        ),
                        (
                            name: "WARNING",
                        ),
                        (
                            name: "INFO",
                        ),
                        (
                            name: "DEBUG",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--log-cli-format",
            ],
            description: Some("Log format as used by the logging module"),
            arguments: [
                (
                    name: "Log CLI Format",
                ),
            ],
        ),
        (
            names: [
                "--log-cli-date-format",
            ],
            description: Some("Log date format as used by the logging module"),
            arguments: [
                (
                    name: "Log CLI Date Format",
                ),
            ],
        ),
        (
            names: [
                "--log-date-format",
            ],
            description: Some("Log date format as used by the logging module"),
            arguments: [
                (
                    name: "Log Date Format",
                ),
            ],
        ),
        (
            names: [
                "--log-format",
            ],
            description: Some("Log format as used by the logging module"),
            arguments: [
                (
                    name: "Log Format",
                ),
            ],
        ),
        (
            names: [
                "--log-file",
            ],
            description: Some("Path to a file where logging will be written to"),
            arguments: [
                (
                    name: "Log File Path",
                    template: [
                        FilePaths,
                    ],
                    suggest_current_token: true,
                ),
            ],
        ),
        (
            names: [
                "--log-file-level",
            ],
            description: Some("Log file logging level"),
            arguments: [
                (
                    name: "Log File Level",
                    suggestions: [
                        (
                            name: "CRITICAL",
                        ),
                        (
                            name: "ERROR",
                        ),
                        (
                            name: "WARNING",
                        ),
                        (
                            name: "INFO",
                        ),
                        (
                            name: "DEBUG",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--log-file-date-format",
            ],
            description: Some("Log date format as used by the logging module"),
            arguments: [
                (
                    name: "Log File Date Format",
                ),
            ],
        ),
        (
            names: [
                "--log-file-format",
            ],
            description: Some("Log format as used by the logging module"),
            arguments: [
                (
                    name: "Log File Format",
                ),
            ],
        ),
        (
            names: [
                "--log-level",
            ],
            description: Some("Level of messages to catch/display. Not set by default, so it depends on the root/parent log handler's effective level, where it is `WARNING` by default"),
            arguments: [
                (
                    name: "Level",
                    suggestions: [
                        (
                            name: "CRITICAL",
                        ),
                        (
                            name: "ERROR",
                        ),
                        (
                            name: "WARNING",
                        ),
                        (
                            name: "INFO",
                        ),
                        (
                            name: "DEBUG",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-m",
            ],
            description: Some("Only run tests matching given mark expression"),
            arguments: [
                (
                    name: "Mark Expression",
                ),
            ],
        ),
        (
            names: [
                "--markers",
            ],
            description: Some("Show markers (builtin, plugin and per-project ones)"),
        ),
        (
            names: [
                "--maxfail",
            ],
            description: Some("Exit after first num failures or errors"),
            arguments: [
                (
                    name: "num",
                ),
            ],
        ),
        (
            names: [
                "--new-first",
                "--nf",
            ],
            description: Some("Run tests from new files first, then the rest of the tests sorted by file mtime"),
        ),
        (
            names: [
                "--noconftest",
            ],
            description: Some("Don't load any conftest.py files"),
        ),
        (
            names: [
                "--no-header",
            ],
            description: Some("Disable header"),
        ),
        (
            names: [
                "--no-summary",
            ],
            description: Some("Disable summary"),
        ),
        (
            names: [
                "--override-ini",
                "-o",
            ],
            description: Some("Override ini option with `option=value` style`"),
            arguments: [
                (
                    name: "Override INI",
                    description: Some("Ex: `-o xfail_strict=True -o cache_dir=cache"),
                ),
            ],
        ),
        (
            names: [
                "-p",
            ],
            description: Some("Early-load given plugin module name or entry point (multi-allowed)"),
            arguments: [
                (
                    name: "Plugin name",
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "--pastebin",
            ],
            description: Some("Send failed|all info to bpaste.net pastebin service"),
            arguments: [
                (
                    name: "mode",
                    suggestions: [
                        (
                            name: "failed",
                        ),
                        (
                            name: "all",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--pdb",
            ],
            description: Some("Start the interactive Python debugger on errors or KeyboardInterrupt"),
        ),
        (
            names: [
                "--pdbcls",
            ],
            description: Some("Specify a custom interactive Python debugger for use with --pdb"),
            arguments: [
                (
                    name: "modulename:classname",
                    description: Some("Ex: --pdbcls=IPython.terminal.debugger:TerminalPdb"),
                ),
            ],
        ),
        (
            names: [
                "--pyargs",
            ],
            description: Some("Try to interpret all arguments as python packages"),
        ),
        (
            names: [
                "--quiet",
                "-q",
            ],
            description: Some("Decrease verbosity"),
        ),
        (
            names: [
                "-r",
            ],
            description: Some("Show extra test summary info as specified by chars: (f)ailed, (E)rror, (s)kipped, (x)failed, (X)passed, (p)assed, (P)assed with output, (a)ll except passed (p/P), or (A)ll. (w)arnings are enabled by default (see --disable-warnings), 'N' can be used to reset the list. (default: 'fE')"),
            arguments: [
                (
                    name: "chars",
                    suggestions: [
                        (
                            name: "a",
                        ),
                        (
                            name: "A",
                        ),
                        (
                            name: "E",
                        ),
                        (
                            name: "f",
                        ),
                        (
                            name: "N",
                        ),
                        (
                            name: "p",
                        ),
                        (
                            name: "P",
                        ),
                        (
                            name: "s",
                        ),
                        (
                            name: "w",
                        ),
                        (
                            name: "x",
                        ),
                        (
                            name: "X",
                        ),
                    ],
                    default: Some("fE"),
                ),
            ],
        ),
        (
            names: [
                "--rootdir",
            ],
            description: Some("Define root directory for tests. Can be relative path: 'root_dir', './root_dir', 'root_dir/another_dir/'; absolute path: '/home/user/root_dir'; path with variables:'$HOME/root_dir'"),
            arguments: [
                (
                    name: "Root Dir",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--runxfail",
            ],
            description: Some("Report the results of xfail tests as if they were not marked"),
        ),
        (
            names: [
                "-s",
            ],
            description: Some("Shortcut for --capture=no"),
        ),
        (
            names: [
                "--setup-only",
            ],
            description: Some("Only setup fixtures, do not execute tests"),
        ),
        (
            names: [
                "--setup-show",
            ],
            description: Some("Show setup of fixtures while executing tests"),
        ),
        (
            names: [
                "--setup-plan",
            ],
            description: Some("Show what fixtures and tests would be executed but don't execute anything"),
        ),
        (
            names: [
                "--show-capture",
            ],
            description: Some("Controls how captured stdout/stderr/log is shown on failed tests"),
            arguments: [
                (
                    name: "Capture method",
                    suggestions: [
                        (
                            name: "no",
                        ),
                        (
                            name: "stdout",
                        ),
                        (
                            name: "stderr",
                        ),
                        (
                            name: "log",
                        ),
                        (
                            name: "all",
                        ),
                    ],
                    default: Some("all"),
                ),
            ],
        ),
        (
            names: [
                "--stepwise",
                "--sw",
            ],
            description: Some("Exit on test failure and continue from last failing test next time"),
        ),
        (
            names: [
                "--stepwise-skip",
                "--sw-skip",
            ],
            description: Some("Ignore the first failing test but stop on the next failing test"),
        ),
        (
            names: [
                "--strict",
            ],
            description: Some("Alias to --strict-markers"),
        ),
        (
            names: [
                "--strict-config",
            ],
            description: Some("Any warnings encountered while parsing the `pytest` section of the configuration file raise errors"),
        ),
        (
            names: [
                "--strict-markers",
            ],
            description: Some("Markers not registered in the `markers` section of the configuration file raise errors"),
        ),
        (
            names: [
                "--tb",
            ],
            description: Some("Traceback print mode"),
            arguments: [
                (
                    name: "Traceback print mode",
                    suggestions: [
                        (
                            name: "auto",
                        ),
                        (
                            name: "long",
                        ),
                        (
                            name: "short",
                        ),
                        (
                            name: "line",
                        ),
                        (
                            name: "native",
                        ),
                        (
                            name: "no",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--trace",
            ],
            description: Some("Immediately break when running each test"),
        ),
        (
            names: [
                "--trace-config",
            ],
            description: Some("Trace considerations of conftest.py files"),
        ),
        (
            names: [
                "--verbose",
                "-v",
            ],
            description: Some("Increase verbosity"),
            repeat: Many,
        ),
        (
            names: [
                "--verbosity",
            ],
            description: Some("Set verbosity. Default is 0"),
            arguments: [
                (
                    name: "Verbosity level",
                    default: Some("0"),
                ),
            ],
        ),
        (
            names: [
                "--version",
                "-V",
            ],
            description: Some("Display pytest version and information about plugins. When given twice, also display information about plugins"),
        ),
        (
            names: [
                "--pythonwarnings",
                "-W",
            ],
            description: Some("Set which warnings to report, see -W option of python itself"),
            arguments: [
                (
                    name: "Warnings to report",
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "File or Directory",
            description: Some("The test file or directory you want to run pytest on. If omitted, pytest will run all       of the files of the form test_*.py or *_test.py in the current directory       and its subdirectories"),
            template: [
                FilePaths,
                Folders,
            ],
            optional: true,
        ),
    ],
)
