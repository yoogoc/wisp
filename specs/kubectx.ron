(
    version: 1,
    command: "kubectx",
    description: Some("Switch between Kubernetes-contexts"),
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for kubectx"),
        ),
        (
            names: [
                "--current",
                "-c",
            ],
            description: Some("Show current context"),
        ),
        (
            names: [
                "--unset",
                "-u",
            ],
            description: Some("Unset the current context"),
        ),
        (
            names: [
                "-d",
            ],
            description: Some("Delete context"),
            arguments: [
                (
                    name: "context",
                    generators: [
                        (
                            script: [
                                "kubectx",
                            ],
                            has_post_process: true,
                        ),
                    ],
                    variadic: true,
                ),
            ],
            presentation: (
                dangerous: true,
            ),
        ),
    ],
    arguments: [
        (
            name: "context",
            generators: [
                (
                    script: [
                        "bash",
                        "-c",
                        "kubectx | grep -v $(kubectx -c)",
                    ],
                    has_post_process: true,
                ),
                (
                    script: [
                        "kubectx",
                        "-c",
                    ],
                    has_post_process: true,
                ),
            ],
            optional: true,
        ),
    ],
    additional_suggestions: [
        (
            name: "-",
            description: Some("Switch to previous context"),
            presentation: (
                priority: Some(85.0),
                icon: Some("fig://icon?type=asterisk"),
            ),
        ),
    ],
    parser_directives: Some((
        flags_are_posix_noncompliant: true,
    )),
)
