(
    version: 1,
    command: "python",
    description: Some("Run the python interpreter"),
    options: [
        (
            names: [
                "-c",
            ],
            description: Some("Execute the Python code in command. command can be one or more statements separated by newlines, with significant leading whitespace as in normal module code"),
            arguments: [
                (
                    name: "command",
                    is_command: true,
                ),
            ],
            presentation: (
                insert_value: Some("-c '{cursor}'"),
            ),
        ),
        (
            names: [
                "-m",
            ],
            description: Some("Module"),
            arguments: [
                (
                    name: "python module",
                    suggestions: [
                        (
                            name: "http.server",
                        ),
                    ],
                    is_module: Some("python/"),
                ),
            ],
        ),
        (
            names: [
                "-?",
                "-h",
                "--help",
            ],
            description: Some("Print a short description of all command line options"),
        ),
        (
            names: [
                "-V",
                "--version",
            ],
            description: Some("Print the Python version number and exit"),
        ),
        (
            names: [
                "-b",
            ],
            description: Some("Issue a warning when comparing bytes or bytearray with str or bytes with int. Issue an error when the option is given twice (-bb)"),
        ),
        (
            names: [
                "-B",
            ],
            description: Some("If given, Python won’t try to write .pyc files on the import of source modules"),
        ),
        (
            names: [
                "--check-hash-based-pycs",
            ],
            description: Some("Control the validation behavior of hash-based .pyc files. See Cached bytecode invalidation"),
            arguments: [
                (
                    name: "",
                    suggestions: [
                        (
                            name: "default",
                        ),
                        (
                            name: "always",
                        ),
                        (
                            name: "never",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-d",
            ],
            description: Some("Turn on parser debugging output (for expert only, depending on compilation options)"),
        ),
        (
            names: [
                "-E",
            ],
            description: Some("Ignore all PYTHON* environment variables, e.g. PYTHONPATH and PYTHONHOME, that might be set"),
        ),
        (
            names: [
                "-i",
            ],
            description: Some("When a script is passed as first argument or the -c option is used, enter interactive mode after executing the script or the command, even when sys.stdin does not appear to be a terminal"),
        ),
        (
            names: [
                "-I",
            ],
            description: Some("Run Python in isolated mode. This also implies -E and -s. In isolated mode sys.path contains neither the script’s directory nor the user’s site-packages directory"),
        ),
        (
            names: [
                "-O",
            ],
            description: Some("Remove assert statements and any code conditional on the value of __debug__"),
        ),
        (
            names: [
                "-OO",
            ],
            description: Some("Do -O and also discard docstrings"),
        ),
        (
            names: [
                "-g",
            ],
            description: Some("Don’t display the copyright and version messages even in interactive mode"),
        ),
        (
            names: [
                "-R",
            ],
            description: Some("Turn on hash randomization. This option only has an effect if the PYTHONHASHSEED environment variable is set to 0, since hash randomization is enabled by default"),
        ),
        (
            names: [
                "-s",
            ],
            description: Some("Don’t add the user site-packages directory to sys.path"),
        ),
        (
            names: [
                "-S",
            ],
            description: Some("Disable the import of the module site and the site-dependent manipulations of sys.path that it entails"),
        ),
        (
            names: [
                "-u",
            ],
            description: Some("Force the stdout and stderr streams to be unbuffered. This option has no effect on the stdin stream"),
        ),
        (
            names: [
                "-v",
            ],
            description: Some("Print a message each time a module is initialized, showing the place (filename or built-in module) from which it is loaded"),
        ),
        (
            names: [
                "-W",
            ],
            description: Some("Warning control. Python’s warning machinery by default prints warning messages to sys.stderr"),
            arguments: [
                (
                    name: "",
                ),
            ],
        ),
        (
            names: [
                "-x",
            ],
            description: Some("Skip the first line of the source, allowing use of non-Unix forms of #!cmd. This is intended for a DOS specific hack only"),
        ),
        (
            names: [
                "-X",
            ],
            description: Some("Reserved for various implementation-specific options"),
            arguments: [
                (
                    name: "",
                    suggestions: [
                        (
                            name: "faulthandler",
                        ),
                        (
                            name: "showrefcount",
                        ),
                        (
                            name: "tracemalloc",
                        ),
                        (
                            name: "showalloccount",
                        ),
                        (
                            name: "importtime",
                        ),
                        (
                            name: "dev",
                        ),
                        (
                            name: "utf8",
                        ),
                        (
                            name: "pycache_prefix=PATH",
                        ),
                    ],
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "python script",
            generators: [
                (
                    has_custom: true,
                    has_dynamic_trigger: true,
                    has_dynamic_query_term: true,
                ),
            ],
            is_script: true,
        ),
    ],
    has_generate_spec: true,
)
