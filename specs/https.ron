(
    version: 1,
    command: "https",
    description: Some("HTTPie: command-line HTTP client for the API era"),
    options: [
        (
            names: [
                "--json",
                "-j",
            ],
            description: Some("Data items from the command line are serialized as a JSON object. The Content-Type and Accept headers are set to application/json"),
            exclusive_on: [
                "--form",
                "-f",
                "--multipart",
                "--boundary",
            ],
        ),
        (
            names: [
                "--form",
                "-f",
            ],
            description: Some("FData items from the command line are serialized as form fields.\nThe Content-Type is set to application/x-www-form-urlencoded (if not\nspecified). The presence of any file fields results in a\nmultipart/form-data request"),
            exclusive_on: [
                "--json",
                "-j",
                "--multipart",
                "--boundary",
            ],
        ),
        (
            names: [
                "--multipart",
            ],
            description: Some("Similar to --form, but always sends a multipart/form-data request (i.e., even without files)"),
            exclusive_on: [
                "--json",
                "-j",
                "--form",
                "-f",
                "--boundary",
            ],
        ),
        (
            names: [
                "--boundary",
            ],
            description: Some("Specify a custom boundary string for multipart/form-data requests. Has effect only together with --form"),
            exclusive_on: [
                "--json",
                "-j",
                "--multipart",
            ],
        ),
        (
            names: [
                "--compress",
                "-x",
            ],
            description: Some("Content compressed (encoded) with Deflate algorithm. The Content-Encoding header is set to deflate"),
        ),
        (
            names: [
                "--pretty",
            ],
            description: Some("Controls output processing. The value can be \"none\" to not prettify\nthe output (default for redirected output), \"all\" to apply both colors\nand formatting (default for terminal output), \"colors\", or \"format\""),
            arguments: [
                (
                    name: "",
                    suggestions: [
                        (
                            name: "all",
                        ),
                        (
                            name: "colors",
                        ),
                        (
                            name: "format",
                        ),
                        (
                            name: "none",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--style",
                "-s",
            ],
            arguments: [
                (
                    name: "STYLE",
                    suggestions: [
                        (
                            name: "abap",
                        ),
                        (
                            name: "algol",
                        ),
                        (
                            name: "algol_nu",
                        ),
                        (
                            name: "arduino",
                        ),
                        (
                            name: "auto",
                        ),
                        (
                            name: "autumn",
                        ),
                        (
                            name: "borland",
                        ),
                        (
                            name: "bw",
                        ),
                        (
                            name: "colorful",
                        ),
                        (
                            name: "default",
                        ),
                        (
                            name: "emacs",
                        ),
                        (
                            name: "friendly",
                        ),
                        (
                            name: "fruity",
                        ),
                        (
                            name: "igor",
                        ),
                        (
                            name: "inkpot",
                        ),
                        (
                            name: "lovelace",
                        ),
                        (
                            name: "manni",
                        ),
                        (
                            name: "monokai",
                        ),
                        (
                            name: "murphy",
                        ),
                        (
                            name: "native",
                        ),
                        (
                            name: "paraiso-dark",
                        ),
                        (
                            name: "paraiso-light",
                        ),
                        (
                            name: "pastie",
                        ),
                        (
                            name: "perldoc",
                        ),
                        (
                            name: "rainbow_dash",
                        ),
                        (
                            name: "rrt",
                        ),
                        (
                            name: "sas",
                        ),
                        (
                            name: "solarized",
                        ),
                        (
                            name: "solarized-dark",
                        ),
                        (
                            name: "solarized-light",
                        ),
                        (
                            name: "stata",
                        ),
                        (
                            name: "stata-dark",
                        ),
                        (
                            name: "stata-light",
                        ),
                        (
                            name: "tango",
                        ),
                        (
                            name: "trac",
                        ),
                        (
                            name: "vim",
                        ),
                        (
                            name: "vs",
                        ),
                        (
                            name: "xcode",
                        ),
                    ],
                    default: Some("auto"),
                ),
            ],
        ),
        (
            names: [
                "--unsorted",
            ],
            description: Some("Disables all sorting while formatting output"),
            exclusive_on: [
                "--sorted",
            ],
        ),
        (
            names: [
                "--sorted",
            ],
            description: Some("Re-enables all sorting options while formatting output"),
            exclusive_on: [
                "--unsorted",
            ],
        ),
        (
            names: [
                "--format-options",
            ],
            description: Some("Controls output formatting"),
            arguments: [
                (
                    name: "FORMAT_OPTIONS",
                    suggestions: [
                        (
                            name: "headers.sort:true",
                        ),
                        (
                            name: "json.format:true",
                        ),
                        (
                            name: "json.indent:4",
                        ),
                        (
                            name: "json.sort_keys:true",
                        ),
                    ],
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "--print",
                "-p",
            ],
            description: Some("String specifying what the output should contain"),
            arguments: [
                (
                    name: "WHAT",
                    suggestions: [
                        (
                            name: "H",
                            description: Some("Request headers"),
                        ),
                        (
                            name: "B",
                            description: Some("Request body"),
                        ),
                        (
                            name: "h",
                            description: Some("Response headers"),
                        ),
                        (
                            name: "b",
                            description: Some("Response body"),
                        ),
                    ],
                    default: Some("hb"),
                ),
            ],
        ),
        (
            names: [
                "--headers",
                "-h",
            ],
            description: Some("Print only the response headers. Shortcut for --print=h"),
        ),
        (
            names: [
                "--body",
                "-b",
            ],
            description: Some("Print only the response body. Shortcut for --print=b"),
        ),
        (
            names: [
                "--verbose",
                "-v",
            ],
            description: Some("Verbose output. Print the whole request as well as the response. Also print\nany intermediary requests/responses (such as redirects).\nIt's a shortcut for: --all --print=BHbh"),
        ),
        (
            names: [
                "--all",
            ],
            description: Some("By default, only the final request/response is shown. Use this flag to show\nany intermediary requests/responses as well. Intermediary requests include\nfollowed redirects (with --follow), the first unauthorized request when\nDigest auth is used (--auth=digest), etc"),
        ),
        (
            names: [
                "--history-print",
                "-P",
            ],
            description: Some("The same as --print, -p but applies only to intermediary requests/responses\n(such as redirects) when their inclusion is enabled with --all. If this\noptions is not specified, then they are formatted the same way as the final\nresponse"),
            arguments: [
                (
                    name: "WHAT",
                    suggestions: [
                        (
                            name: "H",
                            description: Some("Request headers"),
                        ),
                        (
                            name: "B",
                            description: Some("Request body"),
                        ),
                        (
                            name: "h",
                            description: Some("Response headers"),
                        ),
                        (
                            name: "b",
                            description: Some("Response body"),
                        ),
                    ],
                    default: Some("hb"),
                ),
            ],
        ),
        (
            names: [
                "--stream",
                "-S",
            ],
            description: Some("Always stream the response body by line, i.e., behave like `tail -f'"),
        ),
        (
            names: [
                "--output",
                "-o",
            ],
            description: Some("Save output to FILE instead of stdout. If --download is also set, then only\nthe response body is saved to FILE. Other parts of the HTTP exchange are\nprinted to stderr"),
            arguments: [
                (
                    name: "FILE",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--download",
                "-d",
            ],
            description: Some("Do not print the response body to stdout. Rather, download it and store it\nin a file. The filename is guessed unless specified with --output\n[filename]. This action is similar to the default behaviour of wget"),
        ),
        (
            names: [
                "--continue",
                "-c",
            ],
            description: Some("Resume an interrupted download. Note that the --output option needs to be specified as well"),
        ),
        (
            names: [
                "--quiet",
                "-q",
            ],
            description: Some("Do not print to stdout or stderr.\nstdout is still redirected if --output is specified.\nFlag doesn't affect behaviour of download beyond not printing to terminal"),
        ),
        (
            names: [
                "--session",
            ],
            description: Some("Create, or reuse and update a session. Within a session, custom headers,\nauth credential, as well as any cookies sent by the server persist between\nrequests"),
            arguments: [
                (
                    name: "SESSION_NAME_OR_PATH",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--session-read-only",
            ],
            description: Some("Create or read a session without updating it form the request/response exchange"),
            arguments: [
                (
                    name: "SESSION_NAME_OR_PATH",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--auth",
                "-a",
            ],
            description: Some("If only the username is provided (-a username), HTTPie will prompt for the password"),
            arguments: [
                (
                    name: "USER[:PASS]",
                ),
            ],
        ),
        (
            names: [
                "--auth-type",
                "-A",
            ],
            description: Some("The authentication mechanism to be used. Defaults to \"basic\""),
            arguments: [
                (
                    name: "",
                    suggestions: [
                        (
                            name: "basic",
                            description: Some("Basic HTTP auth"),
                        ),
                        (
                            name: "digest",
                            description: Some("Digest HTTP auth"),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--ignore-netrc",
            ],
            description: Some("Ignore credentials from .netrc"),
        ),
        (
            names: [
                "--offline",
            ],
            description: Some("Build the request and print it but don’t actually send it"),
        ),
        (
            names: [
                "--proxy",
            ],
            description: Some("String mapping protocol to the URL of the proxy\n(e.g. http:http://foo.bar:3128). You can specify multiple proxies with\ndifferent protocols. The environment variables $ALL_PROXY, $HTTP_PROXY,\nand $HTTPS_proxy are supported as well"),
            arguments: [
                (
                    name: "PROTOCOL:PROXY_URL",
                ),
            ],
        ),
        (
            names: [
                "--follow",
                "-F",
            ],
            description: Some("Follow 30x Location redirects"),
        ),
        (
            names: [
                "--max-redirects",
            ],
            description: Some("By default, requests have a limit of 30 redirects (works with --follow)"),
            arguments: [
                (
                    name: "MAX_REDIRECTS",
                ),
            ],
        ),
        (
            names: [
                "--max-headers",
            ],
            description: Some("The maximum number of response headers to be read before giving up (default 0, i.e., no limit)"),
            arguments: [
                (
                    name: "MAX_HEADERS",
                ),
            ],
        ),
        (
            names: [
                "--timeout",
            ],
            description: Some("The connection timeout of the request in seconds.\nThe default value is 0, i.e., there is no timeout limit"),
            arguments: [
                (
                    name: "SECONDS",
                ),
            ],
        ),
        (
            names: [
                "--check-status",
            ],
            description: Some("By default, HTTPie exits with 0 when no network or other fatal errors\noccur. This flag instructs HTTPie to also check the HTTP status code and\nexit with an error if the status indicates one"),
        ),
        (
            names: [
                "--path-as-is",
            ],
            description: Some("Bypass dot segment (/../ or /./) URL squashing"),
        ),
        (
            names: [
                "--chunked",
            ],
            description: Some("Enable streaming via chunked transfer encoding"),
        ),
        (
            names: [
                "--verify",
            ],
            description: Some("Set to \"no\" (or \"false\") to skip checking the host's SSL certificate.\nDefaults to \"yes\" (\"true\"). You can also pass the path to a CA_BUNDLE file\nfor private certs"),
            arguments: [
                (
                    name: "VERIFY",
                    suggestions: [
                        (
                            name: "no",
                        ),
                        (
                            name: "yes",
                        ),
                    ],
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--ssl",
            ],
            description: Some("The desired protocol version to use. This will default to\nSSL v2.3 which will negotiate the highest protocol that both\nthe server and your installation of OpenSSL support"),
            arguments: [
                (
                    name: "",
                    suggestions: [
                        (
                            name: "ssl2.3",
                        ),
                        (
                            name: "tls1",
                        ),
                        (
                            name: "tls1.1",
                        ),
                        (
                            name: "tls1.2",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--ciphers",
            ],
            description: Some("A string in the OpenSSL cipher list format"),
            arguments: [
                (
                    name: "",
                    default: Some("ECDHE+AESGCM:ECDHE+CHACHA20:DHE+AESGCM:DHE+CHACHA20:ECDH+AESGCM:DH+AESGCM:ECDH+AES:DH+AES:RSA+AESGCM:RSA+AES:!aNULL:!eNULL:!MD5:!DSS"),
                ),
            ],
        ),
        (
            names: [
                "--cert",
            ],
            description: Some("You can specify a local cert to use as client side SSL certificate.\nThis file may either contain both private key and certificate or you may\nspecify --cert-key separately"),
            arguments: [
                (
                    name: "",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--cert-key",
            ],
            description: Some("The private key to use with SSL. Only needed if --cert is given and the certificate file does not contain the private key"),
            arguments: [
                (
                    name: "",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--ignore-stdin",
                "-I",
            ],
            description: Some("Do not attempt to read stdin"),
        ),
        (
            names: [
                "--help",
            ],
            description: Some("Show the help message and exit"),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Show version and exit"),
        ),
        (
            names: [
                "--traceback",
            ],
            description: Some("Prints the exception traceback should one occur"),
        ),
        (
            names: [
                "--default-scheme",
            ],
            description: Some("The default scheme to use if not specified in the URL"),
            arguments: [
                (
                    name: "DEFAULT_SCHEME",
                ),
            ],
        ),
        (
            names: [
                "--debug",
            ],
            description: Some("Prints the exception traceback should one occur, as well as other\ninformation useful for debugging HTTPie itself and for reporting bugs"),
        ),
    ],
    arguments: [
        (
            name: "METHOD",
            description: Some("The HTTP method to be used for the request (GET, POST, PUT, DELETE, ...)"),
            suggestions: [
                (
                    name: "GET",
                ),
                (
                    name: "POST",
                ),
                (
                    name: "PUT",
                ),
                (
                    name: "DELETE",
                ),
                (
                    name: "HEAD",
                ),
            ],
            optional: true,
            default: Some("GET"),
        ),
        (
            name: "URL",
            description: Some("The scheme defaults to 'http://' if the URL does not include one"),
        ),
        (
            name: "REQUEST_ITEM",
            description: Some("Optional key-value pairs to be included in the request. The separator used determines the type"),
            optional: true,
            variadic: true,
        ),
    ],
)
