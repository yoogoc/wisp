                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "--headers",
                "-h",
            ],
            description: Some("Print only the response headers. Shortcut for --print=h"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "--body",
                "-b",
            ],
            description: Some("Print only the response body. Shortcut for --print=b"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "--verbose",
                "-v",
            ],
            description: Some("Verbose output. Print the whole request as well as the response. Also print\nany intermediary requests/responses (such as redirects).\nIt\'s a shortcut for: --all --print=BHbh"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "--all",
            ],
            description: Some("By default, only the final request/response is shown. Use this flag to show\nany intermediary requests/responses as well. Intermediary requests include\nfollowed redirects (with --follow), the first unauthorized request when\nDigest auth is used (--auth=digest), etc"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "--history-print",
                "-P",
            ],
            description: Some("The same as --print, -p but applies only to intermediary requests/responses\n(such as redirects) when their inclusion is enabled with --all. If this\noptions is not specified, then they are formatted the same way as the final\nresponse"),
            takes_value: true,
            arguments: [
                (
                    name: "WHAT",
                    source: Static([
                        "H",
                        "B",
                        "h",
                        "b",
                    ]),
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "--stream",
                "-S",
            ],
            description: Some("Always stream the response body by line, i.e., behave like `tail -f\'"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "--output",
                "-o",
            ],
            description: Some("Save output to FILE instead of stdout. If --download is also set, then only\nthe response body is saved to FILE. Other parts of the HTTP exchange are\nprinted to stderr"),
            takes_value: true,
            arguments: [
                (
                    name: "FILE",
                    source: Files,
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
