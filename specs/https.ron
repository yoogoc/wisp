        ),
        (
            names: [
                "--download",
                "-d",
            ],
            description: Some("Do not print the response body to stdout. Rather, download it and store it\nin a file. The filename is guessed unless specified with --output\n[filename]. This action is similar to the default behaviour of wget"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "--continue",
                "-c",
            ],
            description: Some("Resume an interrupted download. Note that the --output option needs to be specified as well"),
