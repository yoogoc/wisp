            arguments: [],
        ),
        (
            names: [
                "--quiet",
                "-q",
            ],
            description: Some("Do not print to stdout or stderr.\nstdout is still redirected if --output is specified.\nFlag doesn\'t affect behaviour of download beyond not printing to terminal"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "--session",
            ],
            description: Some("Create, or reuse and update a session. Within a session, custom headers,\nauth credential, as well as any cookies sent by the server persist between\nrequests"),
