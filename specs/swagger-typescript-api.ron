(
    version: 1,
    command: "swagger-typescript-api",
    description: Some("Generate api via swagger scheme"),
    subcommands: [
        (
            name: "generate-templates",
            aliases: [],
            description: Some("Generate \".ejs\" templates needed for generate api"),
            subcommands: [],
            options: [
                (
                    names: [
                        "--output",
                        "-o",
                    ],
                    description: Some("Output path of generated templates"),
                    takes_value: true,
                    arguments: [
                        (
                            name: "Path",
                            source: Directories,
                            optional: false,
                            variadic: false,
                            imported_generator: None,
                        ),
                    ],
                ),
                (
                    names: [
                        "--modular",
                        "-m",
                    ],
                    description: Some("Generate templates needed to separate files for http client, data contracts, and routes"),
                    takes_value: false,
                    arguments: [],
                ),
                (
                    names: [
                        "--http-client",
                    ],
                    description: Some("Http client type"),
                    takes_value: true,
                    arguments: [
                        (
                            name: "Http client",
                            source: Static([
                                "fetch",
                                "axios",
                            ]),
                            optional: false,
                            variadic: false,
                            imported_generator: None,
                        ),
                    ],
                ),
                (
                    names: [
                        "--clean-output",
                        "-c",
                    ],
                    description: Some("Clean output folder before generate template"),
                    takes_value: false,
                    arguments: [],
                ),
                (
                    names: [
                        "--rewrite",
                        "-r",
                    ],
                    description: Some("Rewrite content in existing templates"),
                    takes_value: false,
                    arguments: [],
                ),
            ],
            arguments: [],
            load_spec: None,
        ),
    ],
    options: [
        (
            names: [
                "--version",
                "-v",
            ],
            description: Some("Output the current version"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "--path",
                "-p",
            ],
            description: Some("Path/url to swagger scheme"),
            takes_value: true,
            arguments: [
                (
                    name: "Path",
                    source: Files,
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "--output",
                "-o",
            ],
            description: Some("Output path of typescript api file (default: \"./\")"),
            takes_value: true,
            arguments: [
                (
                    name: "Path",
                    source: Directories,
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "--name",
                "-n",
            ],
            description: Some("Name of output typescript api file (default: \"Api.ts\")"),
            takes_value: true,
            arguments: [
                (
                    name: "Name",
                    source: Files,
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "--templates",
                "-t",
            ],
            description: Some("Path to folder containing templates"),
            takes_value: true,
            arguments: [
                (
                    name: "Path",
                    source: Directories,
                    optional: false,
                    variadic: false,
                    imported_generator: None,
                ),
            ],
        ),
        (
            names: [
                "--default-as-success",
