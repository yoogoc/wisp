(
    version: 1,
    command: "xed",
    description: Some("Xcode text editor invocation tool"),
    options: [
        (
            names: [
                "--launch",
                "-x",
            ],
            description: Some("Launches Xcode, opening a new empty unsaved file"),
        ),
        (
            names: [
                "--create",
                "-c",
            ],
            description: Some("Creates any non-existent files in the file list. If used without --launch, standard input will be read and piped to the last file created"),
        ),
        (
            names: [
                "--wait",
                "-w",
            ],
            description: Some("Wait for the files to be closed before exiting. xed will idle and will only terminate when all files are closed"),
        ),
        (
            names: [
                "--line",
                "-l",
            ],
            description: Some("Selects the given line in the last file opened"),
            arguments: [
                (
                    name: "number",
                    description: Some("The line number to select"),
                ),
            ],
        ),
        (
            names: [
                "--background",
                "-b",
            ],
            description: Some("Opens Xcode without activating it; the process that invoked xed remains in front"),
        ),
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for xed"),
            exclusive_on: [
                "-x",
                "-c",
                "-w",
                "-l",
                "-b",
                "-v",
            ],
        ),
        (
            names: [
                "--version",
                "-v",
            ],
            description: Some("Prints the version number of xed"),
        ),
    ],
    arguments: [
        (
            name: "file",
            description: Some("A list of file paths. If no files are passed, then standard input will       be read and piped into a new untitled document"),
            template: [
                FilePaths,
            ],
            optional: true,
            variadic: true,
        ),
    ],
)
