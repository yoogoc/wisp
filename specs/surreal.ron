(
    version: 1,
    command: "surreal",
    description: Some("SurrealDB is the ultimate cloud database for tomorrow's applications - https://surrealdb.com/"),
    subcommands: [
        (
            name: "help",
            description: Some("Print this message or the help of the given subcommand(s)"),
            arguments: [
                (
                    name: "command",
                    description: Some("Command to get help for"),
                    template: [
                        Help,
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "start",
            description: Some("Start the database server"),
            options: [
                (
                    names: [
                        "--",
                    ],
                    description: Some("Everything after this is an argument"),
                ),
                (
                    names: [
                        "--addr",
                    ],
                    description: Some("The allowed networks for master authentication [env: ADDR=] [default: 127.0.0.1/32]"),
                    arguments: [
                        (
                            name: "addr",
                            description: Some("The allowed networks for master authentication [env: ADDR=] [default: 127.0.0.1/32]"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--bind",
                        "-b",
                    ],
                    description: Some("The hostname or ip address to listen for connections on [env: BIND=] [default: 0.0.0.0:8000]"),
                    arguments: [
                        (
                            name: "bind",
                            description: Some("The hostname or ip address to listen for connections on [env: BIND=] [default: 0.0.0.0:8000]"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--key",
                        "-k",
                    ],
                    description: Some("Encryption key to use for on-disk encryption [env: KEY=]"),
                    arguments: [
                        (
                            name: "key",
                            description: Some("Encryption key to use for on-disk encryption [env: KEY=]"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--kvs-ca",
                    ],
                    description: Some("Path to the CA file used when connecting to the remote KV store [env: KVS_CA=]"),
                    arguments: [
                        (
                            name: "kvs-ca",
                            description: Some("Path to the CA file used when connecting to the remote KV store [env: KVS_CA=]"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--kvs-crt",
                    ],
                    description: Some("Path to the certificate file used when connecting to the remote KV store [env: KVS_CRT=]"),
                    arguments: [
                        (
                            name: "kvs-crt",
                            description: Some("Path to the certificate file used when connecting to the remote KV store [env: KVS_CRT=]"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--kvs-key",
                    ],
                    description: Some("Path to the private key file used when connecting to the remote KV store [env: KVS_KEY=]"),
                    arguments: [
                        (
                            name: "kvs-key",
                            description: Some("Path to the private key file used when connecting to the remote KV store [env: KVS_KEY=]"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--log",
                        "-l",
                    ],
                    description: Some("The logging level for the database server [env: LOG=] [default: info] [possible values: warn, info, debug, trace, full]"),
                    arguments: [
                        (
                            name: "log",
                            description: Some("The logging level for the database server [env: LOG=] [default: info] [possible values: warn, info, debug, trace, full]"),
                            suggestions: [
                                (
                                    name: "warn",
                                ),
                                (
                                    name: "info",
                                ),
                                (
                                    name: "debug",
                                ),
                                (
                                    name: "trace",
                                ),
                                (
                                    name: "full",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--pass",
                        "-p",
                    ],
                    description: Some("The master password for the database [env: PASS=]"),
                    arguments: [
                        (
                            name: "pass",
                            description: Some("The master password for the database [env: PASS=]"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--strict",
                        "-s",
                    ],
                    description: Some("Whether strict mode is enabled on this database instance [env: STRICT=]"),
                    arguments: [
                        (
                            name: "strict",
                            description: Some("Whether strict mode is enabled on this database instance [env: STRICT=]"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--user",
                        "-u",
                    ],
                    description: Some("The master username for the database [env: USER=] [default: root]"),
                    arguments: [
                        (
                            name: "user",
                            description: Some("The master username for the database [env: USER=] [default: root]"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--web-crt",
                    ],
                    description: Some("Path to the certificate file for encrypted client connections [env: WEB_CRT=]"),
                    arguments: [
                        (
                            name: "web-crt",
                            description: Some("Path to the certificate file for encrypted client connections [env: WEB_CRT=]"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--web-key",
                    ],
                    description: Some("Path to the private key file for encrypted client connections [env: WEB_KEY=]"),
                    arguments: [
                        (
                            name: "web-key",
                            description: Some("Path to the private key file for encrypted client connections [env: WEB_KEY=]"),
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "path",
                    description: Some("Database path used for storing data [env: DB_PATH=] [default: memory]"),
                    optional: true,
                ),
            ],
        ),
