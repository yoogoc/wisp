(
    version: 1,
    command: "spring",
    description: Some("The Spring Boot CLI is a command line tool that you can use to bootstrap a new project from start.spring.io or encode a password"),
    subcommands: [
        (
            name: "init",
            description: Some("Initialize a new project using Spring Initializr"),
            options: [
                (
                    names: [
                        "-a",
                        "---artifact-id",
                    ],
                    description: Some("Project coordinates"),
                    arguments: [
                        (
                            name: "Name",
                        ),
                    ],
                ),
                (
                    names: [
                        "-b",
                        "--boot-version",
                    ],
                    description: Some("Spring Boot version"),
                    arguments: [
                        (
                            name: "Version",
                            generators: [
                                (
                                    has_custom: true,
                                    cache: Some((
                                        ttl_ms: Some(86400000),
                                        stale_while_revalidate: true,
                                    )),
                                ),
                            ],
                            debounce: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--build",
                    ],
                    description: Some("Build system to use"),
                    arguments: [
                        (
                            name: "System",
                            suggestions: [
                                (
                                    name: "maven",
                                ),
                                (
                                    name: "gradle",
                                ),
                            ],
                            default: Some("maven"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-d",
                        "--dependencies",
                    ],
                    description: Some("Comma-separated list of dependency identifiers to include in the generated project"),
                    arguments: [
                        (
                            name: "Dependencies",
                            generators: [
                                (
                                    has_custom: true,
                                    has_dynamic_trigger: true,
                                    has_dynamic_query_term: true,
                                    cache: Some((
                                        ttl_ms: Some(86400000),
                                        stale_while_revalidate: true,
                                    )),
                                ),
                            ],
                            variadic: true,
                            debounce: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--description",
                    ],
                    description: Some("Project description"),
                    arguments: [
                        (
                            name: "description",
                        ),
                    ],
                    presentation: (
                        insert_value: Some("--description '{cursor}'"),
                    ),
                ),
                (
                    names: [
                        "-f",
                        "--force",
                    ],
                    description: Some("Force overwrite of existing files"),
                    presentation: (
                        dangerous: true,
                    ),
                ),
                (
                    names: [
                        "--format",
                    ],
                    description: Some("Format of the generated content"),
                    arguments: [
                        (
                            name: "Format",
                            suggestions: [
                                (
                                    name: "build",
                                ),
                                (
                                    name: "project",
                                ),
                            ],
                            default: Some("build"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-g",
                        "--group-id",
                    ],
                    description: Some("Project coordinates"),
                    arguments: [
                        (
                            name: "Group ID",
                        ),
                    ],
                ),
                (
                    names: [
                        "-j",
                        "--java-version",
                    ],
                    description: Some("Language level"),
                    arguments: [
                        (
                            name: "Version",
                            generators: [
                                (
                                    has_custom: true,
                                    cache: Some((
                                        ttl_ms: Some(86400000),
                                        stale_while_revalidate: true,
                                    )),
                                ),
                            ],
                            debounce: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--list",
                    ],
                    description: Some("List the capabilities of the service"),
                ),
                (
                    names: [
                        "-n",
                        "--name",
                    ],
                    description: Some("Project name"),
                    arguments: [
                        (
                            name: "Name",
                        ),
                    ],
                ),
                (
                    names: [
                        "-p",
                        "--packaging",
                    ],
                    description: Some("Project packaging"),
                    arguments: [
                        (
                            name: "Packaging",
                            suggestions: [
                                (
                                    name: "jar",
                                ),
                                (
                                    name: "war",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--package-name",
                    ],
                    description: Some("Package name"),
                    arguments: [
                        (
                            name: "Name",
                        ),
                    ],
                ),
                (
                    names: [
                        "-t",
                        "--type",
                    ],
                    description: Some("Project type"),
                    arguments: [
                        (
                            name: "Type",
                            suggestions: [
                                (
                                    name: "gradle-build",
                                    description: Some("Generate a Gradle build file"),
                                ),
                                (
                                    name: "gradle-project",
                                    description: Some("Generate a Gradle based project archive using the Groovy DSL"),
                                ),
                                (
                                    name: "gradle-project-kotlin",
                                    description: Some("Generate a Gradle based project archive using the Kotlin DSL"),
                                ),
                                (
                                    name: "maven-build",
                                    description: Some("Generate a Maven pom.xml"),
                                ),
                                (
                                    name: "maven-project",
                                    description: Some("Generate a Maven based project archive"),
                                ),
                            ],
                            default: Some("gradle-project"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--target",
                    ],
                    description: Some("URL of the service to use"),
                    arguments: [
                        (
                            name: "URL",
                            default: Some("https://start.spring.io"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-v",
                        "--version",
                    ],
                    description: Some("Project version"),
                    arguments: [
                        (
                            name: "Version",
                        ),
                    ],
                ),
                (
                    names: [
                        "-x",
                        "--extract",
                    ],
                    description: Some("Extract the project archive. Inferred if a location is specified without an extension"),
                ),
            ],
        ),
        (
            name: "encodepassword",
            description: Some("Encode a password for use with Spring Security"),
            options: [
                (
                    names: [
                        "-a",
                        "--algorithm",
                    ],
                    description: Some("The algorithm to use"),
                    arguments: [
                        (
                            name: "Algorithm",
                            suggestions: [
                                (
                                    name: "default",
                                ),
                                (
                                    name: "bcrypt",
                                ),
                                (
                                    name: "pbkdf2",
                                ),
                            ],
                            default: Some("default"),
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "Password",
                ),
            ],
        ),
        (
            name: "shell",
            description: Some("Start a nested shell"),
        ),
        (
            name: "help",
            description: Some("Show help for other commands"),
            arguments: [
                (
                    name: "Command",
                    template: [
                        Help,
                    ],
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--help",
            ],
            description: Some("Show help for spring"),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Get spring CLI version"),
        ),
        (
            names: [
                "--debug",
            ],
            description: Some("Print additional status information for the command you are running"),
            persistent: true,
        ),
    ],
    presentation: (
        icon: Some("https://start.spring.io/images/icon-48x48.png"),
    ),
)
