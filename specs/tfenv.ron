(
    version: 1,
    command: "tfenv",
    description: Some("Terraform version manager"),
    subcommands: [
        (
            name: "install",
            description: Some("Install a specific version of Terraform"),
            arguments: [
                (
                    name: "version",
                    description: Some("Possible Terraform Version"),
                    suggestions: [
                        (
                            name: "latest",
                        ),
                        (
                            name: "min-required",
                        ),
                    ],
                    generators: [
                        (
                            script: [
                                "tfenv",
                                "list-remote",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "use",
            description: Some("Switch to a version to use"),
            arguments: [
                (
                    name: "version",
                    description: Some("Installed Terraform Version"),
                    generators: [
                        (
                            script: [
                                "tfenv",
                                "list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "uninstall",
            description: Some("Uninstall a specific version of Terraform"),
            arguments: [
                (
                    name: "version",
                    description: Some("Installed Terraform Version"),
                    generators: [
                        (
                            script: [
                                "tfenv",
                                "list",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "list",
            description: Some("List all installed versions"),
        ),
        (
            name: "list-remote",
            description: Some("List all installable versions"),
        ),
        (
            name: "version-name",
            description: Some("Print current version"),
        ),
        (
            name: "init",
            description: Some("Update environment to use tfenv correctly"),
        ),
    ],
    options: [
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("View your current tfenv version"),
        ),
        (
            names: [
                "--help",
            ],
            description: Some("View commands"),
        ),
    ],
)
