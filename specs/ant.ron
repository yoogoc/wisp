(
    version: 1,
    command: "ant",
    description: Some("A software tool for automating software build processes"),
    options: [
        (
            names: [
                "--help",
                "-help",
                "-h",
            ],
            description: Some("Show help for ant"),
        ),
        (
            names: [
                "--noconfig",
            ],
            description: Some("Suppress sourcing of /etc/ant.conf, $HOME/.ant/ant.conf, and $HOME/.antrc configuration files"),
        ),
        (
            names: [
                "--usejikes",
            ],
            description: Some("Enable use of jikes by default, unless set explicitly in configuration files"),
        ),
        (
            names: [
                "--execdebug",
            ],
            description: Some("Print ant exec line generated by this launch script"),
        ),
        (
            names: [
                "-projecthelp",
                "-p",
            ],
            description: Some("Print project help information and exit"),
        ),
        (
            names: [
                "-version",
            ],
            description: Some("Print the version information and exit"),
        ),
        (
            names: [
                "-diagnostics",
            ],
            description: Some("Print information that might be helpful to diagnose or report problems and exit"),
        ),
        (
            names: [
                "-quiet",
                "-q",
            ],
            description: Some("Be extra quiet"),
        ),
        (
            names: [
                "-silent",
                "-S",
            ],
            description: Some("Print nothing but task outputs and build failures"),
        ),
        (
            names: [
                "-verbose",
                "-v",
            ],
            description: Some("Be extra verbose"),
        ),
        (
            names: [
                "-debug",
                "-d",
            ],
            description: Some("Print debugging information"),
        ),
        (
            names: [
                "-emacs",
                "-e",
            ],
            description: Some("Produce logging information without adornments"),
        ),
        (
            names: [
                "-lib",
            ],
            description: Some("Specifies a path to search for jars and classes"),
            arguments: [
                (
                    name: "path",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-logfile",
                "-l",
            ],
            description: Some("Use given file for log"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-logger",
            ],
            description: Some("The class which is to perform logging"),
            arguments: [
                (
                    name: "classname",
                ),
            ],
        ),
        (
            names: [
                "-listener",
            ],
            description: Some("Add an instance of class as a project listener"),
            arguments: [
                (
                    name: "classname",
                ),
            ],
        ),
        (
            names: [
                "-noinput",
            ],
            description: Some("Do not allow interactive input"),
        ),
        (
            names: [
                "-buildfile",
                "-file",
                "-f",
            ],
            description: Some("Use given buildfile"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-keep-going",
                "-k",
            ],
            description: Some("Execute all targets that do not depend on failed target(s)"),
        ),
        (
            names: [
                "-propertyfile",
            ],
            description: Some("Load all properties from file with -D properties taking precedence"),
            arguments: [
                (
                    name: "name",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-inputhandler",
            ],
            description: Some("The class which will handle input requests"),
            arguments: [
                (
                    name: "class",
                ),
            ],
        ),
        (
            names: [
                "-find",
                "-s",
            ],
            description: Some("Search for buildfile towards the root of the filesystem and use it"),
            arguments: [
                (
                    name: "file",
                ),
            ],
        ),
        (
            names: [
                "-nice",
            ],
            description: Some("A niceness value for the main thread"),
            arguments: [
                (
                    name: "number",
                ),
            ],
        ),
        (
            names: [
                "-nouserlib",
            ],
            description: Some("Run ant without using the jar files from ${user.home}/.ant/lib"),
        ),
        (
            names: [
                "-noclasspath",
            ],
            description: Some("Run ant without using CLASSPATH"),
        ),
        (
            names: [
                "-autoproxy",
            ],
            description: Some("Java1.5+: use the OS proxy settings"),
        ),
        (
            names: [
                "-main",
            ],
            description: Some("Override Ant's normal entry point"),
            arguments: [
                (
                    name: "class",
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "target",
            generators: [
                (
                    script: [
                        "bash",
                        "-c",
                        "command ant -p | grep -i '^\\s' | tr -d ' '",
                    ],
                    has_post_process: true,
                    cache: Some((
                        by_directory: true,
                        stale_while_revalidate: true,
                    )),
                ),
            ],
            optional: true,
            variadic: true,
        ),
    ],
    parser_directives: Some((
        flags_are_posix_noncompliant: true,
    )),
)
