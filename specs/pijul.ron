                    names: [
                        "-u",
                        "--untracked",
                    ],
                    description: Some("Include the untracked files"),
                ),
            ],
            arguments: [
                (
                    name: "PREFIXES",
                    description: Some("Only diff those paths (files or directories). If missing, diff the entire repository"),
                ),
            ],
        ),
