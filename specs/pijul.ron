(
    version: 1,
    command: "pijul",
    description: Some("A distributed version control system that is at the same time theoretically sound, fast and easy to learn and use"),
    subcommands: [
        (
            name: "add",
            description: Some("Adds a path to the tree"),
            options: [
                (
                    names: [
                        "-f",
                        "--force",
                    ],
                ),
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Print help information"),
                ),
                (
                    names: [
                        "-r",
                        "--recursive",
                    ],
                ),
            ],
            arguments: [
                (
                    name: "PATHS",
                    description: Some("Paths to add to the internal tree"),
                ),
            ],
        ),
        (
            name: "apply",
            description: Some("Applies changes to a channel"),
            options: [
                (
                    names: [
                        "--channel",
                    ],
                    description: Some("Apply change to this channel"),
                    arguments: [
                        (
                            name: "CHANNEL",
                        ),
                    ],
                ),
                (
                    names: [
                        "--deps-only",
                    ],
                    description: Some("Only apply the dependencies of the change, not the change itself. Only applicable for a single change"),
                ),
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Print help information"),
                ),
                (
                    names: [
                        "--repository",
                    ],
                    description: Some("Set the repository where this command should run. Defaults to the first ancestor of the current directory that contains a .pijul directory"),
                    arguments: [
                        (
                            name: "REPO_PATH",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "CHANGE",
                    description: Some("The change that need to be applied. If this value is missing, read the change in text format on the standard input"),
                ),
            ],
        ),
        (
            name: "archive",
            description: Some("Creates an archive of the repository"),
            options: [
                (
                    names: [
                        "--change",
                    ],
                    description: Some("Apply these changes after switching to the channel"),
                    arguments: [
                        (
                            name: "CHANGE",
                        ),
                    ],
                ),
                (
                    names: [
                        "--channel",
                    ],
                    description: Some("Use this channel, instead of the current channel"),
                    arguments: [
                        (
                            name: "CHANNEL",
                        ),
                    ],
                ),
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Print help information"),
                ),
                (
                    names: [
                        "-k",
                    ],
                    description: Some("Do not check certificates (HTTPS remotes only, this option might be dangerous)"),
                ),
                (
                    names: [
                        "-o",
                    ],
                    description: Some("Name of the output file"),
                    arguments: [
                        (
                            name: "NAME",
                        ),
                    ],
                ),
                (
                    names: [
                        "--prefix",
                    ],
                    description: Some("Append this path in front of each path inside the archive"),
                    arguments: [
                        (
                            name: "PREFIX",
                        ),
                    ],
                ),
                (
                    names: [
                        "--remote",
                    ],
                    description: Some("Ask the remote to send an archive"),
                    arguments: [
                        (
                            name: "REMOTE",
                        ),
                    ],
                ),
                (
                    names: [
                        "--repository",
                    ],
                    description: Some("Set the repository where this command should run. Defaults to the first ancestor of the current directory that contains a .pijul directory"),
                    arguments: [
                        (
                            name: "REPO_PATH",
                        ),
                    ],
                ),
                (
                    names: [
                        "--state",
                    ],
                    description: Some("Archive in this state"),
                    arguments: [
                        (
                            name: "STATE",
                        ),
                    ],
                ),
                (
                    names: [
                        "--umask",
                    ],
                    description: Some("Append this path in front of each path inside the archive"),
                    arguments: [
                        (
                            name: "UMASK",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "change",
            description: Some("Shows information about a particular change"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Print help information"),
                ),
                (
                    names: [
                        "--repository",
                    ],
                    description: Some("Use the repository at PATH instead of the current directory"),
                    arguments: [
                        (
                            name: "PATH",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "HASH",
                    description: Some("The hash of the change to show, or an unambiguous prefix thereof"),
                ),
            ],
        ),
        (
            name: "channel",
            description: Some("Manages different channels"),
            subcommands: [
                (
                    name: "delete",
                    description: Some("Delete a channel. The channel must not be the current channel"),
