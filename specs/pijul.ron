                ),
                (
                    name: "SALT",
                ),
            ],
        ),
        (
            name: "credit",
            description: Some("Shows which change last affected each line of the given file(s)"),
            options: [
                (
                    names: [
                        "--channel",
                    ],
                    description: Some("Use this channel instead of the current channel"),
                    arguments: [
                        (
                            name: "CHANNEL",
