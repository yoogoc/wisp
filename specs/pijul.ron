                    arguments: [
                        (
                            name: "FROM",
                        ),
                        (
                            name: "TO",
                        ),
                    ],
                ),
                (
                    name: "switch",
                    description: Some("Switch to a channel. There must not be unrecorded changes in the working copy"),
                ),
