(
    version: 1,
    command: "pgcli",
    options: [
        (
            names: [
                "-h",
                "--host",
            ],
            description: Some("Host address of the postgres database"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            names: [
                "-p",
                "--port",
            ],
            description: Some("Port number at which the postgres instance is listening"),
            arguments: [
                (
                    name: "integer",
                ),
            ],
        ),
        (
            names: [
                "-U",
                "--username",
            ],
            description: Some("Username to connect to the postgres database"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            names: [
                "-u",
                "--user",
            ],
            description: Some("Username to connect to the postgres database"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            names: [
                "-W",
                "--password",
            ],
            description: Some("Force password prompt"),
        ),
        (
            names: [
                "-w",
                "--no-password",
            ],
            description: Some("Never prompt for password"),
        ),
        (
            names: [
                "--single-connection",
            ],
            description: Some("Do not use a separate connection for completions"),
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Version of pgcli"),
        ),
        (
            names: [
                "-d",
                "--dbname",
            ],
            description: Some("Database name to connect to"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            names: [
                "--pgclirc",
            ],
            description: Some("Location of pgclirc file"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                    suggest_current_token: true,
                ),
            ],
        ),
        (
            names: [
                "-D",
                "--dsn",
            ],
            description: Some("Use DSN configured into the [alias_dsn] section of pgclirc file"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            names: [
                "--list-dsn",
            ],
            description: Some("List of DSN configured into the [alias_dsn] section of pgclirc file"),
        ),
        (
            names: [
                "--row-limit",
            ],
            description: Some("Set threshold for row limit prompt. Use 0 to disable prompt"),
            arguments: [
                (
                    name: "integer",
                ),
            ],
        ),
        (
            names: [
                "--less-chatty",
            ],
            description: Some("Skip intro on startup and goodbye on exit"),
        ),
        (
            names: [
                "--prompt",
            ],
            description: Some("Prompt format (Default: \"\\u@\\h:\\d> \")"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            names: [
                "--prompt-dsn",
            ],
            description: Some("Prompt format for connections using DSN aliases (Default: \"\\u@\\h:\\d> \")"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            names: [
                "-l",
                "--list",
            ],
            description: Some("List available databases, then exit"),
        ),
        (
            names: [
                "--auto-vertical-output",
            ],
            description: Some("Automatically switch to vertical output mode if the result is wider than the terminal width"),
        ),
        (
            names: [
                "--warn",
            ],
            description: Some("Warn before running a destructive query"),
            arguments: [
                (
                    name: "choice",
                    suggestions: [
                        (
                            name: "all",
                        ),
                        (
                            name: "moderate",
                        ),
                        (
                            name: "off",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--ssh-tunnel",
            ],
            description: Some("Open an SSH tunnel to the given address and connect to the database from it"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            names: [
                "--help",
            ],
            description: Some("Show this message and exit"),
        ),
    ],
    arguments: [
        (
            name: "database_name or db_url",
        ),
    ],
)
