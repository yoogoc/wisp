                (
                    names: [
                        "-v",
                        "--verbose",
                    ],
                    description: Some("Use once for info, twice for debug, three times for trace"),
                ),
                (
                    names: [
                        "-q",
                        "--quiet",
                    ],
                    description: Some("Do not display progress bar"),
                ),
            ],
            arguments: [
                (
                    name: "regex",
                    description: Some("List only packages matching this regular expression"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "package",
            description: Some("Low-level conda package utility. (EXPERIMENTAL)"),
            options: [
                (
                    names: [
                        "-w",
                        "--which",
                    ],
                    description: Some("Given some PATH print which conda package the file came from"),
                    arguments: [
