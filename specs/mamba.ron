(
    version: 1,
    command: "mamba",
    description: Some("Mamba is a reimplementation of the conda package manager in C++"),
    subcommands: [
        (
            name: "activate",
            description: Some("Activate an environment"),
            options: [
                (
                    names: [
                        "--stack",
                    ],
                    description: Some("Stack the environment being activated on top of the previous active environment"),
                    exclusive_on: [
                        "--no-stack",
                    ],
                ),
                (
                    names: [
                        "--no-stack",
                    ],
                    description: Some("Do not stack the environment. Overrides 'auto_stack' setting"),
                    exclusive_on: [
                        "--stack",
                    ],
                ),
            ],
            arguments: [
                (
                    name: "environment",
                    generators: [
                        (
                            script: [
                                "conda",
                                "env",
                                "list",
                            ],
                            script_timeout_ms: Some(10000),
                            has_post_process: true,
                            cache: Some((
                                stale_while_revalidate: true,
                            )),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "deactivate",
            description: Some("Deactivate an environment"),
        ),
        (
            name: "clean",
            description: Some("Remove unused packages and caches"),
            options: [
                (
                    names: [
                        "-a",
                        "--all",
                    ],
                    description: Some("Remove index cache, lock files, unused cache packages, and tarballs"),
                ),
                (
                    names: [
                        "-i",
                        "--index-cache",
                    ],
                    description: Some("Remove index cache"),
                ),
                (
                    names: [
                        "-p",
                        "--packages",
                    ],
                    description: Some("Remove unused packages from writable package caches"),
                ),
                (
                    names: [
                        "-t",
                        "--tarballs",
                    ],
                    description: Some("Remove cached package tarballs"),
                ),
                (
                    names: [
                        "-f",
                        "--force-pkgs-dirs",
                    ],
                    description: Some("Remove all writable package caches"),
                ),
                (
                    names: [
                        "-l",
                        "--logfiles",
                    ],
                    description: Some("Remove log files"),
                ),
                (
                    names: [
                        "--locks",
                    ],
                    description: Some("Remove lock files"),
                ),
                (
                    names: [
                        "-c",
                        "--tempfiles",
                    ],
                    description: Some("Remove temporary files that could not be deleted earlier due to being in-use. Argument is path(s) to prefix(es) where files should be found and removed"),
                    arguments: [
                        (
                            name: "file",
                            template: [
                                FilePaths,
                            ],
                            variadic: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "-d",
                        "--dry-run",
                    ],
                    description: Some("Only display what would have been done"),
                ),
                (
                    names: [
                        "--json",
                    ],
                    description: Some("Report all output as json. Suitable for using conda programmatically"),
                ),
                (
                    names: [
                        "-q",
                        "--quiet",
                    ],
                    description: Some("Do not display progress bar"),
                ),
                (
                    names: [
                        "-v",
                        "--verbose",
                    ],
                    description: Some("Can be used multiple times. Once for INFO, twice for DEBUG, three times for TRACE"),
                    repeat: Many,
                ),
                (
                    names: [
                        "-y",
                        "--yes",
                    ],
                    description: Some("Do not ask for confirmation"),
                ),
            ],
        ),
        (
            name: "compare",
            description: Some("Compare packages between conda environments"),
            options: [
                (
                    names: [
                        "-n",
                        "--name",
                    ],
                    description: Some("Name of environment"),
                    arguments: [
                        (
                            name: "environment",
                        ),
                    ],
                    presentation: (
                        insert_value: Some("-n '{cursor}'"),
                    ),
                ),
                (
                    names: [
                        "-p",
                        "--prefix",
                    ],
                    description: Some("Full path to environment location (i.e. prefix)"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Show this help message and exit"),
                ),
                (
                    names: [
                        "--json",
                    ],
                    description: Some("Report all output as json. Suitable for using conda programmatically"),
                ),
                (
                    names: [
                        "-v",
                        "--verbose",
                    ],
                    description: Some("Use once for info, twice for debug, three times for trace"),
                ),
                (
                    names: [
                        "-q",
                        "--quiet",
                    ],
                    description: Some("Do not display progress bar"),
                ),
            ],
            arguments: [
                (
                    name: "file",
                    description: Some("Path to the environment file that is to be compared against"),
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "create",
            description: Some("Create a new conda environment from a list of specified packages"),
            options: [
                (
                    names: [
                        "--clone",
                    ],
                    description: Some("Path to (or name of) existing local environment"),
                    arguments: [
                        (
                            name: "env",
                            generators: [
                                (
                                    script: [
                                        "conda",
                                        "env",
                                        "list",
                                    ],
                                    script_timeout_ms: Some(10000),
                                    has_post_process: true,
                                    cache: Some((
                                        stale_while_revalidate: true,
                                    )),
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--file",
                    ],
                    description: Some("Read package versions from the given file. Repeated file specifications can be passed (e.g. --file=file1 --file=file2)"),
                    arguments: [
                        (
                            name: "file",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--dev",
                    ],
                    description: Some("Use sys.executable -m conda in wrapper scripts instead of CONDA_EXE. This is mainly for use during tests where we test new conda source against old Python versions"),
                ),
                (
                    names: [
                        "-n",
                        "--name",
                    ],
                    description: Some("Name of environment"),
                    arguments: [
                        (
                            name: "environment",
                        ),
                    ],
                    presentation: (
                        insert_value: Some("-n '{cursor}'"),
                    ),
                ),
                (
                    names: [
                        "-p",
                        "--prefix",
                    ],
                    description: Some("Full path to environment location (i.e. prefix)"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-c",
                        "--channel",
                    ],
                    description: Some("They are given (including local directories using the 'file://' syntax or simply a path like '/home/conda/mychan' or '../mychan'). Then, the defaults or channels from .condarc are searched (unless --override-channels is given). You can use 'defaults' to get the default packages for conda. You can also use any name and the .condarc channel_alias value will be prepended. The default channel_alias is http://conda.anaconda.org/"),
                    arguments: [
                        (
                            name: "channel",
                        ),
                    ],
                ),
                (
                    names: [
                        "--use-local",
                    ],
                    description: Some("Use locally built packages. Identical to '-c local'"),
                ),
                (
                    names: [
                        "--override-channels",
                    ],
                    description: Some("Do not search default or .condarc channels. Requires --channel"),
                    depends_on: [
                        "--channel",
                    ],
                ),
                (
                    names: [
                        "--repodata-fn",
                    ],
                    description: Some("Specify name of repodata on remote server. Conda will try whatever you specify, but will ultimately fall back to repodata.json if your specs are not satisfiable with what you specify here. This is used to employ repodata that is reduced in time scope. You may pass this flag more than once. Leftmost entries are tried first, and the fallback to repodata.json is added for you automatically"),
                    arguments: [
                        (
                            name: "repodata",
                        ),
                    ],
                    repeat: Many,
                ),
                (
                    names: [
                        "--strict-channel-priority",
                    ],
                    description: Some("Packages in lower priority channels are not considered if a package with the same name appears in a higher priority channel"),
                ),
                (
                    names: [
                        "--no-channel-priority",
                    ],
                    description: Some("Package version takes precedence over channel priority. Overrides the value given by conda config --show channel_priority"),
                ),
                (
                    names: [
                        "--no-deps",
                    ],
                    description: Some("Do not install, update, remove, or change dependencies. This WILL lead to broken environments and inconsistent behavior. Use at your own risk"),
                    presentation: (
                        dangerous: true,
                    ),
                ),
                (
                    names: [
                        "--only-deps",
                    ],
                    description: Some("Only install dependencies"),
                ),
                (
                    names: [
                        "--no-pin",
                    ],
                    description: Some("Ignore pinned file"),
                ),
                (
                    names: [
                        "--no-default-packages",
                    ],
                    description: Some("Ignore create_default_packages in the .condarc file"),
                ),
                (
                    names: [
                        "--copy",
                    ],
                    description: Some("Install all packages using copies instead of hard- or soft-linking"),
                ),
                (
                    names: [
                        "-C",
                        "--use-index-cache",
                    ],
                    description: Some("Use cache of channel index files, even if it has expired"),
                ),
                (
                    names: [
                        "-k",
                        "--insecure",
                    ],
                    description: Some("Allow conda to perform insecure SSL connections and transfers. Equivalent to setting 'ssl_verify' to 'false'"),
                ),
                (
                    names: [
                        "--offline",
                    ],
                    description: Some("Offline mode. Don't connect to the Internet"),
                ),
                (
                    names: [
                        "-d",
                        "--dry-run",
                    ],
                    description: Some("Only display what would have been done"),
                ),
                (
                    names: [
                        "--json",
                    ],
                    description: Some("Report all output as json. Suitable for using conda programmatically"),
                ),
                (
                    names: [
                        "-q",
                        "--quiet",
                    ],
                    description: Some("Do not display progress bar"),
                ),
                (
                    names: [
                        "-v",
                        "--verbose",
                    ],
                    description: Some("Can be used multiple times. Once for INFO, twice for DEBUG, three times for TRACE"),
                    repeat: Many,
                ),
                (
                    names: [
                        "-y",
                        "--yes",
                    ],
                    description: Some("Do not ask for confirmation"),
                ),
                (
                    names: [
                        "--download-only",
                    ],
                    description: Some("Solve an environment and ensure package caches are populated, but exit prior to unlinking and linking packages into the prefix"),
                ),
                (
                    names: [
                        "--show-channel-urls",
                    ],
                    description: Some("Show channel urls. Overrides the value given by conda config --show show_channel_urls"),
                ),
            ],
            arguments: [
                (
                    name: "package_spec",
                    description: Some("Packages to install or update in the conda environment"),
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "info",
            description: Some("Display information about current conda install"),
            options: [
                (
                    names: [
                        "-a",
                        "--all",
                    ],
                    description: Some("Show all information"),
                ),
                (
                    names: [
                        "--base",
                    ],
                    description: Some("Display base environment path"),
                ),
                (
                    names: [
                        "-e",
                        "--envs",
                    ],
                    description: Some("List all known conda environments"),
                ),
                (
                    names: [
                        "-s",
                        "--system",
                    ],
                    description: Some("List environment variables"),
                ),
                (
                    names: [
                        "--unsafe-channels",
                    ],
                    description: Some("Display list of channels with tokens exposed"),
                ),
                (
                    names: [
                        "--json",
                    ],
                    description: Some("Report all output as json. Suitable for using conda programmatically"),
                ),
                (
                    names: [
                        "-v",
                        "--verbose",
                    ],
                    description: Some("Use once for info, twice for debug, three times for trace"),
                ),
                (
                    names: [
                        "-q",
                        "--quiet",
                    ],
                    description: Some("Do not display progress bar"),
                ),
            ],
        ),
        (
            name: "init",
            description: Some("Initialize conda for shell interaction. [Experimental]"),
        ),
        (
            name: "install",
            description: Some("Installs a list of packages into a specified conda environment"),
            options: [
                (
                    names: [
                        "--revision",
                    ],
                    description: Some("Revert to the specified REVISION"),
                    arguments: [
                        (
                            name: "revision",
                        ),
                    ],
                ),
                (
                    names: [
                        "--file",
                    ],
                    description: Some("Read package versions from the given file. Repeated file specifications can be passed (e.g. --file=file1 --file=file2)"),
                    arguments: [
                        (
                            name: "file",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--dev",
                    ],
                    description: Some("Use sys.executable -m conda in wrapper scripts instead of CONDA_EXE. This is mainly for use during tests where we test new conda source against old Python versions"),
                ),
                (
                    names: [
                        "-n",
                        "--name",
                    ],
                    description: Some("Name of environment"),
                    arguments: [
                        (
                            name: "environment",
                        ),
                    ],
                    presentation: (
                        insert_value: Some("-n '{cursor}'"),
                    ),
                ),
                (
                    names: [
                        "-p",
