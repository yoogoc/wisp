                        "--quiet",
                    ],
                    description: Some("Do not display progress bar"),
                ),
                (
                    names: [
                        "-v",
                        "--verbose",
                    ],
                    description: Some("Can be used multiple times. Once for INFO, twice for DEBUG, three times for TRACE"),
                    repeat: Many,
                ),
                (
                    names: [
                        "-y",
                        "--yes",
                    ],
                    description: Some("Do not ask for confirmation"),
                ),
                (
                    names: [
                        "--download-only",
                    ],
                    description: Some("Solve an environment and ensure package caches are populated, but exit prior to unlinking and linking packages into the prefix"),
