                (
                    names: [
                        "--show-channel-urls",
                    ],
                    description: Some("Show channel urls. Overrides the value given by conda config --show show_channel_urls"),
                ),
            ],
            arguments: [
                (
                    name: "package spec",
                    description: Some("Packages to install or update in the conda environment"),
                    generators: [
                        (
                            has_dynamic_script: true,
                            script_timeout_ms: Some(10000),
                            has_post_process: true,
                        ),
                    ],
                    variadic: true,
                    debounce: true,
                ),
            ],
        ),
        (
            name: "list",
            description: Some("List linked packages in a conda environment"),
            options: [
                (
                    names: [
                        "--show-channel-urls",
                    ],
                    description: Some("Show channel urls. Overrides the value given by conda config --show show_channel_urls"),
                ),
                (
                    names: [
                        "-c",
                        "--canonical",
                    ],
                    description: Some("Output canonical names of packages only. Implies --no-pip"),
                ),
                (
                    names: [
                        "-f",
                        "--full-name",
                    ],
                    description: Some("Only search for full names, i.e., ^<regex>$"),
                ),
                (
                    names: [
                        "--explicit",
                    ],
                    description: Some("List explicitly all installed conda packaged with URL (output may be used by conda create --file)"),
                ),
                (
                    names: [
                        "--md5",
                    ],
                    description: Some("Add MD5 hashsum when using --explicit"),
                ),
                (
                    names: [
                        "-e",
                        "--export",
                    ],
                    description: Some("Output requirement string only (output may be used by conda create --file)"),
                ),
                (
                    names: [
                        "-r",
                        "--revisions",
                    ],
                    description: Some("List the revision history and exit"),
                ),
                (
                    names: [
                        "--no-pip",
                    ],
                    description: Some("Do not include pip-only installed packages"),
                ),
                (
                    names: [
                        "-n",
                        "--name",
                    ],
                    description: Some("Name of environment"),
                    arguments: [
                        (
                            name: "environment",
