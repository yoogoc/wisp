                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-c",
                        "--channel",
                    ],
                    description: Some("They are given (including local directories using the 'file://' syntax or simply a path like '/home/conda/mychan' or '../mychan'). Then, the defaults or channels from .condarc are searched (unless --override-channels is given). You can use 'defaults' to get the default packages for conda. You can also use any name and the .condarc channel_alias value will be prepended. The default channel_alias is http://conda.anaconda.org/"),
                    arguments: [
                        (
                            name: "channel",
                        ),
                    ],
                ),
                (
                    names: [
                        "--use-local",
                    ],
                    description: Some("Use locally built packages. Identical to '-c local'"),
                ),
                (
                    names: [
                        "--override-channels",
                    ],
                    description: Some("Do not search default or .condarc channels. Requires --channel"),
                ),
                (
                    names: [
                        "--repodata-fn",
                    ],
                    description: Some("Specify name of repodata on remote server. Conda will try whatever you specify, but will ultimately fall back to repodata.json if your specs are not satisfiable with what you specify here. This is used to employ repodata that is reduced in time scope. You may pass this flag more than once. Leftmost entries are tried first, and the fallback to repodata.json is added for you automatically"),
                    arguments: [
                        (
                            name: "repodata",
                        ),
                    ],
                ),
                (
                    names: [
                        "--strict-channel-priority",
                    ],
                    description: Some("Packages in lower priority channels are not considered if a package with the same name appears in a higher priority channel"),
                ),
                (
                    names: [
                        "--no-channel-priority",
                    ],
                    description: Some("Package version takes precedence over channel priority. Overrides the value given by conda config --show channel_priority"),
                ),
                (
                    names: [
                        "--no-deps",
                    ],
                    description: Some("Do not install, update, remove, or change dependencies. This WILL lead to broken environments and inconsistent behavior. Use at your own risk"),
                ),
                (
                    names: [
                        "--only-deps",
                    ],
                    description: Some("Only install dependencies"),
                ),
                (
                    names: [
                        "--no-pin",
                    ],
                    description: Some("Ignore pinned file"),
                ),
                (
                    names: [
                        "--force-reinstall",
                    ],
                    description: Some("Ensure that any user-requested package for the current operation is uninstalled and reinstalled, even if that package already exists in the environment"),
                ),
                (
                    names: [
                        "--freeze-installed",
                        "--no-update-deps",
                    ],
                    description: Some("Do not update or change already-installed dependencies"),
                ),
                (
                    names: [
                        "--update-deps",
                    ],
                    description: Some("Update dependencies"),
                ),
                (
                    names: [
                        "-S",
                        "--satisfied-skip-solve",
                    ],
                    description: Some("Exit early and do not run the solver if the requested specs are satisfied. Also skips aggressive updates as configured by 'aggressive_update_packages'. Similar to the default behavior of 'pip install'"),
                ),
                (
                    names: [
                        "--update-all",
                        "--all",
                    ],
                    description: Some("Update all installed packages in the environment"),
                ),
                (
                    names: [
                        "--update-specs",
                    ],
                    description: Some("Update based on provided specifications"),
                ),
                (
                    names: [
                        "--copy",
                    ],
                    description: Some("Install all packages using copies instead of hard- or soft-linking"),
                ),
                (
                    names: [
                        "-m",
                        "--mkdir",
                    ],
                    description: Some("Create the environment directory if necessary"),
                ),
                (
                    names: [
                        "--clobber",
                    ],
                    description: Some("Allow clobbering of overlapping file paths within packages, and suppress related warnings"),
                ),
                (
                    names: [
                        "-C",
                        "--use-index-cache",
                    ],
                    description: Some("Use cache of channel index files, even if it has expired"),
                ),
                (
                    names: [
                        "-k",
                        "--insecure",
                    ],
                    description: Some("Allow conda to perform insecure SSL connections and transfers. Equivalent to setting 'ssl_verify' to 'false'"),
                ),
                (
                    names: [
