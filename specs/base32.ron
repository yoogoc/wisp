(
    version: 1,
    command: "base32",
    description: Some("Base32 encode/decode data and print to standard output"),
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Display this help and exit"),
        ),
        (
            names: [
                "--decode",
                "-d",
            ],
            description: Some("Decode data"),
        ),
        (
            names: [
                "--ignore-garbage",
                "-i",
            ],
            description: Some("When decoding, ignore non-alphabet characters"),
        ),
        (
            names: [
                "--wrap",
                "-w",
            ],
            description: Some("Wrap encoded lines after COLS character (default 76).  Use 0 to disable line wrapping"),
            arguments: [
                (
                    name: "COLS",
                    suggestions: [
                        (
                            name: "76",
                        ),
                        (
                            name: "78",
                        ),
                        (
                            name: "80",
                        ),
                        (
                            name: "100",
                        ),
                        (
                            name: "120",
                        ),
                        (
                            name: "160",
                        ),
                        (
                            name: "0",
                        ),
                    ],
                    default: Some("76"),
                ),
            ],
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Output version information and exit"),
        ),
    ],
    arguments: [
        (
            name: "FILE",
            description: Some("File to base32 encode/decode"),
            template: [
                FilePaths,
            ],
        ),
    ],
    parser_directives: Some((
        options_must_precede_arguments: true,
    )),
)
