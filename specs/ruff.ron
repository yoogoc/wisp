(
    version: 1,
    command: "ruff",
    description: Some("Ruff: An extremely fast Python linter"),
    subcommands: [
        (
            name: "check",
            description: Some("Run Ruff on the given files or directories"),
            options: [
                (
                    names: [
                        "--fix",
                    ],
                    description: Some("Apply fixes to resolve lint violations"),
                ),
                (
                    names: [
                        "--unsafe-fixes",
                    ],
                    description: Some("Include fixes that may not retain the original intent of the code"),
                ),
                (
                    names: [
                        "--show-fixes",
                    ],
                    description: Some("Show an enumeration of all fixed lint violations"),
                ),
                (
                    names: [
                        "--diff",
                    ],
                    description: Some("Avoid writing any fixed files back; instead, output a diff for each changed file to stdout, and exit 0 if there are no diffs. Implies `--fix-only`"),
                ),
                (
                    names: [
                        "-w",
                        "--watch",
                    ],
                    description: Some("Run in watch mode by re-running whenever files change"),
                ),
                (
                    names: [
                        "--fix-only",
                    ],
                    description: Some("Apply fixes to resolve lint violations, but don't report on, or exit non-zero for, leftover violations. Implies `--fix`"),
                ),
                (
                    names: [
                        "--ignore-noqa",
                    ],
                    description: Some("Ignore any `# noqa` comments"),
                ),
                (
                    names: [
                        "--output-format",
                    ],
                    description: Some("Output serialization format for violations. The default serialization format is 'full'"),
                    arguments: [
                        (
                            name: "output_format",
                            suggestions: [
                                (
                                    name: "concise",
                                ),
                                (
                                    name: "full",
                                ),
                                (
                                    name: "json",
                                ),
                                (
                                    name: "json-lines",
                                ),
                                (
                                    name: "junit",
                                ),
                                (
                                    name: "grouped",
                                ),
                                (
                                    name: "github",
                                ),
                                (
                                    name: "gitlab",
                                ),
                                (
                                    name: "pylint",
                                ),
                                (
                                    name: "rdjson",
                                ),
                                (
                                    name: "azure",
                                ),
                                (
                                    name: "sarif",
                                ),
                            ],
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "-o",
                        "--output-file",
                    ],
                    description: Some("Specify file to write the linter output to (default: stdout)"),
                    arguments: [
                        (
                            name: "output_file",
                            template: [
                                FilePaths,
                            ],
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--target-version",
                    ],
                    description: Some("The minimum Python version that should be supported"),
                    arguments: [
                        (
                            name: "target_version",
                            suggestions: [
                                (
                                    name: "py37",
                                ),
                                (
                                    name: "py38",
                                ),
                                (
                                    name: "py39",
                                ),
                                (
                                    name: "py310",
                                ),
                                (
                                    name: "py311",
                                ),
                                (
                                    name: "py312",
                                ),
                                (
                                    name: "py313",
                                ),
                            ],
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--preview",
                    ],
                    description: Some("Enable preview mode; checks will include unstable rules and fixes"),
                ),
                (
                    names: [
                        "--extension",
                    ],
                    description: Some("List of mappings from file extension to language (one of `python`, `ipynb`, `pyi`). For example, to treat `.ipy` files as IPython notebooks, use `--extension ipy:ipynb`"),
                    arguments: [
                        (
                            name: "extension",
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--statistics",
                    ],
                    description: Some("Show counts for every rule with at least one violation"),
                ),
                (
                    names: [
                        "--add-noqa",
                    ],
                    description: Some("Enable automatic additions of `noqa` directives to failing lines"),
                ),
                (
                    names: [
                        "--show-files",
                    ],
                    description: Some("See the files Ruff will be run against with the current settings"),
                ),
                (
                    names: [
                        "--show-settings",
                    ],
                    description: Some("See the settings Ruff will use to lint a given Python file"),
                ),
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Print help"),
                ),
                (
                    names: [
                        "--select",
                    ],
                    description: Some("Comma-separated list of rule codes to enable (or ALL, to enable all rules)"),
                    arguments: [
                        (
                            name: "select",
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--ignore",
                    ],
                    description: Some("Comma-separated list of rule codes to disable"),
                    arguments: [
                        (
                            name: "ignore",
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--extend-select",
                    ],
                    description: Some("Like --select, but adds additional rule codes on top of the selected ones"),
                    arguments: [
                        (
                            name: "extend_select",
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--per-file-ignores",
                    ],
                    description: Some("List of mappings from file pattern to code to exclude"),
                    arguments: [
                        (
                            name: "per_file_ignores",
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--extend-per-file-ignores",
                    ],
                    description: Some("Like `--per-file-ignores`, but adds additional ignores on top of those already specified"),
                    arguments: [
                        (
                            name: "extend_per_file_ignores",
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--fixable",
                    ],
                    description: Some("List of rule codes to treat as eligible for fix. Only applicable when fix itself is enabled (e.g., via `--fix`)"),
                    arguments: [
                        (
                            name: "fixable",
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--unfixable",
                    ],
                    description: Some("List of rule codes to treat as ineligible for fix. Only applicable when fix itself is enabled (e.g., via `--fix`)"),
                    arguments: [
                        (
                            name: "unfixable",
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--extend-fixable",
                    ],
                    description: Some("Like --fixable, but adds additional rule codes on top of those already specified"),
                    arguments: [
                        (
                            name: "extend_fixable",
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--exclude",
                    ],
                    description: Some("List of paths, used to omit files and/or directories from analysis"),
                    arguments: [
                        (
                            name: "exclude",
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--extend-exclude",
                    ],
                    description: Some("Like --exclude, but adds additional files and directories on top of those already excluded"),
                    arguments: [
                        (
                            name: "extend_exclude",
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--respect-gitignore",
                    ],
                    description: Some("Respect file exclusions via `.gitignore` and other standard ignore files"),
                ),
                (
                    names: [
                        "--force-exclude",
                    ],
                    description: Some("Enforce exclusions, even for paths passed to Ruff directly on the command-line"),
                ),
                (
                    names: [
                        "-n",
                        "--no-cache",
                    ],
                    description: Some("Disable cache reads"),
                ),
                (
                    names: [
                        "--cache-dir",
                    ],
                    description: Some("Path to the cache directory"),
                    arguments: [
                        (
                            name: "cache_dir",
                            template: [
                                FilePaths,
                            ],
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--stdin-filename",
                    ],
                    description: Some("The name of the file when passing it through stdin"),
                    arguments: [
                        (
                            name: "stdin_filename",
                            template: [
                                FilePaths,
                            ],
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "-e",
                        "--exit-zero",
                    ],
                    description: Some("Exit with status code \"0\", even upon detecting lint violations"),
                ),
                (
                    names: [
                        "--exit-non-zero-on-fix",
                    ],
                    description: Some("Exit with a non-zero status code if any files were modified via fix, even if no lint violations remain"),
                ),
            ],
            arguments: [
                (
                    name: "Path",
                    description: Some("The path to use for the project/script"),
                    template: [
                        FilePaths,
                    ],
                    variadic: true,
                    default: Some("."),
                ),
            ],
        ),
        (
            name: "rule",
            description: Some("Explain a rule (or all rules)"),
            options: [
                (
                    names: [
                        "--all",
                    ],
                    description: Some("Explain all rules"),
                ),
                (
                    names: [
                        "--output-format",
                    ],
                    description: Some("Output format [default: text]"),
                    arguments: [
                        (
                            name: "output-format",
                            suggestions: [
                                (
                                    name: "text",
                                ),
                                (
                                    name: "json",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "rule",
                    description: Some("Rule(s) to explain"),
                    suggestions: [
                        (
                            name: "F401",
