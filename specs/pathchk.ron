(
    version: 1,
    command: "pathchk",
    description: Some("Check pathnames for POSIX portability"),
    subcommands: [],
    options: [
        (
            names: [
                "-p",
            ],
            description: Some("Perform portability checks on the specified pathname arguments, writes messages if 1) path is longer than _POSIX_PATH_MAX (255) bytes 2) contains a component longer than _POSIX_NAME_MAX (14) bytes, contains any character not in the portable filename character set"),
            takes_value: false,
            arguments: [],
        ),
        (
            names: [
                "-P",
            ],
            description: Some("In addition to the default or -p checks, write a diagnostic for each argument that 1) is empty 2) contains a component that starts with a hyphen"),
            takes_value: false,
            arguments: [],
        ),
    ],
    arguments: [
        (
            name: "pathname",
            source: Files,
            optional: false,
            variadic: true,
            imported_generator: None,
        ),
    ],
)