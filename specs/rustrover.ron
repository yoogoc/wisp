(
    version: 1,
    command: "rustrover",
    description: Some("RustRover cli"),
    subcommands: [
        (
            name: "diff",
            description: Some("Open the diff viewer to see the differences between two specified files"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                    ],
                ),
                (
                    name: "path2",
                    template: [
                        FilePaths,
                    ],
                ),
                (
                    name: "path3-optional",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "merge",
            description: Some("Open the Merge dialog to merge the specified files"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                    ],
                ),
                (
                    name: "path2",
                    template: [
                        FilePaths,
                    ],
                ),
                (
                    name: "base-optional",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "format",
            description: Some("Apply code style formatting to the specified files"),
            options: [
                (
                    names: [
                        "-h",
                    ],
                    description: Some("Show help for format command"),
                ),
                (
                    names: [
                        "-m",
                        "-mask",
                    ],
                    description: Some("Specify a comma-separated list of file masks that define the files to be processed"),
                ),
                (
                    names: [
                        "-r",
                        "-R",
                    ],
                    description: Some("Process specified directories recursively"),
                ),
                (
                    names: [
                        "-s",
                        "-settings",
                    ],
                    description: Some("Specify the code style settings file to use for formatting"),
                ),
                (
                    names: [
                        "-allowDefaults",
                    ],
                    description: Some("Use the default code style settings when the code style is not defined for a file or a group of files"),
                ),
                (
                    names: [
                        "-charset",
                    ],
                    description: Some("Preserve encoding and enforce the charset for reading and writing source files"),
                ),
                (
                    names: [
                        "-d",
                        "-dry",
                    ],
                    description: Some("Run the formatter in the validation mode"),
                ),
            ],
            arguments: [
                (
                    name: "path...",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "inspect",
            description: Some("Perform code inspection on the specified project"),
            options: [
                (
                    names: [
                        "-changes",
                    ],
                    description: Some("Run inspections only on local uncommitted changes"),
                ),
                (
                    names: [
                        "-d",
                    ],
                    description: Some("Specify the full path to the subdirectory if you don't want to inspect the whole project"),
                ),
                (
                    names: [
                        "-format",
                    ],
                    description: Some("Specify the format of the output file with inspection results"),
                ),
                (
                    names: [
                        "-v",
                    ],
                    description: Some("Set the verbosity level of the output"),
                ),
            ],
            arguments: [
                (
                    name: "project",
                    template: [
                        Folders,
                    ],
                ),
                (
                    name: "inspection-profile",
                    template: [
                        FilePaths,
                    ],
                ),
                (
                    name: "output",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "installPlugins",
            description: Some("Install plugins by plugin ID from JetBrains Marketplace or a custom plugin repository"),
            arguments: [
                (
                    name: "plugin-id",
                ),
                (
                    name: "repository-url ",
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "nosplash",
            ],
            description: Some("Do not show the splash screen when loading RustRover"),
        ),
        (
            names: [
                "dontReopenProjects",
            ],
            description: Some("Do not reopen projects and show the welcome screen"),
        ),
        (
            names: [
                "disableNonBundledPlugins",
            ],
            description: Some("Do not load manually installed plugins"),
        ),
        (
            names: [
                "--wait",
            ],
            description: Some("Wait for the files to be closed before returning to the command prompt"),
        ),
    ],
    arguments: [
        (
            name: "path",
            template: [
                FilePaths,
            ],
        ),
    ],
)
