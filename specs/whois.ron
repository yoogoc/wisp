(
    version: 1,
    command: "whois",
    description: Some("Query a database for information about a domain registrant"),
    options: [
        (
            names: [
                "-a",
            ],
            description: Some("Use the American Registry for Internet Numbers (ARIN) database"),
        ),
        (
            names: [
                "-A",
            ],
            description: Some("Use the Asia/Pacific Network Information Center (APNIC) database"),
        ),
        (
            names: [
                "-b",
            ],
            description: Some("Use the Network Abuse Clearinghouse database"),
        ),
        (
            names: [
                "-c",
            ],
            description: Some("Equivalent to '-h TLD.whois-servers.net', where 'TLD' is this option's argument"),
            arguments: [
                (
                    name: "TLD",
                ),
            ],
            exclusive_on: [
                "-h",
            ],
        ),
        (
            names: [
                "-f",
            ],
            description: Some("Use the African Network Information Centre (AfriNIC) database"),
        ),
        (
            names: [
                "-g",
            ],
            description: Some("Use the US non-military federal government database"),
        ),
        (
            names: [
                "-h",
            ],
            description: Some("Use the specified host instead of the default (host name or IP)"),
            arguments: [
                (
                    name: "hostname",
                ),
            ],
            exclusive_on: [
                "-c",
            ],
        ),
        (
            names: [
                "-i",
            ],
            description: Some("Use the traditional Network Information Center (InterNIC) database"),
        ),
        (
            names: [
                "-I",
            ],
            description: Some("Use the Internet Assigned Numbers Authority (IANA) database"),
        ),
        (
            names: [
                "-k",
            ],
            description: Some("Use the National Internet Development Agency of Korea (KRNIC) database"),
        ),
        (
            names: [
                "-l",
            ],
            description: Some("Use the Latin American and Caribbean IP address Regional Registry (LACNIC) database"),
        ),
        (
            names: [
                "-m",
            ],
            description: Some("Use the Route Arbiter Database (RADB) database"),
        ),
        (
            names: [
                "-p",
            ],
            description: Some("Connect to the whois server on the given port"),
            arguments: [
                (
                    name: "port",
                    default: Some("43"),
                ),
            ],
        ),
        (
            names: [
                "-P",
            ],
            description: Some("Use the PeeringDB database of AS numbers"),
        ),
        (
            names: [
                "-Q",
            ],
            description: Some("Do a quick lookup (don't follow referrals)"),
        ),
        (
            names: [
                "-r",
            ],
            description: Some("Use the Réseaux IP Européens (RIPE) database"),
        ),
        (
            names: [
                "-R",
            ],
            description: Some("Do a recursive lookup"),
        ),
        (
            names: [
                "-S",
            ],
            description: Some("Print the output verbatim"),
        ),
    ],
    arguments: [
        (
            name: "name",
            variadic: true,
        ),
    ],
)
