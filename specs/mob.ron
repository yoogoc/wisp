(
    version: 1,
    command: "mob",
    description: Some("Fast git handover for remote collaboration with mob.sh"),
    subcommands: [
        (
            name: "start",
            aliases: [
                "s",
            ],
            description: Some("Start session from base branch in wip branch"),
            options: [
                (
                    names: [
                        "--include-uncommitted-changes",
                        "-i",
                    ],
                    description: Some("Move uncommitted changes to wip branch"),
                ),
                (
                    names: [
                        "--branch",
                        "-b",
                    ],
                    description: Some("Set wip branch to 'mob/<base-branch>/<branch-postfix>'"),
                    arguments: [
                        (
                            name: "branch-postfix",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "minutes",
                    description: Some("Start a <minutes> timer"),
                    optional: true,
                ),
            ],
        ),
        (
            name: "next",
            aliases: [
                "n",
            ],
            description: Some("Handover changes in wip branch to next person"),
            options: [
                (
                    names: [
                        "--stay",
                        "-s",
                    ],
                    description: Some("Stay on wip branch (default)"),
                ),
                (
                    names: [
                        "--return-to-base-branch",
                        "-r",
                    ],
                    description: Some("Return to base branch"),
                ),
                (
                    names: [
                        "--message",
                        "-m",
                    ],
                    description: Some("Override commit message"),
                    arguments: [
                        (
                            name: "commit-message",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "done",
            aliases: [
                "d",
            ],
            description: Some("Squashes all changes in wip branch to index in base branch"),
            options: [
                (
                    names: [
                        "--no-squash",
                    ],
                    description: Some("Squash no commits from wip branch, only merge wip branch"),
                ),
                (
                    names: [
                        "--squash",
                    ],
                    description: Some("Squash all commits from wip branch"),
                ),
                (
                    names: [
                        "--squash-wip",
                    ],
                    description: Some("Squash wip commits from wip branch, maintaining manual commits"),
                ),
            ],
        ),
        (
            name: "reset",
            description: Some("Removes local and remote wip branch"),
            options: [
                (
                    names: [
                        "--branch",
                        "-b",
                    ],
                    description: Some("Set wip branch to 'mob/<base-branch>/<branch-postfix>'"),
                    arguments: [
                        (
                            name: "branch-postfix",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "clean",
            description: Some("Removes all orphan wip branches"),
        ),
        (
            name: "timer",
            aliases: [
                "t",
            ],
            description: Some("Start a <minutes> timer"),
            arguments: [
                (
                    name: "minutes",
                ),
            ],
        ),
        (
            name: "break",
            description: Some("Start a <minutes> break timer"),
            arguments: [
                (
                    name: "minutes",
                ),
            ],
        ),
        (
            name: "status",
            description: Some("Show the status of the current session"),
        ),
        (
            name: "fetch",
            description: Some("Fetch remote state"),
        ),
        (
            name: "branch",
            aliases: [
                "b",
            ],
            description: Some("Show remote wip branches"),
        ),
        (
            name: "config",
            description: Some("Show all configuration options"),
        ),
        (
            name: "version",
            description: Some("Show the version"),
        ),
        (
            name: "help",
            description: Some("Show help"),
        ),
        (
            name: "moo",
            description: Some("Moo!"),
        ),
    ],
    options: [
        (
            names: [
                "--debug",
            ],
            description: Some("Enable verbose logging"),
        ),
    ],
)
