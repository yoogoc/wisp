(
    version: 1,
    command: "dtm",
    description: Some("DevStream is an open-source DevOps toolchain manager"),
    subcommands: [
        (
            name: "apply",
            description: Some("Create or update DevOps tools according to DevStream configuration file"),
            options: [
                (
                    names: [
                        "--config-file",
                        "-f",
                    ],
                    description: Some("Config file"),
                    arguments: [
                        (
                            name: "config-file",
                            template: [
                                FilePaths,
                            ],
                            generators: [
                                (
                                    has_custom: true,
                                    has_dynamic_trigger: true,
                                    has_dynamic_query_term: true,
                                ),
                            ],
                            default: Some("config.yaml"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--plugin-dir",
                        "-d",
                    ],
                    description: Some("Plugins directory"),
                    arguments: [
                        (
                            name: "plugin-dir",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--yes",
                        "-y",
                    ],
                    description: Some("Apply directly without confirmation"),
                ),
            ],
        ),
        (
            name: "completion",
            description: Some("Generate the autocompletion script for dtm for the specified shell"),
            subcommands: [
                (
                    name: "bash",
                    description: Some("Generate autocompletion script for bash"),
                ),
                (
                    name: "fish",
                    description: Some("Generate autocompletion script for fish"),
                ),
                (
                    name: "powershell",
                    description: Some("Generate autocompletion script for powershell"),
                ),
                (
                    name: "zsh",
                    description: Some("Generate autocompletion script for zsh"),
                ),
            ],
        ),
        (
            name: "delete",
            description: Some("Delete DevOps tools according to DevStream configuration file"),
            options: [
                (
                    names: [
                        "--config-file",
                        "-f",
                    ],
                    description: Some("Config file"),
                    arguments: [
                        (
                            name: "config-file",
                            template: [
                                FilePaths,
                            ],
                            generators: [
                                (
                                    has_custom: true,
                                    has_dynamic_trigger: true,
                                    has_dynamic_query_term: true,
                                ),
                            ],
                            default: Some("config.yaml"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--force",
                    ],
                    description: Some("Force delete by config"),
                ),
                (
                    names: [
                        "--plugin-dir",
                        "-d",
                    ],
                    description: Some("Plugins directory"),
                    arguments: [
                        (
                            name: "plugin-dir",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--yes",
                        "-y",
                    ],
                    description: Some("Delete directly without confirmation"),
                ),
            ],
        ),
        (
            name: "destroy",
            description: Some("Destroy DevOps tools deployment according to DevStream configuration file & state file"),
            options: [
                (
                    names: [
                        "--config-file",
                        "-f",
                    ],
                    description: Some("Config file"),
                    arguments: [
                        (
                            name: "config-file",
                            template: [
                                FilePaths,
                            ],
                            generators: [
                                (
                                    has_custom: true,
                                    has_dynamic_trigger: true,
                                    has_dynamic_query_term: true,
                                ),
                            ],
                            default: Some("config.yaml"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--force",
                    ],
                    description: Some("Force destroy by config"),
                ),
                (
                    names: [
                        "--plugin-dir",
                        "-d",
                    ],
                    description: Some("Plugins directory"),
                    arguments: [
                        (
                            name: "plugin-dir",
                        ),
                    ],
                ),
                (
                    names: [
                        "--yes",
                        "-y",
                    ],
                    description: Some("Destroy directly without confirmation"),
                ),
            ],
        ),
        (
            name: "develop",
            description: Some("Develop is used for develop a new plugin"),
            subcommands: [
                (
                    name: "create-plugin",
                    description: Some("Create a new plugin"),
                    options: [
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("Specify name of the plugin to be created"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                            persistent: true,
                        ),
                    ],
                ),
                (
                    name: "validate-plugin",
                    description: Some("Validate a plugin"),
                    options: [
                        (
                            names: [
                                "--all",
                                "-a",
                            ],
                            description: Some("Validate all plugins"),
                            persistent: true,
                        ),
                        (
                            names: [
                                "--name",
                                "-n",
                            ],
                            description: Some("Specify name of the plugin to be validated"),
                            arguments: [
                                (
                                    name: "name",
                                ),
                            ],
                            persistent: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "init",
            description: Some("Download needed plugins according to the config file"),
            options: [
                (
                    names: [
                        "--all",
                        "-a",
                    ],
                    description: Some("Download all plugins"),
                ),
                (
                    names: [
                        "--arch",
                    ],
                    description: Some("Download plugins for specific arch"),
                    arguments: [
                        (
                            name: "arch",
                            default: Some("amd64"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--config-file",
                        "-f",
                    ],
                    description: Some("Config file"),
                    arguments: [
                        (
                            name: "config-file",
                            template: [
                                FilePaths,
                            ],
                            generators: [
                                (
                                    has_custom: true,
                                    has_dynamic_trigger: true,
                                    has_dynamic_query_term: true,
                                ),
                            ],
                            default: Some("config.yaml"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--download-only",
                    ],
                    description: Some("Download plugins only"),
                ),
                (
                    names: [
                        "--os",
                    ],
                    description: Some("Download plugins for specific os"),
                    arguments: [
                        (
                            name: "os",
                            default: Some("linux"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--plugin-dir",
                        "-d",
                    ],
                    description: Some("Plugins directory"),
                    arguments: [
                        (
                            name: "plugin-dir",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--plugins",
                        "-p",
                    ],
                    description: Some("The plugins to be downloaded"),
                    arguments: [
                        (
                            name: "plugins",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "list",
            description: Some("This command only supports listing plugins now"),
            subcommands: [
                (
                    name: "plugins",
                    description: Some("List all plugins"),
                    options: [
                        (
                            names: [
                                "--filter",
                                "-r",
                            ],
                            description: Some("Filter plugin by regex"),
                            arguments: [
                                (
                                    name: "filter",
                                ),
                            ],
                            persistent: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "show",
            description: Some("Show is used to print plugins' configuration templates or status"),
            subcommands: [
                (
                    name: "config",
                    description: Some("Show configuration information"),
                    options: [
                        (
                            names: [
                                "--plugin",
                                "-p",
                            ],
                            description: Some("Specify name with the plugin"),
                            arguments: [
                                (
                                    name: "plugin",
                                    generators: [
                                        (
                                            script: [
                                                "dtm",
                                                "list",
                                                "plugins",
                                            ],
                                            has_post_process: true,
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--template",
                                "-t",
                            ],
                            description: Some("Print a template config, e.g. quickstart/gitops/"),
                            arguments: [
                                (
                                    name: "template",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    name: "status",
                    description: Some("Show status information"),
                    options: [
                        (
                            names: [
                                "--all",
                                "-a",
                            ],
                            description: Some("Show all instances of all plugins status"),
                        ),
                        (
                            names: [
                                "--config-file",
                                "-f",
                            ],
                            description: Some("Config file"),
                            arguments: [
                                (
                                    name: "config-file",
                                    default: Some("config.yaml"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--id",
                                "-i",
                            ],
                            description: Some("Specify id with the plugin instance"),
                            arguments: [
                                (
                                    name: "id",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--plugin",
                                "-p",
                            ],
                            description: Some("Specify name with the plugin"),
                            arguments: [
                                (
                                    name: "plugin",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--plugin-dir",
                                "-d",
                            ],
                            description: Some("Plugins directory"),
                            arguments: [
                                (
                                    name: "plugin-dir",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "upgrade",
            description: Some("Upgrade dtm to the latest release version"),
            options: [
                (
                    names: [
                        "--yes",
                        "-y",
                    ],
                    description: Some("Upgrade directly without confirmation"),
                ),
            ],
        ),
        (
            name: "verify",
            description: Some("Verify DevOps tools according to DevStream config file and state"),
            options: [
                (
                    names: [
                        "--config-file",
                        "-f",
                    ],
                    description: Some("Config file"),
                    arguments: [
                        (
                            name: "config-file",
                            template: [
                                FilePaths,
                            ],
                            generators: [
                                (
                                    has_custom: true,
                                    has_dynamic_trigger: true,
                                    has_dynamic_query_term: true,
                                ),
                            ],
                            default: Some("config.yaml"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--plugin-dir",
                        "-d",
                    ],
                    description: Some("Plugins directory"),
                    arguments: [
                        (
                            name: "plugin-dir",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "version",
            description: Some("Print the version number of DevStream"),
        ),
        (
            name: "help",
            description: Some("Help about any command"),
            subcommands: [
                (
                    name: "apply",
                    description: Some("Create or update DevOps tools according to DevStream configuration file"),
                ),
                (
                    name: "completion",
                    description: Some("Generate the autocompletion script for dtm for the specified shell"),
                    subcommands: [
                        (
                            name: "bash",
                            description: Some("Generate autocompletion script for bash"),
                        ),
                        (
                            name: "fish",
                            description: Some("Generate autocompletion script for fish"),
                        ),
                        (
                            name: "powershell",
                            description: Some("Generate autocompletion script for powershell"),
                        ),
                        (
                            name: "zsh",
                            description: Some("Generate autocompletion script for zsh"),
                        ),
                    ],
                ),
                (
                    name: "delete",
                    description: Some("Delete DevOps tools according to DevStream configuration file"),
                ),
                (
                    name: "destroy",
                    description: Some("Destroy DevOps tools deployment according to DevStream configuration file & state file"),
                ),
                (
                    name: "develop",
                    description: Some("Develop is used for develop a new plugin"),
                    subcommands: [
                        (
                            name: "create-plugin",
                            description: Some("Create a new plugin"),
                        ),
                        (
                            name: "validate-plugin",
                            description: Some("Validate a plugin"),
                        ),
                    ],
                ),
                (
                    name: "init",
                    description: Some("Download needed plugins according to the config file"),
                ),
                (
                    name: "list",
                    description: Some("This command only supports listing plugins now"),
                    subcommands: [
                        (
                            name: "plugins",
                            description: Some("List all plugins"),
                        ),
                    ],
                ),
                (
                    name: "show",
                    description: Some("Show is used to print plugins' configuration templates or status"),
                    subcommands: [
                        (
                            name: "config",
                            description: Some("Show configuration information"),
                        ),
                        (
                            name: "status",
                            description: Some("Show status information"),
                        ),
                    ],
                ),
                (
                    name: "upgrade",
                    description: Some("Upgrade dtm to the latest release version"),
                ),
                (
                    name: "verify",
                    description: Some("Verify DevOps tools according to DevStream config file and state"),
                ),
                (
                    name: "version",
                    description: Some("Print the version number of DevStream"),
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--debug",
            ],
            description: Some("Debug level log"),
            persistent: true,
        ),
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Display help"),
            persistent: true,
        ),
    ],
)
