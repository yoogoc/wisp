(
    version: 1,
    command: "streamlit",
    description: Some("Streamlit"),
    subcommands: [
        (
            name: "activate",
            description: Some("Activate Streamlit by entering your email"),
            presentation: (
                icon: Some("✉️"),
            ),
        ),
        (
            name: "cache",
            description: Some("Manage the Streamlit cache"),
            subcommands: [
                (
                    name: "clear",
                    description: Some("Clear st.cache, st.memo, and st.singleton caches"),
                    presentation: (
                        icon: Some("🗑"),
                    ),
                ),
            ],
            presentation: (
                icon: Some("🗂"),
            ),
        ),
        (
            name: "config",
            description: Some("Manage Streamlit's config settings"),
            subcommands: [
                (
                    name: "show",
                    description: Some("Show all of Streamlit's config settings"),
                    presentation: (
                        icon: Some("👀"),
                    ),
                ),
            ],
            presentation: (
                icon: Some("⚙️"),
            ),
        ),
        (
            name: "docs",
            description: Some("Show help in browser"),
            presentation: (
                icon: Some("💡"),
            ),
        ),
        (
            name: "hello",
            description: Some("Runs the Hello World script"),
            presentation: (
                icon: Some("👋,"),
            ),
        ),
        (
            name: "help",
            description: Some("Print the help message"),
            presentation: (
                icon: Some("❓"),
            ),
        ),
        (
            name: "run",
            description: Some("Run a Python script, piping stderr to Streamlit"),
            arguments: [
                (
                    name: "file",
                    description: Some("The Python script to run"),
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                ),
            ],
            presentation: (
                icon: Some("🎈"),
            ),
        ),
        (
            name: "version",
            description: Some("Print Streamlit's version number"),
            presentation: (
                icon: Some("💯"),
            ),
        ),
    ],
    options: [
        (
            names: [
                "--log_level",
            ],
            description: Some("Set the log level"),
            arguments: [
                (
                    name: "",
                    suggestions: [
                        (
                            name: "error",
                            presentation: (
                                icon: Some("🔥"),
                            ),
                        ),
                        (
                            name: "warning",
                            presentation: (
                                icon: Some("⚠️"),
                            ),
