(
    version: 1,
    command: "sha1sum",
    description: Some("Print or check SHA1 (160-bit) checksums"),
    options: [
        (
            names: [
                "-b",
                "--binary",
            ],
            description: Some("Read in binary mode"),
        ),
        (
            names: [
                "-c",
                "--check",
            ],
            description: Some("Read SHA1 sums from the FILEs and check them"),
        ),
        (
            names: [
                "--tag",
            ],
            description: Some("Create a BSD-style checksum"),
        ),
        (
            names: [
                "-t",
                "--text",
            ],
            description: Some("Read in text mode (default)"),
        ),
        (
            names: [
                "-z",
                "--zero",
            ],
            description: Some("End each output line with NUL, not newline, and disable file name escaping"),
        ),
        (
            names: [
                "--ignore-missing",
            ],
            description: Some("Don't fail or report status for missing files"),
        ),
        (
            names: [
                "--quiet",
            ],
            description: Some("Don't print OK for each successfully verified file"),
        ),
        (
            names: [
                "--status",
            ],
            description: Some("Don't output anything, status code shows success"),
        ),
        (
            names: [
                "--strict",
            ],
            description: Some("Exit non-zero for improperly formatted checksum lines"),
        ),
        (
            names: [
                "-w",
                "--warn",
            ],
            description: Some("Warn about improperly formatted checksum lines"),
        ),
        (
            names: [
                "--help",
            ],
            description: Some("Output help message and exit"),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Output version information and exit"),
        ),
    ],
    arguments: [
        (
            name: "file",
            description: Some("With no FILE, or when FILE is -, read standard input"),
            suggestions: [
                (
                    name: "-",
                ),
            ],
            template: [
                FilePaths,
            ],
            optional: true,
        ),
    ],
)
