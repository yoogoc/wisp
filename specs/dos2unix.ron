(
    version: 1,
    command: "dos2unix",
    description: Some("DOS to Unix file format converter"),
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Show help for dos2unix"),
        ),
        (
            names: [
                "--",
            ],
            description: Some("Treat all following options as file names. Use this option if you want to convert files whose names start with a dash"),
        ),
        (
            names: [
                "--allow-chown",
            ],
            description: Some("Allow file ownership change in old file mode"),
        ),
        (
            names: [
                "-ascii",
            ],
            description: Some("Convert only line breaks. This is the default conversion mode"),
        ),
        (
            names: [
                "-iso",
            ],
            description: Some("Conversion between DOS and ISO-8859-1 character set"),
        ),
        (
            names: [
                "-1252",
            ],
            description: Some("Use Windows code page 1252 (Western European)"),
        ),
        (
            names: [
                "-437",
            ],
            description: Some("Use DOS code page 437 (US). This is the default code page used for ISO conversion"),
        ),
        (
            names: [
                "-850",
            ],
            description: Some("Use DOS code page 850 (Western European)"),
        ),
        (
            names: [
                "-860",
            ],
            description: Some("Use DOS code page 860 (Portuguese)"),
        ),
        (
            names: [
                "-863",
            ],
            description: Some("Use DOS code page 863 (French Canadian)"),
        ),
        (
            names: [
                "-865",
            ],
            description: Some("Use DOS code page 865 (Nordic)"),
        ),
        (
            names: [
                "-7",
            ],
            description: Some("Convert 8 bit characters to 7 bit space"),
        ),
        (
            names: [
                "-b",
                "--keep-bom",
            ],
            description: Some("Keep Byte Order Mark (BOM). When the input file has a BOM, write a BOM in the output file"),
        ),
        (
            names: [
                "-c",
                "--convmode",
            ],
            description: Some("Set conversion mode"),
            arguments: [
                (
                    name: "CONVMODE",
                    suggestions: [
                        (
                            name: "ascii",
                        ),
                        (
                            name: "7bit",
                        ),
                        (
                            name: "iso",
                        ),
                        (
                            name: "mac",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-D",
                "--display-enc",
            ],
            description: Some("Set encoding of displayed text"),
            arguments: [
                (
                    name: "ENCODING",
                    suggestions: [
                        (
                            name: "ansi",
                        ),
                        (
                            name: "unicode",
                        ),
                        (
                            name: "unicodebom",
                        ),
                        (
                            name: "utf8",
                        ),
                        (
                            name: "utf8bom",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-f",
                "--force",
            ],
            description: Some("Force conversion of binary files"),
        ),
        (
            names: [
                "-gb",
                "--gb18030",
            ],
            description: Some("On Windows UTF-16 files are by default converted to UTF-8, regardless of the locale setting"),
        ),
        (
            names: [
                "-i",
            ],
            description: Some("Display file information. No conversion is done"),
            arguments: [
                (
                    name: "value",
                ),
            ],
            exclusive_on: [
                "--info",
            ],
            presentation: (
                insert_value: Some("-i{cursor}"),
            ),
        ),
        (
            names: [
                "--info",
            ],
            description: Some("Display file information. No conversion is done"),
            arguments: [
                (
                    name: "value",
                ),
            ],
            requires_separator: Some("="),
            exclusive_on: [
                "-i",
            ],
        ),
        (
            names: [
                "-k",
                "--keepdate",
            ],
        ),
        (
            names: [
                "-L",
                "--license",
            ],
            description: Some("Display program's license"),
        ),
        (
            names: [
                "-l",
                "--newline",
            ],
            description: Some("Add additional newline"),
        ),
        (
            names: [
                "-m",
                "--add-bom",
            ],
            description: Some("Write a Byte Order Mark (BOM) in the output file. By default an UTF-8 BOM is written"),
        ),
        (
            names: [
                "--newfile",
            ],
            description: Some("New file mode. Convert file INFILE and write output to file OUTFILE. File names must be given in pairs and wildcard names should not be used or you will lose your files"),
            arguments: [
                (
                    name: "INFILE",
                    template: [
                        FilePaths,
                    ],
                ),
                (
                    name: "OUTFILE",
                    template: [
                        FilePaths,
                    ],
                    suggest_current_token: true,
                ),
            ],
        ),
        (
            names: [
                "--no-allow-chown",
            ],
            description: Some("Don't allow file ownership change in old file mode (default)"),
        ),
        (
            names: [
                "-o",
                "--oldfile",
            ],
            description: Some("Old file mode. Convert file FILE and overwrite output to it"),
            arguments: [
                (
                    name: "FILE",
                    template: [
                        FilePaths,
                    ],
                    variadic: true,
                ),
            ],
        ),
        (
            names: [
                "-q",
                "--quiet",
            ],
            description: Some("Quiet mode. Suppress all warnings and messages. The return value is zero.  Except when wrong command-line options are used"),
        ),
        (
            names: [
                "-r",
                "--remove-bom",
            ],
            description: Some("Remove Byte Order Mark (BOM). Do not write a BOM in the output file"),
        ),
        (
            names: [
                "-s",
                "--safe",
            ],
            description: Some("Skip binary files (default)"),
        ),
        (
            names: [
                "-u",
                "--keep-utf16",
            ],
            description: Some("Keep UTF-16 encoding"),
        ),
        (
            names: [
                "-ul",
                "--assume-utf16le",
            ],
            description: Some("Assume that the input format is UTF-16LE"),
        ),
        (
            names: [
                "-ub",
                "--assume-utf16be",
            ],
            description: Some("Assume that the input format is UTF-16BE"),
        ),
        (
            names: [
                "-v",
                "--verbose",
            ],
            description: Some("Verbose operation"),
        ),
        (
            names: [
                "-F",
                "--follow-symlink",
            ],
            description: Some("Follow symbolic links and convert the targets"),
        ),
        (
            names: [
                "-R",
                "--replace-symlink",
            ],
            description: Some("Replace symbolic links with converted files"),
        ),
        (
            names: [
                "-S",
                "--skip-symlink",
            ],
            description: Some("Keep symbolic links and targets unchanged (default)"),
        ),
        (
            names: [
                "-V",
                "--version",
            ],
            description: Some("Display version number"),
        ),
    ],
    arguments: [
        (
            name: "file",
            template: [
                FilePaths,
            ],
            optional: true,
            variadic: true,
        ),
    ],
    parser_directives: Some((
        flags_are_posix_noncompliant: true,
    )),
)
