(
    version: 1,
    command: "pyenv",
    description: Some("Pyenv"),
    subcommands: [
        (
            name: "commands",
            description: Some("Lists all available pyenv commands"),
        ),
        (
            name: "local",
            description: Some("Sets a local application-specific Python version"),
            options: [
                (
                    names: [
                        "--unset",
                    ],
                ),
            ],
            arguments: [
                (
                    name: "python version",
                    variadic: true,
                ),
            ],
        ),
        (
            name: "global",
            description: Some("Sets the global version of Python to be used in all shells"),
            arguments: [
                (
                    name: "python version",
                    generators: [
                        (
                            script: [
                                "pyenv",
                                "versions",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "shell",
            description: Some("Sets a shell-specific Python version"),
            options: [
                (
                    names: [
                        "--unset",
                    ],
                ),
            ],
            arguments: [
                (
                    name: "python version",
                ),
            ],
        ),
        (
            name: "install",
            description: Some("Install a Python version"),
            options: [
                (
                    names: [
                        "-l",
                        "--list",
                    ],
                    description: Some("List all available versions"),
                ),
                (
                    names: [
                        "-f",
                        "--force",
                    ],
                    description: Some("Install even if the version appears to be installed already"),
                ),
                (
                    names: [
                        "-s",
                        "--skip-existing",
                    ],
                    description: Some("Skip the installation if the version appears to be installed already"),
                ),
                (
                    names: [
                        "-k",
                        "--keep",
                    ],
                    description: Some("Keep source tree in $PYENV_BUILD_ROOT after installation"),
                ),
                (
                    names: [
                        "-v",
                        "--verbose",
                    ],
                    description: Some("Verbose mode: print compilation status to stdout"),
                ),
                (
                    names: [
                        "-p",
                        "--patch",
                    ],
                    description: Some("Apply a patch from stdin before building"),
                ),
                (
                    names: [
                        "-g",
                        "--debug",
                    ],
                    description: Some("Build a debug version"),
                ),
            ],
            arguments: [
                (
                    name: "python version",
                    generators: [
                        (
                            script: [
                                "pyenv",
                                "install",
                                "-l",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "uninstall",
            description: Some("Performs a deployment (default)"),
            options: [
                (
                    names: [
                        "-f",
                        "--force",
                    ],
                    description: Some("Attempt to remove the specified version without prompting for confirmation"),
                ),
            ],
            arguments: [
                (
                    name: "version",
                ),
            ],
        ),
        (
            name: "rehash",
            description: Some("Performs a deployment (default)"),
        ),
        (
            name: "version",
            description: Some("Displays the currently active Python version, along with information on how it was set"),
        ),
        (
            name: "versions",
            description: Some("Lists all Python versions known to pyenv, and shows an asterisk next to the currently active version"),
            options: [
                (
                    names: [
                        "--bare",
                    ],
                    description: Some("Print only the version names, one per line"),
                ),
                (
                    names: [
                        "--skip-aliases",
                    ],
                    description: Some("Skip printing aliases"),
                ),
            ],
        ),
        (
            name: "which",
            description: Some("Displays the full path to the executable that pyenv will invoke when you run the given command"),
            arguments: [
                (
                    name: "command",
                ),
            ],
        ),
        (
            name: "whence",
            description: Some("Lists all Python versions with the given command installed"),
            arguments: [
                (
                    name: "command",
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Output usage information"),
        ),
    ],
    arguments: [
        (
            name: "",
        ),
    ],
)
