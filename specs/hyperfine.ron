(
    version: 1,
    command: "hyperfine",
    description: Some("A command-line benchmarking tool"),
    options: [
        (
            names: [
                "--warmup",
                "-w",
            ],
            description: Some("Perform warmupruns (number) before the actual benchmarking starts"),
            arguments: [
                (
                    name: "NUM",
                ),
            ],
        ),
        (
            names: [
                "--min-runs",
                "-m",
            ],
            description: Some("Perform at least NUM runs for each command"),
            arguments: [
                (
                    name: "NUM",
                    default: Some("10"),
                ),
            ],
        ),
        (
            names: [
                "--max-runs",
                "-M",
            ],
            description: Some("Perform at most NUM runs for each command. Default: no limit"),
            arguments: [
                (
                    name: "NUM",
                ),
            ],
        ),
        (
            names: [
                "--runs",
                "-r",
            ],
            description: Some("Perform exactly NUM runs for each command"),
            arguments: [
                (
                    name: "NUM",
                ),
            ],
        ),
        (
            names: [
                "--setup",
                "-s",
            ],
            description: Some("Execute cmd once before each set of timing runs"),
            arguments: [
                (
                    name: "CMD",
                    is_command: true,
                ),
            ],
        ),
        (
            names: [
                "--prepare",
                "-p",
            ],
            description: Some("Execute cmd before each timing run. This is useful for clearing disk caches, for example"),
            arguments: [
                (
                    name: "CMD ...",
                    is_command: true,
                ),
            ],
        ),
        (
            names: [
                "--cleanup",
                "-c",
            ],
            description: Some("Execute cmd after the completion of all benchmarking runs for each individual command to be benchmarked"),
            arguments: [
                (
                    name: "CMD",
                    is_command: true,
                ),
            ],
        ),
        (
            names: [
                "--parameter-scan",
                "-P",
            ],
            description: Some("Perform benchmark runs for each value in the range min..max"),
            arguments: [
                (
                    name: "VAR",
                ),
                (
                    name: "MIN",
                ),
                (
                    name: "MAX",
                ),
            ],
        ),
        (
            names: [
                "--parameter-step-size",
                "-D",
            ],
            description: Some("This argument requires --parameter-scan to be specified as well. Traverse the range min..max in steps of delta"),
            arguments: [
                (
                    name: "delta",
                ),
            ],
            depends_on: [
                "--parameter-scan",
                "-P",
            ],
        ),
        (
            names: [
                "--parameter-list",
                "-L",
            ],
            description: Some("Perform benchmark runs for each value in the comma-separated list of values"),
            arguments: [
                (
                    name: "VAR",
                ),
                (
                    name: "VALS",
                ),
            ],
        ),
        (
            names: [
                "--style",
            ],
            description: Some("Set output style type"),
            arguments: [
                (
                    name: "STYLE",
                    suggestions: [
                        (
                            name: "basic",
                            description: Some("Disable output coloring and interactive elements"),
                        ),
                        (
                            name: "full",
                            description: Some("Enable all effects even if no interactive terminal was detected"),
                        ),
                        (
                            name: "nocolor",
                            description: Some("Keep the interactive output without any colors"),
                        ),
                        (
                            name: "color",
                            description: Some("Keep the colors without any interactive output"),
                        ),
                        (
                            name: "none",
                            description: Some("Disable all the output of the tool"),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--shell",
                "-S",
            ],
            description: Some("Set the shell to use for executing benchmarked commands"),
            arguments: [
                (
                    name: "SHELL",
                    suggestions: [
                        (
                            name: "bash",
                            description: Some("Use bash as the shell"),
                        ),
                        (
                            name: "zsh",
                            description: Some("Use zsh as the shell"),
                        ),
                        (
                            name: "sh",
                            description: Some("Use sh as the shell"),
                        ),
                        (
                            name: "fish",
                            description: Some("Use fish as the shell"),
                        ),
                        (
                            name: "pwsh",
                            description: Some("Use pwsh as the shell"),
                        ),
                        (
                            name: "powershell",
                            description: Some("Use powershell as the shell"),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--ignore-failure",
                "-i",
            ],
            description: Some("Ignore non-zero exit codes of the benchmarked commands"),
        ),
        (
            names: [
                "--time-unit",
                "-u",
            ],
            description: Some("Set the time unit to use for the benchmark results"),
            arguments: [
                (
                    name: "UNIT",
                    suggestions: [
                        (
                            name: "millisecond",
                        ),
                        (
                            name: "second",
                        ),
                    ],
                    default: Some("second"),
                ),
            ],
        ),
        (
            names: [
                "--export-asciidoc",
            ],
            description: Some("Export the timing summary statistics as an AsciiDoc table to the given file"),
            arguments: [
                (
                    name: "FILE",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--export-csv",
            ],
            description: Some("Export the timing summary statistics as CSV to the given file"),
            arguments: [
                (
                    name: "FILE",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--export-json",
            ],
            description: Some("Export the timing summary statistics and timings of individual runs as JSON to the given file"),
            arguments: [
                (
                    name: "FILE",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--export-markdown",
            ],
            description: Some("Export the timing summary statistics as a Markdown table to the given file"),
            arguments: [
                (
                    name: "FILE",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--show-output",
            ],
            description: Some("Print the stdout and stderr of the benchmark instead of suppressing it"),
        ),
        (
            names: [
                "--command-name",
            ],
            description: Some("Identify a command with the given name"),
            arguments: [
                (
                    name: "NAME",
                ),
            ],
        ),
        (
            names: [
                "--help",
            ],
            description: Some("Prints help message"),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Shows version information"),
        ),
    ],
    arguments: [
        (
            name: "CMD",
            description: Some("Command to benchmark"),
            is_command: true,
        ),
    ],
)
