(
    version: 1,
    command: "ollama",
    description: Some("A command-line tool for managing and deploying machine learning models"),
    subcommands: [
        (
            name: "serve",
            description: Some("Start ollama"),
        ),
        (
            name: "create",
            description: Some("Create a model from a Modelfile"),
            options: [
                (
                    names: [
                        "-f",
                    ],
                    description: Some("Specify Modelfile"),
                    arguments: [
                        (
                            name: "filename",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "show",
            description: Some("Show information for a model"),
            arguments: [
                (
                    name: "model",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "ollama ls | awk '!/NAME/ { print $1 }'",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "run",
            description: Some("Run a model"),
            options: [
                (
                    names: [
                        "--verbose",
                    ],
                    description: Some("Enable verbose output"),
                ),
            ],
            arguments: [
                (
                    name: "model",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "ollama ls | awk '!/NAME/ { print $1 }'",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "stop",
            description: Some("Stop the ollama server"),
            arguments: [
                (
                    name: "model",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "ollama ps | awk '!/NAME/ { print $1 }'",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "pull",
            description: Some("Pull a model from a registry"),
        ),
        (
            name: "push",
            description: Some("Push a model to a registry"),
        ),
        (
            name: "list",
            aliases: [
                "ls",
            ],
            description: Some("List models"),
        ),
        (
            name: "ps",
            description: Some("List running models"),
        ),
        (
            name: "cp",
            description: Some("Copy a model"),
            arguments: [
                (
                    name: "SOURCE",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "ollama ls | awk '!/NAME/ { print $1 }'",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "rm",
            description: Some("Remove a model"),
            arguments: [
                (
                    name: "model",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "ollama ls | awk '!/NAME/ { print $1 }'",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "help",
            description: Some("Help about any command"),
            subcommands: [
                (
                    name: "serve",
                    description: Some("Start ollama"),
                ),
                (
                    name: "create",
                    description: Some("Create a model from a Modelfile"),
                ),
                (
                    name: "show",
                    description: Some("Show information for a model"),
                ),
                (
                    name: "run",
                    description: Some("Run a model"),
                ),
                (
                    name: "stop",
                    description: Some("Stop the ollama server"),
                ),
                (
                    name: "pull",
                    description: Some("Pull a model from a registry"),
                ),
                (
                    name: "push",
                    description: Some("Push a model to a registry"),
                ),
                (
                    name: "list",
                    description: Some("List models"),
                ),
                (
                    name: "ps",
                    description: Some("List running models"),
                ),
                (
                    name: "cp",
                    description: Some("Copy a model"),
                ),
                (
                    name: "rm",
                    description: Some("Remove a model"),
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for ollama"),
            persistent: true,
        ),
        (
            names: [
                "--version",
                "-v",
            ],
            description: Some("Show version information"),
        ),
    ],
)
