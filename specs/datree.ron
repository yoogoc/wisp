(
    version: 1,
    command: "datree",
    description: Some("Datree can be used on the command line to run policies against Kubernetes manifests YAML files or Helm charts"),
    subcommands: [
        (
            name: "completion",
            description: Some("Generate completion script for bash,zsh,fish,powershell"),
        ),
        (
            name: "config",
            description: Some("Internal configuration management for datree config file"),
            subcommands: [
                (
                    name: "get",
                    description: Some("Get configuration value"),
                    options: [
                        (
                            names: [
                                "-h",
                                "--help",
                            ],
                            description: Some("Get value for specific key from datree config.yaml file. Defaults to $HOME/.datree/config.yaml"),
                        ),
                    ],
                ),
                (
                    name: "set",
                    description: Some("Set configuration value"),
                    options: [
                        (
                            names: [
                                "-h",
                                "--help",
                            ],
                            description: Some("Apply value for specific key in datree config.yaml file. Defaults to $HOME/.datree/config.yaml"),
                        ),
                    ],
                ),
            ],
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Help for config"),
                ),
            ],
        ),
        (
            name: "help",
            description: Some("Help about any command"),
            arguments: [
                (
                    name: "",
                    template: [
                        Help,
                    ],
                ),
            ],
        ),
        (
            name: "kustomize",
            description: Some("Generate kustomization files from manifests"),
            subcommands: [
                (
                    name: "test",
                    description: Some("Test kustomization files"),
                    options: [
                        (
                            names: [
                                "--help",
                                "-h",
                            ],
                            description: Some("Help for 'test'"),
                        ),
                        (
                            names: [
                                "--ignore-missing-schemas",
                            ],
                            description: Some("Ignore missing schemas when executing schema validation step"),
                        ),
                        (
                            names: [
                                "--no-record",
                            ],
                            description: Some("Do not send policy checks metadata to the backend"),
                        ),
                        (
                            names: [
                                "--only-k8s-files",
                            ],
                            description: Some("Evaluate only valid yaml files with the properties 'apiVersion' and 'kind'. Ignore everything else"),
                        ),
                        (
                            names: [
                                "-o",
                                "--output",
                            ],
                            description: Some("Define output format (simple, yaml, json, xml, JUnit)"),
                            arguments: [
                                (
                                    name: "output",
                                    description: Some("Output format"),
                                    suggestions: [
                                        (
                                            name: "simple",
                                            description: Some("Simple output without colors"),
                                        ),
                                        (
                                            name: "yaml",
                                            description: Some("YAML output"),
                                        ),
                                        (
                                            name: "json",
                                            description: Some("JSON output"),
                                        ),
                                        (
                                            name: "xml",
                                            description: Some("XML output"),
                                        ),
                                        (
                                            name: "junit",
                                            description: Some("JUnit output"),
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-p",
                                "--policy",
                            ],
                            description: Some("Policy name to run against"),
                            arguments: [
                                (
                                    name: "policy",
                                    description: Some("String"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--policy-config",
                            ],
                            description: Some("Path for local policies configuration file"),
                            arguments: [
                                (
                                    name: "",
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--schema-location",
                            ],
                            description: Some("Override schemas location search path (can be specified multiple times)"),
                            arguments: [
                                (
                                    name: "stringArray",
                                    description: Some("String array"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "-s",
                                "--schema-version",
                            ],
                            description: Some("Set kubernetes version to validate against. Defaults to 1.19.0"),
                        ),
                        (
                            names: [
                                "--verbose",
                            ],
                            description: Some("Display 'How to Fix' link"),
                        ),
                    ],
                ),
            ],
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Help for kustomize"),
                ),
            ],
        ),
        (
            name: "publish",
            description: Some("Publish policies configuration for given <fileName>. Input should be the path to the Policy-as-Code yaml configuration file. ## Note You need to first enable Policy-as-Code (PaC) on the settings page in the dashboard"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Help for publish"),
                ),
            ],
            arguments: [
                (
                    name: "file path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "test",
            description: Some("Trigger a policy check, provide a Kubernetes configuration file path or a glob pattern"),
            options: [
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Help for 'test'"),
                ),
                (
                    names: [
                        "--ignore-missing-schemas",
                    ],
                    description: Some("Ignore missing schemas when executing schema validation step"),
                ),
                (
                    names: [
                        "--no-record",
                    ],
                    description: Some("Do not send policy checks metadata to the backend"),
                ),
                (
                    names: [
                        "--only-k8s-files",
                    ],
                    description: Some("Evaluate only valid yaml files with the properties 'apiVersion' and 'kind'. Ignore everything else"),
                ),
                (
                    names: [
                        "-o",
                        "--output",
                    ],
                    description: Some("Define output format (simple, yaml, json, xml, JUnit)"),
                    arguments: [
                        (
                            name: "output",
                            description: Some("Output format"),
                            suggestions: [
                                (
                                    name: "simple",
                                    description: Some("Simple output without colors"),
                                ),
                                (
                                    name: "yaml",
                                    description: Some("YAML output"),
                                ),
                                (
                                    name: "json",
                                    description: Some("JSON output"),
                                ),
                                (
                                    name: "xml",
                                    description: Some("XML output"),
                                ),
                                (
                                    name: "junit",
                                    description: Some("JUnit output"),
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-p",
                        "--policy",
                    ],
                    description: Some("Policy name to run against"),
                    arguments: [
                        (
                            name: "policy",
                            description: Some("String"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--policy-config",
                    ],
                    description: Some("Path for local policies configuration file"),
                    arguments: [
                        (
                            name: "",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--schema-location",
                    ],
                    description: Some("Override schemas location search path (can be specified multiple times)"),
                    arguments: [
                        (
                            name: "stringArray",
                            description: Some("String array"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-s",
                        "--schema-version",
                    ],
                    description: Some("Set kubernetes version to validate against. Defaults to 1.19.0"),
                ),
                (
                    names: [
                        "--verbose",
                    ],
                    description: Some("Display 'How to Fix' link"),
                ),
            ],
            arguments: [
                (
                    name: "file path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "version",
            description: Some("Print the version number"),
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for datree"),
        ),
    ],
)
