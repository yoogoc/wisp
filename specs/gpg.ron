(
    version: 1,
    command: "gpg",
    description: Some("Encryption and signing tool"),
    subcommands: [
        (
            name: "-s",
            aliases: [
                "--sign",
            ],
            description: Some("Make a signature"),
        ),
        (
            name: "--clearsign",
            description: Some("Make a clear text signature"),
        ),
        (
            name: "-b",
            aliases: [
                "--detach-sign",
            ],
            description: Some("Make a detached signature"),
        ),
        (
            name: "-e",
            aliases: [
                "--encrypt",
            ],
            description: Some("Encrypt data"),
        ),
        (
            name: "-c",
            aliases: [
                "--symmetric",
            ],
            description: Some("Encrypt with symmetric cipher only"),
        ),
        (
            name: "--store",
            description: Some("Store only (make a simple RFC1991 packet)"),
        ),
        (
            name: "--decrypt",
            description: Some("Decrypt file (or stdin if no file is specified) and write it to stdout"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "--verify",
            description: Some("Assume that sigfile is a signature and verify it without generating any output"),
            arguments: [
                (
                    name: "sigfile",
                    template: [
                        FilePaths,
                    ],
                    optional: true,
                ),
                (
                    name: "signed-files",
                    template: [
                        FilePaths,
                    ],
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "--verify-files",
            description: Some("Special version of --verify which does not work with detached signatures"),
            arguments: [
                (
                    name: "files",
                    template: [
                        FilePaths,
                    ],
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "--list-keys",
            aliases: [
                "--list-public-keys",
            ],
            description: Some("List all keys from public keyrings, or just the ones given on the command line"),
            arguments: [
                (
                    name: "names",
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "--list-secret-keys",
            description: Some("List all keys from secret keyrings, or just the ones given on the command line"),
            arguments: [
                (
                    name: "names",
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "--list-sigs",
            description: Some("Same as --list-keys, but the signatures are listed too"),
            arguments: [
                (
                    name: "names",
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "--check-sigs",
            description: Some("Same as --list-sigs, but the signatures are verified"),
            arguments: [
                (
                    name: "names",
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "--fingerprint",
            description: Some("List all keys with their fingerprints"),
            arguments: [
                (
                    name: "names",
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "--list-packets",
            description: Some("List only the sequence of packets"),
        ),
        (
            name: "--gen-key",
            description: Some("Generate a new key pair"),
        ),
        (
            name: "--edit-key",
            description: Some("Present a menu which enables you to do all key related tasks"),
            arguments: [
                (
                    name: "name",
                ),
            ],
        ),
        (
            name: "--sign-key",
            description: Some("Sign a public key with you secret key"),
            arguments: [
                (
                    name: "name",
                ),
            ],
        ),
        (
            name: "--lsign-key",
            description: Some("Sign a public key with you secret key but mark it as non-exportable"),
            arguments: [
                (
                    name: "name",
                ),
            ],
        ),
        (
            name: "--trusted-key",
            description: Some("Assume that the specified key is as trustworthy as one of your own secret keys"),
            arguments: [
                (
                    name: "long key ID",
                ),
            ],
        ),
        (
            name: "--delete-key",
            description: Some("Remove key from the public keyring"),
            arguments: [
                (
                    name: "name",
                ),
            ],
        ),
        (
            name: "--delete-secret-key",
            description: Some("Remove key from the secret and public keyring"),
            arguments: [
                (
                    name: "name",
                ),
            ],
        ),
        (
            name: "--gen-revoke",
            description: Some("Generate a revocation certificate for the complete key"),
        ),
        (
            name: "--export",
            description: Some("Either export all keys from all keyrings or those of the given names"),
            arguments: [
                (
                    name: "names",
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "--send-keys",
            description: Some("Same as --export but sends the keys to a keyserver"),
            arguments: [
                (
                    name: "names",
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "--export-all",
            description: Some("Same as --export, but also exports keys which are not compatible to OpenPGP"),
            arguments: [
                (
                    name: "names",
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "--export-secret-keys",
            description: Some("Same as --export, but exports the secret keys"),
            arguments: [
                (
                    name: "names",
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "--export-secret-subkeys",
            description: Some("Same as --export, but exports the secret subkeys"),
            arguments: [
                (
                    name: "names",
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "--import",
            description: Some("Import/merge keys. This adds the given keys to the keyring"),
            arguments: [
                (
                    name: "files",
                    template: [
                        FilePaths,
                    ],
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "--fast-import",
            description: Some("--import but does not build the trustdb"),
            arguments: [
                (
                    name: "files",
                    template: [
                        FilePaths,
                    ],
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "--recv-keys",
            description: Some("Import the keys with the given key IDs from a HKP keyserver"),
            arguments: [
                (
                    name: "key IDs",
                    variadic: true,
                ),
            ],
        ),
        (
            name: "--export-ownertrust",
            description: Some("List the ownertrust values in ASCII format"),
        ),
        (
            name: "--import-ownertrust",
            description: Some("Update the trustdb with the ownertrust values stored in files"),
            arguments: [
                (
                    name: "files",
                    template: [
                        FilePaths,
                    ],
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "--print-md",
            description: Some("Print message digest of algorithm ALGO for all given files of stdin"),
            arguments: [
                (
                    name: "algo",
                    generators: [
                        (
                            script: [
                                "gpg",
                                "--version",
                            ],
                            has_post_process: true,
                        ),
                    ],
                    default: Some("*"),
                ),
                (
                    name: "files",
                    template: [
                        FilePaths,
                    ],
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "--gen-random",
            description: Some("Emit COUNT random bytes of the given quality level"),
            arguments: [
                (
                    name: "0|1|2",
                    suggestions: [
                        (
                            name: "0",
                        ),
                        (
                            name: "1",
                        ),
                        (
                            name: "2",
                        ),
                    ],
                ),
                (
                    name: "files",
                    template: [
                        FilePaths,
                    ],
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "--gen-prime",
            description: Some("Generate prime numbers"),
            arguments: [
                (
                    name: "mode",
                ),
                (
                    name: "bits",
                ),
                (
                    name: "qbits",
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "--version",
            description: Some("Print version information"),
        ),
        (
            name: "--warranty",
            description: Some("Print warranty information"),
        ),
        (
            name: "-h",
            aliases: [
                "--help",
            ],
            description: Some("Print usage information"),
        ),
    ],
    options: [
        (
            names: [
                "--homedir",
            ],
            description: Some("Set the name of the home directory"),
            arguments: [
                (
                    name: "directory",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--options",
            ],
            description: Some("Read options from file"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
            exclusive_on: [
                "--no-options",
            ],
        ),
        (
            names: [
                "-a",
                "--armour",
            ],
            description: Some("Create ASCII armored output"),
        ),
        (
            names: [
                "-o",
                "--output",
            ],
            description: Some("Write output to file"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-u",
                "--local-user",
            ],
            description: Some("Use name as the user ID to sign"),
            arguments: [
                (
                    name: "name",
                ),
            ],
        ),
        (
            names: [
                "--default-key",
            ],
            description: Some("Use name as default user ID for signatures"),
            arguments: [
                (
                    name: "name",
                ),
            ],
        ),
        (
            names: [
                "-r",
                "--recipient",
            ],
            description: Some("Encrypt for user id name"),
            arguments: [
                (
                    name: "name",
                ),
            ],
        ),
        (
            names: [
                "--default-recipient",
            ],
            description: Some("Use name as default recipient"),
            arguments: [
                (
                    name: "name",
                ),
            ],
            exclusive_on: [
                "--no-default-recipient",
                "--default-recipient-self",
            ],
        ),
        (
            names: [
                "--default-recipient-self",
            ],
            description: Some("Use the default key as default recipient"),
            exclusive_on: [
                "--default-recipient",
                "--no-default-recipient",
            ],
        ),
        (
            names: [
                "--no-default-recipient",
            ],
            description: Some("Reset --default-recipient and --default-recipient-self"),
            exclusive_on: [
                "--default-recipient",
                "--default-recipient-self",
            ],
        ),
        (
            names: [
                "--encrypt-to",
            ],
            description: Some("Same as --recipient but this one is intended for in the options file"),
            arguments: [
                (
                    name: "name",
                ),
            ],
            exclusive_on: [
                "--no-encrypt-to",
            ],
        ),
        (
            names: [
                "--no-encrypt-to",
            ],
            description: Some("Disable the use of all --encrypt-to keys"),
            exclusive_on: [
                "--encrypt-to",
            ],
        ),
        (
            names: [
                "-v",
                "--verbose",
            ],
            description: Some("Give more information during processing"),
            exclusive_on: [
                "--no-verbose",
            ],
        ),
        (
            names: [
                "-q",
                "--quiet",
            ],
            description: Some("Try to be as quiet as possible"),
        ),
        (
            names: [
                "-Z",
            ],
            description: Some("Set compression level to n"),
            arguments: [
                (
                    name: "n",
                    suggestions: [
                        (
                            name: "0",
                        ),
                        (
                            name: "1",
                        ),
                        (
                            name: "2",
                        ),
                        (
                            name: "3",
                        ),
                        (
                            name: "4",
                        ),
                        (
                            name: "5",
                        ),
                        (
                            name: "6",
                        ),
                    ],
                    default: Some("6"),
                ),
            ],
        ),
        (
            names: [
                "-t",
                "--textmode",
            ],
            description: Some("Use canonical text mode"),
        ),
        (
            names: [
                "-n",
                "--dry-run",
            ],
            description: Some("Don't make any changes"),
        ),
        (
            names: [
                "-i",
                "--interactive",
            ],
            description: Some("Prompt before overwriting any files"),
        ),
        (
            names: [
                "--batch",
            ],
            description: Some("Use batch mode"),
            exclusive_on: [
                "--no-batch",
            ],
        ),
        (
            names: [
                "--no-tty",
            ],
            description: Some("Make sure that the TTY is never used for any output"),
        ),
        (
            names: [
                "--no-batch",
            ],
            description: Some("Disable batch mode"),
            exclusive_on: [
                "--batch",
            ],
        ),
        (
            names: [
                "--yes",
            ],
            description: Some("Assume \"yes\" on most questions"),
            exclusive_on: [
                "--no",
            ],
        ),
        (
            names: [
                "--no",
            ],
            description: Some("Assume \"no\" on most questions"),
            exclusive_on: [
                "--yes",
            ],
        ),
        (
            names: [
                "--always-trust",
            ],
            description: Some("Skip key validation"),
        ),
        (
            names: [
                "--keyserver",
            ],
            description: Some("Use name to lookup keys which are not yet in your keyring"),
            arguments: [
                (
                    name: "name",
                ),
            ],
        ),
        (
            names: [
                "--no-auto-key-retrieve",
            ],
            description: Some("Disables the automatic retrieving of keys"),
        ),
        (
            names: [
                "--honor-http-proxy",
            ],
            description: Some("Try to access the keyserver over the proxy"),
        ),
        (
            names: [
                "--keyring",
            ],
            description: Some("Add file to the list of keyrings"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--secret-keyring",
            ],
            description: Some("Same as --keyring but for the secret keyrings"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--charset",
            ],
            description: Some("Set the name of the native character set"),
            arguments: [
                (
                    name: "name",
                    suggestions: [
                        (
                            name: "iso-8859-1",
                            description: Some("This is the default Latin 1 set"),
                        ),
                        (
                            name: "iso-8859-2",
                            description: Some("The Latin 2 set"),
                        ),
                        (
                            name: "koi8-r",
                            description: Some("The usual Russian set (rfc1489)"),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--utf8-strings",
            ],
            description: Some("Assume that the arguments are already given as UTF8"),
            exclusive_on: [
                "--no-utf8-strings",
            ],
        ),
        (
            names: [
                "--no-utf8-strings",
            ],
            exclusive_on: [
                "--utf8-strings",
            ],
        ),
        (
            names: [
                "--no-options",
            ],
            description: Some("Shortcut for \"--options /dev/null\""),
            exclusive_on: [
                "--options",
            ],
        ),
        (
            names: [
                "--load-extension",
            ],
            description: Some("Load an extension module"),
            arguments: [
                (
                    name: "name",
                    description: Some("If name does not contain a slash it is searched in \"/usr/local/lib/gnupg\""),
                ),
            ],
        ),
        (
            names: [
                "--debug",
            ],
            description: Some("Set debugging flags"),
            arguments: [
                (
                    name: "flags",
                ),
            ],
        ),
        (
            names: [
                "--debug-all",
            ],
            description: Some("Set all useful debugging flags"),
        ),
        (
            names: [
                "--status-fd",
            ],
            description: Some("Write special status strings to the file descriptor n"),
            arguments: [
                (
                    name: "n",
                ),
            ],
        ),
        (
            names: [
                "--logger-fd",
            ],
            description: Some("Write log output to file descriptor n and not to stderr"),
            arguments: [
                (
                    name: "n",
                ),
            ],
        ),
        (
            names: [
                "--no-comment",
            ],
            description: Some("Do not write comment packets"),
            exclusive_on: [
                "--comment",
                "--default-comment",
            ],
        ),
        (
            names: [
                "--comment",
            ],
            description: Some("Use string as comment string in clear text signatures"),
            arguments: [
                (
                    name: "string",
                ),
            ],
            exclusive_on: [
                "--no-comment",
                "--default-comment",
            ],
        ),
        (
            names: [
                "--default-comment",
            ],
            description: Some("Force to write the standard comment string"),
            exclusive_on: [
                "--no-comment",
                "--comment",
            ],
        ),
        (
            names: [
                "--no-version",
            ],
            description: Some("Omit the version string in clear text signatures"),
        ),
        (
            names: [
                "--emit-version",
            ],
            description: Some("Force to write the version string"),
        ),
        (
            names: [
                "-N",
                "--notation-data",
            ],
            description: Some("Put the name value pair into the signature as notation data"),
            arguments: [
                (
                    name: "name=value",
                ),
            ],
        ),
        (
            names: [
                "--set-policy-url",
            ],
            description: Some("Use string as Policy URL for signatures (rfc2440:5.2.3.19)"),
            arguments: [
                (
                    name: "string",
                ),
            ],
        ),
        (
            names: [
                "--set-filename",
            ],
            description: Some("Use string as the name of file which is stored in messages"),
            arguments: [
                (
                    name: "string",
                ),
            ],
        ),
        (
            names: [
                "--use-embedded-filename",
            ],
            description: Some("Try to create a file with a name as embedded in the data"),
        ),
        (
            names: [
                "--completes-needed",
            ],
            description: Some("Number of completely trusted users to introduce a new key signer"),
            arguments: [
                (
                    name: "n",
                    default: Some("1"),
                ),
            ],
        ),
        (
            names: [
                "--marginals-needed",
            ],
            description: Some("Number of marginally trusted users to introduce a new key signer"),
            arguments: [
                (
                    name: "n",
                    default: Some("3"),
                ),
            ],
        ),
        (
            names: [
                "--max-cert-depth",
            ],
            description: Some("Maximum depth of a certification chain"),
            arguments: [
                (
                    name: "n",
                    default: Some("5"),
                ),
            ],
        ),
        (
            names: [
                "--cipher-algo",
            ],
            description: Some("Use name as cipher algorithm"),
            arguments: [
                (
                    name: "name",
                    generators: [
                        (
                            script: [
                                "gpg",
                                "--version",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--digest-algo",
            ],
            description: Some("Use name as message digest algorithm"),
            arguments: [
                (
                    name: "name",
                    generators: [
                        (
                            script: [
                                "gpg",
                                "--version",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--s2k-cipher-algo",
            ],
            description: Some("Use name as the cipher algorithm used to protect secret keys"),
            arguments: [
                (
                    name: "name",
                    generators: [
                        (
                            script: [
                                "gpg",
                                "--version",
                            ],
                            has_post_process: true,
                        ),
                    ],
                    default: Some("BLOWFISH"),
                ),
            ],
        ),
        (
            names: [
                "--s2k-digest-algo",
            ],
            description: Some("Use name as the digest algorithm used to mangle the passphrases"),
            arguments: [
                (
                    name: "name",
                    generators: [
                        (
                            script: [
                                "gpg",
                                "--version",
                            ],
                            has_post_process: true,
                        ),
                    ],
                    default: Some("RIPE-MD-160"),
                ),
            ],
        ),
        (
            names: [
                "--s2k-mode",
            ],
            description: Some("Selects how passphrases are mangled"),
            arguments: [
                (
                    name: "n",
                    suggestions: [
                        (
                            name: "0",
                            description: Some("A plain passphrase (which is not recommended) will be used"),
                        ),
                        (
                            name: "1",
                            description: Some("Adds a salt to the passphrase"),
                        ),
                        (
                            name: "3",
                            description: Some("Iterates the whole process a couple of times"),
                        ),
                    ],
                    default: Some("1"),
                ),
            ],
        ),
        (
            names: [
                "--compress-algo",
            ],
            description: Some("Use compress algorithm n"),
            arguments: [
                (
                    name: "n",
                    suggestions: [
                        (
                            name: "1",
                            description: Some("Use the old zlib version (RFC1951) which is used by PGP"),
                        ),
                        (
                            name: "2",
                            description: Some("RFC1950 compression"),
                        ),
                    ],
                    default: Some("2"),
                ),
            ],
        ),
        (
            names: [
                "--disable-cipher-algo",
            ],
            description: Some("Never allow the use of name as cipher algorithm"),
            arguments: [
                (
                    name: "name",
                    generators: [
                        (
                            script: [
                                "gpg",
                                "--version",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--disable-pubkey-algo",
            ],
            description: Some("Never allow the use of name as public key algorithm"),
            arguments: [
                (
                    name: "name",
                ),
            ],
        ),
        (
            names: [
                "--throw-keyid",
            ],
            description: Some("Do not put the keyid into encrypted packets"),
        ),
        (
            names: [
                "--not-dash-escaped",
            ],
            description: Some("Makes signatures usable for patch files"),
        ),
        (
            names: [
                "--escape-from-lines",
            ],
            description: Some("Handle \"<From\" in emails"),
        ),
        (
            names: [
                "--passphrase-fd",
            ],
            description: Some("Read the passphrase from file descriptor n"),
            arguments: [
                (
                    name: "n",
                    default: Some("0"),
                ),
            ],
        ),
        (
            names: [
                "--command-fd",
            ],
            description: Some("This is a replacement for the depreciated shared-memory IPC mode"),
            arguments: [
                (
                    name: "n",
                    default: Some("0"),
                ),
            ],
        ),
        (
            names: [
                "--rfc1991",
            ],
            description: Some("Try to be more RFC1991 (PGP 2.x) compliant"),
        ),
        (
            names: [
                "--openpgp",
            ],
            description: Some("Reset all packet, cipher and digest options to OpenPGP"),
        ),
        (
            names: [
                "--force-v3-sigs",
            ],
            description: Some("Forces v3 signatures for signatures on data"),
        ),
        (
            names: [
                "--force-mdc",
            ],
            description: Some("Force encryption with appended manipulation code"),
        ),
        (
            names: [
                "--allow-non-selfsigned-uid",
            ],
            description: Some("Allow non self-signed user IDs"),
        ),
        (
            names: [
                "--allow-freeform-uid",
            ],
            description: Some("Disable all checks on the form of the user ID"),
        ),
        (
            names: [
                "--ignore-time-conflict",
            ],
            description: Some("Makes time checks just a warning"),
        ),
        (
            names: [
                "--lock-once",
            ],
            description: Some("Do not release the lock until the process terminates"),
            exclusive_on: [
                "--lock-multiple",
                "--lock-never",
            ],
        ),
        (
            names: [
                "--lock-multiple",
            ],
            description: Some("Release the locks every time one is no longer needed"),
            exclusive_on: [
                "--lock-once",
                "--lock-never",
            ],
        ),
        (
            names: [
                "--lock-never",
            ],
            description: Some("Disable locking entirely"),
            exclusive_on: [
                "--lock-once",
                "--lock-multiple",
            ],
        ),
        (
            names: [
                "--no-random-seed-file",
            ],
            description: Some("Disable random pool cache"),
        ),
        (
            names: [
                "--no-verbose",
            ],
            description: Some("Reset verbose level to 0"),
            exclusive_on: [
                "--verbose",
            ],
        ),
        (
            names: [
                "--no-greeting",
            ],
            description: Some("Suppress the initial copyright message"),
        ),
        (
            names: [
                "--no-secmem-warning",
            ],
            description: Some("Suppress the \"using insecure memory\" warning"),
        ),
        (
            names: [
                "--no-armor",
            ],
            description: Some("Assume the input data is not in ASCII armored format"),
        ),
        (
            names: [
                "--no-default-keyring",
            ],
            description: Some("Do not add the keyrings to the list of keyrings"),
        ),
        (
            names: [
                "--skip-verify",
            ],
            description: Some("Skip the signature verification step"),
        ),
        (
            names: [
                "--with-colons",
            ],
            description: Some("Print key listings delimited by colons"),
        ),
        (
            names: [
                "--with-key-data",
            ],
            description: Some("--with-colons with the public key data"),
        ),
        (
            names: [
                "--with-fingerprint",
            ],
            description: Some("--fingerprint with a different format"),
        ),
        (
            names: [
                "--fast-list-mode",
            ],
            description: Some("Changes the list commands to work faster"),
        ),
        (
            names: [
                "--list-only",
            ],
            description: Some("Skip the decryption pass"),
        ),
        (
            names: [
                "--no-literal",
            ],
            description: Some("This is not for normal use"),
        ),
        (
            names: [
                "--set-filesize",
            ],
            description: Some("This is not for normal use"),
        ),
        (
            names: [
                "--emulate-md-encode-bug",
            ],
            description: Some("Enables workaround to check faulty signatures"),
        ),
        (
            names: [
                "--show-session-key",
            ],
            description: Some("Display the session key used for one message"),
        ),
        (
            names: [
                "--override-session-key",
            ],
            description: Some("Don't use the public key but the session key string"),
            arguments: [
                (
                    name: "string",
                ),
            ],
        ),
        (
            names: [
                "--merge-only",
            ],
            description: Some("Don't insert new keys into the keyrings"),
        ),
        (
            names: [
                "--try-all-secrets",
            ],
            description: Some("Try all secret keys in turn to find the right one"),
        ),
