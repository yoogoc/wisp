            ],
            description: Some("Connections to keep open"),
            arguments: [
                (
                    name: "Number",
                ),
            ],
        ),
        (
            names: [
                "-d",
                "--duration",
            ],
            description: Some("Duration of test"),
            arguments: [
                (
                    name: "Time",
                ),
            ],
        ),
        (
            names: [
                "-t",
                "--threads",
            ],
            description: Some("Number of threads"),
            arguments: [
                (
                    name: "Number",
                ),
            ],
        ),
        (
            names: [
                "-s",
                "--script",
            ],
            description: Some("Load Lua script file"),
            arguments: [
                (
                    name: "Script",
                ),
            ],
        ),
        (
            names: [
                "-H",
                "--header",
            ],
            description: Some("Add header to request"),
            arguments: [
                (
                    name: "Header",
                ),
            ],
        ),
        (
            names: [
                "--latency",
            ],
            description: Some("Print latency statistics"),
        ),
        (
            names: [
                "--timeout",
            ],
            description: Some("Socket/request timeout"),
            arguments: [
                (
                    name: "Time",
                ),
            ],
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Print version details"),
        ),
        (
            names: [
