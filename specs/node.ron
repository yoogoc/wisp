(
    version: 1,
    command: "node",
    description: Some("Run the node interpreter"),
    options: [
        (
            names: [
                "-e",
                "--eval=...",
            ],
            description: Some("Evaluate script"),
            arguments: [
                (
                    name: "",
                ),
            ],
            presentation: (
                insert_value: Some("-e '{cursor}'"),
            ),
        ),
        (
            names: [
                "--watch",
            ],
            description: Some("Watch input files"),
        ),
        (
            names: [
                "--watch-path",
            ],
            description: Some("Specify a watch directory or file"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "--watch-preserve-output",
            ],
            description: Some("Disable the clearing of the console when watch mode restarts the process"),
            depends_on: [
                "--watch",
                "--watch-path",
            ],
        ),
        (
            names: [
                "--env-file",
            ],
            description: Some("Specify a file containing environment variables"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "-p",
                "--print",
            ],
            description: Some("Evaluate script and print result"),
        ),
        (
            names: [
                "-c",
                "--check",
            ],
            description: Some("Syntax check script without executing"),
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Print Node.js version"),
        ),
        (
            names: [
                "-i",
                "--interactive",
            ],
            description: Some("Always enter the REPL even if stdin does not appear to be a terminal"),
        ),
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Print node command line options (currently set)"),
        ),
        (
            names: [
                "--inspect",
            ],
            description: Some("Activate inspector on host:port (default: 127.0.0.1:9229)"),
            arguments: [
                (
                    name: "[host:]port",
                    optional: true,
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "--preserve-symlinks",
            ],
            description: Some("Follows symlinks to directories when examining source code and templates for translation strings"),
        ),
    ],
    arguments: [
        (
            name: "node script",
            generators: [
                (
                    has_custom: true,
                    has_dynamic_trigger: true,
                    has_dynamic_query_term: true,
                ),
            ],
            is_script: true,
        ),
    ],
    has_generate_spec: true,
)
