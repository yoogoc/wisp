(
    version: 1,
    command: "env",
    description: Some("Set environment and execute command, or print environment"),
    options: [
        (
            names: [
                "-0",
            ],
            description: Some("End each output line with NUL, not newline"),
        ),
        (
            names: [
                "-i",
                "-",
            ],
            description: Some("Start with an empty environment"),
        ),
        (
            names: [
                "-v",
            ],
            description: Some("Print verbose logs"),
        ),
        (
            names: [
                "-u",
            ],
            description: Some("Remove variable from the environment"),
            arguments: [
                (
                    name: "name",
                    generators: [
                        (
                            has_custom: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-P",
            ],
            description: Some("Search the given directories for the utility, rather than the PATH"),
            arguments: [
                (
                    name: "altpath",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-S",
            ],
            description: Some("Split the given string into separate arguments"),
            arguments: [
                (
                    name: "string",
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "name=value ...",
            description: Some("Set environment variables"),
            optional: true,
        ),
        (
            name: "utility",
            description: Some("Utility to run"),
            optional: true,
            is_command: true,
        ),
    ],
)
