(
    version: 1,
    command: "black",
    description: Some("Python code formatter"),
    options: [
        (
            names: [
                "--code",
                "-c",
            ],
            description: Some("Format the code passed in as a string"),
            arguments: [
                (
                    name: "string",
                ),
            ],
        ),
        (
            names: [
                "--line-length",
                "-l",
            ],
            description: Some("How many characters per line to allow"),
            arguments: [
                (
                    name: "line length",
                    default: Some("88"),
                ),
            ],
        ),
        (
            names: [
                "--target-version",
                "-t",
            ],
            description: Some("Python versions that should be supported"),
            arguments: [
                (
                    name: "python version",
                    suggestions: [
                        (
                            name: "py33",
                        ),
                        (
                            name: "py34",
                        ),
                        (
                            name: "py35",
                        ),
                        (
                            name: "py36",
                        ),
                        (
                            name: "py37",
                        ),
                        (
                            name: "py38",
                        ),
                        (
                            name: "py39",
                        ),
                        (
                            name: "py310",
                        ),
                    ],
                    default: Some("per-file auto-detection"),
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "--pyi",
            ],
            description: Some("Format all input files regardless of file extension"),
        ),
        (
            names: [
                "--ipynb",
            ],
            description: Some("Format all input files like Jupyter Notebooks regardless of file extension"),
        ),
        (
            names: [
                "--python-cell-magics",
            ],
            description: Some("Add the given magic to the list of known python-magics"),
            arguments: [
                (
                    name: "python-magic",
                    suggestions: [
                        (
                            name: "python",
                        ),
                        (
                            name: "python3",
                        ),
                        (
                            name: "timeit",
                        ),
                        (
                            name: "prun",
                        ),
                        (
                            name: "time",
                        ),
                        (
                            name: "pypy",
                        ),
                        (
                            name: "capture",
                        ),
                    ],
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "--skip-string-normalization",
                "-S",
            ],
            description: Some("Don't normalize string quotes or prefixes"),
        ),
        (
            names: [
                "--skip-magic-trailing-comma",
                "-C",
            ],
            description: Some("Don't use trailing commas as a reason to split lines"),
        ),
        (
            names: [
                "--preview",
            ],
            description: Some("Enable potentially disruptive style changes"),
        ),
        (
            names: [
                "--check",
            ],
            description: Some("Don't write the files back, just return the status"),
        ),
        (
            names: [
                "--diff",
            ],
            description: Some("Don't write the files back, just output a diff for each file on stdout"),
        ),
        (
            names: [
                "--color",
            ],
            description: Some("Show colored diff"),
            exclusive_on: [
                "--no-color",
            ],
            depends_on: [
                "--diff",
            ],
        ),
        (
            names: [
                "--no-color",
            ],
            description: Some("Show uncolored diff"),
            exclusive_on: [
                "--color",
            ],
            depends_on: [
                "--diff",
            ],
        ),
        (
            names: [
                "--fast",
            ],
            description: Some("Skip temporary sanity checks"),
            exclusive_on: [
                "--safe",
            ],
        ),
        (
            names: [
                "--safe",
            ],
            description: Some("Run temporary sanity checks"),
            exclusive_on: [
                "--fast",
            ],
        ),
        (
            names: [
                "--required-version",
            ],
            description: Some("Require a specific version of Black"),
            arguments: [
                (
                    name: "version",
                    generators: [
                        (
                            script: [
                                "gh",
                                "release",
                                "list",
                                "--repo",
                                "psf/black",
                            ],
                            has_post_process: true,
                            cache: Some((
                                ttl_ms: Some(172800000),
                                stale_while_revalidate: true,
                            )),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--include",
            ],
            description: Some("Regex that matches files and directories that should be included on recursive searches"),
            arguments: [
                (
                    name: "Regex",
                ),
            ],
        ),
        (
            names: [
                "--exclude",
            ],
            description: Some("Regex that matches files and directories that should be excluded on recursive searches"),
            arguments: [
                (
                    name: "Regex",
                ),
            ],
        ),
        (
            names: [
                "--extend-exclude",
            ],
            description: Some("Additional exlusions"),
            arguments: [
                (
                    name: "Regex",
                ),
            ],
        ),
        (
            names: [
                "--force-exclude",
            ],
            description: Some("Exlude matching files and folders even when passed explicitly"),
            arguments: [
                (
                    name: "Regex",
                ),
            ],
        ),
        (
            names: [
                "--stdin-filename",
            ],
            description: Some("The name of the file when passing it through stdin"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--workers",
                "-W",
            ],
            description: Some("Number of parallel workers"),
            arguments: [
                (
                    name: "integer",
                    default: Some("2"),
                ),
            ],
        ),
        (
            names: [
                "--quiet",
                "-q",
            ],
            description: Some("Don't emit non-error messages to stderr"),
        ),
        (
            names: [
                "--verbose",
                "-v",
            ],
            description: Some("Also emit messages about files that were not changed or were ignored due to exclusion patterns"),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Show the version"),
        ),
        (
            names: [
                "--config",
            ],
            description: Some("Read configuration from filepath"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show usage information"),
        ),
    ],
    arguments: [
        (
            name: "file or directory",
            template: [
                FilePaths,
            ],
            variadic: true,
        ),
    ],
)
