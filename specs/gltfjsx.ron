(
    version: 1,
    command: "gltfjsx",
    description: Some("GLTF to JSX converter"),
    options: [
        (
            names: [
                "-t",
                "--types",
            ],
            description: Some("Add Typescript definitions"),
        ),
        (
            names: [
                "-v",
                "--verbose",
            ],
            description: Some("Verbose output w/ names and empty groups"),
        ),
        (
            names: [
                "-m",
                "--meta",
            ],
            description: Some("Include metadata (as userData)"),
        ),
        (
            names: [
                "-s",
                "--shadows",
            ],
            description: Some("Let meshes cast and receive shadows"),
        ),
        (
            names: [
                "-w",
                "--printwidth",
            ],
            description: Some("Prettier printWidth (default: 120)"),
            arguments: [
                (
                    name: "width",
                ),
            ],
        ),
        (
            names: [
                "-p",
                "--precision",
            ],
            description: Some("Number of fractional digits (default: 2)"),
            arguments: [
                (
                    name: "digits",
                ),
            ],
        ),
        (
            names: [
                "-d",
                "--draco",
            ],
            description: Some("Draco binary path"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-r",
                "--root",
            ],
            description: Some("Sets directory from which .gltf file is served"),
            arguments: [
                (
                    name: "root",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-D",
                "--debug",
            ],
            description: Some("Debug output"),
        ),
    ],
    arguments: [
        (
            name: "file",
            template: [
                FilePaths,
            ],
        ),
    ],
)
