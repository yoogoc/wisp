(
    version: 1,
    command: "osascript",
    description: Some("Execute OSA scripts (AppleScript, JavaScript, etc.)"),
    options: [
        (
            names: [
                "-e",
            ],
            description: Some("Enter one line of a script"),
            arguments: [
                (
                    name: "statement",
                ),
            ],
        ),
        (
            names: [
                "-i",
            ],
            description: Some("Interactive mode"),
        ),
        (
            names: [
                "-l",
            ],
            description: Some("Override the language for any plain text files"),
            arguments: [
                (
                    name: "language",
                ),
            ],
        ),
        (
            names: [
                "-s",
            ],
            description: Some("Modify the output style"),
            arguments: [
                (
                    name: "flags",
                    suggestions: [
                        (
                            name: "h",
                            description: Some("Print values in human-readable form (default)"),
                        ),
                        (
                            name: "s",
                            description: Some("Print values in recompilable source form"),
                        ),
                        (
                            name: "e",
                            description: Some("Print script errors to stderr (default)"),
                        ),
                        (
                            name: "o",
                            description: Some("Print script errors to stdout"),
                        ),
                    ],
                    variadic: true,
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "script",
            generators: [
                (
                    has_custom: true,
                    has_dynamic_trigger: true,
                    has_dynamic_query_term: true,
                ),
            ],
            optional: true,
            is_script: true,
        ),
    ],
)
