(
    version: 1,
    command: "rake",
    description: Some("A ruby build program with capabilities similar to make"),
    options: [
        (
            names: [
                "-n",
                "--dry-run",
            ],
            description: Some("Do a dry run without executing actions"),
        ),
        (
            names: [
                "-h",
                "-H",
                "--help",
            ],
            description: Some("Display this help message"),
        ),
        (
            names: [
                "-I",
                "--libdir",
            ],
            description: Some("Include LIBDIR in the search path for required modules"),
            arguments: [
                (
                    name: "LIBDIR",
                    template: [
                        Folders,
                    ],
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "-P",
                "--prereqs",
            ],
            description: Some("Display the tasks and dependencies, then exit"),
        ),
        (
            names: [
                "-q",
                "--quiet",
            ],
            description: Some("Do not log messages to standard output"),
        ),
        (
            names: [
                "-f",
                "--rakefile",
            ],
            description: Some("Use FILE as the rakefile"),
            arguments: [
                (
                    name: "FILE",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "-r",
                "--require",
            ],
            description: Some("Require MODULE before executing rakefile"),
            arguments: [
                (
                    name: "MODULE",
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "-s",
                "--silent",
            ],
            description: Some("Like --quiet, but also suppresses the 'in directory' announcement"),
        ),
        (
            names: [
                "-T",
                "--tasks",
            ],
            description: Some("Display the tasks and dependencies, then exit"),
            arguments: [
                (
                    name: "pattern",
                    optional: true,
                ),
            ],
        ),
        (
            names: [
                "-t",
                "--trace",
            ],
            description: Some("Turn on invoke/execute tracing, enable full backtrace"),
            arguments: [
                (
                    name: "output",
                    optional: true,
                ),
            ],
        ),
        (
            names: [
                "-v",
                "--verbose",
            ],
            description: Some("Log message to standard output (default)"),
        ),
        (
            names: [
                "-V",
                "--version",
            ],
            description: Some("Display the program version"),
        ),
    ],
    arguments: [
        (
            name: "targets",
            generators: [
                (
                    script: [
                        "rake",
                        "--tasks",
                        "--silent",
                    ],
                    has_post_process: true,
                    cache: Some((
                        by_directory: true,
                        stale_while_revalidate: true,
                    )),
                ),
            ],
            optional: true,
            variadic: true,
        ),
    ],
    presentation: (
        icon: Some("https://avatars.githubusercontent.com/u/210414?s=48&v=4"),
    ),
)
