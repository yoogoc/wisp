(
    version: 1,
    command: "pkgutil",
    description: Some("Query and manipulate for macOS Installer packages and receipts"),
    subcommands: [
        (
            name: "--packages",
            aliases: [
                "--pkgs",
            ],
            description: Some("List all installed package IDs on the specified --volume"),
        ),
        (
            name: "--pkgs-plist",
            description: Some("List all installed package IDs, in Mac OS X plist(5) format, on the specified --volume"),
        ),
        (
            name: "--files",
            description: Some("List all of the files installed under the package-id"),
            arguments: [
                (
                    name: "package-id",
                    description: Some("The package ID to list the files of"),
                    generators: [
                        (
                            script: [
                                "pkgutil",
                                "--pkgs",
                            ],
                            split_on: Some("\n"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "--export-plist",
            description: Some("Print all receipt information about the specified package-id in Mac OS X plist(5) format"),
            arguments: [
                (
                    name: "package-id",
                    description: Some("The package ID to export the plist of"),
                    generators: [
                        (
                            script: [
                                "pkgutil",
                                "--pkgs",
                            ],
                            split_on: Some("\n"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "--verify",
            description: Some("Run repair_packages(8) to verify the specified package-id"),
            arguments: [
                (
                    name: "package-id",
                    description: Some("The package ID to verify"),
                    generators: [
                        (
                            script: [
                                "pkgutil",
                                "--pkgs",
                            ],
                            split_on: Some("\n"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "--repair",
            description: Some("Run repair_packages(8) to repair the specified package-id"),
            arguments: [
                (
                    name: "package-id",
                    description: Some("The package ID to repair"),
                    generators: [
                        (
                            script: [
                                "pkgutil",
                                "--pkgs",
                            ],
                            split_on: Some("\n"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "--pkg-info",
            description: Some("Print extended information about the specified package-id"),
            arguments: [
                (
                    name: "package-id",
                    description: Some("The package ID to print the info of"),
                    generators: [
                        (
                            script: [
                                "pkgutil",
                                "--pkgs",
                            ],
                            split_on: Some("\n"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "--pkg-info-plist",
            description: Some("Print extended information about the specified package-id in Mac OS X plist(5) format"),
            arguments: [
                (
                    name: "package-id",
                    description: Some("The package ID to print the info of"),
                    generators: [
                        (
                            script: [
                                "pkgutil",
                                "--pkgs",
                            ],
                            split_on: Some("\n"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "--forget",
            description: Some("Discard all receipt data about package-id, but don't touch installed files"),
            arguments: [
                (
                    name: "package-id",
                    description: Some("The package ID to forget"),
                    generators: [
                        (
                            script: [
                                "pkgutil",
                                "--pkgs",
                            ],
                            split_on: Some("\n"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "--learn",
            description: Some("Update the ACLs of the given path in the receipt identified by --edit-pkg"),
            arguments: [
                (
                    name: "path",
                    description: Some("The path to update ACLs on"),
                    generators: [
                        (
                            has_custom: true,
                            trigger: Some(OnMatch([
                                    "/",
                                ])),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "--pkg-groups",
            description: Some("List all of the package groups this package-id is a member of"),
            arguments: [
                (
                    name: "package-id",
                    description: Some("The package ID to list the groups of"),
                    generators: [
                        (
                            script: [
                                "pkgutil",
                                "--pkgs",
                            ],
                            split_on: Some("\n"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "--groups",
            description: Some("List all of the package groups ont he specified --volume"),
        ),
        (
            name: "--group-plist",
            description: Some("List all of the package groups ont he specified --volume in Mac OS X plist(5) format"),
        ),
        (
            name: "--group-pkgs",
            description: Some("List all of the packages that are members of this group-id"),
            arguments: [
                (
                    name: "group-id",
                    description: Some("The group ID to list the packages of"),
                    generators: [
                        (
                            script: [
                                "pkgutil",
                                "--groups",
                            ],
                            split_on: Some("\n"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "--file-info",
            description: Some("Show the metadata known about path"),
            arguments: [
                (
                    name: "path",
                    description: Some("The path to show the metadata of"),
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "--file-info-plist",
            description: Some("Show the metadata known about path in Mac OS X plist(5) format"),
            arguments: [
                (
                    name: "path",
                    description: Some("The path to show the metadata of"),
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "--expand",
            description: Some("Expand the flat package at pkg-path into a new directory specified by dir-path"),
            arguments: [
                (
                    name: "pkg-path",
                    description: Some("The path to the flat package to expand"),
                    template: [
                        FilePaths,
                    ],
                ),
                (
                    name: "dir-path",
                    description: Some("The path to the directory to expand the package into"),
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            name: "--flatten",
            description: Some("Flatten the dir-path into a new flat package created at pkg-path"),
            arguments: [
                (
                    name: "dir-path",
                    description: Some("The path to the directory to flatten"),
                    template: [
                        Folders,
                    ],
                ),
                (
                    name: "pkg-path",
                    description: Some("The path to the flat package to create"),
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "--bom",
            description: Some("Extract any BOM files from the flat pkg at path into /tmp and return the filename(s)"),
            arguments: [
                (
                    name: "path",
                    description: Some("The path to the flat package to extract the BOM from"),
                    generators: [
                        (
                            script: [
                                "find",
                                ".",
                                "-type",
                                "f",
                                "-name",
                                "*.bom",
                                "-maxdepth",
                                "1",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "--payload-files",
            description: Some("List the files archived within the uninstalled flat package(s) at path"),
            arguments: [
                (
                    name: "path",
                    description: Some("The path to the flat package to list the archived files of"),
                    generators: [
                        (
                            script: [
                                "find",
                                ".",
                                "-type",
                                "f",
                                "-name",
                                "*.pkg",
                                "-maxdepth",
                                "1",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "--check-signature",
            description: Some("Check the validity and trust of the signature on the package at pkg-path"),
            arguments: [
                (
                    name: "pkg-path",
                    description: Some("The path to the flat package to check the signature of"),
                    generators: [
                        (
                            script: [
                                "find",
                                ".",
                                "-type",
                                "f",
                                "-name",
                                "*.pkg",
                                "-maxdepth",
                                "1",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("A brief summary of commands and usage"),
        ),
        (
            names: [
                "-f",
                "--force",
            ],
            description: Some("Skip confirmation before a potentially destructive or ambiguous action"),
        ),
        (
            names: [
                "-v",
                "--verbose",
            ],
            description: Some("Output in a human-readable format"),
        ),
        (
            names: [
                "--volume",
            ],
            description: Some("Perform all operations on specified volume"),
            arguments: [
                (
                    name: "volume",
                    description: Some("Volume to perform operations on"),
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--edit-pkg",
            ],
            description: Some("Specifies an existing receipt to be modified in-place by --learn"),
            arguments: [
                (
                    name: "package-id",
                    description: Some("Package ID of the receipt to modify"),
                    generators: [
                        (
                            script: [
                                "pkgutil",
                                "--pkgs",
                            ],
                            split_on: Some("\n"),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--only-files",
            ],
            description: Some("List only files (not directories) in --files listing"),
        ),
        (
            names: [
                "--only-dirs",
            ],
            description: Some("List only directories (not files) in --files listing"),
        ),
        (
            names: [
                "--regexp",
            ],
            description: Some("Use regex to match package-id arguments, if an exact match isn't found"),
        ),
        (
            names: [
                "--pkgs",
            ],
            description: Some("List all installed package IDs, optionally matching kwarg REGEXP, on the specified --volume"),
            arguments: [
                (
                    name: "REGEXP",
                    description: Some("Regular expression"),
                ),
            ],
            requires_separator: Some("="),
        ),
    ],
)
