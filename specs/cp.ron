(
    version: 1,
    command: "cp",
    description: Some("Copy files and directories"),
    options: [
        (
            names: [
                "-a",
            ],
            description: Some("Preserves structure and attributes of files but not directory structure"),
        ),
        (
            names: [
                "-f",
            ],
            description: Some("If the destination file cannot be opened, remove it and create a new file, without prompting for confirmation"),
            exclusive_on: [
                "-n",
            ],
        ),
        (
            names: [
                "-H",
            ],
            description: Some("If the -R option is specified, symbolic links on the command line are followed"),
            exclusive_on: [
                "-L",
                "-P",
            ],
            depends_on: [
                "-R",
            ],
        ),
        (
            names: [
                "-i",
            ],
            description: Some("Cause cp to write a prompt to the standard error output before copying a file that would overwrite an existing file"),
            exclusive_on: [
                "-n",
            ],
        ),
        (
            names: [
                "-L",
            ],
            description: Some("If the -R option is specified, all symbolic links are followed"),
            exclusive_on: [
                "-H",
                "-P",
            ],
            depends_on: [
                "-R",
            ],
        ),
        (
            names: [
                "-n",
            ],
            description: Some("Do not overwrite an existing file"),
            exclusive_on: [
                "-f",
                "-i",
            ],
        ),
        (
            names: [
                "-P",
            ],
            description: Some("If the -R option is specified, no symbolic links are followed"),
            exclusive_on: [
                "-H",
                "-L",
            ],
            depends_on: [
                "-R",
            ],
        ),
        (
            names: [
                "-R",
            ],
            description: Some("If source designates a directory, cp copies the directory and the entire subtree connected at that point. If source ends in a /, the contents of the directory are copied rather than the directory itself"),
        ),
        (
            names: [
                "-v",
            ],
            description: Some("Cause cp to be verbose, showing files as they are copied"),
        ),
        (
            names: [
                "-X",
            ],
            description: Some("Do not copy Extended Attributes (EAs) or resource forks"),
        ),
        (
            names: [
                "-c",
            ],
            description: Some("Copy files using clonefile"),
        ),
    ],
    arguments: [
        (
            name: "source",
            template: [
                FilePaths,
                Folders,
            ],
            variadic: true,
        ),
        (
            name: "target",
            template: [
                FilePaths,
                Folders,
            ],
        ),
    ],
)
