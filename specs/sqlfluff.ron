(
    version: 1,
    command: "sqlfluff",
    description: Some("A dialect-flexible and configurable SQL linter"),
    subcommands: [
        (
            name: "lint",
            description: Some("Lint SQL files via passing a list of files or using stdin"),
            options: [
                (
                    names: [
                        "--nocolor",
                        "-n",
                    ],
                    description: Some("No color - output will be without ANSI color codes"),
                ),
                (
                    names: [
                        "--ignore",
                        "-i",
                    ],
                    description: Some("Ignore particular families of errors so that they don’t cause a failed run. -–ignore behaves somewhat like noqa comments, except it applies globally"),
                    arguments: [
                        (
                            name: "error",
                        ),
                    ],
                ),
                (
                    names: [
                        "--verbose",
                        "-v",
                    ],
                    description: Some("Verbosity, how detailed should the output be. This is stackable, so -vv is more verbose than -v. For the most verbose option try -vvvv or -vvvvv"),
                    repeat: Times(5),
                ),
                (
                    names: [
                        "--exclude-rules",
                        "-e",
                    ],
                    description: Some("Exclude specific rules. This could either be the allowlist, or the general set if there is no specific allowlist"),
                    arguments: [
                        (
                            name: "exclude_rules",
                        ),
                    ],
                ),
                (
                    names: [
                        "--rules",
                        "-r",
                    ],
                    description: Some("Narrow the search to only specific rules"),
                    arguments: [
                        (
                            name: "rules",
                        ),
                    ],
                ),
                (
                    names: [
                        "--templater",
                        "-t",
                    ],
                    description: Some("The templater to use (default=jinja)"),
                    arguments: [
                        (
                            name: "templater",
                            description: Some("Name of templater to use, eg. raw"),
                            suggestions: [
                                (
                                    name: "raw",
                                ),
                                (
                                    name: "jinja",
                                ),
                                (
                                    name: "python",
                                ),
                                (
                                    name: "placeholders",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--dialect",
                        "-d",
                    ],
                    description: Some("The dialect of SQL to lint"),
                    arguments: [
                        (
                            name: "dialect",
                            description: Some("Name of dialect, eg. ANSI"),
                            suggestions: [
                                (
                                    name: "ansi",
                                ),
                                (
                                    name: "bigquery",
                                ),
                                (
                                    name: "exasol",
                                ),
                                (
                                    name: "hive",
                                ),
                                (
                                    name: "mysql",
                                ),
                                (
                                    name: "oracle",
                                ),
                                (
                                    name: "postgres",
                                ),
                                (
                                    name: "redshift",
                                ),
                                (
                                    name: "snowflake",
                                ),
                                (
                                    name: "spark3",
                                ),
                                (
                                    name: "sqllite",
                                ),
                                (
                                    name: "teradata",
                                ),
                                (
                                    name: "tsql",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--format",
                        "-f",
                    ],
                    description: Some("What format to return the lint result in (default=human)"),
                    arguments: [
                        (
                            name: "format",
                            suggestions: [
                                (
                                    name: "human",
                                ),
                                (
                                    name: "json",
                                ),
                                (
                                    name: "yaml",
                                ),
                                (
                                    name: "github-annotation",
                                ),
                                (
                                    name: "github-annotation-native",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--processes",
                        "-p",
                    ],
                    description: Some("The number of parallel processes to run. Positive numbers work as expected. Zero and negative numbers will work as number_of_cpus - number. e.g -1 means all cpus except one. 0 means all cpus"),
                    arguments: [
                        (
                            name: "processes",
                        ),
                    ],
                ),
                (
                    names: [
                        "--disable-noqa",
                    ],
                    description: Some("Set this flag to ignore inline noqa comments"),
                ),
                (
                    names: [
                        "--bench",
                    ],
                    description: Some("Set this flag to engage the benchmarking tool output"),
                ),
                (
                    names: [
                        "--logger",
                    ],
                    description: Some("Choose to limit the logging to one of the loggers"),
                    arguments: [
                        (
                            name: "logger",
                            description: Some("Name of logger to limit to, eg. templater"),
                            suggestions: [
                                (
                                    name: "templater",
                                ),
                                (
                                    name: "lexer",
                                ),
                                (
                                    name: "parser",
                                ),
                                (
                                    name: "linter",
                                ),
                                (
                                    name: "rules",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--encoding",
                    ],
                    description: Some("Specify encoding to use when reading and writing files. Defaults to autodetect"),
                    arguments: [
                        (
                            name: "encoding",
                        ),
                    ],
                ),
                (
                    names: [
                        "--ignore-local-config",
                    ],
                    description: Some("Ignore config files in default search path locations. This option allows the user to lint with the default config or can be used in conjunction with –config to only reference the custom config file"),
                ),
                (
                    names: [
                        "--config",
                    ],
                    description: Some("Include additional config file. By default the config is generated from the standard configuration files described in the documentation. This argument allows you to specify an additional configuration file that overrides the standard configuration files. N.B. cfg format is required"),
                    arguments: [
                        (
                            name: "extra_config_path",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--write-output",
                    ],
                    description: Some("Optionally provide a filename to write the results to, mostly used in tandem with –format. NB: Setting an output file re-enables normal stdout logging"),
                    arguments: [
                        (
                            name: "write_output",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--annotation-level",
                    ],
                    description: Some("When format is set to github-annotation or github-annotation-native, default annotation level (default=notice). failure and error are equivalent"),
                    arguments: [
                        (
                            name: "annotation-level",
                            description: Some("Level of annotation, eg. notice"),
                            suggestions: [
                                (
                                    name: "notice",
                                ),
                                (
                                    name: "warning",
                                ),
                                (
                                    name: "failure",
                                ),
                                (
                                    name: "error",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--disregard-sqlfluffignores",
                    ],
                    description: Some("Perform the operation regardless of .sqlfluffignore configurations"),
                ),
                (
                    names: [
                        "--disable-progress-bar",
                    ],
                    description: Some("Disables progress bars"),
                ),
                (
                    names: [
                        "--nofail",
                    ],
                    description: Some("If set, the exit code will always be zero, regardless of violations found. This is potentially useful during rollout"),
                ),
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Show help for sqlfluff"),
                ),
            ],
            arguments: [
                (
                    name: "",
                    template: [
                        FilePaths,
                    ],
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
