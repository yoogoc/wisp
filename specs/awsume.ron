(
    version: 1,
    command: "awsume",
    description: Some("Awsume"),
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for awsume"),
        ),
        (
            names: [
                "--version",
                "-v",
            ],
            description: Some("Display the current version of awsume"),
        ),
        (
            names: [
                "--output-profile",
                "-o",
            ],
            description: Some("A profile to output credentials to"),
            arguments: [
                (
                    name: "output_profile",
                ),
            ],
        ),
        (
            names: [
                "--clean",
            ],
            description: Some("Clean expired output profiles"),
        ),
        (
            names: [
                "--refresh",
                "-r",
            ],
            description: Some("Force refresh credentials"),
        ),
        (
            names: [
                "--show-commands",
                "-s",
            ],
            description: Some("Show the commands to set the credentials"),
        ),
        (
            names: [
                "--unset",
                "-u",
            ],
            description: Some("Unset your aws environment variables"),
        ),
        (
            names: [
                "--auto-refresh",
                "-a",
            ],
            description: Some("Auto refresh credentials"),
        ),
        (
            names: [
                "--kill-refresher",
                "-k",
            ],
            description: Some("Kill autoawsume"),
        ),
        (
            names: [
                "--list-profiles",
                "-l",
            ],
            description: Some("List profiles, \"more\" for detail (slow)"),
            arguments: [
                (
                    name: "",
                ),
            ],
        ),
        (
            names: [
                "--refresh-autocomplete",
            ],
            description: Some("Refresh all plugin autocomplete profiles"),
        ),
        (
            names: [
                "--role-arn",
            ],
            description: Some("Role ARN or <partition>:<account_id>:<role_name>"),
            arguments: [
                (
                    name: "role_arn",
                ),
            ],
        ),
        (
            names: [
                "--principal-arn",
            ],
            description: Some("Principal ARN or <partition>:<account_id>:<provider_name>"),
            arguments: [
                (
                    name: "principal_arn",
                ),
            ],
        ),
        (
            names: [
                "--source-profile",
            ],
            description: Some("Source_profile to use(role-arn only)"),
            arguments: [
                (
                    name: "source_profile",
                ),
            ],
        ),
        (
            names: [
                "--external-id",
            ],
            description: Some("External ID to pass to the assume_role"),
            arguments: [
                (
                    name: "external_id",
                ),
            ],
        ),
        (
            names: [
                "--mfa-token",
            ],
            description: Some("Your mfa token"),
            arguments: [
                (
                    name: "mfa-token",
                ),
            ],
        ),
        (
            names: [
                "--region",
            ],
            description: Some("The region you want to awsume into"),
            arguments: [
                (
                    name: "region",
                ),
            ],
        ),
        (
            names: [
                "--session-name",
            ],
            description: Some("Set a custom role session name"),
            arguments: [
                (
                    name: "session_name",
                ),
            ],
        ),
        (
            names: [
                "--role-duration",
            ],
            description: Some("Seconds to get role creds for"),
            arguments: [
                (
                    name: "role_duration",
                ),
            ],
        ),
        (
            names: [
                "--with-saml",
            ],
            description: Some("Use saml (requires plugin)"),
        ),
        (
            names: [
                "--with-web-identity",
            ],
            description: Some("Use web identity (requires plugin)"),
        ),
        (
            names: [
                "--json",
            ],
            description: Some("Use json credentials"),
            arguments: [
                (
                    name: "json",
                ),
            ],
        ),
        (
            names: [
                "--credentials-file",
            ],
            description: Some("Target a shared credentials file"),
            arguments: [
                (
                    name: "credentials_file",
                ),
            ],
        ),
        (
            names: [
                "--config-file",
            ],
            description: Some("Target a config file"),
            arguments: [
                (
                    name: "config_file",
                ),
            ],
        ),
        (
            names: [
                "--config",
            ],
            description: Some("Configure awsume"),
            arguments: [
                (
                    name: "option",
                    variadic: true,
                ),
            ],
        ),
        (
            names: [
                "--list-plugins",
            ],
            description: Some("List installed plugins"),
        ),
        (
            names: [
                "--info",
            ],
            description: Some("Print any info logs to stderr"),
        ),
        (
            names: [
                "--debug",
            ],
            description: Some("Print any debug logs to stderr"),
        ),
        (
            names: [
                "--console",
                "-c",
            ],
            description: Some("Open AWS console"),
        ),
        (
            names: [
                "--console-link",
                "-cl",
            ],
            description: Some("Get a sign-on url"),
        ),
        (
            names: [
                "--console-service",
                "-cs",
            ],
            description: Some("Open the console to a specific service"),
            arguments: [
                (
                    name: "service",
                ),
            ],
        ),
        (
            names: [
                "-cls",
                "-csl",
            ],
            description: Some("Get a sign-on url to a specific service"),
            arguments: [
                (
                    name: "service",
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "profile",
            template: [
                History,
            ],
        ),
    ],
    parser_directives: Some((
        flags_are_posix_noncompliant: true,
    )),
)
