(
    version: 1,
    command: "nuxi",
    description: Some("Nuxt 3 CLI"),
    subcommands: [
        (
            name: "info",
            description: Some("The info command logs information about the current or specified Nuxt project"),
            arguments: [
                (
                    name: "rootDir",
                    description: Some("The directory of the target application"),
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                icon: Some("📝"),
                display_name: Some("Info"),
            ),
        ),
        (
            name: "init",
            aliases: [
                "create",
            ],
            description: Some("The init command initializes a fresh Nuxt project"),
            options: [
                (
                    names: [
                        "--verbose",
                        "-v",
                    ],
                    description: Some("Log information about the installation process"),
                ),
                (
                    names: [
                        "--template",
                        "-t",
                    ],
                    description: Some("Specify a Git repository to use as a template"),
                ),
                (
                    names: [
                        "--force",
                    ],
                    description: Some("Force clone to any existing directory"),
                ),
                (
                    names: [
                        "--prefer-offline",
                    ],
                    description: Some("Try local cache first to download templates"),
                ),
                (
                    names: [
                        "--shell",
                    ],
                    description: Some("Open shell in cloned directory (experimental)"),
                ),
            ],
            arguments: [
                (
                    name: "dir",
                    description: Some("Name of the install directory"),
                ),
            ],
        ),
        (
            name: "add",
            aliases: [
                "new",
            ],
            description: Some("Generate a entity into your Nuxt application"),
            options: [
                (
                    names: [
                        "--cwd",
                    ],
                    description: Some("The current working directory of the target application"),
                ),
                (
                    names: [
                        "--force",
                    ],
                    description: Some("Force override file if it already exists"),
                ),
            ],
            arguments: [
                (
                    name: "TEMPLATE",
                    description: Some("Specify a template of the file to be generated"),
                    suggestions: [
                        (
                            name: "component",
                            description: Some("Generate a nuxt component"),
                            presentation: (
                                icon: Some("fig://template?color=0079ff&badge=+"),
                            ),
                        ),
                        (
                            name: "composable",
                            description: Some("Generate a nuxt composable"),
                            presentation: (
                                icon: Some("fig://template?color=0079ff&badge=+"),
                            ),
                        ),
                        (
                            name: "layout",
                            description: Some("Generate a nuxt layout"),
                            presentation: (
                                icon: Some("fig://template?color=0079ff&badge=+"),
                            ),
                        ),
                        (
                            name: "plugin",
                            description: Some("Generate a nuxt plugin"),
                            presentation: (
                                icon: Some("fig://template?color=0079ff&badge=+"),
                            ),
                        ),
                        (
                            name: "page",
                            description: Some("Generate a nuxt page"),
                            presentation: (
                                icon: Some("fig://template?color=0079ff&badge=+"),
                            ),
                        ),
                        (
                            name: "middleware",
                            description: Some("Generate a nuxt middleware"),
                            presentation: (
                                icon: Some("fig://template?color=0079ff&badge=+"),
                            ),
                        ),
                        (
                            name: "api",
                            description: Some("Generate a nuxt api"),
                            presentation: (
                                icon: Some("fig://template?color=0079ff&badge=+"),
                            ),
                        ),
                    ],
                ),
                (
                    name: "NAME",
                    description: Some("Specify a name of the file that will be created"),
                ),
            ],
            presentation: (
                icon: Some("fig://template?color=2ecc71&badge=+"),
                display_name: Some("Add"),
            ),
        ),
        (
            name: "analyze",
            description: Some("The analyze command builds Nuxt and analyzes the production bundle (experimental)"),
            arguments: [
                (
                    name: "rootDir",
                    description: Some("The directory of the target application"),
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                icon: Some("✨"),
                display_name: Some("Analyze"),
            ),
        ),
        (
            name: "build",
            description: Some("The build command creates a .output directory with all your application, server and dependencies ready for production"),
            options: [
                (
                    names: [
                        "--dotenv",
                    ],
                    description: Some("Point to another .env file to load, relative to the root directory"),
                ),
                (
                    names: [
                        "--prerender",
                    ],
                    description: Some("Pre-render every route of your application. (note: This is an experimental flag. The behavior might be changed)"),
                ),
            ],
            arguments: [
                (
                    name: "rootDir",
                    description: Some("The directory of the target application"),
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                icon: Some("🏗"),
                display_name: Some("Build"),
            ),
        ),
        (
            name: "dev",
            description: Some("The dev command starts a development server with hot module replacement at http://localhost:3000"),
            options: [
                (
                    names: [
                        "--dotenv",
                    ],
                    description: Some("Point to another .env file to load, relative to the root directory"),
                ),
                (
                    names: [
                        "--clipboard",
                    ],
                    description: Some("Copy URL to clipboard"),
                ),
                (
                    names: [
                        "--open",
                        "-o",
                    ],
                    description: Some("Open URL in browser"),
                ),
                (
                    names: [
                        "--no-clear",
                    ],
                    description: Some("Does not clear the console after startup"),
                ),
                (
                    names: [
                        "--port",
                        "-p",
                    ],
                    description: Some("Port to listen"),
                ),
                (
                    names: [
                        "--host",
                        "-h",
                    ],
                    description: Some("Hostname of the server"),
                ),
                (
                    names: [
                        "--https",
                    ],
                    description: Some("Listen with https protocol with a self-signed certificate by default"),
                ),
                (
                    names: [
                        "--ssl-cert",
                    ],
                    description: Some("Specify a certificate for https"),
                ),
                (
                    names: [
                        "--ssl-key",
                    ],
                    description: Some("Specify the key for the https certificate"),
                ),
            ],
            arguments: [
                (
                    name: "rootDir",
                    description: Some("The directory of the target application"),
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                icon: Some("💻"),
                display_name: Some("Dev"),
            ),
        ),
        (
            name: "prepare",
            description: Some("The prepare command creates a .nuxt directory in your application and generates ts types"),
            presentation: (
                icon: Some("📦"),
            ),
        ),
        (
            name: "preview",
            description: Some("The preview command starts a server to preview your Nuxt application after running the build command"),
            options: [
                (
                    names: [
                        "--dotenv",
                    ],
                    description: Some("Point to another .env file to load, relative to the root directory"),
                ),
            ],
            arguments: [
                (
                    name: "rootDir",
                    description: Some("The directory of the target application"),
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                icon: Some("🔗"),
                display_name: Some("Preview"),
            ),
        ),
        (
            name: "generate",
            description: Some("Build Nuxt and prerender static routes"),
            arguments: [
                (
                    name: "rootDir",
                    description: Some("The directory of the target application"),
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                icon: Some("📦"),
                display_name: Some("Generate"),
            ),
        ),
        (
            name: "clean",
            aliases: [
                "cleanup",
            ],
            description: Some("The cleanup command removes common generated Nuxt files and caches including .nuxt/, .output/, node_modules/.vite and node_modules/.cache"),
            arguments: [
                (
                    name: "rootDir",
                    description: Some("The directory of the target application"),
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                icon: Some("🧼"),
                display_name: Some("Cleanup"),
            ),
        ),
        (
            name: "test",
            description: Some("Run the test files for your Nuxt application"),
            options: [
                (
                    names: [
                        "--dev",
                    ],
                    description: Some("Run tests in development mode"),
                ),
                (
                    names: [
                        "--watch",
                    ],
                    description: Some("Actively watch for changes and rerun tests"),
                ),
            ],
            arguments: [
                (
                    name: "rootDir",
                    description: Some("The directory of the target application"),
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                icon: Some("🧪"),
                display_name: Some("Test"),
            ),
        ),
        (
            name: "upgrade",
            description: Some("The upgrade command upgrades Nuxt 3 to the latest version"),
            options: [
                (
                    names: [
                        "--force",
                        "-f",
                    ],
                    description: Some("Removes node_modules and lock files before upgrade"),
                ),
            ],
            presentation: (
                icon: Some("⭐️"),
                display_name: Some("Upgrade"),
            ),
        ),
        (
            name: "typecheck",
            description: Some("The typecheck command runs vue-tsc to check types throughout your app"),
            arguments: [
                (
                    name: "rootDir",
                    description: Some("The directory of the target application"),
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
            presentation: (
                icon: Some("✅"),
            ),
        ),
        (
            name: "usage",
            description: Some("The usage command shows the usage of the Nuxt CLI"),
            presentation: (
                icon: Some("📊"),
                display_name: Some("Usage"),
            ),
        ),
    ],
    options: [
        (
            names: [
                "--help",
            ],
            description: Some("Show help"),
            persistent: true,
