                                ),
                                (
                                    name: "env",
                                ),
                                (
                                    name: "vars",
                                ),
                            ],
                            optional: true,
                            default: Some("ini"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--config",
                        "-c",
                    ],
                    description: Some("Path to configuration file, defaults to first file found in precedence"),
                    arguments: [
                        (
                            name: "CONFIG_FILE",
                            description: Some("Path to configuration file"),
                            template: [
