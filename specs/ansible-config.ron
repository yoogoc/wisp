(
    version: 1,
    command: "ansible-config",
    description: Some("View ansible configuration"),
    subcommands: [
        (
            name: "list",
            description: Some("List and output available configs"),
            options: [
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Show help and exit"),
                ),
                (
                    names: [
                        "--verbose",
                    ],
                    description: Some("Verbose mode (-vvv for more, -vvvv to enable connection debugging)"),
                    exclusive_on: [
                        "-v",
                    ],
                ),
                (
                    names: [
                        "-v",
                    ],
                    description: Some("Verbose mode (-vvv for more, -vvvv to enable connection debugging)"),
                    repeat: Times(4),
                    exclusive_on: [
                        "--verbose",
                    ],
                ),
                (
                    names: [
                        "--config",
                        "-c",
                    ],
                    description: Some("Path to configuration file, defaults to first file found in precedence"),
                    arguments: [
                        (
                            name: "CONFIG_FILE",
                            description: Some("Path to configuration file"),
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--type",
                        "-t",
                    ],
                    description: Some("Filter down to a specific plugin type"),
                    arguments: [
                        (
                            name: "TYPE",
                            description: Some("Plugin type"),
                            suggestions: [
                                (
                                    name: "all",
                                ),
                                (
                                    name: "base",
                                ),
                                (
                                    name: "become",
                                ),
                                (
                                    name: "cache",
                                ),
                                (
                                    name: "callback",
                                ),
                                (
                                    name: "cliconf",
                                ),
                                (
                                    name: "connection",
                                ),
                                (
                                    name: "httpapi",
                                ),
                                (
                                    name: "inventory",
                                ),
                                (
                                    name: "lookup",
                                ),
                                (
                                    name: "netconf",
                                ),
                                (
                                    name: "shell",
                                ),
                                (
                                    name: "vars",
                                ),
                            ],
                            default: Some("all"),
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "args",
                    description: Some("Specific plugin to target, requires type of plugin to be set"),
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "dump",
            description: Some("Shows the current settings, merges ansible.cfg if specified"),
            options: [
                (
                    names: [
                        "--help",
                        "-h",
                    ],
                    description: Some("Show help and exit"),
                ),
                (
                    names: [
