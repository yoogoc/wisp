            arguments: [
                (
                    name: "args",
                    description: Some("Specific plugin to target, requires type of plugin to be set"),
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "view",
            description: Some("Displays the current config file"),
            options: [
