                                    name: "callback",
                                ),
                                (
                                    name: "cliconf",
                                ),
                                (
                                    name: "connection",
                                ),
                                (
                                    name: "httpapi",
                                ),
                                (
                                    name: "inventory",
                                ),
                                (
                                    name: "lookup",
                                ),
                                (
                                    name: "netconf",
                                ),
                                (
                                    name: "shell",
                                ),
                                (
                                    name: "vars",
                                ),
                            ],
                            default: Some("all"),
