                    ],
                    description: Some("Verbose mode (-vvv for more, -vvvv to enable connection debugging)"),
                    repeat: Times(4),
                    exclusive_on: [
                        "--verbose",
                    ],
                ),
                (
                    names: [
                        "--disabled",
                    ],
                    description: Some("Prefixes all entries with a comment character to disable them"),
                ),
                (
                    names: [
                        "--format",
                        "-f",
                    ],
                    description: Some("Output format for init"),
                    arguments: [
                        (
                            name: "FORMAT",
