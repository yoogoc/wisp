                    names: [
                        "-v",
                    ],
                    description: Some("Verbose mode (-vvv for more, -vvvv to enable connection debugging)"),
                    repeat: Times(4),
                    exclusive_on: [
                        "--verbose",
                    ],
                ),
                (
                    names: [
                        "--only-changed",
                        "--changed-only",
                    ],
                    description: Some("Only show configurations that have changed from the default"),
                ),
                (
                    names: [
                        "--config",
                        "-c",
                    ],
                    description: Some("Path to configuration file, defaults to first file found in precedence"),
                    arguments: [
