(
    version: 1,
    command: "shopify",
    description: Some("Shopify CLI helps you build Shopify apps. It quickly generates Node.js, Ruby on Rails, and PHP apps, app extensions, Shopify Scripts (beta), and Shopify themes. You can also use it for Shopify themes and when automating many common development tasks. Visit https://shopify.dev/apps/tools/cli to know more"),
    subcommands: [
        (
            name: "theme",
            description: Some("Suite of commands for developing Shopify themes"),
            subcommands: [
                (
                    name: "init",
                    description: Some("Clones a Git repository to your local machine to use as the starting point for building a theme"),
                    options: [
                        (
                            names: [
                                "--clone-url",
                            ],
                            description: Some("The URL of the Git repository that you want to clone. If no URL is specified, then https://github.com/Shopify/dawn.git is used"),
                            arguments: [
                                (
                                    name: "URL",
                                ),
                            ],
                            presentation: (
                                icon: Some("fig://icon?type=github"),
                            ),
                        ),
                    ],
                    arguments: [
                        (
                            name: "NAME",
                            description: Some("The name that you want to give your theme. Cloned files are stored in a folder with this name"),
                        ),
                    ],
                    presentation: (
                        priority: Some(100.0),
                    ),
                ),
                (
                    name: "serve",
                    description: Some("Uploads the current theme as a development theme to the store that you're connected to"),
                    options: [
                        (
                            names: [
                                "--live-reload",
                            ],
                            description: Some("The level at which content is reloaded when changes are made to the theme"),
                            arguments: [
                                (
                                    name: "MODE",
                                    suggestions: [
                                        (
                                            name: "hot-reload",
                                            description: Some("Hot reloads local changes to CSS and sections (default)"),
                                        ),
                                        (
                                            name: "full-page",
                                            description: Some("Refreshes the entire page when a file is modified"),
                                        ),
                                        (
                                            name: "off",
                                            description: Some("Deactivate live reload"),
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--host",
                            ],
                            description: Some("The network interface the web server listens on. The default value is 127.0.0.1"),
                            arguments: [
                                (
                                    name: "IP",
                                    description: Some("The network interface the web server listens on. The default value is 127.0.0.1"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--port",
                            ],
                            description: Some("The local port to serve the theme preview from"),
                            arguments: [
                                (
                                    name: "PORT",
                                    description: Some("The local port to serve the theme preview from"),
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--poll",
                            ],
                            description: Some("Force the polling adapter to watch file changes. You can try this option if live reload isn't working as expected"),
                        ),
                    ],
                ),
                (
                    name: "check",
                    description: Some("Calls and runs Theme Check to analyze your theme code for errors and to ensure that it follows theme and Liquid best practices. Learn more about the checks that Theme Check runs"),
                    options: [
                        (
                            names: [
                                "--config",
                            ],
                            description: Some("The path to your custom Theme Check config. This config overrides .theme-check.yml, if it is present in the directory being analyzed"),
                            arguments: [
                                (
                                    name: "PATH",
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--category",
                            ],
                            description: Some("Run only the specified category of checks. You can specify multiple categories using multiple instances of this flag"),
                            arguments: [
                                (
                                    name: "CATEGORY",
                                    suggestions: [
                                        (
                                            name: "html",
                                        ),
                                        (
                                            name: "json",
                                        ),
                                        (
                                            name: "liquid",
                                        ),
                                        (
                                            name: "performance",
                                        ),
                                        (
                                            name: "translation",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--exclude-category",
                            ],
                            description: Some("Run all checks other than those in the specified category. You can specify multiple categories using multiple instances of this flag"),
                            arguments: [
                                (
                                    name: "CATEGORY",
                                    suggestions: [
                                        (
                                            name: "html",
                                        ),
                                        (
                                            name: "json",
                                        ),
                                        (
                                            name: "liquid",
                                        ),
                                        (
                                            name: "performance",
                                        ),
                                        (
                                            name: "translation",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--fail-level",
                            ],
                            description: Some("Configure the severity level that causes a run of theme check to fail (exit code 1). Options include error, suggestion, and style"),
                            arguments: [
                                (
                                    name: "LEVEL",
                                    suggestions: [
                                        (
                                            name: "error",
                                        ),
                                        (
                                            name: "suggestion",
                                        ),
                                        (
                                            name: "style",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--auto-correct",
                            ],
                            description: Some("Automatically fix correctable offenses"),
                        ),
                        (
                            names: [
                                "--init",
                            ],
                            description: Some("Generate a new Theme Check config file"),
                        ),
                        (
                            names: [
                                "--output",
                            ],
                            description: Some("Output the results of the check to a file. Options include json and text (default)"),
                            arguments: [
                                (
                                    name: "type",
                                    suggestions: [
                                        (
                                            name: "json",
                                        ),
                                        (
                                            name: "text",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--print",
                            ],
                            description: Some("Output the active config to STDOUT"),
                        ),
                        (
                            names: [
                                "--list",
                            ],
                            description: Some("List the active checks"),
                        ),
                        (
                            names: [
                                "--version",
                            ],
                            description: Some("Print the version of Theme Check being used"),
                        ),
                    ],
                    presentation: (
                        icon: Some("fig://icon?type=alert"),
                    ),
                ),
                (
                    name: "open",
                    description: Some("Returns links that let you preview the specified theme"),
                    options: [
                        (
                            names: [
                                "--theme",
                            ],
                            description: Some("The name or ID of the theme that you want to overwrite"),
                            arguments: [
                                (
                                    name: "NAME_OR_ID",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--live",
                            ],
                            description: Some("Returns links for the live (published) theme. This option doesn't require --theme"),
                        ),
                        (
                            names: [
                                "--development",
                            ],
                            description: Some("Returns links for your development theme. This option doesn't require --theme"),
                        ),
                    ],
                ),
                (
                    name: "delete",
                    description: Some("Deletes a theme from your store"),
                    options: [
                        (
                            names: [
                                "--development",
                            ],
                            description: Some("Deletes your development theme"),
                        ),
                        (
                            names: [
                                "--force",
                            ],
                            description: Some("Deletes the theme without confirming with the user"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "THEME_ID",
                            description: Some("The ID of the theme that you want to delete. You can specify multiple theme IDs separated by spaces"),
                        ),
                    ],
                ),
                (
                    name: "package",
                    description: Some("Packages your local theme files into a ZIP file that can be uploaded to Shopify"),
                    arguments: [
                        (
                            name: "ROOT",
                            template: [
                                Folders,
                            ],
                            optional: true,
                        ),
                    ],
                    presentation: (
                        icon: Some("fig://icon?type=box"),
                    ),
                ),
                (
                    name: "publish",
                    description: Some("Publishes an unpublished theme from your theme library"),
                    options: [
                        (
                            names: [
                                "--force",
                            ],
                            description: Some("Publish the theme without confirming with the user"),
                        ),
                    ],
                    arguments: [
                        (
                            name: "THEME_ID",
                            description: Some("The ID of the theme that you want to delete. You can specify multiple theme IDs separated by spaces"),
                        ),
                    ],
                ),
                (
                    name: "pull",
                    description: Some("Retrieves theme files from Shopify"),
                    options: [
                        (
                            names: [
                                "--theme",
                            ],
                            description: Some("The name or ID of the theme that you want to overwrite"),
                            arguments: [
                                (
                                    name: "NAME_OR_ID",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--live",
                            ],
                            description: Some("Pulls the live (published) theme. This option doesn't require --theme"),
                        ),
                        (
                            names: [
                                "--development",
                            ],
                            description: Some("Downloads theme files from your remote development theme. You might use this command to copy changes made to the development theme in the theme editor to your local copy of the theme. This option doesn't require --theme"),
                        ),
                        (
                            names: [
                                "--nodelete",
                            ],
                            description: Some("Runs the pull command without deleting local files"),
                        ),
                        (
                            names: [
                                "--ignore",
                            ],
                            description: Some("Skips downloading the specified files from Shopify. Specify multiple patterns to ignore by using the flag multiple times in a single command. If files are excluded using .shopifyignore, then both the contents of .shopifyignore and the --ignore flag are respected"),
                        ),
                        (
                            names: [
                                "--only",
                            ],
                            description: Some("Downloads only the specified files from Shopify. Specify multiple patterns by using the flag multiple times in a single command"),
                        ),
                    ],
                ),
                (
                    name: "push",
                    description: Some("Uploads your local theme files to Shopify, overwriting the remote theme if specified"),
                    options: [
                        (
                            names: [
                                "--theme",
                            ],
                            description: Some("The name or ID of the theme that you want to overwrite"),
                            arguments: [
                                (
                                    name: "NAME_OR_ID",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--development",
                            ],
                            description: Some("Pushes to your development theme. If you don't have a development theme, then one is created. This option doesn't require --theme"),
                        ),
                        (
                            names: [
                                "--nodelete",
                            ],
                            description: Some("Pushes your local files without deleting remote files from Shopify"),
                        ),
                        (
                            names: [
                                "--json",
                            ],
                            description: Some("Returns information about the pushed theme as a JSON object"),
                        ),
                        (
                            names: [
                                "--allow-live",
                            ],
                            description: Some("Allows Shopify CLI to overwrite the live (published) theme"),
                        ),
                        (
                            names: [
                                "--live",
                            ],
                            description: Some("Pushes to the live (published) theme. This option doesn't require --theme or --allow-live"),
                        ),
                        (
                            names: [
                                "--publish",
                            ],
                            description: Some("After the theme is pushed, publishes the theme so it is live in the store"),
                        ),
                        (
                            names: [
                                "--unpublished",
                            ],
                            description: Some("Uploads the theme to the theme library as a new unpublished theme.You're prompted to provide a name for the theme. Use the --theme flag to provide a name as a part of the command"),
                        ),
                        (
                            names: [
                                "--ignore",
                            ],
                            description: Some("Skips uploading the specified files to Shopify. Specify multiple patterns to ignore by using the flag multiple times in a single command. If files are excluded using .shopifyignore, then both the contents of .shopifyignore and the --ignore flag are respected"),
                        ),
                        (
                            names: [
                                "--only",
                            ],
                            description: Some("Uploads only the specified files to Shopify. Specify multiple patterns by using the flag multiple times in a single command"),
                        ),
                    ],
                ),
                (
                    name: "list",
                    description: Some("Lists the themes in your store, along with their IDs and statuses"),
                ),
            ],
            presentation: (
                priority: Some(100.0),
            ),
        ),
        (
            name: "app",
            description: Some("This reference lists the Shopify CLI commands for apps"),
            subcommands: [
                (
                    name: "create",
                    description: Some("Creates a ruby on rails / node / php app"),
                    subcommands: [
                        (
                            name: "rails",
                            description: Some("Connects an existing app to Shopify CLI. Creates a config file"),
                            options: [
                                (
                                    names: [
                                        "--name",
                                    ],
                                    description: Some("App name. Any string"),
                                    arguments: [
                                        (
                                            name: "NAME",
                                        ),
                                    ],
                                ),
                                (
                                    names: [
                                        "--organization-id",
                                    ],
                                    description: Some("Partner organization ID. Must be an existing organization"),
                                    arguments: [
                                        (
                                            name: "ID",
                                        ),
                                    ],
                                ),
                                (
                                    names: [
                                        "--store-domain",
                                    ],
                                    description: Some("Development store URL. Must be an existing development store"),
                                    arguments: [
                                        (
                                            name: "MYSHOPIFYDOMAIN",
                                        ),
                                    ],
                                ),
                                (
                                    names: [
                                        "--type",
                                    ],
                                    description: Some("Whether this app is public or custom"),
                                    arguments: [
                                        (
                                            name: "APPTYPE",
                                            suggestions: [
                                                (
                                                    name: "public",
                                                ),
                                                (
                                                    name: "custom",
                                                ),
                                            ],
                                        ),
                                    ],
                                ),
                                (
                                    names: [
                                        "--verbose",
                                    ],
                                    description: Some("Output verbose information when installing dependencies"),
                                ),
                                (
                                    names: [
                                        "--db",
                                    ],
                                    description: Some("Database type"),
                                    arguments: [
                                        (
                                            name: "DB",
                                            suggestions: [
                                                (
                                                    name: "mysql",
                                                ),
                                                (
                                                    name: "postgresql",
                                                ),
                                                (
                                                    name: "sqlite3",
                                                ),
                                                (
                                                    name: "oracle",
                                                ),
                                                (
                                                    name: "frontbase",
                                                ),
                                                (
                                                    name: "ibm_db",
                                                ),
                                                (
                                                    name: "sqlserver",
                                                ),
                                                (
                                                    name: "jdbcmysql",
                                                ),
                                                (
                                                    name: "jdbcsqlite3",
                                                ),
                                                (
                                                    name: "jdbcpostgresql",
                                                ),
                                                (
                                                    name: "jdbc",
                                                ),
                                            ],
                                        ),
                                    ],
                                ),
                                (
                                    names: [
                                        "--rails-opts",
                                    ],
                                    description: Some("Additional options. Must be string containing one or more valid Rails options, separated by spaces"),
                                    arguments: [
                                        (
                                            name: "RAILSOPTS",
                                        ),
                                    ],
                                ),
                            ],
                        ),
                        (
                            name: "node",
                            description: Some("Creates an embedded nodejs app"),
                            options: [
                                (
                                    names: [
                                        "--name",
                                    ],
                                    description: Some("App name. Any string"),
                                    arguments: [
                                        (
                                            name: "NAME",
                                        ),
                                    ],
                                ),
                                (
                                    names: [
                                        "--organization-id",
                                    ],
                                    description: Some("Partner organization ID. Must be an existing organization"),
                                    arguments: [
                                        (
                                            name: "ID",
                                        ),
                                    ],
                                ),
                                (
                                    names: [
                                        "--store-domain",
                                    ],
                                    description: Some("Development store URL. Must be an existing development store"),
                                    arguments: [
                                        (
                                            name: "MYSHOPIFYDOMAIN",
                                        ),
                                    ],
                                ),
                                (
                                    names: [
                                        "--type",
                                    ],
                                    description: Some("Whether this app is public or custom"),
                                    arguments: [
                                        (
                                            name: "APPTYPE",
                                            suggestions: [
                                                (
                                                    name: "public",
                                                ),
                                                (
                                                    name: "custom",
                                                ),
                                            ],
                                        ),
                                    ],
                                ),
                                (
                                    names: [
                                        "--verbose",
                                    ],
                                    description: Some("Output verbose information when installing dependencies"),
                                ),
                            ],
                        ),
                        (
                            name: "php",
                            description: Some("Connects an existing app to Shopify CLI. Creates a config file"),
                            options: [
                                (
                                    names: [
                                        "--name",
                                    ],
                                    description: Some("App name. Any string"),
                                    arguments: [
                                        (
                                            name: "NAME",
                                        ),
                                    ],
                                ),
                                (
                                    names: [
                                        "--organization-id",
                                    ],
                                    description: Some("Partner organization ID. Must be an existing organization"),
                                    arguments: [
                                        (
                                            name: "ID",
                                        ),
                                    ],
                                ),
                                (
                                    names: [
                                        "--store-domain",
                                    ],
                                    description: Some("Development store URL. Must be an existing development store"),
                                    arguments: [
                                        (
                                            name: "MYSHOPIFYDOMAIN",
                                        ),
                                    ],
                                ),
                                (
                                    names: [
                                        "--type",
                                    ],
                                    description: Some("Whether this app is public or custom"),
                                    arguments: [
                                        (
                                            name: "APPTYPE",
                                            suggestions: [
                                                (
                                                    name: "public",
                                                ),
                                                (
                                                    name: "custom",
                                                ),
                                            ],
                                        ),
                                    ],
                                ),
                                (
                                    names: [
                                        "--verbose",
                                    ],
                                    description: Some("Output verbose information when installing dependencies"),
                                ),
                            ],
                        ),
                    ],
                    presentation: (
                        priority: Some(100.0),
                    ),
                ),
                (
                    name: "connect",
                    description: Some("Connects an existing app to Shopify CLI. Creates a config file"),
                    presentation: (
                        priority: Some(90.0),
                    ),
                ),
                (
                    name: "deploy",
                    description: Some("Deploy the current app to a hosting service. Heroku (https://www.heroku.com) is currently the only option, but more will be added in the future"),
                    subcommands: [
                        (
                            name: "heroku",
                            description: Some("Deploys the current app to Heroku"),
                            presentation: (
                                icon: Some("fig://icon?type=heroku"),
                            ),
                        ),
                    ],
                    presentation: (
                        priority: Some(80.0),
                    ),
                ),
                (
                    name: "open",
                    description: Some("Open your local development app in the default browser"),
                    presentation: (
                        priority: Some(70.0),
                    ),
                ),
                (
                    name: "serve",
                    description: Some("Start a local development server for your project, as well as a public ngrok tunnel to your localhost"),
                    presentation: (
                        priority: Some(60.0),
                    ),
                ),
                (
                    name: "tunnel",
                    description: Some("Controls an HTTP tunnel to your local development app using ngrok. With the tunnel command, you can authenticate with ngrok and start or stop the tunnel. To authenticate with ngrok, you need to create an ngrok account, and then create an authentication token from your ngrok dashboard. Copy your token and use it with the auth command"),
                    subcommands: [
                        (
                            name: "start",
                            description: Some("Starts an ngrok tunnel, will print the URL for an existing tunnel if already running"),
                            presentation: (
                                priority: Some(100.0),
                            ),
                        ),
                        (
                            name: "stop",
                            description: Some("Stops the ngrok tunnel"),
                            presentation: (
                                priority: Some(90.0),
                            ),
                        ),
                        (
                            name: "auth",
                            description: Some("Writes an ngrok auth token to ~/.ngrok2/ngrok.yml to connect with an ngrok account. Visit https://dashboard.ngrok.com/signup to sign up"),
                            options: [
                                (
                                    names: [
                                        "--token",
                                    ],
                                    description: Some("Ngrok auth token"),
                                    arguments: [
                                        (
                                            name: "token",
                                        ),
                                    ],
                                    required: true,
                                ),
                            ],
                            presentation: (
                                priority: Some(80.0),
                            ),
                        ),
                    ],
                    presentation: (
                        priority: Some(50.0),
                    ),
                ),
            ],
            presentation: (
                priority: Some(90.0),
            ),
        ),
        (
            name: "extension",
            description: Some("Suite of commands for developing app extensions"),
            subcommands: [
                (
                    name: "create",
                    description: Some("Scaffolds a new extension project in a subdirectory of your app. To specify the type and name of your extension, you can use the interactive prompts or specify them as parameters on the command"),
                    options: [
                        (
                            names: [
                                "--type",
                            ],
                            description: Some("The type of extension that you want to create"),
                            arguments: [
                                (
                                    name: "TYPE",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--name",
                            ],
                            description: Some("The name of the extension. Shopify CLI transforms the input into snake case to name your directory. Extension names have a 50 character limit"),
                            arguments: [
                                (
                                    name: "NAME",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--api-key",
                            ],
                            arguments: [
                                (
                                    name: "KEY",
                                ),
                            ],
                        ),
                    ],
                    presentation: (
                        priority: Some(100.0),
                    ),
                ),
                (
                    name: "serve",
                    description: Some("Starts a local server that can be rendered in the development store. This command must be run from your extension’s directory. The server will continue to run until you press Ctrl+C"),
                    options: [
                        (
                            names: [
                                "--tunnel",
                            ],
                            description: Some("Creates an HTTP tunnel (this is the default behavior)"),
                        ),
                        (
                            names: [
                                "--no-tunnel",
                            ],
                            description: Some("Skips creating an HTTP tunnel"),
                        ),
                        (
                            names: [
                                "--ressourceUrl",
                            ],
                            arguments: [
                                (
                                    name: "RESOURCE",
                                    description: Some("A relative link to product or variant"),
                                ),
                            ],
                        ),
                    ],
                    presentation: (
                        priority: Some(90.0),
                    ),
                ),
                (
                    name: "register",
                    description: Some("Creates your app extension and associates it with an app in your Partner organization. This step should be done only once for each app extension. Before you can push your code to Shopify, you need to create an app in your Partner Dashboard that you want to register your extension to. After an extension is registered to an app, the registration can’t be undone"),
                    options: [
                        (
                            names: [
                                "--api-key",
                            ],
                            description: Some("The API key of the app that you want to register your extension to"),
                            arguments: [
                                (
                                    name: "KEY",
                                ),
                            ],
                        ),
                    ],
                    presentation: (
                        priority: Some(80.0),
                    ),
                ),
                (
                    name: "connect",
                    description: Some("Connects your local project directory to an existing app in your Partner organization. This command is intended to help teams collaborate on the same extension code. Each developer can clone the extension code locally, and then run shopify extension connect to populate the local .env file with the API keys required to push changes to the extension"),
                    presentation: (
                        priority: Some(70.0),
                    ),
                ),
                (
                    name: "push",
                    description: Some("Uploads your code to Shopify. You need to run this command before you can publish your extension from the Partner Dashboard. You need to register your extension before you can push it to Shopify"),
                    options: [
                        (
                            names: [
                                "--api-key",
                            ],
                            description: Some("Connect your extension and app by inserting your app's API key (which you can get from your app setup page on shopify.dev)"),
                            arguments: [
                                (
                                    name: "KEY",
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--registration-id",
                            ],
                            description: Some("The id of the extension's registration"),
                            arguments: [
                                (
                                    name: "REGISTRATION_ID",
                                ),
                            ],
                        ),
                    ],
                    presentation: (
                        priority: Some(60.0),
                    ),
                ),
                (
                    name: "check",
                    description: Some("Runs Theme Check to analyze your code for errors and to ensure that it follows theme and Liquid best practices. Learn more about the checks that Theme Check runs. This command is only valid for theme app extensions"),
                    options: [
                        (
                            names: [
                                "--config",
                            ],
                            description: Some("The path to your custom Theme Check config. This config overrides .theme-check.yml, if it is present in the directory being analyzed"),
                            arguments: [
                                (
                                    name: "PATH",
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--category",
                            ],
                            description: Some("Run only the specified category of checks. You can specify multiple categories using multiple instances of this flag"),
                            arguments: [
                                (
                                    name: "CATEGORY",
                                    suggestions: [
                                        (
                                            name: "html",
