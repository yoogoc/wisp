(
    version: 1,
    command: "progressline",
    description: Some("⏳Track commands progress in a compact one-line format"),
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for progressline"),
        ),
        (
            names: [
                "--log-all",
                "-a",
            ],
            description: Some("Log all lines above the progress line"),
        ),
        (
            names: [
                "--static-text",
                "-t",
            ],
            description: Some("Set static text to display instead of the latest stdin data"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            names: [
                "--activity-style",
                "-s",
            ],
            description: Some("Set style of the activity indicator"),
            arguments: [
                (
                    name: "style",
                    suggestions: [
                        (
                            name: "dots",
                        ),
                        (
                            name: "kitt",
                        ),
                        (
                            name: "snake",
                        ),
                    ],
                    default: Some("dots"),
                ),
            ],
        ),
        (
            names: [
                "--original-log-path",
                "-l",
            ],
            description: Some("Save the original log to a file"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--log-matches",
                "-m",
            ],
            description: Some("Log above progress line lines matching the given regular expressions"),
            arguments: [
                (
                    name: "regex",
                ),
            ],
        ),
    ],
)
