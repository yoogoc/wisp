                    name: "[PARAMETER...]",
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "emu",
            description: Some("Run emulator console command"),
            arguments: [
                (
                    name: "COMMAND",
                ),
            ],
        ),
        (
            name: "install",
            description: Some("Push a single package to the device and install it"),
            options: [
                (
                    names: [
                        "-l",
                    ],
                    description: Some("Forward-lock the app"),
                ),
                (
                    names: [
                        "-r",
                    ],
                    description: Some("Replace existing application"),
                ),
                (
                    names: [
                        "-t",
                    ],
                    description: Some("Allow test packages"),
                ),
                (
                    names: [
                        "-d",
                    ],
                    description: Some("Allow version code downgrade (debuggable packages only)"),
                ),
                (
                    names: [
                        "-s",
                    ],
                    description: Some("Install on SD card instead of internal storage"),
                ),
                (
                    names: [
                        "-g",
                    ],
                    description: Some("Grant all runtime permissions"),
                ),
                (
                    names: [
                        "--abi",
                    ],
                    description: Some("Override platform's default ABI"),
                    arguments: [
                        (
                            name: "ABI",
                        ),
                    ],
                ),
                (
                    names: [
                        "--instant",
                    ],
                    description: Some("Cause the app to be installed as an ephemeral install app"),
                ),
                (
                    names: [
                        "--no-streaming",
                    ],
                    description: Some("Always push APK to device and invoke Package Manager as separate steps"),
                ),
                (
                    names: [
                        "--streaming",
                    ],
                    description: Some("Force streaming APK directly into Package Manager"),
                ),
                (
                    names: [
                        "--fastdeploy",
                    ],
                    description: Some("Use fast deploy"),
                ),
                (
                    names: [
                        "--no-fastdeploy",
                    ],
                    description: Some("Prevent use of fast deploy"),
                ),
                (
                    names: [
                        "--force-agent",
                    ],
                    description: Some("Force update of deployment agent when using fast deploy"),
                ),
                (
                    names: [
                        "--date-check-agent",
                    ],
