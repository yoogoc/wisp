                (
                    name: "FILE",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "logcat",
            description: Some("Show device log (logcat --help for more)"),
        ),
        (
            name: "version",
            description: Some("Show version num"),
        ),
        (
            name: "connect",
