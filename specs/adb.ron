            arguments: [
                (
                    name: "HOST[:PORT]",
                ),
            ],
        ),
        (
            name: "disconnect",
            description: Some("Disconnect from given TCP/IP device [default port=5555], or all"),
            arguments: [
                (
                    name: "HOST[:PORT]",
                    optional: true,
                ),
            ],
        ),
        (
            name: "uninstall",
