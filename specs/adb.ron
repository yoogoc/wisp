(
    version: 1,
    command: "adb",
    description: Some("Android Debug Bridge"),
    subcommands: [
        (
            name: "devices",
            description: Some("List connected devices"),
            options: [
                (
                    names: [
                        "-l",
                    ],
                    description: Some("Long output"),
                ),
            ],
        ),
        (
            name: "help",
            description: Some("Show this help message"),
        ),
        (
            name: "get-state",
            description: Some("Print offline | bootloader | device"),
        ),
        (
            name: "get-serialno",
            description: Some("Print <serial-number>"),
        ),
        (
            name: "get-devpath",
            description: Some("Print <device-path>"),
        ),
        (
            name: "remount",
            description: Some("Remount partitions read-write. if a reboot is required, -R will automatically reboot the device"),
            options: [
                (
                    names: [
                        "-R",
                    ],
                    description: Some("Reboot device"),
                ),
            ],
        ),
        (
            name: "jdwp",
            description: Some("List pids of processes hosting a JDWP transport"),
        ),
        (
            name: "root",
            description: Some("Restart adbd with root permissions"),
        ),
        (
            name: "unroot",
            description: Some("Restart adbd without root permissions"),
        ),
        (
            name: "usb",
            description: Some("Restart adbd listening on USB"),
        ),
        (
            name: "sideload",
            description: Some("Sideload the given full OTA package"),
            arguments: [
                (
                    name: "OTAPACKAGE",
                ),
            ],
        ),
        (
            name: "start-server",
            description: Some("Ensure that there is a server running"),
        ),
        (
            name: "kill-server",
            description: Some("Kill the server if it is running"),
        ),
        (
            name: "reconnect",
            description: Some("Kick connection from host side to force reconnect"),
            subcommands: [
                (
                    name: "device",
                    description: Some("Kick connection from device side to force reconnect"),
                ),
                (
                    name: "offline",
                    description: Some("Reset offline/unauthorized devices to force reconnect`"),
                ),
            ],
        ),
        (
            name: "tcpip",
            description: Some("Restart adbd listening on TCP on PORT"),
            arguments: [
                (
                    name: "PORT",
                ),
            ],
        ),
        (
            name: "reboot",
            description: Some("Reboot the device; defaults to booting system image but supports bootloader and recovery too. sideload reboots into recovery and automatically starts sideload mode, sideload-auto-reboot is the same but reboots after sideloading"),
            arguments: [
                (
                    name: "type",
                    suggestions: [
                        (
                            name: "bootloader",
                        ),
                        (
                            name: "recovery",
                        ),
                        (
                            name: "sideload",
                        ),
                        (
                            name: "sideload-auto-reboot",
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "disable-verity",
            description: Some("Disable dm-verity checking on userdebug builds"),
        ),
        (
            name: "enable-verity",
            description: Some("Re-enable dm-verity checking on userdebug builds"),
        ),
        (
            name: "wait-for-device",
            description: Some("Wait for state=device"),
        ),
        (
            name: "wait-for-recovery",
            description: Some("Wait for state=recovery"),
        ),
        (
            name: "wait-for-rescue",
            description: Some("Wait for state=rescue"),
        ),
        (
            name: "wait-for-sideload",
            description: Some("Wait for state=sideload"),
        ),
        (
            name: "wait-for-bootloader",
            description: Some("Wait for state=bootloader"),
        ),
        (
            name: "wait-for-disconnect",
            description: Some("Wait for state=disconnect"),
        ),
        (
            name: "wait-for-usb-device",
            description: Some("Wait for usb in state=device"),
        ),
        (
            name: "wait-for-usb-recovery",
