(
    version: 1,
    command: "git_push_example",
    options: [
        (
            names: [
                "--all",
            ],
        ),
        (
            names: [
                "--mirror",
            ],
        ),
        (
            names: [
                "--tags",
            ],
        ),
        (
            names: [
                "-n",
                "--dry-run",
            ],
        ),
        (
            names: [
                "--receive-pack",
            ],
            arguments: [
                (
                    name: "git-receive-pack",
                ),
            ],
        ),
        (
            names: [
                "-u",
                "--set-upstream",
            ],
        ),
        (
            names: [
                "-o",
            ],
            arguments: [
                (
                    name: "string",
                ),
            ],
        ),
        (
            names: [
                "--push-option",
            ],
            arguments: [
                (
                    name: "string",
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "repository",
            optional: true,
        ),
        (
            name: "refspec",
            optional: true,
            variadic: true,
        ),
    ],
)
