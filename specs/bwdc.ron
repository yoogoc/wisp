                            name: "directory-type",
                            description: Some("Active Directory/LDAP : 0\nAzure Active Directory : 1\nGoogle Workspace/GSuite : 2\nOkta : 3\nOneLogin : 4"),
                            suggestions: [
                                (
                                    name: "0",
                                    description: Some("Active Directory/LDAP"),
                                ),
                                (
                                    name: "1",
                                    description: Some("Azure Active Directory"),
                                ),
