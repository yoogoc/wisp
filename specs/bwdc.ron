(
    version: 1,
    command: "bwdc",
    description: Some("Bitwarden Directory Connector"),
    subcommands: [
        (
            name: "login",
            description: Some("Log in to Directory Connector"),
            options: [
                (
                    names: [
                        "--help",
                    ],
                ),
            ],
            arguments: [
                (
                    name: "client_id",
                    description: Some("Organisation API client_id"),
                    optional: true,
                ),
                (
                    name: "client_secret",
                    description: Some("Organisation API client_secret"),
                    optional: true,
                ),
            ],
            presentation: (
