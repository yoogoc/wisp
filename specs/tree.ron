(
    version: 1,
    command: "tree",
    description: Some("Display directories as trees (with optional color/HTML output)"),
    options: [
        (
            names: [
                "-a",
            ],
            description: Some("All files are listed"),
        ),
        (
            names: [
                "-d",
            ],
            description: Some("List directories only"),
        ),
        (
            names: [
                "-l",
            ],
            description: Some("Follow symbolic links like directories"),
        ),
        (
            names: [
                "-f",
            ],
            description: Some("Print the full path prefix for each file"),
        ),
        (
            names: [
                "-x",
            ],
            description: Some("Stay on current filesystem only"),
        ),
        (
            names: [
                "-L",
            ],
            description: Some("Descend only level directories deep"),
            arguments: [
                (
                    name: "level",
                ),
            ],
        ),
        (
            names: [
                "-R",
            ],
            description: Some("Rerun tree when max dir level reached"),
        ),
        (
            names: [
                "-P",
            ],
            description: Some("List only those files that match the pattern given"),
            arguments: [
                (
                    name: "pattern",
                ),
            ],
        ),
        (
            names: [
                "-I",
            ],
            description: Some("Do not list files that match the given pattern"),
            arguments: [
                (
                    name: "pattern",
                ),
            ],
        ),
        (
            names: [
                "--ignore-case",
            ],
            description: Some("Ignore case when pattern matching"),
        ),
        (
            names: [
                "--matchdirs",
            ],
            description: Some("Include directory names in -P pattern matching"),
        ),
        (
            names: [
                "--noreport",
            ],
            description: Some("Turn off file/directory count at end of tree listing"),
        ),
        (
            names: [
                "--charset",
            ],
            description: Some("Use charset X for terminal/HTML and indentation line output"),
            arguments: [
                (
                    name: "charset",
                ),
            ],
        ),
        (
            names: [
                "--filelimit",
            ],
            description: Some("Do not descend dirs with more than # files in them"),
            arguments: [
                (
                    name: "number",
                    description: Some("Number of files"),
                ),
            ],
        ),
        (
            names: [
                "--timefmt",
            ],
            description: Some("Print and format time according to the format <f>"),
            arguments: [
                (
                    name: "format",
                    description: Some("Format in strftime syntax"),
                ),
            ],
        ),
        (
            names: [
                "-o",
            ],
            description: Some("Output to file instead of stdout"),
            arguments: [
                (
                    name: "filename",
                ),
            ],
        ),
        (
            names: [
                "-q",
            ],
            description: Some("Print non-printable characters as '?'"),
        ),
        (
            names: [
                "-N",
            ],
            description: Some("Print non-printable characters as is"),
        ),
        (
            names: [
                "-Q",
            ],
            description: Some("Quote filenames with double quotes"),
        ),
        (
            names: [
                "-p",
            ],
            description: Some("Print the protections for each file"),
        ),
        (
            names: [
                "-u",
            ],
            description: Some("Displays file owner or UID number"),
        ),
        (
            names: [
                "-g",
            ],
            description: Some("Displays file group owner or GID number"),
        ),
        (
            names: [
                "-s",
            ],
            description: Some("Print the size in bytes of each file"),
        ),
        (
            names: [
                "-h",
            ],
            description: Some("Print the size in a more human readable way"),
        ),
        (
            names: [
                "--si",
            ],
            description: Some("Like -h but use SI units (powers of 1000) instead"),
        ),
        (
            names: [
                "--du",
            ],
            description: Some("For each directory report its size as the accumulation of sizes of all its files and sub-directories (and their files, and so on). The total amount of used space is also given in the final report (like the 'du -c' command.) This option requires tree to read the entire directory tree before emitting it, see BUGS AND NOTES below. Implies -s"),
        ),
        (
            names: [
                "-D",
            ],
            description: Some("Print the date of the last modification time or if -c is used, the last status change time for the file listed"),
        ),
        (
            names: [
                "-F",
            ],
            description: Some("Appends '/', '=', '*', '@', '|' or '>' as per ls -F"),
        ),
        (
            names: [
                "--inodes",
            ],
            description: Some("Print inode number of each file"),
        ),
        (
            names: [
                "--device",
            ],
            description: Some("Print device ID number to which each file belongs"),
        ),
        (
            names: [
                "-v",
            ],
            description: Some("Sort files alphanumerically by version"),
        ),
        (
            names: [
                "-t",
            ],
            description: Some("Sort files by last modification time"),
        ),
        (
            names: [
                "-c",
            ],
            description: Some("Sort files by last status change time"),
        ),
        (
            names: [
                "-U",
            ],
            description: Some("Leave files unsorted"),
        ),
        (
            names: [
                "-r",
            ],
            description: Some("Reverse the order of the sort"),
        ),
        (
            names: [
                "--dirsfirst",
            ],
            description: Some("List directories before files (-U disables)"),
        ),
        (
            names: [
                "--sort",
            ],
            description: Some("Select sort"),
            arguments: [
                (
                    name: "type",
                    suggestions: [
                        (
                            name: "name",
                        ),
                        (
                            name: "version",
                        ),
                        (
                            name: "size",
                        ),
                        (
                            name: "mtime",
                        ),
                        (
                            name: "ctime",
                        ),
                    ],
                ),
            ],
            requires_separator: Some("="),
        ),
        (
            names: [
                "-i",
            ],
            description: Some("Don't print indentation lines"),
        ),
        (
            names: [
                "-A",
            ],
            description: Some("Print ANSI lines graphic indentation lines"),
        ),
        (
            names: [
                "-S",
            ],
            description: Some("Print with CP437 (console) graphics indentation lines"),
        ),
        (
            names: [
                "-n",
            ],
            description: Some("Turn colorization off always (-C overrides)"),
        ),
        (
            names: [
                "-C",
            ],
            description: Some("Turn colorization on always"),
        ),
        (
            names: [
                "-X",
            ],
            description: Some("Prints out an XML representation of the tree"),
        ),
        (
            names: [
                "-J",
            ],
            description: Some("Prints out an JSON representation of the tree"),
        ),
        (
            names: [
                "-H",
            ],
            description: Some("Prints out HTML format with baseHREF as top directory"),
            arguments: [
                (
                    name: "baseHREF",
                ),
            ],
        ),
        (
            names: [
                "-T",
            ],
            description: Some("Replace the default HTML title and H1 header with string"),
            arguments: [
                (
                    name: "title",
                ),
            ],
        ),
        (
            names: [
                "--nolinks",
            ],
            description: Some("Turn off hyperlinks in HTML output"),
        ),
        (
            names: [
                "--fromfile",
            ],
            description: Some("Reads paths from files"),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Print version and exit"),
        ),
        (
            names: [
                "--help",
            ],
            description: Some("Print usage and this help message and exit"),
        ),
        (
            names: [
                "--",
            ],
            description: Some("Options processing terminator"),
        ),
    ],
    arguments: [
        (
            name: "",
            template: [
                Folders,
            ],
        ),
    ],
)
