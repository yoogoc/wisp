(
    version: 1,
    command: "just",
    description: Some("Just a command runner"),
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Print help information"),
        ),
        (
            names: [
                "--changelog",
            ],
            description: Some("Print the changelog"),
        ),
        (
            names: [
                "--check",
            ],
            description: Some("Run --fmt in 'check' mode"),
            depends_on: [
                "--unstable",
                "--fmt",
            ],
        ),
        (
            names: [
                "--choose",
            ],
            description: Some("Select one or more recipes to run using another program"),
        ),
        (
            names: [
                "--chooser",
            ],
            description: Some("Override the binary invoked by --choose"),
            arguments: [
                (
                    name: "program",
                ),
            ],
        ),
        (
            names: [
                "--color",
            ],
            description: Some("Print colorful output"),
            arguments: [
                (
                    name: "",
                    suggestions: [
                        (
                            name: "auto",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "always",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "never",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-c",
                "--command",
            ],
            description: Some("Run an arbitrary command with the working directory, .env, overrides, and exports"),
            arguments: [
                (
                    name: "command",
                    is_command: true,
                ),
            ],
        ),
        (
            names: [
                "--completions",
            ],
            description: Some("Print shell completions"),
            arguments: [
                (
                    name: "shell",
                    suggestions: [
                        (
                            name: "zsh",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "bash",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "fish",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "powershell",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "elvish",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--clear-shell-args",
            ],
            description: Some("Clear shell arguments"),
        ),
        (
            names: [
                "--dry-run",
            ],
            description: Some("Print what just would do, without doing it"),
        ),
        (
            names: [
                "--dump",
            ],
            description: Some("Print justfile"),
        ),
        (
            names: [
                "--dotenv-filename",
            ],
            description: Some("Use a file with this name instead of .env"),
            arguments: [
                (
                    name: "name",
                ),
            ],
        ),
        (
            names: [
                "--dotenv-path",
            ],
            description: Some("Load the environment file from a path instead of searching for one"),
        ),
        (
            names: [
                "--dump-format",
            ],
            description: Some("Specify the format for dumping the justfile"),
            arguments: [
                (
                    name: "format",
                    suggestions: [
                        (
                            name: "just",
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                        (
                            name: "json",
                            description: Some("This value requires --unstable"),
                            presentation: (
                                icon: Some("fig://icon?type=string"),
                            ),
                        ),
                    ],
                ),
            ],
            depends_on: [
                "--dump",
            ],
        ),
        (
            names: [
                "-e",
                "--edit",
            ],
            description: Some("Edit the justfile with $VISUAL or $EDITOR, falling back to vim"),
        ),
        (
            names: [
                "--evaluate",
            ],
            description: Some("Evaluate and print all variables"),
        ),
        (
            names: [
                "--fmt",
            ],
            description: Some("Format and overwrite the justfile"),
            depends_on: [
                "--unstable",
            ],
        ),
        (
            names: [
                "--highlight",
            ],
            description: Some("Highlight echoed recipe lines in bold"),
            exclusive_on: [
                "--no-highlight",
            ],
        ),
        (
            names: [
                "--init",
            ],
            description: Some("Initialize a new justfile"),
        ),
        (
            names: [
                "-f",
                "--justfile",
            ],
            description: Some("Use a specific justfile"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-l",
                "--list",
            ],
            description: Some("List available recipes and their arguments"),
        ),
        (
            names: [
                "--list-heading",
            ],
            description: Some("Print this text before the list"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            names: [
                "--list-prefix",
            ],
            description: Some("Print this text before each list item"),
            arguments: [
                (
                    name: "text",
                ),
            ],
        ),
        (
            names: [
                "--no-dotenv",
            ],
            description: Some("Don't load the environment file"),
        ),
        (
            names: [
                "--no-highlight",
            ],
            description: Some("Don't highlight echoed recipe lines"),
            exclusive_on: [
                "--highlight",
            ],
        ),
        (
            names: [
                "-q",
                "--quiet",
            ],
            description: Some("Suppress all output"),
        ),
        (
            names: [
                "--set",
            ],
            description: Some("Override a variable with a value"),
            arguments: [
                (
                    name: "variable",
                    generators: [
                        (
                            has_dynamic_script: true,
                            has_post_process: true,
                        ),
                    ],
                ),
                (
                    name: "value",
                    description: Some("The string value the variable will be set to"),
                ),
            ],
        ),
        (
            names: [
                "--shell",
            ],
            description: Some("Invoke this shell to run recipes"),
            arguments: [
                (
                    name: "shell",
                    default: Some("sh"),
                ),
            ],
        ),
        (
            names: [
                "--shell-arg",
            ],
            description: Some("Invoke the shell with this as an argument"),
            arguments: [
                (
                    name: "argument",
                    default: Some("-cu"),
                ),
            ],
        ),
        (
            names: [
                "--shell-command",
            ],
            description: Some("Invoke --command with the shell used to run recipe lines and backticks"),
        ),
        (
            names: [
                "-s",
                "--show",
            ],
            description: Some("Show information about a recipe"),
            arguments: [
                (
                    name: "recipe",
                    generators: [
                        (
                            has_dynamic_script: true,
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--summary",
            ],
            description: Some("List names of available recipes"),
        ),
        (
            names: [
                "-u",
                "--unsorted",
            ],
            description: Some("Return list and summary entries in source order"),
        ),
        (
            names: [
                "--unstable",
            ],
            description: Some("Enable unstable features"),
        ),
        (
            names: [
                "--variables",
            ],
            description: Some("List names of variables"),
        ),
        (
            names: [
                "-v",
                "--verbose",
            ],
            description: Some("Use verbose output"),
        ),
        (
            names: [
                "-V",
                "--version",
            ],
            description: Some("Print version information"),
        ),
        (
            names: [
                "-d",
                "--working-directory",
            ],
            description: Some("Use this as the working directory"),
            arguments: [
                (
                    name: "",
                    template: [
                        Folders,
                    ],
                ),
            ],
            depends_on: [
                "--justfile",
            ],
        ),
    ],
    arguments: [
        (
            name: "args",
            generators: [
                (
                    has_dynamic_script: true,
                    has_post_process: true,
                    has_dynamic_trigger: true,
                ),
            ],
            optional: true,
            variadic: true,
        ),
    ],
)
