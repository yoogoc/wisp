                (
                    name: "diff",
                    description: Some("Compares the database schema from two arbitrary sources, and outputs the differences either as a human-readable summary (by default) or an executable script"),
                    options: [
                        (
                            names: [
                                "-h",
                                "--help",
                            ],
                            description: Some("Display this help message"),
                        ),
                        (
                            names: [
                                "--from-url",
                            ],
                            description: Some("A datasource url"),
                            arguments: [
                                (
                                    name: "full url",
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--to-url",
                            ],
                            description: Some("A datasource url"),
                            arguments: [
                                (
                                    name: "full url",
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--from-empty",
                            ],
                            description: Some("Flag to assume from is an empty datamodel"),
                        ),
                        (
                            names: [
                                "--to-empty",
                            ],
                            description: Some("Flag to assume to is an empty datamodel"),
                        ),
                        (
                            names: [
                                "--from-schema-datamodel",
                            ],
                            description: Some("Path to a Prisma schema file, uses the 'datamodel' for the diff"),
                            arguments: [
                                (
                                    name: "filepath",
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--to-schema-datamodel",
                            ],
                            description: Some("Path to a Prisma schema file, uses the 'datamodel' for the diff"),
                            arguments: [
                                (
                                    name: "filepath",
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--from-schema-datasource",
                            ],
                            description: Some("Path to a Prisma schema file, uses the 'datasource url' for the diff"),
                            arguments: [
                                (
                                    name: "filepath",
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--to-schema-datasource",
                            ],
                            description: Some("Path to a Prisma schema file, uses the 'datasource url' for the diff"),
                            arguments: [
                                (
                                    name: "filepath",
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--from-migrations",
                            ],
                            description: Some("Path to the Prisma Migrate migrations directory"),
                            arguments: [
                                (
                                    name: "folder",
                                    template: [
                                        Folders,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--to-migrations",
                            ],
                            description: Some("Path to the Prisma Migrate migrations directory"),
                            arguments: [
                                (
                                    name: "folder",
                                    template: [
                                        Folders,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--shadow-database-url",
                            ],
                            description: Some("URL for the shadow database. Only required if using --from-migrations or --to-migrations"),
                            arguments: [
                                (
                                    name: "full url",
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--script",
                            ],
                            description: Some("Render a SQL script to stdout instead of the default human readable summary (not supported on MongoDB)"),
                            arguments: [
                                (
                                    name: "filepath",
                                    template: [
                                        FilePaths,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--exit-code",
                            ],
                            description: Some("Change the exit code behavior to signal if the diff is empty or not (Empty: 0, Error: 1, Not empty: 2). Default behavior is Success: 0, Error: 1.`"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "db",
