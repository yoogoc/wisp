                        ),
                        (
                            names: [
                                "--skip-generate",
                            ],
                            description: Some("Skip triggering generators (e.g. Prisma Client)"),
                        ),
                        (
                            names: [
                                "--create-only",
                            ],
                            description: Some("Create a new migration but do not apply it. The migration will be empty if there are no changes in Prisma schema"),
                        ),
                        (
                            names: [
                                "-n",
                                "--name",
                            ],
                            description: Some("The name of the migration. If no name is provided, the CLI will prompt you"),
                            arguments: [
                                (
                                    name: "filename",
                                    optional: true,
                                ),
                            ],
                        ),
                    ],
                    presentation: (
                        icon: Some("💻"),
                    ),
                ),
                (
                    name: "reset",
                    description: Some("Reset your database and apply all migrations, all data will be lost"),
                    options: [
                        (
                            names: [
                                "-h",
                                "--help",
                            ],
                            description: Some("Display this help message"),
                        ),
                        (
                            names: [
                                "--schema",
                            ],
                            description: Some("Custom path to your Prisma schema"),
