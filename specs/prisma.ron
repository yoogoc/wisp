                    ],
                    description: Some("Browser to open Studio in"),
                    arguments: [
                        (
                            name: "Browser choice",
                            suggestions: [
                                (
                                    name: "firefox",
                                ),
                                (
                                    name: "chrome",
                                ),
                                (
                                    name: "safari",
                                ),
                                (
                                    name: "none",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-n",
