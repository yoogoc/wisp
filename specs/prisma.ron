        ),
        (
            name: "migrate",
            description: Some("Migrate your database"),
            subcommands: [
                (
                    name: "dev",
                    description: Some("The migrate dev command updates your database using migrations files during development"),
                    options: [
                        (
                            names: [
                                "-h",
                                "--help",
                            ],
                            description: Some("Display this help message"),
                        ),
                        (
                            names: [
                                "--schema",
                            ],
