                                        FilePaths,
                                    ],
                                ),
                            ],
                        ),
                        (
                            names: [
                                "--skip-seed",
                            ],
                            description: Some("Skip triggering seed"),
                        ),
                        (
                            names: [
                                "--skip-generate",
                            ],
                            description: Some("Skip triggering generators (e.g. Prisma Client)"),
                        ),
