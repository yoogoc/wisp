(
    version: 1,
    command: "prisma",
    description: Some("Prisma is a modern DB toolkit to query, migrate and model your database"),
    subcommands: [
        (
            name: "init",
            description: Some("Setup Prisma for your app"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Display this help message"),
                ),
                (
                    names: [
                        "--datasource-provider",
                    ],
                    description: Some("Define the datasource provider to use"),
                    arguments: [
                        (
                            name: "",
                            description: Some("Choose provider"),
                            suggestions: [
                                (
                                    name: "PostgreSQL",
                                ),
                                (
                                    name: "MySQL",
                                ),
                                (
                                    name: "SQLite",
                                ),
                                (
                                    name: "SQLServer",
                                ),
                                (
                                    name: "MongoDB",
                                ),
                                (
                                    name: "CockroachDB",
                                ),
                            ],
                            default: Some("PostgreSQL"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--url",
                    ],
                    description: Some("Define a custom datasource url"),
                    arguments: [
                        (
                            name: "full url",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "generate",
            description: Some("Generate artifacts (e.g. Prisma Client)"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Display this help message"),
                ),
                (
                    names: [
                        "--schema",
                    ],
                    description: Some("Custom path to your Prisma schema"),
                    arguments: [
                        (
                            name: "Schema path",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--data-proxy",
                    ],
                    description: Some("Enable the Data Proxy in the Prisma Client"),
                ),
                (
                    names: [
                        "--no-hints",
                    ],
                    description: Some("Hides the hint messages but still outputs errors and warnings"),
                ),
                (
                    names: [
                        "--no-engine",
                    ],
                    description: Some("Generate a client for use with Accelerate only"),
                ),
                (
                    names: [
                        "--watch",
                    ],
                    description: Some("Watch the Prisma schema and rerun after a change"),
                ),
                (
                    names: [
                        "--allow-no-models",
                    ],
                    description: Some("Allow generating a client without models"),
                ),
            ],
        ),
        (
            name: "studio",
            description: Some("Open Prisma Studio"),
            options: [
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Display this help message"),
                ),
                (
                    names: [
                        "--schema",
                    ],
