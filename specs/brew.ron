                (
                    names: [
                        "--days",
                    ],
                    description: Some("How many days of analytics data to retrieve"),
                    arguments: [
                        (
                            name: "days",
                            description: Some("Number of days of data to retrieve"),
                            suggestions: [
                                (
                                    name: "30",
                                ),
                                (
                                    name: "90",
                                ),
                                (
                                    name: "365",
                                ),
                            ],
                        ),
                    ],
                    exclusive_on: [
                        "--analytics",
                    ],
                ),
                (
                    names: [
                        "--category",
                    ],
                    description: Some("Which type of analytics data to retrieve"),
                    arguments: [
                        (
                            name: "",
