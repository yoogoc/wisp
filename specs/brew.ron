        (
            name: "upgrade",
            description: Some("Upgrade outdated casks and outdated, unpinned formulae using the same options they were originally installed with, plus any appended brew formula options"),
            options: [
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("If brewing fails, open an interactive debugging session with access to IRB or a shell inside the temporary build directory"),
                ),
                (
                    names: [
                        "-f",
                        "--force",
                    ],
                    description: Some("Install formulae without checking for previously installed keg-only or non-migrated versions. When installing casks, overwrite existing files (binaries and symlinks are excluded, unless originally from the same cask)"),
                ),
                (
                    names: [
                        "-v",
                        "--verbose",
                    ],
                    description: Some("Print the verification and postinstall steps"),
                ),
                (
                    names: [
                        "-n",
                        "--dry-run",
                    ],
                    description: Some("Show what would be upgraded, but do not actually upgrade anything"),
                ),
                (
                    names: [
                        "-s",
                        "--build-from-source",
                    ],
                    description: Some("Compile formula from source even if a bottle is provided. Dependencies will still be installed from bottles if they are available"),
                ),
                (
                    names: [
                        "-i",
                        "--interactive",
                    ],
                    description: Some("Download and patch formula, then open a shell"),
                ),
                (
                    names: [
                        "-g",
                        "--git",
                    ],
                    description: Some("Create a Git repository"),
                ),
                (
                    names: [
                        "-q",
                        "--quiet",
                    ],
                    description: Some("Make some output more quiet"),
                ),
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Show this message"),
                ),
                (
                    names: [
                        "--formula",
                        "--formulae",
                    ],
                    description: Some("Treat all named arguments as formulae. If no named arguments are specified, upgrade only outdated formulae"),
                ),
                (
                    names: [
                        "--env",
                    ],
                    description: Some("Disabled other than for internal Homebrew use"),
                ),
                (
                    names: [
                        "--ignore-dependencies",
                    ],
                    description: Some("An unsupported Homebrew development flag to skip installing any dependencies of any kind. If the dependencies are not already present, the formula will have issues. If you're not developing Homebrew, consider adjusting your PATH rather than using this flag"),
                ),
                (
                    names: [
                        "--only-dependencies",
                    ],
                    description: Some("Install the dependencies with specified options but do not install the formula itself"),
                ),
                (
                    names: [
                        "--cc",
                    ],
                    description: Some("Attempt to compile using the specified compiler, which should be the name of the compiler's executable"),
                    arguments: [
                        (
                            name: "compiler",
                            suggestions: [
                                (
                                    name: "gcc-7",
                                ),
                                (
                                    name: "llvm_clang",
                                ),
                                (
                                    name: "clang",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--force-bottle",
                    ],
                    description: Some("Install from a bottle if it exists for the current or newest version of macOS, even if it would not normally be used for installation"),
                ),
                (
                    names: [
                        "--include-test",
                    ],
                    description: Some("Install testing dependencies required to run brew test formula"),
                ),
                (
                    names: [
                        "--HEAD",
                    ],
                    description: Some("If formula defines it, install the HEAD version, aka. main, trunk, unstable, master"),
                ),
                (
                    names: [
                        "--fetch-HEAD",
                    ],
                    description: Some("Fetch the upstream repository to detect if the HEAD installation of the formula is outdated. Otherwise, the repository's HEAD will only be checked for updates when a new stable or development version has been released"),
                ),
                (
                    names: [
                        "--ignore-pinned",
                    ],
                    description: Some("Set a successful exit status even if pinned formulae are not upgraded"),
                ),
                (
                    names: [
                        "--keep-tmp",
                    ],
                    description: Some("Retain the temporary files created during installation"),
                ),
                (
                    names: [
                        "--build-bottle",
                    ],
                    description: Some("Prepare the formula for eventual bottling during installation, skipping any post-install steps"),
                ),
                (
                    names: [
                        "--bottle-arch",
                    ],
                    description: Some("Optimise bottles for the specified architecture rather than the oldest architecture supported by the version of macOS the bottles are built on"),
                ),
                (
                    names: [
                        "--display-times",
                    ],
                    description: Some("Print install times for each formula at the end of the run"),
                ),
                (
                    names: [
                        "--cask",
                        "--casks",
                    ],
                    description: Some("Treat all named arguments as casks. If no named arguments are specified, upgrade only outdated casks"),
                ),
                (
                    names: [
                        "--binaries",
                    ],
                    description: Some("Disable/enable linking of helper executables (default: enabled)"),
                    exclusive_on: [
                        "--no-binaries",
                    ],
                ),
                (
                    names: [
                        "--no-binaries",
                    ],
                    description: Some("Disable/enable linking of helper executables (default: enabled)"),
                    exclusive_on: [
                        "--binaries",
                    ],
                ),
                (
                    names: [
                        "--require-sha",
                    ],
                    description: Some("Require all casks to have a checksum"),
                ),
                (
                    names: [
                        "--quarantine",
                    ],
                    description: Some("Disable/enable quarantining of downloads (default: enabled)"),
                    exclusive_on: [
                        "--no-quarantine",
                    ],
                ),
                (
                    names: [
                        "--no-quarantine",
                    ],
                    description: Some("Disable/enable quarantining of downloads (default: enabled)"),
                    exclusive_on: [
                        "--quarantine",
                    ],
                ),
                (
                    names: [
                        "--skip-cask-deps",
                    ],
                    description: Some("Skip installing cask dependencies"),
                ),
                (
                    names: [
                        "--greedy",
                    ],
                    description: Some("Also include casks with auto_updates true or version :latest"),
                    exclusive_on: [
