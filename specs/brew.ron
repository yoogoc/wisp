                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Display any debugging information"),
                ),
                (
                    names: [
                        "-q",
                        "--quiet",
                    ],
                    description: Some("List only the names of outdated kegs"),
                ),
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Get help with services command"),
