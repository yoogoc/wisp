(
    version: 1,
    command: "brew",
    description: Some("Package manager for macOS"),
    subcommands: [
        (
            name: "list",
            description: Some("List all installed formulae"),
            options: [
                (
                    names: [
                        "-d",
                        "--debug",
                    ],
                    description: Some("Display any debugging information"),
                ),
                (
                    names: [
                        "-q",
                        "--quiet",
                    ],
                    description: Some("Make some output more quiet"),
                ),
                (
                    names: [
                        "-v",
                        "--verbose",
                    ],
                    description: Some("Make some output more verbose"),
                ),
                (
                    names: [
                        "-h",
                        "--help",
                    ],
                    description: Some("Show help message"),
                ),
                (
                    names: [
                        "--formula",
                        "--formulae",
                    ],
                    description: Some("List only formulae, or treat all named arguments as formulae"),
                ),
                (
                    names: [
                        "--cask",
                        "--casks",
                    ],
                    description: Some("List only casks, or treat all named arguments as casks"),
                ),
                (
                    names: [
                        "--unbrewed",
                    ],
                    description: Some("List files in Homebrew's prefix not installed by Homebrew. (disabled; replaced by brew --prefix --unbrewed)"),
                ),
                (
                    names: [
                        "--full-name",
                    ],
                    description: Some("Print formulae with fully-qualified names. Unless --full-name, --versions or"),
                ),
                (
                    names: [
                        "--pinned",
                    ],
                    description: Some("List only pinned formulae, or only the specified (pinned) formulae if formula are provided"),
                ),
                (
                    names: [
                        "--versions",
                    ],
                    description: Some("Show the version number for installed formulae, or only the specified formulae if formula are provided"),
                ),
                (
                    names: [
                        "--multiple",
                    ],
                    description: Some("Only show formulae with multiple versions installed"),
                ),
                (
                    names: [
                        "--pinned",
                    ],
                    description: Some("List only pinned formulae, or only the specified (pinned) formulae if formula are provided. See also pin, unpin"),
                ),
                (
                    names: [
                        "-1",
                    ],
                    description: Some("Force output to be one entry per line. This is the default when output is not to a terminal"),
                ),
                (
                    names: [
                        "-l",
                    ],
                    description: Some("List formulae and/or casks in long format. Has no effect when a formula or cask name is passed as an argument"),
                ),
                (
                    names: [
                        "-r",
                    ],
                    description: Some("Reverse the order of the formulae and/or casks sort to list the oldest entries first. Has no effect when a formula or cask name is passed as an argument"),
                ),
                (
                    names: [
                        "-t",
                    ],
                    description: Some("Sort formulae and/or casks by time modified, listing most recently modified first. Has no effect when a formula or cask name is passed as an argument"),
                ),
            ],
            arguments: [
                (
                    name: "formula",
                    generators: [
                        (
                            script: [
                                "brew",
                                "list",
                                "-1",
                            ],
                            has_post_process: true,
                        ),
                    ],
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
