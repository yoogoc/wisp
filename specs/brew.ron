                (
                    names: [
                        "--merge",
                    ],
                    description: Some("Use git merge to apply updates (rather than git rebase)"),
                ),
                (
                    names: [
                        "--preinstall",
                    ],
                    description: Some("Run on auto-updates (e.g. before brew install). Skips some slower steps"),
                ),
            ],
        ),
