                                (
                                    has_custom: true,
                                ),
                            ],
                        ),
                    ],
                    exclusive_on: [
                        "--analytics",
                    ],
                ),
                (
                    names: [
                        "--github",
                    ],
                    description: Some("Open the GitHub source page for formula in a browser"),
                ),
                (
                    names: [
                        "--json",
                    ],
                    description: Some("Print a JSON representation"),
                ),
                (
                    names: [
                        "--installed",
                    ],
                    description: Some("Print JSON of formulae that are currently installed"),
                    exclusive_on: [
                        "--json",
                    ],
                ),
                (
                    names: [
                        "--all",
                    ],
                    description: Some("Print JSON of all available formulae"),
                    exclusive_on: [
                        "--json",
                    ],
                ),
                (
                    names: [
                        "-v",
                        "--verbose",
                    ],
                    description: Some("Show more verbose analytics data for formulae"),
