(
    version: 1,
    command: "projj",
    description: Some("Manage repository easily"),
    subcommands: [
        (
            name: "completion",
            description: Some("Generate completion script"),
        ),
        (
            name: "add",
            description: Some("Add repository"),
            arguments: [
                (
                    name: "repository url",
                ),
            ],
        ),
        (
            name: "find",
            description: Some("Find repository"),
            arguments: [
                (
                    name: "repository name",
                    generators: [
                        (
                            has_custom: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "import",
            description: Some("Import repositories from existing directory"),
            arguments: [
                (
                    name: "directory",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            name: "init",
            description: Some("Initialize configuration"),
        ),
        (
            name: "remove",
            description: Some("Remove repository"),
            arguments: [
                (
                    name: "repository name",
                    generators: [
                        (
                            has_custom: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "run",
            description: Some("Run hook in current directory"),
            arguments: [
                (
                    name: "hook name",
                    generators: [
                        (
                            has_custom: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "runall",
            description: Some("Run hook in every repository"),
            arguments: [
                (
                    name: "hook name",
                    generators: [
                        (
                            has_custom: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "sync",
            description: Some("Sync data from directory"),
            arguments: [
                (
                    name: "directory",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for projj"),
        ),
        (
            names: [
                "--version",
                "-v",
            ],
            description: Some("Show version number"),
        ),
    ],
)
