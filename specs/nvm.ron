(
    version: 1,
    command: "nvm",
    description: Some("Node Package Manager"),
    subcommands: [
        (
            name: "install",
            description: Some("Download and install a <version>. Uses .nvmrc if available and version is omitted"),
            options: [
                (
                    names: [
                        "-s",
                    ],
                    description: Some("Skip binary download, install from source only"),
                ),
                (
                    names: [
                        "--reinstall-packages-from",
                    ],
                    description: Some("When installing, reinstall packages installed in <version>"),
                    arguments: [
                        (
                            name: "version",
                            description: Some("Node version"),
                            suggestions: [
                                (
                                    name: "node",
                                    description: Some("The latest version of node"),
                                ),
                                (
                                    name: "iojs",
                                    description: Some("The latest version of io.js"),
                                ),
                                (
                                    name: "system",
                                    description: Some("System-installed version of node"),
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--lts",
                    ],
                    description: Some("When installing, only select from LTS (long-term support) versions"),
                ),
                (
                    names: [
                        "--lts",
                    ],
                    description: Some("When installing, only select from versions for a specific LTS line"),
                    arguments: [
                        (
                            name: "LTS name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--skip-default-packages",
                    ],
                    description: Some("When installing, skip the default-packages file if it exists"),
                ),
                (
                    names: [
                        "--latest-npm",
                    ],
                    description: Some("After installing, attempt to upgrade to the latest working npm on the given node version"),
                ),
                (
                    names: [
                        "--no-progress",
                    ],
                    description: Some("Disable the progress bar on any downloads"),
                ),
                (
                    names: [
                        "--alias",
                    ],
                    description: Some("After installing, set the alias specified to the version specified. (same as: nvm alias <name> <version>)"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--default",
                    ],
                    description: Some("After installing, set default alias to the version specified. (same as: nvm alias default <version>)"),
                ),
            ],
            arguments: [
                (
                    name: "version",
                    description: Some("Node version"),
                    suggestions: [
                        (
                            name: "node",
                            description: Some("The latest version of node"),
                        ),
                        (
                            name: "iojs",
                            description: Some("The latest version of io.js"),
                        ),
                        (
                            name: "system",
                            description: Some("System-installed version of node"),
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "uninstall",
            description: Some("Uninstall a version"),
            options: [
                (
                    names: [
                        "--lts",
                    ],
                    description: Some("Uninstall using automatic LTS (long-term support) alias `lts/*`, if available"),
                ),
                (
                    names: [
                        "--lts",
                    ],
                    description: Some("Uninstall using automatic alias for provided LTS line, if available"),
                    arguments: [
                        (
                            name: "LTS name",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "version",
                    description: Some("Node version"),
                    suggestions: [
                        (
                            name: "node",
                            description: Some("The latest version of node"),
                        ),
                        (
                            name: "iojs",
                            description: Some("The latest version of io.js"),
                        ),
                        (
                            name: "system",
                            description: Some("System-installed version of node"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "use",
            description: Some("Modify PATH to use <version>. Uses .nvmrc if available and version is omitted"),
            options: [
                (
                    names: [
                        "--silent",
                    ],
                    description: Some("Silences stdout/stderr output"),
                ),
                (
                    names: [
                        "--lts",
                    ],
                    description: Some("Uses automatic LTS (long-term support) alias `lts/*`, if available"),
                ),
                (
                    names: [
                        "--lts",
                    ],
                    description: Some("Uses automatic alias for provided LTS line, if available"),
                    arguments: [
                        (
                            name: "LTS name",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "version",
                    description: Some("Node version"),
                    suggestions: [
                        (
                            name: "node",
                            description: Some("The latest version of node"),
                        ),
                        (
                            name: "iojs",
                            description: Some("The latest version of io.js"),
                        ),
                        (
                            name: "system",
                            description: Some("System-installed version of node"),
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "exec",
            description: Some("Run <command> on <version>. Uses .nvmrc if available and version is omitted"),
            options: [
                (
                    names: [
                        "--silent",
                    ],
                    description: Some("Silences stdout/stderr output"),
                ),
                (
                    names: [
                        "--lts",
                    ],
                    description: Some("Uses automatic LTS (long-term support) alias `lts/*`, if available"),
                ),
                (
                    names: [
                        "--lts",
                    ],
                    description: Some("Uses automatic alias for provided LTS line, if available"),
                    arguments: [
                        (
                            name: "LTS name",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "version",
                    description: Some("Node version"),
                    suggestions: [
                        (
                            name: "node",
                            description: Some("The latest version of node"),
                        ),
                        (
                            name: "iojs",
                            description: Some("The latest version of io.js"),
                        ),
                        (
                            name: "system",
                            description: Some("System-installed version of node"),
                        ),
                    ],
                    optional: true,
                ),
                (
                    name: "command",
                    variadic: true,
                ),
            ],
        ),
        (
            name: "run",
            description: Some("Run `node` on <version> with <args> as arguments. Uses .nvmrc if available and version is omitted"),
            options: [
                (
                    names: [
                        "--silent",
                    ],
                    description: Some("Silences stdout/stderr output"),
                ),
                (
                    names: [
                        "--lts",
                    ],
                    description: Some("Uses automatic LTS (long-term support) alias `lts/*`, if available"),
                ),
                (
                    names: [
                        "--lts",
                    ],
                    description: Some("Uses automatic alias for provided LTS line, if available"),
                    arguments: [
                        (
                            name: "LTS name",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "version",
                    description: Some("Node version"),
                    suggestions: [
                        (
                            name: "node",
                            description: Some("The latest version of node"),
                        ),
                        (
                            name: "iojs",
                            description: Some("The latest version of io.js"),
                        ),
                        (
                            name: "system",
                            description: Some("System-installed version of node"),
                        ),
                    ],
                    optional: true,
                ),
                (
                    name: "args",
                    variadic: true,
                ),
            ],
        ),
        (
            name: "current",
            description: Some("Display currently activated version of Node"),
        ),
        (
            name: "ls",
            description: Some("List installed versions, matching a given <version> if provided"),
            options: [
                (
                    names: [
                        "--no-colors",
                    ],
                    description: Some("Suppress colored output"),
                ),
                (
                    names: [
                        "--no-alias",
                    ],
                    description: Some("Suppress `nvm alias` output"),
                ),
            ],
            arguments: [
                (
                    name: "version",
                    description: Some("Node version"),
                    suggestions: [
                        (
                            name: "node",
                            description: Some("The latest version of node"),
                        ),
                        (
                            name: "iojs",
                            description: Some("The latest version of io.js"),
                        ),
                        (
                            name: "system",
                            description: Some("System-installed version of node"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "ls-remote",
            description: Some("List remote versions available for install, matching a given <version> if provided"),
            options: [
                (
                    names: [
                        "--lts",
                    ],
                    description: Some("When listing, only show LTS (long-term support) versions"),
                ),
                (
                    names: [
                        "--lts",
                    ],
                    description: Some("When listing, only show versions for a specific LTS line"),
                    arguments: [
                        (
                            name: "LTS name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-colors",
                    ],
                    description: Some("Suppress colored output"),
                ),
            ],
            arguments: [
                (
                    name: "version",
                    description: Some("Node version"),
                    suggestions: [
                        (
                            name: "node",
                            description: Some("The latest version of node"),
                        ),
                        (
                            name: "iojs",
                            description: Some("The latest version of io.js"),
                        ),
                        (
                            name: "system",
                            description: Some("System-installed version of node"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "version",
            description: Some("Resolve the given description to a single local version"),
            arguments: [
                (
                    name: "version",
                    description: Some("Node version"),
                    suggestions: [
                        (
                            name: "node",
                            description: Some("The latest version of node"),
                        ),
                        (
                            name: "iojs",
                            description: Some("The latest version of io.js"),
                        ),
                        (
                            name: "system",
                            description: Some("System-installed version of node"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "version-remote",
            description: Some("Resolve the given description to a single remote version"),
            options: [
                (
                    names: [
                        "--lts",
                    ],
                    description: Some("When listing, only show LTS (long-term support) versions"),
                ),
                (
                    names: [
                        "--lts",
                    ],
                    description: Some("When listing, only show versions for a specific LTS line"),
                    arguments: [
                        (
                            name: "LTS name",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "version",
                    description: Some("Node version"),
                    suggestions: [
                        (
                            name: "node",
                            description: Some("The latest version of node"),
                        ),
                        (
                            name: "iojs",
                            description: Some("The latest version of io.js"),
                        ),
                        (
                            name: "system",
                            description: Some("System-installed version of node"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "deactivate",
            description: Some("Undo effects of `nvm` on current shell"),
            options: [
                (
                    names: [
                        "--silent",
                    ],
                    description: Some("Silences stdout/stderr output"),
                ),
            ],
        ),
        (
            name: "alias",
            description: Some("Show all aliases beginning with <pattern> or Set an alias named <name> pointing to <version>"),
            arguments: [
                (
                    name: "pattern or name",
                    description: Some("Pattern or name"),
                ),
                (
                    name: "version",
                    optional: true,
                ),
            ],
        ),
        (
            name: "unalias",
            description: Some("Deletes the alias named <name>"),
            arguments: [
                (
                    name: "name",
                ),
            ],
        ),
        (
            name: "install-latest-npm",
            description: Some("Attempt to upgrade to the latest working `npm` on the current node version"),
        ),
        (
            name: "reinstall-packages",
            description: Some("Reinstall global `npm` packages contained in <version> to current version"),
            arguments: [
                (
                    name: "version",
                    description: Some("Node version"),
                    suggestions: [
                        (
                            name: "node",
                            description: Some("The latest version of node"),
                        ),
                        (
                            name: "iojs",
                            description: Some("The latest version of io.js"),
                        ),
                        (
                            name: "system",
                            description: Some("System-installed version of node"),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "unload",
            description: Some("Unload `nvm` from shell"),
        ),
        (
            name: "which",
            description: Some("Display path to installed node version. Uses .nvmrc if available and version is omitted"),
            subcommands: [
                (
                    name: "current",
                ),
            ],
            options: [
                (
                    names: [
                        "--silent",
                    ],
                    description: Some("Silences stdout/stderr output when a version is omitted"),
                ),
            ],
            arguments: [
                (
                    name: "version",
                    description: Some("Node version"),
                    suggestions: [
                        (
                            name: "node",
                            description: Some("The latest version of node"),
                        ),
                        (
                            name: "iojs",
                            description: Some("The latest version of io.js"),
                        ),
                        (
                            name: "system",
                            description: Some("System-installed version of node"),
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "cache",
            arguments: [
                (
                    name: "",
                    suggestions: [
                        (
                            name: "dir",
                            description: Some("Display path to the cache directory for nvm"),
                            kind: Some(Subcommand),
                        ),
                        (
                            name: "clear",
                            description: Some("Empty cache directory for nvm"),
                            kind: Some(Subcommand),
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "set-colors",
            description: Some("Set five text colors using format \"yMeBg\". Available when supported"),
            arguments: [
                (
                    name: "color codes",
                    description: Some("Using format \"yMeBg\""),
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--help",
            ],
            description: Some("Show help page"),
