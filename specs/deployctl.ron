(
    version: 1,
    command: "deployctl",
    description: Some("Command line tool for Deno Deploy"),
    subcommands: [
        (
            name: "deploy",
            description: Some("Deploy a script with static files to Deno Deploy"),
            options: [
                (
                    names: [
                        "--exclude",
                    ],
                    description: Some("Exclude files that match this pattern"),
                    arguments: [
                        (
                            name: "pattern",
                        ),
                    ],
                    presentation: (
                        insert_value: Some("--exclude '{cursor}'"),
                    ),
                ),
                (
                    names: [
                        "--include",
                    ],
                    description: Some("Only upload files that match this pattern"),
                    arguments: [
                        (
                            name: "pattern",
                        ),
                    ],
                    presentation: (
                        insert_value: Some("--include '{cursor}'"),
                    ),
                ),
                (
                    names: [
                        "--no-static",
                    ],
                    description: Some("Don't include the files in the CWD as static files"),
                ),
                (
                    names: [
                        "--prod",
                    ],
                    description: Some("Create a production deployment (default is preview deployment)"),
                ),
                (
                    names: [
                        "-p",
                        "--project",
                    ],
                    description: Some("The project to deploy to"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--token",
                    ],
                    description: Some("The API token to use"),
                    arguments: [
                        (
                            name: "token",
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "entrypoint",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "upgrade",
            description: Some("Upgrade deployctl"),
            arguments: [
                (
                    name: "version",
                    generators: [
                        (
                            script: [
                                "curl",
                                "-sL",
                                "https://cdn.deno.land/deploy/meta/versions.json",
                            ],
                            has_post_process: true,
                            cache: Some((
                                ttl_ms: Some(86400000),
                                stale_while_revalidate: true,
                            )),
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help"),
            persistent: true,
        ),
        (
            names: [
                "-V",
                "--version",
            ],
            description: Some("Show the version"),
        ),
    ],
)
