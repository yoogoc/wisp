(
    version: 1,
    command: "croc",
    description: Some("Croc is a tool that allows any two computers to simply and securely transfer files and folders"),
    subcommands: [
        (
            name: "send",
            description: Some("Send file(s), or folder"),
            options: [
                (
                    names: [
                        "--code",
                        "-c",
                    ],
                    description: Some("Codephrase used to connect to relay"),
                    arguments: [
                        (
                            name: "codephrase",
                        ),
                    ],
                ),
                (
                    names: [
                        "--hash",
                    ],
                    description: Some("Hash algorithm"),
                    arguments: [
                        (
                            name: "",
                            suggestions: [
                                (
                                    name: "xxhash",
                                ),
                                (
                                    name: "imohash",
                                ),
                                (
                                    name: "md5",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--text",
                        "-t",
                    ],
                    description: Some("Send some text"),
                    arguments: [
                        (
                            name: "text",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-local",
                    ],
                    description: Some("Disable local relay when sending"),
                ),
                (
                    names: [
                        "--no-multi",
                    ],
                    description: Some("Disable multiplexing"),
                ),
                (
                    names: [
                        "--ports",
                    ],
                    description: Some("Ports of the local relay"),
                ),
            ],
            arguments: [
                (
                    name: "",
                    template: [
                        FilePaths,
                        Folders,
                    ],
                ),
            ],
        ),
        (
            name: "relay",
            description: Some("Start your own relay"),
            options: [
                (
                    names: [
                        "--host",
                    ],
                    description: Some("Host of the relay"),
                    arguments: [
                        (
                            name: "value",
                        ),
                    ],
                ),
                (
                    names: [
                        "--ports",
                    ],
                    description: Some("Ports of the local relay"),
                    arguments: [
                        (
                            name: "ports",
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "help",
            aliases: [
                "h",
            ],
            description: Some("Shows a list of commands or help for one command"),
            arguments: [
                (
                    name: "command",
                    template: [
                        Help,
                    ],
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for croc"),
            persistent: true,
        ),
        (
            names: [
                "--internal-dns",
            ],
            description: Some("Use a built-in DNS stub resolver rather than the host operating system"),
        ),
        (
            names: [
                "--remember",
            ],
            description: Some("Save these settings to reuse next time"),
        ),
        (
            names: [
                "--debug",
            ],
            description: Some("Toggle debug mode"),
        ),
        (
            names: [
                "--yes",
            ],
            description: Some("Automatically agree to all prompts"),
        ),
        (
            names: [
                "--stdout",
            ],
            description: Some("Redirect file to stdout"),
        ),
        (
            names: [
                "--no-compress",
            ],
            description: Some("Disable compression"),
        ),
        (
            names: [
                "--ask",
            ],
            description: Some("Make sure sender and recipient are prompted"),
        ),
        (
            names: [
                "--local",
            ],
            description: Some("Force to use only local connections"),
        ),
        (
            names: [
                "--ignore-stdin",
            ],
            description: Some("Ignore piped stdin"),
        ),
        (
            names: [
                "--overwrite",
            ],
            description: Some("Do not prompt to overwrite"),
        ),
        (
            names: [
                "--curve",
            ],
            description: Some("Choose an encryption curve"),
            arguments: [
                (
                    name: "value",
                    suggestions: [
                        (
                            name: "p521",
                        ),
                        (
                            name: "p256",
                        ),
                        (
                            name: "p384",
                        ),
                        (
                            name: "siec",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--ip",
            ],
            description: Some("Set sender ip if known"),
            arguments: [
                (
                    name: "value",
                ),
            ],
        ),
        (
            names: [
                "--relay",
            ],
            description: Some("Address of the relay"),
            arguments: [
                (
                    name: "ipv4 address",
                ),
            ],
        ),
        (
            names: [
                "--relay6",
            ],
            description: Some("Ipv6 address of the relay"),
            arguments: [
                (
                    name: "ipv6 address",
                ),
            ],
        ),
        (
            names: [
                "--out",
            ],
            description: Some("Specify an output folder to receive the file"),
            arguments: [
                (
                    name: "output folder",
                ),
            ],
        ),
        (
            names: [
                "--pass",
            ],
            description: Some("Password for the relay (default: \"pass123\")"),
            arguments: [
                (
                    name: "password",
                ),
            ],
        ),
        (
            names: [
                "--socks5",
            ],
            description: Some("Add a socks5 proxy"),
            arguments: [
                (
                    name: "value",
                ),
            ],
        ),
        (
            names: [
                "--throttleUpload",
            ],
            description: Some("Throttle the upload speed e.g. 500k"),
            arguments: [
                (
                    name: "value",
                ),
            ],
        ),
        (
            names: [
                "--version",
                "-v",
            ],
            description: Some("Print the version"),
        ),
    ],
    arguments: [
        (
            name: "secret-code",
            description: Some("Receive a file using code"),
        ),
    ],
)
