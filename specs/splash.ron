(
    version: 1,
    command: "splash-cli",
    description: Some("Get stunning wallpapers from Unsplash"),
    subcommands: [
        (
            name: "settings",
            description: Some("Manage settings"),
            subcommands: [
                (
                    name: "get",
                    arguments: [
                        (
                            name: "config key",
                            description: Some("Config key"),
                            optional: true,
                        ),
                    ],
                ),
                (
                    name: "set",
                    description: Some("Setup the configuration"),
                ),
                (
                    name: "restore",
                    description: Some("Restore default settings"),
                ),
            ],
            presentation: (
                icon: Some("⚙️"),
            ),
        ),
        (
            name: "aliases",
            description: Some("Manage aliases"),
            subcommands: [
                (
                    name: "get",
                    description: Some("Get an alias"),
                    arguments: [
                        (
                            name: "alias",
                        ),
                    ],
                ),
                (
                    name: "set",
                    description: Some("Set an alias"),
                    arguments: [
                        (
                            name: "key",
                        ),
                        (
                            name: "value",
                        ),
                    ],
                ),
                (
                    name: "help",
                    description: Some("Show help menu"),
                ),
            ],
            presentation: (
                icon: Some("🔗"),
            ),
        ),
        (
