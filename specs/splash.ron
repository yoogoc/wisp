                    ),
                ),
                (
                    name: "count",
                    description: Some("Count all the downloaded photos"),
                    presentation: (
                        icon: Some("📈"),
                    ),
                ),
                (
                    name: "help",
                    description: Some("Show help for this command"),
                ),
            ],
            presentation: (
                icon: Some("📁"),
            ),
        ),
        (
            name: "user",
            subcommands: [
                (
                    name: "login",
                    description: Some("Login with your Unsplash account"),
                ),
                (
                    name: "logout",
                    description: Some("Removes all user data"),
                ),
