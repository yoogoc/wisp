                        (
                            name: "collection id",
                        ),
                    ],
                ),
                (
                    name: "delete",
                    description: Some("Delete a collection"),
                    arguments: [
                        (
                            name: "collection id",
                        ),
                    ],
                ),
                (
                    name: "create",
                    description: Some("Create a collection"),
                ),
                (
                    name: "photos:add",
                    description: Some("Add photos to a collection"),
                ),
                (
                    name: "photos:remove",
                    description: Some("Remove photos to a collection"),
                ),
                (
                    name: "help",
                    description: Some("Show help for this command"),
                ),
            ],
            presentation: (
                icon: Some("🗃"),
            ),
        ),
        (
            name: "dir",
