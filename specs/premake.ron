(
    version: 1,
    command: "premake",
    description: Some("Premake CLI"),
    subcommands: [
        (
            name: "clean",
            description: Some("Remove all binaries and generated files"),
            options: [
                (
                    names: [
                        "--file",
                    ],
                    description: Some("The premake5.lua file"),
                    arguments: [
                        (
                            name: "file",
                            description: Some("Path to the premake5.lua file"),
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--debugger",
                    ],
                    description: Some("Start MobDebug remote debugger. Works with ZeroBrane Studio"),
                ),
                (
                    names: [
                        "--fatal",
                    ],
                    description: Some("Treat warnings from project scripts as errors"),
                ),
                (
                    names: [
                        "--insecure",
                    ],
                    description: Some("Forfit SSH certification checks"),
                ),
                (
                    names: [
                        "--interactive",
                    ],
                    description: Some("Interactive command prompt"),
                ),
                (
                    names: [
                        "--os",
                    ],
                    description: Some("Generate files for a different operating system"),
                    arguments: [
                        (
                            name: "os",
                            description: Some("The operating system"),
                            suggestions: [
                                (
                                    name: "aix",
                                ),
                                (
                                    name: "android",
                                ),
                                (
                                    name: "bsd",
                                ),
                                (
                                    name: "haiku",
                                ),
                                (
                                    name: "hurd",
                                ),
                                (
                                    name: "ios",
                                ),
                                (
                                    name: "linux",
                                ),
                                (
                                    name: "macosx",
                                ),
                                (
                                    name: "solaris",
                                ),
                                (
                                    name: "windows",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--scripts",
                    ],
                    description: Some("Search for additional scripts on the given path"),
                    arguments: [
                        (
                            name: "path",
                            description: Some("The path to the scripts"),
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--systemscript",
                    ],
                    description: Some("Override default system script (premake5-system.lua)"),
                    arguments: [
                        (
                            name: "script",
                            description: Some("The system script"),
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--verbose",
                    ],
                    description: Some("Generate extra debug text output"),
                ),
                (
                    names: [
                        "--cc",
                    ],
                    description: Some("Choose a C/C++ compiler set"),
                    arguments: [
                        (
                            name: "cc",
                            description: Some("The C/C++ compiler set"),
                            suggestions: [
                                (
                                    name: "clang",
                                ),
                                (
                                    name: "gcc",
                                ),
                                (
                                    name: "mingw",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--dc",
                    ],
                    description: Some("Choose a D compiler"),
                    arguments: [
                        (
                            name: "dc",
                            description: Some("The D compiler set"),
                            suggestions: [
                                (
                                    name: "dmd",
                                ),
                                (
                                    name: "gdc",
                                ),
                                (
                                    name: "ldc",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--dotnet",
                    ],
                    description: Some("Choose a .NET compiler set"),
                    arguments: [
                        (
                            name: "dotnet",
                            description: Some("The .NET compiler set"),
                            suggestions: [
                                (
                                    name: "mono",
                                ),
                                (
                                    name: "msnet",
                                ),
                                (
                                    name: "pnet",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
