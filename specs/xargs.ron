(
    version: 1,
    command: "xargs",
    description: Some("Execute a command with whitespace-delimited strings (from stdin) as arguments"),
    options: [
        (
            names: [
                "-0",
            ],
            description: Some("Use NUL (0x00) as a separator, instead of whitespace"),
        ),
        (
            names: [
                "-E",
            ],
            description: Some("Use this string as a logical EOF marker"),
            arguments: [
                (
                    name: "eof-str",
                    description: Some("The string to use that marks EOF"),
                ),
            ],
        ),
        (
            names: [
                "-I",
            ],
            description: Some("Replace occurrences of this string with the input"),
            arguments: [
                (
                    name: "replacement-str",
                    description: Some("The string to replace"),
                ),
            ],
        ),
        (
            names: [
                "-J",
            ],
            description: Some("Replace an argument exactly equal to this string with the input"),
            arguments: [
                (
                    name: "replacement-str",
                    description: Some("The string to replace"),
                ),
            ],
        ),
        (
            names: [
                "-L",
            ],
            description: Some("Run the program each time this many lines of input are read"),
            arguments: [
                (
                    name: "number",
                ),
            ],
            exclusive_on: [
                "-n",
            ],
        ),
        (
            names: [
                "-n",
            ],
            description: Some("The maximum number of arguments that can be taken from stdin on each run"),
            arguments: [
                (
                    name: "number",
                ),
            ],
            exclusive_on: [
                "-L",
            ],
        ),
        (
            names: [
                "-o",
            ],
            description: Some("Reopen stdin as /dev/tty (useful for running interactive applications)"),
        ),
        (
            names: [
                "-P",
            ],
            description: Some("Run up to this many commands in parallel (as many as possible if 0)"),
            arguments: [
                (
                    name: "max-procs",
                ),
            ],
        ),
        (
            names: [
                "-p",
            ],
            description: Some("Prompt to run each command"),
        ),
        (
            names: [
                "-r",
            ],
            description: Some("Run the command once if there's no input (compatible with GNU xargs)"),
        ),
        (
            names: [
                "-R",
            ],
            description: Some("Specify the maximum number of occurrences that -I will replace"),
            arguments: [
                (
                    name: "number",
                ),
            ],
            depends_on: [
                "-I",
            ],
        ),
        (
            names: [
                "-S",
            ],
            description: Some("Specify the maximum size in bytes that -I can use for replacements (default: 255)"),
            arguments: [
                (
                    name: "replacement-size",
                ),
            ],
            depends_on: [
                "-I",
            ],
        ),
        (
            names: [
                "-s",
            ],
            description: Some("Maximum number of bytes that can be provided to the program (default: 4096)"),
            arguments: [
                (
                    name: "max-args-size",
                ),
            ],
        ),
        (
            names: [
                "-t",
            ],
            description: Some("Echo the command to stderr before it's executed"),
        ),
        (
            names: [
                "-x",
            ],
            description: Some("Terminal if the arguments will not fit in the maximum line length"),
            depends_on: [
                "-n",
            ],
        ),
    ],
    arguments: [
        (
            name: "utility",
            description: Some("Run this program for each line of stdin (default: echo)"),
            optional: true,
            is_command: true,
        ),
    ],
)
