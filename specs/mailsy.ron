(
    version: 1,
    command: "mailsy",
    description: Some("⚡️ Quickly generate a disposable email straight from terminal"),
    subcommands: [
        (
            name: "g",
            description: Some("Generate a new email"),
        ),
        (
            name: "m",
            description: Some("Fetch messages from the inbox"),
        ),
        (
            name: "d",
            description: Some("Delete account"),
        ),
        (
            name: "me",
            description: Some("Show details of the account"),
        ),
        (
            name: "help",
            description: Some("Get help for a command"),
            arguments: [
                (
                    name: "command",
                    template: [
                        Help,
                    ],
                    optional: true,
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Output the current version"),
        ),
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Display help for command"),
            persistent: true,
            presentation: (
                priority: Some(49.0),
            ),
        ),
    ],
)
