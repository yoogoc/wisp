        (
            names: [
                "-C",
            ],
            description: Some("Complement the set of characters in string1, that is '-C ab' includes every character except for 'a' and 'b'"),
        ),
        (
            names: [
                "-c",
            ],
            description: Some("Same as '-C' but complement the set of values in string1"),
        ),
        (
            names: [
                "-d",
            ],
            description: Some("Delete characters in string1 from the input"),
        ),
        (
            names: [
                "-s",
            ],
