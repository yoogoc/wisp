(
    version: 1,
    command: "cut",
    description: Some("Cut out selected portions of each line of a file"),
    options: [
        (
            names: [
                "-b",
            ],
            description: Some("Byte positions as a comma or - separated list of numbers"),
            arguments: [
                (
                    name: "list",
                    description: Some("Specifies byte positions"),
                ),
            ],
        ),
        (
            names: [
                "-c",
            ],
            description: Some("Column positions as a comma or - separated list of numbers"),
            arguments: [
                (
                    name: "list",
                    description: Some("Specifies column positions"),
                ),
            ],
        ),
        (
            names: [
                "-f",
            ],
            description: Some("Field positions as a comma or - separated list of numbers"),
            arguments: [
                (
                    name: "list",
                    description: Some("Specifies column positions"),
                ),
            ],
        ),
        (
            names: [
                "-n",
            ],
            description: Some("Do not split multi-byte characters"),
        ),
        (
            names: [
                "-d",
            ],
            description: Some("Use delim as the field delimiter character instead of the tab character"),
            arguments: [
                (
                    name: "delim",
                    description: Some("Field deliminator to use instead of the tab character"),
                    optional: true,
                ),
            ],
        ),
        (
            names: [
                "-s",
            ],
            description: Some("Suppress lines with no field delimiter characters.  unless specified, lines with no delimiters are passed through unmodified"),
        ),
        (
            names: [
                "-w",
            ],
            description: Some("Use whitespace (spaces and tabs) as the delimiter.  Consecutive spaces and tabs count as one single field separator"),
        ),
    ],
    arguments: [
        (
            name: "",
            template: [
                FilePaths,
            ],
            optional: true,
            variadic: true,
        ),
    ],
)
