(
    version: 1,
    command: "dog",
    description: Some("A command-line DNS client"),
    subcommands: [
        (
            name: "A",
            description: Some("Query Domain A Record"),
            options: [
                (
                    names: [
                        "-q",
                        "--query",
                    ],
                    description: Some("Host name or IP address to query"),
                    arguments: [
                        (
                            name: "HOST",
                        ),
                    ],
                ),
                (
                    names: [
                        "-t",
                        "--type",
                    ],
                    description: Some("Type of the DNS record being queried (A, MX, NS...)"),
                    arguments: [
                        (
                            name: "TYPE",
                        ),
                    ],
                ),
                (
                    names: [
                        "-n",
                        "--nameserver",
                    ],
                    description: Some("Address of the nameserver to send packets to"),
                    arguments: [
                        (
                            name: "ADDR",
                        ),
                    ],
                ),
                (
                    names: [
                        "-class",
                    ],
                    description: Some("Network class of the DNS record being queried (IN, CH, HS)"),
                    arguments: [
                        (
                            name: "CLASS",
                        ),
                    ],
                ),
                (
                    names: [
                        "--edns",
                    ],
                    description: Some("Whether to OPT in to EDNS (disable, hide, show)"),
                    arguments: [
                        (
                            name: "NUMBER",
                        ),
                    ],
                ),
                (
                    names: [
                        "--txid",
                    ],
                    description: Some("Set the transaction ID to a specific value"),
                    arguments: [
                        (
                            name: "CLASS",
                        ),
                    ],
                ),
                (
                    names: [
                        "-Z",
                    ],
                    description: Some("Set uncommon protocol-level tweaks"),
                    arguments: [
                        (
                            name: "TWEAKS",
                        ),
                    ],
                ),
                (
                    names: [
                        "-U",
                        "--udp",
                    ],
                    description: Some("Use the DNS protocol over UDP"),
                ),
                (
                    names: [
                        "-T",
                        "--tcp",
                    ],
                    description: Some("Use the DNS protocol over TCP"),
                ),
                (
                    names: [
                        "-S",
                        "--tls",
                    ],
                    description: Some("Use the DNS-over-TLS protocol"),
                ),
                (
                    names: [
                        "-H",
                        "--https",
                    ],
                    description: Some("Use the DNS-over-HTTPS protocol"),
                ),
                (
                    names: [
                        "-1",
                        "--short",
                    ],
                    description: Some("Short mode: display nothing but the first result"),
                ),
                (
                    names: [
                        "-J",
                        "--json",
                    ],
                    description: Some("Display the output as JSON"),
                ),
                (
                    names: [
                        "--color",
                    ],
                    description: Some("When to colourise the output (always, automatic, never)"),
                    arguments: [
                        (
                            name: "arguments",
                            description: Some("Human-readable host names, nameservers, types, or classes"),
                        ),
                        (
                            name: "WHEN",
                        ),
                    ],
                ),
                (
                    names: [
                        "--seconds",
                    ],
                    description: Some("Do not format durations, display them as seconds"),
                ),
                (
                    names: [
                        "--time",
                    ],
                    description: Some("Print how long the response took to arrive"),
                ),
            ],
            arguments: [
                (
                    name: "arguments",
                    description: Some("Human-readable host names, nameservers, types, or classes"),
                ),
            ],
        ),
