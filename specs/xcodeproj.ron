(
    version: 1,
    command: "xcodeproj",
    description: Some("Xcodeproj lets you create and modify Xcode projects"),
    subcommands: [
        (
            name: "config-dump",
            description: Some("Dumps the build settings of all project targets for all configurations in directories named by the target in the given output directory"),
            arguments: [
                (
                    name: "PROJECT",
                    generators: [
                        (
                            template: [
                                Folders,
                            ],
                            has_filter_template_suggestions: true,
                        ),
                    ],
                    optional: true,
                ),
                (
                    name: "OUTPUT",
                    template: [
                        Folders,
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "project-diff",
            description: Some("Shows the difference between two projects"),
            options: [
                (
                    names: [
                        "--ignore",
                    ],
                    description: Some("A key to ignore in the comparison. Can be specified multiple times"),
                    arguments: [
                        (
                            name: "KEY",
                        ),
                    ],
                    repeat: Many,
                    requires_separator: Some("="),
                ),
            ],
            arguments: [
                (
                    name: "PROJECT1",
                    generators: [
                        (
                            template: [
                                Folders,
                            ],
                            has_filter_template_suggestions: true,
                        ),
                    ],
                ),
                (
                    name: "PROJECT2",
                    generators: [
                        (
                            template: [
                                Folders,
                            ],
                            has_filter_template_suggestions: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "show",
            description: Some("Shows an overview of a project in a YAML representation"),
            options: [
                (
                    names: [
                        "--format",
                    ],
                    description: Some("YAML output format"),
                    arguments: [
                        (
                            name: "FORMAT",
                            suggestions: [
                                (
                                    name: "hash",
                                ),
                                (
                                    name: "tree_hash",
                                ),
                                (
                                    name: "raw",
                                ),
                            ],
                        ),
                    ],
                    requires_separator: Some("="),
                ),
            ],
            arguments: [
                (
                    name: "PROJECT",
                    generators: [
                        (
                            template: [
                                Folders,
                            ],
                            has_filter_template_suggestions: true,
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "sort",
            description: Some("Sorts the given project"),
            options: [
                (
                    names: [
                        "--group-option",
                    ],
                    description: Some("The position of the groups when sorting. If no option is specified sorting will interleave groups and files"),
                    arguments: [
                        (
                            name: "POSITION",
                            suggestions: [
                                (
                                    name: "above",
                                ),
                                (
                                    name: "below",
                                ),
                            ],
                        ),
                    ],
                    requires_separator: Some("="),
                ),
            ],
            arguments: [
                (
                    name: "PROJECT",
                    generators: [
                        (
                            template: [
                                Folders,
                            ],
                            has_filter_template_suggestions: true,
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "target-diff",
            description: Some("Shows the difference between two targets"),
            options: [
                (
                    names: [
                        "--project",
                    ],
                    description: Some("The Xcode project document to use"),
                    arguments: [
                        (
                            name: "PATH",
                            generators: [
                                (
                                    template: [
                                        Folders,
                                    ],
                                    has_filter_template_suggestions: true,
                                ),
                            ],
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "TARGET1",
                ),
                (
                    name: "TARGET2",
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--verbose",
            ],
            description: Some("Show more debugging information"),
            persistent: true,
            presentation: (
                icon: Some("🔊"),
            ),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Show the version of the tool"),
        ),
        (
            names: [
                "--no-ansi",
            ],
            description: Some("Show output without ANSI codes"),
            persistent: true,
        ),
        (
            names: [
                "--help",
            ],
            description: Some("Show help banner of specified command"),
            persistent: true,
        ),
    ],
)
