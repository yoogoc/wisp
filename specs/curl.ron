(
    version: 1,
    command: "curl",
    description: Some("Transfer a URL"),
    options: [
        (
            names: [
                "-a",
                "--append",
            ],
            description: Some("Append to target file when uploading"),
        ),
        (
            names: [
                "-E",
                "--cert",
            ],
            description: Some("Client certificate file and password"),
            arguments: [
                (
                    name: "certificate[:password]",
                    generators: [
                        (
                            query_term: Some(AfterLast(":")),
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-K",
                "--config",
            ],
            description: Some("Read config from a file"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-C",
                "--continue-at",
            ],
            description: Some("Resumed transfer offset"),
            arguments: [
                (
                    name: "offset",
                ),
            ],
        ),
        (
            names: [
                "-b",
                "--cookie",
            ],
            description: Some("Send cookies from string/file"),
            arguments: [
                (
                    name: "data or filename",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-c",
                "--cookie-jar",
            ],
            description: Some("Write cookies to <filename> after operation"),
            arguments: [
                (
                    name: "filename",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-d",
                "--data",
            ],
            description: Some("HTTP POST data"),
            arguments: [
                (
                    name: "data",
                ),
            ],
            repeat: Many,
            presentation: (
                insert_value: Some("-d '{cursor}'"),
            ),
        ),
        (
            names: [
                "-q",
                "--disable",
            ],
            description: Some("Disable .curlrc"),
        ),
        (
            names: [
                "-D",
                "--dump-header",
            ],
            description: Some("Write the received headers to <filename>"),
            arguments: [
                (
                    name: "filename",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-f",
                "--fail",
            ],
            description: Some("Fail silently (no output at all) on HTTP errors"),
        ),
        (
            names: [
                "-F",
                "--form",
            ],
            description: Some("Specify multipart MIME data"),
            arguments: [
                (
                    name: "content",
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "-P",
                "--ftp-port",
            ],
            description: Some("Use PORT instead of PASV"),
            arguments: [
                (
                    name: "address",
                ),
            ],
        ),
        (
            names: [
                "-G",
                "--get",
            ],
            description: Some("Put the post data in the URL and use GET"),
        ),
        (
            names: [
                "-g",
                "--globoff",
            ],
            description: Some("Disable URL sequences and ranges using {} and []"),
        ),
        (
            names: [
                "-I",
                "--head",
            ],
            description: Some("Show document info only"),
        ),
        (
            names: [
                "-H",
                "--header",
            ],
            description: Some("Pass custom header(s) to server"),
            arguments: [
                (
                    name: "header/file",
                    suggestions: [
                        (
                            name: "Content-Type: application/json",
                        ),
                        (
                            name: "Content-Type: application/x-www-form-urlencoded",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("This help text"),
        ),
        (
            names: [
                "-0",
                "--http1.0",
            ],
            description: Some("Use HTTP 1.0"),
        ),
        (
            names: [
                "-i",
                "--include",
            ],
            description: Some("Include protocol response headers in the output"),
        ),
        (
            names: [
                "-k",
                "--insecure",
            ],
            description: Some("Allow insecure server connections when using SSL"),
        ),
        (
            names: [
                "-4",
                "--ipv4",
            ],
            description: Some("Resolve names to IPv4 addresses"),
        ),
        (
            names: [
                "-6",
                "--ipv6",
            ],
            description: Some("Resolve names to IPv6 addresses"),
        ),
        (
            names: [
                "-j",
                "--junk-session-cookies",
            ],
            description: Some("Ignore session cookies read from file"),
        ),
        (
            names: [
                "-l",
                "--list-only",
            ],
            description: Some("List only mode"),
        ),
        (
            names: [
                "-L",
                "--location",
            ],
            description: Some("Follow redirects"),
        ),
        (
            names: [
                "-M",
                "--manual",
            ],
            description: Some("Display the full manual"),
        ),
        (
            names: [
                "-m",
                "--max-time",
            ],
            description: Some("Maximum time allowed for the transfer"),
            arguments: [
                (
                    name: "seconds",
                ),
            ],
        ),
        (
            names: [
                "-n",
                "--netrc",
            ],
            description: Some("Must read .netrc for user name and password"),
        ),
        (
            names: [
                "-:",
                "--next",
            ],
            description: Some("Make next URL use its separate set of options"),
        ),
        (
            names: [
                "-N",
                "--no-buffer",
            ],
            description: Some("Disable buffering of the output stream"),
        ),
        (
            names: [
                "-o",
                "--output",
            ],
            description: Some("Write to file instead of stdout"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-#",
                "--progress-bar",
            ],
            description: Some("Display transfer progress as a bar"),
        ),
        (
            names: [
                "-x",
                "--proxy",
            ],
            description: Some("[protocol://]host[:port] Use this proxy"),
        ),
        (
            names: [
                "-U",
                "--proxy-user",
            ],
            description: Some("Proxy user and password"),
            arguments: [
                (
                    name: "user:password",
                ),
            ],
        ),
        (
            names: [
                "-p",
                "--proxytunnel",
            ],
            description: Some("Operate through an HTTP proxy tunnel (using CONNECT)"),
        ),
        (
            names: [
                "-Q",
                "--quote",
            ],
            description: Some("Send command(s) to server before transfer"),
        ),
        (
            names: [
                "-r",
                "--range",
            ],
            description: Some("Retrieve only the bytes within RANGE"),
            arguments: [
                (
                    name: "range",
                ),
            ],
        ),
        (
            names: [
                "-e",
                "--referer",
            ],
            description: Some("Referrer URL"),
            arguments: [
                (
                    name: "URL",
                ),
            ],
        ),
        (
            names: [
                "-J",
                "--remote-header-name",
            ],
            description: Some("Use the header-provided filename"),
        ),
        (
            names: [
                "-O",
                "--remote-name",
            ],
            description: Some("Write output to a file named as the remote file"),
        ),
        (
            names: [
                "-R",
                "--remote-time",
            ],
            description: Some("Set the remote file's time on the local output"),
        ),
        (
            names: [
                "-X",
                "--request",
            ],
            description: Some("Specify request command to use"),
            arguments: [
                (
                    name: "command",
                    suggestions: [
                        (
                            name: "GET",
                        ),
                        (
                            name: "HEAD",
                        ),
                        (
                            name: "POST",
                        ),
                        (
                            name: "PUT",
                        ),
                        (
                            name: "DELETE",
                        ),
                        (
                            name: "CONNECT",
                        ),
                        (
                            name: "OPTIONS",
                        ),
                        (
                            name: "TRACE",
                        ),
                        (
                            name: "PATCH",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-S",
                "--show-error",
            ],
            description: Some("Show error even when -s is used"),
        ),
        (
            names: [
                "-s",
                "--silent",
            ],
            description: Some("Silent mode"),
        ),
        (
            names: [
                "-Y",
                "--speed-limit",
            ],
            description: Some("Stop transfers slower than this"),
            arguments: [
                (
                    name: "speed",
                ),
            ],
        ),
        (
            names: [
                "-y",
                "--speed-time",
            ],
            description: Some("Trigger 'speed-limit' abort after this time"),
            arguments: [
                (
                    name: "seconds",
                ),
            ],
        ),
        (
            names: [
                "-2",
                "--sslv2",
            ],
            description: Some("Use SSLv2"),
        ),
        (
            names: [
                "-3",
                "--sslv3",
            ],
            description: Some("Use SSLv3"),
        ),
        (
            names: [
                "-t",
                "--telnet-option",
            ],
            description: Some("Set telnet option"),
            arguments: [
                (
                    name: "val",
                ),
            ],
        ),
        (
            names: [
                "-z",
                "--time-cond",
            ],
            description: Some("Transfer based on a time condition"),
            arguments: [
                (
                    name: "time",
                ),
            ],
        ),
        (
            names: [
                "-1",
                "--tlsv1",
            ],
            description: Some("Use TLSv1.0 or greater"),
        ),
        (
            names: [
                "-T",
                "--upload-file",
            ],
            description: Some("Transfer local FILE to destination"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "-B",
                "--use-ascii",
            ],
            description: Some("Use ASCII/text transfer"),
        ),
        (
            names: [
                "-u",
                "--user",
            ],
            description: Some("Server user and password"),
            arguments: [
                (
                    name: "user:password",
                ),
            ],
        ),
        (
            names: [
                "-A",
                "--user-agent",
            ],
            description: Some("Send User-Agent <name> to server"),
            arguments: [
                (
                    name: "name",
                ),
            ],
        ),
        (
            names: [
                "-v",
                "--verbose",
            ],
            description: Some("Make the operation more talkative"),
        ),
        (
            names: [
                "-V",
                "--version",
            ],
            description: Some("Show version number and quit"),
        ),
        (
            names: [
                "-w",
                "--write-out",
            ],
            description: Some("Use output FORMAT after completion"),
            arguments: [
                (
                    name: "format",
                ),
            ],
        ),
        (
            names: [
                "--abstract-unix-socket",
            ],
            description: Some("Connect via abstract Unix domain socket"),
            arguments: [
                (
                    name: "path",
                ),
            ],
        ),
        (
            names: [
                "--alt-svc",
            ],
            description: Some("Name> Enable alt-svc with this cache file"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--anyauth",
            ],
            description: Some("Pick any authentication method"),
        ),
        (
            names: [
                "--basic",
            ],
            description: Some("Use HTTP Basic Authentication"),
        ),
        (
            names: [
                "--cacert",
            ],
            description: Some("CA certificate to verify peer against"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--capath",
            ],
            description: Some("CA directory to verify peer against"),
            arguments: [
                (
                    name: "dir",
                    template: [
                        Folders,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--cert-status",
            ],
            description: Some("Verify the status of the server certificate"),
        ),
        (
            names: [
                "--cert-type",
            ],
            description: Some("Certificate file type"),
            arguments: [
                (
                    name: "type",
                    suggestions: [
                        (
                            name: "DER",
                        ),
                        (
                            name: "PEM",
                        ),
                        (
                            name: "ENG",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--ciphers",
            ],
            description: Some("Of ciphers> SSL ciphers to use"),
            arguments: [
                (
                    name: "list",
                ),
            ],
        ),
        (
            names: [
                "--compressed",
            ],
            description: Some("Request compressed response"),
        ),
        (
            names: [
                "--compressed-ssh",
            ],
            description: Some("Enable SSH compression"),
        ),
        (
            names: [
                "--connect-timeout",
            ],
            description: Some("Maximum time allowed for connection"),
            arguments: [
                (
                    name: "seconds",
                ),
            ],
        ),
        (
            names: [
                "--connect-to",
            ],
            description: Some("Connect to host"),
            arguments: [
                (
                    name: "HOST1:PORT1:HOST2:PORT2",
                ),
            ],
        ),
        (
            names: [
                "--create-dirs",
            ],
            description: Some("Create necessary local directory hierarchy"),
        ),
        (
            names: [
                "--crlf",
            ],
            description: Some("Convert LF to CRLF in upload"),
        ),
        (
            names: [
                "--crlfile",
            ],
            description: Some("Get a CRL list in PEM format from the given file"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--data-ascii",
            ],
            description: Some("HTTP POST ASCII data"),
            arguments: [
                (
                    name: "data",
                ),
            ],
        ),
        (
            names: [
                "--data-binary",
            ],
            description: Some("HTTP POST binary data"),
            arguments: [
                (
                    name: "data",
                ),
            ],
        ),
        (
            names: [
                "--data-raw",
            ],
            description: Some("HTTP POST data, '@' allowed"),
            arguments: [
                (
                    name: "data",
                ),
            ],
        ),
        (
            names: [
                "--data-urlencode",
            ],
            description: Some("HTTP POST data url encoded"),
            arguments: [
                (
                    name: "data",
                ),
            ],
        ),
        (
            names: [
                "--delegation",
            ],
            description: Some("GSS-API delegation permission"),
            arguments: [
                (
                    name: "LEVEL",
                ),
            ],
        ),
        (
            names: [
                "--digest",
            ],
            description: Some("Use HTTP Digest Authentication"),
        ),
        (
            names: [
                "--disable-eprt",
            ],
            description: Some("Inhibit using EPRT or LPRT"),
        ),
        (
            names: [
                "--disable-epsv",
            ],
            description: Some("Inhibit using EPSV"),
        ),
        (
            names: [
                "--disallow-username-in-url",
            ],
            description: Some("Disallow username in url"),
        ),
        (
            names: [
                "--dns-interface",
            ],
            description: Some("Interface to use for DNS requests"),
            arguments: [
                (
                    name: "interface",
                ),
            ],
        ),
        (
            names: [
                "--dns-ipv4-addr",
            ],
            description: Some("IPv4 address to use for DNS requests"),
            arguments: [
                (
                    name: "address",
                ),
            ],
        ),
        (
            names: [
                "--dns-ipv6-addr",
            ],
            description: Some("IPv6 address to use for DNS requests"),
            arguments: [
                (
                    name: "address",
                ),
            ],
        ),
        (
            names: [
                "--dns-servers",
            ],
            description: Some("DNS server addrs to use"),
            arguments: [
                (
                    name: "addresses",
                ),
            ],
        ),
        (
            names: [
                "--doh-url",
            ],
            description: Some("Resolve host names over DOH"),
            arguments: [
                (
                    name: "URL",
                ),
            ],
        ),
        (
            names: [
                "--egd-file",
            ],
            description: Some("EGD socket path for random data"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--engine",
            ],
            description: Some("Crypto engine to use"),
            arguments: [
                (
                    name: "name",
                ),
            ],
        ),
        (
            names: [
                "--etag-compare",
            ],
            description: Some("Make a conditional HTTP request for the ETag read from the given file"),
            arguments: [
                (
                    name: "file",
                ),
            ],
        ),
        (
            names: [
                "--etag-save",
            ],
            description: Some("Save an HTTP ETag to the specified file"),
            arguments: [
                (
                    name: "file",
                ),
            ],
        ),
        (
            names: [
                "--expect100-timeout",
            ],
            description: Some("How long to wait for 100-continue"),
            arguments: [
                (
                    name: "seconds",
                ),
            ],
        ),
        (
            names: [
                "--fail-early",
            ],
            description: Some("Fail on first transfer error, do not continue"),
        ),
        (
            names: [
                "--fail-with-body",
            ],
            description: Some("On HTTP errors, return an error and also output any HTML response"),
        ),
        (
            names: [
                "--false-start",
            ],
            description: Some("Enable TLS False Start"),
        ),
        (
            names: [
                "--form-string",
            ],
            description: Some("Specify multipart MIME data"),
            arguments: [
                (
                    name: "string",
                ),
            ],
        ),
        (
            names: [
                "--ftp-account",
            ],
            description: Some("Account data string"),
            arguments: [
                (
                    name: "data",
                ),
            ],
        ),
        (
            names: [
                "--ftp-alternative-to-user",
            ],
            description: Some("String to replace USER [name]"),
            arguments: [
                (
                    name: "command",
                ),
            ],
        ),
        (
            names: [
                "--ftp-create-dirs",
            ],
            description: Some("Create the remote dirs if not present"),
        ),
        (
            names: [
                "--ftp-method",
            ],
            description: Some("Control CWD usage"),
            arguments: [
                (
                    name: "method",
                ),
            ],
        ),
        (
            names: [
                "--ftp-pasv",
            ],
            description: Some("Use PASV/EPSV instead of PORT"),
        ),
        (
            names: [
                "--ftp-pret",
            ],
            description: Some("Send PRET before PASV"),
        ),
        (
            names: [
                "--ftp-skip-pasv-ip",
            ],
            description: Some("Skip the IP address for PASV"),
        ),
        (
            names: [
                "--ftp-ssl-ccc",
            ],
            description: Some("Send CCC after authenticating"),
        ),
        (
            names: [
                "--ftp-ssl-ccc-mode",
            ],
            description: Some("Set CCC mode"),
            arguments: [
                (
                    name: "mode",
                    suggestions: [
                        (
                            name: "active",
                        ),
                        (
                            name: "passive",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--ftp-ssl-control",
            ],
            description: Some("Require SSL/TLS for FTP login, clear for transfer"),
        ),
        (
            names: [
                "--happy-eyeballs-timeout-ms",
            ],
            description: Some("How long to wait in milliseconds for IPv6 before trying IPv4"),
            arguments: [
                (
                    name: "milliseconds",
                ),
            ],
        ),
        (
            names: [
                "--haproxy-protocol",
            ],
            description: Some("Send HAProxy PROXY protocol v1 header"),
        ),
        (
            names: [
                "--hostpubmd5",
            ],
            description: Some("Acceptable MD5 hash of the host public key"),
            arguments: [
                (
                    name: "md5",
                ),
            ],
        ),
        (
            names: [
                "--http0.9",
            ],
            description: Some("Allow HTTP 0.9 responses"),
        ),
        (
            names: [
                "--http1.1",
            ],
            description: Some("Use HTTP 1.1"),
        ),
        (
            names: [
                "--http2",
            ],
            description: Some("Use HTTP 2"),
        ),
        (
            names: [
                "--http2-prior-knowledge",
            ],
            description: Some("Use HTTP 2 without HTTP/1.1 Upgrade"),
        ),
        (
            names: [
                "--ignore-content-length",
            ],
            description: Some("Ignore the size of the remote resource"),
        ),
        (
            names: [
                "--interface",
            ],
            description: Some("Use network INTERFACE (or address)"),
            arguments: [
                (
                    name: "name",
                ),
            ],
        ),
        (
            names: [
                "--keepalive-time",
            ],
            description: Some("Interval time for keepalive probes"),
            arguments: [
                (
                    name: "seconds",
                ),
            ],
        ),
        (
            names: [
                "--key",
            ],
            description: Some("Private key file name"),
            arguments: [
                (
                    name: "key",
                ),
            ],
        ),
        (
            names: [
                "--key-type",
            ],
            description: Some("Private key file type"),
            arguments: [
                (
                    name: "type",
                    suggestions: [
                        (
                            name: "DER",
                        ),
                        (
                            name: "PEM",
                        ),
                        (
                            name: "ENG",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
