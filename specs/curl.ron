        ),
        (
            names: [
                "--mail-rcpt",
            ],
            description: Some("Mail to this address"),
            arguments: [
                (
                    name: "address",
                ),
            ],
        ),
        (
            names: [
                "--max-filesize",
            ],
            description: Some("Maximum file size to download"),
            arguments: [
                (
                    name: "bytes",
                ),
            ],
        ),
        (
            names: [
                "--max-redirs",
            ],
            description: Some("Maximum number of redirects allowed"),
            arguments: [
                (
                    name: "num",
                ),
            ],
        ),
