            ],
            description: Some("Enable Kerberos with security <level>"),
            arguments: [
                (
                    name: "level",
                ),
            ],
        ),
        (
            names: [
                "--libcurl",
            ],
            description: Some("Dump libcurl equivalent code of this command line"),
            arguments: [
                (
                    name: "file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--limit-rate",
            ],
            description: Some("Limit transfer speed to RATE"),
            arguments: [
                (
                    name: "speed",
                ),
            ],
        ),
        (
            names: [
                "--local-port",
            ],
            description: Some("Force use of RANGE for local port numbers"),
            arguments: [
                (
                    name: "num/range",
                ),
            ],
        ),
        (
            names: [
                "--location-trusted",
            ],
            description: Some("Like --location, and send auth to other hosts"),
        ),
        (
            names: [
                "--login-options",
            ],
            description: Some("Server login options"),
            arguments: [
                (
                    name: "options",
                ),
            ],
        ),
        (
            names: [
                "--mail-auth",
