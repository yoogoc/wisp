(
    version: 1,
    command: "vapor",
    description: Some("Vapor Toolbox (Server-side Swift web framework)"),
    subcommands: [
        (
            name: "build",
            description: Some("Builds an app in the console"),
        ),
        (
            name: "new",
            description: Some("Generates a new app"),
            options: [
                (
                    names: [
                        "--template",
                        "-T",
                    ],
                    description: Some("The URL of a Git repository to use as a template"),
                ),
                (
                    names: [
                        "--branch",
                    ],
                    description: Some("Template repository branch to use"),
                ),
                (
                    names: [
                        "--output",
                        "-o",
                    ],
                    description: Some("The directory to place the new project in"),
                ),
                (
                    names: [
                        "--no-commit",
                    ],
                    description: Some("Skips adding a first commit to the newly created repo"),
                ),
            ],
            arguments: [
                (
                    name: "name",
                    description: Some("Name of project and folder"),
                ),
            ],
        ),
        (
            name: "clean",
            description: Some("Cleans temporary files"),
            options: [
                (
                    names: [
                        "--update",
                        "-u",
                    ],
                    description: Some("Delete Package.resolved file if it exists"),
                ),
                (
                    names: [
                        "--global",
                        "-g",
                    ],
                    description: Some("Clean Xcode's global DerivedData cache"),
                ),
                (
                    names: [
                        "--swiftpm",
                        "-s",
                    ],
                    description: Some("Delete .swiftpm folder"),
                ),
            ],
        ),
        (
            name: "heroku",
            description: Some("Commands for working with Heroku"),
            subcommands: [
                (
                    name: "init",
                    description: Some("Configures app for deployment to Heroku"),
                ),
                (
                    name: "push",
                    description: Some("Deploys app to Heroku"),
                ),
            ],
        ),
        (
            name: "run",
            description: Some("Runs an app from the console. Equivalent to `swift run --enable-test-discovery Run`"),
        ),
        (
            name: "supervisor",
            description: Some("Commands for working with Supervisord"),
            subcommands: [
                (
                    name: "init",
                    description: Some("Creates a Supervisor entry for the current project"),
                ),
                (
                    name: "restart",
                    description: Some("Restarts current project in Supervisor"),
                ),
                (
                    name: "update",
                    description: Some("Updates Supervisor entry for current project"),
                ),
            ],
        ),
        (
            name: "xcode",
            description: Some("Opens an app in Xcode"),
        ),
    ],
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for vapor"),
            arguments: [
                (
                    name: "command",
                    description: Some("Display usage information about the specified command"),
                    suggestions: [
                        (
                            name: "clean",
                        ),
                        (
                            name: "heroku",
                        ),
                        (
                            name: "new",
                        ),
                        (
                            name: "run",
                        ),
                        (
                            name: "supervisor",
                        ),
                        (
                            name: "xcode",
                        ),
                        (
                            name: "build",
                        ),
                    ],
                ),
            ],
        ),
    ],
)
