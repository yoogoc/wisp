(
    version: 1,
    command: "elm",
    description: Some("Fig spec for the Elm language cli"),
    subcommands: [
        (
            name: "init",
            description: Some("Initialize a new Elm project"),
            options: [
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show help for elm init"),
                ),
            ],
            presentation: (
                icon: Some("https://upload.wikimedia.org/wikipedia/commons/thumb/f/f3/Elm_logo.svg/1200px-Elm_logo.svg.png"),
            ),
        ),
        (
            name: "repl",
            description: Some("Start an Elm repl"),
            options: [
                (
                    names: [
                        "--no-colors",
                    ],
                    description: Some("Turn off colors in the repl"),
                ),
                (
                    names: [
                        "--interpreter",
                    ],
                    description: Some("Path to an alternate JS interpreter, such as Node or Deno"),
                    arguments: [
                        (
                            name: "interpreter",
                        ),
                    ],
                ),
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show help for elm repl"),
                ),
            ],
            presentation: (
                icon: Some("https://upload.wikimedia.org/wikipedia/commons/thumb/f/f3/Elm_logo.svg/1200px-Elm_logo.svg.png"),
            ),
        ),
        (
            name: "reactor",
            description: Some("Start an Elm development server"),
            options: [
                (
                    names: [
                        "--port",
                    ],
                    description: Some("The port to access the development server on"),
                    arguments: [
                        (
                            name: "port",
                            description: Some("The port number"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show help for elm reactor"),
                ),
            ],
        ),
        (
            name: "install",
            description: Some("Install an Elm dependency"),
            options: [
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show help for elm install"),
                ),
            ],
            arguments: [
                (
                    name: "package",
                    description: Some("The name of the package to install"),
                    generators: [
                        (
                            script: [
                                "curl",
                                "-sH",
                                "accept-encoding: gzip",
                                "--compressed",
                                "https://package.elm-lang.org/search.json",
                            ],
                            has_post_process: true,
                            cache: Some((
                                ttl_ms: Some(259200000),
                                stale_while_revalidate: true,
                            )),
                        ),
                    ],
                    debounce: true,
                ),
            ],
            presentation: (
                icon: Some("https://upload.wikimedia.org/wikipedia/commons/thumb/f/f3/Elm_logo.svg/1200px-Elm_logo.svg.png"),
            ),
        ),
        (
            name: "make",
            description: Some("Build your Elm code"),
            options: [
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show help for elm make"),
                ),
                (
                    names: [
                        "--debug",
                    ],
                    description: Some("Compile in debug mode"),
                ),
                (
                    names: [
                        "--optimize",
                    ],
                    description: Some("Compile in production mode"),
                ),
                (
                    names: [
                        "--output",
                    ],
                    description: Some("Where to output the compiled code"),
                    arguments: [
                        (
                            name: "output file",
                            description: Some("Name and location of output"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--docs",
                    ],
                    description: Some("Generate a JSON file of documentation"),
                    arguments: [
                        (
                            name: "output json",
                            description: Some("Name and location of output"),
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "source files",
                    description: Some("The source files to compile"),
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "bump",
            description: Some("Bump the version of your package"),
            options: [
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show help for elm bump"),
                ),
            ],
        ),
        (
            name: "diff",
            description: Some("See what changed between versions of a package"),
            options: [
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show help for elm diff"),
                ),
            ],
            arguments: [
                (
                    name: "package",
                    optional: true,
                ),
                (
                    name: "version",
                    optional: true,
                    variadic: true,
                ),
            ],
        ),
        (
            name: "publish",
            description: Some("Publish your package"),
            options: [
                (
                    names: [
                        "--help",
                    ],
                    description: Some("Show help for elm publish"),
                ),
            ],
            presentation: (
                icon: Some("https://upload.wikimedia.org/wikipedia/commons/thumb/f/f3/Elm_logo.svg/1200px-Elm_logo.svg.png"),
            ),
        ),
    ],
    options: [
        (
            names: [
                "--help",
            ],
            description: Some("Show help for elm"),
        ),
    ],
)
