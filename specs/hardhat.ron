(
    version: 1,
    command: "hardhat",
    description: Some("Ethereum development environment"),
    subcommands: [
        (
            name: "accounts",
            description: Some("Prints the list of accounts"),
        ),
        (
            name: "check",
            description: Some("Check whatever you need"),
        ),
        (
            name: "clean",
            description: Some("Clears the cache and deletes all artifacts"),
            options: [
                (
                    names: [
                        "--global",
                    ],
                    description: Some("Clear the global cache"),
                ),
            ],
        ),
        (
            name: "compile",
            description: Some("Compiles the entire project, building all artifacts"),
            options: [
                (
                    names: [
                        "--force",
                    ],
                    description: Some("Force compilation ignoring cache"),
                ),
                (
                    names: [
                        "--quiet",
                    ],
                    description: Some("Makes the compilation process less verbose"),
                ),
            ],
        ),
        (
            name: "console",
            description: Some("Opens a hardhat console"),
            options: [
                (
                    names: [
                        "--no-compile",
                    ],
                    description: Some("Don't compile before running this task"),
                ),
            ],
        ),
        (
            name: "flatten",
            description: Some("Flattens and prints contracts and their dependencies"),
        ),
        (
            name: "help",
            description: Some("Prints this message"),
        ),
        (
            name: "node",
            description: Some("Starts a JSON-RPC server on top of Hardhat Network"),
            options: [
                (
                    names: [
                        "--fork",
                    ],
                    description: Some("The URL of the JSON-RPC server to fork from"),
                ),
                (
                    names: [
                        "--fork-block-number",
                    ],
                    description: Some("The block number to fork from"),
                ),
                (
                    names: [
                        "--hostname",
                    ],
                    description: Some("The host to which to bind to for new connections"),
                ),
                (
                    names: [
                        "--port",
                    ],
                    description: Some("The port on which to listen for new connections (default: 8545)"),
                ),
            ],
        ),
        (
            name: "run",
            description: Some("Runs a user-defined script after compiling the project"),
            options: [
                (
                    names: [
                        "--no-compile",
                    ],
                    description: Some("Don't compile before running this task"),
                ),
            ],
        ),
        (
            name: "test",
            description: Some("Runs mocha tests"),
            options: [
                (
                    names: [
                        "--no-compile",
                    ],
                    description: Some("Don't compile before running this task"),
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "config",
            ],
            description: Some("A Hardhat config file"),
        ),
        (
            names: [
                "--emoji",
            ],
            description: Some("Use emoji in messages"),
        ),
        (
            names: [
                "--max-memory",
            ],
            description: Some("The maximum amount of memory that Hardhat can use"),
        ),
        (
            names: [
                "--help",
            ],
            description: Some("Shows the help text or task's help if name is provided"),
            arguments: [
                (
                    name: "task",
                    optional: true,
                ),
            ],
        ),
        (
            names: [
                "--network",
            ],
            description: Some("The network to connect to"),
        ),
        (
            names: [
                "---show-stack-traces",
            ],
            description: Some("Show stack traces"),
        ),
        (
            names: [
                "--verbose",
            ],
            description: Some("Enables Hardhat verbose logging"),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Shows hardhat's version"),
        ),
    ],
)
