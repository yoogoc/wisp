(
    version: 1,
    command: "ts-node",
    description: Some("Run the TypeScript interpreter for Node.JS"),
    options: [
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help for ts-node"),
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Print version information of the ts-node module"),
        ),
        (
            names: [
                "-e",
                "--eval",
            ],
            description: Some("Evaluate script"),
            arguments: [
                (
                    name: "script",
                ),
            ],
            presentation: (
                insert_value: Some("-e '{cursor}'"),
            ),
        ),
        (
            names: [
                "-p",
                "--print",
            ],
            description: Some("Evaluate script and print result"),
        ),
        (
            names: [
                "-r",
                "--require",
            ],
            description: Some("Require module before executing"),
            arguments: [
                (
                    name: "module",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                        ),
                    ],
                    filter_strategy: Fuzzy,
                ),
            ],
            repeat: Many,
        ),
        (
            names: [
                "-i",
                "--interactive",
            ],
            description: Some("Always open interactive REPL"),
        ),
        (
            names: [
                "--show-config",
            ],
            description: Some("Print resolved Typescript config to the terminal"),
        ),
        (
            names: [
                "--cwd-mode",
            ],
            description: Some("Resolve Typescript config based on the current working directory"),
        ),
        (
            names: [
                "-T",
                "--transpile-only",
            ],
            description: Some("Use the Typescript transpile module mode"),
        ),
        (
            names: [
                "-H",
                "--compiler-host",
            ],
            description: Some("Use the Typescript compiler host API"),
        ),
        (
            names: [
                "-I",
                "--ignore",
            ],
            description: Some("Ignore patterns from Typescript compilation"),
            arguments: [
                (
                    name: "pattern",
                ),
            ],
        ),
        (
            names: [
                "-P",
                "--project",
            ],
            description: Some("Specify TypeScript project location"),
            arguments: [
                (
                    name: "project",
                    generators: [
                        (
                            template: [
                                FilePaths,
                            ],
                            has_filter_template_suggestions: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "-C",
                "--compiler",
            ],
            description: Some("Use a custom compiler"),
            arguments: [
                (
                    name: "compiler",
                ),
            ],
        ),
        (
            names: [
                "--transpiler",
            ],
            description: Some("Use a custom transpiler"),
            arguments: [
                (
                    name: "transpiler",
                ),
            ],
        ),
        (
            names: [
                "-D",
                "--ignore-diagnostics",
            ],
            description: Some("Specify Typescript diagnostic code to ignore"),
            arguments: [
                (
                    name: "code",
                ),
            ],
        ),
        (
            names: [
                "-O",
                "--compiler-options",
            ],
            description: Some("JSON object that will be merged with the compiler options"),
            arguments: [
                (
                    name: "options",
                ),
            ],
            presentation: (
                insert_value: Some("-O '{cursor}'"),
            ),
        ),
        (
            names: [
                "--cwd",
            ],
            description: Some("Specify working directory"),
            arguments: [
                (
                    name: "cwd",
                    generators: [
                        (
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--files",
            ],
            description: Some("Load files, include and exclude from Typescript config on startup"),
        ),
        (
            names: [
                "--pretty",
            ],
            description: Some("Use the pretty formatter for diagnostic errors"),
        ),
        (
            names: [
                "--skip-project",
            ],
            description: Some("Skip reading Typescript config"),
        ),
        (
            names: [
                "--scope",
            ],
            description: Some("Scope compilation to scope directory specified"),
        ),
        (
            names: [
                "--scope-dir",
            ],
            description: Some("Directory for scope parameter"),
            arguments: [
                (
                    name: "directory",
                    generators: [
                        (
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--skip-ignore",
            ],
            description: Some("Skip --ignore checks"),
        ),
        (
            names: [
                "--prefer-ts-exts",
            ],
            description: Some("Prefer Typescript files over JavaScript files when importing files"),
        ),
        (
            names: [
                "--log-error",
            ],
            description: Some("Pipe Typescript errors to stderr instead of throwing exceptions"),
        ),
        (
            names: [
                "--no-experimental-repl-await",
            ],
            description: Some("Disable the top-level await function in REPL"),
        ),
    ],
    arguments: [
        (
            name: "script",
            generators: [
                (
                    has_custom: true,
                    has_dynamic_trigger: true,
                    has_dynamic_query_term: true,
                ),
            ],
            is_script: true,
        ),
    ],
)
