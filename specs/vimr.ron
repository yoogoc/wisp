(
    version: 1,
    command: "vimr",
    description: Some("VimR — Neovim GUI for macOS in Swift"),
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Show help"),
        ),
        (
            names: [
                "--dry-run",
            ],
            description: Some("Just print the 'open' command"),
        ),
        (
            names: [
                "--cwd",
            ],
            description: Some("Set the working directory"),
            arguments: [
                (
                    name: "CWD",
                ),
            ],
        ),
        (
            names: [
                "--line",
            ],
            description: Some("Go to line"),
            arguments: [
                (
                    name: "LINE",
                ),
            ],
        ),
        (
            names: [
                "--wait",
            ],
            description: Some("This command line tool will exit when the corresponding UI window is closed"),
        ),
        (
            names: [
                "--nvim",
            ],
            description: Some("All arguments except --cur-env, --line, --dry-run and --wait will be passed over to the (new) nvim instance in a new UI window"),
        ),
        (
            names: [
                "--cur-env",
            ],
            description: Some("Use the current environment variables when launching the background neovim process. All files will be opened in a new window"),
        ),
        (
            names: [
                "-n",
            ],
            description: Some("Open files in tabs in a new window"),
        ),
        (
            names: [
                "-s",
            ],
            description: Some("Open files in separate windows"),
        ),
    ],
    arguments: [
        (
            name: "",
            template: [
                FilePaths,
                Folders,
            ],
        ),
    ],
)
