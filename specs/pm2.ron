(
    version: 1,
    command: "pm2",
    description: Some("Daemon process manager"),
    subcommands: [
        (
            name: "start",
            description: Some("Starts and daemonizes an app"),
            options: [
                (
                    names: [
                        "-V",
                        "--version",
                    ],
                    description: Some("Outputs the version number"),
                ),
                (
                    names: [
                        "-v",
                    ],
                    description: Some("Gets version"),
                ),
                (
                    names: [
                        "-s",
                        "--silent",
                    ],
                    description: Some("Hides all messages"),
                ),
                (
                    names: [
                        "-m",
                        "--mini-list",
                    ],
                    description: Some("Displays a compacted list without formatting"),
                ),
                (
                    names: [
                        "-f",
                        "--force",
                    ],
                    description: Some("Forces actions"),
                ),
                (
                    names: [
                        "--disable-logs",
                    ],
                    description: Some("Do not write logs"),
                ),
                (
                    names: [
                        "-n",
                        "--name",
                    ],
                    description: Some("Sets a name for script"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                ),
                (
                    names: [
                        "-i",
                        "--instances",
                    ],
                    description: Some("Launches [number] instances (for networked app)(load balanced)"),
                    arguments: [
                        (
                            name: "number",
                        ),
                    ],
                ),
                (
                    names: [
                        "--parallel",
                    ],
                    description: Some("Number of parallel actions (for restart/reload)"),
                    arguments: [
                        (
                            name: "number",
                        ),
                    ],
                ),
                (
                    names: [
                        "-l",
                        "--log",
                    ],
                    description: Some("Specifies entire log file (error and out are both included)"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                FilePaths,
                            ],
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "-o",
                        "--output",
                    ],
                    description: Some("Specifies out log file"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-e",
                        "--error",
                    ],
                    description: Some("Specifies error log file"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-p",
                        "--pid",
                    ],
                    description: Some("Specify pid file"),
                    arguments: [
                        (
                            name: "pid",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-k",
                        "--kill-timeout",
                    ],
                    description: Some("Delays before sending final SIGKILL signal to process"),
                    arguments: [
                        (
                            name: "delay",
                        ),
                    ],
                ),
                (
                    names: [
                        "--listen-timeout",
                    ],
                    description: Some("Listen timeout on application reload"),
                    arguments: [
                        (
                            name: "delay",
                        ),
                    ],
                ),
                (
                    names: [
                        "--max-memory-restart",
                    ],
                    description: Some("Specify max memory amount used to autorestart (in octet or use syntax like 100M)"),
                    arguments: [
                        (
                            name: "memory",
                        ),
                    ],
                ),
                (
                    names: [
                        "--restart-delay",
                    ],
                    description: Some("Specify a delay between restarts (in milliseconds)"),
                    arguments: [
                        (
                            name: "delay",
                        ),
                    ],
                ),
                (
                    names: [
                        "--env",
                    ],
                    description: Some("Specify environment to get specific env variables"),
                    arguments: [
                        (
                            name: "Environment Name",
                        ),
                    ],
                ),
                (
                    names: [
                        "--log-type",
                    ],
                    description: Some("Specify log output style (raw by default, json optional)"),
                    arguments: [
                        (
                            name: "type",
                            default: Some("raw"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-x",
                        "--execute-command",
                    ],
                    description: Some("Execute a program using fork system"),
                ),
                (
                    names: [
                        "--max-restarts",
                    ],
                    description: Some("Only Restart the script COUNT times"),
                    arguments: [
                        (
                            name: "Count",
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "-u",
                        "--user",
                    ],
                    description: Some("Defines user when generating startup script"),
                    arguments: [
                        (
                            name: "username",
                        ),
                    ],
                ),
                (
                    names: [
                        "--uid",
                    ],
                    description: Some("Runs target script with <uid> rights"),
                    arguments: [
                        (
                            name: "uid",
                        ),
                    ],
                ),
                (
                    names: [
                        "--gid",
                    ],
                    description: Some("Runs target script with <gid> rights"),
                    arguments: [
                        (
                            name: "gid",
                        ),
                    ],
                ),
                (
                    names: [
                        "--cwd",
                    ],
                    description: Some("Runs target script as <username>"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--hp",
                    ],
                    description: Some("Defines home path when generating startup script"),
                    arguments: [
                        (
                            name: "home path",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--wait-ip",
                    ],
                    description: Some("Overrides systemd script to wait for full internet connectivity to launch pm2"),
                ),
                (
                    names: [
                        "--service-name",
                    ],
                    description: Some("Defines service name when generating startup script"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                ),
                (
                    names: [
                        "-c",
                        "--cron",
                    ],
                    description: Some("Restarts a running process based on a cron pattern"),
                    arguments: [
                        (
                            name: "Cron Pattern",
                        ),
                    ],
                ),
                (
                    names: [
                        "-w",
                        "--write",
                    ],
                    description: Some("Writes configuration in local folder"),
                ),
                (
                    names: [
                        "--interpreter",
                    ],
                    description: Some("The interpreter pm2 should use for executing app (bash, python…)"),
                    arguments: [
                        (
                            name: "interpreter",
                        ),
                    ],
                ),
                (
                    names: [
                        "--interpreter-args",
                    ],
                    description: Some("Interprets options (alias of –node-args)"),
                    arguments: [
                        (
                            name: "Arguments",
                        ),
                    ],
                ),
                (
                    names: [
                        "--log-date-format",
                    ],
                    description: Some("Adds custom prefix timestamp to logs"),
                    arguments: [
                        (
                            name: "Date Format",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-daemon",
                    ],
                    description: Some("Runs pm2 daemon in the foreground if it doesn’t exist already"),
                ),
                (
                    names: [
                        "-a",
                        "--update-env",
                    ],
                    description: Some("Updates environment on restart/reload (-a <=> apply)"),
                ),
                (
                    names: [
                        "–-source-map-support",
                    ],
                    description: Some("Force source map support"),
                ),
                (
                    names: [
                        "–-only",
                    ],
                    description: Some("With json declaration, allow to only act on one application"),
                    arguments: [
                        (
                            name: "app name",
                        ),
                    ],
                ),
                (
                    names: [
                        "–-disable-source-map-support",
                    ],
                    description: Some("Force source map support"),
                ),
                (
                    names: [
                        "–-wait-ready",
                    ],
                    description: Some("Asks pm2 to wait for ready event from your app"),
                ),
                (
                    names: [
                        "–-merge-logs",
                    ],
                    description: Some("Merges logs from different instances but keep error and out separated"),
                ),
                (
                    names: [
                        "–-watch",
                    ],
                    description: Some("Watches application folder for changes (default: )"),
                    arguments: [
                        (
                            name: "paths",
                            template: [
                                Folders,
                            ],
                            variadic: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "–-ignore-watch",
                    ],
                    description: Some("Folder/files to be ignored watching"),
                    arguments: [
                        (
                            name: "Folder or Files",
                            template: [
                                Folders,
                                FilePaths,
                            ],
                            variadic: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "–-node-args",
                    ],
                    description: Some("Space delimited arguments to pass to node in cluster mode"),
                    arguments: [
                        (
                            name: "Node Args",
                            description: Some("–node-args=`–debug=7001 –trace-deprecation`"),
                        ),
                    ],
                ),
                (
                    names: [
                        "–-no-color",
                    ],
                    description: Some("Skip colors"),
                ),
                (
                    names: [
                        "–-no-vizion",
                    ],
                    description: Some("Starts an app without vizion feature (versioning control)"),
                ),
                (
                    names: [
                        "–-no-autorestart",
                    ],
                    description: Some("Starts an app without automatic restart"),
                ),
                (
                    names: [
                        "–-no-treekill",
                    ],
                    description: Some("Only kills the main process, not detached children"),
                ),
                (
                    names: [
                        "–-no-pmx",
                    ],
                    description: Some("Starts an app without apm"),
                ),
                (
                    names: [
                        "–-no-automation",
                    ],
                    description: Some("Starts an app without apm"),
                ),
                (
                    names: [
                        "–-trace",
                    ],
                    description: Some("Enables transaction tracing with km"),
                ),
                (
                    names: [
                        "–-disable-trace",
                    ],
                    description: Some("Disables transaction tracing with km"),
                ),
                (
                    names: [
                        "–-attach",
                    ],
                    description: Some("Attaches logging after your start/restart/stop/reload"),
                ),
                (
                    names: [
                        "–-sort",
                    ],
                    description: Some("Sort process according to field’s name"),
                    arguments: [
                        (
                            name: "field name",
                            description: Some("Field_name:sort"),
                        ),
                    ],
                ),
                (
                    names: [
                        "–-v8",
                    ],
                    description: Some("Enables v8 data collecting"),
                ),
                (
                    names: [
                        "–-event-loop-inspector",
                    ],
                    description: Some("Enables event-loop-inspector dump in apm"),
                ),
                (
                    names: [
                        "–-deep-monitoring",
                    ],
                    description: Some("Enables all monitoring tools (equivalent to –v8 –event-loop-inspector –trace)"),
                ),
                (
                    names: [
                        "-h",
                        "–-help",
                    ],
                    description: Some("Outputs usage information"),
                ),
            ],
            arguments: [
                (
                    name: "file, json, stdin, app name, pm id, etc",
                ),
            ],
        ),
        (
            name: "trigger",
            description: Some("Deploy your json"),
            arguments: [
                (
                    name: "Proc Name",
                ),
                (
                    name: "Action Name",
                ),
                (
                    name: "Params",
                    optional: true,
                ),
            ],
        ),
        (
            name: "deploy",
            description: Some("Deploy your json"),
            arguments: [
                (
                    name: "File or environment",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "startOrRestart",
            description: Some("Start or restart JSON file"),
            arguments: [
                (
                    name: "json",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "startOrReload",
            description: Some("Start or gracefully reload JSON file"),
            arguments: [
                (
                    name: "json",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "pid",
            description: Some("Return pid of the specified app or all"),
            arguments: [
                (
                    name: "app name",
                    optional: true,
                ),
            ],
        ),
        (
            name: "startOrGracefulReload",
            description: Some("Start or gracefully reolad JSON file"),
            arguments: [
                (
                    name: "json",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                            has_dynamic_query_term: true,
