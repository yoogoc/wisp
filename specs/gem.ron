(
    version: 1,
    command: "gem",
    description: Some("Ruby package manager"),
    subcommands: [
        (
            name: "help",
            description: Some("Help about any command"),
            arguments: [
                (
                    name: "command",
                    template: [
                        Help,
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "install",
            aliases: [
                "i",
            ],
            description: Some("Install a gem into the local repository"),
            options: [
                (
                    names: [
                        "--platform",
                    ],
                    description: Some("Specify the platform of gem to install"),
                    arguments: [
                        (
                            name: "PLATFORM",
                            description: Some("The platform of gem"),
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "GEMNAME",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                        ),
                    ],
                    debounce: true,
                ),
            ],
        ),
        (
            name: "cert",
            description: Some("Manage RubyGems certificates and signing settings"),
            options: [
                (
                    names: [
                        "-a",
                        "--add",
                    ],
                    description: Some("Add a trusted certificate"),
                    arguments: [
                        (
                            name: "CERT",
                            description: Some("The trusted certificate"),
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-l",
                        "--list",
                    ],
                    description: Some("List trusted certificates where the subject contains FILTER"),
                    arguments: [
                        (
                            name: "FILTER",
                            description: Some("The filter"),
                            optional: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "-r",
                        "--remove",
                    ],
                    description: Some("Remove trusted certificates where the subject contains FILTER"),
                    arguments: [
                        (
                            name: "FILTER",
                            description: Some("The filter"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-b",
                        "--build",
                    ],
                    description: Some("Build private key and self-signed certificate for EMAIL_ADDR"),
                    arguments: [
                        (
                            name: "EMAIL_ADDR",
                            description: Some("The email address"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-C",
                        "--certificate",
                    ],
                    description: Some("Signing certificate for --sign"),
                    arguments: [
                        (
                            name: "CERT",
                            description: Some("The certificate"),
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-K",
                        "--private-key",
                    ],
                    description: Some("Key for --sign or --build"),
                    arguments: [
                        (
                            name: "KEY",
                            description: Some("The key"),
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-A",
                        "--key-algorithm",
                    ],
                    description: Some("Select which key algorithm to use for --build"),
                    arguments: [
                        (
                            name: "ALGORITHM",
                            description: Some("The algorithm"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-s",
                        "--sign",
                    ],
                    description: Some("Signs CERT with the key from -K and the certificate from -C"),
                    arguments: [
                        (
                            name: "CERT",
                            description: Some("The certificate"),
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-d",
                        "--days",
                    ],
                    description: Some("Days before the certificate expires"),
                    arguments: [
                        (
                            name: "NUMBER_OF_DAYS",
                            description: Some("The number of days"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-R",
                        "--re-sign",
                    ],
                    description: Some("Re-signs the certificate from -C with the key from -K"),
                ),
            ],
        ),
        (
            name: "check",
            description: Some("Check a gem repository for added or missing files"),
            options: [
                (
                    names: [
                        "-a",
                        "--alien",
                    ],
                    description: Some("Report 'unmanaged' or rogue files in the gem repository"),
                    exclusive_on: [
                        "--no-alien",
                    ],
                ),
                (
                    names: [
                        "--no-alien",
                    ],
                    description: Some("Report 'managed' or rogue files in the gem repository"),
                    exclusive_on: [
                        "--alien",
                    ],
                ),
                (
                    names: [
                        "--doctor",
                    ],
                    description: Some("Clean up uninstalled gems and broken specifications"),
                    exclusive_on: [
                        "--no-doctor",
                    ],
                ),
                (
                    names: [
                        "--no-doctor",
                    ],
                    description: Some("Do not clean up uninstalled gems and broken specifications"),
                    exclusive_on: [
                        "--doctor",
                    ],
                ),
                (
                    names: [
                        "--dry-run",
                    ],
                    description: Some("Do not remove files, only report what would be removed"),
                    exclusive_on: [
                        "--no-dry-run",
                    ],
                ),
                (
                    names: [
                        "--no-dry-run",
                    ],
                    description: Some("Remove files"),
                    exclusive_on: [
                        "--dry-run",
                    ],
                ),
                (
                    names: [
                        "--gems",
                    ],
                    description: Some("Check installed gems for problems"),
                    exclusive_on: [
                        "--no-gems",
                    ],
                ),
                (
                    names: [
                        "--no-gems",
                    ],
                    description: Some("Check not installed gems for problems"),
                    exclusive_on: [
                        "--gems",
                    ],
                ),
                (
                    names: [
                        "-v",
                        "--version",
                    ],
                    description: Some("Specify version of gem to check"),
                    arguments: [
                        (
                            name: "VERSION",
                            description: Some("The version of the gem"),
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "GEMNAME",
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                        ),
                    ],
                    optional: true,
                    debounce: true,
                ),
            ],
        ),
        (
            name: "cleanup",
            description: Some("Clean up old versions of installed gems"),
            options: [
                (
                    names: [
                        "-n",
                        "-d",
                        "--dry-run",
                    ],
                    description: Some("Do not uninstall gems"),
                ),
                (
                    names: [
                        "-D",
                        "--check-development",
                    ],
                    description: Some("Check development dependencies while uninstalling (default: true)"),
                    exclusive_on: [
                        "--no-check-development",
                    ],
                ),
                (
                    names: [
                        "--no-check-development",
                    ],
                    description: Some("Do not check development dependencies while uninstalling"),
                    exclusive_on: [
                        "--check-development",
                    ],
                ),
                (
                    names: [
                        "--user-install",
                    ],
                    description: Some("Cleanup in user’s home directory instead of GEM_HOME"),
                    exclusive_on: [
                        "--no-user-install",
                    ],
                ),
                (
                    names: [
                        "--no-user-install",
                    ],
                    description: Some("Cleanup in GEM_HOME instead of user’s home directory"),
                    exclusive_on: [
                        "--user-install",
                    ],
                ),
            ],
            arguments: [
                (
                    name: "GEMNAME",
                    description: Some("Name of gem to cleanup"),
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                        ),
                    ],
                    optional: true,
                    debounce: true,
                ),
            ],
        ),
        (
            name: "contents",
            description: Some("Display the contents of the installed gems"),
            options: [
                (
                    names: [
                        "-v",
                        "--version",
                    ],
                    description: Some("Specify version of gem to contents"),
                    arguments: [
                        (
                            name: "VERSION",
                            description: Some("The version of the gem"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--all",
                    ],
                    description: Some("Contents for all gems"),
                ),
                (
                    names: [
                        "-s",
                        "--spec-dir",
                    ],
                    description: Some("Search for gems under specific paths"),
                    arguments: [
                        (
                            name: "DIR",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-l",
                        "--lib-only",
                    ],
                    description: Some("Only return files in the Gem’s lib_dirs"),
                    exclusive_on: [
                        "--no-lib-only",
                    ],
                ),
                (
                    names: [
                        "--no-lib-only",
                    ],
                    description: Some("Not only return files in the Gem’s lib_dirs"),
                    exclusive_on: [
                        "--lib-only",
                    ],
                ),
                (
                    names: [
                        "--prefix",
                    ],
                    description: Some("Don’t include installed path prefix"),
                    exclusive_on: [
                        "--no-prefix",
                    ],
                ),
                (
                    names: [
                        "--no-prefix",
                    ],
                    description: Some("Include installed path prefix"),
                    exclusive_on: [
                        "--prefix",
                    ],
                ),
                (
                    names: [
                        "--show-install-dir",
                    ],
                    description: Some("Show only the gem install dir"),
                    exclusive_on: [
                        "--no-show-install-dir",
                    ],
                ),
                (
                    names: [
                        "--no-show-install-dir",
                    ],
                    description: Some("Do not show only the gem install dir"),
                    exclusive_on: [
                        "--show-install-dir",
                    ],
                ),
            ],
            arguments: [
                (
                    name: "GEMNAME",
                    description: Some("Name of gem to list contents for"),
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                        ),
                    ],
                    debounce: true,
                ),
            ],
        ),
        (
            name: "dependency",
            description: Some("Show the dependencies of an installed gem"),
            options: [
                (
                    names: [
                        "-v",
                        "--version",
                    ],
                    description: Some("Specify version of gem to dependency"),
                    arguments: [
                        (
                            name: "VERSION",
                            description: Some("The version of gem"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--platform",
                    ],
                    description: Some("Specify the platform of gem to dependency"),
                    arguments: [
                        (
                            name: "PLATFORM",
                            description: Some("The platform of gem"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--prerelease",
                    ],
                    description: Some("Allow prerelease versions of a gem"),
                    exclusive_on: [
                        "--no-prerelease",
                    ],
                ),
                (
                    names: [
                        "--no-prerelease",
                    ],
                    description: Some("Do not allow prerelease versions of a gem"),
                    exclusive_on: [
                        "--prerelease",
                    ],
                ),
                (
                    names: [
                        "-R",
                        "--reverse-dependencies",
                    ],
                    description: Some("Include reverse dependencies in the output"),
                    exclusive_on: [
                        "--no-reverse-dependencies",
                    ],
                ),
                (
                    names: [
                        "--no-reverse-dependencies",
                    ],
                    description: Some("Do not include reverse dependencies in the output"),
                    exclusive_on: [
                        "--reverse-dependencies",
                    ],
                ),
                (
                    names: [
                        "--pipe",
                    ],
                    description: Some("Pipe Format (name --version ver)"),
                ),
                (
                    names: [
                        "-l",
                        "--local",
                    ],
                    description: Some("Restrict operations to the LOCAL domain"),
                    exclusive_on: [
                        "--remote",
                        "--both",
                    ],
                ),
                (
                    names: [
                        "-r",
                        "--remote",
                    ],
                    description: Some("Restrict operations to the REMOTE domain"),
                    exclusive_on: [
                        "--local",
                        "--both",
                    ],
                ),
                (
                    names: [
                        "-b",
                        "--both",
                    ],
                    description: Some("Allow LOCAL and REMOTE operations"),
                    exclusive_on: [
                        "--remote",
                        "--local",
                    ],
                ),
                (
                    names: [
                        "-B",
                        "--bulk-threshold",
                    ],
                    description: Some("Threshold for switching to bulk synchronization (default 1000)"),
                    arguments: [
                        (
                            name: "COUNT",
                            description: Some("The threshold"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--clear-sources",
                    ],
                    description: Some("Clear the gem sources"),
                ),
                (
                    names: [
                        "-s",
                        "--source",
                    ],
                    description: Some("Append URL to list of remote gem sources"),
                    arguments: [
                        (
                            name: "URL",
                            description: Some("The URL"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-p",
                        "--http-proxy",
                    ],
                    description: Some("Use HTTP proxy for remote operations"),
                    arguments: [
                        (
                            name: "URL",
                            description: Some("The URL"),
                            optional: true,
                        ),
                    ],
                    exclusive_on: [
                        "--no-http-proxy",
                    ],
                ),
                (
                    names: [
                        "--no-http-proxy",
                    ],
                    description: Some("Do not use HTTP proxy for remote operations"),
                    exclusive_on: [
                        "--http-proxy",
                    ],
                ),
            ],
            arguments: [
                (
                    name: "REGEXP",
                    description: Some("Show dependencies for gems whose names start with REGEXP"),
                ),
            ],
        ),
        (
            name: "environment",
            description: Some("Display information about the RubyGems environment"),
            arguments: [
                (
                    name: "",
                    suggestions: [
                        (
                            name: "home",
                            description: Some("Display the path where gems are installed. Aliases: gemhome, gemdir, GEM_HOME"),
                        ),
                        (
                            name: "path",
                            description: Some("Display path used to search for gems. Aliases: gempath, GEM_PATH"),
                        ),
                        (
                            name: "user_gemhome",
                            description: Some("Display the path where gems are installed when --user-install is given. Aliases: user_gemdir"),
                        ),
                        (
                            name: "version",
                            description: Some("Display the gem format version"),
                        ),
                        (
                            name: "remotesources",
                            description: Some("Display the remote gem servers"),
                        ),
                        (
                            name: "platform",
                            description: Some("Display the supported gem platforms"),
                        ),
                    ],
                    optional: true,
                ),
            ],
        ),
        (
            name: "fetch",
            description: Some("Download a gem and place it in the current directory"),
            options: [
                (
                    names: [
                        "-v",
                        "--version",
                    ],
                    description: Some("Specify version of gem to fetch"),
                    arguments: [
                        (
                            name: "VERSION",
                            description: Some("The version of the gem"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--platform",
                    ],
                    description: Some("Specify the platform of gem to fetch"),
                    arguments: [
                        (
                            name: "PLATFORM",
                            description: Some("The platform of gem"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--prerelease",
                    ],
                    description: Some("Allow prerelease versions of a gem"),
                    exclusive_on: [
                        "--no-prerelease",
                    ],
                ),
                (
                    names: [
                        "--no-prerelease",
                    ],
                    description: Some("Do not allow prerelease versions of a gem"),
                    exclusive_on: [
                        "--prerelease",
                    ],
                ),
                (
                    names: [
                        "--suggestions",
                    ],
                    description: Some("Suggest alternates when gems are not found"),
                    exclusive_on: [
                        "--no-suggestions",
                    ],
                ),
                (
                    names: [
                        "--no-suggestions",
                    ],
                    description: Some("Do not suggest alternates when gems are not found"),
                    exclusive_on: [
                        "--suggestions",
                    ],
                ),
                (
                    names: [
                        "-B",
                        "--bulk-threshold",
                    ],
                    description: Some("Threshold for switching to bulk synchronization (default 1000)"),
                    arguments: [
                        (
                            name: "COUNT",
                            description: Some("The threshold"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-s",
                        "--source",
                    ],
                    description: Some("Append URL to list of remote gem sources"),
                    arguments: [
                        (
                            name: "URL",
                            description: Some("The URL"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--clear-sources",
                    ],
                    description: Some("Clear the gem sources"),
                ),
                (
                    names: [
                        "-p",
                        "--http-proxy",
                    ],
                    description: Some("Use HTTP proxy for remote operations"),
                    arguments: [
                        (
                            name: "URL",
                            description: Some("The URL"),
                            optional: true,
                        ),
                    ],
                    exclusive_on: [
                        "--no-http-proxy",
                    ],
                ),
                (
                    names: [
                        "--no-http-proxy",
                    ],
                    description: Some("Do not use HTTP proxy for remote operations"),
                    exclusive_on: [
                        "--http-proxy",
                    ],
                ),
            ],
            arguments: [
                (
                    name: "GEMNAME",
                    description: Some("Name of gem to download"),
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                        ),
                    ],
                    debounce: true,
                ),
            ],
        ),
        (
            name: "generate_index",
            description: Some("Generates the index files for a gem server directory"),
            options: [
                (
                    names: [
                        "-d",
                        "--directory",
                    ],
                    description: Some("Repository base dir containing gems subdir"),
                    arguments: [
                        (
                            name: "DIRNAME",
                            template: [
                                Folders,
                            ],
                            filter_strategy: Fuzzy,
                        ),
                    ],
                    requires_separator: Some("="),
                ),
                (
                    names: [
                        "--modern",
                    ],
                    description: Some("Generate indexes for RubyGems (always true)"),
                    exclusive_on: [
                        "--no-modern",
                    ],
                ),
                (
                    names: [
                        "--no-modern",
                    ],
                    description: Some("Do not generate indexes for RubyGems"),
                    exclusive_on: [
                        "--modern",
                    ],
                ),
                (
                    names: [
                        "--update",
                    ],
                    description: Some("Update modern indexes with gems added since the last update"),
                ),
            ],
        ),
        (
            name: "info",
            description: Some("Show information for the given gem"),
            options: [
                (
                    names: [
                        "-I",
                    ],
                    description: Some("Equivalent to --no-installed"),
                    exclusive_on: [
                        "--installed",
                    ],
                ),
                (
                    names: [
                        "-a",
                        "--all",
                    ],
                    description: Some("Display all gem versions"),
                ),
                (
                    names: [
                        "-e",
                        "--exact",
                    ],
                    description: Some("Name of gem(s) to query on matches the provided STRING"),
                ),
                (
                    names: [
                        "--prerelease",
                    ],
                    description: Some("Allow prerelease versions of a gem"),
                    exclusive_on: [
                        "--no-prerelease",
                    ],
                ),
                (
                    names: [
                        "--no-prerelease",
                    ],
                    description: Some("Do not allow prerelease versions of a gem"),
                    exclusive_on: [
                        "--prerelease",
                    ],
                ),
                (
                    names: [
                        "-i",
                        "--installed",
                    ],
                    description: Some("Check for installed gem"),
                    exclusive_on: [
                        "--no-installed",
                    ],
                ),
                (
                    names: [
                        "-I",
                        "--no-installed",
                    ],
                    description: Some("Check for not installed gem"),
                    exclusive_on: [
                        "--installed",
                    ],
                ),
                (
                    names: [
                        "-v",
                        "--version",
                    ],
                    description: Some("Specify version of gem to list for use with --installed"),
                    arguments: [
                        (
                            name: "VERSION",
                            description: Some("The version of gem"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--versions",
                    ],
                    description: Some("Display only gem names"),
                    exclusive_on: [
                        "--no-versions",
                    ],
                ),
                (
                    names: [
                        "--no-versions",
                    ],
                    description: Some("Display not only gem names"),
                    exclusive_on: [
                        "--versions",
                    ],
                ),
            ],
            arguments: [
                (
                    name: "GEMNAME",
                    description: Some("Name of the gem to print information about"),
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                        ),
                    ],
                    debounce: true,
                ),
            ],
        ),
        (
            name: "lock",
            description: Some("Generate a lockdown list of gems"),
            options: [
                (
                    names: [
                        "-s",
                        "--strict",
                    ],
                    description: Some("Fail if unable to satisfy a dependency"),
                    exclusive_on: [
                        "--no-strict",
                    ],
                ),
                (
                    names: [
                        "--no-strict",
                    ],
                    description: Some("Do not fail if unable to satisfy a dependency"),
                    exclusive_on: [
                        "--strict",
                    ],
                ),
            ],
            arguments: [
                (
                    name: "GEMNAME-VERSION",
                    description: Some("Name and the version of gem to lock, ex: rails-1.0.0"),
                ),
            ],
        ),
        (
            name: "mirror",
            description: Some("Mirror all gem files (requires rubygems-mirror)"),
        ),
        (
            name: "open",
            description: Some("Open gem sources in editor"),
            options: [
                (
                    names: [
                        "-e",
                        "--editor",
                    ],
                    description: Some("Prepends COMMAND to gem path. Could be used to specify editor"),
                    arguments: [
                        (
                            name: "COMMAND",
                            description: Some("The prepends command to gem path"),
                        ),
                    ],
                ),
                (
                    names: [
                        "-v",
                        "--version",
                    ],
                    description: Some("Opens specific gem version"),
                    arguments: [
                        (
                            name: "VERSION",
                            description: Some("The specify version of gem"),
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "GEMNAME",
                    description: Some("Name of the gem to print information about"),
                    generators: [
                        (
                            has_custom: true,
                            has_dynamic_trigger: true,
                        ),
                    ],
                    debounce: true,
                ),
            ],
        ),
        (
            name: "pristine",
            description: Some("Restores installed gems to pristine condition from files located in the gem cache"),
            options: [
                (
                    names: [
                        "--all",
                    ],
                    description: Some("Restore all installed gems to pristine condition"),
                ),
                (
                    names: [
                        "--skip",
                    ],
                    description: Some("Restore all installed gems to pristine condition"),
                    arguments: [
                        (
                            name: "GEMNAME",
                            description: Some("Name of the gem to print information about"),
                            generators: [
                                (
                                    has_custom: true,
                                    has_dynamic_trigger: true,
                                ),
                            ],
                            debounce: true,
                        ),
                    ],
                    requires_separator: Some("="),
                    depends_on: [
                        "--all",
                    ],
                ),
                (
                    names: [
                        "--extensions",
                    ],
                    description: Some("Restore gems with extensions in addition to regular gems"),
                    exclusive_on: [
                        "--no-extensions",
                    ],
                ),
                (
                    names: [
                        "--no-extensions",
                    ],
                    description: Some("Do not restore gems with extensions in addition to regular gems"),
                    exclusive_on: [
                        "--extensions",
                    ],
                ),
                (
                    names: [
                        "--only-executables",
                    ],
                    description: Some("Only restore executables"),
                ),
                (
                    names: [
                        "--only-plugins",
                    ],
                    description: Some("Only restore plugins"),
                ),
                (
                    names: [
                        "-E",
                        "--env-shebang",
                    ],
                    description: Some("Rewrite executables with a shebang of /usr/bin/env"),
                    exclusive_on: [
                        "--no-env-shebang",
                    ],
                ),
                (
                    names: [
                        "--no-env-shebang",
                    ],
                    description: Some("Do not rewrite executables with a shebang of /usr/bin/env"),
                    exclusive_on: [
                        "--env-shebang",
                    ],
                ),
                (
                    names: [
                        "-i",
                        "--install-dir",
                    ],
                    description: Some("Gem repository to get binstubs and plugins installed"),
                    arguments: [
                        (
                            name: "DIR",
                            template: [
                                Folders,
                            ],
                            filter_strategy: Fuzzy,
                        ),
                    ],
                ),
                (
                    names: [
                        "-n",
                        "--bindir",
                    ],
                    description: Some("Directory where executables are located"),
                    arguments: [
                        (
                            name: "DIR",
                            template: [
                                Folders,
                            ],
                            filter_strategy: Fuzzy,
                        ),
                    ],
                ),
                (
                    names: [
                        "-v",
                        "--version",
                    ],
                    description: Some("Specify version of gem to restore to pristine condition"),
                    arguments: [
                        (
                            name: "VERSION",
