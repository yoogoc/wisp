(
    version: 1,
    command: "tee",
    description: Some("Duplicate standard input"),
    options: [
        (
            names: [
                "-a",
            ],
            description: Some("Append the output to the files rather than overwriting them"),
        ),
        (
            names: [
                "-i",
            ],
            description: Some("Ignore the SIGINT signal"),
        ),
    ],
    arguments: [
        (
            name: "file",
            description: Some("Pathname of an output file"),
            template: [
                FilePaths,
            ],
            variadic: true,
        ),
    ],
)
