(
    version: 1,
    command: "googler",
    description: Some("Google from the command-line"),
    options: [
        (
            names: [
                "-h",
                "--help",
            ],
            description: Some("Show this help message and exit"),
        ),
        (
            names: [
                "-s",
                "--start",
            ],
            description: Some("Start at the Nth result"),
            arguments: [
                (
                    name: "N",
                ),
            ],
        ),
        (
            names: [
                "-n",
                "--count",
            ],
            description: Some("Show N results"),
            arguments: [
                (
                    name: "N",
                    default: Some("10"),
                ),
            ],
        ),
        (
            names: [
                "-N",
                "--news",
            ],
            description: Some("Show results from news section"),
        ),
        (
            names: [
                "-V",
                "--videos",
            ],
            description: Some("Show results from videos section"),
        ),
        (
            names: [
                "-c",
                "--tld",
            ],
            description: Some("Country-specific search with top-level domain .TLD, e.g., 'in' for India"),
            arguments: [
                (
                    name: "top-level domain",
                ),
            ],
        ),
        (
            names: [
                "-l",
                "--lang",
            ],
            description: Some("Display in language"),
            arguments: [
                (
                    name: "language",
                ),
            ],
        ),
        (
            names: [
                "-g",
                "--geoloc",
            ],
            description: Some("Country-specific geolocation search with country code CC, e.g. 'in' for India"),
            arguments: [
                (
                    name: "CC",
                    description: Some("Country codes are the same as top-level domains"),
                ),
            ],
        ),
        (
            names: [
                "-x",
                "--exact",
            ],
            description: Some("Disable automatic spelling correction"),
        ),
        (
            names: [
                "--colorize",
            ],
            description: Some("Whether to colorize output which enables color when stdout is a tty device"),
            arguments: [
                (
                    name: "mode",
                    suggestions: [
                        (
                            name: "auto",
                        ),
                        (
                            name: "always",
                        ),
                        (
                            name: "never",
                        ),
                    ],
                    default: Some("auto"),
                ),
            ],
        ),
        (
            names: [
                "-C",
                "--nocolor",
            ],
            description: Some("Equivalent to --colorize=never"),
        ),
        (
            names: [
                "--colors",
            ],
            description: Some("Set output colors"),
            arguments: [
                (
                    name: "colors",
                    variadic: true,
                ),
            ],
        ),
        (
            names: [
                "-j",
                "--first",
                "--lucky",
            ],
            description: Some("Open the first result in web browser and exit"),
        ),
        (
            names: [
                "-t",
                "--time",
            ],
            description: Some("Time limit search [h5 (5 hrs), d5 (5 days), w5 (5 weeks), m5 (5 months), y5 (5 years)"),
            arguments: [
                (
                    name: "time limit",
                ),
            ],
        ),
        (
            names: [
                "--from",
            ],
            description: Some("Starting date/month/year of date range. Can be used in conjunction with --to and overrides -t, --time"),
            arguments: [
                (
                    name: "date",
                    description: Some("American date format with slashes, e.g., 2/24/2020, 2/2020, 2020"),
                ),
            ],
        ),
        (
            names: [
                "--to",
            ],
            description: Some("Ending date/month/year of date range"),
            arguments: [
                (
                    name: "date",
                    description: Some("American date format with slashes, e.g., 2/24/2020, 2/2020, 2020"),
                ),
            ],
        ),
        (
            names: [
                "-w",
                "--site",
            ],
            description: Some("Search a site using Google"),
            arguments: [
                (
                    name: "site",
                ),
            ],
        ),
        (
            names: [
                "-e",
                "--exclude",
            ],
            description: Some("Exclude site from results"),
        ),
        (
            names: [
                "--unfilter",
            ],
            description: Some("Do not omit similar results"),
        ),
        (
            names: [
                "-p",
                "--proxy",
            ],
            description: Some("Tunnel traffic through an HTTP proxy"),
            arguments: [
                (
                    name: "PROXY",
                    description: Some("In the form of [http://][user:password@]proxyhost[:port]"),
                ),
            ],
        ),
        (
            names: [
                "--notweak",
            ],
            description: Some("Disable TCP optimizations and forced TLS 1.2"),
        ),
        (
            names: [
                "--json",
            ],
            description: Some("Output in JSON format; implies --noprompt"),
            depends_on: [
                "--noprompt",
            ],
        ),
        (
            names: [
                "--url-handler",
            ],
            description: Some("Custom script or cli utility to open results"),
            arguments: [
                (
                    name: "util",
                ),
            ],
        ),
        (
            names: [
                "--show-browser-logs",
            ],
            description: Some("Do not suppress browser output (stdout and stderr)"),
        ),
        (
            names: [
                "--np",
                "--noprompt",
            ],
            description: Some("Search and exit, do not prompt"),
        ),
        (
            names: [
                "-4",
                "--ipv4",
            ],
            description: Some("Only connect over IPv4 (by default, IPv4 is preferred but IPv6 is used as a fallback)"),
        ),
        (
            names: [
                "-6",
                "--ipv6",
            ],
            description: Some("Only connect over IPv6"),
        ),
        (
            names: [
                "-u",
                "--upgrade",
            ],
            description: Some("Perform in-place self-upgrade"),
        ),
        (
            names: [
                "--include-git",
            ],
            description: Some("When used with --upgrade, get latest git master"),
        ),
        (
            names: [
                "-v",
                "--version",
            ],
            description: Some("Show program's version number and exit"),
        ),
        (
            names: [
                "-d",
                "--debug",
            ],
            description: Some("Enable debugging"),
        ),
    ],
    arguments: [
        (
            name: "keyword",
            description: Some("Search keywords"),
            optional: true,
            variadic: true,
        ),
    ],
)
