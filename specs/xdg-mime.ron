(
    version: 1,
    command: "xdg-mime",
    description: Some("Command line tool for querying information about file type handling and adding descriptions for new file types"),
    subcommands: [
        (
            name: "query",
            description: Some("Returns information related to file types"),
            arguments: [
                (
                    name: "filetype | default",
                    template: [
                        FilePaths,
                    ],
                    variadic: true,
                ),
            ],
        ),
        (
            name: "default",
            description: Some("Ask the desktop environment to make application the default application for opening files of type mimetype"),
            arguments: [
                (
                    name: "application",
                ),
                (
                    name: "mimetype(s)",
                    variadic: true,
                ),
            ],
        ),
        (
            name: "install",
            description: Some("Adds the file type descriptions provided in mimetypes-file to the desktop environment"),
            options: [
                (
                    names: [
                        "--mode",
                    ],
                    arguments: [
                        (
                            name: "mode",
                            suggestions: [
                                (
                                    name: "user",
                                ),
                                (
                                    name: "system",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--novendor",
                    ],
                    description: Some("Disables xdg-mime checks that the mimetypes-file to be installed has a proper vendor prefix"),
                ),
            ],
            arguments: [
                (
                    name: "mimetypes-file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            name: "uninstall",
            description: Some("Removes the file type descriptions provided in mimetypes-file and previously added with xdg-mime install from the desktop environment"),
            options: [
                (
                    names: [
                        "--mode",
                    ],
                    arguments: [
                        (
                            name: "mode",
                            suggestions: [
                                (
                                    name: "user",
                                ),
                                (
                                    name: "system",
                                ),
                            ],
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "mimetypes-file",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--help",
            ],
            description: Some("Show command synopsis"),
        ),
        (
            names: [
                "--manual",
            ],
            description: Some("Show manual page"),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Show the xdg-utils version information"),
        ),
    ],
)
