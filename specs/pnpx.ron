(
    version: 1,
    command: "pnpx",
    description: Some("Execute binaries from npm packages"),
    subcommands: [
        (
            name: "create-react-native-app",
            load_spec: Some("create-react-native-app"),
            presentation: (
                icon: Some("https://reactnative.dev/img/pwa/manifest-icon-512.png"),
            ),
        ),
        (
            name: "react-native",
            load_spec: Some("react-native"),
            presentation: (
                icon: Some("https://reactnative.dev/img/pwa/manifest-icon-512.png"),
            ),
        ),
        (
            name: "tailwindcss",
            load_spec: Some("tailwindcss"),
            presentation: (
                icon: Some("https://tailwindcss.com/favicon-32x32.png"),
            ),
        ),
        (
            name: "next",
            load_spec: Some("next"),
            presentation: (
                icon: Some("https://nextjs.org/static/favicon/favicon-16x16.png"),
            ),
        ),
        (
            name: "gltfjsx",
            load_spec: Some("gltfjsx"),
            presentation: (
                icon: Some("https://raw.githubusercontent.com/pmndrs/branding/master/logo.svg"),
            ),
        ),
        (
            name: "prisma",
            load_spec: Some("prisma"),
            presentation: (
                icon: Some("https://raw.githubusercontent.com/prisma/docs/main/src/images/favicon-16x16.png"),
            ),
        ),
    ],
    options: [
        (
            names: [
                "--package",
                "-p",
            ],
            description: Some("Package to be executed"),
            arguments: [
                (
                    name: "package",
                ),
            ],
        ),
        (
            names: [
                "--cache",
            ],
            description: Some("Location of the npm cache"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--always-spawn",
            ],
            description: Some("Always spawn a child process to execute the command"),
        ),
        (
            names: [
                "--no-install",
            ],
            description: Some("Skip installation if a package is missing"),
        ),
        (
            names: [
                "--userconfig",
            ],
            description: Some("Path to user npmrc"),
            arguments: [
                (
                    name: "path",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--call",
                "-c",
            ],
            description: Some("Execute string as if inside `npm run-script`"),
            arguments: [
                (
                    name: "script",
                ),
            ],
        ),
        (
            names: [
                "--shell",
                "-s",
            ],
            description: Some("Shell to execute the command with, if any"),
            arguments: [
                (
                    name: "shell",
                    suggestions: [
                        (
                            name: "bash",
                        ),
                        (
                            name: "fish",
                        ),
                        (
                            name: "zsh",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--shell-auto-fallback",
            ],
            description: Some("Generate shell code to use pnpx as the \"command not found\" fallback"),
            arguments: [
                (
                    name: "shell-fallback",
                    suggestions: [
                        (
                            name: "bash",
                        ),
                        (
                            name: "fish",
                        ),
                        (
                            name: "zsh",
                        ),
                    ],
                ),
            ],
        ),
        (
            names: [
                "--ignore-existing",
            ],
            description: Some("Ignores existing binaries in $PATH, or in the localproject. This forces pnpx to do a temporary install and use the latest version"),
        ),
        (
            names: [
                "--quiet",
                "-q",
            ],
            description: Some("Suppress output from pnpx itself. Subcommands will not be affected"),
        ),
        (
            names: [
                "--npm",
            ],
            description: Some("Npm binary to use for internal operations"),
            arguments: [
                (
                    name: "path to binary",
                    template: [
                        FilePaths,
                    ],
                ),
            ],
        ),
        (
            names: [
                "--node-arg",
                "-n",
            ],
            description: Some("Extra node argument when calling a node binary"),
            arguments: [
                (
                    name: "",
                ),
            ],
        ),
        (
            names: [
                "--version",
                "-v",
            ],
            description: Some("Show version number"),
        ),
        (
            names: [
                "--help",
                "-h",
            ],
            description: Some("Show help"),
        ),
    ],
)
