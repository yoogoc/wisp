(
    version: 1,
    command: "iconv",
    description: Some("Character set conversion"),
    options: [
        (
            names: [
                "--help",
            ],
            description: Some("Show help for iconv"),
        ),
        (
            names: [
                "--version",
            ],
            description: Some("Output version information and exit"),
        ),
        (
            names: [
                "-f",
                "--from-code",
            ],
            description: Some("Specifies the encoding of the input"),
            arguments: [
                (
                    name: "encoding",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "iconv -l | command tr ' ' '\\n' | sort",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
            exclusive_on: [
                "-l",
                "--list",
            ],
        ),
        (
            names: [
                "-t",
                "--to-code",
            ],
            description: Some("Specifies the encoding of the output"),
            arguments: [
                (
                    name: "encoding",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "iconv -l | command tr ' ' '\\n' | sort",
                            ],
                            has_post_process: true,
                        ),
                    ],
                ),
            ],
            exclusive_on: [
                "-l",
                "--list",
            ],
        ),
        (
            names: [
                "-c",
            ],
            description: Some("Discard unconvertible characters"),
            exclusive_on: [
                "-l",
                "--list",
            ],
        ),
        (
            names: [
                "-l",
                "--list",
            ],
            description: Some("List the supported encodings"),
            exclusive_on: [
                "-f",
                "--from-code",
                "-t",
                "--to-code",
                "--unicode-subst",
                "--byte-subst",
                "--widechar-subst",
            ],
        ),
        (
            names: [
                "--unicode-subst",
            ],
            description: Some("Substitution for unconvertible Unicode characters"),
            arguments: [
                (
                    name: "FORMATSTRING",
                    description: Some("The formatstring must be a format string in the same format as for the printf command"),
                ),
            ],
            requires_separator: Some("="),
            exclusive_on: [
                "-l",
                "--list",
            ],
        ),
        (
            names: [
                "--byte-subst",
            ],
            description: Some("Substitution for unconvertible bytes"),
            arguments: [
                (
                    name: "FORMATSTRING",
                    description: Some("The formatstring must be a format string in the same format as for the printf command"),
                ),
            ],
            requires_separator: Some("="),
            exclusive_on: [
                "-l",
                "--list",
            ],
        ),
        (
            names: [
                "--widechar-subst",
            ],
            description: Some("Substitution for unconvertible wide characters"),
            arguments: [
                (
                    name: "FORMATSTRING",
                    description: Some("The formatstring must be a format string in the same format as for the printf command"),
                ),
            ],
            requires_separator: Some("="),
            exclusive_on: [
                "-l",
                "--list",
            ],
        ),
    ],
    arguments: [
        (
            name: "inputfile",
            template: [
                FilePaths,
            ],
            variadic: true,
        ),
    ],
)
