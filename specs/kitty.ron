        (
            name: "icat",
            description: Some("A cat like utility to display images in the terminal"),
            options: [
                (
                    names: [
                        "--align",
                    ],
                    description: Some("Horizontal alignment for the displayed image"),
                    arguments: [
                        (
                            name: "ALIGN",
                            suggestions: [
                                (
                                    name: "center",
                                ),
                                (
                                    name: "left",
                                ),
                                (
                                    name: "right",
                                ),
                            ],
                            default: Some("center"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--place",
                    ],
                    description: Some("Choose where on the screen to display the image"),
                    arguments: [
                        (
                            name: "PLACE",
                            description: Some("<width>x<height>@<left>x<top>"),
                        ),
                    ],
                ),
                (
                    names: [
                        "--scale-up",
                    ],
                    description: Some("Images that are smaller than the specified area to be scaled up to use as much of the specified area as possible"),
                    depends_on: [
                        "--place",
                    ],
                ),
                (
                    names: [
                        "--background",
                    ],
