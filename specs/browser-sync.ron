(
    version: 1,
    command: "browser-sync",
    description: Some("Keep multiple browsers & devices in sync when building websites"),
    subcommands: [
        (
            name: "start",
            description: Some("Start Browsersync"),
            options: [
                (
                    names: [
                        "-s",
                        "--server",
                    ],
                    description: Some("Run a Local server (uses your cwd as the web root)"),
                ),
                (
                    names: [
                        "--cwd",
                    ],
                    description: Some("Working directory"),
                    arguments: [
                        (
                            name: "directory",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--json",
                    ],
                    description: Some("If true, certain logs will output as json only"),
                ),
                (
                    names: [
                        "--serveStatic",
                        "--ss",
                    ],
                    description: Some("Directories to serve static files from"),
                    arguments: [
                        (
                            name: "directories",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--port",
                    ],
                    description: Some("Specify a port to use"),
                    arguments: [
                        (
                            name: "port",
                        ),
                    ],
                ),
                (
                    names: [
                        "-p",
                        "--proxy",
                    ],
                    description: Some("Proxy an existing server"),
                ),
                (
                    names: [
                        "--ws",
                    ],
                    description: Some("Proxy mode only - enable websocket proxying"),
                ),
                (
                    names: [
                        "-b",
                        "--browser",
                    ],
                    description: Some("Choose which browser should be auto-opened"),
                    arguments: [
                        (
                            name: "name",
                        ),
                    ],
                ),
                (
                    names: [
                        "-w",
                        "--watch",
                    ],
                    description: Some("Watch files"),
                ),
                (
                    names: [
                        "--ignore",
                    ],
                    description: Some("Ignore patterns for file watchers"),
                    arguments: [
                        (
                            name: "patterns",
                        ),
                    ],
                ),
                (
                    names: [
                        "-f",
                        "--files",
                    ],
                    description: Some("File paths to watch"),
                    arguments: [
                        (
                            name: "paths",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--index",
                    ],
                    description: Some("Specify which file should be used as the index page"),
                    arguments: [
                        (
                            name: "file",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--plugins",
                    ],
                    description: Some("Load Browsersync plugins"),
                    arguments: [
                        (
                            name: "plugins",
                        ),
                    ],
                ),
                (
                    names: [
                        "--extensions",
                    ],
                    description: Some("Specify file extension fallbacks"),
                    arguments: [
                        (
                            name: "extensions",
                        ),
                    ],
                ),
                (
                    names: [
                        "--startPath",
                    ],
                    description: Some("Specify the start path for the opened browser"),
                    arguments: [
                        (
                            name: "start-path",
                        ),
                    ],
                ),
                (
                    names: [
                        "--single",
                    ],
                    description: Some("If true, the connect-history-api-fallback middleware will be added"),
                ),
                (
                    names: [
                        "--https",
                    ],
                    description: Some("Enable SSL for local development"),
                ),
                (
                    names: [
                        "--directory",
                    ],
                    description: Some("Show a directory listing for the server"),
                ),
                (
                    names: [
                        "--xip",
                    ],
                    description: Some("Use xip.io domain routing"),
                ),
                (
                    names: [
                        "--tunnel",
                    ],
                    description: Some("Use a public URL"),
                ),
                (
                    names: [
                        "--open",
                    ],
                    description: Some("Choose which URL is auto-opened (local, external or tunnel), or provide a url"),
                    arguments: [
                        (
                            name: "string",
                            suggestions: [
                                (
                                    name: "local",
                                ),
                                (
                                    name: "external",
                                ),
                                (
                                    name: "tunnel",
                                ),
                            ],
                            suggest_current_token: true,
                        ),
                    ],
                ),
                (
                    names: [
                        "--cors",
                    ],
                    description: Some("Add Access Control headers to every request"),
                ),
                (
                    names: [
                        "-c",
                        "--config",
                    ],
                    description: Some("Specify a path to a configuration file"),
                    arguments: [
                        (
                            name: "path",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--host",
                    ],
                    description: Some("Specify a hostname to use"),
                    arguments: [
                        (
                            name: "hostname",
                        ),
                    ],
                ),
                (
                    names: [
                        "--listen",
                    ],
                    description: Some("Specify a hostname bind to (this will prevent binding to all interfaces)"),
                    arguments: [
                        (
                            name: "hostname",
                        ),
                    ],
                ),
                (
                    names: [
                        "--logLevel",
                    ],
                    description: Some("Set the logger output level (silent, info or debug)"),
                    arguments: [
                        (
                            name: "level",
                            suggestions: [
                                (
                                    name: "silent",
                                ),
                                (
                                    name: "info",
                                ),
                                (
                                    name: "debug",
                                ),
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "--reload-delay",
                    ],
                    description: Some("Time in milliseconds to delay the reload event following file changes"),
                    arguments: [
                        (
                            name: "milliseconds",
                        ),
                    ],
                ),
                (
                    names: [
                        "--reload-debounce",
                    ],
                    description: Some("Restrict the frequency in which browser:reload events can be emitted to connected clients"),
                    arguments: [
                        (
                            name: "milliseconds",
                        ),
                    ],
                ),
                (
                    names: [
                        "--ui-port",
                    ],
                    description: Some("Specify a port for the UI to use"),
                    arguments: [
                        (
                            name: "port",
                        ),
                    ],
                ),
                (
                    names: [
                        "--watchEvents",
                    ],
                    description: Some("Specify which file events to respond to"),
                    arguments: [
                        (
                            name: "events",
                        ),
                    ],
                ),
                (
                    names: [
                        "--no-notify",
                    ],
                    description: Some("Disable the notify element in browsers"),
                ),
                (
                    names: [
                        "--no-open",
                    ],
                    description: Some("Don't open a new browser window"),
                ),
                (
                    names: [
                        "--no-snippet",
                    ],
                    description: Some("Disable the snippet injection"),
                ),
                (
                    names: [
                        "--no-online",
                    ],
                    description: Some("Force offline usage"),
                ),
                (
                    names: [
                        "--no-ui",
                    ],
                    description: Some("Don't start the user interface"),
                ),
                (
                    names: [
                        "--no-ghost-mode",
                    ],
                    description: Some("Disable Ghost Mode"),
                ),
                (
                    names: [
                        "--no-inject-changes",
                    ],
                    description: Some("Reload on every file change"),
                ),
                (
                    names: [
                        "--no-reload-on-restart",
                    ],
                    description: Some("Don't auto-reload all browsers following a restart"),
                ),
            ],
        ),
        (
            name: "init",
            description: Some("Create a configuration file"),
            options: [
                (
                    names: [
                        "--cwd",
                    ],
                    description: Some("Working directory"),
                    arguments: [
                        (
                            name: "string",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "reload",
            description: Some("Send a reload event over HTTP protocol"),
            options: [
                (
                    names: [
                        "-f",
                        "--files",
                    ],
                    description: Some("File paths to reload"),
                    arguments: [
                        (
                            name: "paths",
                            template: [
                                FilePaths,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-p",
                        "--port",
                    ],
                    description: Some("Target a running instance by port number"),
                    arguments: [
                        (
                            name: "port",
                        ),
                    ],
                ),
                (
                    names: [
                        "-u",
                        "--url",
                    ],
                    description: Some("Provide the full URL to the running browsersync isntance"),
                    arguments: [
                        (
                            name: "url",
                        ),
                    ],
                ),
                (
                    names: [
                        "--cwd",
                    ],
                    description: Some("Working directory"),
                    arguments: [
                        (
                            name: "directory",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "recipe",
            description: Some("Generate the files for a recipe"),
            subcommands: [
                (
                    name: "ls",
                    description: Some("List recipes"),
                ),
            ],
            options: [
                (
                    names: [
                        "--cwd",
                    ],
                    description: Some("Working directory"),
                    arguments: [
                        (
                            name: "directory",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
                (
                    names: [
                        "-o",
                        "--output",
                    ],
                    description: Some("Specify an output directory"),
                    arguments: [
                        (
                            name: "directory",
                            template: [
                                Folders,
                            ],
                        ),
                    ],
                ),
            ],
            arguments: [
                (
                    name: "recipe-name",
                    generators: [
                        (
                            script: [
                                "bash",
                                "-c",
                                "browser-sync recipe ls | tail -n +3 | sed -e 's/^[[:space:]]*//'",
                            ],
                            split_on: Some("\n"),
                            cache: Some((
                                ttl_ms: Some(604800000),
                            )),
                        ),
                    ],
                ),
            ],
        ),
    ],
    options: [
        (
            names: [
                "--version",
            ],
            description: Some("Show version number"),
        ),
        (
            names: [
                "--help",
            ],
            description: Some("Show help"),
            persistent: true,
        ),
    ],
    arguments: [
        (
            name: "site or directory",
            template: [
                Folders,
            ],
            optional: true,
            variadic: true,
            suggest_current_token: true,
        ),
    ],
)
