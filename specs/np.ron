(
    version: 1,
    command: "np",
    description: Some("A better npm publish"),
    options: [
        (
            names: [
                "--any-branch",
            ],
            description: Some("Allow publishing from any branch"),
        ),
        (
            names: [
                "--branch",
            ],
            description: Some("Name of the release branch (default: main | master)"),
            arguments: [
                (
                    name: "branch",
                ),
            ],
        ),
        (
            names: [
                "--no-cleanup",
            ],
            description: Some("Skips cleanup of node_modules"),
        ),
        (
            names: [
                "--no-tests",
            ],
            description: Some("Skips tests"),
        ),
        (
            names: [
                "--yolo",
            ],
            description: Some("Skips cleanup and testing"),
        ),
        (
            names: [
                "--no-publish",
            ],
            description: Some("Skips publishing"),
        ),
        (
            names: [
                "--preview",
            ],
            description: Some("Show tasks without actually executing them"),
        ),
        (
            names: [
                "--tag",
            ],
            description: Some("Publish under a given dist-tag"),
            arguments: [
                (
                    name: "tag",
                ),
            ],
        ),
        (
            names: [
                "--no-yarn",
            ],
            description: Some("Don't use Yarn"),
        ),
        (
            names: [
                "--contents",
            ],
            description: Some("Subdirectory to publish"),
            arguments: [
                (
                    name: "directory",
                ),
            ],
        ),
        (
            names: [
                "--no-release-draft",
            ],
            description: Some("Skips opening a GitHub release draft"),
        ),
        (
            names: [
                "--release-draft-only",
            ],
            description: Some("Only opens a GitHub release draft"),
        ),
        (
            names: [
                "--test-script",
            ],
            description: Some("Name of npm run script to run tests before publishing (default: test)"),
            arguments: [
                (
                    name: "script",
                ),
            ],
        ),
        (
            names: [
                "--no-2fa",
            ],
            description: Some("Don't enable 2FA on new packages (not recommended)"),
        ),
        (
            names: [
                "--message",
            ],
            description: Some("Version bump commit message. `%s` will be replaced with version. (default: '%s' with npm and 'v%s' with yarn)"),
            arguments: [
                (
                    name: "message",
                ),
            ],
        ),
    ],
    arguments: [
        (
            name: "version",
            description: Some("Version to publish"),
            optional: true,
        ),
    ],
)
